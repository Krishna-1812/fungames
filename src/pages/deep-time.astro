---
import GameShell from '../layouts/GameShell.astro'
import { EVENTS } from '../lib/time-events'
import type { Event } from '../lib/time-events'

/**
 * Deep Time — a linear scroll through 4.54 billion years.
 *
 * The whole point is that the scale is honest: every pixel really is the same
 * number of years. But a single linear scale makes all of human history one
 * unreadable pixel, so the page is split into five acts that each zoom in,
 * with the seam made explicit rather than hidden.
 *
 * Beside the scroll, pinned, is the Earth itself at the year the scroll is on
 * (lib/time-earth.ts): the one object all of these sentences are about.
 *
 * In the shell the scroll is the stage, the same way The Deep Sea's is. Score
 * is when you are looking at, Zoom is which of the five scales you are on,
 * Moves is what one pixel is worth there, Best is the furthest you have come,
 * and today is the ending.
 */

type Act = { id: string; from: number; to: number; yearsPerPx: number }

const ACTS: Act[] = [
  // Five zoom levels. Each is internally linear and honest; the seams are shown
  // explicitly. Without them, everything after the dinosaurs is one pixel.
  { id: 'act1', from: 4_540_000_000, to: 60_000_000, yearsPerPx: 250_000 },
  { id: 'act2', from: 60_000_000, to: 2_000_000, yearsPerPx: 20_000 },
  { id: 'act3', from: 2_000_000, to: 12_000, yearsPerPx: 500 },
  { id: 'act4', from: 12_000, to: 250, yearsPerPx: 5 },
  { id: 'act5', from: 250, to: 0, yearsPerPx: 0.25 },
]

// Lay the acts out end to end and resolve every event to an absolute pixel offset.
let cursor = 0
const acts = ACTS.map((a) => {
  const height = Math.round((a.from - a.to) / a.yearsPerPx)
  const laid = { ...a, height, offset: cursor }
  cursor += height
  return laid
})
const totalHeight = cursor

// Vertical position is the honest part and never moves. Events are first laid
// out at their true depth, then any run that would overlap is split into two
// narrow side lanes. Isolated events keep the full-width lane. This is the
// server's estimate; the page measures the real heights and does it again.
const CARD_H = 84
type Placed = ReturnType<typeof at> & { lane: 'center' | 'left' | 'right' }
function at(e: Event) {
  const act = acts.find((a) => e.at <= a.from && e.at > a.to) ?? acts[acts.length - 1]
  return { ...e, top: act.offset + Math.round((act.from - e.at) / act.yearsPerPx) }
}

const rough = EVENTS.map(at)
const placed: Placed[] = []
for (let i = 0; i < rough.length; ) {
  let j = i + 1
  while (j < rough.length && rough[j].top < rough[j - 1].top + CARD_H) j++
  const group = rough.slice(i, j)
  if (group.length === 1) {
    placed.push({ ...group[0], lane: 'center' })
  } else {
    group.forEach((g, k) => placed.push({ ...g, lane: k % 2 === 0 ? 'left' : 'right' }))
  }
  i = j
}

const fmt = (y: number) =>
  y === 0 ? 'today'
  : y >= 1e9 ? `${(y / 1e9).toFixed(2)} billion years ago`
  : y >= 1e6 ? `${(y / 1e6).toFixed(y >= 1e7 ? 0 : 1)} million years ago`
  : `${y.toLocaleString('en-US')} years ago`
---

<GameShell
  slug="deep-time"
  labels={{ score: 'When', best: 'Furthest', level: 'Zoom', moves: 'One pixel' }}
  initial={{ score: '4.54 bn yrs', level: `1 / ${ACTS.length}`, moves: '250K yrs' }}
>
  <div class="dt" id="dig">
  {/* The Earth, pinned while the scroll passes over it. The plain dark behind
      it is what anything without WebGL2 gets. */}
  <div class="dt-back" aria-hidden="true">
    <div class="skygl" id="skygl"></div>
  </div>

  <div class="dt-hud-pin">
    <div class="now" aria-hidden="true"></div>
    <div class="hud" role="group" aria-label="Time gauge">
      <div class="hud-when">
        <div class="hud-label">you are looking at</div>
        <div class="hud-year" id="hudYear">4.54 billion years ago</div>
      </div>
      <div class="hud-facts">
        <dl class="facts">
          <div><dt>A day lasts</dt><dd id="fDay">5 hours</dd></div>
          <div><dt>Oxygen in the air</dt><dd id="fOxy">none</dd></div>
          <div><dt>The Sun</dt><dd id="fSun">71% of today</dd></div>
        </dl>
        <div class="hud-bar"><div class="hud-fill" id="hudFill"></div></div>
        <div class="hud-scale" id="hudScale">1 pixel = 250,000 years</div>
      </div>
    </div>
  </div>

  <div class="intro">
    <p class="intro-title">Deep Time</p>
    <p>Every pixel below is a fixed number of years, and that is the Earth as it was then. Keep scrolling.</p>
    <div class="arrow" aria-hidden="true">↓</div>
  </div>

  <div class="reel" style={`height:${totalHeight}px`}>
    {
      acts.map((a, i) =>
        i === 0 ? null : (
          <div class="seam" style={`top:${a.offset}px`}>
            <span>zooming in {Math.round(acts[i - 1].yearsPerPx / a.yearsPerPx)}×</span>
          </div>
        )
      )
    }
    {
      placed.map((e) => (
        <article class:list={['ev', `lane-${e.lane}`, { big: e.big }]} style={`top:${e.top}px`}>
          <div class="ev-when">{fmt(e.at)}</div>
          <h2>{e.title}</h2>
          {e.note && <p>{e.note}</p>}
        </article>
      ))
    }
  </div>

  <p class="dt-today">Today. Scroll back up: it is a long way.</p>
  </div>

  <Fragment slot="howto">
    <p>
      Scroll down through the 4.54 billion years since the Earth formed, from
      its molten beginning to today, and watch the planet change beside you.
    </p>
    <ul>
      <li>Every pixel is a fixed number of years. One scale all the way would leave the whole of human history as a single unreadable pixel, so the page zooms in five times, and each seam says by how much.</li>
      <li>Every event is at its real date: it happens when its rule reaches the line. The gauge says when you are looking at, how long a day was, how much oxygen was in the air and how bright the Sun was.</li>
      <li>The globe is the Earth at that date. The coastline of the last few million years is the real one, and the ice ages keep their real rhythm. The continents before about 200 million years ago are an impression: nobody has that map.</li>
    </ul>
    <p>Today is the end. Your best is the furthest you have come.</p>
  </Fragment>
</GameShell>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ acts, totalHeight })} />

  <script>
  import { ring } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { EARTH_FRAG, dayHours, oxygenPct, sunPct } from '../lib/time-earth'
  import { createShell } from '../lib/game-shell'
  import { recordPlay } from '../lib/stats'
    const { acts, totalHeight } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  const dig = document.getElementById('dig')!
  const reel = document.querySelector('.reel') as HTMLElement
  const back = document.querySelector('.dt-back') as HTMLElement
  const cards = [...document.querySelectorAll('.ev')] as HTMLElement[]

  // --- where things are ---------------------------------------------------
  // Wide: the timeline down the left, the globe on the right, and the line
  // you read against across the middle. Narrow: the globe on top and the
  // timeline beneath it, with the line two-thirds of the way down. The CSS
  // makes the same decision at the same width; these are the numbers the
  // shader and the scroll need.
  let geo = { wide: true, line: 0.5, cx: 0, cy: 0, R: 1, fadeTo: 0, fadeFrom: 0, moon: [-1.25, 1.05] }
  let seenW = 0, seenH = 0
  function measure() {
    const w = dig.clientWidth, h = window.innerHeight
    seenW = w; seenH = h
    const wide = w >= 860
    if (wide) {
      const R = Math.min(0.30 * h, 0.21 * w)
      geo = { wide, line: 0.5, cx: 0.71 * w, cy: 0.40 * h, R, fadeTo: -1e9, fadeFrom: -1e9, moon: [-1.22, 1.02] }
    } else {
      const R = Math.min(0.155 * h, 0.33 * w)
      const cy = 76 + R
      geo = { wide, line: 0.66, cx: 0.5 * w, cy, R, fadeTo: cy + R + 58, fadeFrom: cy + R + 96, moon: [-1.08, 0.8] }
    }
    // The column is set here rather than in a container query because a
    // container cannot restyle itself, and these live on the container.
    dig.classList.toggle('narrow', !wide)
    dig.style.setProperty('--col-l', `${wide ? Math.round(0.055 * w) : 22}px`)
    dig.style.setProperty('--col-w', `${wide ? Math.round(Math.min(0.40 * w, 560)) : w - 40}px`)
    dig.style.setProperty('--line', `${geo.line * 100}vh`)
    dig.style.setProperty('--gx', `${geo.cx}px`)
    dig.style.setProperty('--gy', `${geo.cy}px`)
    dig.style.setProperty('--gr', `${geo.R}px`)
  }
  measure()

  // --- lane layout -------------------------------------------------------
  // The server lays cards out with an estimated height, which cannot know how
  // text will wrap at this width. This pass measures the real heights and
  // re-lanes any run that still overlaps. It also re-runs on resize.
  function relayout() {
    // A card's height depends on which lane it ends up in, so measure both
    // and group on the larger: a card can only ever shrink from here.
    const measureLane = (lane: string) => {
      for (const el of cards) {
        el.classList.remove('lane-center', 'lane-left', 'lane-right', 'compact', 'compact-hard')
        el.classList.add(lane)
      }
      return cards.map((el) => el.offsetHeight)
    }
    const wideH = measureLane('lane-center')
    const narrowH = measureLane('lane-left')

    const GROUP_GAP = 10
    const boxes = cards.map((el, i) => ({ el, top: el.offsetTop, h: Math.max(wideH[i], narrowH[i]) + GROUP_GAP }))

    const groups: (typeof boxes)[] = []
    for (let i = 0; i < boxes.length; ) {
      let j = i + 1
      while (j < boxes.length && boxes[j].top < boxes[j - 1].top + boxes[j - 1].h) j++
      groups.push(boxes.slice(i, j))
      i = j
    }

    // Anything alone keeps the wide lane; anything crowded goes into two
    // narrow lanes, each tracking how far down it is already occupied.
    for (const group of groups) {
      if (group.length === 1) {
        group[0].el.classList.remove('lane-left')
        group[0].el.classList.add('lane-center')
        continue
      }
      // Escalating compaction: full card, then drop the note, then drop the
      // date line too. Positions never move — only the cards get smaller.
      const TIERS = ['', 'compact', 'compact-hard']
      for (let attempt = 0; attempt < TIERS.length; attempt++) {
        const bottom: Record<string, number> = { left: -Infinity, right: -Infinity }
        let clash = false
        for (const b of group) {
          const h = b.el.offsetHeight
          const GAP = 10
          let lane = bottom.left + GAP <= b.top ? 'left' : bottom.right + GAP <= b.top ? 'right' : null
          if (!lane) {
            clash = true
            lane = bottom.left <= bottom.right ? 'left' : 'right'
          }
          b.el.classList.remove('lane-left', 'lane-right')
          b.el.classList.add('lane-' + lane)
          bottom[lane] = b.top + h
        }
        if (!clash) break
        const next = TIERS[attempt + 1]
        if (next) for (const b of group) b.el.classList.add(next)
      }
    }
  }
  relayout()
  let tops = cards.map((c) => c.offsetTop)

  addEventListener('pointerdown', unlock, { once: true })
  addEventListener('scroll', unlock, { once: true, passive: true })

  const hudYear = document.getElementById('hudYear')!
  const hudFill = document.getElementById('hudFill')!
  const hudScale = document.getElementById('hudScale')!
  const fDay = document.getElementById('fDay')!
  const fOxy = document.getElementById('fOxy')!
  const fSun = document.getElementById('fSun')!
  const intro = document.querySelector('.intro') as HTMLElement
  const introTitle = intro.querySelector('.intro-title') as HTMLElement

  /* ---- the shell ------------------------------------------------------ */

  let ended = false
  let deepestAct = 0
  let furthestPct = 0
  let reached = -1
  const shell = createShell({
    slug: 'deep-time',
    // Back to the beginning of the Earth, not a reload.
    onRestart: () => {
      ended = false
      deepestAct = 0
      furthestPct = 0
      reached = -1
      for (const c of cards) c.classList.remove('focused')
      scrollTo({ top: dig.getBoundingClientRect().top + scrollY - 16, behavior: 'instant' })
    },
  })

  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumSignificantDigits: 3 })
  /** Short enough for a score tile: "4.54 bn yrs", "66M yrs", "1,850 yrs", "Today". */
  function shortYears(y: number) {
    if (y < 0.5) return 'Today'
    if (y >= 1e9) return `${(y / 1e9).toFixed(2)} bn yrs`
    if (y >= 1e4) return `${compact.format(y)} yrs`
    return `${Math.round(y).toLocaleString('en-US')} yrs`
  }

  /* The strip rolls its digits, so it is told once the scroll settles; the
     gauge by the globe is the live one. */
  let stripT = 0
  let at = { years: 4.54e9, actIdx: 0, progress: 0 }
  function paintStrip() {
    const { years, actIdx, progress } = at
    const act = acts[actIdx]
    shell.setScore(shortYears(years))
    shell.setLevel(`${actIdx + 1} / ${acts.length}`)
    shell.setMoves(act.yearsPerPx >= 1e4 ? `${compact.format(act.yearsPerPx)} yrs` : `${act.yearsPerPx} yr${act.yearsPerPx === 1 ? '' : 's'}`)
    if (progress > 0) shell.considerBest(Math.round(progress * 10000), `${(progress * 100).toLocaleString('en-US', { maximumFractionDigits: 2 })}% explored`)
  }

  function reachedToday() {
    ended = true
    clearTimeout(stripT)
    paintStrip()
    recordPlay('deep-time', { reachedToday: true }, {})
    const first = acts[0].yearsPerPx
    const last = acts[acts.length - 1].yearsPerPx
    shell.win({
      kicker: '4.54 billion years, scrolled',
      title: 'Today.',
      score: `${totalHeight.toLocaleString('en-US')} px`,
      lines: [
        `At the scale the page began on, all 5,000 years of written history would be a ${Math.round(first / 5000)}th of a single pixel.`,
        `To fit the last 250 years in, it had to zoom in ${Math.round(first / last).toLocaleString('en-US')} times.`,
      ],
      againLabel: 'Back to the beginning',
    })
  }

  const fmt = (y: number) =>
    y <= 0 ? 'today'
    : y >= 1e9 ? `${(y / 1e9).toFixed(2)} billion years ago`
    : y >= 1e6 ? `${(y / 1e6).toFixed(y >= 1e7 ? 0 : 1)} million years ago`
    : `${Math.round(y).toLocaleString('en-US')} years ago`

  const fmtDay = (h: number) => {
    const whole = Math.floor(h + 1e-6), min = Math.round((h - whole) * 60 / 5) * 5
    return h >= 23.98 ? '24 hours' : min === 0 ? `${whole} hours` : min === 60 ? `${whole + 1} hours` : `${whole} h ${min} min`
  }
  const fmtOxy = (o: number) => (o < 0.05 ? 'none' : o < 1 ? 'a trace' : `${Math.round(o)}%`)

  /* ---- the Earth ------------------------------------------------------- */

  let years = 4.54e9
  let depthPx = 0
  let turn = 0                      // what time alone has turned it
  let lastT = performance.now()
  let hit = { kind: 0, at: -1e9 }
  const surface = new ShaderSurface(document.getElementById('skygl')!, EARTH_FRAG, {
    textures: { u_land: '/deep-time/land.webp' },
    uniforms: () => {
      const now = performance.now()
      if (!prefersReducedMotion) turn += Math.min(0.1, (now - lastT) / 1000) * 0.045
      lastT = now
      const h = back.clientHeight || window.innerHeight
      return {
        u_years: years,
        // Scrolling turns it too: three thousand pixels to a revolution.
        u_spin: 0.9 + turn + depthPx * 0.0021,
        u_globe: [geo.cx / h, 1 - geo.cy / h, geo.R / h],
        u_moon: geo.moon,
        u_hit: [(now - hit.at) / 1000, hit.kind],
      }
    },
  })

  /** The two events that happen in an instant and are over in a pixel: set
   *  off as they cross the line, and played out in seconds. */
  const IMPACTS = [{ at: 4.51e9, kind: 1 }, { at: 66e6, kind: 2 }]

  let ticking = false
  let first = true
  function update() {
    ticking = false
    // Depth is measured at the line, so the readout is the date of whatever
    // rule is on it. Against the viewport, not offsetTop: the reel sits
    // inside the shell's stage, and offsetTop is only relative to that.
    const vh = window.innerHeight
    const reelTop = reel.getBoundingClientRect().top
    const depth = vh * geo.line - reelTop
    const clamped = Math.max(0, Math.min(totalHeight, depth))

    const act = acts.find((a: any) => clamped < a.offset + a.height) ?? acts[acts.length - 1]
    const within = clamped - act.offset
    const was = years
    years = Math.max(0, act.from - within * act.yearsPerPx)
    depthPx = clamped

    hudYear.textContent = fmt(years)
    hudScale.textContent = `1 pixel = ${act.yearsPerPx.toLocaleString('en-US')} years`
    hudFill.style.width = `${(clamped / totalHeight) * 100}%`
    fDay.textContent = fmtDay(dayHours(years))
    fOxy.textContent = fmtOxy(oxygenPct(years))
    fSun.textContent = `${Math.round(sunPct(years))}% of today`

    if (!first && !prefersReducedMotion) {
      for (const im of IMPACTS) if (was > im.at && years <= im.at && was - years < im.at * 0.2) hit = { kind: im.kind, at: performance.now() }
    }

    // Narrow: cards go under the globe on their way out, so they are faded
    // before they get there. Only the handful near the screen are touched.
    const fade = (yv: number) => (geo.wide ? 1 : Math.max(0, Math.min(1, (yv - geo.fadeTo) / (geo.fadeFrom - geo.fadeTo))))
    if (reelTop > -vh) {
      const o = fade(introTitle.getBoundingClientRect().top)
      intro.style.opacity = o === 1 ? '' : o.toFixed(2)
    }
    for (let i = 0; i < cards.length; i++) {
      const yv = tops[i] + reelTop
      if (yv < -400 || yv > vh + 200) continue
      const o = fade(yv)
      cards[i].style.opacity = o === 1 ? '' : o.toFixed(2)
      // Arrived: its rule has reached the line.
      if (yv <= vh * geo.line + 1 && !cards[i].classList.contains('focused')) {
        cards[i].classList.add('focused')
        if (i > reached && !first) {
          reached = i
          if (cards[i].classList.contains('big')) {
            sfx.blip(i)
            ring(geo.cx + dig.getBoundingClientRect().left, geo.cy + back.getBoundingClientRect().top, 'rgba(255,255,255,0.45)', geo.R * 0.5)
            shell.pick('Event reached', cards[i].querySelector('h2')!.textContent!)
          }
        }
      }
    }

    // Driven by scroll as well as by time: under reduced motion the shared
    // ticker never runs, so the frame has to be asked for explicitly.
    if (prefersReducedMotion) surface.redraw()

    const actIdx = acts.indexOf(act)
    at = { years, actIdx, progress: clamped / totalHeight }
    // Each zoom announces itself the first time you reach it.
    if (actIdx > deepestAct) {
      deepestAct = actIdx
      shell.levelUp(`Zooming in ${Math.round(acts[actIdx - 1].yearsPerPx / act.yearsPerPx)}×`)
      shell.pick('Zoom reached', `1 px = ${act.yearsPerPx.toLocaleString('en-US')} yrs`)
    }
    // Where people stop: how far down the page in 5% steps, told only when it grows.
    const pct = Math.floor((clamped / totalHeight) * 20) * 5
    if (pct > furthestPct) shell.progress(furthestPct = pct)
    clearTimeout(stripT)
    stripT = window.setTimeout(paintStrip, 180)
    if (!ended && clamped >= totalHeight - 1) reachedToday()
    first = false
  }

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    },
    { passive: true }
  )
  // A phone reports a desktop's width until its viewport has been applied,
  // and that is after this has run once: so watch the box, not the event.
  new ResizeObserver(() => {
    if (dig.clientWidth === seenW && window.innerHeight === seenH) return
    measure(); relayout(); tops = cards.map((c) => c.offsetTop); update()
  }).observe(dig)
  addEventListener('resize', () => { if (window.innerHeight !== seenH) { measure(); update() } }, { passive: true })
  update()
</script>

<style>
  /* The scroll fills the stage edge to edge. overflow: clip rather than
     hidden, which would make the stage a scroll container and stop the globe
     and the gauge sticking. */
  :global(.stage:has(> .dt)) { padding: 0; overflow: clip; background: #04050a; }
  .dt {
    position: relative; color: #f1f4f8; container-type: inline-size;
    --line: 50vh; --gx: 71cqw; --gy: 40vh; --gr: 21cqw;
    /* the column the timeline runs down */
    --col-l: 5.5cqw; --col-w: min(40cqw, 560px);
  }
  /* Sticky, not fixed: pinned while the scroll passes, but inside the frame. */
  .dt-back {
    position: sticky; top: 0; height: 100vh; margin-bottom: -100vh; overflow: hidden;
    background: radial-gradient(120% 90% at 70% 40%, #0b1020, #04050a 70%);
  }
  .dt-hud-pin { position: sticky; top: 0; height: 0; z-index: 40; pointer-events: none; }
  .skygl { position: absolute; inset: 0; pointer-events: none; }
  /* Created at runtime, so this cannot be a scoped rule. */
  .skygl :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* The line everything is read against: an event happens when its rule gets here. */
  .now {
    position: absolute; top: var(--line); left: 0; width: calc(var(--col-l) + var(--col-w) + 3cqw); height: 1px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0.28) 70%, transparent);
  }
  .now::before {
    content: ''; position: absolute; left: calc(var(--col-l) - 15px); top: -4px; width: 9px; height: 9px;
    border-radius: 50%; background: #fff; box-shadow: 0 0 12px 2px rgb(160 200 255 / 0.8);
  }

  .hud {
    position: absolute; left: var(--gx); top: calc(var(--gy) + var(--gr)); transform: translateX(-50%);
    width: min(38cqw, 440px); padding-top: 26px; text-align: center;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.9);
  }
  .hud-label { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.62; }
  .hud-year {
    font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 600;
    font-size: clamp(24px, 2.9cqw, 40px); line-height: 1.08; letter-spacing: -0.02em; margin-top: 5px;
    font-variant-numeric: tabular-nums;
  }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px 0 0; }
  .facts div { border-top: 1px solid rgb(255 255 255 / 0.2); padding-top: 8px; }
  .facts dt { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
  .facts dd { margin: 3px 0 0; font: inherit; font-size: 16px; font-weight: 600; }
  .hud-bar { height: 2px; background: rgb(255 255 255 / 0.16); border-radius: 2px; margin: 18px 0 7px; }
  .hud-fill { height: 100%; width: 0; background: linear-gradient(90deg, #7fb2ff, #fff); border-radius: 2px; }
  .hud-scale { font-size: 12px; opacity: 0.62; }

  .intro {
    position: relative; min-height: 92vh; display: grid; align-content: center; justify-items: start; gap: 14px;
