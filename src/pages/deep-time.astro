---
import GameLayout from '../layouts/GameLayout.astro'
import { EVENTS } from '../lib/time-events'
import type { Event } from '../lib/time-events'
import { TIME_ART, MOOD, sceneSvg } from '../lib/time-art'
import { withBase } from '../lib/base'

/** "#rrggbb" -> "r, g, b", for building rgba() strings without color-mix() —
 *  color-mix() renders as a `color(srgb …)` function, which several of this
 *  site's own contrast tooling parses as plain rgb() and would silently stop
 *  reading. Plain rgba() has none of that risk. */
const rgb = (hex: string) =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ')

/**
 * Deep Time — a linear scroll through 4.54 billion years.
 *
 * The whole point is that the scale is honest: every pixel really is the same
 * number of years. But a single linear scale makes all of human history one
 * unreadable pixel, so the page is split into three acts that each zoom in by
 * ~500x, with the seam made explicit rather than hidden.
 */

type Act = { id: string; from: number; to: number; yearsPerPx: number; sky: [string, string] }

const ACTS: Act[] = [
  // Five zoom levels. Each is internally linear and honest; the seams are shown
  // explicitly. Without them, everything after the dinosaurs is one pixel.
  { id: 'act1', from: 4_540_000_000, to: 60_000_000, yearsPerPx: 250_000, sky: ['#100a1e', '#33203f'] },
  { id: 'act2', from: 60_000_000, to: 2_000_000, yearsPerPx: 20_000, sky: ['#33203f', '#4a2a55'] },
  { id: 'act3', from: 2_000_000, to: 12_000, yearsPerPx: 500, sky: ['#4a2a55', '#1d4e5f'] },
  { id: 'act4', from: 12_000, to: 250, yearsPerPx: 5, sky: ['#1d4e5f', '#6f9fb5'] },
  { id: 'act5', from: 250, to: 0, yearsPerPx: 0.25, sky: ['#6f9fb5', '#bcd8e2'] },
]

// Lay the acts out end to end and resolve every event to an absolute pixel offset.
let cursor = 0
const acts = ACTS.map((a) => {
  const height = Math.round((a.from - a.to) / a.yearsPerPx)
  const laid = { ...a, height, offset: cursor }
  cursor += height
  return laid
})
const totalHeight = cursor

// Vertical position is the honest part and never moves. When two events land
// close enough to overlap, they are pushed into left/right lanes rather than
// being nudged in time, so the scale stays true and the text stays readable.
const CARD_H = 96

// Vertical position is the honest part and never moves. Events are first laid
// out at their true depth, then any run that would overlap is split into two
// narrow side lanes. Isolated events keep the full-width centre lane.
type Placed = ReturnType<typeof at> & { lane: 'center' | 'left' | 'right' }
function at(e: Event) {
  const act = acts.find((a) => e.at <= a.from && e.at > a.to) ?? acts[acts.length - 1]
  return { ...e, top: act.offset + Math.round((act.from - e.at) / act.yearsPerPx) }
}

const rough = EVENTS.map(at)
const placed: Placed[] = []
for (let i = 0; i < rough.length; ) {
  // Extend a group while each next event would collide with the previous one.
  let j = i + 1
  while (j < rough.length && rough[j].top < rough[j - 1].top + CARD_H) j++
  const group = rough.slice(i, j)
  if (group.length === 1) {
    placed.push({ ...group[0], lane: 'center' })
  } else {
    group.forEach((g, k) => placed.push({ ...g, lane: k % 2 === 0 ? 'left' : 'right' }))
  }
  i = j
}

const fmt = (y: number) =>
  y === 0 ? 'today'
  : y >= 1e9 ? `${(y / 1e9).toFixed(2)} billion years ago`
  : y >= 1e6 ? `${(y / 1e6).toFixed(y >= 1e7 ? 0 : 1)} million years ago`
  : `${y.toLocaleString('en-US')} years ago`
---

<GameLayout slug="deep-time" bar="#171132" bodyClass="night-body">
  <div class="sky" id="sky"></div>
  {/* The rendered sky sits over the CSS gradient, which stays as the fallback
      for anything without WebGL2. */}
  <div class="skygl" id="skygl" aria-hidden="true"></div>

  <div class="hud">
    <div class="hud-label">you are looking at</div>
    <div class="hud-year" id="hudYear">4.54 billion years ago</div>
    <div class="hud-bar"><div class="hud-fill" id="hudFill"></div></div>
    <div class="hud-scale" id="hudScale">1 pixel = 250,000 years</div>
  </div>

  <div class="intro">
    <h1>Deep Time</h1>
    <p>Every pixel below is a fixed number of years. Keep scrolling.</p>
    <div class="arrow">↓</div>
  </div>

  <div class="reel" style={`height:${totalHeight}px`}>
    {
      acts.map((a, i) =>
        i === 0 ? null : (
          // The band is the two real colours either side of the cut — the
          // previous act's own last tone into this one's own first — so the
          // seam looks like the transition it is naming rather than a rule
          // stamped between two unrelated eras.
          <div
            class="seam"
            style={`top:${a.offset}px;--from:${acts[i - 1].sky[1]};--to:${a.sky[0]}`}
          >
            <span>zooming in {Math.round(acts[i - 1].yearsPerPx / a.yearsPerPx)}×</span>
          </div>
        )
      )
    }
    {
      placed.map((e) => {
        const mood = MOOD[e.title]
        // Precomputed once per event at build time, not with color-mix() at
        // render time — see the note by rgb() above.
        const style = mood
          ? `top:${e.top}px;--mood:${mood};--moodRgb:${rgb(mood)}`
          : `top:${e.top}px`
        return (
          <article class:list={['ev', `lane-${e.lane}`, { big: e.big }]} style={style}>
            {TIME_ART[e.title] && <div class="ev-art" set:html={sceneSvg(e.title)} />}
            <div class="ev-text">
              <div class="ev-when">{fmt(e.at)}</div>
              <h2>{e.title}</h2>
              {e.note && <p>{e.note}</p>}
            </div>
          </article>
        )
      })
    }
  </div>

  <footer class="outro">
    <p>Scroll back up. It is a long way.</p>
    <a href={withBase('/')}>← more things like this</a>
  </footer>
</GameLayout>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ acts, totalHeight })} />

  <script>
  import { ring } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { TIME_FRAG } from '../lib/time-sky'
    const { acts, totalHeight } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  // --- lane layout -------------------------------------------------------
  // The server lays cards out with an estimated card height, which is right
  // for most of the page but cannot know how text will wrap at this viewport.
  // This pass measures the real heights and re-lanes any run that still
  // overlaps, then repeats because changing lane changes width and therefore
  // height. It also re-runs on resize.
  const cards = [...document.querySelectorAll('.ev')]

  function relayout() {
    // Phase 1 — a card's height depends on which lane it ends up in, and
    // neither lane is reliably taller: the narrow lane wraps more lines, the
    // wide lane has more padding. So measure both and group on the larger,
    // which guarantees a card can only ever shrink from here.
    const measure = (lane) => {
      for (const el of cards) {
        el.classList.remove('lane-center', 'lane-left', 'lane-right', 'compact', 'compact-hard')
        el.classList.add(lane)
      }
      return cards.map((el) => el.offsetHeight)
    }
    const wide = measure('lane-center')
    const narrow = measure('lane-left')

    const GROUP_GAP = 8
    const boxes = cards.map((el, i) => ({
      el,
      top: el.offsetTop,
      h: Math.max(wide[i], narrow[i]) + GROUP_GAP,
    }))

    const groups = []
    for (let i = 0; i < boxes.length; ) {
      let j = i + 1
      while (j < boxes.length && boxes[j].top < boxes[j - 1].top + boxes[j - 1].h) j++
      groups.push(boxes.slice(i, j))
      i = j
    }

    // Phase 2 — anything alone keeps the wide lane; anything crowded goes into
    // two narrow lanes, each tracking how far down it is already occupied.
    for (const group of groups) {
      if (group.length === 1) {
        group[0].el.classList.remove('lane-left')
        group[0].el.classList.add('lane-center')
        continue
      }
      // Escalating compaction: full card, then drop the note, then drop the date
      // line too. Positions never move — only the cards get smaller.
      const TIERS = ['', 'compact', 'compact-hard']
      for (let attempt = 0; attempt < TIERS.length; attempt++) {
        const bottom = { left: -Infinity, right: -Infinity }
        let clash = false
        for (const b of group) {
          const h = b.el.offsetHeight
          const GAP = 10
          let lane =
            bottom.left + GAP <= b.top ? 'left' : bottom.right + GAP <= b.top ? 'right' : null
          if (!lane) {
            clash = true
            lane = bottom.left <= bottom.right ? 'left' : 'right'
          }
          b.el.classList.remove('lane-left', 'lane-right')
          b.el.classList.add('lane-' + lane)
          bottom[lane] = b.top + h
        }
        if (!clash) break
        const next = TIERS[attempt + 1]
        if (next) for (const b of group) b.el.classList.add(next)
      }
    }
  }

  relayout()

  // A chime when a major event scrolls into the middle of the screen. Watching
  // the centre band rather than the whole viewport means the sound lands when
  // you are actually reading the card, not when it clips the bottom edge.
  let chimeStep = 0
  const bigCards = cards.filter((c) => c.classList.contains('big'))
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          io.unobserve(e.target)
          sfx.blip(chimeStep++)
          const r = e.target.getBoundingClientRect()
          ring(r.left + r.width / 2, r.top + r.height / 2, 'rgba(255,255,255,0.5)', 20)
          // A one-shot spotlight, not a toggle: the observer never asks about
          // this card again, so the class is a permanent record of "you were
          // here for this one" rather than a state that could get stuck on.
          e.target.classList.add('focused')
        }
      },
      { rootMargin: '-42% 0px -42% 0px' }
    )
    bigCards.forEach((c) => io.observe(c))
  }
  addEventListener('pointerdown', unlock, { once: true })
  addEventListener('scroll', unlock, { once: true, passive: true })

  const sky = document.getElementById('sky')
  const hudYear = document.getElementById('hudYear')
  const hudFill = document.getElementById('hudFill')
  const hudScale = document.getElementById('hudScale')
  const reel = document.querySelector('.reel')

  const fmt = (y) =>
    y <= 0 ? 'today'
    : y >= 1e9 ? `${(y / 1e9).toFixed(2)} billion years ago`
    : y >= 1e6 ? `${(y / 1e6).toFixed(y >= 1e7 ? 0 : 1)} million years ago`
    : `${Math.round(y).toLocaleString('en-US')} years ago`

  const mix = (a, b, t) => {
    const p = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16))
    const [r1, g1, b1] = p(a), [r2, g2, b2] = p(b)
    const c = (x, y) => Math.round(x + (y - x) * t)
    return `rgb(${c(r1, r2)},${c(g1, g2)},${c(b1, b2)})`
  }

  /* The rendered sky. The CSS gradient underneath stays in place, so if the
     surface never comes up the page looks exactly as it did before. */
  let curL = Math.log10(4.54e9)
  const surface = new ShaderSurface(document.getElementById('skygl'), TIME_FRAG, {
    // Every regime here is low-frequency; there is nothing with an edge sharp
    // enough for three-quarter resolution to show.
    scale: 0.75,
    uniforms: () => ({ u_L: curL }),
  })

  let ticking = false
  function update() {
    ticking = false
    // Depth measured at the middle of the viewport, so the readout matches
    // whatever event you are actually looking at.
    const depth = window.scrollY + window.innerHeight / 2 - reel.offsetTop
    const clamped = Math.max(0, Math.min(totalHeight, depth))

    const act = acts.find((a) => clamped < a.offset + a.height) ?? acts[acts.length - 1]
    const within = clamped - act.offset
    const years = Math.max(0, act.from - within * act.yearsPerPx)

    hudYear.textContent = fmt(years)
    hudScale.textContent = `1 pixel = ${act.yearsPerPx.toLocaleString('en-US')} years`
    hudFill.style.width = `${(clamped / totalHeight) * 100}%`

    const t = act.height ? Math.min(1, Math.max(0, within / act.height)) : 0
    // The fill is lit by the same sky you are actually under, rather than a
    // flat white bar that says nothing about where in 4.54 billion years you
    // are — the one piece of the HUD Scale's own progress bar does not need,
    // because Scale has no eras to be under.
    hudFill.style.background = mix(act.sky[0], act.sky[1], t)
    sky.style.background = `linear-gradient(${mix(act.sky[0], act.sky[1], t)}, ${mix(act.sky[0], act.sky[1], Math.min(1, t + 0.25))})`

    // The eras cross-fade against log(years), which is the axis the acts are
    // already built on, so each change lands near the event that caused it.
    curL = Math.log10(Math.max(years, 1))
    // Driven by scroll, not by time: under reduced motion the shared ticker
    // never runs, so the frame has to be asked for explicitly.
    if (prefersReducedMotion) surface.redraw()
  }

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    },
    { passive: true }
  )
  addEventListener('resize', () => { relayout(); update() }, { passive: true })
  update()
</script>

<style>
  .skygl { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  /* Created at runtime, so this cannot be a scoped rule. */
  .skygl :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .sky {
    position: fixed; inset: 0; z-index: -2;
    background: linear-gradient(#100a1e, #3b1f47);
    transition: background 260ms linear;
  }
  :global(.night-body) { background: #100a1e; color: #fff; }

  .hud {
    position: fixed; top: 58px; left: 50%; transform: translateX(-50%);
    z-index: 40; width: min(92vw, 520px); text-align: center;
    padding: 10px 16px; border-radius: 12px;
    background: rgba(0, 0, 0, 0.66);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }
  .hud-label { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.78; }
  .hud-year { font-size: 19px; font-weight: 700; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .hud-bar { height: 3px; background: rgba(255,255,255,0.2); border-radius: 2px; margin: 9px 0 6px; }
  /* Colour set from JS, per frame — the same mix(act.sky[0], act.sky[1], t)
     the backdrop itself is built from, so the bar reads as a sample of the
     sky you are actually under rather than a generic white progress meter. */
  .hud-fill { height: 100%; width: 0; background: #fff; border-radius: 2px; transition: background 300ms linear; }
  .hud-scale { font-size: 12px; opacity: 0.8; font-variant-numeric: tabular-nums; }

  /* Leave room for the fixed HUD so the title is never hidden behind it. */
  .intro { min-height: 78vh; display: grid; place-content: center; text-align: center; gap: 10px; padding: 150px 20px 0; }
  .intro h1 { font-size: clamp(38px, 9vw, 74px); margin: 0; letter-spacing: -0.03em; }
  .intro p { opacity: 0.75; margin: 0; font-size: 18px; }
  .arrow { font-size: 30px; opacity: 0.6; animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(10px); } }

  /* overflow-x: clip, not the default visible: a card's glow is a soft
     box-shadow blur, not a layout box, but browsers still count its painted
     extent as scrollable overflow. A card sitting near the right edge was
     giving the whole page an 8px horizontal scrollbar for a glow nobody
     could otherwise have scrolled to see the far side of. Vertical overflow
     is untouched — the reel's real height is what makes the page scroll. */
  .reel { position: relative; overflow-x: clip; }

  .ev {
    position: absolute; left: 50%; transform: translateX(-50%);
    width: min(90vw, 560px);
    /* A picture on the left and centred text beside it reads as two things
       that arrived separately, so the text is ranged left now. It also wraps
       far better in the 220px lane the dense clusters fall back to.

       minmax(0, 1fr), not a bare 1fr: an `fr` track's implicit minimum is
       `auto` — its content's own min-content width — so a bare `1fr` lets one
       long unbroken word refuse to shrink below its own width and grow the
       whole card, and with it the page, out past the viewport instead of
       wrapping. Invisible while the art column was small enough to leave the
       text room regardless; enlarging the art narrowed that room until a
       phone's side lane finally hit it, and the page gained a 60px
       horizontal scrollbar it should never have had. */
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center;
    gap: 14px; text-align: left;
    padding: 15px 19px; border-radius: 14px;
    /* Every card used to be one flat charcoal box regardless of what was
       inside it — a molten Earth and a snowball Earth in identical
       rectangles. --moodRgb is set inline per event from `MOOD` in
       time-art.ts, the same colour the scene's own drawing is dominated by,
       so the card is lit by the thing it is a card for. The default below is
       iron-grey and is the floor for an event with no art, which nothing on
       the page currently is. */
    --moodRgb: 138, 148, 160;
    /* Opaque enough to stay legible against both the near-black opening and
       the pale daylight of the final act — a gradient rather than a flat
       fill so the card reads as a surface catching light, not a sticker. */
    background: linear-gradient(165deg, rgba(24, 19, 38, 0.90), rgba(9, 7, 16, 0.90));
    border: 1px solid rgba(var(--moodRgb), 0.34);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 20px 44px -26px rgb(0 0 0 / 0.8),
      0 0 30px -8px rgba(var(--moodRgb), 0.4);
    transition: box-shadow 200ms var(--ease, ease), border-color 200ms var(--ease, ease);
  }
  .ev.lane-left { left: 50%; transform: translateX(-102%); width: min(44vw, 330px); }
  .ev.lane-right { left: 50%; transform: translateX(2%); width: min(44vw, 330px); }
  .ev.lane-left, .ev.lane-right { padding: 12px 15px; }
  .ev.lane-left h2, .ev.lane-right h2 { font-size: 19px; }
  .ev.lane-left p, .ev.lane-right p { font-size: 14px; }
  /* Scoped styles do not reach set:html content, so the svg carries its own
     sizing and this is only the window it fills. `slice` on the viewBox means
     the scene keeps its 3:2 composition and is cropped rather than squashed
     when the lane narrows. Bigger than it was (116px, and 72 in the side
     lanes) because at those sizes forty-four careful drawings were reading as
     icons rather than as the scenes they are — and lit by the scene's own
     colour rather than a flat white hairline, the same device the frame
     itself uses. */
  .ev-art {
    width: 172px; aspect-ratio: 3 / 2;
    border-radius: 10px; overflow: hidden;
    border: 1px solid rgba(var(--moodRgb), 0.6);
    box-shadow: 0 0 28px -5px rgba(var(--moodRgb), 0.6), inset 0 0 0 1px rgb(0 0 0 / 0.35);
  }
  .ev.lane-left .ev-art, .ev.lane-right .ev-art { width: 104px; }

  /* The major turning points — eleven of forty-four — get a stronger version
     of the same treatment rather than a different one: more glow, a brighter
     rim, a bigger picture. It is still a card of the same species as its
     neighbours, just the one worth stopping at. */
  .ev.big {
    background: linear-gradient(165deg, rgba(28, 22, 44, 0.94), rgba(9, 7, 16, 0.94));
    border-color: rgba(var(--moodRgb), 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.09),
      0 24px 54px -26px rgb(0 0 0 / 0.85),
      0 0 52px -8px rgba(var(--moodRgb), 0.55);
  }
  .ev.big h2 { font-size: 30px; }
  .ev.big .ev-art { width: 220px; box-shadow: 0 0 40px -6px rgba(var(--moodRgb), 0.75), inset 0 0 0 1px rgb(0 0 0 / 0.35); }
  .ev.lane-left.big h2, .ev.lane-right.big h2 { font-size: 23px; }
  .ev.lane-left.big .ev-art, .ev.lane-right.big .ev-art { width: 128px; }

  /* Fired once, by the scroll-triggered chime's own IntersectionObserver, the
     moment a major event first centres in view — see the JS. A brief pulse
     rather than a state, because the observer never asks about this card
     again: it is a record that you were here for this one, not a hover.

     box-shadow only, deliberately — `.ev` already spends its `transform` on
     centring (`translateX(-50%)`, or -102%/2% in the side lanes), and a
     `transform` step inside this keyframe would replace that value rather
     than combine with it. It did, the first time this was written: the
     card's own centring vanished the instant the animation finished, and it
     sat 220px off centre until the next reload. */
  @keyframes seen-pulse {
    0%   { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.09), 0 24px 54px -26px rgb(0 0 0 / 0.85), 0 0 30px -8px rgba(var(--moodRgb), 0.35); }
    45%  { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16), 0 28px 62px -24px rgb(0 0 0 / 0.92), 0 0 80px -6px rgba(var(--moodRgb), 0.95); }
    100% { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.09), 0 24px 54px -26px rgb(0 0 0 / 0.85), 0 0 52px -8px rgba(var(--moodRgb), 0.55); }
  }
  .ev.big.focused { animation: seen-pulse 820ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }

  /* Set by the runtime layout pass when a cluster is too dense for two lanes.
     The picture shrinks first and only goes at the tier that has already given
     up the date, because it is the most of the card, not the least. */
  .ev.compact p { display: none; }
  .ev.compact .ev-art { width: 64px; }
  .ev.compact-hard .ev-when { display: none; }
  .ev.compact-hard .ev-art { display: none; }
  .ev.compact-hard { padding: 9px 12px; grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 620px) {
    .ev.lane-left, .ev.lane-right { width: min(46vw, 220px); }
    .ev.lane-left { transform: translateX(-104%); }

    /* A square crop, not a smaller 3:2 one, and the padding comes in with it.
     *
     * The measurement that decided this: a phone's side lane is 172px, and a
     * 50px picture beside the text left 113px of column, which wrapped the
     * titles onto more lines and made the cards taller. Taller cards collide,
     * and colliding cards get compacted — so the pictures pushed twelve cards
     * into the tier that *drops the picture*, up from three. The art was
     * spending its own budget.
     *
     * Almost none of that cost was the art's height; it was the text column.
     * A 38px square gives 20px of it back and the padding gives the rest, and
     * the count returns to close to what it was with no art at all. The svg's
     * own preserveAspectRatio means the square is a centre crop of the scene
     * rather than a squashed one. */
    .ev.lane-left .ev-art, .ev.lane-right .ev-art { width: 38px; aspect-ratio: 1 / 1; }
    .ev.lane-left.big .ev-art, .ev.lane-right.big .ev-art { width: 46px; }
    .ev.lane-left, .ev.lane-right { padding: 8px 10px; }
    .ev { gap: 7px; }
  }
  .ev-when {
    font-size: 12px; letter-spacing: 0.10em; text-transform: uppercase;
    opacity: 0.75; font-variant-numeric: tabular-nums;
