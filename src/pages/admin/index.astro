  .ad-section p { margin: 4px 0 0; font-size: 13.5px; color: var(--ink3); max-width: 80ch; }
  .ad-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
  .ad-card { min-width: 0; padding: 18px 20px 20px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .ad-card.span-1 { grid-column: span 1; } .ad-card.span-2 { grid-column: span 2; } .ad-card.span-3 { grid-column: span 3; } .ad-card.span-4, .ad-card.span-full { grid-column: 1 / -1; }
  @media (max-width: 1100px) { .ad-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ad-card.span-1 { grid-column: span 1; } .ad-card.span-2, .ad-card.span-3 { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .ad-grid { grid-template-columns: minmax(0, 1fr); } .ad-card.span-1 { grid-column: 1 / -1; } .ad-filters { position: static; } .ad-grow { display: none; } }
  .ad-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
  .ad-card h3, .ad-section h2 { font-family: var(--sans); letter-spacing: 0; }
  .ad-card h3 { margin: 0; font-size: 15px; font-weight: 700; color: var(--ink); }
  .ad-sub { margin: 3px 0 0; font-size: 12.5px; color: var(--ink3); line-height: 1.4; }
  .ad-card-acts { display: flex; gap: 6px; flex: none; }
  .ad-empty { margin: 8px 0; color: var(--ink3); font-size: 14px; }

  .ad-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .ad-svg .ax-grid { stroke: var(--grid); stroke-width: 1; }
  .ad-svg .ax-base { stroke: var(--axis); stroke-width: 1; }
  .ad-svg .ax-t { fill: var(--ink3); font: 500 11.5px var(--sans); }
  .ad-svg .ax-cross { stroke: var(--ink3); stroke-width: 1; }
  .ad-svg .line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .ad-svg .line.is-dashed { stroke-dasharray: 2 4; }
  .ad-svg .area { opacity: 0.12; }
  .ad-svg .dot { stroke: var(--surface); stroke-width: 2; }
  .ad-svg .bar { transition: opacity 0.15s; }
  .ad-svg .bar.is-on { opacity: 0.75; }
  .ad-svg .hit { cursor: crosshair; outline: none; }
  .ad .line.s1, .ad .ad-spark .line { stroke: var(--s1); } .ad .line.s2 { stroke: var(--s2); } .ad .line.s3 { stroke: var(--s3); } .ad .line.s4 { stroke: var(--s4); }
  .ad .area.s1, .ad .dot.s1, .ad .bar.s1 { fill: var(--s1); } .ad .area.s2, .ad .dot.s2, .ad .bar.s2 { fill: var(--s2); } .ad .area.s3, .ad .dot.s3, .ad .bar.s3 { fill: var(--s3); } .ad .area.s4, .ad .dot.s4, .ad .bar.s4 { fill: var(--s4); }
