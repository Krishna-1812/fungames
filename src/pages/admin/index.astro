  .ad-login { display: grid; place-items: center; min-height: 60vh; }
  .ad-login-card { width: min(400px, 100%); padding: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: 24px; box-shadow: var(--shadow); }
  .ad-login-card h2 { margin: 0 0 6px; font-family: var(--display); font-size: 28px; color: var(--ink); }
