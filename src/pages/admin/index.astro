  .ad-legend.is-values { margin: 12px 0 0; }
  .ad-key { display: inline-block; width: 14px; height: 2.5px; border-radius: 2px; background: var(--s1); }
  .ad-key.box { width: 10px; height: 10px; border-radius: 3px; }
  .ad .ad-key.s2 { background: var(--s2); } .ad .ad-key.s3 { background: var(--s3); } .ad .ad-key.s4 { background: var(--s4); }
  .ad .ad-key.is-dashed { background: repeating-linear-gradient(90deg, var(--s3) 0 3px, transparent 3px 6px); }

  .ad-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
