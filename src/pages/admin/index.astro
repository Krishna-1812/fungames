  .ad-bars > li::before { content: ''; position: absolute; z-index: -1; inset: 0 auto 0 0; width: var(--w); border-radius: 9px; background: color-mix(in srgb, var(--s1) 16%, transparent); }
  .ad-bars > li.s2::before { background: color-mix(in srgb, var(--s2) 18%, transparent); } .ad-bars > li.s3::before { background: color-mix(in srgb, var(--s3) 18%, transparent); } .ad-bars > li.s4::before { background: color-mix(in srgb, var(--s4) 20%, transparent); }
  .ad-bar-btn { all: unset; display: flex; align-items: center; gap: 10px; width: 100%; min-width: 0; cursor: pointer; }
  .ad-bar-btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; border-radius: 6px; }
  .ad-bars > li:has(.ad-bar-btn):hover { background: var(--surface-2); }
  .ad-bar-k { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
  .ad-bar-note { color: var(--ink3); font-size: 12px; white-space: nowrap; }
  .ad-bar-v { font-weight: 700; color: var(--ink2); white-space: nowrap; }
  .ad-bars-more { font-size: 12.5px; color: var(--ink3); padding: 4px 10px; }

  .ad-stack { display: flex; gap: 2px; height: 14px; border-radius: 5px; overflow: hidden; margin-top: 4px; }
  .ad-stack.thin { height: 6px; margin: 10px 0 2px; }
  .ad-stack span { min-width: 3px; background: var(--s1); }
  .ad .ad-stack .s2 { background: var(--s2); } .ad .ad-stack .s3 { background: var(--s3); } .ad .ad-stack .s4 { background: var(--s4); }
  .ad .ad-stack .s7 { background: var(--good); } .ad .ad-stack .s8 { background: var(--mid); } .ad .ad-stack .s9 { background: var(--poor); }

  .ad-ramp { display: flex; align-items: center; gap: 3px; margin-top: 10px; font-size: 12px; color: var(--ink3); }
  .ad-ramp i { width: 22px; height: 9px; border-radius: 2px; }
  .ad-ramp span:first-child { margin-right: 4px; } .ad-ramp span:last-child { margin-left: 4px; }
  .ad .q0 { background: var(--q0); fill: var(--q0); } .ad .q1 { background: var(--q1); fill: var(--q1); } .ad .q2 { background: var(--q2); fill: var(--q2); }
  .ad .q3 { background: var(--q3); fill: var(--q3); } .ad .q4 { background: var(--q4); fill: var(--q4); } .ad .q5 { background: var(--q5); fill: var(--q5); }

  .ad-week { display: grid; grid-template-columns: 34px repeat(24, minmax(0, 1fr)); gap: 2px; font-size: 11px; color: var(--ink3); }
  .ad-week-h { text-align: left; font-variant-numeric: tabular-nums; }
  .ad-week-d { display: flex; align-items: center; font-weight: 600; }
  .ad-cell { aspect-ratio: 1.5; min-height: 12px; border-radius: 3px; outline-offset: 1px; }
  .ad-cell:hover { outline: 2px solid var(--ink); }

  .ad-map { display: block; width: 100%; height: auto; }
  .ad-land { stroke: var(--surface); stroke-width: 0.25; transition: opacity 0.15s; }
  .ad-land:hover, .ad-land:focus { opacity: 0.75; outline: none; }
  .ad-dot-ring { fill: color-mix(in srgb, var(--s4) 35%, transparent); animation: ad-ring 2.4s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  .ad-dot-core { fill: var(--s4); stroke: var(--surface); stroke-width: 0.4; }
  @keyframes ad-ring { 0% { transform: scale(0.4); opacity: 1; } 100% { transform: scale(1.6); opacity: 0; } }

  .ad-funnel { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ad .ad-funnel li { position: relative; display: grid; grid-template-columns: 1fr auto; padding: 10px 12px; border-radius: 10px; isolation: isolate; background: none; }
  .ad-funnel li::before { content: ''; position: absolute; z-index: -1; inset: 0 auto 0 0; width: var(--w); min-width: 4px; border-radius: 10px; background: var(--q2); opacity: 0.6; }
  .ad-funnel li.q5::before { background: var(--q5); } .ad-funnel li.q4::before { background: var(--q4); } .ad-funnel li.q3::before { background: var(--q3); }
  .ad-funnel-k { font-weight: 700; font-size: 14px; color: var(--ink); }
  .ad-funnel-v { font-size: 13px; color: var(--ink2); text-align: right; }
  .ad-funnel-v b { color: var(--ink); }
  .ad-funnel-step { grid-column: 1 / -1; font-size: 12px; color: var(--ink2); margin-top: 2px; }

  .ad-scroll { overflow-x: auto; }
  .ad-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .ad-table th, .ad-table td { padding: 9px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  /* Tabular figures only where numbers line up: in Zalando Sans they widen the spaces too. */
  .ad-table td.a-r { font-variant-numeric: tabular-nums; }
  .ad-table .a-l { text-align: left; } .ad-table .a-r { text-align: right; }
  .ad-table td.a-l { white-space: normal; min-width: 120px; }
  .ad-table thead th { font-size: 12px; font-weight: 600; color: var(--ink3); }
  .ad-table thead button { all: unset; cursor: pointer; }
  .ad-table thead button:focus-visible { outline: 2px solid var(--focus); }
  .ad-table thead button[aria-sort='descending']::after { content: ' ↓'; } .ad-table thead button[aria-sort='ascending']::after { content: ' ↑'; }
  .ad-table tbody th { font-weight: 600; color: var(--ink); }
  .ad-table tbody tr.is-link { cursor: pointer; }
  .ad-table tbody tr:hover { background: var(--surface-2); }

  .ad-feed { list-style: none; margin: 0; padding: 0; display: grid; }
  .ad-feed li { display: grid; grid-template-columns: 130px minmax(120px, 210px) 1fr auto; gap: 12px; align-items: baseline; padding: 8px 6px; border-bottom: 1px solid var(--line); font-size: 13px; color: var(--ink2); }
  .ad-feed b { color: var(--ink); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ad-feed-p { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ad-ev { justify-self: start; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--ink); background: color-mix(in srgb, var(--s1) 16%, transparent); white-space: nowrap; }
  .ad-ev.k-game { background: color-mix(in srgb, var(--s2) 20%, transparent); } .ad-ev.k-isl { background: color-mix(in srgb, var(--s3) 18%, transparent); } .ad-ev.k-error { background: color-mix(in srgb, var(--poor) 22%, transparent); }
  .ad-dim { color: var(--ink3); font-weight: 500; }
  @media (max-width: 760px) { .ad-feed li { grid-template-columns: 1fr; gap: 2px; } }

  .ad-game-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin: 4px 0 16px; }
  .ad-game-head h2 { margin: 0; font-family: var(--display); font-size: clamp(26px, 3vw, 36px); color: var(--ink); }
  .ad-back { min-height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); cursor: pointer; font-weight: 600; font-size: 13.5px; }
  .ad-open { margin-left: auto; font-size: 13.5px; font-weight: 600; color: var(--s1); }
  .ad-games td:nth-child(2) { width: 100px; }

  .ad-vitals { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-bottom: 18px; }
  .ad-vital { padding: 16px 18px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .ad-vital p { margin: 0; }
  .ad-status { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 700; color: var(--ink); }
  .ad-status i { display: inline-grid; place-items: center; width: 17px; height: 17px; border-radius: 50%; font-style: normal; font-size: 10.5px; color: #fff; }
  .ad-status.is-good i { background: var(--good); } .ad-status.is-mid i { background: var(--mid); } .ad-status.is-poor i { background: var(--poor); }

  /* ---- phase 3: the crowd, journeys, return visits, the island, errors ---- */
  .ad-banner { margin: 0 0 16px; padding: 10px 14px; border-radius: 12px; font-size: 13.5px; line-height: 1.45; color: var(--ink2); background: color-mix(in srgb, var(--s3) 10%, var(--surface)); border: 1px solid color-mix(in srgb, var(--s3) 28%, transparent); }
  .ad-banner b { color: var(--ink); }
  .ad-key.box { width: 11px; height: 11px; border-radius: 3px; }
  .ad .ad-key.s2 { background: var(--s2); } .ad .ad-key.s3 { background: var(--s3); } .ad .ad-key.s4 { background: var(--s4); } .ad .ad-key.so { background: var(--axis); }
  .ad-key.is-range { height: 2px; background: var(--axis); } .ad-key.is-iqr { height: 6px; border-radius: 3px; background: var(--s1); }

