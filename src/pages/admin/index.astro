  .ad-login-card label { display: block; font-size: 13px; font-weight: 600; color: var(--ink2); margin-bottom: 6px; }
  .ad-login-card input { box-sizing: border-box; width: 100%; height: 46px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--page); font-size: 16px; }
  .ad-login-card button { margin-top: 14px; width: 100%; height: 46px; border: 0; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-weight: 700; font-size: 15px; cursor: pointer; }
  .ad-login-card button:disabled { opacity: 0.6; }
  .ad-err { min-height: 1.3em; margin: 12px 0 0 !important; color: var(--down) !important; }
  .ad-note { padding: 20px 24px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); color: var(--ink2); }

  .ad-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(196px, calc(50% - 6px)), 1fr)); gap: 12px; margin-bottom: 18px; }
  @media (max-width: 640px) { .ad-stat { padding: 13px 13px 12px 16px; } .ad-stat-v { font-size: 24px; } .ad-card { padding: 16px 14px 16px; } }
  .ad-stat { position: relative; padding: 16px 18px 15px 20px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); overflow: hidden; }
  .ad-stat::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--s1); }
  .ad-stat.k2::before { background: var(--s2); } .ad-stat.k3::before { background: var(--s3); } .ad-stat.k4::before { background: var(--s4); }
  .ad-stat p { margin: 0; }
  .ad-stat-l { font-size: 12.5px; font-weight: 600; color: var(--ink2); }
  .ad-stat-v { font-size: clamp(26px, 2.3vw, 34px); font-weight: 800; letter-spacing: -0.02em; margin: 6px 0 4px !important; color: var(--ink); line-height: 1.1; }
  .ad-stat-s { font-size: 12.5px; color: var(--ink3); margin-top: 4px !important; line-height: 1.4; }
  .ad-delta { display: inline-block; font-size: 12.5px; font-weight: 700; }
  .ad-delta.is-up { color: var(--up); } .ad-delta.is-down { color: var(--down); } .ad-delta.is-flat { color: var(--ink3); } .ad-delta.is-new { color: var(--s1); }

  .ad-section { margin: 26px 0 12px; }
