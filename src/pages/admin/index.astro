---
/**
 * /admin/ — the site's analytics, for its owner only.
 *
 * The page itself is static and holds no data: it asks /api/admin/stats/,
 * which answers only with a valid session cookie (src/lib/analytics/auth.ts),
 * and shows a password box otherwise. Never linked, never indexed, left out
 * of the sitemap and robots.txt. Signing in also tells this browser to stop
 * counting its own visits.
 *
 * Phase 1 of 3: the overview (the numbers that matter, the traffic, every
 * game, where visitors are from and on what, how fast the pages are, what
 * broke, who is here now, and the latest events). Phase 2 is the full
 * dashboard; phase 3 the deep views.
 */
import Paper from '../../layouts/Paper.astro'
import { SITE } from '../../site.config'
import { listedGames, GAMES } from '../../data/games'

const titles = Object.fromEntries(GAMES.map((g) => [g.slug, g.title]))
const listed = listedGames().length
---

<Paper title={`Analytics — ${SITE.name}`} noindex masthead={false} colophon={false} themeColor="#0b1029" colorScheme="dark" bodyClass="ad-body">
  <main id="main" class="ad">
    <header class="ad-top">
      <div class="ad-brand">
        <span class="ad-mark" aria-hidden="true"></span>
        <div>
          <p class="ad-kicker">{SITE.name}</p>
          <h1 class="ad-h1">Analytics</h1>
        </div>
      </div>
      <div class="ad-tools" id="adTools" hidden>
        <p class="ad-live" id="adLive"><span class="ad-live-dot" aria-hidden="true"></span><b id="adLiveN">0</b> here now</p>
        <div class="ad-range" role="group" aria-label="Period">
          <button type="button" data-days="1">24 h</button>
          <button type="button" data-days="7" aria-pressed="true">7 days</button>
          <button type="button" data-days="30">30 days</button>
          <button type="button" data-days="90">90 days</button>
        </div>
        <button type="button" class="ad-ghost" id="adRefresh">Refresh</button>
        <button type="button" class="ad-ghost" id="adOut">Sign out</button>
      </div>
    </header>

    <section class="ad-login" id="adLogin" hidden>
      <form class="ad-login-card" id="adForm">
        <h2>Sign in</h2>
        <p>The password is the <code>ADMIN_PASSWORD</code> set in the Vercel project.</p>
        <label for="adPw">Password</label>
        <input id="adPw" name="password" type="password" autocomplete="current-password" required />
        <button type="submit" id="adGo">Sign in</button>
        <p class="ad-err" id="adErr" role="alert"></p>
      </form>
    </section>

    <p class="ad-note" id="adNote" hidden></p>

    <div class="ad-dash" id="adDash" hidden>
      <section class="ad-kpis" id="adKpis" aria-label="Headline numbers"></section>

      <section class="ad-card ad-wide">
        <div class="ad-card-head"><h2>Traffic</h2><p class="ad-legend"><i class="k-vis"></i>Visitors <i class="k-views"></i>Page views</p></div>
        <div class="ad-chart" id="adChart"></div>
      </section>

      <section class="ad-card ad-wide">
        <div class="ad-card-head"><h2>Games</h2><p class="ad-sub" id="adGamesSub"></p></div>
        <div class="ad-scroll"><table class="ad-table" id="adGames"></table></div>
      </section>

      <div class="ad-grid">
        <section class="ad-card"><h2>Pages</h2><ol class="ad-bars" id="adPages"></ol></section>
        <section class="ad-card"><h2>Countries</h2><ol class="ad-bars" id="adCountries"></ol></section>
        <section class="ad-card"><h2>Came from</h2><ol class="ad-bars" id="adRefs"></ol></section>
        <section class="ad-card"><h2>Devices</h2><ol class="ad-bars" id="adDevices"></ol></section>
        <section class="ad-card"><h2>Browsers</h2><ol class="ad-bars" id="adBrowsers"></ol></section>
        <section class="ad-card"><h2>Systems</h2><ol class="ad-bars" id="adOs"></ol></section>
      </div>

      <div class="ad-grid">
        <section class="ad-card"><h2>Speed <span class="ad-sub">75th percentile</span></h2><div class="ad-vitals" id="adVitals"></div></section>
        <section class="ad-card"><h2>Here now</h2><ol class="ad-feed" id="adNow"></ol></section>
        <section class="ad-card"><h2>Errors</h2><ol class="ad-feed" id="adErrors"></ol></section>
      </div>

      <section class="ad-card ad-wide">
        <h2>Latest events</h2>
        <ol class="ad-feed ad-events" id="adEvents"></ol>
      </section>
    </div>
  </main>

  <script type="application/json" id="adData" set:html={JSON.stringify({ titles, listed })} />
</Paper>

<script>
  const { titles, listed } = JSON.parse(document.getElementById('adData')!.textContent!) as { titles: Record<string, string>; listed: number }
  const $ = (id: string) => document.getElementById(id)!
  // Everything shown came from visitors' browsers: escape all of it.
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!)
  const fmt = (n: number) => (n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e4 ? Math.round(n / 1e3) + 'k' : n.toLocaleString())
  const dur = (ms: number) => { const s = Math.round(ms / 1000); return s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, '0')}s` }
  const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) + '%' : '–')
  const ago = (t: string) => { const s = Math.max(0, Math.round((Date.now() - new Date(t).getTime()) / 1000)); return s < 60 ? `${s}s ago` : s < 3600 ? `${Math.floor(s / 60)}m ago` : s < 86400 ? `${Math.floor(s / 3600)}h ago` : `${Math.floor(s / 86400)}d ago` }
  const regionName = (() => { try { const d = new Intl.DisplayNames(undefined, { type: 'region' }); return (c: string) => d.of(c) ?? c } catch { return (c: string) => c } })()
  const gameName = (s: string | null) => (s ? titles[s] ?? s : '')

  let days = 7
  // ?test=1 on this page includes the traffic test runs mark as theirs (left out otherwise).
  const withTest = new URLSearchParams(location.search).get('test') === '1'
  let timer = 0

  type Kpis = { views: number; visitors: number; engagedMs: number; starts: number; ends: number; wins: number; shares: number; dives: number; errors: number; withId: number }
  type Row = { k: string; views: number; visitors: number }
  type Stats = {
    kpis: Kpis; prev: Kpis; series: { t: string; views: number; visitors: number }[]
    games: Record<string, number | string>[]; pages: Row[]; countries: Row[]; devices: Row[]; browsers: Row[]; os: Row[]; refs: Row[]
    vitals: { metric: string; n: number; p75: number }[]; errors: { msg: string; n: number; pages: number; last: string }[]
    recent: { ts: string; name: string; game: string | null; props: Record<string, unknown>; path: string; country: string | null; city: string | null; device: string | null }[]
    live: { now: number; pages: { path: string; game: string | null; country: string | null; city: string | null; device: string | null; seen: string }[] }
    range: { bucket: 'hour' | 'day' }
  }

  function show(which: 'login' | 'dash' | 'note', note = '') {
    $('adLogin').hidden = which !== 'login'
    $('adDash').hidden = which !== 'dash'
    $('adTools').hidden = which !== 'dash'
    $('adNote').hidden = !note
    $('adNote').textContent = note
  }

  async function load() {
    clearTimeout(timer)
    let r: Response
    try { r = await fetch(`/api/admin/stats/?days=${days}&tz=${encodeURIComponent(Intl.DateTimeFormat().resolvedOptions().timeZone)}${withTest ? '&test=1' : ''}`, { cache: 'no-store' }) }
    catch { show('note', 'The site could not be reached. Check the connection and refresh.'); return }
    if (r.status === 401) { show('login'); $('adPw').focus(); return }
    const body = await r.json().catch(() => ({}))
    if (!r.ok) { show('note', body.error ?? 'Something went wrong.'); return }
    try { localStorage.setItem('funsite:admin', '1') } catch {}
    show('dash')
    render(body as Stats)
    timer = window.setTimeout(load, 60_000)
  }

  /* ---- the pieces ------------------------------------------------------ */

  function delta(now: number, before: number, invert = false) {
    if (!before) return now ? '<span class="d-new">new</span>' : ''
    const d = Math.round(((now - before) / before) * 100)
    if (!d) return '<span class="d-flat">±0%</span>'
    const good = invert ? d < 0 : d > 0
    return `<span class="${good ? 'd-up' : 'd-down'}">${d > 0 ? '▲' : '▼'} ${Math.abs(d)}%</span>`
  }

  function kpis(s: Stats) {
    const k = s.kpis, p = s.prev
    const tiles: [string, string, string, string][] = [
      ['Visitors', fmt(k.visitors), delta(k.visitors, p.visitors), `${pct(k.withId, k.visitors)} with an ID`],
      ['Page views', fmt(k.views), delta(k.views, p.views), `${(k.views / Math.max(1, k.visitors)).toFixed(1)} a visitor`],
      ['Games started', fmt(k.starts), delta(k.starts, p.starts), `${fmt(k.dives)} from the island`],
      ['Games finished', fmt(k.ends), delta(k.ends, p.ends), `${pct(k.ends, k.starts)} of starts`],
      ['Time on a page', dur(k.engagedMs), delta(k.engagedMs, p.engagedMs), 'actually looked at'],
      ['Shares', fmt(k.shares), delta(k.shares, p.shares), `${fmt(k.errors)} script errors`],
    ]
    $('adKpis').innerHTML = tiles.map(([label, v, d, sub], i) => `
      <div class="ad-kpi" style="--i:${i}"><p class="ad-kpi-label">${label}</p><p class="ad-kpi-v">${v}</p><p class="ad-kpi-d">${d}</p><p class="ad-kpi-sub">${esc(sub)}</p></div>`).join('')
  }

  function chart(s: Stats) {
    const pts = s.series
    const el = $('adChart')
    if (!pts.length) { el.innerHTML = '<p class="ad-empty">No visits in this period yet.</p>'; return }
    const W = 1000, H = 260, L = 44, B = 28, T = 12
    const max = Math.max(1, ...pts.map((p) => p.views))
    const x = (i: number) => L + (pts.length === 1 ? (W - L) / 2 : (i / (pts.length - 1)) * (W - L - 8))
    const y = (v: number) => T + (1 - v / max) * (H - T - B)
    const line = (key: 'views' | 'visitors') => pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p[key]).toFixed(1)}`).join('')
    const area = (key: 'views' | 'visitors') => `${line(key)}L${x(pts.length - 1).toFixed(1)},${H - B}L${x(0).toFixed(1)},${H - B}Z`
    const ticks = [0, 0.5, 1].map((f) => Math.round(max * f))
    const every = Math.max(1, Math.ceil(pts.length / 8))
    const label = (t: string) => s.range.bucket === 'hour' ? t.slice(11, 16) : new Date(t.slice(0, 10) + 'T12:00').toLocaleDateString(undefined, { day: 'numeric', month: 'short' })
    el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Visitors and page views over the period">
      <defs><linearGradient id="gv" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6debcd" stop-opacity=".35"/><stop offset="1" stop-color="#6debcd" stop-opacity="0"/></linearGradient></defs>
      ${ticks.map((v) => `<line x1="${L}" x2="${W}" y1="${y(v)}" y2="${y(v)}" class="g"/><text x="${L - 8}" y="${y(v) + 4}" class="ax" text-anchor="end">${fmt(v)}</text>`).join('')}
      <path d="${line('views')}" class="l-views"/>
      <path d="${area('visitors')}" fill="url(#gv)"/>
      <path d="${line('visitors')}" class="l-vis"/>
      ${pts.map((p, i) => `<g class="pt"><circle cx="${x(i)}" cy="${y(p.visitors)}" r="3.5" class="c-vis"/><title>${esc(label(p.t))}: ${p.visitors} visitors, ${p.views} views</title></g>`).join('')}
      ${pts.map((p, i) => (i % every ? '' : `<text x="${x(i)}" y="${H - 8}" class="ax" text-anchor="middle">${esc(label(p.t))}</text>`)).join('')}
    </svg>`
  }

  function games(s: Stats) {
    const rows = s.games
    $('adGamesSub').textContent = `${rows.length} of ${listed} games visited in this period`
    const head = '<thead><tr><th scope="col">Game</th><th>Visitors</th><th>Views</th><th>Started</th><th>Finished</th><th>Won</th><th>From island</th><th>Shares</th><th>Restarts</th><th>Time</th></tr></thead>'
    const top = Math.max(1, ...rows.map((r) => Number(r.visitors)))
    $('adGames').innerHTML = head + '<tbody>' + (rows.length ? rows.map((r) => {
      const v = Number(r.visitors)
      return `<tr><th scope="row"><span class="ad-gname">${esc(gameName(String(r.game)))}</span><span class="ad-gbar" style="--w:${(v / top) * 100}%"></span></th>
        <td>${fmt(v)}</td><td>${fmt(Number(r.views))}</td><td>${fmt(Number(r.starts))}</td>
        <td>${fmt(Number(r.ends))} <span class="ad-dim">${pct(Number(r.ends), Number(r.starts))}</span></td>
        <td>${pct(Number(r.wins), Number(r.ends))}</td><td>${fmt(Number(r.dives))}</td><td>${fmt(Number(r.shares))}</td><td>${fmt(Number(r.restarts))}</td>
        <td>${Number(r.engagedMs) ? dur(Number(r.engagedMs)) : '–'}</td></tr>`
    }).join('') : '<tr><td colspan="10" class="ad-empty">No game has been opened in this period yet.</td></tr>') + '</tbody>'
  }

  function bars(id: string, rows: Row[], name: (k: string) => string = (k) => k) {
    const top = Math.max(1, ...rows.map((r) => r.visitors))
    $(id).innerHTML = rows.length
      ? rows.map((r) => `<li style="--w:${(r.visitors / top) * 100}%"><span class="ad-bar-k">${esc(name(r.k))}</span><span class="ad-bar-v">${fmt(r.visitors)}</span></li>`).join('')
      : '<li class="ad-empty">Nothing yet.</li>'
  }

  // Google's own lines for good and poor, per metric.
  const VITALS: Record<string, { good: number; poor: number; unit: 'ms' | '' ; name: string }> = {
    LCP: { good: 2500, poor: 4000, unit: 'ms', name: 'Largest paint' },
    INP: { good: 200, poor: 500, unit: 'ms', name: 'Response to input' },
    CLS: { good: 0.1, poor: 0.25, unit: '', name: 'Layout shift' },
    FCP: { good: 1800, poor: 3000, unit: 'ms', name: 'First paint' },
    TTFB: { good: 800, poor: 1800, unit: 'ms', name: 'Server response' },
  }
  function vitals(s: Stats) {
    const by = Object.fromEntries(s.vitals.map((v) => [v.metric, v]))
    $('adVitals').innerHTML = Object.entries(VITALS).map(([k, m]) => {
      const v = by[k]
      if (!v) return `<div class="ad-vital"><p>${m.name} <span class="ad-dim">${k}</span></p><p class="ad-vital-v ad-dim">–</p></div>`
      const rate = v.p75 <= m.good ? 'good' : v.p75 <= m.poor ? 'mid' : 'poor'
      const val = m.unit === 'ms' ? (v.p75 >= 1000 ? (v.p75 / 1000).toFixed(2) + ' s' : Math.round(v.p75) + ' ms') : v.p75.toFixed(3)
      return `<div class="ad-vital is-${rate}"><p>${m.name} <span class="ad-dim">${k} · ${fmt(v.n)}</span></p><p class="ad-vital-v">${val}</p></div>`
    }).join('')
  }

  const where = (c: string | null, city: string | null) => [city, c ? regionName(c) : null].filter(Boolean).map(esc).join(', ') || 'somewhere'
  function now(s: Stats) {
    $('adLiveN').textContent = String(s.live.now)
    $('adLive').classList.toggle('is-on', s.live.now > 0)
    $('adNow').innerHTML = s.live.pages.length
      ? s.live.pages.slice(0, 12).map((p) => `<li><b>${esc(p.game ? gameName(p.game) : p.path)}</b><span>${where(p.country, p.city)} · ${esc(p.device ?? '')} · ${ago(p.seen)}</span></li>`).join('')
      : '<li class="ad-empty">Nobody in the last five minutes.</li>'
    $('adErrors').innerHTML = s.errors.length
      ? s.errors.map((e) => `<li><b>${esc(e.msg)}</b><span>${e.n}× on ${e.pages} page${e.pages === 1 ? '' : 's'} · ${ago(e.last)}</span></li>`).join('')
      : '<li class="ad-empty">No errors. Lovely.</li>'
  }

  const EV: Record<string, string> = {
    game_start: 'started', game_end: 'finished', game_result: 'result', game_best: 'personal best', game_level: 'level', game_restart: 'restarted',
    game_pause: 'paused', game_howto: 'read how to play', sound: 'sound', share: 'shared', vital: 'speed', error: 'error', outbound: 'left for',
    notfound: 'hit a 404', consent: 'consent', isl_dive: 'dived into', isl_card: 'looked at', isl_search: 'searched', isl_filter: 'filtered',
    isl_surprise: 'surprise me', isl_today: 'today', isl_board: 'noticeboard', isl_board_go: 'noticeboard →', isl_poke: 'poked', isl_bottle: 'found a bottle',
    isl_postcard: 'postcard', isl_passport: 'passport', isl_cover: 'cover', isl_time: 'day/night', isl_welcome: 'welcome', isl_minimap: 'mini-map',
    isl_ball: 'threw the ball', isl_pigeons: 'put up the pigeons', isl_session: 'explored the island', isl_fps: 'island fps',
  }
  const propsText = (p: Record<string, unknown>) => Object.entries(p ?? {}).slice(0, 5).map(([k, v]) => `${esc(k)}: ${esc(v)}`).join(' · ')
  function events(s: Stats) {
    $('adEvents').innerHTML = s.recent.length
      ? s.recent.map((e) => `<li><span class="ad-ev ad-ev-${esc(e.name.split('_')[0])}">${esc(EV[e.name] ?? e.name)}</span>
          <b>${esc(e.game ? gameName(e.game) : e.path)}</b><span>${propsText(e.props)}</span>
          <span class="ad-dim">${where(e.country, e.city)} · ${esc(e.device ?? '')} · ${ago(e.ts)}</span></li>`).join('')
      : '<li class="ad-empty">Nothing has happened yet. Open a game in another browser and it shows up here.</li>'
  }

  function render(s: Stats) {
    kpis(s); chart(s); games(s)
    bars('adPages', s.pages, (k) => (k === '/' ? 'The island (home)' : k))
    bars('adCountries', s.countries, regionName)
    bars('adRefs', s.refs)
    bars('adDevices', s.devices, (k) => k[0].toUpperCase() + k.slice(1))
    bars('adBrowsers', s.browsers)
    bars('adOs', s.os)
    vitals(s); now(s); events(s)
  }

  /* ---- sign in, sign out, the period ------------------------------------ */

  $('adForm').addEventListener('submit', async (e) => {
    e.preventDefault()
    const go = $('adGo') as HTMLButtonElement
    go.disabled = true; $('adErr').textContent = ''
    try {
      const r = await fetch('/api/admin/login/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: ($('adPw') as HTMLInputElement).value }) })
      const b = await r.json().catch(() => ({}))
      if (!r.ok) { $('adErr').textContent = b.error ?? 'That did not work.'; return }
      ;($('adPw') as HTMLInputElement).value = ''
      await load()
    } catch { $('adErr').textContent = 'The site could not be reached.' }
    finally { go.disabled = false }
  })
  $('adOut').addEventListener('click', async () => {
    await fetch('/api/admin/logout/', { method: 'POST' }).catch(() => {})
    try { localStorage.removeItem('funsite:admin') } catch {}
    clearTimeout(timer)
    show('login')
  })
  $('adRefresh').addEventListener('click', load)
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-days]')) b.addEventListener('click', () => {
    days = Number(b.dataset.days)
    for (const o of document.querySelectorAll('[data-days]')) o.setAttribute('aria-pressed', String(o === b))
    load()
  })
  load()
</script>

<style is:global>
  body.ad-body { background: #0b1029; color: #e6eaff; }
  body.ad-body .skip, body.ad-body .progress-bar { display: none; }
</style>

<style is:global>
  /* Global, not scoped: nearly everything here is built by the script at run time,
     which scoped styles never reach. Every selector starts from an ad- class. */
  .ad {
    --bg: #0b1029; --card: #121a3d; --card2: #18214a; --line: rgba(160, 175, 255, 0.14);
    --ink: #eef1ff; --ink2: #b4bce6; --ink3: #7f88b8;
    --mint: #6debcd; --sky: #8ccbff; --lilac: #b9a8ff; --rasp: #ff6f8f; --cobalt: #7a9bff;
    max-width: 1400px; margin: 0 auto; padding: clamp(18px, 3vw, 40px) clamp(16px, 3vw, 40px) 80px;
    font-family: var(--sans); color: var(--ink);
  }
  .ad-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-bottom: 28px; }
  .ad-brand { display: flex; align-items: center; gap: 14px; }
  .ad-mark { width: 44px; height: 44px; border-radius: 14px; background: conic-gradient(from 200deg, var(--mint), var(--sky), var(--lilac), var(--mint)); box-shadow: 0 8px 30px -8px rgba(109, 235, 205, 0.6); }
  .ad-kicker { margin: 0; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink3); font-weight: 600; }
  .ad-h1 { margin: 0; font-family: var(--display); font-size: clamp(28px, 3.4vw, 42px); line-height: 1.05; color: var(--ink); }
  .ad-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .ad-tools[hidden] { display: none; }
  .ad-live { display: flex; align-items: center; gap: 8px; margin: 0 6px 0 0; color: var(--ink2); font-size: 14px; }
  .ad-live b { color: var(--ink); font-size: 16px; }
  .ad-live-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ink3); }
  .ad-live.is-on .ad-live-dot { background: var(--mint); box-shadow: 0 0 0 0 rgba(109, 235, 205, 0.6); animation: ad-pulse 2s infinite; }
  @keyframes ad-pulse { 70% { box-shadow: 0 0 0 9px rgba(109, 235, 205, 0); } 100% { box-shadow: 0 0 0 0 rgba(109, 235, 205, 0); } }
  .ad-range { display: flex; padding: 4px; gap: 2px; background: var(--card); border-radius: 999px; border: 1px solid var(--line); }
  .ad-range button, .ad-ghost {
    font: 600 13.5px/1 var(--sans); min-height: 36px; padding: 0 14px; border-radius: 999px; border: 0; cursor: pointer;
    background: transparent; color: var(--ink2);
  }
  .ad-range button[aria-pressed='true'] { background: var(--mint); color: #0b1029; }
  .ad-ghost { border: 1px solid var(--line); }
  .ad-ghost:hover, .ad-range button:hover:not([aria-pressed='true']) { color: var(--ink); background: var(--card2); }
  .ad button:focus-visible, .ad input:focus-visible { outline: 3px solid var(--lilac); outline-offset: 2px; }

  .ad-login { display: grid; place-items: center; min-height: 60vh; }
  .ad-login[hidden] { display: none; }
