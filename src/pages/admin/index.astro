---
/**
 * /admin/ — the site's analytics, for its owner only.
 *
 * The page is static and holds no data: it asks /api/admin/stats/ for one tab
 * at a time, which answers only with a valid session cookie
 * (src/lib/analytics/auth.ts), and shows a password box otherwise. Never
 * linked, never indexed, left out of the sitemap and robots.txt. Signing in
 * also tells this browser to stop counting its own visits.
 *
 * One filter row scopes everything below it (a period, a comparison with the
 * period before, a country, a kind of device, a game); the tabs are Overview,
 * Live, Games (and a page per game), Island, Audience, Acquisition,
 * Journeys, Retention and Health. Everything the page shows is in the address
 * (#tab=games&days=30&country=IN), so a view can be bookmarked or reloaded.
 * The charts are src/lib/admin/; the queries, src/lib/analytics/report.ts.
 */
import Paper from '../../layouts/Paper.astro'
import { SITE } from '../../site.config'
import { listedGames, GAMES } from '../../data/games'
import { COUNTRY_SHAPES } from '../../data/population-geo'
import { homeIsland, homeBake } from '../../lib/island/home'

const titles = Object.fromEntries(GAMES.map((g) => [g.slug, g.title]))
const listed = listedGames().map((g) => g.slug)

// The map's country names, to the ISO codes Vercel reports, worked out here at
// build time; Natural Earth's short forms are spelled out by hand.
const ALIAS: Record<string, string> = {
  'W. Sahara': 'EH', 'United States of America': 'US', 'Dem. Rep. Congo': 'CD', 'Dominican Rep.': 'DO', 'Falkland Is.': 'FK',
  'Fr. S. Antarctic Lands': 'TF', "Côte d'Ivoire": 'CI', 'Central African Rep.': 'CF', 'Congo': 'CG', 'Eq. Guinea': 'GQ', 'eSwatini': 'SZ',
  'Palestine': 'PS', 'Myanmar': 'MM', 'Turkey': 'TR', 'Solomon Is.': 'SB', 'N. Cyprus': 'CY', 'Somaliland': 'SO', 'Bosnia and Herz.': 'BA',
  'Macedonia': 'MK', 'Trinidad and Tobago': 'TT', 'S. Sudan': 'SS',
}
const names = new Intl.DisplayNames(['en'], { type: 'region' })
const byName = new Map<string, string>()
for (let a = 65; a < 91; a++) for (let b = 65; b < 91; b++) {
  const code = String.fromCharCode(a, b)
  try { const nm = names.of(code); if (nm && nm !== code) byName.set(nm, code) } catch { /* not a region */ }
}
// The island heat-maps draw on the poster the homepage opens on, framed on
// where the buildings are (the island's own box is mostly sea).
const island = homeIsland(), baked = homeBake(), poster = baked.scene.poster
const heat = (() => {
  if (!poster) return null
  const lms = Object.values(island.anchors)
  const x0 = Math.min(...lms.map((a) => a.x0)), y0 = Math.min(...lms.map((a) => a.y0)), x1 = Math.max(...lms.map((a) => a.x1)), y1 = Math.max(...lms.map((a) => a.y1))
  const w = (x1 - x0) * 1.14, h = (y1 - y0) * 1.14, cx = (x0 + x1) / 2, cy = (y0 + y1) / 2
  const W = Math.max(w, h * 1.6), H = W / 1.6
  const [vx, vy] = island.viewBox, lv = baked.scene.levels[0]
  return {
    src: baked.base + poster.file, x: vx, y: vy, w: poster.w / lv, h: poster.h / lv, bounds: island.viewBox,
    frame: [cx - W / 2, cy - H / 2, W, H].map(Math.round),
    anchors: Object.fromEntries(Object.entries(island.anchors).map(([s, a]) => [s, [Math.round(a.bx), Math.round(a.by)]])),
  }
})()
const isoByName = Object.fromEntries(COUNTRY_SHAPES.map((c) => [c.name, ALIAS[c.name] ?? byName.get(c.name) ?? '']).filter(([, v]) => v))
---

<Paper title={`Analytics — ${SITE.name}`} noindex masthead={false} colophon={false} themeColor="#0b1029" colorScheme="dark" bodyClass="ad-body">
  <main id="main" class="ad">
    <header class="ad-top">
      <div class="ad-brand">
        <span class="ad-mark" aria-hidden="true"></span>
        <div>
          <p class="ad-kicker">{SITE.name}</p>
          <h1 class="ad-h1">Analytics</h1>
        </div>
      </div>
      <div class="ad-tools" id="adTools" hidden>
        <p class="ad-live" id="adLive"><span class="ad-live-dot" aria-hidden="true"></span><b id="adLiveN">–</b> here now</p>
        <button type="button" class="ad-ghost" id="adTheme" aria-label="Switch theme">Theme</button>
        <button type="button" class="ad-ghost" id="adOut">Sign out</button>
      </div>
    </header>

    <section class="ad-login" id="adLogin" hidden>
      <form class="ad-login-card" id="adForm">
        <h2>Sign in</h2>
        <p>The password is the <code>ADMIN_PASSWORD</code> set in the Vercel project.</p>
        <label for="adPw">Password</label>
        <input id="adPw" name="password" type="password" autocomplete="current-password" required />
        <button type="submit" id="adGo">Sign in</button>
        <p class="ad-err" id="adErr" role="alert"></p>
      </form>
    </section>

    <p class="ad-note" id="adNote" hidden></p>

    <div id="adApp" hidden>
      <div class="ad-filters" role="search" aria-label="What to show">
        <div class="ad-range" role="group" aria-label="Period">
          <button type="button" data-days="1">24 h</button>
          <button type="button" data-days="7">7 days</button>
          <button type="button" data-days="30">30 days</button>
          <button type="button" data-days="90">90 days</button>
          <button type="button" data-days="365">12 months</button>
          <button type="button" data-days="custom" id="adCustomBtn">Custom</button>
        </div>
        <div class="ad-custom" id="adCustom" hidden>
          <label>From <input type="date" id="adFrom" /></label>
          <label>to <input type="date" id="adTo" /></label>
          <button type="button" class="ad-mini" id="adApply">Apply</button>
        </div>
        <label class="ad-check"><input type="checkbox" id="adCompare" /> Compare with the period before</label>
        <label class="ad-sel"><span>Country</span><select id="adCountry"><option value="">Everywhere</option></select></label>
        <label class="ad-sel"><span>Device</span><select id="adDevice"><option value="">Every device</option><option value="phone">Phones</option><option value="tablet">Tablets</option><option value="desktop">Computers</option></select></label>
        <label class="ad-sel"><span>Game</span><select id="adGame"><option value="">Every page</option></select></label>
        <button type="button" class="ad-mini" id="adClear" hidden>Clear filters</button>
        <span class="ad-grow"></span>
        <button type="button" class="ad-mini" id="adExportViews" title="Every page view in this period, as CSV">Export views</button>
        <button type="button" class="ad-mini" id="adExportEvents" title="Every event in this period, as CSV">Export events</button>
      </div>
      <nav class="ad-tabs" role="tablist" aria-label="Sections">
        <button type="button" role="tab" data-tab="overview">Overview</button>
        <button type="button" role="tab" data-tab="live">Live</button>
        <button type="button" role="tab" data-tab="games">Games</button>
        <button type="button" role="tab" data-tab="island">Island</button>
        <button type="button" role="tab" data-tab="audience">Audience</button>
        <button type="button" role="tab" data-tab="acquisition">Acquisition</button>
        <button type="button" role="tab" data-tab="journeys">Journeys</button>
        <button type="button" role="tab" data-tab="retention">Retention</button>
        <button type="button" role="tab" data-tab="health">Health</button>
      </nav>
      <p class="ad-scope" id="adScope" aria-live="polite"></p>
      <div class="ad-panel" id="adPanel" role="tabpanel"></div>
    </div>
  </main>

  <script type="application/json" id="adData" set:html={JSON.stringify({ titles, listed, isoByName, heat })} />
</Paper>

<script>
  import * as Tabs from '../../lib/admin/tabs'
  import { el, untip } from '../../lib/admin/ui'

  const { titles, listed, isoByName, heat } = JSON.parse(document.getElementById('adData')!.textContent!) as { titles: Record<string, string>; listed: string[]; isoByName: Record<string, string>; heat: Tabs.Ctx['heat'] }
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone
  // ?test=1 on this page includes the traffic test runs mark as theirs (left out otherwise).
  const withTest = new URLSearchParams(location.search).get('test') === '1'

  /* ---- the state, kept in the address -------------------------------------- */
  type State = { tab: string; days: string; start: string; end: string; compare: boolean; country: string; device: string; game: string; slug: string }
  const DEFAULT: State = { tab: 'overview', days: '7', start: '', end: '', compare: true, country: '', device: '', game: '', slug: '' }
  function readState(): State {
    const h = new URLSearchParams(location.hash.slice(1))
    return { ...DEFAULT, ...Object.fromEntries([...h].filter(([k]) => k in DEFAULT)), compare: h.get('compare') !== '0' } as State
  }
  let st = readState()
  function writeState(next: Partial<State>, push = true) {
    st = { ...st, ...next }
    const h = new URLSearchParams()
    for (const [k, v] of Object.entries(st)) {
      if (k === 'compare') { if (!v) h.set(k, '0') }
      else if (v !== '' && v !== (DEFAULT as Record<string, unknown>)[k]) h.set(k, String(v))
    }
    const url = '#' + h.toString()
    if (push) history.pushState(null, '', url); else history.replaceState(null, '', url)
    paintControls()
    load()
  }
  addEventListener('popstate', () => { st = readState(); paintControls(); load() })

  const query = (extra: Record<string, string> = {}) => {
    const q = new URLSearchParams({ tz })
    if (st.days === 'custom' && st.start && st.end) {
      q.set('start', new Date(st.start + 'T00:00').toISOString())
      q.set('end', new Date(new Date(st.end + 'T00:00').getTime() + 864e5).toISOString())
    } else q.set('days', st.days === 'custom' ? '7' : st.days)
    if (st.country) q.set('country', st.country)
    if (st.device) q.set('device', st.device)
    if (st.game) q.set('game', st.game)
    if (withTest) q.set('test', '1')
    for (const [k, v] of Object.entries(extra)) q.set(k, v)
    return q
  }

  /* ---- signing in -------------------------------------------------------------- */
  function show(which: 'login' | 'app' | 'note', note = '') {
    $('adLogin').hidden = which !== 'login'
    $('adApp').hidden = which !== 'app'
    $('adTools').hidden = which !== 'app'
    $('adNote').hidden = !note
    $('adNote').textContent = note
  }
  $('adForm').addEventListener('submit', async (e) => {
    e.preventDefault()
    const go = $<HTMLButtonElement>('adGo')
    go.disabled = true; $('adErr').textContent = ''
    try {
      const r = await fetch('/api/admin/login/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: $<HTMLInputElement>('adPw').value }) })
      const b = await r.json().catch(() => ({}))
      if (!r.ok) { $('adErr').textContent = b.error ?? 'That did not work.'; return }
      $<HTMLInputElement>('adPw').value = ''
      loadOptions(); load()
    } catch { $('adErr').textContent = 'The site could not be reached.' }
    finally { go.disabled = false }
  })
  $('adOut').addEventListener('click', async () => {
    await fetch('/api/admin/logout/', { method: 'POST' }).catch(() => {})
    try { localStorage.removeItem('funsite:admin') } catch {}
    clearTimeout(timer); show('login')
  })

  /* ---- the theme ------------------------------------------------------------------ */
  const root = document.documentElement
  const themes = ['', 'light', 'dark'] as const
  const themeName = { '': 'Theme: system', light: 'Theme: light', dark: 'Theme: dark' }
  let theme: (typeof themes)[number] = ''
  try { const t = localStorage.getItem('funsite:admin-theme'); if (t === 'light' || t === 'dark') theme = t } catch {}
  const paintTheme = () => { if (theme) root.dataset.adTheme = theme; else delete root.dataset.adTheme; $('adTheme').textContent = themeName[theme] }
  $('adTheme').addEventListener('click', () => {
    theme = themes[(themes.indexOf(theme) + 1) % 3]
    try { if (theme) localStorage.setItem('funsite:admin-theme', theme); else localStorage.removeItem('funsite:admin-theme') } catch {}
    paintTheme()
  })
  paintTheme()

  /* ---- the controls ------------------------------------------------------------------- */
  const sel = (id: string) => $<HTMLSelectElement>(id)
  function paintControls() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-days]')) b.setAttribute('aria-pressed', String(b.dataset.days === st.days))
    $('adCustom').hidden = st.days !== 'custom'
    $<HTMLInputElement>('adFrom').value = st.start; $<HTMLInputElement>('adTo').value = st.end
    $<HTMLInputElement>('adCompare').checked = st.compare
    sel('adCountry').value = st.country; sel('adDevice').value = st.device; sel('adGame').value = st.game
    $('adClear').hidden = !st.country && !st.device && !st.game
    for (const t of document.querySelectorAll<HTMLButtonElement>('[data-tab]')) t.setAttribute('aria-selected', String(t.dataset.tab === st.tab || (st.tab === 'game' && t.dataset.tab === 'games')))
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-days]')) b.addEventListener('click', () => {
    if (b.dataset.days === 'custom') {
      const d = (x: Date) => x.toLocaleDateString('en-CA')
      $('adCustom').hidden = false
      if (!st.start) { $<HTMLInputElement>('adFrom').value = d(new Date(Date.now() - 29 * 864e5)); $<HTMLInputElement>('adTo').value = d(new Date()) }
      $<HTMLInputElement>('adFrom').focus()
      return
    }
    writeState({ days: b.dataset.days!, start: '', end: '' })
  })
  $('adApply').addEventListener('click', () => {
    const s = $<HTMLInputElement>('adFrom').value, e = $<HTMLInputElement>('adTo').value
    if (s && e && s <= e) writeState({ days: 'custom', start: s, end: e })
  })
  $('adCompare').addEventListener('change', () => writeState({ compare: $<HTMLInputElement>('adCompare').checked }, false))
  sel('adCountry').addEventListener('change', () => writeState({ country: sel('adCountry').value }))
  sel('adDevice').addEventListener('change', () => writeState({ device: sel('adDevice').value }))
  sel('adGame').addEventListener('change', () => writeState({ game: sel('adGame').value }))
  $('adClear').addEventListener('click', () => writeState({ country: '', device: '', game: '' }))
  for (const t of document.querySelectorAll<HTMLButtonElement>('[data-tab]')) t.addEventListener('click', () => writeState({ tab: t.dataset.tab!, slug: '' }))
  // Arrow keys between tabs.
  document.querySelector('.ad-tabs')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key; if (k !== 'ArrowRight' && k !== 'ArrowLeft') return
    const ts = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')], i = ts.findIndex((t) => t === document.activeElement)
    const n = ts[(i + (k === 'ArrowRight' ? 1 : -1) + ts.length) % ts.length]; n.focus(); n.click()
  })
  const exportCsv = (what: string) => { location.href = '/api/admin/export/?' + query({ what }).toString() }
  $('adExportViews').addEventListener('click', () => exportCsv('views'))
  $('adExportEvents').addEventListener('click', () => exportCsv('events'))

  async function loadOptions() {
    try {
      const r = await fetch('/api/admin/stats/?' + query({ tab: 'options', days: '365' }).toString())
      if (!r.ok) return
      const o = await r.json() as { countries: string[]; games: string[] }
      const rn = (() => { try { return new Intl.DisplayNames(undefined, { type: 'region' }) } catch { return null } })()
      const cs = o.countries.map((c) => [c, rn?.of(c) ?? c]).sort((a, b) => a[1].localeCompare(b[1]))
      sel('adCountry').replaceChildren(el('option', { value: '', text: 'Everywhere' }), ...cs.map(([c, n]) => el('option', { value: c, text: n })))
      const gs = [...new Set([...listed, ...o.games])].map((s) => [s, titles[s] ?? s]).sort((a, b) => a[1].localeCompare(b[1]))
      sel('adGame').replaceChildren(el('option', { value: '', text: 'Every page' }), ...gs.map(([s, n]) => el('option', { value: s, text: n })))
      paintControls()
    } catch { /* the filter keeps its defaults */ }
  }

  /* ---- loading and drawing ---------------------------------------------------------------- */
  let timer = 0, seq = 0
  const panel = $('adPanel')
  const bucketOf = (): Tabs.Bucket => {
    const days = st.days === 'custom' && st.start && st.end ? (new Date(st.end).getTime() - new Date(st.start).getTime()) / 864e5 + 1 : Number(st.days)
    return days <= 2.1 ? 'hour' : days <= 120 ? 'day' : 'week'
  }
  const ctx = (): Tabs.Ctx => ({
    titles, isoByName, bucket: bucketOf(), compare: st.compare,
    openGame: (slug) => { writeState({ tab: 'game', slug }); scrollTo({ top: 0 }) },
    pickCountry: (iso) => writeState({ country: iso }),
    heat,
    fetch: async (params) => {
      const r = await fetch('/api/admin/stats/?' + query(params).toString(), { cache: 'no-store' })
      if (!r.ok) throw new Error(String(r.status))
      return r.json()
    },
  })

  const PERIOD: Record<string, string> = { '1': 'the last 24 hours', '7': 'the last 7 days', '30': 'the last 30 days', '90': 'the last 90 days', '365': 'the last 12 months' }
  function scopeText() {
    const parts = [st.days === 'custom' && st.start ? `${st.start} to ${st.end}` : PERIOD[st.days] ?? `the last ${st.days} days`]
    if (st.country) { try { parts.push(new Intl.DisplayNames(undefined, { type: 'region' }).of(st.country) ?? st.country) } catch { parts.push(st.country) } }
    if (st.device) parts.push(({ phone: 'phones', tablet: 'tablets', desktop: 'computers' } as Record<string, string>)[st.device] ?? st.device)
    if (st.game) parts.push(titles[st.game] ?? st.game)
    if (withTest) parts.push('including test runs')
    return 'Showing ' + parts.join(' · ')
  }

  /** The date before which raw events are gone (90 days), if the period reaches back past it. */
  function summarised() {
    const cut = new Date(); cut.setUTCHours(0, 0, 0, 0); cut.setUTCDate(cut.getUTCDate() - 90)
    const from = st.days === 'custom' && st.start ? new Date(st.start + 'T00:00') : new Date(Date.now() - Number(st.days) * 864e5)
    return from < cut ? cut.toLocaleDateString(undefined, { day: 'numeric', month: 'long' }) : null
  }

  async function load() {
    clearTimeout(timer)
    const my = ++seq
    const tab = st.tab === 'game' && !st.slug ? 'games' : st.tab
    $('adScope').textContent = scopeText()
    panel.classList.add('is-loading')
    let r: Response
    try { r = await fetch('/api/admin/stats/?' + query(tab === 'game' ? { tab, slug: st.slug } : { tab }).toString(), { cache: 'no-store' }) }
    catch { panel.classList.remove('is-loading'); show('note', 'The site could not be reached. Check the connection and refresh.'); return }
    if (my !== seq) return
    if (r.status === 401) { show('login'); $('adPw').focus(); return }
    const body = await r.json().catch(() => ({}))
    if (my !== seq) return
    if (!r.ok) { panel.classList.remove('is-loading'); show('note', body.error ?? 'Something went wrong.'); return }
    try { localStorage.setItem('funsite:admin', '1') } catch {}
    show('app')
    render(tab, body)
    // Live refreshes every ten seconds; everything else every minute (and the "here now" count with it).
    timer = window.setTimeout(load, tab === 'live' ? 10_000 : 60_000)
    if (tab !== 'live' && tab !== 'overview') refreshLive()
  }
  async function refreshLive() {
    try {
      const r = await fetch('/api/admin/stats/?' + query({ tab: 'live' }).toString(), { cache: 'no-store' })
      if (r.ok) paintLive((await r.json()).now)
    } catch { /* keep the last count */ }
  }
  function paintLive(n: number) { $('adLiveN').textContent = String(n); $('adLive').classList.toggle('is-on', n > 0) }

  function render(tab: string, data: unknown) {
    untip()
    const c = ctx()
    const out = el('div', { class: 'ad-tab-body' })
    const old = summarised()
    if (old && tab !== 'live' && tab !== 'retention') out.append(el('p', { class: 'ad-banner' }, el('b', { text: 'Before ' + old + ', only daily totals are kept. ' }), tab === 'overview' || tab === 'games' || tab === 'game' ? 'Starts, finishes, wins, shares and the crowd’s choices include them; anything that needs a single visit’s events (funnels, how long games take, scores) starts on ' + old + '.' : 'Everything on this tab that comes from events starts on ' + old + '; page views and visitors go back thirteen months.'))
    // Into the page first, so every chart can measure the width it has.
    panel.replaceChildren(out)
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const d = data as any
    if (tab === 'overview') { Tabs.overview(out, d, c); paintLive(d.live.now) }
    else if (tab === 'live') { Tabs.live(out, d, c); paintLive(d.now) }
    else if (tab === 'games') Tabs.games(out, d, c, listed)
    else if (tab === 'game') Tabs.game(out, d, st.slug, c, () => writeState({ tab: 'games', slug: '' }))
    else if (tab === 'island') Tabs.island(out, d, c)
    else if (tab === 'audience') Tabs.audience(out, d, c)
    else if (tab === 'acquisition') Tabs.acquisition(out, d, c)
    else if (tab === 'journeys') Tabs.journeys(out, d, c)
    else if (tab === 'retention') Tabs.retention(out, d, c)
    else if (tab === 'health') Tabs.health(out, d, c)
    panel.classList.remove('is-loading')
  }

  paintControls()
  loadOptions()
  load()
</script>

<style is:global>
  /*
   * Global, not scoped: nearly everything here is built by the script at run
   * time, which scoped styles never reach. Every selector starts from an ad-
   * class (or body.ad-body), so none of it can touch another page.
   *
   * Two themes from the same roles. Series are the validated cool four (blue,
   * aqua, violet, pink: no orange or yellow, colour-blind safe in both
   * themes); q0–q5 is one blue ramp for magnitude; good, mid and poor are
   * status, always with a word and a mark beside them.
   */
  body.ad-body {
    color-scheme: light;
    --page: #eef1f6; --surface: #ffffff; --surface-2: #f4f6fa; --line: rgba(17, 24, 52, 0.1); --grid: #e7eaf1; --axis: #c3c9d6;
    --ink: #111827; --ink2: #4a5368; --ink3: #626b80; --accent: #4fe3c1; --on-accent: #0b1029; --focus: #5b82ff;
    --s1: #2a78d6; --s2: #1baf7a; --s3: #4a3aa7; --s4: #e87ba4;
    --q0: #edf0f5; --q1: #cde2fb; --q2: #9ec5f4; --q3: #6da7ec; --q4: #2a78d6; --q5: #184f95;
    --good: #0b8a0b; --mid: #7d72d4; --poor: #d03b3b; --up: #0b7a52; --down: #c21d43;
    --shadow: 0 1px 2px rgba(17, 24, 52, 0.05), 0 10px 30px -18px rgba(17, 24, 52, 0.25);
    background: var(--page); color: var(--ink);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-ad-theme='light']) body.ad-body {
      color-scheme: dark;
      --page: #0b1029; --surface: #121a3d; --surface-2: #18214a; --line: rgba(160, 175, 255, 0.14); --grid: #222b55; --axis: #38427a;
      --ink: #eef1ff; --ink2: #b4bce6; --ink3: #8b94c4; --accent: #6debcd; --on-accent: #0b1029; --focus: #b9a8ff;
      --s1: #3987e5; --s2: #199e70; --s3: #9085e9; --s4: #d55181;
      --q0: #1a2350; --q1: #1d3566; --q2: #1c5cab; --q3: #3987e5; --q4: #6da7ec; --q5: #b7d3f6;
