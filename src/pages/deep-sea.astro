---
import GameLayout from '../layouts/GameLayout.astro'
import { MARKERS, ZONES, TOTAL_DEPTH } from '../data/deep-sea'
import type { Marker } from '../data/deep-sea'
import { DEEP_SEA_ART, MOOD, sceneSvg } from '../lib/deep-sea-art'
import { withBase } from '../lib/base'

/**
 * The Deep Sea — a linear scroll from the surface to Challenger Deep, the
 * deepest known point in any ocean on Earth, 10,935 real metres down.
 *
 * Same shape as Deep Time: an honest, zoned scale (here, the five standard
 * oceanographic zones rather than five geological eras), scroll-linked HUD,
 * and cards placed at their true depth rather than spaced out to look nice.
 * Density falls zone over zone — the sunlight zone is generous because that
 * is where almost everything a person has ever personally seen alive lives,
 * and the trenches get the most total height of any zone despite being the
 * emptiest, because they hold the back half of the page's real story: the
 * handful of records and the handful of people.
 */

const rgb = (hex: string) =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ')

let cursor = 0
const zones = ZONES.map((z) => {
  const height = Math.round((z.to - z.from) * z.pxPerMetre)
  const laid = { ...z, height, offset: cursor }
  cursor += height
  return laid
})
const totalHeight = cursor
// The deepest markers land with their `top` at the very end of the reel —
// depth 10,935 *is* the last pixel of real descent — so a big card there
// hangs entirely below the reel's own box. Extra room after the real bottom
// keeps the finale from overlapping the outro that follows it.
const REEL_TAIL = 620
const reelHeight = totalHeight + REEL_TAIL

const CARD_H = 96

type Placed = ReturnType<typeof at> & { lane: 'center' | 'left' | 'right' }
function at(m: Marker) {
  const zone = zones.find((z) => m.depth >= z.from && m.depth <= z.to) ?? zones[zones.length - 1]
  return { ...m, top: zone.offset + Math.round((m.depth - zone.from) * zone.pxPerMetre) }
}

const rough = MARKERS.map(at)
const placed: Placed[] = []
for (let i = 0; i < rough.length; ) {
  let j = i + 1
  while (j < rough.length && rough[j].top < rough[j - 1].top + CARD_H) j++
  const group = rough.slice(i, j)
  if (group.length === 1) {
    placed.push({ ...group[0], lane: 'center' })
  } else {
    group.forEach((g, k) => placed.push({ ...g, lane: k % 2 === 0 ? 'left' : 'right' }))
  }
  i = j
}

const fmtDepth = (m: number) => (m >= 1000 ? `${(m / 1000).toFixed(2)}km` : `${Math.round(m)}m`)
const fmtPressure = (m: number) => {
  const atm = 1 + m / 10
  return atm >= 100 ? `${Math.round(atm).toLocaleString('en-US')} atm` : `${atm.toFixed(1)} atm`
}
---

<GameLayout slug="deep-sea" bar="#0e4a68" bodyClass="night-body">
  <div class="sky" id="sky"></div>
  {/* The rendered water column sits over the CSS gradient, which stays as
      the fallback for anything without WebGL2. */}
  <div class="skygl" id="skygl" aria-hidden="true"></div>

  <div class="hud-scrim" aria-hidden="true"></div>

  <div class="hud">
    <div class="hud-label" id="hudZone">the sunlight zone</div>
    <div class="hud-depth" id="hudDepth">0m</div>
    <div class="hud-bar"><div class="hud-fill" id="hudFill"></div></div>
    <div class="hud-row">
      <span id="hudPressure">1.0 atm</span>
      <span id="hudLight">full daylight, fading fast</span>
    </div>
  </div>

  <div class="intro">
    <h1>The Deep Sea</h1>
    <p>Every metre below is real. Keep scrolling to the deepest point in any ocean on Earth.</p>
    <div class="arrow">↓</div>
  </div>

  <div class="reel" style={`height:${reelHeight}px`}>
    {
      zones.map((z, i) =>
        i === 0 ? null : (
          <div class="seam" style={`top:${z.offset}px;--from:${zones[i - 1].sky[1]};--to:${z.sky[0]}`}>
            <span class="seam-name">{z.label}</span>
            <span class="seam-note">
              {z.from.toLocaleString('en-US')}m to {z.to.toLocaleString('en-US')}m — {z.light}
            </span>
          </div>
        )
      )
    }
    {
      placed.map((m) => {
        const mood = MOOD[m.title]
        const style = mood ? `top:${m.top}px;--mood:${mood};--moodRgb:${rgb(mood)}` : `top:${m.top}px`
        return (
          <article class:list={['ev', `lane-${m.lane}`, { big: m.big }]} style={style}>
            {DEEP_SEA_ART[m.title] && <div class="ev-art" set:html={sceneSvg(m.title)} />}
            <div class="ev-text">
              <div class="ev-when">{fmtDepth(m.depth)} down</div>
              <h2>{m.title}</h2>
              <p>{m.note}</p>
            </div>
          </article>
        )
      })
    }
  </div>

  <footer class="outro">
    <p>10,935 metres. The deepest the ocean, or this page, goes.</p>
    <a href={withBase('/')}>← more things like this</a>
  </footer>
</GameLayout>

  {/* Data for the module below: modules cannot take define:vars, and modules
      are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ zones, totalHeight })} />

  <script>
  import { ring } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { DEEP_SEA_FRAG } from '../lib/deep-sea-sky'
    const { zones, totalHeight } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  // --- lane layout, identical in shape to Deep Time's own pass -----------
  const cards = [...document.querySelectorAll('.ev')]

  function relayout() {
    const measure = (lane) => {
      for (const el of cards) {
        el.classList.remove('lane-center', 'lane-left', 'lane-right', 'compact', 'compact-hard')
        el.classList.add(lane)
      }
      return cards.map((el) => el.offsetHeight)
    }
    const wide = measure('lane-center')
    const narrow = measure('lane-left')

    const GROUP_GAP = 8
    const boxes = cards.map((el, i) => ({
      el,
      top: el.offsetTop,
      h: Math.max(wide[i], narrow[i]) + GROUP_GAP,
    }))

    const groups = []
    for (let i = 0; i < boxes.length; ) {
      let j = i + 1
      while (j < boxes.length && boxes[j].top < boxes[j - 1].top + boxes[j - 1].h) j++
      groups.push(boxes.slice(i, j))
      i = j
    }

    for (const group of groups) {
      if (group.length === 1) {
        group[0].el.classList.remove('lane-left')
        group[0].el.classList.add('lane-center')
        continue
      }
      const TIERS = ['', 'compact', 'compact-hard']
      for (let attempt = 0; attempt < TIERS.length; attempt++) {
        const bottom = { left: -Infinity, right: -Infinity }
        let clash = false
        for (const b of group) {
          const h = b.el.offsetHeight
          const GAP = 10
          let lane =
            bottom.left + GAP <= b.top ? 'left' : bottom.right + GAP <= b.top ? 'right' : null
          if (!lane) {
            clash = true
            lane = bottom.left <= bottom.right ? 'left' : 'right'
          }
          b.el.classList.remove('lane-left', 'lane-right')
          b.el.classList.add('lane-' + lane)
          bottom[lane] = b.top + h
        }
        if (!clash) break
        const next = TIERS[attempt + 1]
        if (next) for (const b of group) b.el.classList.add(next)
      }
    }
  }

  relayout()

  // A chime when a record or a zone-defining fact scrolls to the middle of
  // the screen — the same one-shot spotlight Deep Time uses.
  let chimeStep = 0
  const bigCards = cards.filter((c) => c.classList.contains('big'))
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          io.unobserve(e.target)
          sfx.blip(chimeStep++)
          const r = e.target.getBoundingClientRect()
          ring(r.left + r.width / 2, r.top + r.height / 2, 'rgba(255,255,255,0.5)', 20)
          e.target.classList.add('focused')
        }
      },
      { rootMargin: '-42% 0px -42% 0px' }
    )
    bigCards.forEach((c) => io.observe(c))
  }
  addEventListener('pointerdown', unlock, { once: true })
  addEventListener('scroll', unlock, { once: true, passive: true })

  const sky = document.getElementById('sky')
  const hudZone = document.getElementById('hudZone')
  const hudDepth = document.getElementById('hudDepth')
  const hudFill = document.getElementById('hudFill')
  const hudPressure = document.getElementById('hudPressure')
  const hudLight = document.getElementById('hudLight')
  const reel = document.querySelector('.reel')

  const fmtDepth = (m) => (m >= 1000 ? `${(m / 1000).toFixed(2)}km` : `${Math.round(m)}m`)
  const fmtPressure = (m) => {
    const atm = 1 + m / 10
    return atm >= 100 ? `${Math.round(atm).toLocaleString('en-US')} atm` : `${atm.toFixed(1)} atm`
  }

  const mix = (a, b, t) => {
    const p = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16))
    const [r1, g1, b1] = p(a), [r2, g2, b2] = p(b)
    const c = (x, y) => Math.round(x + (y - x) * t)
    return `rgb(${c(r1, r2)},${c(g1, g2)},${c(b1, b2)})`
  }

  /* The rendered water column. The CSS gradient underneath stays in place if
     the surface never comes up. */
  let curD = 0
  const surface = new ShaderSurface(document.getElementById('skygl'), DEEP_SEA_FRAG, {
    scale: 0.75,
    uniforms: () => ({ u_D: curD }),
  })

  let ticking = false
  function update() {
    ticking = false
    const depth = window.scrollY + window.innerHeight / 2 - reel.offsetTop
    const clamped = Math.max(0, Math.min(totalHeight, depth))

    const zone = zones.find((z) => clamped < z.offset + z.height) ?? zones[zones.length - 1]
    const within = clamped - zone.offset
    const metres = Math.max(0, Math.min(zone.to, zone.from + within / zone.pxPerMetre))

    hudZone.textContent = zone.label.toLowerCase()
    hudDepth.textContent = fmtDepth(metres)
    hudPressure.textContent = fmtPressure(metres)
    hudLight.textContent = zone.light
    hudFill.style.width = `${(clamped / totalHeight) * 100}%`

    const t = zone.height ? Math.min(1, Math.max(0, within / zone.height)) : 0
    hudFill.style.background = mix(zone.sky[0], zone.sky[1], t)
    sky.style.background = `linear-gradient(${mix(zone.sky[0], zone.sky[1], t)}, ${mix(zone.sky[0], zone.sky[1], Math.min(1, t + 0.25))})`

    curD = metres
    if (prefersReducedMotion) surface.redraw()
  }

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    },
    { passive: true }
  )
  addEventListener('resize', () => { relayout(); update() }, { passive: true })
  update()
</script>

<style>
  .skygl { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  .skygl :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .sky {
    position: fixed; inset: 0; z-index: -2;
    background: linear-gradient(#bdeaf5, #0e4a68);
    transition: background 260ms linear;
  }
  :global(.night-body) { background: #04101c; color: #fff; }

  /* A soft fade at the very top of the viewport, under the HUD but over the
     reel, so a card sliding up to meet the HUD loses contrast gradually
     instead of vanishing behind a hard-edged bar. */
  .hud-scrim {
    position: fixed; inset: 0 0 auto 0; height: 172px; z-index: 39;
    pointer-events: none;
    background: linear-gradient(rgba(0, 4, 8, 0.5), rgba(0, 4, 8, 0));
  }

  .hud {
    position: fixed; top: 58px; left: 50%; transform: translateX(-50%);
    z-index: 40; width: min(92vw, 520px); text-align: center;
    padding: 10px 16px; border-radius: 12px;
    background: rgba(0, 0, 0, 0.66);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }
  .hud-label { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.78; }
  .hud-depth { font-size: 19px; font-weight: 700; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .hud-bar { height: 3px; background: rgba(255,255,255,0.2); border-radius: 2px; margin: 9px 0 6px; }
  .hud-fill { height: 100%; width: 0; background: #fff; border-radius: 2px; transition: background 300ms linear; }
  .hud-row { display: flex; justify-content: space-between; font-size: 12px; opacity: 0.8; font-variant-numeric: tabular-nums; gap: 10px; }
  .hud-row span:last-child { opacity: 0.85; text-align: right; }

  .intro { min-height: 78vh; display: grid; place-content: center; text-align: center; gap: 10px; padding: 150px 20px 0; }
  .intro h1 { font-size: clamp(38px, 9vw, 74px); margin: 0; letter-spacing: -0.03em; }
  .intro p { opacity: 0.75; margin: 0; font-size: 18px; max-width: 32ch; margin-inline: auto; }
  .arrow { font-size: 30px; opacity: 0.6; animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(10px); } }

  .reel { position: relative; overflow-x: clip; }

  .ev {
    position: absolute; left: 50%; transform: translateX(-50%);
    width: min(90vw, 560px);
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center;
    gap: 14px; text-align: left;
    padding: 15px 19px; border-radius: 14px;
    --moodRgb: 138, 148, 160;
    background: linear-gradient(165deg, rgba(6, 14, 22, 0.90), rgba(2, 5, 9, 0.90));
    border: 1px solid rgba(var(--moodRgb), 0.34);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 20px 44px -26px rgb(0 0 0 / 0.8),
      0 0 30px -8px rgba(var(--moodRgb), 0.4);
    transition: box-shadow 200ms var(--ease, ease), border-color 200ms var(--ease, ease);
  }
  .ev.lane-left { left: 50%; transform: translateX(-102%); width: min(44vw, 330px); }
  .ev.lane-right { left: 50%; transform: translateX(2%); width: min(44vw, 330px); }
  .ev.lane-left, .ev.lane-right { padding: 12px 15px; }
  .ev.lane-left h2, .ev.lane-right h2 { font-size: 19px; }
  .ev.lane-left p, .ev.lane-right p { font-size: 14px; }
  .ev-art {
    width: 172px; aspect-ratio: 3 / 2;
    border-radius: 10px; overflow: hidden;
    border: 1px solid rgba(var(--moodRgb), 0.6);
    box-shadow: 0 0 28px -5px rgba(var(--moodRgb), 0.6), inset 0 0 0 1px rgb(0 0 0 / 0.35);
  }
  .ev.lane-left .ev-art, .ev.lane-right .ev-art { width: 104px; }

  .ev.big {
    background: linear-gradient(165deg, rgba(8, 18, 28, 0.94), rgba(2, 5, 9, 0.94));
    border-color: rgba(var(--moodRgb), 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.09),
      0 24px 54px -26px rgb(0 0 0 / 0.85),
      0 0 52px -8px rgba(var(--moodRgb), 0.55);
  }
  .ev.big h2 { font-size: 28px; }
  .ev.big .ev-art { width: 220px; box-shadow: 0 0 40px -6px rgba(var(--moodRgb), 0.75), inset 0 0 0 1px rgb(0 0 0 / 0.35); }
  .ev.lane-left.big h2, .ev.lane-right.big h2 { font-size: 22px; }
  .ev.lane-left.big .ev-art, .ev.lane-right.big .ev-art { width: 128px; }

  @keyframes seen-pulse {
    0%   { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.09), 0 24px 54px -26px rgb(0 0 0 / 0.85), 0 0 30px -8px rgba(var(--moodRgb), 0.35); }
    45%  { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16), 0 28px 62px -24px rgb(0 0 0 / 0.92), 0 0 80px -6px rgba(var(--moodRgb), 0.95); }
    100% { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.09), 0 24px 54px -26px rgb(0 0 0 / 0.85), 0 0 52px -8px rgba(var(--moodRgb), 0.55); }
  }
  .ev.big.focused { animation: seen-pulse 820ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }

  .ev.compact p { display: none; }
  .ev.compact .ev-art { width: 64px; }
  .ev.compact-hard .ev-when { display: none; }
  .ev.compact-hard .ev-art { display: none; }
  .ev.compact-hard { padding: 9px 12px; grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 620px) {
    .ev.lane-left, .ev.lane-right { width: min(46vw, 220px); }
    .ev.lane-left { transform: translateX(-104%); }
    .ev.lane-left .ev-art, .ev.lane-right .ev-art { width: 38px; aspect-ratio: 1 / 1; }
    .ev.lane-left.big .ev-art, .ev.lane-right.big .ev-art { width: 46px; }
    .ev.lane-left, .ev.lane-right { padding: 8px 10px; }
    .ev { gap: 7px; }
  }
  .ev-when {
    font-size: 12px; letter-spacing: 0.10em; text-transform: uppercase;
    opacity: 0.75; font-variant-numeric: tabular-nums;
  }
  .ev h2 { font-size: 22px; margin: 4px 0 0; font-weight: 700; }
  .ev p { margin: 6px 0 0; opacity: 0.72; font-size: 15px; }

  @media (prefers-reduced-motion: reduce) {
    .ev.big.focused { animation: none; }
    .ev { transition: none; }
  }

  .seam {
    position: absolute; left: 0; right: 0; text-align: center;
    padding-top: 11px;
  }
  .seam::before {
    content: ''; position: absolute; left: 9%; right: 9%; top: 0; height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--from), var(--to));
    opacity: 0.65;
  }
  .seam-name, .seam-note {
    position: relative; display: block;
    background: rgb(0 0 0 / 0.46); border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px; padding: 4px 13px; margin: 0 auto 4px;
    width: fit-content; max-width: 90%;
  }
  .seam-name { font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.9; font-weight: 600; }
  .seam-note { font-size: 11.5px; opacity: 0.72; margin-top: 6px; }

  .outro { padding: 22vh 20px 18vh; text-align: center; }
  .outro p { font-size: 20px; opacity: 0.8; }
  .outro a { display: inline-block; margin-top: 12px; opacity: 0.75; }
</style>
