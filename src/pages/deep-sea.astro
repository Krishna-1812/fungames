---
import GameShell from '../layouts/GameShell.astro'
import { MARKERS, ZONES, TOTAL_DEPTH } from '../data/deep-sea'
import type { Marker } from '../data/deep-sea'
import { DEEP_SEA_ART, MOOD, sceneSvg } from '../lib/deep-sea-art'

/**
 * The Deep Sea — a linear scroll from the surface to Challenger Deep, the
 * deepest known point in any ocean on Earth, 10,935 real metres down.
 *
 * Same shape as Deep Time: an honest, zoned scale (here, the five standard
 * oceanographic zones rather than five geological eras), scroll-linked HUD,
 * and cards placed at their true depth rather than spaced out to look nice.
 * Density falls zone over zone — the sunlight zone is generous because that
 * is where almost everything a person has ever personally seen alive lives,
 * and the trenches get the most total height of any zone despite being the
 * emptiest, because they hold the back half of the page's real story: the
 * handful of records and the handful of people.
 *
 * In the shell the dive is the stage: the water column is pinned behind it
 * (a sticky backdrop, not a fixed one, so it stays inside the frame) and the
 * depth gauge sticks to the top of it as you go. Score is the depth you are
 * at, Zone is which of the five you are in, Moves is the pressure, and Best
 * is the deepest you have been. Challenger Deep is the ending.
 */

const rgb = (hex: string) =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ')

let cursor = 0
const zones = ZONES.map((z) => {
  const height = Math.round((z.to - z.from) * z.pxPerMetre)
  const laid = { ...z, height, offset: cursor }
  cursor += height
  return laid
})
const totalHeight = cursor
// The deepest markers land with their `top` at the very end of the reel —
// depth 10,935 *is* the last pixel of real descent — so a big card there
// hangs entirely below the reel's own box. Extra room after the real bottom
// keeps the finale from overlapping the outro that follows it.
const REEL_TAIL = 620
const reelHeight = totalHeight + REEL_TAIL

const CARD_H = 96

type Placed = ReturnType<typeof at> & { lane: 'center' | 'left' | 'right' }
function at(m: Marker) {
  const zone = zones.find((z) => m.depth >= z.from && m.depth <= z.to) ?? zones[zones.length - 1]
  return { ...m, top: zone.offset + Math.round((m.depth - zone.from) * zone.pxPerMetre) }
}

const rough = MARKERS.map(at)
const placed: Placed[] = []
for (let i = 0; i < rough.length; ) {
  let j = i + 1
  while (j < rough.length && rough[j].top < rough[j - 1].top + CARD_H) j++
  const group = rough.slice(i, j)
  if (group.length === 1) {
    placed.push({ ...group[0], lane: 'center' })
  } else {
    group.forEach((g, k) => placed.push({ ...g, lane: k % 2 === 0 ? 'left' : 'right' }))
  }
  i = j
}

const fmtDepth = (m: number) => (m >= 1000 ? `${(m / 1000).toFixed(2)}km` : `${Math.round(m)}m`)
---

<GameShell
  slug="deep-sea"
  labels={{ score: 'Depth', best: 'Deepest', level: 'Zone', moves: 'Pressure' }}
  initial={{ score: '0 m', level: `1 / ${ZONES.length}`, moves: '1 atm' }}
>
  <div class="ds" id="dive">
    {/* The water, pinned to the viewport while the dive scrolls past it. The
        rendered column sits over the CSS gradient, which stays as the fallback
        for anything without WebGL2. */}
    <div class="ds-back" aria-hidden="true">
      <div class="sky" id="sky"></div>
      <div class="skygl" id="skygl"></div>
    </div>

    <div class="ds-hud-pin">
      <div class="hud-scrim" aria-hidden="true"></div>
      <div class="hud" role="group" aria-label="Depth gauge">
        <div class="hud-label" id="hudZone">the sunlight zone</div>
        <div class="hud-depth" id="hudDepth">0m</div>
        <div class="hud-bar"><div class="hud-fill" id="hudFill"></div></div>
        <div class="hud-row">
          <span id="hudPressure">1.0 atm</span>
          <span id="hudLight">full daylight, fading fast</span>
        </div>
      </div>
    </div>

    <div class="intro">
      <p class="intro-title">The Deep Sea</p>
      <p>Every metre below is real. Keep scrolling to the deepest point in any ocean on Earth.</p>
      <div class="arrow" aria-hidden="true">↓</div>
    </div>

    <div class="reel" style={`height:${reelHeight}px`}>
      {
        zones.map((z, i) =>
          i === 0 ? null : (
            <div class="seam" style={`top:${z.offset}px;--from:${zones[i - 1].sky[1]};--to:${z.sky[0]}`}>
              <span class="seam-name">{z.label}</span>
              <span class="seam-note">
                {z.from.toLocaleString('en-US')}m to {z.to.toLocaleString('en-US')}m — {z.light}
              </span>
            </div>
          )
        )
      }
      {
        placed.map((m) => {
          const mood = MOOD[m.title]
          // Deterministic per-marker phase, so twenty-two windows drifting in
          // the same water are not all drifting in step.
          const drift = `--drift:${-((m.depth * 7919) % 1100) / 100}s`
          const style = mood
            ? `top:${m.top}px;--mood:${mood};--moodRgb:${rgb(mood)};${drift}`
            : `top:${m.top}px;${drift}`
          return (
            <article class:list={['ev', `lane-${m.lane}`, { big: m.big, hero: m.hero }]} style={style}>
              {DEEP_SEA_ART[m.title] && <div class="ev-art" set:html={sceneSvg(m.title)} />}
              <div class="ev-text">
                <div class="ev-when">{fmtDepth(m.depth)} down</div>
                <h2>{m.title}</h2>
                <p>{m.note}</p>
              </div>
            </article>
          )
        })
      }
    </div>

    <p class="ds-floor">10,935 metres. The deepest the ocean, or this page, goes.</p>
  </div>

  <Fragment slot="howto">
    <p>
      Scroll down, from the surface to Challenger Deep, 10,935 metres below the
      Pacific: the deepest known point in any ocean on Earth.
    </p>
    <ul>
      <li>Every animal, wreck and record is placed at its real depth. The five zones are the standard oceanographic ones, each given as much room as it needs.</li>
      <li>The gauge at the top gives your depth, the pressure (one more atmosphere every ten metres) and how much light is left.</li>
    </ul>
    <p>The bottom is the end. Your best is the deepest you have been.</p>
  </Fragment>
</GameShell>

  {/* Data for the module below: modules cannot take define:vars, and modules
      are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ zones, totalHeight })} />

  <script>
  import { ring } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { DEEP_SEA_FRAG } from '../lib/deep-sea-sky'
  import { createShell } from '../lib/game-shell'
  import { recordPlay } from '../lib/stats'
    const { zones, totalHeight } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  // --- lane layout, identical in shape to Deep Time's own pass -----------
  const cards = [...document.querySelectorAll('.ev')]

  function relayout() {
    const measure = (lane) => {
      for (const el of cards) {
        el.classList.remove('lane-center', 'lane-left', 'lane-right', 'compact', 'compact-hard')
        el.classList.add(lane)
      }
      return cards.map((el) => el.offsetHeight)
    }
    const wide = measure('lane-center')
    const narrow = measure('lane-left')

    const GROUP_GAP = 8
    const boxes = cards.map((el, i) => ({
      el,
      top: el.offsetTop,
      h: Math.max(wide[i], narrow[i]) + GROUP_GAP,
    }))

    const groups = []
    for (let i = 0; i < boxes.length; ) {
      let j = i + 1
      while (j < boxes.length && boxes[j].top < boxes[j - 1].top + boxes[j - 1].h) j++
      groups.push(boxes.slice(i, j))
      i = j
    }

    for (const group of groups) {
      if (group.length === 1) {
        group[0].el.classList.remove('lane-left')
        group[0].el.classList.add('lane-center')
        continue
      }
      const TIERS = ['', 'compact', 'compact-hard']
      for (let attempt = 0; attempt < TIERS.length; attempt++) {
        const bottom = { left: -Infinity, right: -Infinity }
        let clash = false
        for (const b of group) {
          const h = b.el.offsetHeight
          const GAP = 10
          let lane =
            bottom.left + GAP <= b.top ? 'left' : bottom.right + GAP <= b.top ? 'right' : null
          if (!lane) {
            clash = true
            lane = bottom.left <= bottom.right ? 'left' : 'right'
          }
          b.el.classList.remove('lane-left', 'lane-right')
          b.el.classList.add('lane-' + lane)
          bottom[lane] = b.top + h
        }
        if (!clash) break
        const next = TIERS[attempt + 1]
        if (next) for (const b of group) b.el.classList.add(next)
      }
    }
  }

  relayout()

  // A chime when a record or a zone-defining fact scrolls to the middle of
  // the screen — the same one-shot spotlight Deep Time uses.
  let chimeStep = 0
  const bigCards = cards.filter((c) => c.classList.contains('big') || c.classList.contains('hero'))
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          io.unobserve(e.target)
          sfx.blip(chimeStep++)
          const r = e.target.getBoundingClientRect()
          ring(r.left + r.width / 2, r.top + r.height / 2, 'rgba(255,255,255,0.5)', 20)
          e.target.classList.add('focused')
        }
      },
      { rootMargin: '-42% 0px -42% 0px' }
    )
    bigCards.forEach((c) => io.observe(c))
  }
  addEventListener('pointerdown', unlock, { once: true })
  addEventListener('scroll', unlock, { once: true, passive: true })

  const sky = document.getElementById('sky')
  const hudZone = document.getElementById('hudZone')
  const hudDepth = document.getElementById('hudDepth')
  const hudFill = document.getElementById('hudFill')
  const hudPressure = document.getElementById('hudPressure')
  const hudLight = document.getElementById('hudLight')
  const reel = document.querySelector('.reel')
  const dive = document.getElementById('dive')
  const TOTAL = zones[zones.length - 1].to

  /* ---- the shell ------------------------------------------------------ */

  let ended = false
  let deepestZone = 0
  const shell = createShell({
    slug: 'deep-sea',
    // Back to the surface, not a reload: nothing about the dive needs resetting
    // except where you are and whether the bottom has been reached.
    onRestart: () => {
      ended = false
      deepestZone = 0
      scrollTo({ top: dive.getBoundingClientRect().top + scrollY - 16, behavior: 'instant' })
    },
  })

  /* The strip rolls its digits, so it is told once the scroll settles rather
     than on every frame of it; the gauge above the water is the live one. */
  let stripT = 0
  let at = { metres: 0, zoneIdx: 0 }
  function paintStrip() {
    const { metres, zoneIdx } = at
    shell.setScore(fmtDepth(metres).replace(/(\d)(k?m)$/, '$1 $2'))
    shell.setLevel(`${zoneIdx + 1} / ${zones.length}`)
    shell.setMoves(fmtPressure(metres))
    if (metres >= 1) shell.considerBest(Math.round(metres), fmtDepth(metres).replace(/(\d)(k?m)$/, '$1 $2'))
  }

  function reachedBottom() {
    ended = true
    clearTimeout(stripT)
    paintStrip()
    recordPlay('deep-sea', { depthM: TOTAL }, { depthM: 'high' })
    shell.win({
      kicker: 'Challenger Deep · Mariana Trench',
      title: 'The bottom of the ocean.',
      score: '10,935 m',
      from: '0 m',
      lines: [
        `${fmtPressure(TOTAL).replace('atm', 'atmospheres')} of pressure: over a tonne pressing on every square centimetre.`,
        'The last of the sunlight gave out nearly ten kilometres ago.',
      ],
      againLabel: 'Dive again',
    })
  }

  const fmtDepth = (m) => (m >= 1000 ? `${(m / 1000).toFixed(2)}km` : `${Math.round(m)}m`)
  const fmtPressure = (m) => {
    const atm = 1 + m / 10
    return atm >= 100 ? `${Math.round(atm).toLocaleString('en-US')} atm` : `${atm.toFixed(1)} atm`
  }

  const mix = (a, b, t) => {
    const p = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16))
    const [r1, g1, b1] = p(a), [r2, g2, b2] = p(b)
    const c = (x, y) => Math.round(x + (y - x) * t)
    return `rgb(${c(r1, r2)},${c(g1, g2)},${c(b1, b2)})`
  }

  /* The rendered water column. The CSS gradient underneath stays in place if
     the surface never comes up. */
  let curD = 0
  const surface = new ShaderSurface(document.getElementById('skygl'), DEEP_SEA_FRAG, {
    scale: 0.75,
    uniforms: () => ({ u_D: curD }),
  })

  let ticking = false
  function update() {
    ticking = false
    // Measured against the viewport, not offsetTop: the reel sits inside the
    // shell's stage now, and offsetTop is only relative to that.
    const depth = window.innerHeight / 2 - reel.getBoundingClientRect().top
    const clamped = Math.max(0, Math.min(totalHeight, depth))

    const zone = zones.find((z) => clamped < z.offset + z.height) ?? zones[zones.length - 1]
    const within = clamped - zone.offset
    const metres = Math.max(0, Math.min(zone.to, zone.from + within / zone.pxPerMetre))

    hudZone.textContent = zone.label.toLowerCase()
    hudDepth.textContent = fmtDepth(metres)
    hudPressure.textContent = fmtPressure(metres)
    hudLight.textContent = zone.light
    hudFill.style.width = `${(clamped / totalHeight) * 100}%`

    const t = zone.height ? Math.min(1, Math.max(0, within / zone.height)) : 0
    hudFill.style.background = mix(zone.sky[0], zone.sky[1], t)
    sky.style.background = `linear-gradient(${mix(zone.sky[0], zone.sky[1], t)}, ${mix(zone.sky[0], zone.sky[1], Math.min(1, t + 0.25))})`

    curD = metres
    if (prefersReducedMotion) surface.redraw()

    const zoneIdx = zones.indexOf(zone)
    at = { metres, zoneIdx }
    // Each zone announces itself the first time you sink into it.
    if (zoneIdx > deepestZone) {
      deepestZone = zoneIdx
      shell.levelUp(zone.label)
    }
    clearTimeout(stripT)
    stripT = window.setTimeout(paintStrip, 180)
    if (!ended && metres >= TOTAL - 0.5) reachedBottom()
  }

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    },
    { passive: true }
  )
  addEventListener('resize', () => { relayout(); update() }, { passive: true })
  update()
</script>

<style>
  /* The dive fills the stage edge to edge: no padding, no card, the water is
     the whole frame. overflow: clip rather than hidden, which would make the
     stage a scroll container and stop the backdrop and gauge sticking. */
  :global(.stage:has(> .ds)) { padding: 0; overflow: clip; background: #04101c; }
  .ds { position: relative; color: #f3f5f8; container-type: inline-size; }

  /* Sticky, not fixed: pinned to the viewport while the dive is on screen,
     but it stays inside the frame. The negative margin takes it back out of
     the flow so the dive scrolls over it rather than after it. */
  .ds-back { position: sticky; top: 0; height: 100vh; margin-bottom: -100vh; overflow: hidden; }
  .skygl { position: absolute; inset: 0; pointer-events: none; }
  .skygl :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .sky {
    position: absolute; inset: 0;
    background: linear-gradient(#bdeaf5, #0e4a68);
    transition: background 260ms linear;
  }

  /* A soft fade at the very top of the viewport, under the HUD but over the
     reel, so a card sliding up to meet the HUD loses contrast gradually
     instead of vanishing behind a hard-edged bar. */
  /* The gauge's own pin: zero height, so it takes no room in the dive. */
  .ds-hud-pin { position: sticky; top: 0; height: 0; z-index: 40; }
  .hud-scrim {
    position: absolute; inset: 0 0 auto 0; height: 172px;
    pointer-events: none;
    background: linear-gradient(rgba(0, 4, 8, 0.5), rgba(0, 4, 8, 0));
  }

  .hud {
    position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
    width: min(calc(100% - 24px), 520px); text-align: center;
    padding: 10px 16px; border-radius: 12px;
    background: rgba(0, 0, 0, 0.66);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }
  .hud-label { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.78; }
  .hud-depth { font-size: 19px; font-weight: 700; margin-top: 2px; }
  .hud-bar { height: 3px; background: rgba(255,255,255,0.2); border-radius: 2px; margin: 9px 0 6px; }
  .hud-fill { height: 100%; width: 0; background: #fff; border-radius: 2px; transition: background 300ms linear; }
  .hud-row { display: flex; justify-content: space-between; font-size: 12px; opacity: 0.8; gap: 10px; }
  .hud-row span:last-child { opacity: 0.85; text-align: right; }

  .intro { position: relative; min-height: 78vh; display: grid; place-content: center; text-align: center; gap: 10px; padding: 150px 20px 0; }
  .intro-title {
    font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 600;
    font-size: clamp(40px, 9cqw, 84px); line-height: 1; letter-spacing: -0.03em;
  }
  .intro p { opacity: 0.75; margin: 0; font-size: 18px; max-width: 32ch; margin-inline: auto; }
  .arrow { font-size: 30px; opacity: 0.6; }
  :global(html.play) .arrow { animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(10px); } }

  .reel { position: relative; overflow-x: clip; }

  /* A creature is a window into the water at that depth, not a row in a
     list. The card chrome that used to sit around all of this — panel
     background, border, inset highlight — was the single thing making a
     descent past a giant squid read as an article about one: it framed every
     animal identically and left the drawing itself about a third the width of
     the box it sat in. The drawing is now the element, the caption sits under
     it, and the only thing left around it is the light it throws into the
     water. (The scenes are rectangular by contract — check-deep-sea-art
     requires them fully painted, edge to edge — so this is a porthole, and it
     is allowed to look like one.) */
  .ev {
    position: absolute; left: 50%; transform: translateX(-50%);
    width: min(88cqw, 460px);
    display: grid; justify-items: center;
    gap: 12px; text-align: center;
    --moodRgb: 138, 148, 160;
  }
  .ev.lane-left { left: 50%; transform: translateX(-104%); width: min(44cqw, 300px); }
  .ev.lane-right { left: 50%; transform: translateX(4%); width: min(44cqw, 300px); }
  .ev.lane-left h2, .ev.lane-right h2 { font-size: 19px; }
  .ev.lane-left p, .ev.lane-right p { font-size: 13.5px; }

  /* No frame at all. These are cut-outs now — the drawing is the animal and
     nothing else — so a rounded box with a border around it would be a
     porthole drawn around something that is not behind glass. The glow has
     to follow the shape rather than the box, which is what drop-shadow does
     and box-shadow cannot: box-shadow traces the element rectangle, so on a
     transparent SVG it draws a bright rectangle in open water. */
  .ev-art {
    width: 100%; aspect-ratio: 3 / 2;
    filter:
      drop-shadow(0 0 14px rgba(var(--moodRgb), 0.55))
      drop-shadow(0 0 40px rgba(var(--moodRgb), 0.35));
    /* Everything down here is suspended in moving water, including the
       window you are looking through. */
    animation: drift 11s ease-in-out infinite;
    animation-delay: var(--drift, 0s);
  }
  @keyframes drift {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-9px) rotate(-0.5deg); }
  }

  .ev.big { width: min(92cqw, 620px); }
  .ev.big h2 { font-size: 30px; }
  .ev.big .ev-art { filter: drop-shadow(0 0 18px rgba(var(--moodRgb), 0.7)) drop-shadow(0 0 60px rgba(var(--moodRgb), 0.45)); }
  .ev.lane-left.big, .ev.lane-right.big { width: min(46cqw, 340px); }
  .ev.lane-left.big h2, .ev.lane-right.big h2 { font-size: 22px; }

  /* The named animals — giant squid, anglerfish, colossal squid, the ones a
     scroll like this actually gets remembered for. Rendered a size class
     above everything but the record markers, on the same "the drawing is
     the element" cut-out rule, so the size read as impact rather than as a
     bigger card around the same small picture. */
  .ev.hero { width: min(94cqw, 700px); }
  .ev.hero h2 { font-size: 32px; }
  .ev.hero p { font-size: 16px; max-width: 50ch; }
  .ev.hero .ev-art { filter: drop-shadow(0 0 20px rgba(var(--moodRgb), 0.72)) drop-shadow(0 0 68px rgba(var(--moodRgb), 0.46)); }
  .ev.lane-left.hero, .ev.lane-right.hero { width: min(48cqw, 370px); }
  .ev.lane-left.hero h2, .ev.lane-right.hero h2 { font-size: 23px; }

  @keyframes seen-pulse {
    0%   { filter: drop-shadow(0 0 10px rgba(var(--moodRgb), 0.35)); }
    45%  { filter: drop-shadow(0 0 34px rgba(var(--moodRgb), 1)) drop-shadow(0 0 80px rgba(var(--moodRgb), 0.8)); }
    100% { filter: drop-shadow(0 0 18px rgba(var(--moodRgb), 0.7)) drop-shadow(0 0 60px rgba(var(--moodRgb), 0.45)); }
  }
  .ev.big.focused .ev-art, .ev.hero.focused .ev-art { animation: drift 11s ease-in-out infinite, seen-pulse 820ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }

  /* The compaction tiers relayout() reaches for when markers crowd together:
     lose the prose, then shrink the window, rather than letting two of them
     overlap. */
  .ev.compact p { display: none; }
  .ev.compact { width: min(40cqw, 230px); }
  .ev.compact-hard p { display: none; }
  .ev.compact-hard .ev-art { width: 74px; }
  @container (max-width: 620px) {
    .ev { width: min(92cqw, 330px); }
    .ev.lane-left, .ev.lane-right { width: min(46cqw, 190px); }
    .ev.lane-left { transform: translateX(-103%); }
    .ev.big { width: min(94cqw, 360px); }
    .ev.lane-left.big, .ev.lane-right.big { width: min(46cqw, 200px); }
    .ev.hero { width: min(96cqw, 400px); }
    .ev.lane-left.hero, .ev.lane-right.hero { width: min(48cqw, 220px); }
  }
  .ev-when {
    font-size: 12px; letter-spacing: 0.10em; text-transform: uppercase;
    opacity: 0.8;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.9);
  }
  /* No card behind the words any more, so they carry their own legibility
     against whatever colour the water happens to be at this depth. */
  .ev h2 {
    font-size: 24px; margin: 4px 0 0; font-weight: 700;
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.95), 0 0 30px rgb(0 0 0 / 0.7);
  }
  .ev p {
    margin: 6px 0 0; opacity: 0.86; font-size: 15px; max-width: 46ch;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.95), 0 0 24px rgb(0 0 0 / 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .ev.big.focused .ev-art { animation: none; }
    .ev-art { animation: none; }
    .ev { transition: none; }
  }

