---
import GameShell from '../layouts/GameShell.astro'
import { ZONES, MARKERS, TOTAL_ALTITUDE, fmtAltitude } from '../data/space-elevator'
import type { Marker } from '../data/space-elevator'
import { SPACE_ELEVATOR_ART, MOOD, sceneSvg } from '../lib/space-elevator-art'
import { digitCellHTML } from '../lib/seven-segment'

/**
 * Space Elevator — a linear scroll from sea level to the Kármán line, the
 * internationally recognised edge of space, 100,000 real metres up.
 *
 * Same shape as `deep-sea.astro`, climbing instead of descending: real
 * atmospheric-layer zones rather than an invented scale, a scroll-linked HUD,
 * and every marker placed at its true altitude rather than spaced out to
 * look nice. The one number computed live rather than looked up is the air
 * temperature, from the real US Standard Atmosphere 1976 formula
 * (`src/lib/space-elevator-model.ts`) — the same model aviation uses.
 *
 * **The climb runs bottom-to-top of the page, not top-to-bottom.** Ground
 * sits at the very end of the document; the Kármán line and the finale sit
 * at the very start. The page loads pre-scrolled to the bottom (see the
 * client script's `scrollTo` call), and scrolling *up* — toward the top of
 * the document — is what ascends. Every pixel offset below is computed in
 * `d`-space first: `d` is plain distance-from-ground in pixels, exactly the
 * quantity the old top-to-bottom version used directly as a CSS `top`. The
 * one and only inversion point is `toReelTop(d)`, which turns that d-space
 * value into a position measured from the *top* of `.reel` instead — every
 * other formula (zone lookup, temperature, pressure, the sky mix) still
 * operates on `d` and is untouched by the flip.
 *
 * In the shell the climb is the stage. The sky is a sticky backdrop inside the
 * frame and the gauge sticks to the top of it; the page opens at the ground,
 * at the bottom of the stage. Because the climb ends at the top of the page,
 * the result card sits above the stage (`resultFirst`), and the gauge carries
 * its own How-to-play button, since the shell's bar is a hundred kilometres of
 * scrolling away. Score is the altitude, Layer is which of the four you are
 * in, Moves is the temperature outside, Best is the highest you have been, and
 * the Kármán line is the ending.
 */

let cursor = 0
const zones = ZONES.map((z) => {
  const height = Math.round((z.to - z.from) * z.pxPerMetre)
  const laid = { ...z, height, offset: cursor }
  cursor += height
  return laid
})
const totalHeight = cursor
// Blank scroll room at the *high-altitude* end of the reel now — the pause
// between the finale (which precedes the reel in the DOM) and the first,
// highest marker you actually reach.
const REEL_TAIL = 520
// And the same idea at the *ground* end: the lowest marker's `top` sits
// exactly at REEL_TAIL + totalHeight regardless of this buffer (toReelTop
// doesn't depend on reelHeight), so this is pure blank space the card's own
// height — now much taller, with full-width art — can safely overflow into
// without reaching into `.intro`'s title on a narrow, tall viewport where
// the note text wraps to many lines.
const GROUND_TAIL = 320
const reelHeight = totalHeight + REEL_TAIL + GROUND_TAIL

/** d-space (distance from ground, px) -> position from the top of `.reel`. */
const toReelTop = (d: number) => REEL_TAIL + (totalHeight - d)

/** Real altitude (metres) -> d-space (distance from ground, px). */
function altToD(altitude: number) {
  const zone = zones.find((z) => altitude >= z.from && altitude <= z.to) ?? zones[zones.length - 1]
  return zone.offset + Math.round((altitude - zone.from) * zone.pxPerMetre)
}

const CARD_H = 96

type Placed = ReturnType<typeof at> & { lane: 'center' | 'left' | 'right' }
function at(m: Marker) {
  return { ...m, top: toReelTop(altToD(m.altitude)) }
}

// A deterministic starfield for the high-altitude end of the climb, fading
// in from roughly the middle of the stratosphere onward — the same shape
// the sky gradient itself darkens on, just given actual points of light
// rather than a flat colour. In reel-space that's a band starting right
// after the leading blank tail.
const starRegionStartD = Math.round(zones[1].offset + zones[1].height * 0.45)
const starRegionTop = REEL_TAIL
const starRegionHeight = totalHeight - starRegionStartD
const starRnd = (seed: number, k: number) => {
  const x = Math.sin(seed * 9301 + k * 49297) * 233280
  return x - Math.floor(x)
}
const stars = Array.from({ length: 160 }, (_, i) => ({
  x: (starRnd(11, i) * 100).toFixed(1),
  y: (starRnd(11, i + 500) * 100).toFixed(1),
  r: (0.35 + starRnd(11, i + 900) * 1.15).toFixed(2),
  o: (0.25 + starRnd(11, i + 1300) * 0.65).toFixed(2),
  dur: (2.6 + starRnd(11, i + 1700) * 3.6).toFixed(2),
  delay: (starRnd(11, i + 2100) * 4).toFixed(2),
}))

// Rain, low in the troposphere (0-3,000m) — same deterministic-seed
// discipline as the starfield, just anchored to the ground end instead.
const rainRegionTop = toReelTop(altToD(3_000))
const rainRegionHeight = reelHeight - rainRegionTop
const rainRnd = (seed: number, k: number) => {
  const x = Math.sin(seed * 7207 + k * 15731) * 176192
  return x - Math.floor(x)
}
const raindrops = Array.from({ length: 70 }, (_, i) => ({
  x: (rainRnd(23, i) * 100).toFixed(1),
  y: (rainRnd(23, i + 400) * 100).toFixed(1),
  len: (14 + rainRnd(23, i + 800) * 22).toFixed(0),
  dur: (0.7 + rainRnd(23, i + 1200) * 0.6).toFixed(2),
  delay: (rainRnd(23, i + 1600) * 1.4).toFixed(2),
  o: (0.18 + rainRnd(23, i + 2000) * 0.28).toFixed(2),
}))

// Markers sort ascending by altitude (the data file guarantees this), which
// after toReelTop() is now *descending* reel-top order — reverse it back to
// ascending-by-top for the grouping pass below, which only cares about
// proximity, not which end is which.
const rough = MARKERS.map(at).slice().reverse()
const placed: Placed[] = []
for (let i = 0; i < rough.length; ) {
  let j = i + 1
  while (j < rough.length && rough[j].top < rough[j - 1].top + CARD_H) j++
  const group = rough.slice(i, j)
  if (group.length === 1) {
    placed.push({ ...group[0], lane: 'center' })
  } else {
    group.forEach((g, k) => placed.push({ ...g, lane: k % 2 === 0 ? 'left' : 'right' }))
  }
  i = j
}

const rgb = (hex: string) =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ')

// A big layered mountain panorama behind the Everest / Mont Blanc /
// Kilimanjaro cluster (roughly 3,500-9,200m) — one wide background band,
// not another card, positioned the same way the starfield is.
const panoramaTop = toReelTop(altToD(9_200))
const panoramaBottom = toReelTop(altToD(3_500))
const panoramaHeight = panoramaBottom - panoramaTop

const HUD_DIGITS = 6
---

<GameShell
  slug="space-elevator"
  labels={{ score: 'Altitude', best: 'Highest', level: 'Layer', moves: 'Outside' }}
  initial={{ score: '0 m', level: `1 / ${ZONES.length}`, moves: '15°C' }}
  resultFirst
>
  <div class="se" id="climbRoot">
  {/* The sky, pinned to the viewport while the climb scrolls past it. */}
  <div class="se-back" aria-hidden="true">
    <div class="sky" id="sky"></div>
    <div class="sky-grid"></div>
  </div>

  <div class="se-hud-pin">
  <div class="hud-scrim" aria-hidden="true"></div>
  <div class="hud" id="hud" role="group" aria-label="Altitude gauge">
    <button type="button" class="hud-btn hud-music" id="musicToggle" aria-pressed="false" aria-label="Play elevator music">
      <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M8 3.5 L14.5 2 L14.5 12.2 A2.6 2.1 0 1 1 13 10.4 L13 5.2 L9.5 6 L9.5 14.2 A2.6 2.1 0 1 1 8 12.4Z" fill="currentColor"/></svg>
    </button>
    <button type="button" class="hud-btn hud-help" data-act="howto" aria-haspopup="dialog" aria-label="How to play">?</button>
    <div class="hud-label" id="hudZone">the troposphere</div>
    <div class="hud-alt-row">
      <span class="odometer" id="hudOdo" set:html={Array.from({ length: HUD_DIGITS }, () => digitCellHTML()).join('')} />
      <span class="hud-unit">m</span>
    </div>
    <div class="hud-bar"><div class="hud-fill" id="hudFill"></div></div>
    <div class="hud-row">
      <span id="hudTemp">15°C outside</span>
      <span id="hudPressure">100% sea-level pressure</span>
    </div>
  </div>
  </div>

  <section class="finale">
    <p class="fin-kicker">Past the Kármán line</p>
    <h2>The elevator doesn't stop here — it just gets a lot less interesting to draw</h2>
    <p>
      Keep going and, around 220 kilometres up, you'd pass through the
      brightest part of the aurora — the same particles from the sun that,
      lower down, only ever reach the thermosphere you just left. Around
      400 kilometres, you'd meet the International Space Station, quietly
      falling around the Earth just fast enough to keep missing it.
    </p>
    <p>
      But a <em>real</em> space elevator — the kind engineers have
      seriously proposed — doesn't stop until <strong>35,786 kilometres</strong>,
      geostationary orbit, where a counterweight has to sit for the whole
      cable to hang taut rather than fall. Nobody has built one, and the
      reason is not imagination. It's materials science: the cable has to be
      strong enough to hold up its own weight across that entire span, and
      no material we can currently manufacture at that length — not steel,
      not Kevlar, not carbon fibre — is anywhere close. Carbon nanotubes are
      individually strong enough, in a lab, at a few centimetres. Nobody
      knows how to make one 35,786 kilometres long.
    </p>
    <p class="fin-closer">
      So the gap between "possible" and "built" here isn't physics. It's an
      unsolved engineering problem, sitting quietly behind a page that, until
      a few paragraphs ago, was only asking you to scroll.
    </p>
  </section>


  <div class="climb">
    <div class="cable-track" id="cableTrack" aria-hidden="true">
      <div class="cable-line"></div>
      <div class="cable-car" id="cableCar">
        <div class="cable-car-window">
          <span class="rider-head"></span>
          <span class="rider-body" id="riderBody"></span>
        </div>
      </div>
    </div>

    <div class="reel" style={`height:${reelHeight}px`}>
    <div class="starfield" style={`top:${starRegionTop}px; height:${starRegionHeight}px`} aria-hidden="true">
      {stars.map((s) => (
        <i class="se-star" style={`left:${s.x}%; top:${s.y}%; width:${(Number(s.r) * 2.2).toFixed(2)}px; height:${(Number(s.r) * 2.2).toFixed(2)}px; opacity:${s.o}; animation-duration:${s.dur}s; animation-delay:-${s.delay}s`} />
      ))}
    </div>

    <div class="rain" style={`top:${rainRegionTop}px; height:${rainRegionHeight}px`} aria-hidden="true">
      {raindrops.map((r) => (
        <i class="se-rain" style={`left:${r.x}%; top:${r.y}%; height:${r.len}px; opacity:${r.o}; animation-duration:${r.dur}s; animation-delay:-${r.delay}s`} />
      ))}
    </div>

    <div class="panorama" style={`top:${panoramaTop}px; height:${panoramaHeight}px`} aria-hidden="true">
      <svg viewBox="0 0 900 620" preserveAspectRatio="xMidYMax slice">
        <path d="M0 620 L0 340 L140 220 L230 300 L330 170 L430 280 L520 150 L620 260 L720 190 L820 270 L900 210 L900 620Z" fill="#7f97b8" opacity="0.55"/>
        <path d="M0 620 L0 400 L120 300 L210 360 L310 250 L410 340 L500 240 L600 330 L700 270 L800 350 L900 300 L900 620Z" fill="#5c7295" opacity="0.75"/>
        <path d="M0 620 L0 460 L100 380 L190 430 L290 340 L390 410 L480 330 L580 400 L680 360 L780 420 L900 380 L900 620Z" fill="#3d4f70"/>
        <path d="M140 220 L165 245 L188 226 M330 170 L352 194 L378 176 M520 150 L543 174 L568 156 M720 190 L742 212 L766 196" fill="none" stroke="#eaf3ff" stroke-width="6" stroke-linecap="round" opacity="0.85"/>
      </svg>
    </div>

    {
      zones.map((z, i) =>
        i === 0 ? null : (
          <div class="seam" style={`top:${toReelTop(z.offset)}px;--from:${zones[i - 1].sky[1]};--to:${z.sky[0]}`}>
            <div class="seam-bubble">
              <span class="seam-name">{z.label}</span>
              <span class="seam-note">
                {z.from.toLocaleString('en-US')}m to {z.to.toLocaleString('en-US')}m — {z.note}
              </span>
            </div>
          </div>
        )
      )
    }
    {
      placed.map((m) => {
        const mood = MOOD[m.title]
        // Deterministic per-marker phase, so twenty-nine windows are not all
        // drifting in step — same trick as Deep Sea's own cards.
        const drift = `--drift:${-((m.altitude * 7919) % 1100) / 100}s`
        const style = mood
          ? `top:${m.top}px;--mood:${mood};--moodRgb:${rgb(mood)};${drift}`
          : `top:${m.top}px;${drift}`
        return (
          <article class:list={['ev', `lane-${m.lane}`, { big: m.big }]} style={style}>
            {SPACE_ELEVATOR_ART[m.title] && <div class="ev-art" set:html={sceneSvg(m.title)} />}
            <div class="ev-text">
              <div class="ev-when">{fmtAltitude(m.altitude)} up</div>
              <h2>{m.title}</h2>
              <p>{m.note}</p>
            </div>
          </article>
        )
      })
    }
    </div>

    <div class="intro">
      <div class="intro-title">
        <svg class="intro-spark a" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 0 L12 8 L20 10 L12 12 L10 20 L8 12 L0 10 L8 8Z" fill="#4fe3c1"/></svg>
        <svg class="intro-spark b" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 0 L12 8 L20 10 L12 12 L10 20 L8 12 L0 10 L8 8Z" fill="#6ee7ff"/></svg>
        <svg class="intro-spark c" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 0 L12 8 L20 10 L12 12 L10 20 L8 12 L0 10 L8 8Z" fill="#b8a1ff"/></svg>
        <p class="se-title">Space Elevator</p>
      </div>
      <p>Every metre above is real, all the way to the edge of space — 100,000 real metres up.</p>
      <div class="jacket-pick" id="jacketPick">
        <p>It's about to get cold. Pick a jacket for the ride:</p>
        <div class="jacket-swatches">
          {[
            ['#d9534f', '#a83a37', 'Red jacket'],
            ['#4f7fd9', '#33559e', 'Blue jacket'],
            ['#e8b84f', '#b98a2e', 'Yellow jacket'],
          ].map(([main, shade, label]) => (
            <button type="button" class="jacket-swatch" data-color={main} style={`--jc:${main}`} aria-label={label}>
              <svg viewBox="0 0 40 40" aria-hidden="true">
                <path d="M13 8 L16 6 L20 10 L24 6 L27 8 L27 12 L32 15 L29 21 L27 19 L27 34 L13 34 L13 19 L11 21 L8 15 L13 12Z" fill={main}/>
                <path d="M20 10 L24 6 L27 8 L27 12 L22 12Z" fill={shade} opacity="0.6"/>
                <path d="M13 19 L13 34 L16 34 L16 21Z" fill={shade} opacity="0.35"/>
                <circle cx="20" cy="17" r="1.4" fill={shade}/>
                <circle cx="20" cy="22" r="1.4" fill={shade}/>
                <circle cx="20" cy="27" r="1.4" fill={shade}/>
              </svg>
            </button>
          ))}
        </div>
      </div>
      <div class="arrow" aria-hidden="true">↑</div>
      <p class="scroll-hint">Scroll up!</p>
      <div class="ground" aria-hidden="true">
        <svg viewBox="0 0 900 220" preserveAspectRatio="xMidYMax slice">
          <defs>
            <radialGradient id="se-ground-glow" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#ffd27a" stop-opacity="0.55"/>
              <stop offset="1" stop-color="#ffd27a" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="se-ground-far" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#345a72"/>
              <stop offset="1" stop-color="#24404f"/>
            </linearGradient>
          </defs>
          <ellipse cx="70" cy="196" rx="150" ry="60" fill="url(#se-ground-glow)"/>
          <!-- far ridge, smooth and hazy -->
          <path d="M0 220 L0 132 Q90 96 180 118 T360 108 T540 122 T720 100 T900 116 L900 220Z" fill="url(#se-ground-far)" opacity="0.65"/>
          <!-- mid slope -->
          <path d="M0 220 L0 160 Q120 128 240 148 T480 140 T720 156 T900 138 L900 220Z" fill="#1c3d3a" opacity="0.85"/>
          <!-- near hill, darkest, carries the tree line -->
          <path d="M0 220 L0 188 Q140 158 280 176 T560 168 T900 182 L900 220Z" fill="#0e2320"/>
          <!-- a loose pine tree line along the near ridge -->
          <g fill="#081613">
            <path d="M46 176 L54 176 L50 158Z"/>
            <path d="M44 176 L56 176 L50 150 L45 162 L55 162 L50 150Z"/>
            <path d="M96 172 L106 172 L101 150Z"/>
            <path d="M94 172 L108 172 L101 141 L95 156 L107 156 L101 141Z"/>
            <path d="M210 168 L218 168 L214 152Z"/>
            <path d="M600 172 L610 172 L605 152Z"/>
            <path d="M598 172 L612 172 L605 143 L599 158 L611 158 L605 143Z"/>
            <path d="M700 176 L708 176 L704 160Z"/>
            <path d="M820 172 L830 172 L825 152Z"/>
            <path d="M818 172 L832 172 L825 143 L819 158 L831 158 L825 143Z"/>
          </g>
        </svg>
      </div>
    </div>
  </div>
  </div>

  <Fragment slot="howto">
    <p>
      Scroll <b>up</b>, from sea level to the Kármán line, 100 kilometres up:
      the internationally agreed edge of space.
    </p>
    <ul>
      <li>Every bird, aircraft, balloon and record is placed at its real altitude. The four layers are the real layers of the atmosphere.</li>
      <li>The gauge gives your altitude, the real temperature outside (from the US Standard Atmosphere, the model aviation uses) and how much air is left.</li>
      <li>Pick a jacket before you go; the note button plays elevator music.</li>
    </ul>
    <p>The Kármán line is the end, and there is a little more to read above it. Your best is the highest you have been.</p>
  </Fragment>
</GameShell>

<script type="application/json" id="game-data" set:html={JSON.stringify({ zones, totalHeight, reelHeight, REEL_TAIL })} />

<script>
  import { ring } from '../lib/fx'
  import { sfx, unlock, tone } from '../lib/audio'
  import { segmentsFor, fitWidth } from '../lib/seven-segment'
  import { standardTemperatureK, kelvinToC, approxPressureRatio } from '../lib/space-elevator-model'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { recordPlay } from '../lib/stats'
  import { SITE } from '../site.config'
  import { createShell } from '../lib/game-shell'

  // The climb reads bottom-to-top — open at the ground, the bottom of the
  // stage, rather than the browser's default top-of-page, and stop the
  // browser fighting that with its own back-forward scroll memory.
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual'
  function toGround() {
    const intro = document.querySelector('.intro') as HTMLElement
    scrollTo({ top: intro.getBoundingClientRect().bottom + scrollY - innerHeight + 16, behavior: 'instant' })
  }
  toGround()

  const { zones, totalHeight, reelHeight, REEL_TAIL } = JSON.parse(
    document.getElementById('game-data')!.textContent!,
  ) as any

  const cards = [...document.querySelectorAll('.ev')] as HTMLElement[]

  function relayout() {
    const measure = (lane: string) => {
      for (const el of cards) {
        el.classList.remove('lane-center', 'lane-left', 'lane-right', 'compact', 'compact-hard')
        el.classList.add(lane)
      }
      return cards.map((el) => el.offsetHeight)
    }
    const wide = measure('lane-center')
    const narrow = measure('lane-left')

    const GROUP_GAP = 8
    const boxes = cards.map((el, i) => ({
      el, top: el.offsetTop, h: Math.max(wide[i], narrow[i]) + GROUP_GAP,
    }))

    const groups: typeof boxes[] = []
    for (let i = 0; i < boxes.length; ) {
      let j = i + 1
      while (j < boxes.length && boxes[j].top < boxes[j - 1].top + boxes[j - 1].h) j++
      groups.push(boxes.slice(i, j))
      i = j
    }

    for (const group of groups) {
      if (group.length === 1) {
        group[0].el.classList.remove('lane-left')
        group[0].el.classList.add('lane-center')
        continue
      }
      const TIERS = ['', 'compact', 'compact-hard']
      for (let attempt = 0; attempt < TIERS.length; attempt++) {
        const bottom = { left: -Infinity, right: -Infinity }
        let clash = false
        for (const b of group) {
          const h = b.el.offsetHeight
          const GAP = 10
          let lane =
            bottom.left + GAP <= b.top ? 'left' : bottom.right + GAP <= b.top ? 'right' : null
          if (!lane) {
            clash = true
            lane = bottom.left <= bottom.right ? 'left' : 'right'
          }
          b.el.classList.remove('lane-left', 'lane-right')
          b.el.classList.add('lane-' + lane)
          bottom[lane as 'left' | 'right'] = b.top + h
        }
        if (!clash) break
        const next = TIERS[attempt + 1]
        if (next) for (const b of group) b.el.classList.add(next)
      }
    }
  }
  relayout()

  let chimeStep = 0
  const bigCards = cards.filter((c) => c.classList.contains('big'))
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          io.unobserve(e.target)
          sfx.blip(chimeStep++)
          const r = e.target.getBoundingClientRect()
          ring(r.left + r.width / 2, r.top + r.height / 2, 'rgba(255,255,255,0.5)', 20)
          e.target.classList.add('focused')
        }
      },
      { rootMargin: '-42% 0px -42% 0px' },
    )
    bigCards.forEach((c) => io.observe(c))
  }
  addEventListener('pointerdown', unlock, { once: true })
  addEventListener('scroll', unlock, { once: true, passive: true })

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const sky = $('sky')
  const hud = $('hud')
  const hudZone = $('hudZone')
  const hudFill = $('hudFill')
  const hudTemp = $('hudTemp')
  const hudPressure = $('hudPressure')
  const cableCar = document.getElementById('cableCar')
  const cableTrack = document.getElementById('cableTrack')
  const introEl = document.querySelector('.intro') as HTMLElement
  const reel = document.querySelector('.reel') as HTMLElement

  // The digital-odometer altitude readout: one real seven-segment cell per
  // digit, same shape Printing Money's debt clock and Days Since Incident's
  // counter already use — reused wholesale rather than re-invented.
  const odoDigits = [...$('hudOdo').children] as HTMLElement[]
  const prefersReducedMotion = !document.documentElement.classList.contains('play') || matchMedia('(prefers-reduced-motion: reduce)').matches
  function setOdometer(metres: number) {
    const raw = fitWidth(String(Math.max(0, Math.round(metres))), odoDigits.length)
    for (let i = 0; i < odoDigits.length; i++) {
      const cell = odoDigits[i]
      const ch = raw[i]
      if (cell.dataset.v === ch) continue
      const changed = cell.dataset.v !== undefined
      cell.dataset.v = ch
      const lit = segmentsFor(ch)
      const segs = cell.children
      for (let s = 0; s < lit.length; s++) segs[s]!.classList.toggle('on', lit[s])
      if (changed && !prefersReducedMotion) {
        cell.classList.remove('flicker')
        void cell.offsetWidth
        cell.classList.add('flicker')
      }
    }
  }

  // The track spans the intro's ground and the whole reel — its own height
  // depends on the intro's real, responsive height, so it is measured rather
  // than assumed.
  function sizeTrack() {
    if (cableTrack) cableTrack.style.height = `${reelHeight + introEl.offsetHeight}px`
  }
  sizeTrack()

  // `.reel`'s `offsetTop` is relative to its own offsetParent (`.climb`,
  // which is `position: relative`) — it does not include `.climb`'s own
  // position in the document, which is now substantial (`.finale` and
  // the shell above it all precede it). `getBoundingClientRect()` gives the real
  // viewport-relative position with no offsetParent ambiguity; adding the
  // current scroll turns that into a document-absolute one. Measured fresh
  // inside `update()` itself rather than cached — a cached value went stale
  // the moment anything above the reel reflowed (a webfont swap in the long
  // `.finale` copy was enough to shift it by thousands of pixels), and this
  // runs at most once per animation frame already, so the extra read costs
  // nothing worth avoiding.
  function reelTopAbs() {
    return reel.getBoundingClientRect().top + window.scrollY
  }

  // ---- pick a jacket ---------------------------------------------------
  // A colour choice with a real, visible consequence: the rider inside the
  // cable car keeps it for the rest of the climb.
  const jacketPick = document.getElementById('jacketPick')
  jacketPick?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.jacket-swatch') as HTMLElement | null
    if (!btn) return
    unlock()
    document.documentElement.style.setProperty('--rider-color', btn.dataset.color!)
    jacketPick.querySelectorAll('.jacket-swatch').forEach((b) => b.classList.remove('picked'))
    btn.classList.add('picked')
    jacketPick.classList.add('chosen')
    sfx.click()
  })

  // ---- elevator music ----------------------------------------------------
  // A small looping pentatonic riff via the shared tone() synth — not a new
  // audio subsystem, just a handful of scheduled notes on an interval.
  const musicBtn = document.getElementById('musicToggle')
  let musicOn = false
  let musicTimer: number | null = null
  let musicStep = 0
  const MUSIC_MOTIF = [0, 2, 4, 7, 4, 2]
  function musicTick() {
    tone({ freq: 220 * Math.pow(2, MUSIC_MOTIF[musicStep % MUSIC_MOTIF.length] / 12), dur: 0.85, type: 'triangle', gain: 0.05 })
    musicStep++
  }
  musicBtn?.addEventListener('click', () => {
    unlock()
    musicOn = !musicOn
    musicBtn.setAttribute('aria-pressed', String(musicOn))
    musicBtn.classList.toggle('on', musicOn)
    if (musicOn) {
      musicTick()
      musicTimer = window.setInterval(musicTick, 900)
    } else if (musicTimer !== null) {
      clearInterval(musicTimer)
      musicTimer = null
    }
  })

  const fmtAltitude = (m: number) => (m >= 1000 ? `${(m / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })}km` : `${Math.round(m)}m`)

  const mix = (a: string, b: string, t: number) => {
    const p = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16))
    const [r1, g1, b1] = p(a); const [r2, g2, b2] = p(b)
    const c = (x: number, y: number) => Math.round(x + (y - x) * t)
    return `rgb(${c(r1, r2)},${c(g1, g2)},${c(b1, b2)})`
  }

  /* Declared before the pacing block on purpose — see day-go.astro and
     speed.astro for why a page that can load already scrolled needs this
     ordering: shareCard's TDZ window has to close before anything can
     synchronously reach it. */
  let shareCard: import('../lib/result-card').ResultCard | null = null

  function updateShareCard(altitude: number) {
    const t = standardTemperatureK(Math.min(altitude, 86_000))
    shareCard = {
      slug: 'space-elevator',
      siteName: SITE.name,
      headline: `Climbed to ${fmtAltitude(altitude)}`,
      sub: t !== null ? `Real outside air: ${kelvinToC(t).toFixed(0)}°C` : 'Past where a single temperature even means anything',
      stats: [
        { label: 'Altitude', value: fmtAltitude(altitude) },
        { label: '% to the Kármán line', value: `${Math.min(100, Math.round((altitude / 100_000) * 100))}%` },
      ],
    }
    recordPlay('space-elevator', { altitudeM: altitude }, { altitudeM: 'high' })
  }

  /* ---- the shell ---------------------------------------------------------- */

  const KARMAN = 100_000
  let ended = false
  let highestZone = 0
  const shell = createShell({
    slug: 'space-elevator',
    // Back down to the ground rather than a reload: the jacket you picked
    // stays on.
    onRestart: () => { ended = false; highestZone = 0; toGround() },
  })

  /* The strip rolls its digits, so it is told once the scroll settles; the
     gauge on the sky is the live one. */
  const short = (m: number) => fmtAltitude(m).replace(/(\d)(k?m)$/, '$1 $2')
  let stripT = 0
  let at = { metres: 0, zoneIdx: 0 }
  function paintStrip() {
    const { metres, zoneIdx } = at
    shell.setScore(short(metres))
    shell.setLevel(`${zoneIdx + 1} / ${zones.length}`)
    const t = standardTemperatureK(metres)
    shell.setMoves(t !== null ? `${kelvinToC(t).toFixed(0).replace('-', '−')}°C` : '—')
    if (metres >= 1) shell.considerBest(Math.round(metres), short(metres))
  }

  function reachedSpace(metres: number) {
    ended = true
    updateShareCard(metres)
    shell.levelUp('The edge of space')
    const pct = approxPressureRatio(KARMAN) * 100
    // The card waits above the stage rather than pulling the page up to it:
    // there is still the rest of the thermosphere, and the finale, to climb
    // through on the way.
    shell.win({
      scroll: false,
      kicker: 'The Kármán line · 100 km up',
      title: 'You are in space.',
      score: '100 km',
      from: '000 km',
      lines: [
        `The air is ${pct.toPrecision(2)}% as thick as it was on the ground.`,
        'Everything above this line is, officially, space.',
      ],
      againLabel: 'Ride down and go again',
    })
    shell.resultExtra.innerHTML =
      '<div class="se-report-acts"><button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share the climb</span></button></div>'
    document.getElementById('shareBtn')!.addEventListener('click', async (e) => {
      if (!shareCard) return
      const label = (e.currentTarget as HTMLElement).querySelector('span')!
      const outcome = await shareResult(shareCard, { title: 'Space Elevator', text: `${shareCard.headline}.`, url: location.href })
      label.textContent = outcomeLabel[outcome]
      setTimeout(() => (label.textContent = 'Share the climb'), 1600)
    })
  }

  let ticking = false
  function update() {
    ticking = false
    // Position within the reel, measured from the reel's own top (the
    // high-altitude end, since the reel now precedes the ground/intro in
    // the DOM). `d` converts that back into the one quantity every other
    // formula below actually wants: real distance-from-ground in pixels —
    // identical meaning to what this function used to read directly off
    // the scroll position, before the climb was flipped.
    const raw = window.scrollY + window.innerHeight / 2 - reelTopAbs()
    const topInReel = Math.max(0, Math.min(reelHeight, raw))
    const d = Math.max(0, Math.min(totalHeight, totalHeight - (topInReel - REEL_TAIL)))

    const zone = zones.find((z: any) => d < z.offset + z.height) ?? zones[zones.length - 1]
    const within = d - zone.offset
    const metres = Math.max(0, Math.min(zone.to, zone.from + within / zone.pxPerMetre))

    hud.classList.toggle('visible', metres > 60)
    hudZone.textContent = zone.label.toLowerCase()
    setOdometer(metres)

    const t = standardTemperatureK(metres)
    hudTemp.textContent = t !== null ? `${kelvinToC(t).toFixed(0)}°C outside` : 'no single temperature up here'
    const pct = approxPressureRatio(metres) * 100
    hudPressure.textContent = pct >= 1 ? `${pct.toFixed(1)}% sea-level pressure` : `${pct.toFixed(3)}% sea-level pressure`

    if (cableCar) cableCar.style.top = `${topInReel}px`

    hudFill.style.width = `${(d / totalHeight) * 100}%`
    const zt = zone.height ? Math.min(1, Math.max(0, within / zone.height)) : 0
    const zoneColor = mix(zone.sky[0], zone.sky[1], zt)
    hudFill.style.background = zoneColor
    hud.style.setProperty('--glow', `rgba(${zoneColor.slice(4, -1)}, 0.4)`)
    sky.style.background = `linear-gradient(${zoneColor}, ${mix(zone.sky[0], zone.sky[1], Math.min(1, zt + 0.25))})`

    const zoneIdx = zones.indexOf(zone)
    at = { metres, zoneIdx }
    // Each layer announces itself the first time you climb into it.
    if (zoneIdx > highestZone) {
      highestZone = zoneIdx
      if (metres < KARMAN) shell.levelUp(zone.label)
    }
    clearTimeout(stripT)
    stripT = window.setTimeout(paintStrip, 180)
    if (!ended && metres >= KARMAN) reachedSpace(metres)
  }

  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update) }
  }, { passive: true })
  addEventListener('resize', () => { relayout(); sizeTrack(); update() }, { passive: true })
  update()
</script>

<style>
  /* The climb fills the stage edge to edge. overflow: clip rather than
     hidden, which would make the stage a scroll container and stop the sky
     and the gauge sticking. */
  :global(.stage:has(> .se)) { padding: 0; overflow: clip; background: #030510; }
  .se { position: relative; color: #f3f5f8; container-type: inline-size; }

  /* Sticky, not fixed: pinned while the climb is on screen, but inside the
     frame. The negative margin takes it back out of the flow. */
  .se-back { position: sticky; top: 0; height: 100vh; margin-bottom: -100vh; overflow: hidden; }
  .se-hud-pin { position: sticky; top: 0; height: 0; z-index: 40; }
  .finale, .climb { position: relative; }

  .sky {
    position: absolute; inset: 0;
    background: linear-gradient(#8fcaf0, #2a5a86);
    transition: background 260ms linear;
  }
  /* A faint measured-graph-paper texture over the whole climb — static, no
     motion cost, and a small nod to how technical this page's numbers
     actually are. */
  .sky-grid {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.5;
    background-image:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 64px);
  }

  .hud-scrim {
    position: absolute; inset: 0 0 auto 0; height: 172px;
    pointer-events: none;
    background: linear-gradient(rgba(0, 4, 8, 0.5), rgba(0, 4, 8, 0));
  }

  .hud {
    position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
    width: min(calc(100% - 24px), 460px); text-align: center;
    padding: 8px 16px; border-radius: 20px;
    background: rgba(6, 10, 20, 0.5);
    border: 1.5px solid var(--glow, rgba(255, 255, 255, 0.16));
    box-shadow: 0 0 26px -6px var(--glow, transparent), 0 6px 18px -8px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    pointer-events: none;
    opacity: 0;
    transition: border-color 300ms linear, box-shadow 300ms linear, opacity 420ms var(--ease, ease);
  }
  .hud.visible { opacity: 1; }
  .hud:not(.visible) .hud-btn { visibility: hidden; }
  .hud-label { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.78; }

  .hud-btn {
    position: absolute; top: 8px; right: 10px; pointer-events: auto;
    appearance: none; border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.06);
    color: inherit; width: 26px; height: 26px; border-radius: 50%; cursor: pointer;
    font-size: 13px; line-height: 1; display: grid; place-items: center;
    transition: background 160ms linear, color 160ms linear;
  }
  .hud-help { right: auto; left: 10px; font: 700 13px/1 var(--sans); }
  .hud-music.on { background: var(--mint); color: var(--ink); }

  .hud-alt-row {
    display: flex; align-items: baseline; justify-content: center; gap: 5px;
    margin-top: 4px;
  }
  .hud-unit { font-size: 13px; opacity: 0.75; }
  .hud-bar { height: 3px; background: rgba(255, 255, 255, 0.2); border-radius: 2px; margin: 9px 0 6px; }
  .hud-fill { height: 100%; width: 0; background: #fff; border-radius: 2px; transition: background 300ms linear; }
  .hud-row { display: flex; justify-content: space-between; font-size: 12px; opacity: 0.8; gap: 10px; }
  .hud-row span:last-child { opacity: 0.85; text-align: right; }

  .intro { position: relative; min-height: 78vh; display: grid; place-content: center; text-align: center; gap: 10px; padding: 40px 20px 0; overflow: hidden; }
  .intro-title { position: relative; z-index: 2; display: grid; place-items: center; }
  .intro .se-title {
    font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 700;
    font-size: clamp(44px, 11cqw, 92px); line-height: 1; letter-spacing: -0.03em;
    color: #eaf3ff; -webkit-text-stroke: 3px #0a1626; paint-order: stroke fill;
    text-shadow: 0 4px 0 #5b82ff, 0 9px 0 #0a1626, 0 18px 34px rgba(0, 0, 0, 0.45);
  }
  :global(html.play) .intro .se-title { animation: title-pop 700ms var(--spring) both; }
  @keyframes title-pop { from { opacity: 0; transform: scale(0.7) rotate(-3deg); } }
  .intro-spark {
    position: absolute; width: 22px; height: 22px; opacity: 0.85; pointer-events: none;
    animation: bob 3.2s ease-in-out infinite;
  }
  .intro-spark.a { left: 6%; top: 6%; --r: -8deg; animation-delay: -0.4s; }
  .intro-spark.b { right: 5%; top: 44%; --r: 10deg; width: 16px; height: 16px; animation-delay: -1.6s; }
  .intro-spark.c { left: 12%; bottom: 2%; --r: 6deg; width: 14px; height: 14px; animation-delay: -2.3s; }
  .intro p { opacity: 0.85; margin: 0; font-size: 18px; max-width: 32ch; margin-inline: auto; position: relative; z-index: 2; text-shadow: 0 2px 16px rgba(0, 0, 0, 0.3); }
  .scroll-hint { font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
  .arrow { font-size: 30px; opacity: 0.7; animation: bob 1.8s ease-in-out infinite; position: relative; z-index: 2; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  .ground {
    position: absolute; left: 0; right: 0; bottom: 0; height: 28vh; min-height: 190px;
    z-index: 1; pointer-events: none;
  }
  .ground svg { width: 100%; height: 100%; display: block; }

  /* ---- pick a jacket ------------------------------------------------- */
  .jacket-pick {
    position: relative; z-index: 2; margin-top: 10px;
    background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px; padding: 14px 20px; backdrop-filter: blur(4px);
  }
  .jacket-pick p { font-size: 14px; opacity: 0.9; margin: 0 0 12px; max-width: none; font-weight: 600; }
  .jacket-pick.chosen p { opacity: 0.6; }
  .jacket-swatches { display: flex; gap: 12px; justify-content: center; }
  /* A small sticker card, not a flat colour dot — the same cutout-on-a-
     card motif the rest of the site uses (--sticker-border/-shadow), so the
     one real UI control on this page looks made rather than default. */
  .jacket-swatch {
    appearance: none; cursor: pointer; padding: 6px;
    background: #eef3fa; border: var(--sticker-border, 2.5px solid #16151a);
    border-radius: 12px; box-shadow: var(--sticker-shadow, 3px 4px 0 rgba(0, 0, 0, 0.25));
    width: 52px; height: 52px;
    transition: transform 160ms var(--ease-bounce, ease), box-shadow 160ms var(--ease-bounce, ease);
  }
  .jacket-swatch svg { display: block; width: 100%; height: 100%; }
  .jacket-swatch:hover { transform: translateY(-3px) rotate(-3deg); }
  .jacket-swatch.picked {
    transform: translateY(-4px) scale(1.08) rotate(2deg);
    box-shadow: var(--sticker-shadow-hover, 5px 7px 0 rgba(0, 0, 0, 0.3)), 0 0 0 3px var(--jc);
  }

  .climb { position: relative; }
  .reel { position: relative; overflow-x: clip; }

  .starfield { position: absolute; left: 0; right: 0; z-index: 0; pointer-events: none; overflow: hidden;
    mask-image: linear-gradient(to top, transparent, #000 35%);
    -webkit-mask-image: linear-gradient(to top, transparent, #000 35%); }
  .se-star {
    position: absolute; display: block; border-radius: 50%; background: #eaf3ff;
    animation-name: se-twinkle; animation-iteration-count: infinite; animation-timing-function: ease-in-out;
  }
  @keyframes se-twinkle { 0%, 100% { opacity: 0.15; } 50% { opacity: 1; } }

  /* ---- rain, low in the troposphere ----------------------------------- */
  .rain { position: absolute; left: 0; right: 0; z-index: 0; pointer-events: none; overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, #000 20%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 20%); }
  .se-rain {
    position: absolute; width: 1.4px; background: linear-gradient(rgba(200, 220, 240, 0), rgba(200, 220, 240, 0.8));
    animation-name: se-fall; animation-iteration-count: infinite; animation-timing-function: linear;
    transform: rotate(11deg);
  }
  @keyframes se-fall { 0% { transform: translateY(-40px) rotate(11deg); } 100% { transform: translateY(60px) rotate(11deg); } }

  /* ---- the Everest / Mont Blanc / Kilimanjaro panorama ------------------ */
  /* The band this sits in is tall (it spans a real altitude range), but the
     artwork itself is a fixed-proportion illustration — pinned to the
     bottom of that band (the lower, closer altitude) so it reads as one
     mountain range you climb past, rather than a single image stretched
     to fill however many pixels of scroll the range happens to take. */
  .panorama { position: absolute; left: 0; right: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .panorama svg { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: auto; display: block; }

  .cable-track { position: absolute; top: 0; left: 26px; width: 30px; height: 0; z-index: 1; pointer-events: none; }
  .cable-line {
    position: absolute; left: 50%; top: 0; bottom: 0; width: 2.4px; transform: translateX(-50%);
    background: linear-gradient(#dfe6ee, rgba(223, 230, 238, 0.35));
    opacity: 0.6;
  }
  .cable-car {
    position: absolute; left: 50%; top: 0; transform: translate(-50%, -50%);
    width: 28px; height: 38px; border-radius: 7px;
    background: #0d1f38; border: 2px solid #eaf3ff;
    box-shadow: 0 0 20px -2px rgba(255, 200, 140, 0.75), 0 3px 10px rgba(0, 0, 0, 0.5);
    transition: top 60ms linear;
  }
  .cable-car-window { position: absolute; inset: 4px; background: #16233c; border-radius: 3px; overflow: hidden; }
  .rider-head { position: absolute; left: 50%; top: 3px; transform: translateX(-50%); width: 6px; height: 6px; border-radius: 50%; background: #ffe3c2; }
  .rider-body { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 9px; height: 11px; border-radius: 3px 3px 0 0; background: var(--rider-color, #ffd27a); }
  @container (max-width: 460px) {
    .cable-track { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .se-star { animation: none; }
    .se-rain { animation: none; }
    .cable-car { transition: none; }
  }

  /* No frame at all — the same call Deep Sea makes, and for the same reason:
     these are cut-outs now, floating in real sky rather than sitting inside a
     porthole painted to approximate it. The glow has to trace the drawing's
     own silhouette rather than a card's rectangle, which is what drop-shadow
     does and box-shadow cannot. */
  .ev {
    position: absolute; left: 50%; transform: translateX(-50%); z-index: 2;
    width: min(88cqw, 480px);
    display: grid; justify-items: center;
    gap: 12px; text-align: center;
    --moodRgb: 234, 243, 255;
  }
  .ev.lane-left { left: 50%; transform: translateX(-104%); width: min(44cqw, 320px); }
  .ev.lane-right { left: 50%; transform: translateX(4%); width: min(44cqw, 320px); }
  .ev.lane-left h2, .ev.lane-right h2 { font-size: 18px; }
  .ev.lane-left p, .ev.lane-right p { font-size: 13.5px; }

  /* Everything up here is suspended in thin air, including the window you
     are looking through — same trick as Deep Sea's water, drifting instead
     of sinking. The drawing is the element now, not an icon pinned to the
     top of a text column: it fills the card's own width (Deep Sea's exact
     move, see its `.ev-art` comment), so a scene that used to read as an
     86px badge now reads as the thing you are passing. */
  .ev-art {
    width: min(100%, 260px); aspect-ratio: 1 / 1;
    filter:
      drop-shadow(0 0 20px rgba(var(--moodRgb), 0.55))
      drop-shadow(0 0 56px rgba(var(--moodRgb), 0.32));
    animation: ev-drift 12s ease-in-out infinite;
    animation-delay: var(--drift, 0s);
  }
  @keyframes ev-drift {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(0.6deg); }
  }
  .ev-art svg { display: block; width: 100%; height: 100%; }

  .ev.big { width: min(92cqw, 560px); }
  .ev.big h2 { font-size: 27px; }
  .ev.big .ev-art { width: min(100%, 340px); filter: drop-shadow(0 0 26px rgba(var(--moodRgb), 0.7)) drop-shadow(0 0 74px rgba(var(--moodRgb), 0.42)); }
  .ev.lane-left.big h2, .ev.lane-right.big h2 { font-size: 19px; }

  @keyframes seen-pulse {
    0%   { filter: drop-shadow(0 0 8px rgba(var(--moodRgb), 0.3)); }
    45%  { filter: drop-shadow(0 0 30px rgba(var(--moodRgb), 1)) drop-shadow(0 0 70px rgba(var(--moodRgb), 0.75)); }
    100% { filter: drop-shadow(0 0 16px rgba(var(--moodRgb), 0.65)) drop-shadow(0 0 50px rgba(var(--moodRgb), 0.4)); }
  }
  .ev.big.focused .ev-art { animation: seen-pulse 820ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }

  /* Dense zones (upper stratosphere/mesosphere, where a few hundred real
     metres is only a handful of scroll pixels) still need a fallback that
     keeps SOME picture on screen rather than jumping straight to bare text
     — a small fixed-footprint icon, not the card's own (now much wider)
     width, or "compact" would still be too tall to ever resolve a clash and
     everything would end up in compact-hard regardless. */
  .ev.compact p { display: none; }
  .ev.compact { width: min(46cqw, 220px); }
  .ev.compact .ev-art { width: 64px; }
  .ev.compact-hard .ev-when { display: none; }
  .ev.compact-hard .ev-art { display: none; }
  @container (max-width: 620px) {
    .ev { width: min(92cqw, 360px); }
    .ev.lane-left, .ev.lane-right { width: min(48cqw, 240px); }
    .ev.big { width: min(94cqw, 400px); }
    /* Before this, a big card in a side lane took the full-width size and
       hung off both edges of a phone. */
    .ev.lane-left.big, .ev.lane-right.big { width: min(48cqw, 240px); }
  }
  .ev-when {
    font-size: 12px; letter-spacing: 0.10em; text-transform: uppercase;
    opacity: 0.85;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.85);
  }
  /* No card behind the words either, so they carry their own legibility
