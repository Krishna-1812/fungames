  }
  .seam-name { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: #5a6478; display: block; }
  .seam-note { font-size: 13.5px; opacity: 0.92; margin-top: 4px; display: block; }

  .finale { max-width: 640px; margin: 10vh auto 0; padding: 0 22px 8vh; text-align: left; }
  .fin-kicker { font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #ff9d5c; opacity: 0.9; margin: 0 0 12px; font-weight: 600; }
  .finale h2 { font-size: clamp(24px, 4vw, 32px); margin: 0 0 18px; letter-spacing: -0.02em; }
  .finale p { font-size: 16px; line-height: 1.7; opacity: 0.85; margin: 0 0 16px; }
  .finale em { color: #ff9d5c; font-style: normal; }
  .finale strong { color: #ffd27a; }
  .fin-closer { opacity: 0.95; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.1); }

  .outro { padding: 6vh 20px 16vh; text-align: center; }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: center; margin-bottom: 20px; }
  .acts button {
    appearance: none; border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.06);
    color: inherit; padding: 10px 18px; border-radius: 999px; cursor: pointer; font-size: 14px; font-weight: 600;
  }
  .acts button:first-child { background: linear-gradient(165deg, #ffcb8f, #ff9d5c); color: #2a1608; border: 0; }
  .acts a { color: inherit; opacity: 0.7; font-size: 14px; text-decoration: none; }
  .acts a:hover { opacity: 1; }
  .outro-line { font-size: 15px; opacity: 0.6; margin: 0; }
</style>

<style is:global>
  /* ---- the HUD odometer: a real seven-segment display -------------------
     `#hudOdo`'s digit cells come from `digitCellHTML()` via `set:html`, so
     they never get Astro's scoped-style attribute — same trap this site's
     other odometers (Printing Money, Days Since Incident) already hit, and
     the same fix: a plain global selector, not `:global(...)`, because this
     whole block is already `is:global` and that wrapper only means
     something inside a *scoped* block. */
  .odometer { display: inline-flex; line-height: 1; --seg-on: #eaf3ff; --seg-off: rgba(255, 255, 255, 0.14); }
  .digit { position: relative; display: inline-block; width: 0.6em; height: 1em; margin: 0 0.05em; flex: none; font-size: 19px; }
  .digit.flicker { animation: se-odo-flicker 320ms steps(1, end); }
  @keyframes se-odo-flicker { 0%, 18%, 36% { filter: brightness(1.7); } 9%, 27%, 100% { filter: brightness(1); } }
  .seg { position: absolute; background: var(--seg-off); transition: background 140ms linear, box-shadow 140ms linear; }
  .seg.on { background: var(--seg-on); box-shadow: 0 0 0.08em var(--seg-on), 0 0 0.3em rgba(234, 243, 255, 0.55); }
  .seg-a, .seg-g, .seg-d {
    left: 0.065em; width: 0.43em; height: 0.09em;
    clip-path: polygon(14% 0, 86% 0, 100% 50%, 86% 100%, 14% 100%, 0 50%);
  }
  .seg-a { top: 0; } .seg-g { top: 0.455em; } .seg-d { top: 0.91em; }
  .seg-f, .seg-b, .seg-e, .seg-c {
    width: 0.09em; height: 0.41em; clip-path: polygon(0 14%, 50% 0, 100% 14%, 100% 86%, 50% 100%, 0 86%);
  }
  .seg-f, .seg-e { left: 0; } .seg-b, .seg-c { right: 0; }
  .seg-f, .seg-b { top: 0.09em; } .seg-e, .seg-c { top: 0.5em; }
  @media (prefers-reduced-motion: reduce) {
    .digit.flicker { animation: none; }
  }
</style>
