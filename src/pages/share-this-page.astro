---
import GameLayout from '../layouts/GameLayout.astro'
import { METHODS } from '../lib/share-methods'

/**
 * Share This Page — one message, thirty ways to send it.
 *
 * Every tile marked "real" is a genuine, checkable transform — see
 * src/lib/share-methods.ts for the citations. The ten without the badge say
 * so themselves: they are jokes, not encodings, and the blurb never claims
 * otherwise. Nothing here needs a backend: every "send" happens entirely in
 * this tab, against whatever you actually typed.
 */
---

<GameLayout slug="share-this-page" bar="#1b2740" bodyClass="stp-body">
  <div class="stp-bg" aria-hidden="true">
    <div class="stp-grid-tex"></div>
    <div class="stp-glow"></div>
  </div>

  <header class="stp-head">
    <p class="stp-eyebrow">One message · thirty ways out</p>
    <h1>Share This Page</h1>
    <p class="stp-sub">
      Type anything below. Every tile sends it a different way — most of them
      for real: the actual Morse timing, the actual Braille cell, the actual
      dial tones. A handful are just jokes, and they admit it.
    </p>
    <div class="stp-composer">
      <label for="msg" class="stp-label">Your message</label>
      <input id="msg" type="text" maxlength="90" autocomplete="off" value="You should see this." />
    </div>
  </header>

  <div class="stp-grid" id="grid">
    {METHODS.map((m) => (
      <button type="button" class="stp-tile" data-id={m.id} data-kind={m.kind} style={`--accent:${m.accent}`}>
        <svg class="stp-tile-icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" set:html={m.icon} />
        <span class="stp-tile-title">{m.title}</span>
        {m.kind === 'real' && <span class="stp-real-badge">real</span>}
      </button>
    ))}
  </div>

  <div class="stp-modal" id="modal" hidden>
    <div class="stp-modal-backdrop" id="backdrop"></div>
    <div class="stp-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <button type="button" class="stp-close" id="closeBtn" aria-label="Close">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <div class="stp-modal-head">
        <span class="stp-modal-icon" id="modalIconWrap"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" id="modalIcon"></svg></span>
        <div>
          <h2 id="modalTitle"></h2>
          <p class="stp-modal-blurb" id="modalBlurb"></p>
        </div>
      </div>
      <div class="stp-output" id="modalOutput"></div>
      <div class="stp-modal-actions" id="modalActions">
        <button type="button" class="stp-act" id="playBtn" hidden>
          <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M6 4l10 6-10 6z" fill="currentColor"/></svg>
          <span id="playLabel">Play</span>
        </button>
        <button type="button" class="stp-act" id="copyBtn" hidden>Copy</button>
      </div>
    </div>
  </div>
</GameLayout>

<script>
  import { unlock, tone, hit, sfx } from '../lib/audio'
  import { shake, prefersReducedMotion } from '../lib/fx'
  import {
    METHODS, methodById,
    morseText, morseBeats, MORSE_UNIT,
    brailleText, brailleCells,
    tapCode,
    natoWords,
    binaryText, hexText, base64Text,
    rot13, atbash, leet, pigLatin, reverseText, upsideDown,
    keypadDigits, dtmfTones,
    textNotes,
    interstellarGrid,
  } from '../lib/share-methods'

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const msgInput = $<HTMLInputElement>('msg')
  const grid = $('grid')
  const modal = $('modal')
  const backdrop = $('backdrop')
  const closeBtn = $('closeBtn')
  const modalTitle = $('modalTitle')
  const modalBlurb = $('modalBlurb')
  const modalOutput = $('modalOutput')
  const modalIconWrap = $('modalIconWrap')
  const modalIcon = $<SVGSVGElement & HTMLElement>('modalIcon')
  const playBtn = $<HTMLButtonElement>('playBtn')
  const playLabel = $('playLabel')
  const copyBtn = $<HTMLButtonElement>('copyBtn')

  const message = () => msgInput.value.trim() || 'You should see this.'

  let currentId = ''
  let playing = false

  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const e = document.createElement(tag)
    if (cls) e.className = cls
    if (text != null) e.textContent = text
    return e
  }

  function mono(text: string) {
    const p = el('p', 'stp-mono')
    p.textContent = text
    return p
  }

  // -------------------------------------------------------------- players --

  function playMorse() {
    const beats = morseBeats(message())
    let t = 0
    const marks = Array.from(modalOutput.querySelectorAll<HTMLElement>('.stp-morse-mark'))
    let mi = 0
    beats.forEach((b) => {
      if (b.on) {
        tone({ freq: 660, dur: b.units * MORSE_UNIT * 0.92, type: 'sine', gain: 0.22, delay: t })
        const mark = marks[mi++]
        if (mark) setTimeout(() => mark.classList.add('is-lit'), t * 1000)
      }
      t += b.units * MORSE_UNIT
    })
    return t
  }

  function playTapCode() {
    const taps = tapCode(message())
    let t = 0
    taps.forEach((tap) => {
      for (let i = 0; i < tap.row; i++) { hit({ dur: 0.05, gain: 0.3, freq: 1800, q: 4, delay: t }); t += 0.14 }
      t += 0.22
      for (let i = 0; i < tap.col; i++) { hit({ dur: 0.05, gain: 0.3, freq: 1200, q: 4, delay: t }); t += 0.14 }
      t += 0.4
    })
    return t
  }

  function playDtmf() {
    const tones = dtmfTones(message())
    let t = 0
    tones.forEach(({ freqs }) => {
      tone({ freq: freqs[0], dur: 0.16, type: 'sine', gain: 0.16, delay: t })
      tone({ freq: freqs[1], dur: 0.16, type: 'sine', gain: 0.16, delay: t })
      t += 0.2
    })
    return t
  }

  function playNotes() {
    const notes = textNotes(message())
    let t = 0
    notes.forEach((n) => {
      tone({ freq: n.freq, dur: 0.22, type: 'triangle', gain: 0.2, delay: t })
      t += 0.15
    })
    return t
  }

  function playVoice() {
    if (!('speechSynthesis' in window)) return 0
    const u = new SpeechSynthesisUtterance(message())
    speechSynthesis.cancel()
    speechSynthesis.speak(u)
    return 0
  }

  // -------------------------------------------------------------- render --

  function renderReal(id: string) {
    modalOutput.innerHTML = ''
    playBtn.hidden = true
    copyBtn.hidden = true
    const msg = message()

    switch (id) {
      case 'morse': {
        const text = morseText(msg)
        modalOutput.append(mono(text))
        const row = el('div', 'stp-morse-row')
        text.replace(/\s+/g, ' ').split('').forEach((ch) => {
          if (ch === '.' || ch === '-') row.append(el('span', `stp-morse-mark stp-morse-${ch === '.' ? 'dot' : 'dash'}`))
        })
        modalOutput.append(row)
        playBtn.hidden = false
        playLabel.textContent = 'Play the beeps'
        copyBtn.hidden = false
        playBtn.onclick = () => { unlock(); if (playing) return; playing = true; playMorse(); setTimeout(() => (playing = false), playMorse() * 1000) }
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'braille': {
        const text = brailleText(msg)
        const big = el('p', 'stp-braille-text', text)
        modalOutput.append(big)
        const cellsRow = el('div', 'stp-braille-cells')
        brailleCells(msg).forEach((dots) => {
          const cell = el('div', 'stp-braille-cell')
          for (let d = 1; d <= 6; d++) cell.append(el('span', `stp-dot${dots.includes(d) ? ' is-on' : ''}`))
          cellsRow.append(cell)
        })
        modalOutput.append(cellsRow)
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'tap-code': {
        const taps = tapCode(msg)
        modalOutput.append(mono(taps.map((t) => `${t.row}-${t.col}`).join('  ')))
        const gridWrap = el('div', 'stp-tapgrid')
        for (let r = 1; r <= 5; r++) {
          for (let c = 1; c <= 5; c++) gridWrap.append(el('div', 'stp-tapcell', ''))
        }
        modalOutput.append(gridWrap)
        playBtn.hidden = false
        playLabel.textContent = 'Play the knocks'
        playBtn.onclick = async () => {
          unlock()
          if (playing) return
          playing = true
          const cells = Array.from(gridWrap.children) as HTMLElement[]
          for (const tap of taps) {
            const idx = (tap.row - 1) * 5 + (tap.col - 1)
            cells[idx]?.classList.add('is-hit')
            setTimeout(() => cells[idx]?.classList.remove('is-hit'), 500)
            await new Promise((r) => setTimeout(r, 60))
          }
          playing = false
          playTapCode()
        }
        break
      }
      case 'nato': {
        const words = natoWords(msg)
        const list = el('div', 'stp-nato')
        words.forEach((w) => list.append(el('span', 'stp-nato-word', w)))
        modalOutput.append(list)
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(words.join(' '))
        break
      }
      case 'binary': {
        const text = binaryText(msg)
        modalOutput.append(mono(text))
        const bits = el('div', 'stp-bits')
        text.replace(/ /g, '').split('').slice(0, 96).forEach((b) => bits.append(el('span', `stp-bit${b === '1' ? ' is-on' : ''}`)))
        modalOutput.append(bits)
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'hex': {
        const text = hexText(msg)
        modalOutput.append(mono(text))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'base64': {
        const text = base64Text(msg)
        modalOutput.append(mono(text))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'rot13': {
        const text = rot13(msg)
        modalOutput.append(mono(text))
        modalOutput.append(el('p', 'stp-note', 'Run it through ROT13 again and you get your message back.'))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'atbash': {
        const text = atbash(msg)
        modalOutput.append(mono(text))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'leet': {
        const text = leet(msg)
        modalOutput.append(el('p', 'stp-leet', text))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'pig-latin': {
        const text = pigLatin(msg)
        modalOutput.append(mono(text))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'reverse': {
        const text = reverseText(msg)
        modalOutput.append(mono(text))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'upside-down': {
        const text = upsideDown(msg)
        modalOutput.append(el('p', 'stp-flip', text))
        copyBtn.hidden = false
        copyBtn.onclick = () => copy(text)
        break
      }
      case 'dtmf': {
        const digits = keypadDigits(msg)
        modalOutput.append(mono(digits))
        const pad = el('div', 'stp-pad')
        const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '*', '0', '#']
        keys.forEach((k) => pad.append(el('div', 'stp-key', k)))
        modalOutput.append(pad)
        playBtn.hidden = false
        playLabel.textContent = 'Play the tones'
        playBtn.onclick = async () => {
          unlock()
          if (playing) return
          playing = true
          const seq = digits.split('')
          for (const d of seq) {
            const keyEl = Array.from(pad.children).find((c) => c.textContent === d) as HTMLElement
            keyEl?.classList.add('is-hit')
            setTimeout(() => keyEl?.classList.remove('is-hit'), 180)
            await new Promise((r) => setTimeout(r, 15))
          }
          playDtmf()
          playing = false
        }
        break
      }
      case 'notes': {
        const notes = textNotes(msg)
        const row = el('div', 'stp-notes')
        notes.forEach((n) => row.append(el('span', 'stp-note-chip', n.name)))
        modalOutput.append(row)
        playBtn.hidden = false
        playLabel.textContent = 'Play the melody'
        playBtn.onclick = () => { unlock(); if (playing) return; playing = true; const d = playNotes(); setTimeout(() => (playing = false), d * 1000) }
        break
      }
      case 'voice': {
        const supported = 'speechSynthesis' in window
        modalOutput.append(el('p', 'stp-note', supported ? `“${msg}”` : 'Your browser does not support text-to-speech.'))
        if (supported) {
          playBtn.hidden = false
          playLabel.textContent = 'Speak it'
          playBtn.onclick = () => { unlock(); playVoice() }
        }
        break
      }
      case 'interstellar': {
        const g = interstellarGrid(msg)
        modalOutput.append(el('p', 'stp-note', `${g.rows} × ${g.cols} bits, radioed outward at the speed of light.`))
        const gridWrap = el('div', 'stp-stars')
        gridWrap.style.setProperty('--cols', String(g.cols))
        g.bits.forEach((b) => gridWrap.append(el('div', `stp-star${b ? ' is-on' : ''}`)))
        modalOutput.append(gridWrap)
        break
      }
    }
  }

  function renderJoke() {
    modalOutput.innerHTML = ''
    playBtn.hidden = true
    copyBtn.hidden = true
    modalOutput.append(el('p', 'stp-joke-sent', `“${message()}” — sent.`))
  }

  // -------------------------------------------------------------- modal --

  function open(id: string) {
    const m = methodById(id)
    if (!m) return
    currentId = id
    modalTitle.textContent = m.title
    modalBlurb.textContent = m.blurb
    modalIcon.innerHTML = m.icon
    modalIconWrap.style.setProperty('--accent', m.accent)
    if (m.kind === 'real') renderReal(id)
    else renderJoke()
    modal.hidden = false
    document.body.style.overflow = 'hidden'
    sfx.click()
  }

  function close() {
    modal.hidden = true
    document.body.style.overflow = ''
    speechSynthesis?.cancel?.()
  }

  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text)
      const was = copyBtn.textContent
      copyBtn.textContent = 'Copied'
      sfx.good()
      setTimeout(() => (copyBtn.textContent = was), 1200)
    } catch {
      /* clipboard blocked — nothing useful to say */
    }
  }

  grid.querySelectorAll<HTMLButtonElement>('.stp-tile').forEach((btn) => {
    btn.addEventListener('click', () => { unlock(); open(btn.dataset.id!) })
  })
  closeBtn.addEventListener('click', close)
  backdrop.addEventListener('click', close)
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close() })
</script>

<style>
  .stp-bg { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: #131c30; }
  .stp-grid-tex {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 34px 34px;
  }
  .stp-glow {
    position: absolute; top: -20%; left: 50%; width: 900px; height: 700px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(120, 160, 255, 0.16), transparent 70%);
  }

  .stp-head { max-width: 720px; margin: 48px auto 8px; padding: 0 20px; text-align: center; color: #eaf0ff; }
  .stp-eyebrow { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6; margin: 0 0 8px; }
  .stp-head h1 { font-size: clamp(32px, 6vw, 52px); margin: 0 0 12px; letter-spacing: -0.02em; }
  .stp-sub { opacity: 0.78; line-height: 1.5; margin: 0 0 26px; }

  .stp-composer { display: flex; justify-content: center; }
  .stp-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  #msg {
    width: min(100%, 480px);
    padding: 13px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 15px;
    text-align: center;
    transition: border-color 160ms var(--ease), background 160ms var(--ease);
  }
  #msg:focus { outline: none; border-color: rgba(140, 170, 255, 0.6); background: rgba(255, 255, 255, 0.09); }

  .stp-grid {
    max-width: 980px; margin: 34px auto 80px; padding: 0 20px;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px;
  }
  .stp-tile {
    position: relative;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 18px 10px 14px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 55%, #10182a), color-mix(in srgb, var(--accent) 22%, #0c1220));
    color: #f2f5ff;
    cursor: pointer;
    transition: transform 180ms var(--ease-bounce), border-color 180ms var(--ease), box-shadow 180ms var(--ease);
  }
  .stp-tile:hover { transform: translateY(-3px) scale(1.03); border-color: rgba(255, 255, 255, 0.22); box-shadow: 0 10px 26px -12px rgba(0, 0, 0, 0.6); }
  .stp-tile:active { transform: translateY(-1px) scale(0.99); }
  .stp-tile-icon { opacity: 0.95; }
  .stp-tile-title { font-size: 13px; font-weight: 600; text-align: center; line-height: 1.25; }
  .stp-real-badge {
    position: absolute; top: 8px; right: 9px;
    font-size: 8.5px; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    padding: 2px 6px;
  }

  .stp-modal { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; padding: 20px; }
  .stp-modal[hidden], .stp-act[hidden] { display: none; }
  .stp-modal-backdrop { position: absolute; inset: 0; background: rgba(6, 9, 18, 0.72); backdrop-filter: blur(3px); }
  .stp-modal-card {
    position: relative; z-index: 1;
    width: min(100%, 460px); max-height: 84vh; overflow: auto;
    background: #161f34; color: #eef1fb;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 26px 24px 22px;
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.7);
    animation: stp-pop 220ms var(--ease-bounce);
  }
  @keyframes stp-pop { from { opacity: 0; transform: scale(0.92) translateY(10px); } to { opacity: 1; transform: none; } }
  .stp-close {
    position: absolute; top: 14px; right: 14px;
    width: 30px; height: 30px; border-radius: 999px; border: 0;
    background: rgba(255, 255, 255, 0.08); color: #cfd6ec; cursor: pointer;
    display: grid; place-items: center;
  }
  .stp-close:hover { background: rgba(255, 255, 255, 0.16); }
  .stp-modal-head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 14px; padding-right: 26px; }
  .stp-modal-icon {
    flex: none; width: 46px; height: 46px; border-radius: 12px;
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--accent) 60%, #10182a);
    color: #fff;
  }
  .stp-modal-head h2 { margin: 2px 0 4px; font-size: 19px; }
  .stp-modal-blurb { margin: 0; font-size: 13.5px; line-height: 1.5; opacity: 0.78; }

  .stp-output { margin-top: 16px; min-height: 20px; }
  :global(.stp-mono) {
    font-family: var(--mono, ui-monospace, monospace); font-size: 14px; line-height: 1.6;
    word-break: break-all; background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 12px 14px; margin: 0;
  }
  :global(.stp-note) { font-size: 13.5px; opacity: 0.85; margin: 0 0 10px; }
  :global(.stp-leet) { font-family: var(--mono, monospace); font-size: 22px; font-weight: 700; margin: 0; word-break: break-all; }
  :global(.stp-flip) { font-size: 22px; margin: 0; word-break: break-all; }
  :global(.stp-braille-text) { font-size: 26px; letter-spacing: 2px; margin: 0 0 14px; word-break: break-all; }
  :global(.stp-joke-sent) { font-size: 16px; text-align: center; padding: 18px 0 4px; opacity: 0.92; }

  :global(.stp-morse-row) { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
  :global(.stp-morse-mark) { width: 9px; height: 9px; border-radius: 999px; background: rgba(255, 255, 255, 0.16); transition: background 120ms, box-shadow 120ms; }
  :global(.stp-morse-mark.stp-morse-dash) { width: 18px; border-radius: 5px; }
  :global(.stp-morse-mark.is-lit) { background: #ffd76b; box-shadow: 0 0 10px 2px rgba(255, 215, 107, 0.7); }

  :global(.stp-braille-cells) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  :global(.stp-braille-cell) { display: grid; grid-template-columns: repeat(2, 8px); grid-template-rows: repeat(3, 8px); gap: 2px; padding: 4px; background: rgba(0, 0, 0, 0.22); border-radius: 6px; }
  :global(.stp-braille-cell .stp-dot) { width: 8px; height: 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.14); }
  :global(.stp-braille-cell .stp-dot.is-on) { background: #9db4ff; }

  :global(.stp-tapgrid) { display: grid; grid-template-columns: repeat(5, 30px); grid-template-rows: repeat(5, 30px); gap: 4px; margin-top: 12px; }
  :global(.stp-tapcell) { border-radius: 6px; background: rgba(255, 255, 255, 0.08); transition: background 90ms, transform 90ms; }
  :global(.stp-tapcell.is-hit) { background: #ffd76b; transform: scale(0.88); }

  :global(.stp-nato) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.stp-nato-word) { font-size: 12.5px; padding: 5px 9px; border-radius: 8px; background: rgba(255, 255, 255, 0.08); }

  :global(.stp-bits) { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 10px; }
  :global(.stp-bit) { width: 8px; height: 8px; border-radius: 2px; background: rgba(255, 255, 255, 0.1); }
  :global(.stp-bit.is-on) { background: #7ce0a8; }

  :global(.stp-pad) { display: grid; grid-template-columns: repeat(3, 44px); gap: 6px; margin-top: 12px; justify-content: center; }
  :global(.stp-key) { display: grid; place-items: center; height: 36px; border-radius: 8px; background: rgba(255, 255, 255, 0.08); font-size: 13px; transition: background 90ms, transform 90ms; }
