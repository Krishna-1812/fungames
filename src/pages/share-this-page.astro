  .stp-view-blurb { margin: 0; font-size: 14px; line-height: 1.5; color: rgb(238 242 251 / 0.8); text-shadow: 0 1px 8px rgb(0 0 0 / 0.6); }
  .stp-view-acts { position: absolute; z-index: 1; left: 16px; bottom: 16px; display: flex; gap: 8px; }
  .stp-act[hidden] { display: none; }
  .stp-act {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 17px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.16);
    background: rgb(12 16 26 / 0.62); color: #fff; font-size: 13.5px; font-weight: 600; cursor: pointer;
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    transition: background 140ms var(--ease), transform 160ms var(--ease-bounce);
  }
  .stp-act:hover { background: rgb(40 48 66 / 0.8); transform: scale(1.04); }
  .stp-act:active { transform: scale(0.96); }
  .stp-act:focus-visible { outline: 2px solid #8ff0d6; outline-offset: 2px; }

  .stp-output { margin-top: 12px; max-height: 168px; overflow: auto; color: #e6ebf7; }
