  .stp-tile.is-open .stp-lamp { animation: stp-live-pulse 1.4s ease-in-out infinite; }
  /* The symbol under a domed glass jewel in its enamel. */
  .stp-jewel {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    color: #fff;
