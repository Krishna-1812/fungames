---
import GameShell from '../layouts/GameShell.astro'
import { METHODS } from '../lib/share-methods'

/**
 * Share This Page — one message, thirty ways to send it.
 *
 * Every tile marked "real" is a genuine, checkable transform — see
 * src/lib/share-methods.ts for the citations. The ten without the badge say
 * so themselves: they are jokes, not encodings, and the blurb never claims
 * otherwise. Nothing here needs a backend: every "send" happens entirely in
 * this tab, against whatever you actually typed.
 *
 * Opening a way puts it on the sending desk (lib/share-desk.ts): a real
 * thing under a lamp, made from the message — a brass telegraph key and
 * its signal lamp keying the Morse, Braille embossed in heavy paper under a
 * raking light, eight-track paper tape punched with the bytes, a telephone
 * keypad and two octaves of piano pressed as their tones play, a steel pipe
 * and a spoon for the tap code, a typed sheet for the ciphers, a fanfold
 * printout of the interstellar bitmap, and for each joke a handwritten,
 * stamped, postmarked postcard. The desk stays in view beside the tiles on
 * a wide window and pinned above them on a narrow one; the exact encoding
 * is under it as text, to copy. Without WebGL the text is all there is,
 * which is everything that matters.
 *
 * The tiles are two materials on two shelves. A real way is an engraved
 * plate of dark brushed aluminium, screwed down, its symbol under a glass
 * jewel, with an indicator lamp that lights once it has been sent. A joke is
 * a postcard: card stock, a perforated stamp carrying its symbol, address
 * lines, its name in ink, tilted by a few degrees seeded from its own id so
 * it is stable rather than reshuffling on every load, and franked with a
 * postmark once it has gone.
 *
 * In the shell the room is a dark stage. Score is how many of the ways you
 * have sent it, Real how many of those were genuine encodings, Characters
 * how long the message is, and Best the most ways in one visit. Sending it
 * every way there is, jokes included, is the ending.
 */

// Deterministic, so the same tile always tilts the same amount — a random()
// per render would make the "postcard" read as a layout bug on refresh.
const seedOf = (id: string) => id.split('').reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 1000, 7)
const tiltOf = (id: string) => ((seedOf(id) % 240) / 240 - 0.5) * 5 // -2.5..2.5deg

const BIG = new Set(['morse', 'braille', 'dtmf', 'interstellar'])

// Cool enamels for the jewels and inks for the stamps, dealt round in order
// so neighbours differ. Seeded slot angles keep each screw where it was.
const ENAMEL = ['#35c3a5', '#4f86ff', '#8a7bff', '#3fb9e6', '#5ad38f', '#b77dff', '#ff6b93', '#6fd0ff']
const STAMP = ['#2f5fd0', '#b8324f', '#23806d', '#5d43c4', '#1d76a6']
const REAL = METHODS.filter((m) => m.kind === 'real')
const JOKE = METHODS.filter((m) => m.kind === 'joke')
const slot = (id: string, k: number) => ((seedOf(id + k) * 37) % 180).toFixed(0)
---

<GameShell
  slug="share-this-page"
  labels={{ score: 'Sent', best: 'Most ways', level: 'Real', moves: 'Characters' }}
  initial={{ score: `0 / ${METHODS.length}`, level: `0 / ${METHODS.filter((m) => m.kind === 'real').length}`, moves: '20' }}
  fonts={['Caveat:wght@600;700', 'Courier Prime:wght@400;700']}
>
  <div class="stp-body">
  <div class="stp-bg" aria-hidden="true">
    <div class="stp-grid-tex"></div>
    <div class="stp-radar"></div>
    <div class="stp-glow"></div>
  </div>

  <header class="stp-head">
    <p class="stp-eyebrow"><i class="stp-live-dot" aria-hidden="true"></i>One message · thirty ways out</p>
    <p class="stp-sub">
      Type anything, then pick a way to send it. It goes out for real on the
      desk: the actual Morse on a brass key, the actual Braille pressed into
      paper, the actual dial tones on a keypad. A handful are just jokes, and
      they admit it.
    </p>
    <div class="stp-composer">
      <label for="msg" class="stp-label">Your message</label>
      <div class="stp-input-wrap">
        <input id="msg" type="text" maxlength="90" autocomplete="off" value="You should see this." />
        <div class="stp-signal" id="signal" aria-hidden="true"></div>
      </div>
    </div>
  </header>

  <div class="stp-room">
    <section class="stp-desk" id="desk" aria-labelledby="deskTitle">
      <div class="stp-view">
        <canvas class="stp-canvas" id="deskCanvas" aria-hidden="true"></canvas>
        <div class="stp-view-head">
          <span class="stp-kind" id="deskKind">Ready</span>
          <h2 id="deskTitle">Pick a way to send it</h2>
          <p class="stp-view-blurb" id="deskBlurb">Your message is typed and waiting. Every tile sends it differently.</p>
        </div>
        <div class="stp-view-acts">
          <button type="button" class="stp-act" id="playBtn" hidden>
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M6 4l10 6-10 6z" fill="currentColor"/></svg>
            <span id="playLabel">Play</span>
          </button>
          <button type="button" class="stp-act" id="copyBtn" hidden>Copy</button>
        </div>
      </div>
      <div class="stp-output" id="output" aria-live="polite"></div>
    </section>

    <div class="stp-ways" id="grid">
      <p class="stp-shelf"><span>On the desk</span> real encodings, {REAL.length}</p>
      <div class="stp-grid">
        {REAL.map((m, i) => (
          <button
            type="button"
            class:list={['stp-tile', 'stp-mat-real', { 'stp-tile-big': BIG.has(m.id) }]}
            data-id={m.id}
            data-kind={m.kind}
            aria-controls="desk"
            style={`--enamel:${ENAMEL[i % ENAMEL.length]}`}
          >
            {[0, 1, 2, 3].map((k) => <i class={`stp-screw stp-screw-${k}`} style={`--sr:${slot(m.id, k)}deg`} aria-hidden="true"></i>)}
            <span class="stp-lamp" aria-hidden="true"></span>
            <span class="stp-jewel" aria-hidden="true">
              <svg viewBox="0 0 24 24" width={BIG.has(m.id) ? 26 : 21} height={BIG.has(m.id) ? 26 : 21} set:html={m.icon} />
            </span>
            <span class="stp-tile-title">{m.title}</span>
            <span class="stp-real-badge">real</span>
          </button>
        ))}
      </div>
      <p class="stp-shelf"><span>By post</span> jokes, {JOKE.length}</p>
      <div class="stp-grid stp-grid-post">
        {JOKE.map((m, i) => (
          <button
            type="button"
            class="stp-tile stp-mat-joke"
            data-id={m.id}
            data-kind={m.kind}
            aria-controls="desk"
            style={`--ink:${STAMP[i % STAMP.length]}; --tilt:${tiltOf(m.id).toFixed(2)}deg`}
          >
            <span class="stp-stamp-wrap" aria-hidden="true">
              <span class="stp-stamp">
                <svg viewBox="0 0 24 24" width="18" height="18" set:html={m.icon} />
              </span>
            </span>
            <i class="stp-postmark" aria-hidden="true"></i>
            <span class="stp-tile-title">{m.title}</span>
            <i class="stp-lines" aria-hidden="true"></i>
          </button>
        ))}
      </div>
    </div>
  </div>
  </div>

  <Fragment slot="howto">
    <p>
      Type a message, then send it. Every tile is a different way out, and
      opening one sends your message that way on the desk.
    </p>
    <ul>
      <li>The metal panels are real: the actual Morse timing, the actual Braille cell, the actual dial tones. The ones that make a sound play as they open, and again with Play; most can be copied. Each plate&rsquo;s lamp lights once you&rsquo;ve sent it.</li>
      <li>The handwritten postcards are jokes, and they say so. Each one is franked once it&rsquo;s gone.</li>
      <li>Change the message whenever you like; the desk sends whatever is typed.</li>
    </ul>
    <p>Send it every way there is to finish. The sounds need the Sound button on.</p>
  </Fragment>
</GameShell>

<script>
  import { unlock, output as audioOut, sfx } from '../lib/audio'
  import { createShell } from '../lib/game-shell'
  import { recordPlay } from '../lib/stats'
  import { PLAY } from '../lib/motion'
  import type { Desk, DeskView } from '../lib/share-desk'
  import {
    METHODS, methodById,
    morseText, morseBeats, MORSE_UNIT,
    brailleText, brailleCells,
    tapCode,
    natoWords,
    binaryText, hexText, base64Text,
    rot13, atbash, leet, pigLatin, reverseText, upsideDown,
    keypadDigits, dtmfTones,
    textNotes,
    interstellarGrid,
  } from '../lib/share-methods'

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const msgInput = $<HTMLInputElement>('msg')
  const grid = $('grid')
  const deskEl = $('desk')
  const deskTitle = $('deskTitle')
  const deskBlurb = $('deskBlurb')
  const deskKind = $('deskKind')
  const out = $('output')
  const playBtn = $<HTMLButtonElement>('playBtn')
  const playLabel = $('playLabel')
  const copyBtn = $<HTMLButtonElement>('copyBtn')
  const signal = $('signal')

  const message = () => msgInput.value.trim() || 'You should see this.'

  /* ---- the shell ----------------------------------------------------------- */
  // Restart is the default reload: a fresh message and nothing sent.
  const shell = createShell({ slug: 'share-this-page' })
  const REAL = METHODS.filter((m) => m.kind === 'real').length
  const sent = new Set<string>()
  let realSent = 0
  let ended = false
  function paintStrip() {
    shell.setScore(`${sent.size} / ${METHODS.length}`)
    shell.setLevel(`${realSent} / ${REAL}`)
    if (sent.size) shell.considerBest(sent.size, String(sent.size))
  }
  function noteSent(id: string) {
    const m = methodById(id)
    if (!m || sent.has(id)) return
    sent.add(id)
    if (m.kind === 'real') realSent++
    grid.querySelector(`[data-id="${id}"]`)?.classList.add('is-sent')
    // Which ways, never the message: only whether one was written at all.
    if (sent.size === 1) { shell.pick('First way tried', m.title); shell.pick('Wrote own message', msgInput.value.trim() !== '') }
    shell.pick('Way shared', m.title)
    shell.progress(sent.size)
    paintStrip()
    if (ended || sent.size < METHODS.length) return
    ended = true
    recordPlay('share-this-page', { ways: sent.size }, { ways: 'high' })
    shell.win({
      celebrate: false,
      // The card waits under the tiles; the desk keeps what was just sent.
      scroll: false,
      kicker: `All ${METHODS.length} ways`,
      title: 'Sent every way there is.',
      score: `${METHODS.length} / ${METHODS.length}`,
      lines: [
        `${REAL} of them for real and ${METHODS.length - REAL} of them not. Every one of them said “${message()}”`,
        'Nobody has replied yet.',
      ],
      againLabel: 'Send another',
    })
  }
  const paintLength = () => shell.setMoves(String(message().length))
  msgInput.addEventListener('input', paintLength)
  paintLength()

  // A live "signal strength" readout under the input — the bar heights are
  // the real character codes of whatever is typed.
  function updateSignal() {
    const text = msgInput.value || ' '
    signal.innerHTML = ''
    text.split('').slice(0, 48).forEach((c) => {
      const bar = document.createElement('i')
      bar.style.height = `${3 + (c.charCodeAt(0) % 17)}px`
      signal.append(bar)
    })
  }
  msgInput.addEventListener('input', updateSignal)
  updateSignal()

  /* ---- the desk ------------------------------------------------------------ */
  let desk: Desk | null = null
  const pending: DeskView[] = []
  const show = (v: DeskView) => { if (desk) desk.show(v); else pending.splice(0, 1, v) }

  /* ---- sound: its own bus, so switching ways silences what was queued ---- */
  let bus: GainNode | null = null
  function freshBus() {
    const o = audioOut()
    if (bus) { try { bus.disconnect() } catch { /* already gone */ } }
    bus = null
    if (!o) return null
    bus = o.ctx.createGain()
    bus.connect(o.out)
    return { ctx: o.ctx, bus }
  }
  type Bus = NonNullable<ReturnType<typeof freshBus>>
  function beep(b: Bus | null, freq: number, at: number, dur: number, gain: number, type: OscillatorType = 'sine') {
    if (!b) return
    const t = b.ctx.currentTime + at
    const g = b.ctx.createGain()
    g.gain.setValueAtTime(0.0001, t)
    g.gain.exponentialRampToValueAtTime(gain, t + Math.min(0.008, dur * 0.2))
    g.gain.setValueAtTime(gain, t + Math.max(0.01, dur - 0.012))
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur)
    g.connect(b.bus)
    const o = b.ctx.createOscillator()
    o.type = type
    o.frequency.value = freq
    o.connect(g)
    o.start(t)
    o.stop(t + dur + 0.02)
  }
  /** A spoon on a steel pipe: two inharmonic partials, rung and gone. */
  function ping(b: Bus | null, at: number) {
    if (!b) return
    for (const [f, gain, decay] of [[2380, 0.16, 0.35], [3910, 0.08, 0.18], [6020, 0.03, 0.08]] as const) {
      const t = b.ctx.currentTime + at
      const g = b.ctx.createGain()
      g.gain.setValueAtTime(gain, t)
      g.gain.exponentialRampToValueAtTime(0.0001, t + decay)
      g.connect(b.bus)
      const o = b.ctx.createOscillator()
      o.frequency.value = f
      o.connect(g)
      o.start(t)
      o.stop(t + decay + 0.02)
    }
  }

  let timers: number[] = []
  function stop() {
    for (const t of timers) clearTimeout(t)
    timers = []
    freshBus()
    desk?.release()
    if ('speechSynthesis' in window) speechSynthesis.cancel()
    out.querySelectorAll('.is-lit').forEach((e) => e.classList.remove('is-lit'))
  }
  const later = (s: number, fn: () => void) => timers.push(window.setTimeout(fn, s * 1000))

  /* ---- players: the sound and the desk on one schedule ---- */
  function playMorse() {
    const b = freshBus()
    const marks = Array.from(out.querySelectorAll<HTMLElement>('.stp-morse-mark'))
    let t = 0.15, mi = 0
    for (const beat of morseBeats(message())) {
      const dur = beat.units * MORSE_UNIT
      if (beat.on) {
        beep(b, 660, t, dur * 0.96, 0.2)
        desk?.press('key', t, dur * 0.96)
        const mark = marks[mi++]
        if (mark) later(t, () => mark.classList.add('is-lit'))
      }
      t += dur
    }
    return t
  }

  function playTapCode() {
    const b = freshBus()
    const taps = tapCode(message())
    desk?.ring(taps, 0)
    let t = 0.2
    taps.forEach((tap, i) => {
      for (let k = 0; k < tap.row; k++) { ping(b, t); desk?.press('spoon', t - 0.05, 0.07); t += 0.16 }
      t += 0.3
      for (let k = 0; k < tap.col; k++) { ping(b, t); desk?.press('spoon', t - 0.05, 0.07); t += 0.16 }
      later(t, () => desk?.ring(taps, i + 1))
      t += 0.55
    })
    return t
  }

  function playDtmf() {
    const b = freshBus()
    let t = 0.15
    for (const { digit, freqs } of dtmfTones(message())) {
      beep(b, freqs[0], t, 0.16, 0.12)
      beep(b, freqs[1], t, 0.16, 0.12)
      desk?.press('pad:' + digit, t, 0.16)
      t += 0.22
    }
    return t
  }

  function playNotes() {
    const b = freshBus()
    let t = 0.15
    for (const n of textNotes(message())) {
      beep(b, n.freq, t, 0.3, 0.16, 'triangle')
      beep(b, n.freq * 2, t, 0.18, 0.03, 'sine')
      desk?.press(`piano:${n.name}4`, t, 0.2)
      t += 0.2
    }
    return t
  }

  function playVoice() {
    if (!('speechSynthesis' in window)) return 0
    const u = new SpeechSynthesisUtterance(message())
    speechSynthesis.cancel()
    speechSynthesis.speak(u)
    return 0
  }

  const PLAYERS: Record<string, [string, () => number]> = {
    morse: ['Key it again', playMorse],
    'tap-code': ['Knock it again', playTapCode],
    dtmf: ['Dial it again', playDtmf],
    notes: ['Play it again', playNotes],
    voice: ['Say it again', playVoice],
  }
  function play(id: string) {
    const p = PLAYERS[id]
    if (!p) return
    stop()
    unlock()
    p[1]()
  }

  /* ---- the text under the desk ---- */
  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const e = document.createElement(tag)
    if (cls) e.className = cls
    if (text != null) e.textContent = text
    return e
  }
  const mono = (text: string) => el('p', 'stp-mono', text)
  let copyText = ''

  /** A way the message was typed out: the sheet, and the same words to copy. */
  function typed(title: string, text: string, cls = 'stp-mono') {
    out.append(el('p', cls, text))
    copyText = text
    return { kind: 'sheet', heading: title, text } as DeskView
  }

  function renderReal(id: string): DeskView {
    const msg = message()
    const title = methodById(id)!.title
    switch (id) {
      case 'morse': {
        const text = morseText(msg)
        out.append(mono(text))
        const row = el('div', 'stp-morse-row')
        text.replace(/\s+/g, ' ').split('').forEach((ch) => {
          if (ch === '.' || ch === '-') row.append(el('span', `stp-morse-mark stp-morse-${ch === '.' ? 'dot' : 'dash'}`))
        })
        out.append(row)
        copyText = text
        return { kind: 'key' }
      }
      case 'braille': {
        const text = brailleText(msg)
        out.append(el('p', 'stp-braille-text', text))
        copyText = text
        return { kind: 'braille', cells: brailleCells(msg) }
      }
      case 'tap-code': {
        const taps = tapCode(msg)
        out.append(mono(taps.map((t) => `${t.row}-${t.col}`).join('  ')))
        copyText = ''
        return { kind: 'pipe' }
      }
      case 'nato': return typed(title, natoWords(msg).join(' '))
      case 'binary': {
        const text = binaryText(msg)
        out.append(mono(text))
        copyText = text
        return { kind: 'tape', bytes: text.split(' ').map((b) => parseInt(b, 2) & 0xff) }
      }
      case 'hex': return typed(title, hexText(msg))
      case 'base64': return typed(title, base64Text(msg))
      case 'rot13': {
        const v = typed(title, rot13(msg))
        out.append(el('p', 'stp-note', 'Run it through ROT13 again and you get your message back.'))
        return v
      }
      case 'atbash': return typed(title, atbash(msg))
      case 'leet': return typed(title, leet(msg), 'stp-leet')
      case 'pig-latin': return typed(title, pigLatin(msg))
      case 'reverse': return typed(title, reverseText(msg))
      case 'upside-down': return typed(title, upsideDown(msg), 'stp-flip')
      case 'dtmf': {
        out.append(mono(keypadDigits(msg)))
        copyText = keypadDigits(msg)
        return { kind: 'keypad' }
      }
      case 'notes': {
        const row = el('div', 'stp-notes')
        textNotes(msg).forEach((n) => row.append(el('span', 'stp-note-chip', n.name)))
        out.append(row)
        copyText = ''
        return { kind: 'piano' }
      }
      case 'voice': {
        const supported = 'speechSynthesis' in window
        out.append(el('p', 'stp-note', supported ? `“${msg}”` : 'Your browser does not support text-to-speech.'))
        copyText = ''
        return { kind: 'sheet', heading: 'Read aloud', text: msg }
      }
      case 'interstellar': {
        const g = interstellarGrid(msg)
        out.append(el('p', 'stp-note', `${g.rows} × ${g.cols} bits, radioed outward at the speed of light.`))
        copyText = ''
        return { kind: 'printout', rows: g.rows, cols: g.cols, bits: g.bits, caption: `${g.rows} x ${g.cols} bits, 7-bit ASCII, laid out the way Arecibo was in 1974` }
      }
    }
    return { kind: 'sheet', heading: title, text: msg }
  }

  /** Where each joke's postcard is addressed. */
  const ADDRESS: Record<string, string[]> = {
    god: ['Heaven', 'Up a bit, then left'],
    satan: ['The Underworld', 'Lower ground floor'],
    'the-dead': ['c/o The Other Side', 'Please forward'],
    santa: ['North Pole', 'Canada  H0H 0H0'],
    nsa: ['Fort Meade', 'Maryland, USA'],
    telemarketers: ['All of them', 'At dinnertime'],
    'a-billionaire': ['The penthouse', 'Wherever it is today'],
    whales: ['The open ocean', 'About two hundred metres down'],
    'the-future': ['Not to be opened', 'until later'],
    'no-one': ['', ''],
  }

  let currentId = ''
  function open(id: string, fromTile = true) {
    const m = methodById(id)
    if (!m) return
    stop()
    currentId = id
    out.innerHTML = ''
    copyText = ''
    deskTitle.textContent = m.title
    deskBlurb.textContent = m.blurb
    deskKind.textContent = m.kind === 'real' ? 'Real' : 'Joke'
    deskEl.dataset.kind = m.kind
    let view: DeskView
    if (m.kind === 'real') view = renderReal(id)
    else {
      out.append(el('p', 'stp-joke-sent', `“${message()}”, sent.`))
      view = { kind: 'postcard', to: m.title, address: ADDRESS[id] ?? ['', ''], message: message(), seed: [...id].reduce((h, c) => h * 31 + c.charCodeAt(0), 7) >>> 0 }
    }
    show(view)
    const player = PLAYERS[id]
    playBtn.hidden = !player || (id === 'voice' && !('speechSynthesis' in window))
    if (player) playLabel.textContent = player[0]
    copyBtn.hidden = !copyText
    grid.querySelectorAll('.stp-tile').forEach((t) => t.classList.toggle('is-open', (t as HTMLElement).dataset.id === id))
    if (fromTile) {
      sfx.click()
      noteSent(id)
      // Sending it is playing it: a way with a sound goes out as it opens.
      if (player) play(id)
      // On a narrow screen the desk is pinned above the tiles; on a wide one it is beside them.
      const r = deskEl.getBoundingClientRect()
      if (r.bottom < 80 || r.top > innerHeight - 120) deskEl.scrollIntoView({ block: 'start', behavior: PLAY ? 'smooth' : 'auto' })
    }
  }

  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text)
      once('Way copied')
      const was = copyBtn.textContent
      copyBtn.textContent = 'Copied'
      sfx.good()
      setTimeout(() => (copyBtn.textContent = was), 1200)
    } catch {
      /* clipboard blocked — nothing useful to say */
    }
  }

  // Once per way a visit, however often it is replayed or recopied.
  const done = new Set<string>()
  function once(what: string) {
    const m = methodById(currentId)
    if (m && !ended && !done.has(what + currentId)) { done.add(what + currentId); shell.pick(what, m.title) }
  }
  playBtn.addEventListener('click', () => { once('Way played aloud'); play(currentId) })
  copyBtn.addEventListener('click', () => copy(copyText))

  grid.querySelectorAll<HTMLButtonElement>('.stp-tile').forEach((btn) => {
    btn.addEventListener('click', () => { unlock(); open(btn.dataset.id!) })
  })
  // The plates are brushed metal: the light on them follows the pointer.
  if (matchMedia('(hover: hover)').matches) {
    grid.addEventListener('pointermove', (e) => {
      const t = (e.target as Element).closest<HTMLElement>('.stp-mat-real')
      if (!t) return
      const r = t.getBoundingClientRect()
      t.style.setProperty('--mx', `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`)
      t.style.setProperty('--my', `${(((e.clientY - r.top) / r.height) * 100 - 30).toFixed(1)}%`)
    })
    grid.addEventListener('pointerout', (e) => {
      const t = (e.target as Element).closest<HTMLElement>('.stp-mat-real')
      if (t && !t.contains(e.relatedTarget as Node)) { t.style.removeProperty('--mx'); t.style.removeProperty('--my') }
    })
  }

  // A new message re-sends whatever is open, once the typing settles.
  let retype = 0
  msgInput.addEventListener('input', () => {
    clearTimeout(retype)
    retype = window.setTimeout(() => {
      if (currentId) open(currentId, false)
      else show({ kind: 'sheet', heading: 'Your message', text: message() })
    }, 350)
  })

  show({ kind: 'sheet', heading: 'Your message', text: message() })
  import('../lib/share-desk')
    .then(({ createDesk }) => {
      desk = createDesk($<HTMLCanvasElement>('deskCanvas'), { still: !PLAY })
      if (!desk) { deskEl.classList.add('no-gl'); return }
      const v = pending.pop()
      if (v) desk.show(v)
    })
    .catch(() => deskEl.classList.add('no-gl'))
</script>

<style>
  /* The receiving room fills the stage edge to edge. overflow: clip rather
