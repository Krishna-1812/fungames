  .stp-tile:not(.stp-tile-big) .stp-screw-1, .stp-tile:not(.stp-tile-big) .stp-screw-2 { display: none; }
  /* The indicator lamp: dark glass until this way has been sent. */
  .stp-lamp {
    position: absolute; top: 7px; right: 7px; width: 7px; height: 7px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #5d6878, #1c222b 70%);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.6), 0 1px 0 1px rgb(255 255 255 / 0.06);
    transition: background 300ms var(--ease), box-shadow 300ms var(--ease);
