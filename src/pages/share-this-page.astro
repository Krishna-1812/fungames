  /* ---- the room: the desk beside the tiles, or pinned above them ------- */
  .stp-room {
    position: relative; z-index: 1;
    max-width: 1240px; margin: 30px auto 0; padding: 0 20px 48px;
    display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(290px, 1fr); gap: 22px; align-items: start;
  }
  .stp-desk { position: sticky; top: 12px; z-index: 2; }
  .stp-view {
    position: relative; overflow: hidden; border-radius: 18px;
