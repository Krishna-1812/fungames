---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * Powder - a falling-sand sandbox.
 *
 * A cellular automaton over typed arrays, rendered straight into an ImageData
 * buffer. Nothing here is scripted: oil floats on water because it is lighter,
 * fire makes steam because it met water, and glass appears because sand met
 * lava. All of the interesting behaviour is emergent from about forty local
 * rules, which is why it stays interesting after the novelty wears off.
 */
---

<GameLayout slug="powder" bar="#12100f" fixed bodyClass="powder-body">
  <div class="stage">
    <h1 class="visually-hidden">Powder</h1>

    <div class="canvas-wrap" id="wrap">
      <div id="worldSurface" class="world-surface"><canvas id="sim" aria-label="Falling sand simulation"></canvas></div>
      <div class="hint" id="hint">Draw with the mouse. Try dropping lava on ice.</div>

      <div class="scbar" id="scBar" hidden>
        <div class="scbar-main">
          <b id="scName"></b>
          <span id="scBrief"></span>
        </div>
        <p class="scbar-live"><span id="scProgress"></span> <b id="scPaint"></b></p>
        <div class="scbar-acts">
          <button type="button" id="scRetry">Restart</button>
          <button type="button" id="scExit">Leave</button>
        </div>
      </div>
    </div>

    <aside class="panel">
      <div class="palette" id="palette" role="radiogroup" aria-label="Material"></div>
      <div class="controls">
        <label class="brush">
          <span>Brush</span>
          <input id="brush" type="range" min="1" max="18" value="5" aria-label="Brush size" />
          <b id="brushVal">5</b>
        </label>
        <div class="btns">
          <button type="button" id="pauseBtn" class="ctl">Pause</button>
          <button type="button" id="clearBtn" class="ctl">Clear</button>
        </div>
        <div class="btns">
          <button type="button" id="rainBtn" class="ctl">Rain</button>
          <button type="button" id="quakeBtn" class="ctl">Meteor</button>
        </div>
        <div class="btns">
          <button type="button" id="saveExperiment" class="ctl">Save experiment</button>
          <button type="button" id="loadExperiment" class="ctl">Load experiment</button>
        </div>
        <p class="stat"><b id="count">0</b> particles &middot; <b id="fps">0</b> fps</p>
      </div>

      {/* The reason to keep going. A sandbox with nothing to find is a toy you
          put down after thirty seconds. */}
      <button type="button" class="found" id="foundBtn" aria-expanded="false" aria-controls="logPanel">
        <span><b id="foundN">0</b> of <b id="foundOf">0</b> reactions found</span>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      {/* Somewhere to point the sandbox. Eight set problems, each with the
          palette cut down to what the problem actually needs. */}
      <button type="button" class="found scenarios" id="scBtn" aria-expanded="false" aria-controls="scPanel">
        <span><b id="scCount">0/0</b> scenarios solved</span>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </aside>

    <div class="logwrap" id="scPanel" hidden>
      <div class="loghead">
        <h2>Scenarios</h2>
        <button type="button" id="scClose" aria-label="Close the scenario list">Close</button>
      </div>
      <ul class="log sclist" id="scList"></ul>
      <p class="lognote">
        Each one hands you a grid and takes away most of the palette. Solved
        ones keep their explanation. Saved in this browser only.
      </p>
    </div>

    <div class="logwrap" id="logPanel" hidden>
      <div class="loghead">
        <h2>Reactions</h2>
        <button type="button" id="logClose" aria-label="Close the reaction log">Close</button>
      </div>
      <ol class="log" id="logList"></ol>
      <p class="lognote">
        Found ones show what they make. The rest are yours to stumble into.
        Saved in this browser only.
      </p>
    </div>

    {/* Announcements land here so a discovery is not silent for screen readers. */}
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </div>
</GameLayout>

<script>
  import { sfx, unlock } from '../lib/audio'
  import { burst, ring, shake } from '../lib/fx'
  import { createPowderRenderer } from '../lib/powder-render'
  import { POWDER_SAVE, captureExperiment, readExperiment, restoreExperiment } from '../lib/powder-scene'
  import {
    MATERIALS, REACTIONS, buildLookup, describe,
    SAND, WATER, STONE, WOOD, GLASS, ICE, LAVA,
  } from '../lib/powder-rules'
  import {
    type World, createWorld, clearWorld, step, put, census, countAlive,
    PAL, VARY, LIFE0,
  } from '../lib/powder-sim'
  import {
    SCENARIOS, type Scenario, type Stats,
    begin, tickStats, foldCensus, paintCell, budgetLeft,
  } from '../lib/powder-goals'

  /* Materials and reactions live in lib/powder-rules.ts, and the automaton
     itself in lib/powder-sim.ts. Both used to be inline here, which worked but
     meant nothing could be counted or run without a browser — the reaction log
     below needed the first move and the scenarios needed the second. */
  const DRAWABLE = MATERIALS.filter((m) => m.draw)
  const RX = buildLookup()

  const canvas = document.getElementById('sim') as HTMLCanvasElement
  const wrap = document.getElementById('wrap') as HTMLElement
  const surface = document.getElementById('worldSurface') as HTMLElement
  const CELL = 4
  let W = 0, H = 0
  let world: World = createWorld(1, 1)

  /* The simulation is untouched. This only decides how the grid is painted: a
     shaded, lit world on the GPU, or the original flat ImageData if WebGL2 is
     missing. */
  const renderer = createPowderRenderer(canvas, PAL, VARY, LIFE0)
  if (renderer.gpu) canvas.classList.add('gl')

  function build() {
    const r = wrap.getBoundingClientRect()
    if (r.width < 8 || r.height < 8) return false
    if (!W) {
      W = Math.max(80, Math.min(340, Math.floor(r.width / CELL)))
      H = Math.max(60, Math.min(250, Math.floor(r.height / CELL)))
      world = createWorld(W, H)
    }
    const scale = Math.min(r.width / W, r.height / H)
    surface.style.width = `${W * scale}px`; surface.style.height = `${H * scale}px`
    surface.style.left = `${(r.width - W * scale) / 2}px`; surface.style.top = `${(r.height - H * scale) / 2}px`
    renderer.resize(W, H)
    return true
  }

  /* --------------------------------------------------------------------
     Discovery.

     Every pairwise reaction is a thing to find, so the first time one fires it
     is recorded and announced. Saved under the reaction's own id rather than
     its index, so reordering the table never scrambles anybody's log.
     -------------------------------------------------------------------- */

  const SAVE = 'powder.found.v1'
  const found = new Set<string>()
  try {
    const raw = localStorage.getItem(SAVE)
    if (raw) for (const id of JSON.parse(raw)) found.add(id)
  } catch { /* private mode, or a cleared profile. Start fresh. */ }

  function discover(id: string) {
    if (found.has(id)) return
    const r = REACTIONS.find((x) => x.id === id)
    if (!r) return
    found.add(id)
    try { localStorage.setItem(SAVE, JSON.stringify([...found])) } catch { /* not worth breaking the sim over */ }
    announce(r)
  }

  /* --------------------------------------------------------------------
     Scenarios.
     -------------------------------------------------------------------- */

  const SC_SAVE = 'powder.scenarios.v1'
  const beaten = new Set<string>()
  try {
    const raw = localStorage.getItem(SC_SAVE)
    if (raw) for (const id of JSON.parse(raw)) beaten.add(id)
  } catch { /* fine */ }

  let active: Scenario | null = null
  let stats: Stats | null = null
  let solved = false
  const censusBuf = new Uint32Array(48)

  const scBtn = document.getElementById('scBtn') as HTMLButtonElement
  const scPanel = document.getElementById('scPanel') as HTMLElement
  const scList = document.getElementById('scList')!
  const scCount = document.getElementById('scCount')!
  const bar = document.getElementById('scBar') as HTMLElement
  const barName = document.getElementById('scName')!
  const barBrief = document.getElementById('scBrief')!
  const barProgress = document.getElementById('scProgress')!
  const barPaint = document.getElementById('scPaint')!

  function saveScenarios() {
    try { localStorage.setItem(SC_SAVE, JSON.stringify([...beaten])) } catch { /* fine */ }
  }

  function paintScenarioList() {
    scCount.textContent = `${beaten.size}/${SCENARIOS.length}`
    scList.innerHTML = SCENARIOS.map((s) => {
      const got = beaten.has(s.id)
      return `<li class="sc ${got ? 'got' : ''}" data-sc="${s.id}">
        <button type="button" data-sc="${s.id}">
          <b>${s.name}<span class="visually-hidden">${got ? ', done' : ', not yet done'}</span></b>
          <span class="scbrief">${s.brief}</span>
          ${got ? `<span class="scnote">${s.note}</span>` : ''}
        </button>
      </li>`
    }).join('')
  }

  /** Narrow the palette to what this scenario hands you, or open it all up. */
  function paintPalette() {
    const allowed = active ? new Set(active.palette) : null
    let firstAllowed = -1
    palette.querySelectorAll<HTMLElement>('.mat').forEach((m) => {
      const id = Number(m.dataset.id)
      const ok = !allowed || allowed.has(id)
      m.hidden = !ok
      if (ok && firstAllowed < 0) firstAllowed = id
    })
    if (allowed && !allowed.has(current) && firstAllowed >= 0) pick(firstAllowed)
  }

  function loadScenario(sc: Scenario) {
    if (!W && !build()) return
    clearWorld(world)
    active = sc
    stats = begin(world, sc)
    solved = false
    raining = false
    document.getElementById('rainBtn')!.classList.remove('on')
    bar.hidden = false
    barName.textContent = sc.name
    barBrief.textContent = sc.brief
    paintPalette()
    // A narrow brush, because these are measured out. One full-width drag at
    // the sandbox default costs about two and a half thousand cells, which is
    // more than most of these scenarios hand you in total — so the default
    // there would spend the whole budget before you had finished the stroke.
    setBrush(3)
    surface.classList.toggle('masked', sc.drawTo !== undefined)
    if (sc.drawTo !== undefined) {
      surface.style.setProperty('--reach', `${sc.drawTo * 100}%`)
    }
    scPanel.hidden = true
    scBtn.setAttribute('aria-expanded', 'false')
    census(world, censusBuf)
    updatePaint()
    updateProgress()
    unlock(); sfx.click()
  }

  function endScenario() {
    active = null
    stats = null
    solved = false
    bar.hidden = true
    surface.classList.remove('masked')
    paintPalette()
    clearWorld(world)
    seed()
  }

  /*
   * Split in two on purpose. The paint counter changes on every cell you draw
   * and costs nothing to redraw; the progress line needs a census, which is
   * twenty thousand reads. Drawing one drag calls the first forty times.
   *
   * Keeping them together also showed the line before any census had run, so
   * a freshly loaded scenario announced "0 plants left" — which reads as
   * solved. The census in `loadScenario` is there for the same reason.
   */
  function updatePaint() {
    if (!active || !stats) return
    const left = budgetLeft(active, stats)
    barPaint.textContent = `${left} paint left`
    barPaint.classList.toggle('out', left === 0)
  }

  function updateProgress() {
    if (!active || !stats || solved) return
    barProgress.textContent = active.progress(censusBuf, stats, world)
  }

  function scenarioSolved() {
    if (!active || solved) return
    solved = true
    const wasNew = !beaten.has(active.id)
    beaten.add(active.id)
    saveScenarios()
    paintScenarioList()
    scCount.textContent = `${beaten.size}/${SCENARIOS.length}`
    barProgress.textContent = 'Solved. ' + active.note
    bar.classList.add('won')
    setTimeout(() => bar.classList.remove('won'), 2400)
    sfx.great()
    const r = canvas.getBoundingClientRect()
    burst(r.left + r.width / 2, r.top + r.height / 2, {
      count: 30, colors: ['#7fd6a0', '#d6f2e0', '#fff'], speed: 5, gravity: 0.1, size: 3,
    })
    if (wasNew) toastText('Solved — ' + active.name)
  }

  scBtn.addEventListener('click', () => {
    const open = scPanel.hidden
    scPanel.hidden = !open
    scBtn.setAttribute('aria-expanded', String(open))
    if (open) { paintScenarioList(); logPanel.hidden = true }
    unlock(); sfx.click()
  })
  document.getElementById('scClose')!.addEventListener('click', () => {
    scPanel.hidden = true
    scBtn.setAttribute('aria-expanded', 'false')
    scBtn.focus()
  })
  scList.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-sc]') as HTMLElement | null
    if (!b) return
    const sc = SCENARIOS.find((s) => s.id === b.dataset.sc)
    if (sc) loadScenario(sc)
  })
  document.getElementById('scRetry')!.addEventListener('click', () => {
    if (active) loadScenario(active)
  })
  document.getElementById('scExit')!.addEventListener('click', () => {
    unlock(); sfx.click(); endScenario()
  })

  /* --------------------------------------------------------------------
     The loop.
     -------------------------------------------------------------------- */

  let paused = false
  let raining = false
  let lastFps = performance.now()
  let fpsFrames = 0
  const countEl = document.getElementById('count')!
  const fpsEl = document.getElementById('fps')!

  function tick() {
    if (!paused && W) {
      if (raining) for (let n = 0; n < 3; n++) put(world, (Math.random() * W) | 0, 0, WATER)
      step(world, RX)
      for (const id of world.justFired) discover(id)
      if (world.bangs > 0) {
        // One sound per frame no matter how many cells detonated at once.
        sfx.boom()
        shake(document.body, Math.min(14, 4 + world.bangs), 320)
        const r = canvas.getBoundingClientRect()
        burst(r.left + r.width / 2, r.top + r.height / 2, {
          count: 18, colors: ['#ff9a3c', '#ffd166'], speed: 6, gravity: 0.25, shape: 'streak', size: 3,
        })
      }
      if (active && stats) {
        tickStats(world, stats)
        // The census is the expensive part, so it runs a few times a second
        // rather than every frame. `tickStats` above is the cheap half and has
        // to be every frame, because `justFired` is emptied by the next step.
        if (world.frame % 6 === 0) {
          census(world, censusBuf)
          foldCensus(stats, censusBuf)
          if (!solved && active.done(censusBuf, stats, world)) scenarioSolved()
          updateProgress()
        }
      }
    }
    if (W) {
      renderer.draw(world.grid, world.life, world.shade, performance.now() / 1000)
      fpsFrames++
      const now = performance.now()
      if (now - lastFps > 500) {
        fpsEl.textContent = String(Math.round((fpsFrames * 1000) / (now - lastFps)))
        countEl.textContent = countAlive(world).toLocaleString('en-US')
        lastFps = now
        fpsFrames = 0
      }
    }
    requestAnimationFrame(tick)
  }

  let current = SAND
  let brush = 5
  let drawing = false
  let lastCell: { x: number; y: number } | null = null
  const hintEl = document.getElementById('hint')!

  const palette = document.getElementById('palette')!
  let hintTimer = 0

  function pick(id: number) {
    const d = MATERIALS.find((m) => m.id === id)
    if (!d) return
    current = id
    palette.querySelectorAll('.mat').forEach((m) =>
      m.setAttribute('aria-checked', String(Number((m as HTMLElement).dataset.id) === current)))
    hintEl.textContent = d.hint || ('Drawing ' + d.name.toLowerCase())
    hintEl.classList.remove('faded')
    clearTimeout(hintTimer)
    hintTimer = window.setTimeout(() => hintEl.classList.add('faded'), 2600)
  }

  DRAWABLE.forEach((d, n) => {
    const b = document.createElement('button')
    b.type = 'button'
    b.className = 'mat'
    b.dataset.id = String(d.id)
    b.setAttribute('role', 'radio')
    b.setAttribute('aria-checked', String(d.id === current))
    b.title = d.hint || d.name
    const sw = document.createElement('i')
    sw.style.background = 'rgb(' + d.rgb.join(',') + ')'
    const label = document.createElement('span')
    label.textContent = d.name
    b.append(sw, label)
    b.addEventListener('click', () => {
      unlock(); sfx.blip(n)
      pick(d.id)
      b.classList.remove('picked')
      void b.offsetWidth // restart the animation even if it's already mid-way
      b.classList.add('picked')
    })
    palette.appendChild(b)
  })

  /* ----------------------------------------------------------------------
     The log.
     ---------------------------------------------------------------------- */

  const foundBtn = document.getElementById('foundBtn')!
  const logPanel = document.getElementById('logPanel')!
  const logList = document.getElementById('logList')!
  const toast = document.getElementById('toast')!
  document.getElementById('foundOf')!.textContent = String(REACTIONS.length)

  function paintCount() {
    document.getElementById('foundN')!.textContent = String(found.size)
    foundBtn.classList.toggle('complete', found.size === REACTIONS.length)
  }

  function paintLog() {
    logList.innerHTML = REACTIONS.map((r) => {
      const got = found.has(r.id)
      return `<li class="${got ? 'got' : 'locked'}">
        <b>${got ? describe(r) : '? ? ?'}</b>
        <span>${got ? r.note : 'Not found yet'}</span>
      </li>`
    }).join('')
  }

  let toastTimer = 0
  function toastText(text: string) {
    toast.textContent = text
    toast.classList.add('show')
    clearTimeout(toastTimer)
    toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3200)
  }

  function announce(r: (typeof REACTIONS)[number]) {
    paintCount()
    if (!logPanel.hidden) paintLog()
    sfx.sparkle()
    toastText('New reaction — ' + describe(r))
  }

  foundBtn.addEventListener('click', () => {
    const open = logPanel.hidden
    logPanel.hidden = !open
    foundBtn.setAttribute('aria-expanded', String(open))
    if (open) { paintLog(); scPanel.hidden = true; scBtn.setAttribute('aria-expanded', 'false') }
    unlock(); sfx.click()
  })
  document.getElementById('logClose')!.addEventListener('click', () => {
    logPanel.hidden = true
    foundBtn.setAttribute('aria-expanded', 'false')
    foundBtn.focus()
  })
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return
    if (!logPanel.hidden) {
      logPanel.hidden = true
      foundBtn.setAttribute('aria-expanded', 'false')
    } else if (!scPanel.hidden) {
      scPanel.hidden = true
      scBtn.setAttribute('aria-expanded', 'false')
    }
  })
  paintCount()
  paintScenarioList()

  function setBrush(n: number) {
    brush = n
    brushInput.value = String(n)
    document.getElementById('brushVal')!.textContent = String(n)
  }

  function cellAt(e: PointerEvent) {
    const r = canvas.getBoundingClientRect()
    return {
      x: Math.floor(((e.clientX - r.left) / r.width) * W),
      y: Math.floor(((e.clientY - r.top) / r.height) * H),
    }
  }

  function paint(cx: number, cy: number) {
    const r = brush
    const solid = current === STONE || current === WOOD || current === GLASS || current === ICE
    for (let dy = -r; dy <= r; dy++) {
      for (let dx = -r; dx <= r; dx++) {
        if (dx * dx + dy * dy > r * r) continue
        // Grains are sparse so pouring looks like pouring, not like stamping.
        if (!solid && Math.random() < 0.3) continue
        paintCell(world, stats, active, cx + dx, cy + dy, current)
      }
    }
    if (active && stats) updatePaint()
  }

  canvas.addEventListener('pointerdown', (e) => {
    unlock()
    drawing = true
    try { canvas.setPointerCapture(e.pointerId) } catch {}
    const c = cellAt(e)
    lastCell = c
    paint(c.x, c.y)
    hintEl.classList.add('faded')
    e.preventDefault()
  })
  canvas.addEventListener('pointermove', (e) => {
    if (!drawing) return
    const c = cellAt(e)
    if (lastCell) {
      // Interpolate, or a fast drag leaves a dotted line.
      const steps = Math.max(Math.abs(c.x - lastCell.x), Math.abs(c.y - lastCell.y))
      for (let s = 0; s <= steps; s++) {
        const t = steps ? s / steps : 0
        paint(Math.round(lastCell.x + (c.x - lastCell.x) * t), Math.round(lastCell.y + (c.y - lastCell.y) * t))
      }
    }
    lastCell = c
  })
  const stop = () => { drawing = false; lastCell = null }
  canvas.addEventListener('pointerup', stop)
  canvas.addEventListener('pointercancel', stop)
  canvas.addEventListener('pointerleave', stop)

  const brushInput = document.getElementById('brush') as HTMLInputElement
  brushInput.addEventListener('input', () => setBrush(Number(brushInput.value)))

  document.getElementById('pauseBtn')!.addEventListener('click', (e) => {
    paused = !paused
    ;(e.currentTarget as HTMLButtonElement).textContent = paused ? 'Resume' : 'Pause'
    unlock(); sfx.click()
  })
  document.getElementById('clearBtn')!.addEventListener('click', () => {
    // Inside a scenario this is a restart, because clearing the grid would
    // throw away the thing you were given to work on.
    if (active) { loadScenario(active); return }
    clearWorld(world)
    unlock(); sfx.whoosh()
  })
  document.getElementById('rainBtn')!.addEventListener('click', (e) => {
    raining = !raining
    ;(e.currentTarget as HTMLButtonElement).classList.toggle('on', raining)
    unlock()
    if (raining) sfx.fizz(); else sfx.click()
  })
  document.getElementById('quakeBtn')!.addEventListener('click', () => {
    unlock(); sfx.boom(); shake(document.body, 12, 420)
    const cx = ((0.25 + Math.random() * 0.5) * W) | 0
    for (let i = 0; i < 26; i++) {
      const x = cx + (((Math.random() - 0.5) * 20) | 0)
      for (let y = 0; y < 8; y++) put(world, x, y, Math.random() < 0.6 ? LAVA : STONE)
    }
    const r = canvas.getBoundingClientRect()
    const px = r.left + (cx / W) * r.width
    burst(px, r.top + 20, { count: 40, colors: ['#ff9a3c', '#ffd166', '#e8501e'], speed: 7, gravity: 0.3, shape: 'streak', size: 3 })
    ring(px, r.top + 20, '#ffb347', 26)
  })

  function seed() {
    for (let x = 0; x < W; x++) {
      const h = 4 + Math.round(3 * Math.sin(x / 9))
      for (let y = H - h; y < H; y++) put(world, x, y, STONE)
    }
    for (let x = (W * 0.14) | 0; x < (W * 0.34) | 0; x++)
      for (let y = H - 22; y < H - 8; y++) put(world, x, y, WATER)
    for (let x = (W * 0.62) | 0; x < (W * 0.74) | 0; x++)
      for (let y = H - 26; y < H - 8; y++) put(world, x, y, SAND)
  }

  document.getElementById('saveExperiment')!.addEventListener('click', () => {
    if (active) { toastText('Leave the scenario to save a sandbox experiment.'); return }
    if (!W) return
    try {
      localStorage.setItem(POWDER_SAVE, JSON.stringify(captureExperiment(world)))
      toastText('Experiment saved on this device. Saving again replaces it.')
    } catch { toastText('This device could not save the experiment. Your world is still here.') }
  })
  document.getElementById('loadExperiment')!.addEventListener('click', () => {
    if (active) { toastText('Leave the scenario before loading an experiment.'); return }
    try {
      const raw = localStorage.getItem(POWDER_SAVE)
      if (!raw) { toastText('No saved experiment yet.'); return }
      const scene = raw.length <= 2000000 ? readExperiment(JSON.parse(raw)) : null
      if (!scene) { toastText('That save could not be read. Your world is unchanged.'); return }
      const restored = restoreExperiment(scene)
      stop(); world = restored; W = world.w; H = world.h
      paused = true; raining = false
      document.getElementById('pauseBtn')!.textContent = 'Resume'
      document.getElementById('rainBtn')!.classList.remove('on')
      build()
      toastText('Experiment loaded, paused. Future reactions may unfold differently.')
    } catch { toastText('The experiment could not be loaded.'); }
  })

  /** Resize the view only. Cells, scenario budgets and reaction history survive. */
  function rebuild() {
    stop()
    build()
  }

  // Lay out immediately where possible; rAF is paused in background tabs, so a
  // ResizeObserver covers the case where the element has no size yet.
  if (build()) seed()
  else if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(() => { if (build()) { seed(); ro.disconnect() } })
    ro.observe(wrap)
  }
  let resizeT = 0
  addEventListener('resize', () => {
    clearTimeout(resizeT)
    resizeT = window.setTimeout(rebuild, 200)
  })
  tick()
</script>

