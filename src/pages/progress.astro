  .progress-body .row:focus-visible { outline: 2px solid #c79bff; outline-offset: -2px; }
  /* Read: a small tick after the name, so the list says what is left to read. */
  .progress-body .row.read .r-name b::after { content: '✓'; font-size: 12px; color: #4fe3c1; margin-left: 6px; }

  .progress-body .r-i {
    grid-area: i;
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--mono); font-size: 12px; font-weight: 500;
    /* #7c6796 was quieter and measured 3.89:1. */
