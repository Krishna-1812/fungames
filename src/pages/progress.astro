---
import GameShell from '../layouts/GameShell.astro'
import { watchSvg } from '../lib/progress-watch'

const WATCH = watchSvg()

/**
 * Progress — every unit of time you are currently inside, draining live.
 *
 * All of it is computed from the visitor's own clock, so it is correct in any
 * timezone and needs no backend. The date arithmetic lives in
 * `lib/progress-time.ts` and is exercised by `scripts/check-progress.mjs`
 * across five timezones and a year of instants.
 *
 * The page is one object: a wall panel, a watch hung on it, and a data plate
 * under that. The watch (lib/progress-watch.ts) shows each span by the thing
 * that has always shown it: hands, a week dial, the Moon at its phase, the
 * Earth turning under the Sun, the year on drums. The register at the bottom
 * is the readout: everything the watch shows, in text, which is also what a
 * screen reader gets.
 *
 * In the shell the wall panel is the stage, a sticky backdrop inside the frame
 * rather than fixed to the window. Score is how much of the year is gone, Day
 * how much of today, Read how many channels you have looked at properly — a
 * tap, a click, keyboard focus, or the pointer resting on one for a moment,
 * not a sweep across the dial — and reading every one of them is the ending.
 * The clock does not stop for the pause button; nothing on this page would.
 */
---

<GameShell
  slug="progress"
  labels={{ score: 'Year gone', best: 'Most read', level: 'Read', moves: 'Day gone' }}
  initial={{ score: '—', level: '0', moves: '—' }}
  fonts={['IBM+Plex+Mono:wght@400;500;600']}
>
  <div class="progress-body">
  <div class="pg-panel" id="panel" aria-hidden="true"></div>

  <div class="pg-wrap">
    <header class="head">
      <p class="lede">
        Everything you are currently inside of, and how much of it is already gone.
      </p>
    </header>

    <div class="rig">
      <!-- Three layers: the watch up to its dials, the Earth (a canvas) set
           into the lower one, and the hands and crystal over both. -->
      <div class="watch" id="watch">
        <Fragment set:html={WATCH.base} />
        <div class="earth" id="earth" aria-hidden="true"></div>
        <Fragment set:html={WATCH.top} />
      </div>

      <div class="plate" aria-hidden="true">
        <p class="pl-name" id="plName">—</p>
        <p class="pl-pct" id="plPct">—</p>
        <p class="pl-left" id="plLeft">—</p>
        <p class="pl-clock" id="plClock">—</p>
      </div>

      <p class="hint" id="hint">Fifteen spans of time on one watch. Point at any part of it.</p>
    </div>

    <ol class="reg" id="reg"></ol>

    <p class="foot">Updates every frame. This does not help.</p>
  </div>
  </div>

  <Fragment slot="howto">
    <p>
      Every span of time you are inside right now — this second, this week,
      this year, this century, the Sun's life — and how much of each is
      already gone, worked out from your own clock.
    </p>
    <ul>
      <li>The watch shows every one of them: the hands, the day of the week, the Moon at tonight's phase, the Earth turning under the Sun, the date, the months, the year on rolling drums.</li>
      <li>Point at any part of the watch, or tap it, and the plate underneath reads it out.</li>
      <li>The list below says the same thing in words. Click a row and its part of the watch lights up.</li>
      <li>Nothing pauses. That is rather the point.</li>
    </ul>
    <p>Read every one to finish.</p>
  </Fragment>
</GameShell>

<script>
  import { ShaderSurface } from '../lib/gl'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { recordPlay } from '../lib/stats'

  const prefersReducedMotion = !PLAY
  // Restart is a reload, the default: there is nothing to reset but the list
  // of channels read.
  const shell = createShell({ slug: 'progress' })
  import { PANEL_FRAG } from '../lib/progress-panel'
  import { EARTH_DISC_FRAG } from '../lib/progress-earth'
  import { lumeCss } from '../lib/progress-lume'
  import { EARTH_BOX, handAngles, subsolar, drums, moonPath, bits, sunArc } from '../lib/progress-watch'
  import { liveUnits, MAX_UNITS, read } from '../lib/progress-time'

  const el = (id: string) => document.getElementById(id)!

  const watch = el('watch')
  const reg = el('reg')
  const plPct = el('plPct')
  const plName = el('plName')
  const plLeft = el('plLeft')
  const plClock = el('plClock')

  const now = new Date()
  // Not UNITS: the 32-bit row stops being something you are inside of in 2038.
  const RINGS = liveUnits(now)
  const N = RINGS.length

  /* ------------------------------------------------------------------------
     The register. Built once, then only text and widths are touched — a frame
     that changes nothing writes nothing.
     ------------------------------------------------------------------------ */

  type Row = {
    btn: HTMLButtonElement
    name: HTMLElement
    rule: HTMLElement
    pct: HTMLElement
    left: HTMLElement
    lastName: string
    lastPct: string
    lastLeft: string
    lastW: number
  }

  const rows: Row[] = RINGS.map((u, i) => {
    const li = document.createElement('li')
    const btn = document.createElement('button')
    btn.type = 'button'
    btn.className = 'row'
    btn.setAttribute('aria-pressed', 'false')
    btn.innerHTML =
      `<span class="r-i">${String(i + 1).padStart(2, '0')}</span>` +
      `<span class="r-name"><b></b></span>` +
      `<span class="r-rule"><i></i></span>` +
      `<span class="r-pct"></span><span class="r-left"></span>` +
      /* On its own full-width line rather than under the name. In the name's
         column a note wraps to two lines and makes its row half again as tall
         as the other twelve; across the row it is one line. */
      (u.note ? `<em class="r-note">${u.note}</em>` : '')
    li.append(btn)
    reg.append(li)

    /* A unit's rate never changes, so its colour is set once and never again.
       The rule and the ring it points at both come out of the same two
       constants — `lume()` in the shader, `lumeCss()` here — which is the only
       reason they are the same colour. */
    const rate = read(u, now).rate
    btn.style.setProperty('--lume', lumeCss(rate))
    btn.style.setProperty('--lume-dim', lumeCss(rate, 0.3))
    // Lifted, for type rather than for a rule. See the note by .row.lit .r-i.
    btn.style.setProperty('--lume-lit', lumeCss(rate, 2.5))

    return {
      btn,
      name: btn.querySelector('b')!,
      rule: btn.querySelector('.r-rule i') as HTMLElement,
      pct: btn.querySelector('.r-pct') as HTMLElement,
      left: btn.querySelector('.r-left') as HTMLElement,
      lastName: '', lastPct: '', lastLeft: '', lastW: -1,
    }
  })

  /* ------------------------------------------------------------------------
     Focus: which ring is lit, and what the aperture is reading.

     Two separate things. `focus` dims the rest of the watch and is -1 when
     nobody is pointing at anything; `shown` is what the plate reads and is
     never -1, because a blank plate on an instrument means it is broken.
     ------------------------------------------------------------------------ */

  const DEFAULT = Math.max(0, RINGS.findIndex((u) => u.id === 'year'))
  let hovered = -1
  let pinned = -1
  let focusMix = 0

  const focus = () => (pinned >= 0 ? pinned : hovered)

  /* ------------------------------------------------------------------------
     Reading. A channel counts once it has been looked at properly: pinned, or
     held in focus for a moment. Sweeping the pointer across the dial passes
     over all fifteen in half a second and reads none of them.
     ------------------------------------------------------------------------ */

  const DWELL_MS = 650
  const seen = new Set<number>()
  let dwellOn = -1
  let dwellFrom = 0
  let ended = false
  const YEAR = DEFAULT
  const DAY = Math.max(0, RINGS.findIndex((u) => u.id === 'day'))

  function markRead(i: number, how: 'Clicked' | 'Held in focus') {
    if (i < 0 || seen.has(i)) return
    seen.add(i)
    rows[i].btn.classList.add('read')
    if (seen.size === 1) { shell.pick('First channel read', RINGS[i].id); shell.pick('How the first was read', how) }
    shell.pick('Channel read', RINGS[i].id)
    shell.progress(seen.size)
    shell.setLevel(`${seen.size} / ${N}`)
    shell.considerBest(seen.size, `${seen.size} / ${N}`)
    if (seen.size === N && !ended) finish()
  }

  function finish() {
    ended = true
    const d = new Date()
    const year = read(RINGS[YEAR], d)
    const last = read(RINGS[N - 1], d)
    recordPlay('progress', { read: N }, { read: 'high' })
    shell.win({
      celebrate: false,
      // The card waits under the register; the dial stays where it is.
      scroll: false,
      kicker: 'Every channel, read',
      title: 'All of them are still going.',
      score: `${N} / ${N}`,
      lines: [
        `${year.pct} of ${d.getFullYear()} is gone, and it has gone up while you read this.`,
        `${last.name}: ${last.pct}.`,
      ],
      againLabel: 'Read them again',
    })
  }
  const shown = () => { const f = focus(); return f >= 0 ? f : DEFAULT }

  const parts = [...watch.querySelectorAll<SVGElement>('.wc')]
  function syncPressed() {
    const f = focus()
    for (let i = 0; i < rows.length; i++) {
      rows[i].btn.setAttribute('aria-pressed', String(i === pinned))
      rows[i].btn.classList.toggle('lit', i === f)
    }
    // The part of the watch that shows this span stays lit; the rest stands back.
    const id = f >= 0 ? RINGS[f].id : ''
    watch.classList.toggle('has-focus', f >= 0)
    watch.classList.toggle('day-focus', id === 'day')
    for (const el of parts) { el.classList.toggle('on', !!id && el.dataset.u!.split(' ').includes(id)); el.classList.remove('keep') }
    // A part inside another (the weekend, inside the week) must not be dimmed by its parent.
    for (const el of parts) if (el.classList.contains('on')) for (let a = el.parentElement?.closest('.wc'); a; a = a.parentElement?.closest('.wc')) a.classList.add('keep')
  }

  rows.forEach((row, i) => {
    row.btn.addEventListener('pointerenter', () => { hovered = i; syncPressed() })
    row.btn.addEventListener('pointerleave', () => { if (hovered === i) hovered = -1; syncPressed() })
    // Focus follows the keyboard as well, or the dial would be inert to it.
    row.btn.addEventListener('focus', () => { hovered = i; syncPressed() })
    row.btn.addEventListener('blur', () => { if (hovered === i) hovered = -1; syncPressed() })
    row.btn.addEventListener('click', () => { pinned = pinned === i ? -1 : i; syncPressed(); markRead(i, 'Clicked') })
  })

  /* ------------------------------------------------------------------------
     The instrument.
     ------------------------------------------------------------------------ */

  const fracs = new Float32Array(MAX_UNITS)
  const idx = new Map(RINGS.map((u, i) => [u.id, i]))
  const WEEK = idx.get('week') ?? -1
  const MOON = idx.get('lunation') ?? -1
  const SUN = idx.get('sun') ?? -1

  const handsOf = (id: string) => [...watch.querySelectorAll<SVGElement>(`[data-hand="${id}"]`)]
  const HANDS = { second: handsOf('second'), minute: handsOf('minute'), hour: handsOf('hour'), date: handsOf('date') }
  const weekHand = watch.querySelector<SVGElement>('#pw-week-hand')!
  const yearHand = watch.querySelector<SVGElement>('#pw-year-hand')!
  const moonLit = watch.querySelector<SVGElement>('#pw-moon-lit')!
  const moonShape = watch.querySelector<SVGElement>('#pw-moon-path')!
  const drumEls = [...watch.querySelectorAll<SVGElement>('.drum')]
  const bitEls = [...watch.querySelectorAll<SVGElement>('.bit')]
  const last: Record<string, number | string> = {}
  /** Write an attribute only when what it says has changed. */
  function put(key: string, els: SVGElement | SVGElement[], attr: string, value: string) {
    if (last[key] === value) return
    last[key] = value
    for (const e of Array.isArray(els) ? els : [els]) e.setAttribute(attr, value)
  }
  const rot = (deg: number) => `rotate(${deg.toFixed(2)})`
  if (SUN >= 0) watch.querySelector('#pw-sun-arc')!.setAttribute('d', sunArc(read(RINGS[SUN], now).frac))

  /* The Earth: its own small surface, set into the lower dial. It moves a
     quarter of a degree a minute, so it is drawn when the minute changes
     and not sixty times a second. */
  const earthHost = el('earth')
  earthHost.style.left = (EARTH_BOX.cx - EARTH_BOX.r) * 100 + '%'
  earthHost.style.top = (EARTH_BOX.cy - EARTH_BOX.r) * 100 + '%'
  earthHost.style.width = EARTH_BOX.r * 200 + '%'
  const RAD = Math.PI / 180
  const sun = [0, 0]
  let here = 9
  function aimSun(d: Date) {
    const s = subsolar(d)
    sun[0] = s.lon * RAD
    sun[1] = s.lat * RAD
    // The meridian where the clocks read what this one does: about where you are.
    const localHours = d.getHours() + d.getMinutes() / 60
    here = sun[0] + (localHours - 12) * 15 * RAD
  }
  aimSun(now)
  const earth = new ShaderSurface(earthHost, EARTH_DISC_FRAG, {
    still: true,
    textures: { u_land: '/deep-time/land.webp' },
    uniforms: () => ({ u_sun: sun, u_here: here }),
  })
  if (!earth.canvas.isConnected) earthHost.hidden = true

  /** The watch, set to an instant. The fractions have just been read for the register. */
  function setWatch(d: Date) {
    // Under reduced motion the seconds hand steps once a second, as a quartz one does, and nothing sweeps.
    const a = handAngles(prefersReducedMotion ? new Date(Math.floor(+d / 1000) * 1000) : d)
    put('s', HANDS.second, 'transform', rot(a.second))
    put('m', HANDS.minute, 'transform', rot(a.minute))
    put('h', HANDS.hour, 'transform', rot(a.hour))
    put('d', HANDS.date, 'transform', rot(a.date))
    if (WEEK >= 0) put('w', weekHand, 'transform', rot(fracs[WEEK] * 360))
    put('y', yearHand, 'transform', rot(fracs[YEAR] * 360))
    if (MOON >= 0) {
      const key = Math.round(fracs[MOON] * 2000)
      if (last.moon !== key) {
        last.moon = key
        const m = moonPath(fracs[MOON], 58)
        moonShape.setAttribute('d', m.d)
        moonLit.setAttribute('transform', m.flip ? 'scale(-1 1)' : '')
      }
    }
    const dr = drums(d.getFullYear(), fracs[YEAR])
    dr.forEach((x, k) => {
      const g = drumEls[k]
      if (!g) return
      if (last['dd' + k] !== x.digit) { last['dd' + k] = x.digit; g.children[0].textContent = String(x.digit); g.children[1].textContent = String(x.next) }
      put('dr' + k, g, 'transform', `translate(0 ${(-x.roll * 46).toFixed(2)})`)
    })
    const sec = Math.floor(+d / 1000)
    if (last.bits !== sec) {
      last.bits = sec
      const b = bits(d)
      for (let k = 0; k < bitEls.length; k++) bitEls[k].classList.toggle('on', b[k] === '1')
    }
    const minute = Math.floor(+d / 60_000)
    if (last.earth !== minute) { last.earth = minute; aimSun(d); earth.redraw() }
  }

  /* Pointing at the watch. Each part carries the span it shows; a part that
     shows two (the track of sixty at the edge) answers for the first. */
  function aim(e: PointerEvent) {
    const part = (e.target as Element).closest<SVGElement>('[data-u]')
    let hit = -1
    if (part) for (const id of part.dataset.u!.split(' ')) { const i = idx.get(id); if (i !== undefined) { hit = i; break } }
    if (hit !== hovered) { hovered = hit; syncPressed() }
  }

  watch.addEventListener('pointermove', aim)
  watch.addEventListener('pointerdown', (e) => {
    aim(e)
    // On a touchscreen there is no hover, so the tap has to do the pinning.
    if (hovered >= 0) { pinned = pinned === hovered ? -1 : hovered; syncPressed(); markRead(hovered, 'Clicked') }
  })
  watch.addEventListener('pointerleave', () => { hovered = -1; syncPressed() })

  /* ------------------------------------------------------------------------
     The panel behind everything. Fixed to the viewport and told where the page
     has been scrolled to, rather than being one very tall canvas.
     ------------------------------------------------------------------------ */

  let scroll = 0
  const panel = new ShaderSurface(el('panel'), PANEL_FRAG, {
    scale: 0.75,
    uniforms: () => ({ u_scroll: scroll, u_motion: prefersReducedMotion ? 0 : 1 }),
  })

  function readScroll() {
    const max = document.documentElement.scrollHeight - innerHeight
    scroll = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0
  }
  readScroll()
  addEventListener('scroll', () => {
    readScroll()
    // The shared ticker is parked under reduced motion, so the panel needs asking.
    if (prefersReducedMotion) panel.redraw()
  }, { passive: true })

  /* ------------------------------------------------------------------------
     The clock
     ------------------------------------------------------------------------ */

  // Built once. Constructing an Intl.DateTimeFormat is expensive and
  // toLocaleString builds one per call — this ran sixty times a second to
  // produce a string that changes once a second.
  const fmt = new Intl.DateTimeFormat(undefined, {
    weekday: 'short', day: 'numeric', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit', second: '2-digit',
  })
  let lastSecond = -1
  let lastStripSec = -1
  const stripPct = (frac: number) => (frac * 100).toFixed(1) + '%'
  let lastPlPct = ''
  let lastPlName = ''
  let lastPlLeft = ''
  /* Under reduced motion the shared ticker never runs, so the dial has to be
     asked to redraw — but only when something has actually moved. A ring
     advancing is the page working, not decoration, so it is not something to
     suppress; redrawing sixty times a second to show a change that happens
     seventeen times a second is. */
  let dirty = false

  function frame() {
    const d = new Date()

    const sec = Math.floor(+d / 1000)
    if (sec !== lastSecond) {
      lastSecond = sec
      plClock.textContent = fmt.format(d)
    }

    const s = shown()
    let sv = null as ReturnType<typeof read> | null

    for (let i = 0; i < N; i++) {
      const row = rows[i]
      const v = read(RINGS[i], d)
      if (i === s) sv = v

      fracs[i] = v.frac

      if (v.name !== row.lastName) { row.lastName = v.name; row.name.textContent = v.name }

      // Rounded to a tenth of a percent of the rule's width: below that
      // nothing moves on screen, and a style write per row per frame is not
      // free at fifteen rows and sixty frames.
      const w = Math.round(v.frac * 1000)
      if (w !== row.lastW) {
        row.lastW = w
        dirty = true
        row.rule.style.width = (w / 10).toFixed(1) + '%'
      }
      if (v.pct !== row.lastPct) { row.lastPct = v.pct; row.pct.textContent = v.pct }
      if (v.left !== row.lastLeft) { row.lastLeft = v.left; row.left.textContent = v.left }
    }

    // The strip: once a second is plenty for a percentage of a year.
    if (sec !== lastStripSec) {
      lastStripSec = sec
      shell.setScore(stripPct(fracs[YEAR]))
      shell.setMoves(stripPct(fracs[DAY]))
    }

    // Dwell: the same ring in focus, uninterrupted, for long enough to read.
    const f = focus()
    if (f !== dwellOn) { dwellOn = f; dwellFrom = +d }
    else if (f >= 0 && !seen.has(f) && +d - dwellFrom >= DWELL_MS) markRead(f, 'Held in focus')

    // The aperture and the plate read whichever ring is under the pointer.
    if (sv) {
      if (sv.pct !== lastPlPct) { lastPlPct = sv.pct; plPct.textContent = sv.pct }
      if (sv.name !== lastPlName) { lastPlName = sv.name; plName.textContent = sv.name }
      if (sv.left !== lastPlLeft) { lastPlLeft = sv.left; plLeft.textContent = sv.left }
    }

    setWatch(d)
    requestAnimationFrame(frame)
  }

  syncPressed()
  shell.setLevel(`0 / ${N}`)
  frame()

  /* Touch has no hover, so the invitation has to name the thing that works there. */
  el('hint').textContent =
    `${N} spans of time on one watch. ` +
    (matchMedia('(hover: none)').matches ? 'Tap any part of it.' : 'Point at any part of it.')
</script>

<style is:global>
  /* Rows are built at runtime, so these cannot be scoped. */
  /* The wall panel fills the stage edge to edge. overflow: clip rather than
     hidden, which would make the stage a scroll container and stop the panel
     sticking. */
  .stage:has(> .progress-body) { padding: 0; overflow: clip; background: #14091f; }
  .progress-body {
    position: relative;
    color: #f1eaf8;
    --ink: #f1eaf8;
    --ink2: #b3a1c9;
    --ink3: #a08cbb;
    --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* Sticky, not fixed: pinned behind the page while it scrolls, but inside the frame. */
  .progress-body .pg-panel {
    position: sticky; top: 0; height: 100vh; margin-bottom: -100vh; z-index: 0; pointer-events: none; overflow: hidden;
    /* The still fallback, roughly what the shader settles to: without WebGL2
       this is the page's own background and nothing looks missing. */
    background:
      radial-gradient(105% 55% at 44% -6%, #2a1547 0%, transparent 60%),
      linear-gradient(180deg, #190c28, #120817 58%, #0d0512);
  }
  .progress-body .pg-panel .gl-surface,
  .progress-body .earth .gl-surface {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
  }

  .progress-body .pg-wrap {
    position: relative; z-index: 1;
    /* 900 rather than a text measure: the dial is the widest thing here and
       820 was fencing it in. The prose inside sets its own measure. */
    max-width: 900px; margin: 0 auto; padding: 32px 22px 64px;
  }

  .progress-body .head { text-align: center; }
  .progress-body .lede { color: var(--ink2); margin: 0 auto; max-width: 42ch; font-size: 17px; }

  /* ---------------------------------------------------------------- rig -- */

  /* One column that is exactly the wrap's width: an auto track sizes itself
     off the widest item, and the plate's min-width was pushing the track, and
     the dial at 100% of it, past the edge of the frame. */
  .progress-body .rig { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; margin: 26px 0 34px; }

  .progress-body .watch {
    /* 100%, not a viewport measure: the wrap has padding either side and a
       viewport width walks straight through it. The 86vh keeps the whole
       watch on screen at once in a short window, which is the only reason
       to draw one round. */
    position: relative;
    width: min(100%, 780px, 86vh);
    aspect-ratio: 1;
    touch-action: manipulation;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55)) drop-shadow(0 6px 10px rgb(0 0 0 / 0.5));
  }
  .progress-body .watch-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
  .progress-body .watch-top { pointer-events: none; }
  .progress-body .earth { position: absolute; aspect-ratio: 1; border-radius: 50%; overflow: hidden; pointer-events: none; }

  .progress-body .watch text { text-anchor: middle; dominant-baseline: central; font-family: var(--mono); fill: #c9cbe6; user-select: none; }
  .progress-body .watch .t-date { font-size: 17px; font-weight: 500; }
  .progress-body .watch .t-sub { font-size: 19px; font-weight: 600; fill: #e6e8f6; }
  .progress-body .watch .t-mo { font-size: 15px; }
  .progress-body .watch .t-we { fill: #cdbcff; }
  .progress-body .watch .t-24 { font-size: 12px; font-weight: 600; fill: #e6e8f6; paint-order: stroke; stroke: #07061a; stroke-width: 4px; }
  .progress-body .watch .t-cap { font-size: 11px; letter-spacing: 0.3em; fill: #9a9cc4; }
  .progress-body .watch .t-name { font-family: var(--display); font-size: 31px; letter-spacing: -0.01em; fill: #f1eefc; }
  .progress-body .watch .t-drum { font-size: 31px; font-weight: 600; fill: #14122b; }

  .progress-body .watch .bit { fill: #1d1b40; transition: fill 120ms linear; }
  .progress-body .watch .bit.on { fill: #4fe3c1; }

  .progress-body .watch .h-main { fill: url(#pw-hand); stroke: #2a2c40; stroke-width: 1; }
  .progress-body .watch .h-lume { fill: #bff5e6; }
  .progress-body .watch .h-sec { fill: #4fe3c1; }
  .progress-body .watch .h-date { fill: #b8a1ff; }
  .progress-body .watch .sh { fill: #000; opacity: 0.34; }
