     number stopped being readable. */
  .progress-body .row.lit .r-i { color: var(--lume-lit); }
  .progress-body .r-name {
    grid-area: n; font-weight: 600; font-size: 15px; letter-spacing: -0.006em;
  }
  .progress-body .r-name b { font-weight: inherit; }
  /* No grid-area: only three of the fifteen rows have a note, and naming an
     area would give the other twelve an empty row and its gap. Spanning the
     full width with no row assigned lets it create an implicit row, and only
     where there is something to put in one. */
  .progress-body .r-note {
    /* From 2, not 1: the index column is the row's label, and a note starting
       under it reads as belonging to the number rather than to the unit. */
    grid-column: 2 / -1;
    font-style: normal; font-weight: 400;
    font-size: 12px; color: var(--ink3);
  }

  /* A scale rule engraved in the plate, not a progress bar: a hairline groove
     with the travelled part filled in the ring's own colour. Three faint
     ticks at 25/50/75 repeat the dial bezel's own numerals in miniature, so
     the two read as one measuring instrument rather than a gauge next to an
     unrelated list. */
  .progress-body .r-rule {
    grid-area: r; position: relative;
    height: 4px; border-radius: 3px;
    background:
      linear-gradient(90deg,
        transparent 24.3%, rgb(255 255 255 / 0.07) 25%, transparent 25.7%,
        transparent 49.3%, rgb(255 255 255 / 0.07) 50%, transparent 50.7%,
        transparent 74.3%, rgb(255 255 255 / 0.07) 75%, transparent 75.7%),
