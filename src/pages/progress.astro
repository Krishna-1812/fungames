  .progress-body .r-rule i::after {
    content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 2px;
    background: #fff; opacity: 0.6;
    box-shadow: 0 0 4px 1px rgb(255 255 255 / 0.55);
  }

