---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * Progress — every unit of time you are currently inside, draining live.
 *
 * All of it is computed from the visitor's own clock, so it is correct in any
 * timezone and needs no backend. The date arithmetic lives in
 * `lib/progress-time.ts` and is exercised by `scripts/check-progress.mjs`
 * across four timezones and a year of instants; the instrument's geometry
 * lives in `lib/progress-dial.ts` so that the shader and the pointer hit-test
 * cannot disagree about where a ring is.
 *
 * The page is one object: a wall panel, a chronometer bolted to it, and a data
 * plate under that. The register at the bottom is the readout — everything the
 * dial shows, in text, which is also what a screen reader gets, since the dial
 * itself is a canvas and says nothing.
 */
---

<GameLayout
  slug="progress"
  bar="#2c1440"
  bodyClass="progress-body"
  fonts={['IBM+Plex+Mono:wght@400;500;600']}
>
  <div class="panel" id="panel" aria-hidden="true"></div>

  <div class="wrap">
    <header class="head">
      <h1>Progress</h1>
      <p class="lede">
        Everything you are currently inside of, and how much of it is already gone.
      </p>
    </header>

    <div class="rig">
      <div class="dial" id="dial">
        <!-- The canvas is injected here. Everything it draws is also written
             out in the register below, so it is decoration as far as assistive
             technology is concerned. -->
        <!-- Every channel sweeps clockwise from twelve, so one set of numerals
             on the bezel reads all fifteen of them. -->
        <div class="scale" aria-hidden="true">
          <span style="--a:0deg"><i>0</i></span>
          <span style="--a:90deg"><i>25</i></span>
          <span style="--a:180deg"><i>50</i></span>
          <span style="--a:270deg"><i>75</i></span>
        </div>

        <div class="aper" id="aper" aria-hidden="true">
          <span class="ap-pct" id="apPct">—</span>
          <span class="ap-tag" id="apTag">—</span>
        </div>
      </div>

      <div class="plate" aria-hidden="true">
        <p class="pl-name" id="plName">—</p>
        <p class="pl-left" id="plLeft">—</p>
        <p class="pl-clock" id="plClock">—</p>
      </div>

      <p class="hint" id="hint">Fifteen channels, fastest at the rim. Point at one.</p>
    </div>

    <ol class="reg" id="reg"></ol>

    <p class="foot">Updates every frame. This does not help.</p>
  </div>
</GameLayout>

<script>
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { PANEL_FRAG } from '../lib/progress-panel'
  import { DIAL_FRAG } from '../lib/progress-dial'
  import { DIAL, ringAt, lumeCss } from '../lib/progress-geom'
  import { liveUnits, MAX_UNITS, read } from '../lib/progress-time'

  const el = (id: string) => document.getElementById(id)!

  const dialHost = el('dial')
  const reg = el('reg')
  const apPct = el('apPct')
  const apTag = el('apTag')
  const plName = el('plName')
  const plLeft = el('plLeft')
  const plClock = el('plClock')

  const now = new Date()
  // Not UNITS: the 32-bit row stops being something you are inside of in 2038.
  const RINGS = liveUnits(now)
  const N = RINGS.length

  // The aperture is sized off the same constant the shader mills it at, so a
  // change to the dial's proportions cannot leave the readout hanging over the
  // lip of its own recess.
  dialHost.style.setProperty('--aper', String(DIAL.aperR))
  // Halved twice: the shader's radii are fractions of the half-width, and CSS
  // is offsetting from the centre by a fraction of the full width.
  dialHost.style.setProperty('--scale-r', String((DIAL.bezelIn + DIAL.caseR) / 4))

  /* ------------------------------------------------------------------------
     The register. Built once, then only text and widths are touched — a frame
     that changes nothing writes nothing.
     ------------------------------------------------------------------------ */

  type Row = {
    btn: HTMLButtonElement
    name: HTMLElement
    rule: HTMLElement
    pct: HTMLElement
    left: HTMLElement
    lastName: string
    lastPct: string
    lastLeft: string
    lastW: number
  }

  const rows: Row[] = RINGS.map((u, i) => {
    const li = document.createElement('li')
    const btn = document.createElement('button')
    btn.type = 'button'
    btn.className = 'row'
    btn.setAttribute('aria-pressed', 'false')
    btn.innerHTML =
      `<span class="r-i">${String(i + 1).padStart(2, '0')}</span>` +
      `<span class="r-name"><b></b></span>` +
      `<span class="r-rule"><i></i></span>` +
      `<span class="r-pct"></span><span class="r-left"></span>` +
      /* On its own full-width line rather than under the name. In the name's
         column a note wraps to two lines and makes its row half again as tall
         as the other twelve; across the row it is one line. */
      (u.note ? `<em class="r-note">${u.note}</em>` : '')
    li.append(btn)
    reg.append(li)

    /* A unit's rate never changes, so its colour is set once and never again.
       The rule and the ring it points at both come out of the same two
       constants — `lume()` in the shader, `lumeCss()` here — which is the only
       reason they are the same colour. */
    const rate = read(u, now).rate
    btn.style.setProperty('--lume', lumeCss(rate))
    btn.style.setProperty('--lume-dim', lumeCss(rate, 0.3))
    // Lifted, for type rather than for a rule. See the note by .row.lit .r-i.
    btn.style.setProperty('--lume-lit', lumeCss(rate, 2.5))

    return {
      btn,
      name: btn.querySelector('b')!,
      rule: btn.querySelector('.r-rule i') as HTMLElement,
      pct: btn.querySelector('.r-pct') as HTMLElement,
      left: btn.querySelector('.r-left') as HTMLElement,
      lastName: '', lastPct: '', lastLeft: '', lastW: -1,
    }
  })

  /* ------------------------------------------------------------------------
     Focus: which ring is lit, and what the aperture is reading.

     Two separate things. `focus` dims the other fourteen rings and is -1 when
     nobody is pointing at anything; `shown` is what the aperture reads and is
     never -1, because a blank aperture on an instrument means it is broken.
     ------------------------------------------------------------------------ */

  const DEFAULT = Math.max(0, RINGS.findIndex((u) => u.id === 'year'))
  let hovered = -1
  let pinned = -1
  let focusMix = 0

  const focus = () => (pinned >= 0 ? pinned : hovered)
  const shown = () => { const f = focus(); return f >= 0 ? f : DEFAULT }

  function syncPressed() {
    for (let i = 0; i < rows.length; i++) {
      rows[i].btn.setAttribute('aria-pressed', String(i === pinned))
      rows[i].btn.classList.toggle('lit', i === focus())
    }
  }

  rows.forEach((row, i) => {
    row.btn.addEventListener('pointerenter', () => { hovered = i; syncPressed() })
    row.btn.addEventListener('pointerleave', () => { if (hovered === i) hovered = -1; syncPressed() })
    // Focus follows the keyboard as well, or the dial would be inert to it.
    row.btn.addEventListener('focus', () => { hovered = i; syncPressed() })
    row.btn.addEventListener('blur', () => { if (hovered === i) hovered = -1; syncPressed() })
    row.btn.addEventListener('click', () => { pinned = pinned === i ? -1 : i; syncPressed() })
  })

  /* ------------------------------------------------------------------------
     The instrument.
     ------------------------------------------------------------------------ */

  const fracs = new Float32Array(MAX_UNITS)
  const rates = new Float32Array(MAX_UNITS)

  const dial = new ShaderSurface(dialHost, DIAL_FRAG, {
    uniforms: () => ({
      u_n: N,
      u_frac: fracs,
      u_rate: rates,
      u_focus: focus(),
      u_focusMix: focusMix,
      u_motion: prefersReducedMotion ? 0 : 1,
    }),
  })

  /* Pointing at the dial. The hit test runs on the same geometry the shader
     mills the channels from, in the same space: origin at the centre, 1.0 at
     the edge, y up. The flip is here and nowhere else. */
  function aim(e: PointerEvent) {
    const b = dialHost.getBoundingClientRect()
    if (b.width < 1) return
    const x = ((e.clientX - b.left) / b.width) * 2 - 1
    const y = 1 - ((e.clientY - b.top) / b.height) * 2
    dial.setPointer((x + 1) / 2, (y + 1) / 2)
    const hit = ringAt(x, y, N)
    if (hit !== hovered) { hovered = hit; syncPressed() }
  }

  dialHost.addEventListener('pointermove', aim)
  dialHost.addEventListener('pointerdown', (e) => {
    aim(e)
    // On a touchscreen there is no hover, so the tap has to do the pinning.
    if (hovered >= 0) { pinned = pinned === hovered ? -1 : hovered; syncPressed() }
  })
  dialHost.addEventListener('pointerleave', () => {
    hovered = -1
    dial.setPointer(0.5, 0.5)
    syncPressed()
  })

  /* ------------------------------------------------------------------------
     The panel behind everything. Fixed to the viewport and told where the page
     has been scrolled to, rather than being one very tall canvas.
     ------------------------------------------------------------------------ */

  let scroll = 0
  const panel = new ShaderSurface(el('panel'), PANEL_FRAG, {
    scale: 0.75,
    uniforms: () => ({ u_scroll: scroll, u_motion: prefersReducedMotion ? 0 : 1 }),
  })

  function readScroll() {
    const max = document.documentElement.scrollHeight - innerHeight
    scroll = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0
  }
  readScroll()
  addEventListener('scroll', () => {
    readScroll()
    // The shared ticker is parked under reduced motion, so the panel needs asking.
    if (prefersReducedMotion) panel.redraw()
  }, { passive: true })

  /* ------------------------------------------------------------------------
     The clock
     ------------------------------------------------------------------------ */

  // Built once. Constructing an Intl.DateTimeFormat is expensive and
  // toLocaleString builds one per call — this ran sixty times a second to
  // produce a string that changes once a second.
  const fmt = new Intl.DateTimeFormat(undefined, {
    weekday: 'short', day: 'numeric', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit', second: '2-digit',
  })
  let lastSecond = -1
  let lastTag = ''
  let lastApPct = ''
  let lastPlName = ''
  let lastPlLeft = ''
  /* Under reduced motion the shared ticker never runs, so the dial has to be
     asked to redraw — but only when something has actually moved. A ring
     advancing is the page working, not decoration, so it is not something to
     suppress; redrawing sixty times a second to show a change that happens
     seventeen times a second is. */
  let dirty = false

  function frame() {
    const d = new Date()

    const sec = Math.floor(+d / 1000)
    if (sec !== lastSecond) {
      lastSecond = sec
      plClock.textContent = fmt.format(d)
    }

    const s = shown()
    let sv = null as ReturnType<typeof read> | null

    for (let i = 0; i < N; i++) {
      const row = rows[i]
      const v = read(RINGS[i], d)
      if (i === s) sv = v

      fracs[i] = v.frac
      rates[i] = v.rate

      if (v.name !== row.lastName) { row.lastName = v.name; row.name.textContent = v.name }

      // Rounded to a tenth of a percent of the rule's width: below that
      // nothing moves on screen, and a style write per row per frame is not
      // free at fifteen rows and sixty frames.
      const w = Math.round(v.frac * 1000)
      if (w !== row.lastW) {
        row.lastW = w
        dirty = true
        row.rule.style.width = (w / 10).toFixed(1) + '%'
      }
      if (v.pct !== row.lastPct) { row.lastPct = v.pct; row.pct.textContent = v.pct }
      if (v.left !== row.lastLeft) { row.lastLeft = v.left; row.left.textContent = v.left }
    }

    // The aperture and the plate read whichever ring is under the pointer.
    if (sv) {
      if (sv.pct !== lastApPct) { lastApPct = sv.pct; apPct.textContent = sv.pct }
      const tag = String(s + 1).padStart(2, '0')
      if (tag !== lastTag) { lastTag = tag; apTag.textContent = tag }
      if (sv.name !== lastPlName) { lastPlName = sv.name; plName.textContent = sv.name }
      if (sv.left !== lastPlLeft) { lastPlLeft = sv.left; plLeft.textContent = sv.left }
    }

    // Focus fades rather than snaps: fifteen rings going dark in one frame
    // reads as a bug, and over 150ms it reads as an instrument.
    const want = focus() >= 0 ? 1 : 0
    if (focusMix !== want) {
      focusMix = prefersReducedMotion ? want : focusMix + (want - focusMix) * 0.18
      if (Math.abs(focusMix - want) < 0.004) focusMix = want
      dirty = true
    }

    if (prefersReducedMotion && dirty) { dirty = false; dial.redraw() }
    requestAnimationFrame(frame)
  }

  syncPressed()
  frame()

  /* The count is written from the count. It says fifteen today and will say
     fourteen in 2038, and touch has no hover, so the invitation also has to
     name the thing that actually works there. */
  const WORDS = ['', '', '', '', '', '', '', '', '', '', '', 'Eleven', 'Twelve',
    'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen']
  el('hint').textContent =
    `${WORDS[N] ?? N} channels, fastest at the rim. ` +
    (matchMedia('(hover: none)').matches ? 'Tap one.' : 'Point at one.')
</script>

<style is:global>
  /* Rows are built at runtime, so these cannot be scoped. */
  .progress-body {
    background: #14091f;
    color: #f1eaf8;
    --ink: #f1eaf8;
    --ink2: #b3a1c9;
    --ink3: #a08cbb;
    --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .progress-body .panel {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    /* The still fallback, roughly what the shader settles to: without WebGL2
       this is the page's own background and nothing looks missing. */
    background:
      radial-gradient(105% 55% at 44% -6%, #2a1547 0%, transparent 60%),
      linear-gradient(180deg, #190c28, #120817 58%, #0d0512);
  }
  .progress-body .panel .gl-surface,
  .progress-body .dial .gl-surface {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
  }

  .progress-body .wrap {
    position: relative; z-index: 1;
    /* 900 rather than a text measure: the dial is the widest thing here and
       820 was fencing it in. The prose inside sets its own measure. */
    max-width: 900px; margin: 0 auto; padding: 40px 22px 84px;
  }

  .progress-body .head { text-align: center; }
  .progress-body .head h1 { font-size: clamp(34px, 6vw, 54px); }
  .progress-body .lede { color: var(--ink2); margin: 10px auto 0; max-width: 42ch; }

  /* ---------------------------------------------------------------- rig -- */

  .progress-body .rig { display: grid; justify-items: center; margin: 26px 0 34px; }

  .progress-body .dial {
    /* 100%, not 96vw: the wrap has 22px of padding either side, and a viewport
       measure walks straight through it — on a 390px phone the dial started at
       the left padding and ran six pixels off the right of the page.
       The 76vh is not belt and braces either. This thing is square, and in a
       short laptop window a 700px dial is taller than the viewport, so the
       instrument and its own readout can never be on screen together. */
    --aper: 0.285;
    --scale-r: 0.4445;
    position: relative;
    /* 100%, not a viewport measure: the wrap has 22px of padding either side
       and `96vw` walks straight through it — on a 390px phone the dial started
       at the left padding and ran six pixels off the right of the page. The
       88vh is not belt and braces either: this thing is square, and a dial
       taller than the viewport cannot be read at a glance, which is the only
       reason to draw one as a circle. It is the cap that usually binds — 76vh
       was the first try and it made the instrument feel small in any window
       that was not tall, which is most of them.

       The width is written here rather than kept in a custom property, and
       everything inside sizes off `cqw` or a percentage of this box. A custom
       property holding `min(100%, …)` looks reusable and is a trap: a
       percentage means the container's width in `width`, the parent's font
       size in `font-size`, and the element's own height in `translateY`. It
       collapsed the dial to zero and then rendered the readout at 0.688px. */
    width: min(100%, 880px, 88vh);
    aspect-ratio: 1;
    container-type: inline-size;
    /* The channels are the control; the pointer has to be able to find them. */
    touch-action: manipulation;
  }

  /* Numerals stamped into the bezel.
     Each is a full-size overlay rotated about the dial's centre, with the glyph
     pushed out to the bezel by padding. Padding percentages resolve against the
     containing block's *width* — the dial — which is the only percentage basis
     here that unambiguously means what it says. Offsetting with a translate
     was the obvious way to write this and it silently measured the numeral's
     own 14px box instead, stacking all four on top of each other. */
  .progress-body .scale span {
    position: absolute; inset: 0;
    display: flex; justify-content: center; align-items: flex-start;
    padding-top: calc((0.5 - var(--scale-r)) * 100%);
    transform: rotate(var(--a));
    pointer-events: none;
  }
  /* Counter-rotated, so you read a gauge without tilting your head. */
  .progress-body .scale i {
    transform: rotate(calc(-1 * var(--a)));
    margin-top: -0.6em;
    font-family: var(--mono); font-style: normal;
    font-size: 10px; font-weight: 500; letter-spacing: 0.06em;
    color: #cfc3e2;
    text-shadow: 0 -1px 1px rgb(0 0 0 / 0.8);
  }

  /* Above the canvas. ShaderSurface appends its canvas to the host, so without
     this everything printed on the dial is painted over by the dial. */
  .progress-body .aper,
  .progress-body .scale span { z-index: 2; }

  .progress-body .aper {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    /* 1.8 rather than 2: type inside a circle gets the chord, not the diameter,
       or the ends of a wide number sit under the lip of the recess. */
    width: calc(var(--aper) * 1.8 * 100%);
    display: grid; justify-items: center; gap: 2px;
    pointer-events: none;
  }
  .progress-body .ap-pct {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    /* Sized off the aperture, not off taste. The widest thing this can ever
       read is "100.0000%" — nine characters at 0.6em each in Plex Mono — and
       at 5.8cqw that was 117px of number in a 92px recess on a phone. */
    font-size: 4.3cqw;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #f6efff;
    /* Lumed, not printed: a dark hairline above the glyph and a soft bloom
       around it, which is what a filled engraving does under one light. */
    text-shadow: 0 -1px 0 rgb(0 0 0 / 0.85), 0 0 16px rgb(186 120 255 / 0.34);
  }
  .progress-body .ap-tag {
    font-family: var(--mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.28em; text-indent: 0.28em;
    /* Not a quieter violet. The aperture's luminance cap is a guarantee, and
       the guarantee only holds down to L = 0.288; anything dimmer passes
       against what the recess actually renders today and fails against what
       the shader is allowed to render tomorrow. */
    color: var(--ink3);
  }

  /* -------------------------------------------------------------- plate -- */

  .progress-body .plate {
    position: relative;
    margin-top: -6px;
    min-width: min(92vw, 380px);
    padding: 13px 30px 12px;
    text-align: center;
    border-radius: 8px;
    background: linear-gradient(180deg, #1d1229, #150d1f);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.055),
      inset 0 -1px 0 rgb(0 0 0 / 0.5),
      0 10px 24px -14px rgb(0 0 0 / 0.9);
  }
  /* Two screws, because a plate is fixed to something. */
  .progress-body .plate::before,
  .progress-body .plate::after {
    content: ''; position: absolute; top: 50%; width: 5px; height: 5px;
    margin-top: -2.5px; border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #6b6076, #241c30 70%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.07);
  }
  .progress-body .plate::before { left: 11px; }
  .progress-body .plate::after { right: 11px; }

  .progress-body .pl-name {
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.18em; text-indent: 0.18em; text-transform: uppercase;
    color: var(--ink);
  }
  .progress-body .pl-left {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: 13px; color: var(--ink2); margin-top: 3px;
  }
  .progress-body .pl-clock {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: 11px; color: var(--ink3); margin-top: 7px;
    padding-top: 7px; border-top: 1px solid rgb(255 255 255 / 0.06);
  }

  .progress-body .hint {
    margin-top: 14px; font-size: 12.5px; color: var(--ink3); text-align: center;
  }

  /* ----------------------------------------------------------- register -- */

  /* One plate, not fifteen floating cards. The panel shares the plate's own
     gradient — the same #1d1229 → #150d1f the readout sits on above — so the
     list reads as another surface of the one instrument rather than a
     separate widget parked underneath it. Rows keep a hairline gap, and what
     shows through the gap is this background, which is what turns the gap
     into a seam instead of a hole back to the page. */
  .progress-body .reg {
    list-style: none; margin: 0; padding: 7px;
    display: grid; gap: 1px;
    background: linear-gradient(180deg, #1d1229, #150d1f);
    border-radius: 16px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      inset 0 -1px 0 rgb(0 0 0 / 0.45),
      0 24px 60px -34px rgb(0 0 0 / 0.85);
  }

  .progress-body .row {
    display: grid;
    width: 100%;
    /* The name column is wider than it looks like it needs to be because of
       "The current lunar cycle", which wrapped to two lines and took its note
       to a third, making one row half again as tall as the other fourteen. */
    grid-template-columns: 2.3rem minmax(0, 1.4fr) 1.7fr 4.9rem;
    grid-template-areas: 'i n r p' '. l l l';
    align-items: center;
    gap: 4px 12px;
    padding: 10px 12px 10px 9px;
    border: 0; border-radius: 9px;
    /* Reserved rather than added on .lit: a border that appears out of
       nowhere nudges every column over by its width for one frame. Only the
       colour changes when a row lights. */
    border-left: 3px solid transparent;
    background: transparent;
    color: inherit; font: inherit; text-align: left;
    cursor: pointer;
    transition: background 150ms var(--ease), border-color 150ms var(--ease);
  }
  .progress-body .row.lit {
    background: rgb(255 255 255 / 0.05);
    border-left-color: var(--lume);
  }
  .progress-body .row:active { transform: scale(0.997); }
  .progress-body .row:focus-visible { outline: 2px solid #c79bff; outline-offset: -2px; }

  .progress-body .r-i {
    grid-area: i;
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--mono); font-size: 11px; font-weight: 500;
    /* #7c6796 was quieter and measured 3.89:1. */
    color: #8d78ab; letter-spacing: 0.04em;
  }
  /* A permanent swatch of the ring's own colour, dim until the row is lit —
     so the register carries the dial's one real fact (fast is hot, slow is
     cold) even before anything is pointed at. Purely decorative: it carries
     no text, so it needs no contrast of its own. */
  .progress-body .r-i::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%; flex: none;
    background: var(--lume); opacity: 0.5;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.35);
    transition: opacity 150ms var(--ease), box-shadow 150ms var(--ease);
  }
  .progress-body .row.lit .r-i::before { opacity: 1; box-shadow: 0 0 6px 1px var(--lume); }
  /* The lit row's index takes its ring's colour — but the *lifted* one. The
     lume as painted runs down to rgb(110 83 187) at the slow end, which is
     3.33:1 on this background: the moment you pointed at the Sun's row, its
     number stopped being readable. */
  .progress-body .row.lit .r-i { color: var(--lume-lit); }
  .progress-body .r-name {
    grid-area: n; font-weight: 600; font-size: 15px; letter-spacing: -0.006em;
  }
  .progress-body .r-name b { font-weight: inherit; }
  /* No grid-area: only three of the fifteen rows have a note, and naming an
     area would give the other twelve an empty row and its gap. Spanning the
     full width with no row assigned lets it create an implicit row, and only
     where there is something to put in one. */
  .progress-body .r-note {
