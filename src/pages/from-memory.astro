---
import GameShell from '../layouts/GameShell.astro'
import { ROUND_SIZE } from '../data/memory'

/**
 * From Memory — draw an everyday object, then compare against the real shape.
 *
 * Deliberately uses ordinary objects rather than brand logos: it avoids
 * reproducing trademarks, and the effect is stronger anyway. Almost nobody can
 * draw a working bicycle, which is a genuine documented phenomenon.
 *
 * Sixteen prompts in data/memory.ts, ten per sitting, bicycle always first.
 * Reference shapes are hand-authored SVG in a shared 200×140 viewBox so the
 * overlay lines up with the canvas exactly — scripts/check-memory.mjs parses
 * every coordinate and checks they really do stay inside it, which is not
 * something you can see by reading a path.
 *
 * In the shell: the game never had a score, and the shell wants one, so it
 * has a real one — lib/memo-score.ts measures how much of the real shape you
 * drew and how much of your ink lies on it, and the checker proves it can tell
 * a traced reference from a random line of the same length. Score is your
 * average likeness so far, Drawing is progress, Moves are strokes on this
 * sheet, and Best is your best average over a full ten.
 */
---

<GameShell
  slug="from-memory"
  labels={{ score: 'Likeness', best: 'Best average', level: 'Drawing', moves: 'Strokes' }}
  initial={{ score: '—', level: `1 / ${ROUND_SIZE}`, moves: '0' }}
>
  <div class="fm">
    <div class="fm-brief">
      <p class="label meta" id="tag">Drawing 1 of {ROUND_SIZE}</p>
      <h2 class="fm-prompt" id="prompt">A bicycle</h2>
      <p class="fm-hint">Draw it without looking anything up. Beautifully wrong is welcome.</p>
      <ol class="fm-tally" id="tally" aria-label="Your drawings so far">
        {Array.from({ length: ROUND_SIZE }, () => <li><span class="sr-only">Not drawn yet</span></li>)}
      </ol>
    </div>

    <div class="fm-desk">
      <div class="fm-pad" id="padBox">
        <div class="fm-sheet" id="sheet" aria-hidden="true"></div>
        <canvas id="pad" aria-label="Drawing area — draw with a mouse, pen or finger"></canvas>
        <svg class="fm-ref" id="ref" viewBox="0 0 200 140" aria-hidden="true" hidden></svg>
      </div>
      <div class="fm-compare" id="comparison" hidden>
        <figure><figcaption class="label meta">What you remembered</figcaption><img id="attemptImage" alt="Your drawing" /></figure>
        <figure><figcaption class="label meta">The reference</figcaption><svg id="comparisonRef" viewBox="0 0 200 140" role="img" aria-label="Reference drawing"></svg></figure>
      </div>
      <div class="fm-tools" id="tools">
        <button type="button" class="pill pill--line pill--sm" id="undoBtn"><span>Undo</span></button>
        <button type="button" class="pill pill--line pill--sm" id="clearBtn"><span>Clear</span></button>
        <button type="button" class="pill pill--hero fm-reveal" id="revealBtn"><span>Reveal</span><span class="arrow" aria-hidden="true">→</span></button>
      </div>
    </div>

    <div class="fm-verdict" id="verdict" hidden tabindex="-1">
      <p class="label">Likeness</p>
      <p class="fm-score"><span class="num" id="vScore">0%</span><span class="fm-word" id="vWord">Close</span></p>
      <p class="fm-why" id="vWhy"></p>
      <p class="fm-fact" id="fact"></p>
      <div class="fm-actions">
        <button type="button" class="pill pill--ink" id="nextBtn"><span id="nextLbl">Next drawing</span><span aria-hidden="true">→</span></button>
        <button type="button" class="pill pill--line pill--sm" id="compareBtn" aria-pressed="false"><span>Side by side</span></button>
        <button type="button" class="pill pill--line pill--sm" id="postcardBtn"><span>Download postcard</span></button>
      </div>
      <p class="fm-status" id="exportStatus" role="status"></p>
    </div>
  </div>

  <Fragment slot="howto">
    <p>
      Ten everyday things, one at a time. Draw each one from memory on the
      sheet — mouse, pen or finger — then press <b>Reveal</b> to see the real
      shape drawn over yours.
    </p>
    <ul>
      <li><b>Likeness</b> measures how much of the real shape you drew and how much of your ink lies on it. Drawing it in the wrong place or at the wrong size is forgiven; drawing the wrong shape is not.</li>
      <li>Scribbling over everything does not help — extra ink counts against you.</li>
      <li>Keys: <kbd>R</kbd> reveals, <kbd>U</kbd> undoes a stroke, <kbd>N</kbd> moves on.</li>
    </ul>
    <p>Your best is your best average over a full ten.</p>
  </Fragment>

  <details class="fm-real" slot="after">
    <summary class="label">How the likeness is measured</summary>
    <p>
      Both drawings live in the same 200 by 140 box. The real shape is sampled
      into points a unit and a half apart, and so is your ink. <b>Coverage</b>
      is how much of the real shape has some of your ink within about 1.5% of
      the box; <b>precision</b> is how much of your ink has the real shape that
      close. The likeness is their harmonic mean, so a single tidy line (high
      precision, no coverage) and a scribble (coverage, no precision) both
      score low.
    </p>
    <p>
      Nobody draws from memory in exactly the right spot, so your drawing is
      also tried moved and scaled onto the real one — its aspect ratio allowed
      to bend by a third at most — and the better placement counts. Ink beyond
      1.6 times the real drawing's own length costs precision in proportion.
    </p>
    <p>
      <code>scripts/check-memory.mjs</code> holds the number to account: a
      trace of every reference scores 98 or more, a 5-unit wobble averages
      the mid-80s, the wrong object drawn perfectly averages the mid-30s, and
      a random line of the same length averages under 30.
    </p>
  </details>
</GameShell>

<script>
  import { createShell } from '../lib/game-shell'
  import { roll, PLAY } from '../lib/motion'
  import { sfx, unlock } from '../lib/audio'
  import { pickRound } from '../data/memory'
  import type { Item } from '../data/memory'
  import { ShaderSurface } from '../lib/gl'
  import { PAPER_FRAG } from '../lib/memo-paper'
  import { InkSurface, Nib, nibWidth, renderStrokes, REF_W, REF_H } from '../lib/memo-ink'
  import type { Pt, Stroke } from '../lib/memo-ink'
  import { Reveal } from '../lib/memo-reveal'
  import { memoryPostcard } from '../lib/memo-postcard'
  import { refPoints, likeness, verdictFor } from '../lib/memo-score'
  import type { Likeness } from '../lib/memo-score'
  import { download } from '../lib/share-card'
  import { recordPlay } from '../lib/stats'
  import { dailyFor, dailyTarget } from '../data/game-meta'

  /* Ten of the sixteen, freshly drawn each visit, with the bicycle always
     first. A pool bigger than the sitting is the difference between a thing you
     do once and a thing you can hand to somebody else afterwards. */
  let ROUND: Item[] = pickRound()

  const el = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const pad = el<HTMLCanvasElement>('pad')
  const ref = el('ref') as unknown as SVGSVGElement
  const padBox = el('padBox')
  const verdict = el('verdict')
  const tally = [...el('tally').children] as HTMLLIElement[]

  let i = 0
  /* Strokes are lists of {x, y, w} in the 200x140 reference space the answers
     are drawn in, not in canvas pixels. That is what lets the same stroke be
     re-rendered into the pad at whatever size the layout gives it and into the
     gallery at thumbnail size, both sharp. */
  let strokes: Stroke[] = []
  let drawing: Stroke | null = null
  let revealed = false
  let activePointer: number | null = null
  let saved: string[] = []          // data URLs, one per item
  let scores: Likeness[] = []

  const shell = createShell({ slug: 'from-memory', onRestart: restart })
  const ink = new InkSurface(pad)
  const reveal = new Reveal(ref)

  // Paper. Never animates: still: true is one frame on mount and one per
  // resize. A drawing surface that shimmers would be intolerable.
  new ShaderSurface(el('sheet'), PAPER_FRAG, { still: true })

  const band = (n: number) => (n >= 60 ? 'is-high' : n >= 45 ? 'is-mid' : 'is-low')
  const average = () => (scores.length ? Math.round(scores.reduce((a, s) => a + s.score, 0) / scores.length) : 0)

  function paintStrip() {
    shell.setScore(scores.length ? `${average()}%` : '—')
    shell.setLevel(`${Math.min(i + 1, ROUND.length)} / ${ROUND.length}`)
    shell.setMoves(String(strokes.length))
  }

  function paintTally() {
    tally.forEach((li, k) => {
      const s = scores[k]
      li.className = s ? band(s.score) : k === i ? 'is-now' : ''
      li.dataset.score = s ? String(s.score) : ''
      li.firstElementChild!.textContent = s ? `${ROUND[k].reveal}: ${s.score}%` : k === i ? 'Drawing now' : 'Not drawn yet'
    })
  }

  /** Rebuild the whole sheet. Only for undo, clear and resize. */
  function rebuild() {
    ink.replay(strokes)
    ink.blit()
  }

  /** Pointer position in reference units. */
  function pos(e: PointerEvent) {
    const r = pad.getBoundingClientRect()
    return {
      x: ((e.clientX - r.left) / r.width) * REF_W,
      y: ((e.clientY - r.top) / r.height) * REF_H,
    }
  }

  let nib: Nib | null = null
  let lastT = 0
  let lastW = 0

  /** One pointer sample: work out the nib width, hand it to the pen. */
  function extend(e: PointerEvent, at: number) {
    const q = pos(e)
    const prev = drawing![drawing!.length - 1]
    const dist = Math.hypot(q.x - prev.x, q.y - prev.y)
    // Samples that land on top of each other carry no shape and only cost fill.
    // A resting hand produces a lot of them.
    if (dist < 0.12) return
    const w = nibWidth(dist, at - lastT, lastW, e.pressure)
    lastT = at
    lastW = w
    const pt: Pt = { x: q.x, y: q.y, w }
    drawing!.push(pt)
    nib!.push(pt)
  }

  pad.addEventListener('pointerdown', (e) => {
    if (revealed || shell.paused || activePointer !== null || !e.isPrimary || e.button !== 0) return
    activePointer = e.pointerId
    try { pad.setPointerCapture(e.pointerId) } catch { /* not fatal */ }
    unlock(); sfx.tick()
    const q = pos(e)
    lastT = e.timeStamp
    const pt: Pt = { x: q.x, y: q.y, w: nibWidth(0, 0, 0, e.pressure) }
    lastW = pt.w
    drawing = [pt]
    strokes.push(drawing)
    nib = new Nib(ink)
    nib.push(pt)
    ink.blit()
    e.preventDefault()
  })

  pad.addEventListener('pointermove', (e) => {
    if (!drawing || e.pointerId !== activePointer) return
    /* Coalesced events are the samples the browser collected since the last
       frame and would otherwise throw away. A pen reports far faster than the
       display refreshes, and taking only the delivered event throws most of a
       stylus stroke on the floor. */
    const raw = e.getCoalescedEvents ? e.getCoalescedEvents() : []
    if (raw.length) for (const c of raw) extend(c, c.timeStamp)
    else extend(e, e.timeStamp)
    ink.blit()
  })

  /* No pointerleave here on purpose. The pointer is captured, so up and cancel
     still arrive when the hand goes outside the pad — and the old listener
     meant that drawing off the edge of the paper and back cut the stroke in
     two, which is not what happens with a pen. */
  const end = () => {
    activePointer = null
    if (!drawing) return
    drawing = null
    nib!.end()
    nib = null
    ink.commit()
    ink.blit()
    shell.setMoves(String(strokes.length))
  }
  pad.addEventListener('pointerup', (e) => { if (e.pointerId === activePointer) end() })
  pad.addEventListener('pointercancel', (e) => { if (e.pointerId === activePointer) end() })

  function undo() { if (revealed) return; end(); strokes.pop(); rebuild(); shell.setMoves(String(strokes.length)) }
  function clear() { if (revealed) return; end(); strokes = []; rebuild(); shell.setMoves('0') }
  el('undoBtn').addEventListener('click', undo)
  el('clearBtn').addEventListener('click', clear)

  function render() {
    const it = ROUND[i]
    el('tag').textContent = `Drawing ${i + 1} of ${ROUND.length}`
    el('prompt').textContent = it.prompt
    strokes = []
    drawing = null
    nib = null
    revealed = false
    el('comparison').hidden = true
    el('compareBtn').setAttribute('aria-pressed', 'false')
    el('compareBtn').firstElementChild!.textContent = 'Side by side'
    el('exportStatus').textContent = ''
    padBox.hidden = false
    ink.resize()
    rebuild()
    reveal.stop()
    ref.toggleAttribute('hidden', true)
    ref.innerHTML = ''
    verdict.hidden = true
    el('tools').hidden = false
    for (const id of ['undoBtn', 'clearBtn', 'revealBtn']) (el(id) as HTMLButtonElement).disabled = false
    paintStrip()
    paintTally()
    const brief = document.querySelector('.fm-brief')!
    brief.classList.remove('is-turning')
    void (brief as HTMLElement).offsetWidth
    brief.classList.add('is-turning')
    if (i === ROUND.length - 1) shell.levelUp('Last one.')
  }

  function doReveal() {
    if (revealed || shell.paused) return
    unlock(); sfx.sparkle()
    const it = ROUND[i]
    revealed = true
    end()
    const s = likeness(refPoints(it.svg), strokes)
    scores[i] = s
    // Rendered from the stroke list rather than grabbed off the pad, so the
    // gallery is sharp whatever size the pad happened to be.
    saved[i] = renderStrokes(strokes, 300).toDataURL('image/png')
    el<HTMLImageElement>('attemptImage').src = saved[i]
    el<HTMLImageElement>('attemptImage').alt = `Your drawing: ${it.prompt}`
    el('comparisonRef').innerHTML = it.svg
    el('comparisonRef').setAttribute('aria-label', `Reference: ${it.prompt}`)
    // `hidden` is an HTMLElement property; on an <svg> assigning it only sets an
    // expando and the attribute from the markup stays, so the answer never
    // appeared. The attribute is the thing that has to change.
    ref.toggleAttribute('hidden', false)
    reveal.play(it.svg, !PLAY)

    const word = verdictFor(s.score)
    verdict.className = 'fm-verdict ' + band(s.score)
    el('vWord').textContent = word
    el('vWhy').textContent = !strokes.length
      ? 'Nothing drawn — so here is what it actually looks like.'
      : `You drew ${Math.round(s.coverage * 100)}% of the real shape, and ${Math.round(s.precision * 100)}% of your ink was on it` +
        (s.aligned ? ', once your drawing was lined up with it.' : '.')
    el('fact').textContent = it.fact
    el('nextLbl').textContent = i + 1 >= ROUND.length ? 'See all ten' : 'Next drawing'
    el('tools').hidden = true
    verdict.hidden = false
    const scoreEl = el('vScore')
    if (PLAY) roll(scoreEl, `${s.score}%`, { from: `${String(s.score).replace(/\d/g, '0')}%`, ms: 1100 })
    else scoreEl.textContent = `${s.score}%`
    if (s.score >= 60) shell.pop(verdict)
    shell.announce(`${s.score}% likeness. ${word}.`)
    paintStrip()
    paintTally()
    verdict.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'nearest' })
    el('nextBtn').focus({ preventScroll: true })
  }
  el('revealBtn').addEventListener('click', doReveal)

  function next() {
    if (!revealed) return
    unlock(); sfx.click()
    i++
    if (i < ROUND.length) {
      render()
      padBox.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'nearest' })
      return
    }
    finish()
  }
  el('nextBtn').addEventListener('click', next)

  el('compareBtn').addEventListener('click', () => {
    const sideBySide = el('comparison').hidden
    el('comparison').hidden = !sideBySide
    padBox.hidden = sideBySide
    el('compareBtn').setAttribute('aria-pressed', String(sideBySide))
    el('compareBtn').firstElementChild!.textContent = sideBySide ? 'Overlay drawings' : 'Side by side'
  })

  el('postcardBtn').addEventListener('click', async () => {
    const button = el<HTMLButtonElement>('postcardBtn')
    const roundIndex = i
    const it = ROUND[i]
    const s = scores[i]
    const snapshot = strokes.map((stroke) => stroke.map((point) => ({ ...point })))
    button.disabled = true
    el('exportStatus').textContent = 'Preparing your postcard…'
    try {
      const blob = await memoryPostcard(snapshot, it.svg, it.prompt, s ? { score: s.score, verdict: verdictFor(s.score) } : undefined)
      download(blob, 'from-memory-postcard.png')
      if (i === roundIndex) el('exportStatus').textContent = 'Postcard ready. Check your downloads.'
    } catch {
      if (i === roundIndex) el('exportStatus').textContent = 'The postcard could not be created. Try again.'
    } finally { button.disabled = false }
  })

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || shell.paused || i >= ROUND.length) return
    const t = e.target as HTMLElement
    if (t.closest('input, textarea, select, dialog')) return
    const k = e.key.toLowerCase()
    if (k === 'r' && !revealed) { e.preventDefault(); doReveal() }
    else if (k === 'u' && !revealed) { e.preventDefault(); undo() }
    else if ((k === 'n' || (k === 'enter' && !t.closest('button, a'))) && revealed) { e.preventDefault(); next() }
  })

  /* ---- all ten ------------------------------------------------------- */

  function finish() {
    const avg = average()
    shell.resultExtra.innerHTML = `
      <p class="label">Everything you drew</p>
      <ol class="fm-shelf">${ROUND.map((it, k) => `
        <li class="fm-shot">
          <div class="fm-shot-pad">
            <img src="${saved[k] || ''}" alt="Your drawing of ${it.prompt.toLowerCase()}">
            <svg viewBox="0 0 200 140" aria-hidden="true" class="fm-shot-ref">${it.svg}</svg>
          </div>
          <p><b class="num">${scores[k]?.score ?? 0}%</b> ${it.reveal}</p>
        </li>`).join('')}
      </ol>`

    recordPlay('from-memory', { average: avg, drawn: scores.filter((s) => s.score > 0).length }, { average: 'high' })
    const beat = shell.considerBest(avg, `${avg}%`)
    const best = [...scores.keys()].sort((a, b) => scores[b].score - scores[a].score)[0]
    const lines = [
      `Your best likeness was ${ROUND[best].reveal.toLowerCase()}, at ${scores[best].score}%.`,
    ]
    if (beat === 'beaten') lines.push('✓ That is a new best average.')
    else if (beat === 'first') lines.push('Your first full ten — that average is the one to beat now.')
    else if (shell.best) lines.push(`Your best average is still ${shell.best.text}.`)
    const now = new Date()
    if (dailyFor(now).slug === 'from-memory') {
      const need = dailyTarget.likeness(now)
      lines.push(avg >= need ? `✓ Daily challenge beaten: ${need}% average or better.` : `✗ Daily challenge: average ${need}% or better.`)
    }
    const titles: Record<string, string> = {
      Uncanny: 'A photographic memory.',
      Close: 'You remembered most of it.',
      Recognisable: 'Recognisable, mostly.',
      Loosely: 'Loosely remembered.',
      'From another planet': 'Drawn from another planet.',
    }
    shell.win({
      kicker: `${ROUND.length} drawings · average likeness`,
      title: titles[verdictFor(avg)],
      score: `${avg}%`,
      from: '0%',
      lines,
      againLabel: 'Draw ten more',
    })
  }

  function restart() {
    // A fresh ten out of the sixteen, not the same ten again — otherwise the
    // pool may as well not exist.
    ROUND = pickRound()
    i = 0
    saved = []
    scores = []
    render()
    shell.stage.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
  }

  // The backing store follows the element's real size, so a reflow — a
  // rotation, a font landing, the card growing when the fact appears — has to
  // resize and replay. Assigning canvas.width is what clears it.
  new ResizeObserver(() => { if (ink.resize()) rebuild() }).observe(pad)

  render()
</script>

<style is:global>
  /* The gallery is built by the script, so these rules are global on purpose. */
  .fm {
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    grid-template-areas: 'brief desk' 'verdict desk';
    grid-template-rows: auto 1fr;
    gap: clamp(16px, 2.6vw, 36px);
    align-items: start;
  }
  .fm-brief { grid-area: brief; display: grid; gap: 12px; }
  .fm-desk { grid-area: desk; display: grid; gap: 14px; }
  .fm-verdict { grid-area: verdict; }
  @media (max-width: 900px) {
    .fm { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'brief' 'desk' 'verdict'; grid-template-rows: none; }
  }

  .fm-prompt { font-size: var(--fs-h2); line-height: 0.98; }
  .fm-hint { color: var(--ink2); }
  .fm-tally { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; }
  .fm-tally li { aspect-ratio: 1; max-width: 32px; border-radius: 8px; background: var(--paper2); display: grid; place-items: center; }
  .fm-tally li::after { content: attr(data-score); font: 700 10px/1 var(--sans); letter-spacing: -0.02em; color: var(--ink); }
  .fm-tally li.is-now { background: var(--card); box-shadow: inset 0 0 0 2px var(--ink); }
  .fm-tally li.is-high { background: var(--mint); }
  .fm-tally li.is-mid { background: var(--sky); }
  .fm-tally li.is-low { background: var(--lilac); }

  /* The sheet: a white page with its ruling printed in, framed in ink. */
  .fm-pad {
    position: relative; aspect-ratio: 200 / 140;
    border: 2px solid var(--ink); border-radius: var(--r-lg); overflow: hidden;
    /* The fallback when there is no WebGL2: eight ruled lines, as a proportion
       of the height, so it rules the sheet exactly as the shader does. */
    background:
      repeating-linear-gradient(0deg, transparent 0 calc(12.5% - 1px), var(--paper2) calc(12.5% - 1px) 12.5%),
      var(--card);
  }
  .fm-pad[hidden] { display: none; }
  .fm-sheet { position: absolute; inset: 0; z-index: 0; }
  .fm-sheet .gl-surface { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .fm-pad canvas { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
  .fm-ref, .fm-compare svg, .fm-shot-ref {
    fill: none; stroke: var(--t-cobalt); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; color: var(--t-cobalt);
  }
  .fm-ref { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; pointer-events: none; }

  .fm-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .fm-compare[hidden] { display: none; }
  .fm-compare figure { margin: 0; min-width: 0; display: grid; gap: 8px; }
  .fm-compare img, .fm-compare svg { display: block; width: 100%; aspect-ratio: 200 / 140; background: var(--card); border: 2px solid var(--ink); border-radius: var(--r); }
  @media (max-width: 480px) { .fm-compare { grid-template-columns: minmax(0, 1fr); } }

  .fm-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .fm-tools[hidden] { display: none; }
  .fm-reveal { margin-left: auto; }

  /* The verdict: one block, its colour the band, the word always written. */
  .fm-verdict { display: grid; gap: 10px; justify-items: start; padding: 22px; border-radius: var(--r-lg); color: var(--ink); background: var(--lilac); box-shadow: var(--shadow-block); outline: none; }
  .fm-verdict[hidden] { display: none; }
  .fm-verdict.is-high { background: var(--mint); }
  .fm-verdict.is-mid { background: var(--sky); }
  .fm-score { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .fm-score .num { font-size: clamp(56px, 7vw, 88px); }
  .fm-word { font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 600; font-style: italic; font-size: var(--fs-h3); letter-spacing: -0.02em; }
  .fm-why { font-weight: 600; max-width: 42ch; }
  .fm-fact { font-size: 15px; line-height: 1.5; max-width: 46ch; }
  .fm-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .fm-status { font-size: 13px; font-weight: 600; }
