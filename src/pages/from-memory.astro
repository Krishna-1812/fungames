---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * From Memory — draw an everyday object, then compare against the real shape.
 *
 * Deliberately uses ordinary objects rather than brand logos: it avoids
 * reproducing trademarks, and the effect is stronger anyway. Almost nobody can
 * draw a working bicycle, which is a genuine documented phenomenon.
 *
 * Sixteen prompts in data/memory.ts, ten per sitting, bicycle always first.
 * Reference shapes are hand-authored SVG in a shared 200×140 viewBox so the
 * overlay lines up with the canvas exactly — scripts/check-memory.mjs parses
 * every coordinate and checks they really do stay inside it, which is not
 * something you can see by reading a path.
 */

---

<GameLayout slug="from-memory" bar="#3b1338" bodyClass="mem-body">
  <div class="wrap">
    <header class="head">
      <h1>From Memory</h1>
      <p class="lede">No looking. Draw it, then find out what it actually looks like.</p>
    </header>

    <div class="dots" id="dots" aria-hidden="true"></div>

    <section class="card" id="card">
      <div class="tag"><span id="tag">1 of 10</span></div>
      <h2 id="prompt">—</h2>

      <div class="pad">
        <div class="sheet" id="sheet" aria-hidden="true"></div>
        <canvas id="pad" aria-label="Drawing area"></canvas>
        <svg
          class="ref" id="ref" viewBox="0 0 200 140" aria-hidden="true" hidden
        ></svg>
      </div>

      <div class="tools">
        <button type="button" id="undoBtn" class="ghost">Undo</button>
        <button type="button" id="clearBtn" class="ghost">Clear</button>
        <button type="button" id="revealBtn" class="primary">Reveal</button>
        <button type="button" id="nextBtn" class="primary" hidden>Next →</button>
      </div>

      <p class="fact" id="fact" hidden></p>
    </section>

    <section class="gallery" id="gallery" hidden>
      <h2>Everything you drew</h2>
      <div class="shelf" id="shelf"></div>
      <div class="gallery-actions">
        <button type="button" data-share data-title="From Memory">Share</button>
        <button type="button" id="againBtn" class="ghost">Draw ten more</button>
      </div>
    </section>
  </div>
</GameLayout>

  <script>
  import { burst } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { pickRound } from '../data/memory'
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { PAPER_FRAG } from '../lib/memo-paper'
  import { InkSurface, Nib, nibWidth, renderStrokes, REF_W, REF_H } from '../lib/memo-ink'
  import { Reveal } from '../lib/memo-reveal'

  /* Ten of the sixteen, freshly drawn each visit, with the bicycle always
     first. A pool bigger than the sitting is the difference between a thing you
     do once and a thing you can hand to somebody else afterwards. */
  let ROUND = pickRound()

  const el = (id) => document.getElementById(id)
  const pad = el('pad')
  const ref = el('ref')
  const dots = el('dots')

  let i = 0
  /* Strokes are lists of {x, y, w} in the 200x140 reference space the answers
     are drawn in, not in canvas pixels. That is what lets the same stroke be
     re-rendered into the pad at whatever size the layout gives it and into the
     gallery at thumbnail size, both sharp. */
  let strokes = []
  let drawing = null
  let revealed = false
  const saved = []       // data URLs, one per item

  const ink = new InkSurface(pad)
  const reveal = new Reveal(ref)

  // Paper. Never animates: still: true is one frame on mount and one per
  // resize. A drawing surface that shimmers would be intolerable.
  new ShaderSurface(document.getElementById('sheet'), PAPER_FRAG, { still: true })

  let dotEls = []
  function buildDots() {
    dots.replaceChildren(...ROUND.map(() => {
      const d = document.createElement('span'); d.className = 'dot'; return d
    }))
    dotEls = [...dots.children]
  }
  buildDots()

  /** Rebuild the whole sheet. Only for undo, clear and resize. */
  function rebuild() {
    ink.replay(strokes)
    ink.blit()
  }

  /** Pointer position in reference units. */
  function pos(e) {
    const r = pad.getBoundingClientRect()
    return {
      x: ((e.clientX - r.left) / r.width) * REF_W,
      y: ((e.clientY - r.top) / r.height) * REF_H,
    }
  }

  let nib = null
  let lastT = 0
  let lastW = 0

  /** One pointer sample: work out the nib width, hand it to the pen. */
  function extend(e, at) {
    const q = pos(e)
    const prev = drawing[drawing.length - 1]
    const dist = Math.hypot(q.x - prev.x, q.y - prev.y)
    // Samples that land on top of each other carry no shape and only cost fill.
    // A resting hand produces a lot of them.
    if (dist < 0.12) return
    const w = nibWidth(dist, at - lastT, lastW, e.pressure)
    lastT = at
    lastW = w
    const pt = { x: q.x, y: q.y, w }
    drawing.push(pt)
    nib.push(pt)
  }

  pad.addEventListener('pointerdown', (e) => {
    if (revealed) return
    try { pad.setPointerCapture(e.pointerId) } catch {}
    unlock(); sfx.tick()
    const q = pos(e)
    lastT = e.timeStamp
    const pt = { x: q.x, y: q.y, w: nibWidth(0, 0, 0, e.pressure) }
    lastW = pt.w
    drawing = [pt]
    strokes.push(drawing)
    nib = new Nib(ink)
    nib.push(pt)
    ink.blit()
    e.preventDefault()
  })

  pad.addEventListener('pointermove', (e) => {
    if (!drawing) return
    /* Coalesced events are the samples the browser collected since the last
       frame and would otherwise throw away. A pen reports far faster than the
       display refreshes, and taking only the delivered event throws most of a
       stylus stroke on the floor. */
    const raw = e.getCoalescedEvents ? e.getCoalescedEvents() : []
    if (raw.length) for (const c of raw) extend(c, c.timeStamp)
    else extend(e, e.timeStamp)
    ink.blit()
  })

  /* No pointerleave here on purpose. The pointer is captured, so up and cancel
     still arrive when the hand goes outside the pad — and the old listener
     meant that drawing off the edge of the paper and back cut the stroke in
     two, which is not what happens with a pen. */
  const end = () => {
    if (!drawing) return
    drawing = null
    nib.end()
    nib = null
    ink.commit()
    ink.blit()
  }
  pad.addEventListener('pointerup', end)
  pad.addEventListener('pointercancel', end)

  el('undoBtn').addEventListener('click', () => { strokes.pop(); rebuild() })
  el('clearBtn').addEventListener('click', () => { strokes = []; rebuild() })

  function render() {
    const it = ROUND[i]
    el('tag').textContent = `${i + 1} of ${ROUND.length}`
    el('prompt').textContent = it.prompt
    strokes = []
    drawing = null
    nib = null
    revealed = false
    ink.resize()
    rebuild()
    reveal.stop()
    ref.hidden = true
    ref.innerHTML = ''
    el('fact').hidden = true
    el('revealBtn').hidden = false
    el('nextBtn').hidden = true
    el('undoBtn').disabled = false
    el('clearBtn').disabled = false
    dotEls.forEach((d, k) => d.classList.toggle('done', k < i))
  }

  el('revealBtn').addEventListener('click', (e) => {
    unlock(); sfx.sparkle()
    const r = (e.currentTarget as HTMLElement).getBoundingClientRect()
    burst(r.left + r.width / 2, r.top, {
      count: 18, colors: ['#e0629b', '#fff', '#ffd166'], speed: 4, gravity: 0.14, life: 40, size: 3,
    })
    const it = ROUND[i]
    revealed = true
    end()
    // Rendered from the stroke list rather than grabbed off the pad, so the
    // gallery is sharp whatever size the pad happened to be.
    saved[i] = renderStrokes(strokes, 300).toDataURL('image/png')
    ref.hidden = false
    reveal.play(it.svg, prefersReducedMotion)
    el('fact').textContent = it.fact
    el('fact').hidden = false
    el('revealBtn').hidden = true
    el('nextBtn').hidden = false
    el('undoBtn').disabled = true
    el('clearBtn').disabled = true
    el('nextBtn').focus({ preventScroll: true })
  })

  el('nextBtn').addEventListener('click', () => {
    unlock(); sfx.click()
    i++
    if (i < ROUND.length) return render()
    showGallery()
  })

  function showGallery() {
    el('card').hidden = true
    dots.hidden = true
    const shelf = el('shelf')
    shelf.replaceChildren(
      ...ROUND.map((it, k) => {
        const fig = document.createElement('figure')
        fig.className = 'shot'
        /* Both layers, the way the pad showed them. The shelf used to be eight
           pictures of your own wrong drawings with nothing to compare them to,
           which threw away the only thing the game had told you. */
        const box = document.createElement('div')
        box.className = 'shot-pad'
        const img = document.createElement('img')
        img.src = saved[k] || ''
        img.alt = `Your drawing of ${it.prompt.toLowerCase()}`
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
        svg.setAttribute('viewBox', '0 0 200 140')
        svg.setAttribute('aria-hidden', 'true')
        svg.setAttribute('class', 'shot-ref')
        svg.innerHTML = it.svg
        box.append(img, svg)
        const cap = document.createElement('figcaption')
        cap.textContent = it.reveal
        fig.append(box, cap)
        return fig
      })
    )
    el('gallery').hidden = false
    el('gallery').scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  el('againBtn').addEventListener('click', () => {
    // A fresh ten out of the sixteen, not the same ten again — otherwise the
    // pool may as well not exist.
    ROUND = pickRound()
    i = 0
    saved.length = 0
    buildDots()
    el('card').hidden = false
    dots.hidden = false
    el('gallery').hidden = true
    render()
    el('card').scrollIntoView({ behavior: 'smooth', block: 'center' })
  })

  // The backing store follows the element's real size, so a reflow — a
  // rotation, a font landing, the card growing when the fact appears — has to
  // resize and replay. Assigning canvas.width is what clears it.
  new ResizeObserver(() => { if (ink.resize()) rebuild() }).observe(pad)

  render()
</script>

<style>
  :global(.mem-body) { background: #fdf3f8; }

  .wrap { max-width: 700px; margin: 0 auto; padding: 44px 22px 80px; }
  .head { text-align: center; margin-bottom: 22px; }
  .head h1 { font-size: clamp(34px, 6vw, 52px); }
  .lede { color: var(--ink-soft); margin: 10px auto 0; max-width: 40ch; }

  .dots { display: flex; justify-content: center; gap: 6px; margin-bottom: 16px; }
  .dots :global(.dot) { width: 7px; height: 7px; border-radius: 50%; background: #f0d5e3; }
  .dots :global(.dot.done) { background: #e0629b; }

  .card {
    background: #fff; border: 1px solid #f2d9e6; border-radius: var(--radius-lg);
    padding: 22px 20px 20px; box-shadow: var(--shadow);
  }
  .tag { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #b8497d; font-weight: 600; }
  .card h2 { font-size: clamp(22px, 4vw, 30px); margin: 6px 0 14px; }

  .pad {
    position: relative; aspect-ratio: 200 / 140;
    border: 1px solid #f0d5e3; border-radius: 14px; overflow: hidden;
    /* A sheet resting on the card rather than an empty slot cut into it. The
       dashed outline it had reads as a dropzone waiting for a file. */
    box-shadow: 0 1px 0 #fff inset, 0 2px 6px rgba(59, 19, 56, 0.06);
    /* The fallback when there is no WebGL2, and the ruling the page has always
       had in its stylesheet and never once shown: the layer order was wrong,
       and in CSS the first background layer paints on top.
       Eight lines, as a proportion of the height, so the fallback and the
       shader rule the sheet identically at every size. */
    background:
      repeating-linear-gradient(0deg,
        transparent 0 calc(12.5% - 1px), #fbeaf2 calc(12.5% - 1px) 12.5%),
      #fdf7fa;
  }
  .sheet { position: absolute; inset: 0; z-index: 0; }
  .sheet :global(.gl-surface) {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
  }
  canvas {
    position: absolute; inset: 0; z-index: 1;
    width: 100%; height: 100%; touch-action: none; cursor: crosshair;
  }
  .ref {
    position: absolute; inset: 0; z-index: 2;
    width: 100%; height: 100%;
    pointer-events: none;
    fill: none; stroke: #c9346f; stroke-width: 2.4;
    stroke-linecap: round; stroke-linejoin: round;
    color: #c9346f;
  }
  @keyframes fadeIn { from { opacity: 0; } }

  .tools { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .tools button {
    border-radius: 999px; padding: 10px 20px; font-weight: 600; font-size: 14.5px;
    cursor: pointer; border: 0; transition: filter 140ms var(--ease), transform 180ms var(--ease-bounce);
  }
  .tools button:hover:not(:disabled) { transform: translateY(-2px) scale(1.04); filter: brightness(1.05); }
  .tools button:active:not(:disabled) { transform: scale(0.95); }
  .tools button:disabled { cursor: default; }
  .ghost:disabled { color: #6f6b78; border-color: #f5e3ed !important; }
  .primary { background: #3b1338; color: #fff; margin-left: auto; }
  .ghost { background: #fff; border: 1px solid #edcfe0 !important; color: var(--ink); }

  .fact {
    margin: 14px 0 0; padding-top: 14px; border-top: 1px dashed #f2d9e6;
    color: #5b4453; font-size: 15px; text-wrap: pretty;
    animation: fadeIn 320ms var(--ease);
  }

  .gallery {
    background: #fff; border: 1px solid #f2d9e6; border-radius: var(--radius-lg);
    padding: 26px 22px; margin-top: 20px; box-shadow: var(--shadow);
  }
  .gallery h2 { font-size: 26px; text-align: center; }
  .shelf {
    display: grid; gap: 12px; margin-top: 18px;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .shelf :global(.shot) { margin: 0; }
  /* The paper, the attempt and the answer, stacked as they were on the pad. */
  .shelf :global(.shot-pad) {
    position: relative; aspect-ratio: 200/140; overflow: hidden;
    border: 1px solid #f2d9e6; border-radius: 10px;
    background:
      repeating-linear-gradient(0deg,
        transparent 0 calc(12.5% - 1px), #fbeaf2 calc(12.5% - 1px) 12.5%),
      #fdf7fa;
  }
  .shelf :global(.shot-pad img) {
    display: block; position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .shelf :global(.shot-ref) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    fill: none; stroke: #c9346f; stroke-width: 2.4;
    stroke-linecap: round; stroke-linejoin: round;
    color: #c9346f;
  }
  .shelf :global(figcaption) { font-size: 12.5px; color: var(--ink-soft); margin-top: 5px; text-align: center; }
  .gallery-actions { display: flex; gap: 10px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
  .gallery-actions button {
    border: 0; border-radius: 999px; padding: 11px 24px; font-weight: 600;
    cursor: pointer; background: #3b1338; color: #fff;
    transition: transform 180ms var(--ease-bounce);
  }
  .gallery-actions button:hover { transform: translateY(-2px) scale(1.04); }
  .gallery-actions button:active { transform: scale(0.95); }
  .gallery-actions .ghost { background: #fff; border: 1px solid #edcfe0 !important; color: var(--ink); }
</style>
