---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * From Memory — draw an everyday object, then compare against the real shape.
 *
 * Deliberately uses ordinary objects rather than brand logos: it avoids
 * reproducing trademarks, and the effect is stronger anyway. Almost nobody can
 * draw a working bicycle, which is a genuine documented phenomenon.
 *
 * Reference shapes are hand-authored SVG in a shared 200×140 viewBox so the
 * overlay lines up with the canvas exactly.
 */

type Item = { id: string; prompt: string; reveal: string; fact: string; svg: string }

const ITEMS: Item[] = [
  {
    id: 'bicycle',
    prompt: 'A bicycle',
    reveal: 'A bicycle',
    fact: 'In a study of 376 people, most drew a frame that could not physically work — usually the chain or the front fork.',
    svg: `<circle cx="46" cy="100" r="30"/><circle cx="154" cy="100" r="30"/>
          <path d="M46 100 L82 54 L128 54 L154 100 M82 54 L110 100 L154 100"/>
          <path d="M82 54 L74 40 M63 38 L85 38"/>
          <path d="M128 54 L136 39 M126 36 L150 36"/>
          <circle cx="110" cy="100" r="6"/>`,
  },
  {
    id: 'clock',
    prompt: 'A clock face showing twenty to four',
    reveal: 'Twenty to four',
    fact: 'Most people draw the hour hand pointing exactly at the 3. At 3:40 it has already moved two thirds of the way to the 4.',
    svg: `<circle cx="100" cy="70" r="54"/>
          <path d="M100 22 v8 M148 70 h-8 M100 118 v-8 M52 70 h8"/>
          <path d="M100 70 L133 82" stroke-width="4"/>
          <path d="M100 70 L61 93"/>
          <circle cx="100" cy="70" r="3.5" fill="currentColor"/>`,
  },
  {
    id: 'dipper',
    prompt: 'The Big Dipper',
    reveal: 'The Big Dipper',
    fact: 'Seven stars. The two at the end of the bowl point almost exactly at Polaris.',
    svg: `<circle cx="32" cy="96" r="4" fill="currentColor"/><circle cx="66" cy="106" r="4" fill="currentColor"/>
          <circle cx="100" cy="100" r="4" fill="currentColor"/><circle cx="124" cy="78" r="4" fill="currentColor"/>
          <circle cx="150" cy="60" r="4" fill="currentColor"/><circle cx="152" cy="30" r="4" fill="currentColor"/>
          <circle cx="118" cy="34" r="4" fill="currentColor"/>
          <path d="M32 96 L66 106 L100 100 L124 78 L150 60 L152 30 L118 34 L124 78" stroke-dasharray="3 4"/>`,
  },
  {
    id: 'key',
    prompt: 'A house key',
    reveal: 'A house key',
    fact: 'The teeth go on one edge only, and the bow is usually much larger than people remember.',
    svg: `<circle cx="48" cy="70" r="22"/><circle cx="48" cy="70" r="9"/>
          <path d="M70 70 H160"/>
          <path d="M120 70 v16 M134 70 v20 M148 70 v14"/>`,
  },
  {
    id: 'umbrella',
    prompt: 'An open umbrella',
    reveal: 'An open umbrella',
    fact: 'The canopy is made of scalloped panels, and the handle almost always curves the wrong way in drawings.',
    svg: `<path d="M22 78 A78 78 0 0 1 178 78"/>
          <path d="M22 78 q19 22 39 0 q19 22 39 0 q19 22 39 0 q19 22 39 0"/>
          <path d="M100 78 V116 a14 14 0 0 0 28 0"/>
          <path d="M100 78 V16"/>`,
  },
  {
    id: 'bulb',
    prompt: 'A light bulb',
    reveal: 'A light bulb',
    fact: 'The screw thread is a spiral, not a stack of rings, and the glass narrows into a neck before it starts.',
    svg: `<path d="M100 16 a38 38 0 0 1 22 68 q-6 5 -6 12 h-32 q0 -7 -6 -12 a38 38 0 0 1 22 -68 Z"/>
          <path d="M84 100 h32 M84 108 h32 M88 116 h24"/>
          <path d="M92 84 q8 -18 16 0" stroke-dasharray="3 3"/>`,
  },
  {
    id: 'boat',
    prompt: 'A sailboat',
    reveal: 'A sailboat',
    fact: 'Two sails: a large one behind the mast and a smaller triangle in front of it.',
    svg: `<path d="M34 104 h132 l-18 22 H52 Z"/>
          <path d="M100 100 V16"/>
          <path d="M104 96 V26 L150 96 Z"/>
          <path d="M96 96 V30 L58 96 Z"/>`,
  },
  {
    id: 'peace',
    prompt: 'The peace symbol',
    reveal: 'The peace symbol',
    fact: 'The two lower strokes go down and outwards. Drawing them as a Y pointing up is the most common mistake.',
    svg: `<circle cx="100" cy="70" r="54"/>
          <path d="M100 16 V124 M100 70 L62 108 M100 70 L138 108"/>`,
  },
]
---

<GameLayout slug="from-memory" bar="#3b1338" bodyClass="mem-body">
  <div class="wrap">
    <header class="head">
      <h1>From Memory</h1>
      <p class="lede">No looking. Draw it, then find out what it actually looks like.</p>
    </header>

    <div class="dots" id="dots" aria-hidden="true"></div>

    <section class="card" id="card">
      <div class="tag"><span id="tag">1 of 8</span></div>
      <h2 id="prompt">—</h2>

      <div class="pad">
        <canvas id="pad" width="800" height="560" aria-label="Drawing area"></canvas>
        <svg
          class="ref" id="ref" viewBox="0 0 200 140" aria-hidden="true" hidden
        ></svg>
      </div>

      <div class="tools">
        <button type="button" id="undoBtn" class="ghost">Undo</button>
        <button type="button" id="clearBtn" class="ghost">Clear</button>
        <button type="button" id="revealBtn" class="primary">Reveal</button>
        <button type="button" id="nextBtn" class="primary" hidden>Next →</button>
      </div>

      <p class="fact" id="fact" hidden></p>
    </section>

    <section class="gallery" id="gallery" hidden>
      <h2>Everything you drew</h2>
      <div class="shelf" id="shelf"></div>
      <div class="gallery-actions">
        <button type="button" data-share data-title="From Memory">Share</button>
        <button type="button" id="againBtn" class="ghost">Draw them again</button>
      </div>
    </section>
  </div>
</GameLayout>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ ITEMS })} />

  <script>
  import { burst } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
    const { ITEMS } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  const el = (id) => document.getElementById(id)
  const pad = el('pad')
  const ctx = pad.getContext('2d')
  const ref = el('ref')
  const dots = el('dots')

  let i = 0
  let strokes = []       // array of arrays of {x,y} in canvas space
  let drawing = null
  let revealed = false
  const saved = []       // data URLs, one per item

  dots.replaceChildren(...ITEMS.map(() => {
    const d = document.createElement('span'); d.className = 'dot'; return d
  }))
  const dotEls = [...dots.children]

  function fit() {
    // Backing store is fixed at 800×560 (the 200×140 reference, ×4), so the
    // overlay always lines up no matter how the canvas is displayed.
    const r = pad.getBoundingClientRect()
    pad.dataset.sx = String(800 / r.width)
    pad.dataset.sy = String(560 / r.height)
  }

  function redraw() {
    ctx.clearRect(0, 0, 800, 560)
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'
    ctx.lineWidth = 5
    ctx.strokeStyle = '#2a1026'
    for (const s of strokes) {
      if (s.length < 2) {
        if (s.length === 1) {
          ctx.beginPath(); ctx.arc(s[0].x, s[0].y, 2.5, 0, Math.PI * 2)
          ctx.fillStyle = '#2a1026'; ctx.fill()
        }
        continue
      }
      ctx.beginPath()
      ctx.moveTo(s[0].x, s[0].y)
      for (let k = 1; k < s.length; k++) ctx.lineTo(s[k].x, s[k].y)
      ctx.stroke()
    }
  }

  function pos(e) {
    const r = pad.getBoundingClientRect()
    return { x: (e.clientX - r.left) * (800 / r.width), y: (e.clientY - r.top) * (560 / r.height) }
  }

  pad.addEventListener('pointerdown', (e) => {
    if (revealed) return
    try { pad.setPointerCapture(e.pointerId) } catch {}
    unlock(); sfx.tick()
    drawing = [pos(e)]
    strokes.push(drawing)
    redraw()
    e.preventDefault()
  })
  pad.addEventListener('pointermove', (e) => {
    if (!drawing) return
    drawing.push(pos(e))
    redraw()
  })
  const end = () => { drawing = null }
  pad.addEventListener('pointerup', end)
  pad.addEventListener('pointercancel', end)
  pad.addEventListener('pointerleave', end)

  el('undoBtn').addEventListener('click', () => { strokes.pop(); redraw() })
  el('clearBtn').addEventListener('click', () => { strokes = []; redraw() })

  function render() {
    const it = ITEMS[i]
    el('tag').textContent = `${i + 1} of ${ITEMS.length}`
    el('prompt').textContent = it.prompt
    strokes = []
    revealed = false
    redraw()
    ref.hidden = true
    ref.innerHTML = ''
    el('fact').hidden = true
    el('revealBtn').hidden = false
    el('nextBtn').hidden = true
    el('undoBtn').disabled = false
    el('clearBtn').disabled = false
    dotEls.forEach((d, k) => d.classList.toggle('done', k < i))
    fit()
  }

  el('revealBtn').addEventListener('click', (e) => {
    unlock(); sfx.sparkle()
    const r = (e.currentTarget as HTMLElement).getBoundingClientRect()
    burst(r.left + r.width / 2, r.top, {
      count: 18, colors: ['#e0629b', '#fff', '#ffd166'], speed: 4, gravity: 0.14, life: 40, size: 3,
    })
    const it = ITEMS[i]
    revealed = true
    saved[i] = pad.toDataURL('image/png')
    ref.innerHTML = it.svg
    ref.hidden = false
    el('fact').textContent = it.fact
    el('fact').hidden = false
    el('revealBtn').hidden = true
    el('nextBtn').hidden = false
    el('undoBtn').disabled = true
    el('clearBtn').disabled = true
    el('nextBtn').focus({ preventScroll: true })
  })

  el('nextBtn').addEventListener('click', () => {
    unlock(); sfx.click()
    i++
    if (i < ITEMS.length) return render()
    showGallery()
  })

  function showGallery() {
    el('card').hidden = true
    dots.hidden = true
    const shelf = el('shelf')
    shelf.replaceChildren(
      ...ITEMS.map((it, k) => {
        const fig = document.createElement('figure')
        fig.className = 'shot'
        const img = document.createElement('img')
        img.src = saved[k] || ''
        img.alt = `Your drawing of ${it.prompt.toLowerCase()}`
        const cap = document.createElement('figcaption')
        cap.textContent = it.reveal
        fig.append(img, cap)
        return fig
      })
    )
    el('gallery').hidden = false
    el('gallery').scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  el('againBtn').addEventListener('click', () => {
    i = 0
    el('card').hidden = false
    dots.hidden = false
    el('gallery').hidden = true
    render()
    el('card').scrollIntoView({ behavior: 'smooth', block: 'center' })
  })

  addEventListener('resize', fit)
  render()
</script>

<style>
  :global(.mem-body) { background: #fdf3f8; }

  .wrap { max-width: 700px; margin: 0 auto; padding: 44px 22px 80px; }
  .head { text-align: center; margin-bottom: 22px; }
  .head h1 { font-size: clamp(34px, 6vw, 52px); }
  .lede { color: var(--ink-soft); margin: 10px auto 0; max-width: 40ch; }

  .dots { display: flex; justify-content: center; gap: 6px; margin-bottom: 16px; }
  .dots :global(.dot) { width: 7px; height: 7px; border-radius: 50%; background: #f0d5e3; }
  .dots :global(.dot.done) { background: #e0629b; }

  .card {
    background: #fff; border: 1px solid #f2d9e6; border-radius: var(--radius-lg);
    padding: 22px 20px 20px; box-shadow: var(--shadow);
  }
  .tag { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #b8497d; font-weight: 600; }
  .card h2 { font-size: clamp(22px, 4vw, 30px); margin: 6px 0 14px; }

  .pad {
    position: relative; aspect-ratio: 200 / 140;
    border: 2px dashed #f0d5e3; border-radius: 14px; overflow: hidden;
    background:
      linear-gradient(#fdf7fa 0 0) padding-box,
      repeating-linear-gradient(0deg, transparent 0 23px, #fbeaf2 23px 24px);
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
  .ref {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
    fill: none; stroke: #e0629b; stroke-width: 2.4;
    stroke-linecap: round; stroke-linejoin: round;
    color: #e0629b;
    animation: fadeIn 380ms var(--ease);
  }
  @keyframes fadeIn { from { opacity: 0; } }

  .tools { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .tools button {
    border-radius: 999px; padding: 10px 20px; font-weight: 600; font-size: 14.5px;
    cursor: pointer; border: 0; transition: filter 140ms var(--ease), transform 140ms var(--ease);
  }
  .tools button:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.05); }
  .tools button:disabled { cursor: default; }
  .ghost:disabled { color: #6f6b78; border-color: #f5e3ed !important; }
  .primary { background: #3b1338; color: #fff; margin-left: auto; }
  .ghost { background: #fff; border: 1px solid #edcfe0 !important; color: var(--ink); }

  .fact {
    margin: 14px 0 0; padding-top: 14px; border-top: 1px dashed #f2d9e6;
    color: #5b4453; font-size: 15px; text-wrap: pretty;
    animation: fadeIn 320ms var(--ease);
  }

  .gallery {
    background: #fff; border: 1px solid #f2d9e6; border-radius: var(--radius-lg);
    padding: 26px 22px; margin-top: 20px; box-shadow: var(--shadow);
  }
  .gallery h2 { font-size: 26px; text-align: center; }
  .shelf {
    display: grid; gap: 12px; margin-top: 18px;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .shelf :global(.shot) { margin: 0; }
  .shelf :global(img) {
    display: block; width: 100%; aspect-ratio: 200/140;
    border: 1px solid #f2d9e6; border-radius: 10px; background: #fdf7fa;
  }
  .shelf :global(figcaption) { font-size: 12.5px; color: var(--ink-soft); margin-top: 5px; text-align: center; }
  .gallery-actions { display: flex; gap: 10px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
  .gallery-actions button {
    border: 0; border-radius: 999px; padding: 11px 24px; font-weight: 600;
    cursor: pointer; background: #3b1338; color: #fff;
  }
  .gallery-actions .ghost { background: #fff; border: 1px solid #edcfe0 !important; color: var(--ink); }
</style>
