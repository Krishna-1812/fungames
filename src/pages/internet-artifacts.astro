  .hud-fill { height: 100%; width: 0; background: #fff; border-radius: 2px; transition: background 300ms linear; }

  .intro { position: relative; min-height: 74vh; display: grid; place-content: center; text-align: center; gap: 14px; padding: 40px 20px; overflow: hidden; }

  /* A quiet scatter of 0s and 1s behind the title — the climb's own
