  }
  .intro h1 .cursor { color: #7cfc8a; -webkit-text-stroke: 0; animation: cursor-blink 1s steps(1, end) infinite; }
  @keyframes cursor-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes title-pop { from { opacity: 0; transform: scale(0.7) rotate(-3deg); } }
  /* A brief CRT-glitch pulse every few seconds — a couple of frames of
     colour-split jitter, not a constant effect, the same restraint the
     flicker on `.scanlines` uses. */
  @keyframes title-glitch {
    0%, 97%, 100% { transform: translate(0, 0); filter: none; }
    97.6% { transform: translate(-2px, 1px); filter: hue-rotate(25deg); }
    98.2% { transform: translate(2px, -1px); filter: hue-rotate(-25deg); }
