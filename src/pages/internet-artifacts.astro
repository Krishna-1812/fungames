  /* Cut-outs, same contract as Deep Sea and Space Elevator: the drawing is
     the element, not an icon pinned above a text column — it fills the
     card's own width, learned first-time here rather than fixed after
     shipping. */
  .ev {
    position: absolute; left: 50%; transform: translateX(-50%); z-index: 2;
    width: min(88vw, 480px);
    display: grid; justify-items: center;
    gap: 12px; text-align: center;
    --moodRgb: 234, 243, 255;
  }
  .ev.lane-left { left: 50%; transform: translateX(-104%); width: min(44vw, 320px); }
  .ev.lane-right { left: 50%; transform: translateX(4%); width: min(44vw, 320px); }
  .ev.lane-left h2, .ev.lane-right h2 { font-size: 18px; }
  .ev.lane-left p, .ev.lane-right p { font-size: 13.5px; }

  .ev-art {
    width: min(100%, 260px); aspect-ratio: 1 / 1;
    filter:
      drop-shadow(0 0 20px rgba(var(--moodRgb), 0.55))
      drop-shadow(0 0 56px rgba(var(--moodRgb), 0.32));
    animation: ev-drift 12s ease-in-out infinite;
    animation-delay: var(--drift, 0s);
  }
  @keyframes ev-drift {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(0.6deg); }
  }
  .ev-art svg { display: block; width: 100%; height: 100%; }

  .ev.big { width: min(92vw, 560px); }
  .ev.big h2 { font-size: 27px; }
  .ev.big .ev-art { width: min(100%, 340px); filter: drop-shadow(0 0 26px rgba(var(--moodRgb), 0.7)) drop-shadow(0 0 74px rgba(var(--moodRgb), 0.42)); }
  .ev.lane-left.big h2, .ev.lane-right.big h2 { font-size: 19px; }

  @keyframes seen-pulse {
    0%   { filter: drop-shadow(0 0 8px rgba(var(--moodRgb), 0.3)); }
    45%  { filter: drop-shadow(0 0 30px rgba(var(--moodRgb), 1)) drop-shadow(0 0 70px rgba(var(--moodRgb), 0.75)); }
    100% { filter: drop-shadow(0 0 16px rgba(var(--moodRgb), 0.65)) drop-shadow(0 0 50px rgba(var(--moodRgb), 0.4)); }
  }
  .ev.big.focused .ev-art { animation: seen-pulse 820ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }

  .ev.compact p { display: none; }
  .ev.compact { width: min(46vw, 220px); }
  .ev.compact .ev-art { width: 64px; }
  /* A turning point stays visually a little heavier than the trivia next to
     it even when the cluster forces it to compact — the same reasoning as
     `.ev.big`'s own larger glow, just surviving the squeeze. */
  .ev.big.compact { width: min(52vw, 260px); }
  .ev.big.compact .ev-art { width: 96px; }
  .ev.compact-hard .ev-when { display: none; }
  .ev.compact-hard .ev-art { display: none; }
  @media (max-width: 620px) {
    .ev { width: min(92vw, 360px); }
    .ev.lane-left, .ev.lane-right { width: min(48vw, 240px); }
    .ev.big { width: min(94vw, 400px); }
  }
  .ev-when {
    font-family: var(--mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;
    opacity: 0.85; font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.85);
  }
  .ev-when::before { content: '// '; opacity: 0.6; }
  .ev h2 {
    font-size: 21px; margin: 4px 0 0; font-weight: 700;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.9), 0 0 26px rgb(0 0 0 / 0.65);
  }
  .ev p {
    margin: 6px 0 0; opacity: 0.88; font-size: 14.5px; max-width: 42ch;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.9), 0 0 22px rgb(0 0 0 / 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .ev.big.focused .ev-art { animation: none; }
    .ev-art { animation: none; }
    .ev { transition: none; }
    .arrow { animation: none; }
  }

  .seam { position: absolute; left: 0; right: 0; z-index: 1; text-align: center; padding-top: 8px; }
  .seam::before {
    content: ''; position: absolute; left: 9%; right: 9%; top: 0; height: 2px; border-radius: 2px;
    background: linear-gradient(90deg, var(--from), var(--to)); opacity: 0.65;
  }
  .seam-bubble {
    position: relative; display: inline-block; margin-top: 16px;
    background: #fff; color: #1a2233;
    border: 2px solid #1a2233; border-radius: 18px;
    padding: 10px 18px 11px; max-width: min(84vw, 420px);
    box-shadow: 0 5px 0 rgba(0, 0, 0, 0.2);
  }
  .seam-bubble::after {
    content: ''; position: absolute; left: 50%; top: -8px; margin-left: -8px;
    width: 14px; height: 14px; background: #fff;
    border-left: 2px solid #1a2233; border-top: 2px solid #1a2233;
    border-radius: 3px 0 0 0; transform: rotate(45deg);
  }
  .seam-name { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: #5a6478; display: block; }
  .seam-note { font-size: 13.5px; opacity: 0.92; margin-top: 4px; display: block; }

  .finale { max-width: 640px; margin: 10vh auto 0; padding: 0 22px 8vh; text-align: left; }
  .fin-kicker { font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #7cfc8a; opacity: 0.9; margin: 0 0 12px; font-weight: 600; }
  .finale h2 { font-size: clamp(24px, 4vw, 32px); margin: 0 0 18px; letter-spacing: -0.02em; }
  .finale p { font-size: 16px; line-height: 1.7; opacity: 0.85; margin: 0 0 16px; }
  .finale em { color: #7cfc8a; font-style: normal; }
  .finale strong { color: #ffd27a; }
  .fin-closer { opacity: 0.95; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.1); }

  .outro { padding: 6vh 20px 16vh; text-align: center; }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: center; margin-bottom: 20px; }
  .acts button {
    appearance: none; border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.06);
    color: inherit; padding: 10px 18px; border-radius: 999px; cursor: pointer; font-size: 14px; font-weight: 600;
  }
  .acts button:first-child { background: linear-gradient(165deg, #a8ffb4, #7cfc8a); color: #03110a; border: 0; }
  .acts a { color: inherit; opacity: 0.7; font-size: 14px; text-decoration: none; }
  .acts a:hover { opacity: 1; }
  .outro-line { font-size: 15px; opacity: 0.6; margin: 0; }
</style>

