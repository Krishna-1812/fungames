  .glyphfield { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .glyphfield span {
    position: absolute; font-family: var(--mono, 'JetBrains Mono', ui-monospace, monospace);
    font-weight: 600; animation: glyph-drift linear infinite;
    text-shadow: 0 0 10px currentColor;
  }
  @keyframes glyph-drift {
    0% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
    100% { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro-glyphs span, .glyphfield span { animation: none; }
  }

  .rail-track { position: absolute; top: 0; left: 26px; width: 12px; height: 0; z-index: 1; pointer-events: none; }
  .rail-line {
    position: absolute; left: 50%; top: 0; bottom: 0; width: 2.4px; transform: translateX(-50%);
    background: linear-gradient(rgba(124, 252, 138, 0.5), rgba(124, 252, 138, 0.08));
  }
  .rail-dot {
    position: absolute; left: 50%; top: 0; transform: translate(-50%, -50%);
    width: 10px; height: 10px; border-radius: 2px;
    background: #7cfc8a; box-shadow: 0 0 12px 2px rgba(124, 252, 138, 0.75);
    transition: top 60ms linear;
    animation: rail-blink 1s steps(1, end) infinite;
  }
  @keyframes rail-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.35; } }
  @media (max-width: 460px) {
