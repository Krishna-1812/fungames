---
import GameShell from '../layouts/GameShell.astro'
import { ZONES, MARKERS } from '../data/internet-artifacts'
import type { Marker } from '../data/internet-artifacts'
import { INTERNET_ARTIFACTS_ART, MOOD, sceneSvg } from '../lib/internet-artifacts-art'
import { digitCellHTML } from '../lib/seven-segment'

/**
 * Internet Artifacts — a linear scroll from the first message ever sent
 * between two computers (1969) to Nyan Cat (2011), twenty-five real, dated
 * moments in the order they actually happened.
 *
 * Same shape as `space-elevator.astro`, running the ordinary direction this
 * time: oldest at the top, scrolling down moves forward through time. `d` is
 * plain distance-from-the-start in pixels; `TOP_PAD`/`BOTTOM_PAD` give the
 * intro and the finale real breathing room the same way `REEL_TAIL` did on
 * Space Elevator, learned from the bug that page shipped with — a card's own
 * height, once art fills the card instead of sitting in a corner of it, can
 * be taller than the gap between it and the next section, and needs a real
 * buffer rather than however much space happens to be left over.
 *
 * In the shell it follows Space Elevator: the sky and the scanlines are a
 * sticky backdrop inside the stage, the year gauge rides on a zero-height
 * sticky pin, and widths are measured against the stage (cqw) rather than the
 * window. Score is the year you have scrolled to, Era which of the five, and
 * Moments how many of the twenty-five you have passed; each era announces
 * itself as you enter it, and scrolling past Nyan Cat is the ending. Restart
 * scrolls back to 1969.
 */

let cursor = 0
const zones = ZONES.map((z) => {
  const height = Math.round((z.to - z.from) * z.pxPerYear)
  const laid = { ...z, height, offset: cursor }
  cursor += height
  return laid
})
const totalHeight = cursor
const TOP_PAD = 480
const BOTTOM_PAD = 420
const reelHeight = TOP_PAD + totalHeight + BOTTOM_PAD

const toReelTop = (d: number) => TOP_PAD + d

/** Real year -> d-space (distance from the timeline's start, px). */
function yearToD(year: number) {
  const zone = zones.find((z) => year >= z.from && year <= z.to) ?? zones[zones.length - 1]
  return zone.offset + Math.round((year - zone.from) * zone.pxPerYear)
}

const CARD_H = 96
type Placed = ReturnType<typeof at> & { lane: 'center' | 'left' | 'right' }
function at(m: Marker) {
  return { ...m, top: toReelTop(yearToD(m.year)) }
}

// MARKERS is already ascending by year (checked), and so is top after at() —
// no reversal needed, unlike Space Elevator's inverted coordinate space.
const rough = MARKERS.map(at)
const placed: Placed[] = []
for (let i = 0; i < rough.length; ) {
  let j = i + 1
  while (j < rough.length && rough[j].top < rough[j - 1].top + CARD_H) j++
  const group = rough.slice(i, j)
  if (group.length === 1) {
    placed.push({ ...group[0], lane: 'center' })
  } else {
    group.forEach((g, k) => placed.push({ ...g, lane: k % 2 === 0 ? 'left' : 'right' }))
  }
  i = j
}

const rgb = (hex: string) =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ')

const HUD_DIGITS = 4

// A drifting field of characters behind the whole climb — the one thing
// that kept the long stretches between markers (and the deliberate blank
// buffers either end) reading as an empty void rather than a page with an
// idea running through it. Each character is drawn from its own era's
// vocabulary (binary for ARPANET, angle brackets once the Web exists,
// currency once commerce does) and tinted with that era's own sky colour,
// so the field itself tells the same story the seams do.
const GLYPH_SETS: Record<string, string[]> = {
  arpanet: ['0', '1'],
  'early-internet': ['0', '1', '#'],
  'world-wide-web': ['<', '>', '/'],
  'dot-com': ['$', '%', '*'],
  'web-two': ['@', '#', '~'],
}
// A zone's own `sky` tones are close enough to the page background itself
// (the two are the same gradient) that text drawn in them nearly vanishes —
// this needs a colour that actually reads as glowing against that sky, not
// the sky's own colour restated.
const GLYPH_COLOR: Record<string, string> = {
  arpanet: '#7cfc8a',
  'early-internet': '#8fb8ff',
  'world-wide-web': '#6ee7ff',
  'dot-com': '#c9a8ff',
  'web-two': '#ff8fd6',
}
const glyphRnd = (seed: number, k: number) => {
  const x = Math.sin(seed * 12.9898 + k * 78.233) * 43758.5453
  return x - Math.floor(x)
}
const GLYPH_COUNT = 170
const glyphs = Array.from({ length: GLYPH_COUNT }, (_, i) => {
  const top = glyphRnd(7, i) * reelHeight
  const d = top - TOP_PAD
  const zone = zones.find((z) => d >= z.offset && d < z.offset + z.height) ?? (d < 0 ? zones[0] : zones[zones.length - 1])
  const set = GLYPH_SETS[zone.id] ?? ['0', '1']
  const ch = set[Math.floor(glyphRnd(7, i + 1000) * set.length)]
  return {
    top: top.toFixed(0),
    x: (glyphRnd(7, i + 2000) * 100).toFixed(1),
    ch,
    color: GLYPH_COLOR[zone.id] ?? '#7cfc8a',
    size: (11 + glyphRnd(7, i + 3000) * 11).toFixed(1),
    op: (0.10 + glyphRnd(7, i + 4000) * 0.26).toFixed(2),
    dur: (7 + glyphRnd(7, i + 5000) * 11).toFixed(1),
    delay: (-glyphRnd(7, i + 6000) * 14).toFixed(1),
  }
})
// A smaller, always-green scatter just for the intro screen — the climb's
// glyph field doesn't reach up into `.intro`, and the opening screen was
// otherwise a flat gradient behind the title.
const introGlyphs = Array.from({ length: 22 }, (_, i) => ({
  x: (glyphRnd(11, i) * 100).toFixed(1),
  y: (glyphRnd(11, i + 500) * 100).toFixed(1),
  ch: ['0', '1'][Math.floor(glyphRnd(11, i + 900) * 2)],
  size: (12 + glyphRnd(11, i + 1300) * 12).toFixed(1),
  op: (0.10 + glyphRnd(11, i + 1700) * 0.22).toFixed(2),
  dur: (8 + glyphRnd(11, i + 2100) * 10).toFixed(1),
  delay: (-glyphRnd(11, i + 2500) * 12).toFixed(1),
}))
---

<GameShell
  slug="internet-artifacts"
  labels={{ score: 'Year', best: 'Furthest', level: 'Era', moves: 'Moments' }}
  initial={{ score: String(ZONES[0].from), level: `1 / ${ZONES.length}`, moves: `0 / ${MARKERS.length}` }}
>
  <div class="ia" id="iaRoot">
  {/* The sky, pinned while the timeline scrolls past it. */}
  <div class="ia-back" aria-hidden="true">
    <div class="sky" id="sky"></div>
    <div class="scanlines"></div>
  </div>

  <div class="ia-hud-pin">
  <div class="hud-scrim" aria-hidden="true"></div>
  <div class="hud" id="hud">
    <button type="button" class="hud-dial" id="dialToggle" aria-pressed="false" aria-label="Play dial-up modem sound">
      <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M4 8a6 6 0 0 1 12 0v6a1.5 1.5 0 0 1-3 0v-5a3 3 0 0 0-6 0v5a1.5 1.5 0 0 1-3 0Z" fill="currentColor"/></svg>
    </button>
    <div class="hud-label" id="hudZone">the arpanet era</div>
    <div class="hud-year-row">
      <span class="odometer" id="hudYear" set:html={Array.from({ length: HUD_DIGITS }, () => digitCellHTML()).join('')} />
    </div>
    <div class="hud-bar"><div class="hud-fill" id="hudFill"></div></div>
  </div>
  </div>

  <div class="climb">
    <div class="rail-track" id="railTrack" aria-hidden="true">
      <div class="rail-line"></div>
      <div class="rail-dot" id="railDot"></div>
    </div>

    <div class="intro">
      <div class="intro-glyphs" aria-hidden="true">
        {introGlyphs.map((g) => (
          <span style={`left:${g.x}%;top:${g.y}%;font-size:${g.size}px;opacity:${g.op};animation-duration:${g.dur}s;animation-delay:${g.delay}s`}>{g.ch}</span>
        ))}
      </div>
      <div class="intro-title">
        <p class="boot-line">&gt; RUN INTERNET_ARTIFACTS.EXE_</p>
        {/* The shell already names the page; this is the boot screen's art. */}
        <p class="intro-name" aria-hidden="true">Internet Artifacts<span class="cursor">_</span></p>
      </div>
      <p>Twenty-five real, dated moments from the internet's own history — from the first message ever sent between two computers to a cat made of Pop-Tart.</p>
      <div class="arrow">&#8595;</div>
      <p class="scroll-hint">Scroll down!</p>
    </div>

    <div class="reel" style={`height:${reelHeight}px`}>
    <div class="glyphfield" aria-hidden="true">
      {glyphs.map((g) => (
        <span style={`left:${g.x}%;top:${g.top}px;font-size:${g.size}px;color:${g.color};opacity:${g.op};animation-duration:${g.dur}s;animation-delay:${g.delay}s`}>{g.ch}</span>
      ))}
    </div>
    {
      zones.map((z, i) =>
        i === 0 ? null : (
          <div class="seam" style={`top:${toReelTop(z.offset)}px;--from:${zones[i - 1].sky[1]};--to:${z.sky[0]}`}>
            <div class="seam-bubble">
              <span class="seam-name">{z.label}</span>
              <span class="seam-note">
                {z.from} to {z.to} — {z.note}
              </span>
            </div>
          </div>
        )
      )
    }
    {
      placed.map((m) => {
        const mood = MOOD[m.title]
        const drift = `--drift:${-((Math.round(m.year * 1000) * 7919) % 1100) / 100}s`
        const style = mood
          ? `top:${m.top}px;--mood:${mood};--moodRgb:${rgb(mood)};${drift}`
          : `top:${m.top}px;${drift}`
        return (
          <article class:list={['ev', `lane-${m.lane}`, { big: m.big }]} style={style}>
            {INTERNET_ARTIFACTS_ART[m.title] && <div class="ev-art" set:html={sceneSvg(m.title)} />}
            <div class="ev-text">
              <div class="ev-when">{m.date}</div>
              <h2>{m.title}</h2>
              <p>{m.note}</p>
            </div>
          </article>
        )
      })
    }
    </div>

    <section class="finale">
      <p class="fin-kicker">Past Nyan Cat</p>
      <h2>Twenty-five moments, out of an uncountable number</h2>
      <p>
        This list could have been four times as long — almost every entry
        here has ten more almost as good sitting just outside it. What made
        the cut is what is <em>well documented</em>: a source better than
        "everyone on the internet remembers it happening," a date more
        people agree on than not. A few entries above say so directly —
        nobody, including Ray Tomlinson himself, ever recorded which day in
        1971 he sent the first network email.
      </p>
      <p>
        The gaps between entries get shorter as the list goes on, and that
        is not nostalgia talking. Fourteen years separate the first ARPANET
        message from the network finally agreeing on one protocol. Four
        years later there is a Web to put a photograph on. By the time
        Rickrolling has a name, it took about a year to go from "one 4chan
        post" to "cliché." Culture has been compressing for over fifty
        years, and there is no real sign it has finished.
      </p>
      <p class="fin-closer">
        This page stops in 2011 on purpose. Everything since is still being
        argued over by people who watched it happen — which is exactly the
        kind of dispute a page built on "the note says so, not silently"
        tries to stay out of.
      </p>
    </section>

    <footer class="outro">
      <p class="outro-line">Twenty-five real dates, fifty years, one cat made of Pop-Tart.</p>
    </footer>
  </div>
  </div>

  <Fragment slot="howto">
    <p>
      Twenty-five real, dated moments from the internet's own history, in the
      order they happened: from the first message ever sent between two
      computers, in 1969, to Nyan Cat.
    </p>
    <ul>
      <li>Scroll down to move forward in time. The gauge at the top reads the year.</li>
      <li>Time is not to scale across the whole page: each era has its own pace, and the bubbles mark where one ends and the next begins.</li>
      <li>The handset button on the gauge plays a dial-up modem, if you have the sound on.</li>
    </ul>
    <p>Scroll past Nyan Cat, in 2011, to finish.</p>
  </Fragment>
</GameShell>

<script type="application/json" id="game-data" set:html={JSON.stringify({ zones, totalHeight, reelHeight, TOP_PAD, BOTTOM_PAD })} />

<script>
  import { ring } from '../lib/fx'
  import { sfx, unlock, tone } from '../lib/audio'
  import { segmentsFor, fitWidth } from '../lib/seven-segment'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { recordPlay } from '../lib/stats'
  import { SITE } from '../site.config'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'

  const { zones, totalHeight, reelHeight, TOP_PAD, BOTTOM_PAD } = JSON.parse(
    document.getElementById('game-data')!.textContent!,
  ) as any

  const cards = [...document.querySelectorAll('.ev')] as HTMLElement[]

  function relayout() {
    const measure = (lane: string) => {
      for (const el of cards) {
        el.classList.remove('lane-center', 'lane-left', 'lane-right', 'compact', 'compact-hard')
        el.classList.add(lane)
      }
      return cards.map((el) => el.offsetHeight)
    }
    const wide = measure('lane-center')
    const narrow = measure('lane-left')

    const GROUP_GAP = 8
    const boxes = cards.map((el, i) => ({
      el, top: el.offsetTop, h: Math.max(wide[i], narrow[i]) + GROUP_GAP,
    }))

    const groups: typeof boxes[] = []
    for (let i = 0; i < boxes.length; ) {
      let j = i + 1
      while (j < boxes.length && boxes[j].top < boxes[j - 1].top + boxes[j - 1].h) j++
      groups.push(boxes.slice(i, j))
      i = j
    }

    for (const group of groups) {
      if (group.length === 1) {
        group[0].el.classList.remove('lane-left')
        group[0].el.classList.add('lane-center')
        continue
      }
      const TIERS = ['', 'compact', 'compact-hard']
      for (let attempt = 0; attempt < TIERS.length; attempt++) {
        const bottom = { left: -Infinity, right: -Infinity }
        let clash = false
        for (const b of group) {
          const h = b.el.offsetHeight
          const GAP = 10
          let lane =
            bottom.left + GAP <= b.top ? 'left' : bottom.right + GAP <= b.top ? 'right' : null
          if (!lane) {
            clash = true
            lane = bottom.left <= bottom.right ? 'left' : 'right'
          }
          b.el.classList.remove('lane-left', 'lane-right')
          b.el.classList.add('lane-' + lane)
          bottom[lane as 'left' | 'right'] = b.top + h
        }
        if (!clash) break
        const next = TIERS[attempt + 1]
        if (next) for (const b of group) b.el.classList.add(next)
      }
    }
    dodgeSeams()
  }

  // An era's note hangs where the era begins, which is often exactly where a
  // moment from that year is too (the first emoticon, ARPANET's flag day). The
  // line marking the boundary stays put; the note drops to the nearest gap
  // between moments below it, or rises to one above if there is none.
  const seamNotes = [...document.querySelectorAll('.seam-bubble')] as HTMLElement[]
  function dodgeSeams() {
    const taken = cards.map((el) => [el.offsetTop - 16, el.offsetTop + el.offsetHeight + 16])
    for (const b of seamNotes) {
      b.style.transform = ''
      b.classList.remove('is-moved')
      const y0 = b.parentElement!.offsetTop + b.offsetTop, h = b.offsetHeight
      const free = (dy: number) => taken.every(([a, z]) => y0 + dy + h <= a || y0 + dy >= z)
      let dy = 0
      if (!free(0)) {
        dy = NaN
        for (let d = 6; d <= 1200 && Number.isNaN(dy); d += 6) if (free(d)) dy = d
        for (let d = 6; d <= 600 && Number.isNaN(dy); d += 6) if (free(-d)) dy = -d
        if (Number.isNaN(dy)) dy = 0
      }
      if (dy) { b.style.transform = `translateY(${dy}px)`; b.classList.add('is-moved') }
    }
  }
  relayout()

  let chimeStep = 0
  const bigCards = cards.filter((c) => c.classList.contains('big'))
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          io.unobserve(e.target)
          sfx.blip(chimeStep++)
          const r = e.target.getBoundingClientRect()
          ring(r.left + r.width / 2, r.top + r.height / 2, 'rgba(255,255,255,0.5)', 20)
          e.target.classList.add('focused')
        }
      },
      { rootMargin: '-42% 0px -42% 0px' },
    )
    bigCards.forEach((c) => io.observe(c))
  }
  addEventListener('pointerdown', unlock, { once: true })
  addEventListener('scroll', unlock, { once: true, passive: true })

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const sky = $('sky')
  const hud = $('hud')
  const hudZone = $('hudZone')
  const hudFill = $('hudFill')
  const railDot = document.getElementById('railDot')
  const railTrack = document.getElementById('railTrack')
  const introEl = document.querySelector('.intro') as HTMLElement
  const reel = document.querySelector('.reel') as HTMLElement

  const yearDigits = [...$('hudYear').children] as HTMLElement[]
  const prefersReducedMotion = !PLAY
  function setYear(year: number) {
    const raw = fitWidth(String(Math.max(0, Math.round(year))), yearDigits.length)
    for (let i = 0; i < yearDigits.length; i++) {
      const cell = yearDigits[i]
      const ch = raw[i]
      if (cell.dataset.v === ch) continue
      const changed = cell.dataset.v !== undefined
      cell.dataset.v = ch
      const lit = segmentsFor(ch)
      const segs = cell.children
      for (let s = 0; s < lit.length; s++) segs[s]!.classList.toggle('on', lit[s])
      if (changed && !prefersReducedMotion) {
        cell.classList.remove('flicker')
        void cell.offsetWidth
        cell.classList.add('flicker')
      }
    }
  }

  function sizeTrack() {
    if (railTrack) railTrack.style.height = `${reelHeight + introEl.offsetHeight}px`
  }
  sizeTrack()

  // `.reel`'s document position is not fixed — `.intro` precedes it and has
  // a responsive height — so it is measured fresh inside `update()` itself
  // rather than cached. Space Elevator's own comment on this exact function
  // explains why a cached value goes stale: reflow anywhere above the reel
  // (a webfont swap in the finale's long paragraphs, here too) shifts it.
  function reelTopAbs() {
    return reel.getBoundingClientRect().top + window.scrollY
  }

  // ---- dial-up modem sound -----------------------------------------------
  // A little handshake warble via the shared tone() synth, looped while on —
  // the actual sound a 1990s modem made trying to connect, roughly.
  const dialBtn = document.getElementById('dialToggle')
  let dialOn = false
  let dialTried = false
  let dialTimer: number | null = null
  const DIAL_FREQS = [1200, 2100, 1600, 2400, 1800, 1400]
  function dialTick() {
    DIAL_FREQS.forEach((f, i) =>
      tone({ freq: f, dur: 0.13, type: 'square', gain: 0.045, delay: i * 0.1, filter: 3200 }),
    )
  }
  dialBtn?.addEventListener('click', () => {
    unlock()
    dialOn = !dialOn
    if (dialOn && !dialTried) { dialTried = true; shell.pick('Dial-up modem switched on', true) }
    dialBtn.setAttribute('aria-pressed', String(dialOn))
    dialBtn.classList.toggle('on', dialOn)
    if (dialOn) {
      dialTick()
      dialTimer = window.setInterval(dialTick, 900)
    } else if (dialTimer !== null) {
      clearInterval(dialTimer)
      dialTimer = null
    }
  })

  const mix = (a: string, b: string, t: number) => {
    const p = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16))
    const [r1, g1, b1] = p(a); const [r2, g2, b2] = p(b)
    const c = (x: number, y: number) => Math.round(x + (y - x) * t)
    return `rgb(${c(r1, r2)},${c(g1, g2)},${c(b1, b2)})`
  }

  let shareCard: import('../lib/result-card').ResultCard | null = null

  /* ---- the shell ------------------------------------------------------------ */
  let recorded = false
  /* Set by Restart. The ending re-arms only once the page is back in the first
     half: the ride up starts at the far end, and re-arming at once let the
     first frame of it end the piece again. */
  let rearm = false
  let highestZone = 0
  let seenMost = 0
  let yearTold = 0
  const passed = new Set<HTMLElement>()
  const root = $('iaRoot')
  const shell = createShell({
    slug: 'internet-artifacts',
    // Back to 1969 rather than a reload.
    onRestart: () => {
      rearm = true
      highestZone = 0
      scrollTo({ top: root.getBoundingClientRect().top + scrollY - 12, behavior: PLAY ? 'smooth' : 'auto' })
    },
  })

  /* The strip rolls its digits, so it is told once the scroll settles; the
     gauge on the sky is the live one. */
  let stripT = 0
  let at = { year: zones[0].from, zoneIdx: 0 }
  function paintStrip() {
    const y = Math.round(at.year)
    shell.setScore(String(y))
    shell.setLevel(`${at.zoneIdx + 1} / ${zones.length}`)
    shell.setMoves(`${seenMost} / ${cards.length}`)
    if (y > zones[0].from) shell.considerBest(y, String(y))
  }

  /** Nyan Cat is the ending. The card waits under the finale, which is still
      to be read on the way down to it. */
  function finish(year: number) {
    const y = Math.round(year)
    shell.win({
      celebrate: false,
      scroll: false,
      // The timeline runs on past the last entry, to the end of its last era.
      kicker: 'Past Nyan Cat',
      title: `${y - zones[0].from} years of the internet.`,
      score: String(y),
      from: String(zones[0].from),
      lines: [
        `${cards.length} real, dated moments, from the first message between two computers to a cat made of Pop-Tart.`,
        'The gaps between them kept getting shorter.',
      ],
      againLabel: `Back to ${zones[0].from}`,
    })
    shell.resultExtra.innerHTML =
      '<div class="ia-report-acts"><button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share this</span></button></div>'
    $('shareBtn').addEventListener('click', async (e) => {
      if (!shareCard) return
      const label = (e.currentTarget as HTMLElement).querySelector('span')!
      const outcome = await shareResult(shareCard, { title: 'Internet Artifacts', text: `${shareCard.headline}.`, url: location.href })
      label.textContent = outcomeLabel[outcome]
      setTimeout(() => (label.textContent = 'Share this'), 1600)
    })
  }
  function updateShareCard(year: number) {
    shareCard = {
      slug: 'internet-artifacts',
      siteName: SITE.name,
      headline: `Scrolled all the way to ${Math.round(year)}`,
      sub: 'Twenty-five real, dated moments from the internet’s own history',
      stats: [
        { label: 'Year reached', value: String(Math.round(year)) },
        { label: 'Years covered', value: `${Math.round(year) - zones[0].from}` },
      ],
    }
    recordPlay('internet-artifacts', { yearReached: Math.round(year) }, { yearReached: 'high' })
    finish(year)
  }

  let ticking = false
  function update() {
    ticking = false
    const raw = window.scrollY + window.innerHeight / 2 - reelTopAbs()
    const topInReel = Math.max(0, Math.min(reelHeight, raw))
    const d = Math.max(0, Math.min(totalHeight, topInReel - TOP_PAD))

    const zone = zones.find((z: any) => d < z.offset + z.height) ?? zones[zones.length - 1]
    const within = d - zone.offset
    const year = Math.max(zone.from, Math.min(zone.to, zone.from + within / zone.pxPerYear))

    hud.classList.toggle('visible', d > 40)
    hudZone.textContent = zone.label.toLowerCase()
    setYear(year)

    if (railDot) railDot.style.top = `${topInReel}px`

    hudFill.style.width = `${(d / totalHeight) * 100}%`
    const zt = zone.height ? Math.min(1, Math.max(0, within / zone.height)) : 0
    const zoneColor = mix(zone.sky[0], zone.sky[1], zt)
    hudFill.style.background = zoneColor
    hud.style.setProperty('--glow', `rgba(${zoneColor.slice(4, -1)}, 0.4)`)
    sky.style.background = `linear-gradient(${zoneColor}, ${mix(zone.sky[0], zone.sky[1], Math.min(1, zt + 0.25))})`

    const zoneIdx = zones.indexOf(zone)
    // Each era announces itself the first time you scroll into it.
    if (zoneIdx > highestZone) {
      highestZone = zoneIdx
      shell.levelUp(zone.label)
      shell.pick('Era reached', zone.label)
    }
    // Where people stop: the latest whole year reached, and each artifact once per visit.
    if (Math.floor(year) > yearTold) shell.progress(yearTold = Math.floor(year))
    let seen = 0
    for (const c of cards) if (c.offsetTop <= topInReel) {
      seen++
      if (!passed.has(c)) { passed.add(c); shell.pick('Artifact reached', c.querySelector('h2')!.textContent!) }
    }
    if (seen > seenMost) seenMost = seen
    at = { year, zoneIdx }
    clearTimeout(stripT)
    stripT = window.setTimeout(paintStrip, 180)

    if (rearm && d < totalHeight / 2) { rearm = false; recorded = false }
    if (!recorded && d >= totalHeight - 40) {
      recorded = true
      updateShareCard(year)
    }
  }

  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update) }
  }, { passive: true })
  addEventListener('resize', () => { relayout(); sizeTrack(); update() }, { passive: true })
  update()

</script>

<style>
  /* The timeline fills the stage edge to edge. overflow: clip rather than
