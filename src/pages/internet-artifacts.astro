  @keyframes cursor-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes title-pop { from { opacity: 0; transform: scale(0.7) rotate(-3deg); } }
  /* A brief CRT-glitch pulse every few seconds — a couple of frames of
