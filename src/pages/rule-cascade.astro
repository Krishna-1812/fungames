            <path d="M58 30 C58 8, 122 8, 122 30" fill="none" stroke="url(#rcClipWire)" stroke-width="6" stroke-linecap="round" />
            <!-- the plate, its rolled front edge and the jaw biting the paper -->
            <path d="M14 26 H166 a8 8 0 0 1 8 8 V44 Q90 54 6 44 V34 a8 8 0 0 1 8 -8Z" fill="url(#rcClipPlate)" stroke="#5b6474" stroke-width="1" />
            <path d="M12 44 Q90 54 168 44" fill="none" stroke="#ffffff" stroke-opacity="0.7" stroke-width="1.4" />
            <circle cx="34" cy="35" r="4.2" fill="url(#rcRivet)" stroke="#4d5665" stroke-width="0.7" />
            <circle cx="146" cy="35" r="4.2" fill="url(#rcRivet)" stroke="#4d5665" stroke-width="0.7" />
          </svg>
        </span>

        <div class="rc-sheet" id="sheet">
          <header class="rc-letter">
            <span class="rc-seal" aria-hidden="true">
              <svg viewBox="0 0 40 40" width="40" height="40">
                <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.4" />
                <circle cx="20" cy="20" r="14.5" fill="none" stroke="currentColor" stroke-width="0.8" />
                <path d="M13 26 V17 L20 12 L27 17 V26 M11 26 H29 M16 26 V19 M20 26 V19 M24 26 V19" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="rc-org"><b>Registry of Usernames</b><small>Form U-1 · Application for a username</small></span>
            <span class="rc-ref">Step 1 of 1</span>
          </header>

          <h2 class="rc-title">Choose a <em class="wonk">username</em>.</h2>
          <p class="rc-sub">It should not take long.</p>

          <div class="rc-field" id="field">
            <label class="rc-label" for="input">Username <span>(block capitals not required)</span></label>
            <textarea
              id="input"
              rows="2"
              spellcheck="false"
              autocomplete="off"
              autocapitalize="off"
              placeholder="type something"></textarea>
            <div class="rc-meter">
              <span id="count">0 characters</span>
              <span id="score">0 / {total} rules</span>
            </div>
          </div>

          <div class="rc-office" id="office">
            <p class="rc-office-label">For office use only</p>
            <p class="rc-received" id="received" aria-hidden="true"><b>Received</b><span id="receivedAt"></span></p>
            <div class="rc-slip" id="slip" hidden>
              <i class="rc-staple" aria-hidden="true"></i>
              <span class="rc-slip-ink">Confiscated</span>
              <b id="slipLetter">E</b>
              <small>Not to be returned</small>
            </div>
            <div class="rc-accept" id="accept" hidden aria-hidden="true"><span>Accepted</span></div>
          </div>
        </div>
