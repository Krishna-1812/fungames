---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * Rule Cascade — you are just picking a username, and the requirements keep
 * arriving. Rules unlock one at a time and every previously-unlocked rule stays
 * live, so late rules routinely break early ones. All validation is client-side;
 * there is no server and nothing is ever sent anywhere.
 *
 * Thirty rules, three of which do something rather than just checking: a moth
 * that eats a character every six seconds, a sacrifice that takes one letter of
 * the alphabet away from you permanently, and a rule about how many rules are on
 * screen, which therefore moves every time you satisfy it.
 *
 * The rules themselves are in lib/cascade-rules.ts, because with this many
 * interlocking constraints "is it still possible to finish?" stopped being a
 * question anyone could answer by reading. scripts/check-cascade.mjs builds a
 * real solution for all 24 hours and all 26 possible sacrifices.
 */
---

<GameLayout slug="rule-cascade" bar="#0f3d2e">
  {/* The sheet this is all printed on. A real gradient stays behind it for
      anything without WebGL2. */}
  <div class="paper" id="paper" aria-hidden="true"></div>

  <div class="stage">
    <header class="head">
      <h1>Choose a username</h1>
      <p class="sub">It should not take long.</p>
    </header>

    <div class="field">
      <textarea
        id="input"
        rows="2"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        aria-label="Username"
        placeholder="type something"></textarea>
      <div class="meter">
        <span id="count">0 characters</span>
        <span id="score">0 / 30 rules</span>
      </div>
    </div>

    <ol class="rules" id="rules"></ol>

    {/* Changes only, and debounced. Putting aria-live on the list itself meant
        re-announcing every rule on every keystroke, which is unusable. */}
    <p class="visually-hidden" id="announce" role="status" aria-live="polite"></p>

    <div class="win" id="win" hidden>
      <h2>Fine. That is a username.</h2>
      <p id="winStat"></p>
      <button type="button" data-share data-title="Rule Cascade">Share this</button>
      <a href="/">try something else →</a>
    </div>
  </div>
</GameLayout>

<script>
  import { burst, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface } from '../lib/gl'
  import { PAPER_FRAG } from '../lib/cascade-paper'
  import { RULES, chars } from '../lib/cascade-rules'
  import { onShare } from '../lib/share-card'
  import { recordPlay } from '../lib/stats'
  import { SITE } from '../site.config'
  const input = document.getElementById('input')
  const list = document.getElementById('rules')
  const count = document.getElementById('count')
  const score = document.getElementById('score')
  const win = document.getElementById('win')
  const winStat = document.getElementById('winStat')

  /* The rules live in lib/cascade-rules.ts so scripts/check-cascade.mjs can prove
     the form is still fillable. With thirty interlocking constraints, a live
     clock and a letter taken away mid-game, that is not something anyone can
     check by reading it. */
  const ctx = { hour: new Date().getHours(), unlocked: 1, banned: null }

  let won = false

  /* The sheet. Its wear is a function of how many rules are live, so the paper
     picks up a crease for each one and the page you are reading gets very
     slightly more tired as the form drags on. */
  const paper = new ShaderSurface(document.getElementById('paper'), PAPER_FRAG, {
    // Nothing here has an edge; three-quarter resolution is free.
    scale: 0.75,
    uniforms: () => ({
      u_tension: ctx.unlocked / RULES.length,
      u_motion: prefersReducedMotion ? 0 : 1,
    }),
  })
  let paperDrawnAt = -1

  /* One node per rule, kept for the life of the page.

     It used to rebuild every <li> on every render. That replayed the entry
     animation on all of them for each character typed, and made the reordering
     a teleport rather than a move. Reconciling instead is what lets the cards
     animate to their new positions below. */
  const nodes = new Map()
  function nodeFor(r) {
    let li = nodes.get(r.id)
    if (li) return li
    li = document.createElement('li')
    li.dataset.id = String(r.id)
    li.innerHTML =
      '<span class="mark" aria-hidden="true">' +
        '<svg class="glyph" viewBox="0 0 16 16">' +
          '<path class="tick" d="M3.2 8.4 L6.6 11.8 L12.8 4.6"/>' +
          '<path class="cross" d="M4.4 4.4 L11.6 11.6 M11.6 4.4 L4.4 11.6"/>' +
        '</svg>' +
      '</span>' +
      '<span class="body"><b>Rule ' + r.id + '</b>' +
        '<span class="visually-hidden state"></span><br>' +
        '<span class="text"></span></span>'
    nodes.set(r.id, li)
    return li
  }

  /* Announcements are batched: typing a username is a keystroke every 150ms or
     so, and a live region that fires on each one is noise, not help. */
  const announcer = document.getElementById('announce')
  let shareCard = null
  onShare(() => shareCard, () => ({
    title: 'Rule Cascade',
    text: 'I satisfied every last one of these rules.',
  }))

  const pending = []
  let announceT = 0
  function announce(msg) {
    pending.push(msg)
    clearTimeout(announceT)
    announceT = window.setTimeout(() => {
      announcer.textContent = pending.join(' ')
      pending.length = 0
    }, 700)
  }
  // Remembering which rules passed last frame is what lets us make a sound
  // only on the transition rather than on every keystroke.
  let passedBefore = new Set<number>()
  let keystrokes = 0
  const started = Date.now()

  function render() {
    const v = input.value

    const before = ctx.unlocked
    // A rule unlocks only once every rule before it has been satisfied at least
    // once — but unlocked rules never lock again, which is where the pain is.
    // One at a time, because the sacrifice has to fire the moment its own rule
    // arrives. Unlocking in a single sweep would step straight over it: rule 25
    // passes trivially while there is nothing banned yet.
    while (ctx.unlocked < RULES.length && RULES.slice(0, ctx.unlocked).every((r) => r.ok(v, ctx))) {
      ctx.unlocked++
      maybeSacrifice()
    }

    const active = RULES.slice(0, ctx.unlocked)
    const passingSet = new Set(active.filter((r) => r.ok(v, ctx)).map((r) => r.id))
    const passing = passingSet.size

    if (ctx.unlocked > before) {
      sfx.blip(Math.min(9, ctx.unlocked))
      for (let i = before; i < ctx.unlocked; i++) announce('New rule ' + RULES[i].id + '. ' + RULES[i].text(ctx))
    }
    for (const r of active) {
      if (passingSet.has(r.id) && !passedBefore.has(r.id)) { sfx.good(); announce('Rule ' + r.id + ' met.') }
      else if (!passingSet.has(r.id) && passedBefore.has(r.id)) { sfx.bad(); announce('Rule ' + r.id + ' no longer met.') }
    }
    passedBefore = passingSet

    // FLIP, part one: where every card sits before the DOM is touched.
    const firstTop = new Map()
    if (!prefersReducedMotion)
      for (const [id, li] of nodes) if (li.isConnected) firstTop.set(id, li.getBoundingClientRect().top)

    // Unmet rules first: the thing you have to fix should be at the top. Ties
    // break by id so the order is stable and cards do not swap for no reason.
    const order = active.slice().sort((a, b) =>
      (passingSet.has(a.id) ? 1 : 0) - (passingSet.has(b.id) ? 1 : 0) || a.id - b.id)

    for (const r of order) {
      const li = nodeFor(r)
      const done = passingSet.has(r.id)
      if (!li.isConnected) li.classList.add('enter')
      // Only assigned when it changes, so the tick redraws on a real transition
      // rather than on every keystroke.
      const cls = 'rule ' + (done ? 'ok' : 'bad') + (li.classList.contains('enter') ? ' enter' : '')
      if (li.className !== cls) li.className = cls
      const txt = r.text(ctx)
      const textEl = li.querySelector('.text')
      if (textEl.textContent !== txt) textEl.textContent = txt
      // The glyph is decorative, so the state needs saying somewhere real.
      const stateEl = li.querySelector('.state')
      const stateTxt = done ? ', met. ' : ', not met. '
      if (stateEl.textContent !== stateTxt) stateEl.textContent = stateTxt
      list.appendChild(li)   // appending a node already in the list moves it
    }

    /* FLIP, part two: measure where they landed, snap them back to where they
       were, then let CSS carry them across. A card that changes state travels
       to its new place instead of vanishing and reappearing somewhere else. */
    if (!prefersReducedMotion) {
      for (const [id, li] of nodes) {
        if (!li.isConnected) continue
        const was = firstTop.get(id)
        if (was === undefined) continue
        const dy = was - li.getBoundingClientRect().top
        if (Math.abs(dy) < 1) continue
        li.style.transition = 'none'
        li.style.transform = 'translateY(' + dy + 'px)'
        void li.offsetHeight        // flush, or the browser skips the invert
        li.style.transition = ''
        li.style.transform = ''
      }
    }

    count.textContent = `${chars(v).length} character${chars(v).length === 1 ? '' : 's'}`
    score.textContent = `${passing} / ${RULES.length} rules`

    const all = RULES.every((r) => r.ok(v, ctx))
    if (all && !won) {
      won = true
      const secs = Math.round((Date.now() - started) / 1000)
      winStat.textContent = `${keystrokes} keystrokes, ${Math.floor(secs / 60)}m ${secs % 60}s, and ${RULES.length} rules.`

      /* The password itself is the result, and it is also the one thing that
         must not go on a shareable picture: people reuse these. What the card
         carries is what it cost to arrive at one. */
      const stat = recordPlay(
        'rule-cascade',
        { keystrokes, seconds: secs, length: chars(v).length },
        { keystrokes: 'low', seconds: 'low' },
      )
      shareCard = {
        slug: 'rule-cascade',
        siteName: SITE.name,
        headline: `All ${RULES.length} rules`,
        sub:
          `${keystrokes.toLocaleString('en-US')} keystrokes for a ${chars(v).length}-character password ` +
          `that satisfies every rule at once.` +
          (stat.plays > 1 ? ` Attempt ${stat.plays}.` : ''),
        stats: [
          { label: 'Keystrokes', value: keystrokes.toLocaleString('en-US') },
          { label: 'Length', value: String(chars(v).length) },
          { label: 'Time', value: `${Math.floor(secs / 60)}m ${secs % 60}s` },
        ],
      }
      win.hidden = false
      sfx.great()
      for (let k = 0; k < 5; k++) {
        setTimeout(() => burst(innerWidth * (0.2 + Math.random() * 0.6), innerHeight * 0.3, {
          count: 18, colors: ['#5cb872', '#ffd166', '#fff'], speed: 6, gravity: 0.22, life: 60, size: 5, shape: 'square',
        }), k * 110)
      }
      win.scrollIntoView({ behavior: 'smooth', block: 'center' })
    } else if (!all) {
      won = false
      win.hidden = true
    }
  }

  // The sheet only changes when a rule unlocks, and under reduced motion the
  // shared ticker never runs, so it has to be asked for that one frame.
  function repaintPaper() {
    if (!prefersReducedMotion || paperDrawnAt === ctx.unlocked) return
    paperDrawnAt = ctx.unlocked
    paper.redraw()
  }

  /* ------------------------------------------------------------------ */
  /* The two rules that do something to you                              */
  /* ------------------------------------------------------------------ */

  const MOTH_RULE = RULES.find((r) => r.live === 'moth').id
  const SACRIFICE_RULE = RULES.find((r) => r.live === 'sacrifice').id

  /**
   * The moth eats one character every six seconds, from a random position,
   * until you put a spider in. It never eats the spider — a hazard you cannot
   * end is not a puzzle, it is a wall.
   */
  const MOTH_MS = 6000
  setInterval(() => {
    if (won) return
    if (ctx.unlocked < MOTH_RULE) return
    const rule = RULES[MOTH_RULE - 1]
    if (rule.ok(input.value, ctx)) return
    const a = chars(input.value)
    if (!a.length) return
    const edible = a.map((_, i) => i).filter((i) => a[i] !== '🕷')
    if (!edible.length) return
    const at = edible[(Math.random() * edible.length) | 0]
    const eaten = a[at]
    a.splice(at, 1)
    input.value = a.join('')
    sfx.bad()
    announce(`The moth ate a character: ${eaten}.`)
    render()
    repaintPaper()
  }, MOTH_MS)

  /**
   * The sacrifice fires once, the moment its rule appears, and takes whichever
   * letter you have leaned on hardest. It is read off what you have actually
   * typed, so it is personal, and it never comes back.
   */
  function maybeSacrifice() {
    if (ctx.banned || ctx.unlocked < SACRIFICE_RULE) return
    const counts = new Map<string, number>()
    for (const ch of input.value.toLowerCase())
      if (/[a-z]/.test(ch)) counts.set(ch, (counts.get(ch) ?? 0) + 1)
    if (!counts.size) return
    ctx.banned = [...counts.entries()].sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1))[0][0]
    announce(`The letter ${ctx.banned} has been taken away.`)
    sfx.thud()
  }

  input.addEventListener('input', () => { unlock(); keystrokes++; render(); repaintPaper() })
  // Rules 12 and 23 are live, so keep re-checking even when nobody is typing.
  setInterval(() => { ctx.hour = new Date().getHours(); render() }, 5000)
  render()
  repaintPaper()
  input.focus()
</script>

<!-- .rule list items are created in JS, and JS-created nodes do not get Astro's
     scoped-style attribute, so these rules must be global. -->
<style is:global>
  /* The still fallback, and what the shader is a small deviation from. */
  :global(body) { background: #f2f6f3; }
  .paper {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(120% 90% at 18% 2%, #fbfdfa 0%, transparent 58%),
      #f2f6f3;
  }
  .paper .gl-surface { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .stage { max-width: 640px; margin: 0 auto; padding: 42px 20px 96px; }
  .head { text-align: center; margin-bottom: 22px; }
  .head h1 { font-size: 34px; margin: 0; letter-spacing: -0.02em; }
  .sub { color: var(--ink-soft); margin: 6px 0 0; }

  .field {
    background: var(--card); border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden;
    position: sticky; top: 58px; z-index: 20;
  }
  textarea {
    width: 100%; border: 0; outline: 0; resize: none; display: block;
    padding: 16px; font-size: 22px; font-family: var(--mono);
    line-height: 1.4; background: transparent; color: var(--ink);
  }
  .meter {
    display: flex; justify-content: space-between;
    padding: 8px 16px; font-size: 12px; color: var(--ink-soft);
    border-top: 1px solid var(--line); background: #fafbfa;
    font-variant-numeric: tabular-nums;
  }

  .rules { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 10px; }
  .rule {
    display: flex; gap: 12px; align-items: flex-start;
    background: linear-gradient(178deg, #ffffff, #fbfbf9);
    border-radius: 12px; padding: 14px 16px;
    border-left: 4px solid; font-size: 16px;
    /* Layered rather than one blur: a tight contact shadow to sit the card on
       the page, and a wide soft one to lift it off. */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 1px 2px rgba(20, 18, 28, 0.05),
      0 8px 20px rgba(20, 18, 28, 0.06);
    transition:
      transform 280ms var(--ease), opacity 240ms var(--ease),
      box-shadow 240ms var(--ease), border-color 240ms var(--ease);
  }
  /* Only on a card that has genuinely just appeared. It used to run on every
     card on every keystroke, because every card was rebuilt every keystroke. */
  .rule.enter { animation: slide 240ms var(--ease); }
  @keyframes slide { from { opacity: 0; transform: translateY(-8px); } }
  /* A met rule sinks back toward the page: lower elevation, cooler card,
     quieter text.

     Deliberately not 'opacity'. That is what the page used to do, and it fades
     the white card along with the text -- which measured 4.12:1 against the
     4.5 AA needs, and, now that the sheet underneath has creases in it, let
     them show straight through the card. Muting the ink instead keeps the card
     opaque and lands at 6.44:1. */
  .rule.ok {
    border-color: #2f8a55;
    background: linear-gradient(178deg, #fcfcfb, #f7f7f5);
    box-shadow: 0 1px 2px rgba(20, 18, 28, 0.045);
    /* Plays once, the moment the class is actually applied — a rule flipping
       to satisfied is the one genuinely good feeling in this whole game and
       it was landing with zero acknowledgement beyond the tick itself. */
    animation: pop-rule 340ms var(--ease-bounce);
  }
  @keyframes pop-rule { 35% { transform: scale(1.018); } }
  .rule.ok .text { color: var(--ink-soft); }
  .rule.bad { border-color: #c2392a; }

  .mark { flex: none; line-height: 0; margin-top: 3px; }
  .glyph { width: 17px; height: 17px; display: block; }
  .glyph path { fill: none; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
  .rule.ok .cross, .rule.bad .tick { display: none; }
  .rule.bad .cross { stroke: #c2392a; }
  /* The tick draws itself, once, when the rule is actually satisfied. */
  .rule.ok .tick { stroke: #2f8a55; stroke-dasharray: 17; animation: draw 280ms var(--ease) both; }
  @keyframes draw { from { stroke-dashoffset: 17; } to { stroke-dashoffset: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .rule { transition: none; }
    .rule.enter { animation: none; }
    .rule.ok { animation: none; }
    .rule.ok .tick { animation: none; stroke-dasharray: none; }
  }
  .rule b { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }

  .win {
    margin-top: 26px; text-align: center; background: #0f3d2e; color: #fff;
    border-radius: var(--radius); padding: 30px 20px;
  }
  .win h2 { margin: 0 0 6px; font-size: 26px; }
  .win p { margin: 0 0 16px; opacity: 0.8; font-variant-numeric: tabular-nums; }
  .win button {
    background: #fff; color: #0f3d2e; border: 0; border-radius: 999px;
    padding: 10px 22px; font-weight: 600; cursor: pointer;
    transition: transform 180ms var(--ease-bounce);
  }
  .win button:hover { transform: translateY(-2px) scale(1.04); }
  .win button:active { transform: scale(0.95); }
  .win a { display: block; margin-top: 14px; opacity: 0.8; font-size: 15px; }
</style>
