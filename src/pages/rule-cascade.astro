      <div class="rc-side">
        <ol class="rc-tray" id="rules" aria-label="Rules"></ol>
        <div class="rc-pile-bar" id="pileBar" hidden>
          <button class="rc-fan" id="fan" type="button" aria-pressed="false">Spread the approved pile</button>
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="howto">
    <p>
      You are picking a username. Type it on the form. A rule card lands on the
      desk; satisfy it and the next one arrives — and every rule already on the
      desk <b>stays live</b>, so a late rule will often break an early one.
    </p>
    <ul>
      <li>Rules still to meet lie in a column, marked <b>Required</b>. Met ones are stamped <b>Approved</b> and go on the pile. If one stops being true it comes back off the pile.</li>
      <li>Spread the pile to read the approved cards again.</li>
      <li>Some rules act on you: a moth eats a character every few seconds until you give it a spider, and one rule takes a letter away for good.</li>
      <li>Everything is checked in your browser. Nothing you type is sent anywhere.</li>
    </ul>
    <p>Finish all {total}. Your best is the fewest keystrokes it took.</p>
  </Fragment>
</GameShell>

<script>
  import { createShell } from '../lib/game-shell'
  import { sfx, unlock, hit, tone } from '../lib/audio'
  import { WORLD_PLAY } from '../lib/motion'
  import { RULES, chars } from '../lib/cascade-rules'
  import { createDeck } from '../lib/cascade/deck'
  import { createMoth } from '../lib/cascade/moth'
  import { recordPlay } from '../lib/stats'
  import { dailyFor } from '../data/game-meta'
  import { loadCrowd, fillCrowd, standing, median, people } from '../lib/crowd'

  const TOTAL = RULES.length
  const input = document.getElementById('input') as HTMLTextAreaElement
  const list = document.getElementById('rules')!
  const count = document.getElementById('count')!
  const scoreEl = document.getElementById('score')!
  const fanBtn = document.getElementById('fan') as HTMLButtonElement
  const pileBar = document.getElementById('pileBar')!
  const board = document.getElementById('board')!
  const field = document.getElementById('field')!
  const desk = document.getElementById('desk')!

  const ctx = { hour: new Date().getHours(), unlocked: 1, banned: null as string | null }
  let won = false
  let keystrokes = 0
  let started = Date.now()
  let passedBefore = new Set<number>()
  const nodes = new Map<number, HTMLLIElement>()
  /** When each met rule was approved, so the newest sits on top of the pile. */
  const approved = new Map<number, number>()
  let stampSeq = 0

  /* ---- sounds of paper ---------------------------------------------- */
  const paper = {
    /** A card meeting the leather. */
    land: (hard: number) => hit({ dur: 0.05 + hard * 0.04, gain: 0.05 + hard * 0.12, freq: 700 + hard * 500, q: 0.7 }),
    /** A rubber stamp: the thump of the handle and the smack of the rubber. */
    stamp: () => { hit({ dur: 0.07, gain: 0.32, freq: 240, type: 'lowpass' }); hit({ dur: 0.03, gain: 0.16, freq: 2400, q: 1.4, delay: 0.005 }); tone({ freq: 110, to: 60, dur: 0.12, gain: 0.22 }) },
    /** A card snatched back off the pile. */
    snatch: () => hit({ dur: 0.16, gain: 0.12, freq: 1600, sweepTo: 600, q: 0.9 }),
  }

  const deck = createDeck({
    tray: list,
    animate: WORLD_PLAY,
    onLand: (_, hard) => { if (hard > 0.15) paper.land(hard) },
  })

  const shell = createShell({
    slug: 'rule-cascade',
    onRestart: restart,
    onPause: () => { pausedAt = Date.now() },
    onResume: () => { started += Date.now() - pausedAt; ruleAt += Date.now() - pausedAt; input.focus() },
  })
  let pausedAt = 0
  loadCrowd('rule-cascade')

  // For the crowd: how long each rule held people up, and how far they got.
  let ruleAt = Date.now(), slowest = { id: 0, s: -1 }, reached = 0
  function cleared(id: number) {
    const s = Math.round((Date.now() - ruleAt) / 1000)
    ruleAt = Date.now()
    shell.pick('Seconds to clear each rule', s, `Rule ${id}`)
    if (s > slowest.s) slowest = { id, s }
  }

  /* Best: most rules met at once, or — once finished — a finish with fewer
     keystrokes. A finish always outranks a non-finish. */
  const liveBest = (met: number) => met * 10_000
  const finishBest = (keys: number) => (TOTAL + 1) * 10_000 - keys

  function nodeFor(r: (typeof RULES)[number]) {
    let li = nodes.get(r.id)
    if (li) return li
    li = document.createElement('li')
    li.dataset.id = String(r.id)
    // The stamp is turned the way a hand turns it, a little differently each time.
    li.style.setProperty('--stamp-r', `${(-13 + ((r.id * 37) % 11)).toFixed(0)}deg`)
    li.innerHTML =
      '<span class="rc-shadow" aria-hidden="true"></span>' +
      '<span class="rc-face">' +
      '<span class="rc-head"><span class="rc-no">No. ' + r.id + '</span><span class="rc-req" aria-hidden="true">Required</span></span>' +
      '<span class="sr-only rc-state"></span>' +
      '<span class="rc-text"></span>' +
      '<span class="rc-stamp" aria-hidden="true"><span>Approved</span></span>' +
      '</span>'
    li.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') deck.lookAt(r.id) })
    li.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') deck.lookAt(null) })
    nodes.set(r.id, li)
    deck.add(r.id, li)
    return li
  }

  function render() {
    const v = input.value
    const before = ctx.unlocked
    while (ctx.unlocked < TOTAL && RULES.slice(0, ctx.unlocked).every((r) => r.ok(v, ctx))) {
      cleared(RULES[ctx.unlocked - 1].id)
      ctx.unlocked++
      maybeSacrifice()
    }
    const active = RULES.slice(0, ctx.unlocked)
    const passing = new Set(active.filter((r) => r.ok(v, ctx)).map((r) => r.id))

    if (ctx.unlocked > before) {
      sfx.blip(Math.min(9, ctx.unlocked))
      for (let i = before; i < ctx.unlocked; i++) shell.announce(`New rule ${RULES[i].id}. ${RULES[i].text(ctx)}`)
      // A milestone every ten rules gets the marker; the rest just arrive.
      for (let i = before + 1; i <= ctx.unlocked; i++) if (i % 10 === 0) shell.levelUp(`Rule ${i}`)
    }

    const arrived: number[] = [], broke: number[] = [], fixed: number[] = []
    const order = active.slice().sort((a, b) =>
      (passing.has(a.id) ? 1 : 0) - (passing.has(b.id) ? 1 : 0) || a.id - b.id)

    order.forEach((r, i) => {
      const isNew = !nodes.has(r.id)
      const li = nodeFor(r)
      const done = passing.has(r.id)
      const cls = 'rc-card ' + (done ? 'is-ok' : 'is-bad')
      if (!li.className.startsWith(cls)) li.className = cls
      const txt = r.text(ctx)
      const t = li.querySelector('.rc-text')!
      if (t.textContent !== txt) t.textContent = txt
      li.querySelector('.rc-state')!.textContent = done ? ', met. ' : ', not met. '
      // Reading order for a screen reader: still to do first, then the rest.
      if (list.children[i] !== li) list.insertBefore(li, list.children[i] ?? null)
      if (isNew) arrived.push(r.id)
      if (done && (isNew || !passedBefore.has(r.id))) { fixed.push(r.id); approved.set(r.id, ++stampSeq) }
      else if (!done && passedBefore.has(r.id)) { broke.push(r.id); approved.delete(r.id) }
    })

    for (const r of active) {
      if (passing.has(r.id) && !passedBefore.has(r.id)) shell.announce(`Rule ${r.id} met.`)
      else if (!passing.has(r.id) && passedBefore.has(r.id)) { sfx.bad(); shell.announce(`Rule ${r.id} no longer met.`) }
    }
    passedBefore = passing

    const unmet = order.filter((r) => !passing.has(r.id)).map((r) => r.id)
    const met = [...approved.keys()].filter((id) => passing.has(id)).sort((a, b) => approved.get(a)! - approved.get(b)!)
    deck.layout(unmet, met)
    if (WORLD_PLAY) for (const id of arrived) deck.toss(deck.get(id)!)
    for (const id of fixed) {
      const li = nodes.get(id)!
      li.classList.remove('just-ok'); void li.offsetWidth; li.classList.add('just-ok')
      if (!arrived.includes(id)) deck.press(id)
    }
    if (fixed.length) paper.stamp()
    for (const id of broke) deck.jolt(id)
    if (broke.length) paper.snatch()
    pileBar.hidden = met.length < 2

    grow()
    const n = chars(v).length
    count.textContent = `${n} character${n === 1 ? '' : 's'}`
    scoreEl.textContent = `${passing.size} / ${TOTAL} rules`
    shell.setScore(String(passing.size))
    shell.setLevel(String(ctx.unlocked))
    desk.style.setProperty('--t', ((ctx.unlocked - 1) / (TOTAL - 1)).toFixed(3))
    if (ctx.unlocked !== reached) shell.progress(reached = ctx.unlocked)
    shell.setMoves(keystrokes.toLocaleString('en-GB'))
    shell.considerBest(liveBest(passing.size), `${passing.size} / ${TOTAL}`)

    const all = RULES.every((r) => r.ok(v, ctx))
    if (all && !won) finish(n)
    moth.poke()
  }

  /* ---- the watch: the real time, on the desk ----------------------- */
  {
    const hands = document.getElementById('rcHands')
    const set = (cls: string, deg: number) => hands?.querySelector(cls)?.setAttribute('transform', `rotate(${deg.toFixed(2)} 36 120)`)
    const tickWatch = () => {
      const d = new Date(), s = d.getSeconds(), m = d.getMinutes() + s / 60, h = (d.getHours() % 12) + m / 60
      set('.rc-h', h * 30); set('.rc-m', m * 6); set('.rc-s', s * 6)
    }
    tickWatch()
    setInterval(() => { if (!document.hidden) tickWatch() }, 1000)
  }

  /* ---- the office box -------------------------------------------- */
  const slip = document.getElementById('slip')!
  const accept = document.getElementById('accept')!
  {
    // Date-stamped the moment you sat down, like any form.
    const d = new Date()
    document.getElementById('receivedAt')!.textContent =
      d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase() +
      ' · ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })
  }
  const replay = (el: HTMLElement, cls: string) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls) }
  function confiscate(letter: string) {
    document.getElementById('slipLetter')!.textContent = letter.toUpperCase() + letter
    slip.hidden = false
    replay(slip, 'is-new')
    // A staple: the snap, then the thud of the stapler on the board.
    hit({ dur: 0.03, gain: 0.3, freq: 4200, q: 2.4 }); hit({ dur: 0.08, gain: 0.22, freq: 300, type: 'lowpass', delay: 0.02 })
  }

  function finish(n: number) {
    won = true
    accept.hidden = false
    replay(accept, 'is-new')
    paper.stamp()
    replay(board, 'is-thumped')
    cleared(RULES[TOTAL - 1].id)
    shell.pick('Rule that took longest', slowest.id)
    const secs = Math.round((Date.now() - started) / 1000)
    recordPlay('rule-cascade', { keystrokes, seconds: secs, length: n }, { keystrokes: 'low', seconds: 'low' })
    const beat = shell.considerBest(finishBest(keystrokes), `${keystrokes.toLocaleString('en-GB')} keys`)
    const daily = dailyFor(new Date())
    const cap = Number(daily.goal.match(/fewer than (\d+)/)?.[1] ?? 0)
    const lines = [
      `keystrokes for all ${TOTAL} rules — a ${n}-character username in ${Math.floor(secs / 60)}m ${secs % 60}s.`,
      beat === 'beaten' ? '✓ That is a new personal best.'
        : beat === 'first' ? 'Your first finish — that is the best to beat now.'
        : `Your best is still ${shell.best?.text}.`,
    ]
    if (daily.slug === 'rule-cascade' && cap)
      shell.daily(keystrokes < cap, `The target: all ${TOTAL} rules in fewer than ${cap} keystrokes. You took ${keystrokes.toLocaleString('en-GB')}.`)
    // The crowd: how your slowest rule compares, and which rule holds everyone up.
    const hold = slowest
    const crowdEl = document.createElement('div')
    shell.resultExtra.replaceChildren(crowdEl)
    fillCrowd(crowdEl, 'rule-cascade', (c) => {
      const st = standing(c, 'Seconds to clear each rule', `Rule ${hold.id}`, hold.s, 'low')
      const meds = RULES.map((r) => ({ id: r.id, m: median(c, 'Seconds to clear each rule', `Rule ${r.id}`) })).filter((x) => x.m && x.m.n >= 10)
      const worst = meds.sort((a, b) => b.m!.v - a.m!.v)[0]
      const parts: string[] = []
      if (st) parts.push(`Your slowest was Rule ${hold.id}, at ${hold.s} s: quicker than <b>${st.pct}%</b> of ${people(st.n)} players who reached it.`)
      if (worst) parts.push(worst.id === hold.id ? 'It holds up everyone else longest too.' : `The rule that holds everyone up longest is Rule ${worst.id}: a typical player needs ${worst.m!.v} s for it.`)
      return parts.length ? parts.join(' ') : null
    }, 'crowd-note--block')
    shell.win({
      kicker: '✓ Username accepted',
      title: 'Fine. That is a username.',
      score: keystrokes.toLocaleString('en-GB'),
      lines,
    })
  }

  /* ---- the rules that do something to you ------------------------- */

  const MOTH_RULE = RULES.find((r) => r.live === 'moth')!.id
  const SACRIFICE_RULE = RULES.find((r) => r.live === 'sacrifice')!.id

  /* The moth is real now (lib/cascade/moth.ts): it circles the lamp, comes
     down onto one letter every six seconds, and eats it. A spider sends it off. */
  const moth = createMoth({
    host: desk,
    field: input,
    animate: WORLD_PLAY,
    lamp: () => {
      const d = desk.getBoundingClientRect(), b = board.getBoundingClientRect()
      return { x: b.left - d.left + b.width * 0.3, y: b.top - d.top + 24 }
    },
    present: () => !won && ctx.unlocked >= MOTH_RULE,
    hungry: () => !RULES[MOTH_RULE - 1].ok(input.value, ctx),
    paused: () => shell.paused,
    pick: () => {
      const a = chars(input.value)
      const edible = a.map((_, i) => i).filter((i) => a[i] !== '🕷')
      return edible.length ? edible[(Math.random() * edible.length) | 0] : null
    },
    eat: (i) => {
      const a = chars(input.value)
      if (i >= a.length || a[i] === '🕷') return false
      const eaten = a[i]
      // Keep the caret where it was, less the letter that went from before it.
      const at = input.selectionStart ?? 0, from = a.slice(0, i).join('').length
      a.splice(i, 1)
      input.value = a.join('')
      if (document.activeElement === input) { const p = at > from ? at - eaten.length : at; input.setSelectionRange(p, p) }
      for (let k = 0; k < 3; k++) hit({ dur: 0.025, gain: 0.12, freq: 2800 + k * 300, q: 3, delay: k * 0.07 })
      tone({ freq: 170, to: 110, dur: 0.18, type: 'sawtooth', gain: 0.07, filter: 800, delay: 0.2 })
      shell.announce(`The moth ate a character: ${eaten}.`)
      render()
      return true
    },
    onFlutter: () => { for (let k = 0; k < 6; k++) hit({ dur: 0.028, gain: 0.045, freq: 240, type: 'lowpass', delay: k * 0.034 }) },
  })

  function maybeSacrifice() {
    if (ctx.banned || ctx.unlocked < SACRIFICE_RULE) return
    const counts = new Map<string, number>()
    for (const ch of input.value.toLowerCase()) if (/[a-z]/.test(ch)) counts.set(ch, (counts.get(ch) ?? 0) + 1)
    if (!counts.size) return
    ctx.banned = [...counts.entries()].sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1))[0][0]
    shell.announce(`The letter ${ctx.banned} has been taken away.`)
    confiscate(ctx.banned)
    sfx.thud()
  }

  /** The field grows with what you type, so every letter can be seen (and landed on). */
  function grow() {
    input.style.height = 'auto'
    const want = input.scrollHeight + 2
    input.style.height = Math.min(want, 300) + 'px'
    input.style.overflowY = want > 300 ? 'auto' : 'hidden'
  }

  /* ---- the approved pile ------------------------------------------ */

  fanBtn.addEventListener('click', () => {
    const on = !deck.fanned
    fanBtn.setAttribute('aria-pressed', String(on))
    fanBtn.textContent = on ? 'Square up the pile' : 'Spread the approved pile'
    deck.setFanned(on)
    render()
    hit({ dur: 0.3, gain: 0.1, freq: 1300, sweepTo: 500, q: 0.6 })
  })

  /* On a phone the clipboard rides along at the top of the screen, but only
     its lower half: the heading scrolls away and the field stays, because
     that is the part you are typing into. */
  function stick() {
    const head = field.getBoundingClientRect().top - board.getBoundingClientRect().top
    board.style.setProperty('--stick', `${-Math.max(0, head - 12)}px`)
  }
  new ResizeObserver(stick).observe(board)

  function restart() {
    input.value = ''
    ctx.unlocked = 1
    ctx.banned = null
    won = false
    keystrokes = 0
    started = Date.now()
    ruleAt = started; slowest = { id: 0, s: -1 }; reached = 0
    passedBefore = new Set()
    approved.clear(); stampSeq = 0
    nodes.clear()
    deck.clear()
    moth.reset()
    slip.hidden = true
    accept.hidden = true
    list.innerHTML = ''
    render()
    input.focus()
  }

  input.addEventListener('input', () => { unlock(); keystrokes++; render() })
  setInterval(() => { if (shell.paused) return; ctx.hour = new Date().getHours(); render() }, 5000)
  // Heights change once the typewriter face arrives; lay the cards out again.
  document.fonts?.ready.then(() => render())
  render()
  input.focus({ preventScroll: true })

  if (import.meta.env.DEV) (window as any).__cascade = { deck, ctx, render, input, moth }
</script>

