---
import GameShell from '../layouts/GameShell.astro'
import { RULES } from '../lib/cascade-rules'

/**
 * Rule Cascade — you are just picking a username, and the requirements keep
 * arriving. Rules unlock one at a time and every previously-unlocked rule stays
 * live, so late rules routinely break early ones. All validation is
 * client-side; nothing is ever sent anywhere.
 *
 * Thirty-one rules, three of which do something rather than just checking: a
 * moth that eats a character every six seconds, a sacrifice that takes one
 * letter of the alphabet away from you permanently, and a rule about how many
 * rules are on screen, which therefore moves every time you satisfy it.
 *
 * The rules live in lib/cascade-rules.ts; scripts/check-cascade.mjs builds a
 * real solution for all 24 hours and all 26 possible sacrifices.
 *
 * In the shell: Score is rules met right now, Rule is how far the list has
 * unlocked, Moves are keystrokes. Best is the most rules ever met at once —
 * and once you have finished, the fewest keystrokes a finish took.
 */
const total = RULES.length
---

<GameShell
  slug="rule-cascade"
  labels={{ score: 'Rules met', best: 'Best', level: 'Rule', moves: 'Keystrokes' }}
  initial={{ score: '0', level: '1', moves: '0' }}
>
  <div class="rc">
    <div class="rc-head">
      <p class="label meta">Step 1 of 1</p>
      <h2 class="rc-title">Choose a <em class="wonk">username</em>.</h2>
      <p class="rc-sub">It should not take long.</p>
    </div>

    <div class="rc-field">
      <label class="sr-only" for="input">Username</label>
      <textarea
        id="input"
        rows="2"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        placeholder="type something"></textarea>
      <div class="rc-meter">
        <span id="count">0 characters</span>
        <span id="score">0 / {total} rules</span>
      </div>
    </div>

    <ol class="rc-rules" id="rules" aria-label="Rules"></ol>
  </div>

  <Fragment slot="howto">
    <p>
      You are picking a username. Type it in the box. A rule appears; satisfy
      it and the next one arrives — and every rule already on screen <b>stays
      live</b>, so a late rule will often break an early one.
    </p>
    <ul>
      <li>Unmet rules sit at the top with a <b>✗</b>. Met ones sink below, filled blue with a <b>✓</b>.</li>
      <li>Some rules act on you: a moth eats a character every few seconds until you give it a spider, and one rule takes a letter away for good.</li>
      <li>Everything is checked in your browser. Nothing you type is sent anywhere.</li>
    </ul>
    <p>Finish all {total}. Your best is the fewest keystrokes it took.</p>
  </Fragment>
</GameShell>

<script>
  import { createShell } from '../lib/game-shell'
  import { sfx, unlock } from '../lib/audio'
  import { PLAY } from '../lib/motion'
  import { RULES, chars } from '../lib/cascade-rules'
  import { recordPlay } from '../lib/stats'
  import { dailyFor } from '../data/game-meta'

  const TOTAL = RULES.length
  const input = document.getElementById('input') as HTMLTextAreaElement
  const list = document.getElementById('rules')!
  const count = document.getElementById('count')!
  const scoreEl = document.getElementById('score')!

  const ctx = { hour: new Date().getHours(), unlocked: 1, banned: null as string | null }
  let won = false
  let keystrokes = 0
  let started = Date.now()
  let passedBefore = new Set<number>()
  const nodes = new Map<number, HTMLLIElement>()

  const shell = createShell({
    slug: 'rule-cascade',
    onRestart: restart,
    onPause: () => { pausedAt = Date.now() },
    onResume: () => { started += Date.now() - pausedAt; input.focus() },
  })
  let pausedAt = 0

  /* Best: most rules met at once, or — once finished — a finish with fewer
     keystrokes. A finish always outranks a non-finish. */
  const liveBest = (met: number) => met * 10_000
  const finishBest = (keys: number) => (TOTAL + 1) * 10_000 - keys

  function nodeFor(r: (typeof RULES)[number]) {
    let li = nodes.get(r.id)
    if (li) return li
    li = document.createElement('li')
    li.dataset.id = String(r.id)
    li.innerHTML =
      '<span class="rc-mark" aria-hidden="true"></span>' +
      '<span class="rc-body"><span class="rc-no">Rule ' + r.id + '</span>' +
      '<span class="sr-only rc-state"></span>' +
      '<span class="rc-text"></span></span>'
    nodes.set(r.id, li)
    return li
  }

  function render() {
    const v = input.value
    const before = ctx.unlocked
    while (ctx.unlocked < TOTAL && RULES.slice(0, ctx.unlocked).every((r) => r.ok(v, ctx))) {
      ctx.unlocked++
      maybeSacrifice()
    }
    const active = RULES.slice(0, ctx.unlocked)
    const passing = new Set(active.filter((r) => r.ok(v, ctx)).map((r) => r.id))

    const arrived: HTMLElement[] = []
    const broke: HTMLElement[] = []
    const fixed: HTMLElement[] = []

    if (ctx.unlocked > before) {
      sfx.blip(Math.min(9, ctx.unlocked))
      for (let i = before; i < ctx.unlocked; i++) shell.announce(`New rule ${RULES[i].id}. ${RULES[i].text(ctx)}`)
      // A milestone every ten rules gets the marker; the rest just arrive.
      for (let i = before + 1; i <= ctx.unlocked; i++) if (i % 10 === 0) shell.levelUp(`Rule ${i}`)
    }

    // FLIP, part one: where every rule sits before the list changes.
    const firstTop = new Map<number, number>()
    if (PLAY) for (const [id, li] of nodes) if (li.isConnected) firstTop.set(id, li.getBoundingClientRect().top)

    const order = active.slice().sort((a, b) =>
      (passing.has(a.id) ? 1 : 0) - (passing.has(b.id) ? 1 : 0) || a.id - b.id)

    for (const r of order) {
      const li = nodeFor(r)
      const done = passing.has(r.id)
      const isNew = !li.isConnected
      const cls = 'rc-rule ' + (done ? 'is-ok' : 'is-bad')
      if (li.className !== cls) li.className = cls
      const txt = r.text(ctx)
      const t = li.querySelector('.rc-text')!
      if (t.textContent !== txt) t.textContent = txt
      li.querySelector('.rc-mark')!.textContent = done ? '✓' : '✗'
      li.querySelector('.rc-state')!.textContent = done ? ', met. ' : ', not met. '
      list.appendChild(li)
      if (isNew) arrived.push(li)
      else if (done && !passedBefore.has(r.id)) fixed.push(li)
      else if (!done && passedBefore.has(r.id)) broke.push(li)
    }

    for (const r of active) {
      if (passing.has(r.id) && !passedBefore.has(r.id)) { sfx.good(); shell.announce(`Rule ${r.id} met.`) }
      else if (!passing.has(r.id) && passedBefore.has(r.id)) { sfx.bad(); shell.announce(`Rule ${r.id} no longer met.`) }
    }
    passedBefore = passing

    // FLIP, part two: carry each rule from where it was to where it is.
    if (PLAY) {
      for (const [id, li] of nodes) {
        const was = firstTop.get(id)
        if (!li.isConnected || was === undefined) continue
        const dy = was - li.getBoundingClientRect().top
        if (Math.abs(dy) < 1) continue
        li.style.transition = 'none'
        li.style.transform = `translateY(${dy}px)`
        void li.offsetHeight
        li.style.transition = ''
        li.style.transform = ''
      }
    }
    arrived.forEach((li) => shell.pop(li))
    fixed.forEach((li) => shell.pop(li))
    broke.forEach((li) => shell.shake(li))

    const n = chars(v).length
    count.textContent = `${n} character${n === 1 ? '' : 's'}`
    scoreEl.textContent = `${passing.size} / ${TOTAL} rules`
    shell.setScore(String(passing.size))
    shell.setLevel(String(ctx.unlocked))
    shell.setMoves(keystrokes.toLocaleString('en-GB'))
    shell.considerBest(liveBest(passing.size), `${passing.size} / ${TOTAL}`)

    const all = RULES.every((r) => r.ok(v, ctx))
    if (all && !won) {
      won = true
      const secs = Math.round((Date.now() - started) / 1000)
      recordPlay('rule-cascade', { keystrokes, seconds: secs, length: n }, { keystrokes: 'low', seconds: 'low' })
      const beat = shell.considerBest(finishBest(keystrokes), `${keystrokes.toLocaleString('en-GB')} keys`)
      const daily = dailyFor(new Date())
      const cap = Number(daily.goal.match(/fewer than (\d+)/)?.[1] ?? 0)
      const lines = [
        `keystrokes for all ${TOTAL} rules — a ${n}-character username in ${Math.floor(secs / 60)}m ${secs % 60}s.`,
        beat === 'beaten' ? '✓ That is a new personal best.'
          : beat === 'first' ? 'Your first finish — that is the best to beat now.'
          : `Your best is still ${shell.best?.text}.`,
      ]
      if (daily.slug === 'rule-cascade' && cap)
        lines.push(keystrokes < cap ? `✓ Daily challenge beaten: under ${cap} keystrokes.` : `✗ Daily challenge: under ${cap} keystrokes to beat it.`)
      shell.win({
        kicker: '✓ Username accepted',
        title: 'Fine. That is a username.',
        score: keystrokes.toLocaleString('en-GB'),
        lines,
      })
    }
  }

  /* ---- the rules that do something to you ------------------------- */

  const MOTH_RULE = RULES.find((r) => r.live === 'moth')!.id
  const SACRIFICE_RULE = RULES.find((r) => r.live === 'sacrifice')!.id

  setInterval(() => {
    if (won || shell.paused || ctx.unlocked < MOTH_RULE) return
    if (RULES[MOTH_RULE - 1].ok(input.value, ctx)) return
    const a = chars(input.value)
    const edible = a.map((_, i) => i).filter((i) => a[i] !== '🕷')
    if (!edible.length) return
    const at = edible[(Math.random() * edible.length) | 0]
    const eaten = a[at]
    a.splice(at, 1)
    input.value = a.join('')
    sfx.bad()
    shell.shake(input.closest('.rc-field')!)
    shell.announce(`The moth ate a character: ${eaten}.`)
    render()
  }, 6000)

  function maybeSacrifice() {
    if (ctx.banned || ctx.unlocked < SACRIFICE_RULE) return
    const counts = new Map<string, number>()
    for (const ch of input.value.toLowerCase()) if (/[a-z]/.test(ch)) counts.set(ch, (counts.get(ch) ?? 0) + 1)
    if (!counts.size) return
    ctx.banned = [...counts.entries()].sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1))[0][0]
    shell.announce(`The letter ${ctx.banned} has been taken away.`)
    sfx.thud()
  }

  function restart() {
    input.value = ''
    ctx.unlocked = 1
    ctx.banned = null
    won = false
    keystrokes = 0
    started = Date.now()
    passedBefore = new Set()
    nodes.clear()
    list.innerHTML = ''
    render()
    input.focus()
  }

  input.addEventListener('input', () => { unlock(); keystrokes++; render() })
  setInterval(() => { if (shell.paused) return; ctx.hour = new Date().getHours(); render() }, 5000)
  render()
  input.focus({ preventScroll: true })
</script>

<style is:global>
  /* Rules are built by the script, and script-built nodes never get Astro's
     scoped-style attribute, so every rule here is global on purpose. */
  .rc { max-width: 720px; margin: 0 auto; }
  .rc-head { text-align: center; }
  .rc-title { font-size: var(--fs-h2); margin-top: 10px; }
  .rc-sub { margin-top: 10px; color: var(--ink2); font-size: var(--fs-lead); }

  .rc-field {
    margin-top: 28px;
    border-radius: var(--r);
    border: 2px solid var(--ink);
    background: var(--card);
    overflow: hidden;
    position: sticky;
    top: 12px;
    z-index: 3;
    box-shadow: var(--shadow-block);
  }
  .rc-field:has(textarea:focus-visible) { outline: 2px solid var(--ink); outline-offset: 3px; }
  .rc-field textarea {
    display: block;
    width: 100%;
    border: 0;
    outline: 0;
    resize: none;
    padding: 16px 18px;
    font-family: var(--sans);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
    background: transparent;
    color: var(--ink);
  }
  .rc-field textarea::placeholder { color: var(--ink3); opacity: 1; }
  .rc-meter {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 18px;
    border-top: 1.5px solid var(--paper3);
    background: var(--paper2);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink2);
  }

  /* Pieces: an unmet rule is an ink-outlined card with a ✗; a met rule
     sinks into a sky block with a ✓. Two px of paper between them. */
  .rc-rules { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 8px; }
  .rc-rule {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: 14px;
    border: 2px solid var(--ink);
    background: var(--card);
    color: var(--ink);
  }
  .rc-rule.is-ok { background: var(--sky); border-color: var(--sky); }
  .rc-mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 15px;
    line-height: 1;
    background: var(--ink);
    color: var(--ink-paper);
  }
  .rc-rule.is-bad .rc-mark { background: var(--red); color: var(--ink); }
  .rc-body { display: grid; gap: 2px; font-size: 16px; line-height: 1.4; }
  .rc-no { font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .rc-rule.is-bad .rc-no { color: var(--t-red); }

  html.play .rc-rule { transition: transform 380ms var(--glide); }
</style>
