101.64" x2="23.90" y2="99.04" stroke-width="1.3"/><line x1="26.81" y1="99.35" x2="26.16" y2="97.89" stroke-width="0.5"/><line x1="29.02" y1="98.51" x2="28.52" y2="96.98" stroke-width="0.5"/><line x1="31.30" y1="97.89" x2="30.97" y2="96.33" stroke-width="0.5"/><line x1="33.64" y1="97.52" x2="33.47" y2="95.93" stroke-width="0.5"/></g>
