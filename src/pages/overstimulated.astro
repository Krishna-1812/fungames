---
import GameShell from '../layouts/GameShell.astro'
import { iconSvg } from '../lib/icons'

/**
 * Overstimulated - a clicker whose upgrades all make the page worse.
 *
 * Every purchase adds a layer of noise: a bassline, a popup, a second cursor,
 * a tilt. The joke only works if the escalation is real, so each layer is
 * genuinely implemented rather than being a label on a counter, and they all
 * run at once by the end.
 *
 * Two rules keep it from being hostile: the sound is off until you press a
 * button, and "Make it stop" is always reachable.
 *
 * In the shell the room is the stage, framed rather than filling the window.
 * Score is attention, Upgrades how many layers of noise you have bought,
 * Clicks the clicks, and Best the most clicks anybody has put in before
 * stopping. "Make it stop" is the ending, and the quiet is the shell's result
 * card now rather than an overlay. The shell's Pause really pauses: every
 * layer runs on one interval helper that skips its turn while paused, so the
 * bassline, the popups and the income all hold. The page's own gold is mint
 * and sky; the confetti is still confetti.
 */
---

<GameShell
  slug="overstimulated"
  labels={{ score: 'Attention', best: 'Most clicks', level: 'Upgrades', moves: 'Clicks' }}
  initial={{ score: '0', level: '0 / 15', moves: '0' }}
>
  <div class="over-body" id="overRoot">
  {/* Deliberately a sibling of .world rather than a child. The world tilts and
      shakes; a full-bleed element inside it would swing its own corners into
      view. Keeping the room still while the furniture lurches is also the more
      unpleasant of the two, which is the point. */}
  <div class="oversky" id="oversky" aria-hidden="true"></div>
  <canvas class="over-marbles" id="marbles" aria-hidden="true"></canvas>
  <ol class="over-legend" id="legend" aria-label="What each colour of marble is worth">
    <li style="--c: #5ff0c0">1</li><li style="--c: #56b8ff">10</li><li style="--c: #a080ff">100</li><li style="--c: #ff68b0">1,000</li><li style="--c: #e8f0ff">10,000</li>
  </ol>

  <script
    type="application/json"
    id="icon-data"
    set:html={JSON.stringify({
      trophy: iconSvg('trophy'),
      runners: ['cat', 'duck', 'snail', 'dino', 'scooter'].map((k) => iconSvg(k)),
    })}
  />

  <div class="world" id="world">

    <div class="core">
      <div class="score">
        <b id="attention">0</b>
        <span>attention</span>
        <em id="rate" hidden>+0 / sec</em>
      </div>

      <button type="button" class="big" id="bigBtn">
        <span class="big-ring" aria-hidden="true"></span>
        <span class="big-cap"><span id="bigLabel">Click me</span></span>
      </button>

      <p class="sub" id="sub">That is the whole game. For now.</p>
    </div>

    <aside class="shop" id="shop" aria-label="Upgrades"></aside>

    <button type="button" class="stop" id="stopBtn" hidden>Make it stop</button>
  </div>
  <canvas class="over-confetti" id="confetti" aria-hidden="true"></canvas>
  </div>

  <Fragment slot="howto">
    <p>
      A clicker. Click the button to earn attention, and spend it in the shop.
      Every upgrade makes the page a little worse, and they all keep running.
    </p>
    <ul>
      <li>Click fast and the button runs hotter: a quick run of clicks is worth more per click.</li>
      <li>Some upgrades earn attention on their own. All of them add noise.</li>
      <li>The sound stays off until you turn it on with the Sound button.</li>
      <li>"Make it stop" appears once there is something to stop, and it always works.</li>
    </ul>
    <p>Stopping is the end. Best is the most clicks it took you.</p>
  </Fragment>
</GameShell>

<script>
    const { trophy: TROPHY, runners: RUNNERS } = JSON.parse(
      document.getElementById('icon-data')!.textContent!,
    ) as { trophy: string; runners: string[] }

  import { sfx, unlock, tone, hit, scaleFreq } from '../lib/audio'
  import { burst, floatText } from '../lib/fx'
  import { ShaderSurface } from '../lib/gl'
  import { OVER_FRAG } from '../lib/over-sky'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { recordPlay } from '../lib/stats'
  import { SITE } from '../site.config'
  import { createShell } from '../lib/game-shell'
  import { PLAY, WORLD_PLAY } from '../lib/motion'
  import { createMarbles } from '../lib/over/marbles'
  import { createConfetti } from '../lib/over/confetti'

  const prefersReducedMotion = !PLAY
  // Restart is the default reload: nothing about the noise is worth keeping.
  const shell = createShell({ slug: 'overstimulated' })
  /** Every layer's timer. It skips its turn while the shell is paused, so a
      pause holds the whole room rather than only the income. */
  const every = (fn: () => void, ms: number) => window.setInterval(() => { if (!shell.paused) fn() }, ms)

  const el = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const world = el('world')
  const root = el('overRoot')
  const shop = el('shop')

  let attention = 0
  let clicks = 0
  let perSec = 0
  let combo = 0
  let comboAt = 0
  const started = performance.now()
  const timers: number[] = []
  const owned = new Set<string>()
  let lastBought = 'Nothing'

  /* What the environment is driven by. 'load' chases the fraction owned rather
     than snapping to it, so a purchase ramps the room up over a second or so
     instead of switching a layer on. */
  let load = 0
  let beatAt = -10
  let clickAt = -10
  let rainbow = false
  let calm = 0

  /* Where the core column actually is, in the space centred() builds. Measured
     from layout on resize rather than tracked per frame: the world shakes and
     tilts, and a well that chased that would slosh about behind the text. */
  let focus: [number, number] = [0, 0]
  function measureFocus() {
    const r = document.querySelector('.core')!.getBoundingClientRect()
    // Against the room, not the window: the sky fills the stage now.
    const b = root.getBoundingClientRect()
    const w = b.width || 1, h = b.height || 1, m = Math.min(w, h)
    // Mirrors centredAt(): origin at the room's centre, units of half the
    // short axis, y upward.
    focus = [(2 * (r.left - b.left + r.width / 2) - w) / m, (h - 2 * (r.top - b.top + r.height / 2)) / m]
  }
  measureFocus()
  addEventListener('resize', measureFocus)

  /* ---- attention, in glass ---------------------------------------------- */
  const narrow = () => matchMedia('(max-width: 760px)').matches
  function tankBox() {
    const b = root.getBoundingClientRect(), s = shop.getBoundingClientRect()
    const right = narrow() ? b.width - 14 : s.left - b.left - 16
    const bottom = narrow() ? s.top - b.top - 12 : b.height - 16
    return { left: 16, right, bottom, height: narrow() ? Math.max(86, b.height * 0.12) : Math.min(190, Math.max(110, b.height * 0.24)) }
  }
  const marbles = createMarbles({
    canvas: el<HTMLCanvasElement>('marbles'),
    tank: tankBox,
    // The visitor's own setting, not PLAY, which a slow load can lose.
    animate: WORLD_PLAY,
    onClick: (k, tier) => tone({ freq: 2300 + tier * 260 + Math.random() * 500, dur: 0.035 + k * 0.03, type: 'sine', gain: 0.012 + k * 0.05 }),
    onMerge: (tier) => { tone({ freq: 1320 + tier * 220, dur: 0.22, type: 'sine', gain: 0.06 }); tone({ freq: 1980 + tier * 330, dur: 0.3, type: 'sine', gain: 0.035, delay: 0.04 }) },
  })
  function placeLegend() {
    const t = tankBox()
    // The button and its words stand above the tank, never in it.
    root.style.setProperty('--tank-top', t.bottom - t.height - 6 + 'px')
    const lg = el('legend')
    lg.style.left = t.left + 10 + 'px'
    lg.style.top = t.bottom - t.height + 8 + 'px'
  }
  placeLegend()
  addEventListener('resize', placeLegend)
  /** Where new marbles come from, and where spent ones go. */
  const at = (n: Element) => {
    const b = root.getBoundingClientRect(), r = n.getBoundingClientRect()
    return { x: r.left - b.left + r.width / 2, y: r.top - b.top + r.height / 2 }
  }
  let spendTo = { x: 0, y: 0 }
  const confetti = createConfetti({
    canvas: el<HTMLCanvasElement>('confetti'),
    animate: WORLD_PLAY,
    // What lands, lands on the glass ledge along the front of the tank.
    floor: () => { const t = tankBox(); return { left: t.left, right: t.right, y: t.bottom + 5 } },
  })

  const sky = new ShaderSurface(document.getElementById('oversky')!, OVER_FRAG, {
    // Every layer here is low frequency; three-quarter resolution costs nothing
    // visible and leaves the frame budget to the DOM chaos on top.
    scale: 0.75,
    uniforms: () => ({
      u_load: load,
      u_click: prefersReducedMotion ? 0 : Math.max(0, 1 - (performance.now() - clickAt) / 260),
      // Matched to the 7s hue-rotate the .has-rainbow class runs on .world, so
      // the background and the foreground drift together rather than beating
      // against each other.
      // Driven by wall-clock rather than by u_time, so it needs its own guard:
      // under reduced motion Colour still changes the palette, it just stops
      // cycling through it.
      u_hue: !rainbow ? 0 : prefersReducedMotion ? Math.PI * 0.55 : ((performance.now() / 7000) % 1) * Math.PI * 2,
      u_calm: calm,
      u_focus: focus,
      u_motion: prefersReducedMotion ? 0 : 1,
      u_beat: prefersReducedMotion ? 99 : (performance.now() - beatAt) / 1000,
    }),
  })

  type Up = {
    id: string
    name: string
    note: string
    cost: number
    /** Attention per second this adds. */
    rate?: number
    apply: () => void
  }

  // ---- the layers of noise ----------------------------------------------
  const NOTIFS = [
    'Someone liked your thing', 'Your streak is at risk', '3 people are typing',
    'New feature you did not ask for', 'Your storage is almost full',
    'A person you met once posted', 'Weekly report: down 4%',
    'You have 1,204 unread', 'Rate your recent experience',
    'Reminder about a thing from 2019', 'Trending in your area: nothing',
  ]
  const ACHIEVEMENTS = [
    'First Click', 'Committed', 'Why Are You Still Here', 'Certified Clicker',
    'Diminishing Returns', 'Peak Engagement', 'Beyond Help',
  ]

  function spawnNotification() {
    const n = document.createElement('div')
    n.className = 'notif'
    n.innerHTML = '<b>' + NOTIFS[(Math.random() * NOTIFS.length) | 0] + '</b><span>now</span>'
    world.appendChild(n)
    tone({ freq: 880, to: 1320, dur: 0.1, type: 'sine', gain: 0.07 })
    setTimeout(() => { n.classList.add('out'); setTimeout(() => n.remove(), 400) }, 3400)
  }

  function spawnAchievement() {
    const a = document.createElement('div')
    a.className = 'achv'
    a.innerHTML = '<span>' + TROPHY + '</span><div><b>Achievement unlocked</b>' +
      '<i>' + ACHIEVEMENTS[(Math.random() * ACHIEVEMENTS.length) | 0] + '</i></div>'
    world.appendChild(a)
    sfx.sparkle()
    setTimeout(() => { a.classList.add('out'); setTimeout(() => a.remove(), 400) }, 2800)
  }

  function spawnPopup() {
    if (world.querySelector('.popup')) return
    const p = document.createElement('div')
    p.className = 'popup'
    p.innerHTML =
      '<b>Before you go</b>' +
      '<p>Get our newsletter. It is mostly this.</p>' +
      '<div><button type="button" class="pop-yes">Yes obviously</button>' +
      '<button type="button" class="pop-no">No thanks</button></div>'
    world.appendChild(p)
    hit({ dur: 0.09, gain: 0.16, freq: 900, q: 3 })
    const close = () => { p.classList.add('out'); setTimeout(() => p.remove(), 300) }
    p.querySelector('.pop-no')!.addEventListener('click', () => { answered('No thanks'); close() })
    p.querySelector('.pop-yes')!.addEventListener('click', () => { answered('Yes obviously'); close(); spawnAchievement() })
  }
  // The popup recurs; only its first answer is counted.
  let popupAnswered = false
  const answered = (v: string) => { if (!popupAnswered) { popupAnswered = true; shell.pick('Newsletter popup, first answer', v) } }

  let cursorEls: HTMLElement[] = []
  const cursorPos = { x: innerWidth / 2, y: innerHeight / 2 }
  function addCursors(n: number) {
    for (let i = 0; i < n; i++) {
      const c = document.createElement('div')
      c.className = 'ghost-cursor'
      c.textContent = '➤'
      world.appendChild(c)
      cursorEls.push(c)
    }
  }
  addEventListener('pointermove', (e) => { cursorPos.x = e.clientX; cursorPos.y = e.clientY }, { passive: true })

  function spawnRunner() {
    const c = document.createElement('div')
    c.className = 'runner'
    c.innerHTML = RUNNERS[(Math.random() * RUNNERS.length) | 0]
    c.style.top = 20 + Math.random() * 60 + '%'
    c.style.animationDuration = 2.4 + Math.random() * 2 + 's'
    world.appendChild(c)
    setTimeout(() => c.remove(), 5000)
  }

  // A four-bar bassline, scheduled a beat ahead so it does not drift.
  let musicTimer = 0
  function startMusic() {
    const PATTERN = [0, 0, 3, 0, 5, 3, 0, -2]
    let beat = 0
    musicTimer = every(() => {
      beatAt = performance.now()
      const step = PATTERN[beat % PATTERN.length]
      tone({ freq: scaleFreq(step, 55), dur: 0.26, type: 'sawtooth', gain: 0.1, filter: 420 })
      if (beat % 2 === 0) hit({ dur: 0.06, gain: 0.14, freq: 180, type: 'lowpass' })
      if (beat % 4 === 2) hit({ dur: 0.05, gain: 0.07, freq: 6000, q: 1 })
      beat++
    }, 260)
    timers.push(musicTimer)
  }

  const UPGRADES: Up[] = [
    { id: 'bar', name: 'A progress bar', note: 'It does not measure anything', cost: 10,
      apply: () => world.classList.add('has-bar') },
    { id: 'auto', name: 'An autoclicker', note: '+2 attention every second', cost: 25, rate: 2,
      apply: () => {} },
    { id: 'notif', name: 'Notifications', note: 'From apps you do not have', cost: 45,
      apply: () => timers.push(every(spawnNotification, 2600)) },
    { id: 'music', name: 'A backing track', note: 'It has one idea', cost: 80,
      apply: startMusic },
    { id: 'confetti', name: 'Confetti', note: 'For no particular reason', cost: 120,
      apply: () => { confetti.pop(at(el('bigBtn')).x, at(el('bigBtn')).y, 60); timers.push(every(() => confetti.rain(9), 700)) } },
    { id: 'ad', name: 'One tasteful ad', note: 'It is not tasteful', cost: 180, rate: 4,
      apply: () => world.classList.add('has-ad') },
    { id: 'cursor', name: 'A second cursor', note: 'It is slightly behind yours', cost: 260,
      apply: () => { addCursors(1); world.classList.add('has-cursors') } },
    { id: 'popup', name: 'A newsletter popup', note: 'Recurring, obviously', cost: 380,
      apply: () => { spawnPopup(); timers.push(every(spawnPopup, 9000)) } },
    { id: 'achv', name: 'Achievements', note: 'For clicking', cost: 520, rate: 10,
      apply: () => { spawnAchievement(); timers.push(every(spawnAchievement, 6000)) } },
    { id: 'shake', name: 'Screen shake', note: 'Constantly', cost: 700,
      apply: () => world.classList.add('has-shake') },
    { id: 'runner', name: 'Animals', note: 'Running across the screen', cost: 900,
      apply: () => { spawnRunner(); timers.push(every(spawnRunner, 2200)) } },
    { id: 'rainbow', name: 'Colour', note: 'All of it', cost: 1200, rate: 25,
      apply: () => { world.classList.add('has-rainbow'); rainbow = true } },
    { id: 'swarm', name: 'Nineteen more cursors', note: 'They are all slightly behind yours', cost: 1700,
      apply: () => addCursors(19) },
    { id: 'tilt', name: 'A slow rotation', note: 'Of the entire page', cost: 2400,
      apply: () => world.classList.add('has-tilt') },
    { id: 'everything', name: 'Everything, faster', note: 'You know what you are doing', cost: 3600, rate: 100,
      apply: () => {
        world.classList.add('has-everything')
        timers.push(every(spawnNotification, 900))
        timers.push(every(spawnRunner, 700))
        timers.push(every(() => confetti.rain(14), 300))
      } },
  ]

  // ---- shop --------------------------------------------------------------
  const cards = new Map<string, HTMLButtonElement>()
  for (const up of UPGRADES) {
    const b = document.createElement('button')
    b.type = 'button'
    b.className = 'buy'
    b.disabled = true
    b.innerHTML =
      '<span class="buy-name">' + up.name + '</span>' +
      '<span class="buy-note">' + up.note + '</span>' +
      '<span class="buy-cost">' + up.cost.toLocaleString('en-US') + '</span>'
    b.addEventListener('click', () => purchase(up, b))
    shop.appendChild(b)
    cards.set(up.id, b)
  }

  function purchase(up: Up, b: HTMLButtonElement) {
    if (owned.has(up.id) || attention < up.cost) return
    attention -= up.cost
    spendTo = at(b)
    owned.add(up.id)
    if (up.rate) perSec += up.rate
    unlock()
    sfx.great()
    b.classList.add('owned')
    b.disabled = true
    b.querySelector('.buy-cost')!.textContent = 'on'
    up.apply()
    shell.pick('Upgrade bought', up.name)
    shell.progress(owned.size)
    lastBought = up.name

    const r = b.getBoundingClientRect()
    burst(r.left + r.width / 2, r.top + r.height / 2, {
      count: 18, colors: ['#ff5f9e', '#8affc4', '#8affc4'], speed: 4, gravity: 0.1, life: 40, size: 4,
    })

    if (owned.size >= 4) el('rate').hidden = false
    if (owned.size >= 3) el('stopBtn').hidden = false
    shell.setLevel(`${owned.size} / ${UPGRADES.length}`)
    if (owned.size === UPGRADES.length) {
      el('sub').textContent = 'There is nothing left to buy. There is only this.'
      el('stopBtn').classList.add('urgent')
    }
    paint()
  }

  // ---- clicking ----------------------------------------------------------
  const LABELS = [
    'Click me', 'Again', 'Keep going', 'More', 'Do not stop',
    'You are doing great', 'Why', 'Yes', 'MORE',
  ]

  /* The cap is on a spring: it goes down while held, comes back up past
     where it started, and settles. A click from the keyboard still knocks it. */
  const press = { x: 0, v: 0, to: 0 }
  const bigBtn = el('bigBtn')
  bigBtn.addEventListener('pointerdown', () => { press.to = 1 })
  for (const ev of ['pointerup', 'pointerleave', 'pointercancel']) bigBtn.addEventListener(ev, () => { press.to = 0 })

  el('bigBtn').addEventListener('click', (e) => {
    if (press.to === 0) press.v += 34
    unlock()
    clicks++
    const now = performance.now()
    combo = now - comboAt < 700 ? Math.min(combo + 1, 12) : 0
    comboAt = now
    clickAt = now
    const gain = 1 + Math.floor(combo / 3)
    attention += gain

    sfx.pop(combo)
    const r = (e.currentTarget as HTMLElement).getBoundingClientRect()
    const px = r.left + r.width / 2 + (Math.random() - 0.5) * r.width * 0.5
    const py = r.top + r.height / 2
    floatText(px, py, '+' + gain, '#8affc4')
    burst(px, py, {
      count: 6 + combo, colors: ['#ff5f9e', '#8affc4', '#fff'],
      speed: 3, gravity: 0.18, life: 30, size: 3,
    })

    el('bigLabel').textContent = LABELS[Math.min(LABELS.length - 1, Math.floor(clicks / 9))]
    paint()
  })

  // ---- loop --------------------------------------------------------------
  function paint() {
    el('attention').textContent = Math.floor(attention).toLocaleString('en-US')
    el('rate').textContent = '+' + perSec + ' / sec'
    for (const up of UPGRADES) {
      const b = cards.get(up.id)!
      if (owned.has(up.id)) continue
      b.disabled = attention < up.cost
      b.classList.toggle('ready', attention >= up.cost)
    }
  }

  let last = performance.now()
  let lastStrip = -1e9
  let lastDrawn = -1
  let shakeSeed = 0
  function loop(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000)
    last = now
    if (perSec && !shell.paused) { attention += perSec * dt; paint() }
    if (!shell.paused) {
      marbles.sync(Math.floor(attention), at(el('bigBtn')), spendTo)
      marbles.frame(dt)
      confetti.frame(dt)
    }
    // The strip rolls its digits; four times a second is plenty.
    if (now - lastStrip > 250) {
      lastStrip = now
      shell.setScore(Math.floor(attention).toLocaleString('en-US'))
      shell.setMoves(clicks.toLocaleString('en-US'))
    }

    // Ease toward the target rather than stepping to it. Buying a layer should
    // feel like a fader being pushed up, not like a switch.
    const target = owned.size / UPGRADES.length
    load += (target - load) * Math.min(1, dt * 1.6)
    if (stopping) calm = Math.min(1, calm + dt * 1.1)

    // Cools on its own once you stop, so the button is a readout of how hard
    // you are currently going rather than a latch on your best run.
    const hot = Math.max(0, 1 - (now - comboAt) / 900) * (combo / 12)
    world.style.setProperty('--combo', hot.toFixed(3))
    if (prefersReducedMotion) press.x = press.to
    else {
      press.v += (900 * (press.to - press.x) - 26 * press.v) * dt
      press.x += press.v * dt
    }
    bigBtn.style.setProperty('--press', press.x.toFixed(3))

    /* Under reduced motion the shared ticker never runs, so the surface has to
       be asked for a frame. Only when something it depends on has actually
       moved, though: redrawing every frame would just be animating it again by
       the back door. */
    if (prefersReducedMotion && Math.abs(load + calm - lastDrawn) > 0.004) {
      lastDrawn = load + calm
      sky.redraw()
    }

    // The constant shake is applied here rather than in CSS so it can stack
    // with the tilt without the two animations fighting.
    if (world.classList.contains('has-shake') && !prefersReducedMotion) {
      shakeSeed += dt * 60
      const k = world.classList.contains('has-everything') ? 5 : 2.2
      world.style.setProperty('--sx', (Math.sin(shakeSeed * 1.7) * k).toFixed(2) + 'px')
      world.style.setProperty('--sy', (Math.cos(shakeSeed * 2.3) * k).toFixed(2) + 'px')
    }

    // Ghost cursors chase the real one, each one lagging a little more. They
    // live in the room, so the pointer is taken into the room's own space.
    const wr = cursorEls.length ? world.getBoundingClientRect() : null
    cursorEls.forEach((c, i) => {
      const lag = 0.16 - Math.min(0.14, i * 0.006)
      const cx = Number(c.dataset.x || cursorPos.x)
      const cy = Number(c.dataset.y || cursorPos.y)
      const nx = cx + (cursorPos.x - cx) * lag
      const ny = cy + (cursorPos.y - cy) * lag
      c.dataset.x = String(nx); c.dataset.y = String(ny)
      c.style.transform = 'translate(' + (nx - wr!.left) + 'px,' + (ny - wr!.top) + 'px)'
    })

    requestAnimationFrame(loop)
  }

  // ---- the off switch ----------------------------------------------------
  let stopping = false
  let shareCard: import('../lib/result-card').ResultCard | null = null

  el('stopBtn').addEventListener('click', () => {
    // The loop fades 'calm' in from here; the shader multiplies every layer out
    // by it, so the room goes quiet over about a second instead of cutting.
    stopping = true
    rainbow = false
    for (const t of timers) clearInterval(t)
    timers.length = 0
    cursorEls.forEach((c) => c.remove())
    cursorEls = []
    world.querySelectorAll('.notif, .achv, .popup, .runner').forEach((n) => n.remove())
    confetti.clear()
    world.className = 'world calm'
    world.style.removeProperty('--sx')
    world.style.removeProperty('--sy')

    const secs = Math.round((performance.now() - started) / 1000)
    shell.pick('Last upgrade before stopping', lastBought)

    const stat = recordPlay(
      'overstimulated',
      { clicks, upgrades: owned.size, seconds: secs },
      { clicks: 'high', upgrades: 'high' },
    )
    shareCard = {
      slug: 'overstimulated',
      siteName: SITE.name,
      /* What you did is click. The number is the joke, so it is the headline
         rather than a chip. */
      headline: clicks.toLocaleString('en-US') + ' clicks',
      sub:
        `${owned.size} of ${UPGRADES.length} upgrades, in ${Math.floor(secs / 60)}m ${secs % 60}s, ` +
        'before deciding that was enough.' +
        (stat.plays > 1 ? ` Session ${stat.plays}.` : ''),
      stats: [
        { label: 'Upgrades', value: `${owned.size} / ${UPGRADES.length}` },
        { label: 'Minutes', value: String(Math.max(1, Math.round(secs / 60))) },
        { label: 'Per second', value: (clicks / Math.max(1, secs)).toFixed(1) },
      ],
    }

    if (clicks > 0) shell.considerBest(clicks, clicks.toLocaleString('en-US'))
    shell.win({
      celebrate: false,
      kicker: 'You made it stop',
      title: 'Quiet.',
      score: clicks.toLocaleString('en-US'),
      lines: [
        `${clicks.toLocaleString('en-US')} click${clicks === 1 ? '' : 's'}, ${owned.size} of ${UPGRADES.length} upgrades, ${Math.floor(secs / 60)}m ${secs % 60}s.`,
        'That took a surprising amount of clicking.',
      ],
      againLabel: 'Do it again',
    })
    shell.resultExtra.innerHTML =
      '<div class="os-report-acts"><button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share this</span></button></div>'
    el('shareBtn').addEventListener('click', async (e) => {
      if (!shareCard) return
      const label = (e.currentTarget as HTMLElement).querySelector('span')!
      const outcome = await shareResult(shareCard, { title: 'Overstimulated', text: `${shareCard.headline}, and then I stopped.`, url: location.href })
      label.textContent = outcomeLabel[outcome]
      setTimeout(() => (label.textContent = 'Share this'), 1600)
    })
    el('stopBtn').hidden = true
  })

  shell.setLevel(`0 / ${UPGRADES.length}`)
  if (import.meta.env.DEV) (window as any).__over = {
    add(n: number) { attention += n; paint() },
    buy(id: string) { const up = UPGRADES.find((u) => u.id === id)!; attention = Math.max(attention, up.cost); purchase(up, cards.get(id)!) },
    click() { el('bigBtn').click() },
    marbles,
  }

  paint()
  requestAnimationFrame(loop)
</script>

<style is:global>
