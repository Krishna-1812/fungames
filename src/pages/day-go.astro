---
import GameShell from '../layouts/GameShell.astro'
import { withBase } from '../lib/base'

/**
 * Where Does The Day Go? — a live instrument, not a runner over stages.
 *
 * The day is a ring of glass lying on a sheet of paper (lib/day-glass.ts):
 * twenty-four hours clockwise from waking, one block of coloured glass for
 * each part of it. The ring stays on screen while the page scrolls past it,
 * and each section tells it one more thing the tidy estimate left out — the
 * morning, the meals, the trip there and back, then the interruptions,
 * which saw it into pieces and frost the twenty-three minutes after each cut
 * into work. Scroll back up and it is whole again.
 *
 * Every slider feeds the same pure function, `src/lib/day-model.ts`'s
 * `computeDay`, which lays the day out in order and says where each cut
 * lands; the glass only draws that. Work and sleep are sliders and home is
 * what they leave of twenty-four hours, so the ring is always a whole day,
 * and nothing carved out of it later ever makes it longer.
 *
 * Each later section's sliders start at 0 and take a sensible default the
 * first time that section scrolls into view — pacing, never a gate.
 *
 * The one number on the page that is not a slider is `REFOCUS_MINUTES`:
 * Gloria Mark's published 23 minutes 15 seconds to get back to a task.
 * `scripts/check-day-model.mjs` checks the arithmetic and the citation.
 *
 * In the shell it is a paper page. Score is the real work left in the day,
 * Pieces how many pieces the day is in, Moves the interruptions, and Best
 * the most real work kept. Reaching the reckoning at the bottom is the
 * ending; the card under it is the summary, and a share.
 */
---

<GameShell
  slug="day-go"
  labels={{ score: 'Real work', best: 'Most kept', level: 'Pieces', moves: 'Interruptions' }}
  initial={{ score: '8.0h', level: '3', moves: '0' }}
>
  <div class="day-body">
    <div class="dg-bg" aria-hidden="true">
      <canvas class="dg-canvas"></canvas>
      <canvas class="dg-flat" hidden></canvas>
      <div class="dg-hud">
        <p class="dg-hud-title" id="hudTitle">Your day, as you would describe it</p>
        <div class="dg-legend" id="legend"></div>
      </div>
    </div>

    <header class="dg-head dg-sec" id="sec-basics">
      <div class="dg-card">
        <p class="label meta dg-eyebrow">A live instrument, not a quiz</p>
        <h1 class="dg-title">Where does the day go?</h1>
        <p class="dg-lead">
          Here are your twenty-four hours as a ring of glass, one block for each
          part of the day, clockwise from the moment you wake. Set it to what
          you think a day looks like, then keep scrolling: we're going to find
          everything that estimate left out, without ever making the day any
          longer than it is.
        </p>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>Work / school</b><i id="v-work">8h</i></span>
          <input type="range" id="workHours" min="0" max="16" step="0.5" value="8">
        </label>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>Sleep</b><i id="v-sleep">8h</i></span>
          <input type="range" id="sleepHours" min="0" max="12" step="0.5" value="8">
        </label>
        <p class="dg-home">
          <span><b>Home</b>, which is whatever is left</span><i id="v-home">8h</i>
        </p>
        <p class="dg-note">Three tidy pieces. It's beautiful. It doesn't stay that way, so keep scrolling.</p>
      </div>
    </header>

    <section class="dg-sec" id="sec-morning">
      <div class="dg-card">
        <h2>The part before work even starts</h2>
        <p>
          Getting up, showering, getting dressed: none of that was ever "home"
          time in the sense you meant it. It's carved out of home now, not
          added on top. Watch the mint glass give it up.
        </p>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>Morning routine</b><i id="v-morning">0m</i></span>
          <input type="range" id="morningMin" min="0" max="120" step="5" value="0">
        </label>
      </div>
    </section>

    <section class="dg-sec" id="sec-meals">
      <div class="dg-card">
        <h2>And you have to eat. Twice.</h2>
        <p>Lunch comes out of the middle of work. Dinner comes out of the middle of home.</p>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>Lunch</b><i id="v-lunch">0m</i></span>
          <input type="range" id="lunchMin" min="0" max="90" step="5" value="0">
        </label>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>Dinner</b><i id="v-dinner">0m</i></span>
          <input type="range" id="dinnerMin" min="0" max="90" step="5" value="0">
        </label>
      </div>
    </section>

    <section class="dg-sec" id="sec-commute">
      <div class="dg-card">
        <h2>Unless you teleport to work</h2>
        <p>Counted there and back: both trips happen, even if only one felt worth mentioning.</p>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>Commute, one way</b><i id="v-commute">0m</i></span>
          <input type="range" id="commuteMin" min="0" max="90" step="5" value="0">
        </label>
        <p class="dg-note">The day is in ten pieces now, and not one of those sliders made it any longer. Now for the part that does the damage.</p>
      </div>
    </section>

    <section class="dg-sec" id="sec-phone">
      <div class="dg-card">
        <h2>Now the part that actually does the damage</h2>
        <p>
          Everything so far only relabelled the day honestly. This is the first
          thing that cuts it. Each interruption is a saw cut where it lands, and
          the twenty-three minutes after a cut into work are frosted: that is how
          long it takes to get properly back to what you were doing.
        </p>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>How often you check your phone</b><i id="v-phone">off</i></span>
          <input type="range" id="phoneStep" min="0" max="13" step="1" value="0">
        </label>
        <p class="dg-source">Published estimates run from roughly 80 to over 200 checks a day: every five to twelve waking minutes. The page starts you at every half hour, gentler than any of them.</p>
        <label class="dg-slider">
          <span class="dg-slider-label"><b>Other interruptions, in a typical day</b><i id="v-extra">0</i></span>
          <input type="range" id="extraDistractionsPerDay" min="0" max="20" step="1" value="0">
        </label>
        <ul class="dg-common" aria-label="Common examples">
          <li>A co-worker with a quick question</li>
          <li>An email that wasn't actually urgent</li>
          <li>A notification you didn't need to open</li>
          <li>Someone else in the house needing something</li>
          <li>A pet deciding this was the moment</li>
        </ul>
      </div>
    </section>

    <section class="dg-sec dg-results" id="sec-results">
      <div class="dg-card">
        <h2>So here's what's actually happening</h2>
        <p class="dg-piece-line" id="pieceLine">Your day started as 3 pieces. Right now it's 3.</p>
        <div class="dg-worklines">
          <div class="dg-workline">
            <span>Work you think you're doing</span>
            <b id="perceivedWork">8.0h</b>
          </div>
          <div class="dg-workline dg-actual">
            <span>Work you're actually doing <small>(the clear cobalt glass)</small></span>
            <b id="actualWork">8.0h</b>
          </div>
        </div>
        <p class="dg-lost" id="lostLine"></p>
        <p class="dg-source" id="refocusSource"></p>
        <p class="dg-clock" id="clockLine"></p>

        <details class="how">
          <summary>How this actually works</summary>
          <p>
            Work and sleep are sliders, and home is what they leave of
            twenty-four hours, so the ring is always one whole day. Every slider
            after that (the morning, lunch, dinner, the commute) is carved out of
            work or home rather than added on top: the day never grows, it just
            gets more honest about what was always inside it.
          </p>
          <p>
            The day is laid out in order from waking: the morning, the trip in,
            work with lunch in the middle of it, the trip home, the evening with
            dinner in the middle of it, then sleep. The phone is checked every so
            many minutes from the moment you wake; the other interruptions land at
            scattered moments of the waking day. Each one cuts the glass where it
            lands.
          </p>
          <p>
            The cost of an interruption is a published figure rather than a guess:
            Gloria Mark, at UC Irvine, tracked information workers through real
            interruptions and found an average of 23 minutes 15 seconds to fully
            return to a task afterwards ("The Cost of Interrupted Work: More Speed
            and Stress," CHI 2008). Here, the first 23 minutes 15 seconds after
            each cut into work, or as much of it as there is before the next cut,
            is frosted, and "work you're actually doing" is the clear glass left.
            It is a model, not a measurement of your day: the figure is real, and
            the way the page applies it is the page's own.
          </p>
          <p>Related: <a href={withBase('/progress/')}>Progress</a> is the other page here about how much of something is already gone, computed live rather than looked up.</p>
        </details>
      </div>
    </section>
  </div>

  <Fragment slot="howto">
    <p>
      Set work and sleep to what a typical day looks like; home is whatever they
      leave. Then keep scrolling: each section finds something that estimate left out.
    </p>
    <ul>
      <li>The morning, meals and the commute are carved out of the day you already have; none of them makes it longer.</li>
      <li>Then the interruptions saw the ring into pieces, and the time it takes to get back to work after each one turns the glass frosted.</li>
      <li>Every slider can be moved at any time. Scroll back up and the day is whole again.</li>
    </ul>
    <p>The reckoning at the bottom is the end. Your best is the most real work you have kept in a day.</p>
  </Fragment>
</GameShell>

<script>
  import { computeDay, hoursLeftToday, SOURCES, GLASS_TINT, type DayInputs, type DayModel, type Piece as DayPiece } from '../lib/day-model'
  import type { DayGlass } from '../lib/day-glass'
  import { recordPlay } from '../lib/stats'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { SITE } from '../site.config'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'

  const prefersReducedMotion = !PLAY
  // Restart is a reload, the default: every slider back where it started.
  const shell = createShell({ slug: 'day-go' })

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T

  const SEG_LABEL: Record<string, string> = {
    morning: 'Morning routine', commute: 'Commute', work: 'Work / school',
    lunch: 'Lunch', home: 'Home', dinner: 'Dinner', sleep: 'Sleep',
  }

  /** The phone slider's stops, in minutes between checks (0 is never). */
  const PHONE = [0, 60, 45, 40, 30, 25, 20, 15, 12, 10, 8, 7, 6, 5]
  const phoneStepOf = (min: number) => Math.max(0, PHONE.indexOf(min))

  const state: DayInputs = {
    workHours: 8, homeHours: 8, sleepHours: 8,
    morningMin: 0, lunchMin: 0, dinnerMin: 0, commuteMin: 0,
    phoneIntervalMin: 0, extraDistractionsPerDay: 0,
  }

  const PICK_ROW: Record<string, string> = {
    workHours: 'Work / school, hours', sleepHours: 'Sleep, hours',
    morningMin: 'Morning routine, minutes', lunchMin: 'Lunch, minutes', dinnerMin: 'Dinner, minutes',
    commuteMin: 'Commute one way, minutes', phoneStep: 'Phone checked every, minutes',
    extraDistractionsPerDay: 'Other interruptions a day',
  }

  const fmtH = (h: number) => `${h.toFixed(1)}h`
  const fmtHM = (h: number) => (Math.abs(h - Math.round(h)) < 0.01 ? `${Math.round(h)}h` : `${Math.floor(h)}h ${Math.round((h % 1) * 60)}m`)
  const fmtMin = (m: number) => (m >= 60 ? `${(m / 60).toFixed(m % 60 ? 1 : 0)}h` : `${Math.round(m)}m`)

  /* ------------------------------------------------------------------ */
  /* The stage: one ring of glass, told one more thing per section.       */
  /* ------------------------------------------------------------------ */

  const CHECKPOINTS: { id: string; title: string; keys: (keyof DayInputs)[] }[] = [
    { id: 'sec-basics', title: 'Your day, as you would describe it', keys: [] },
    { id: 'sec-morning', title: 'Your day, with the morning in it', keys: ['morningMin'] },
    { id: 'sec-meals', title: 'Your day, with meals in it', keys: ['morningMin', 'lunchMin', 'dinnerMin'] },
    { id: 'sec-commute', title: 'Your day, there and back', keys: ['morningMin', 'lunchMin', 'dinnerMin', 'commuteMin'] },
    { id: 'sec-phone', title: 'Your day, cut where the interruptions land', keys: ['morningMin', 'lunchMin', 'dinnerMin', 'commuteMin', 'phoneIntervalMin', 'extraDistractionsPerDay'] },
    { id: 'sec-results', title: 'Your day, as it is lived', keys: ['morningMin', 'lunchMin', 'dinnerMin', 'commuteMin', 'phoneIntervalMin', 'extraDistractionsPerDay'] },
  ]
  let active = 0

  /** Only what the section in view has found out about so far: an early
   *  section's ring doesn't know about a slider it hasn't introduced yet. */
  function partialState(keys: (keyof DayInputs)[]): DayInputs {
    const only = new Set(keys)
    const out = { ...state }
    for (const k of ['morningMin', 'lunchMin', 'dinnerMin', 'commuteMin', 'phoneIntervalMin', 'extraDistractionsPerDay'] as const) {
      if (!only.has(k)) out[k] = 0
    }
    return out
  }

  const canvas = document.querySelector<HTMLCanvasElement>('.dg-canvas')!
  let glass: DayGlass | null = null
  let flatPieces: { pieces: DayPiece[]; total: number } | null = null

  // The ring sits to the right of the words on a wide window and above them on a narrow one.
  const wide = matchMedia('(min-width: 900px)')
  const framing = () => (wide.matches ? { x: 0.7, y: 0.5, size: 0.84 } : { x: 0.5, y: 0.41, size: 1.0 })

  /** Without WebGL: the same ring, flat, in the same colours. */
  function drawFlat() {
    const c = document.querySelector<HTMLCanvasElement>('.dg-flat')!
    if (!flatPieces) return
    const w = c.clientWidth, h = c.clientHeight, dpr = Math.min(2, devicePixelRatio || 1)
    c.width = w * dpr; c.height = h * dpr
    const x = c.getContext('2d')!
    x.scale(dpr, dpr)
    const f = framing(), R = (f.size * Math.min(w, h)) / 2 / 1.36, cx = f.x * w, cy = f.y * h
    const { pieces, total } = flatPieces
    for (const p of pieces) {
      const a0 = (p.start / total) * Math.PI * 2 - Math.PI / 2, a1 = (p.end / total) * Math.PI * 2 - Math.PI / 2
      const g = p.cut ? 0.012 : 0.002
      x.beginPath(); x.arc(cx, cy, R, a0 + g, a1 - g); x.arc(cx, cy, R * 0.73, a1 - g, a0 + g, true); x.closePath()
      x.fillStyle = GLASS_TINT[p.key]; x.fill()
      if (p.frost > 0) {
        const af = a0 + (p.frost / total) * Math.PI * 2
        x.beginPath(); x.arc(cx, cy, R, a0 + g, af); x.arc(cx, cy, R * 0.73, af, a0 + g, true); x.closePath()
        x.fillStyle = 'rgba(240,244,250,0.72)'; x.fill()
      }
    }
  }

  function paintStage(instant = false) {
    const cp = CHECKPOINTS[active]
    const m = computeDay(partialState(cp.keys))
    $('hudTitle').textContent = cp.title
    const frost = m.pieces.reduce((s, p) => s + p.frost, 0)
    $('legend').innerHTML =
      m.segments
        .filter((s) => s.hours > 0.05)
        .map((s) => `<span class="dg-chip"><i style="--c:${GLASS_TINT[s.key]}"></i>${SEG_LABEL[s.key]} <b>${fmtHM(s.hours)}</b></span>`)
        .join('') +
      (frost > 0.01 ? `<span class="dg-chip dg-chip--frost"><i></i>Getting back to work <b>${fmtHM(frost)}</b></span>` : '') +
      `<span class="dg-chip dg-chip--count">${m.pieceCountAfter} piece${m.pieceCountAfter === 1 ? '' : 's'}</span>`
    if (glass) glass.set(m.pieces, m.totalHours, { instant: instant || prefersReducedMotion })
    else { flatPieces = { pieces: m.pieces, total: m.totalHours }; drawFlat() }
  }

  function render() {
    paintStage()
    const m = computeDay(state)
    $('pieceLine').textContent =
      `Your day started as ${m.pieceCountBefore} piece${m.pieceCountBefore === 1 ? '' : 's'}. ` +
      `Right now it's ${m.pieceCountAfter}${m.totalInterruptions ? `, cut apart by ${m.totalInterruptions} interruption${m.totalInterruptions === 1 ? '' : 's'} a day` : ''}.`
    $('perceivedWork').textContent = fmtH(m.perceivedWorkHours)
    $('actualWork').textContent = fmtH(m.actualWorkHours)
    $('lostLine').textContent =
      m.lostWorkMinutes > 0.5
        ? `That's ${Math.round(m.lostWorkMinutes)} minutes a day spent getting back to work rather than doing it: ${(m.lostWorkMinutes / 60).toFixed(1)} hours, or roughly ${Math.max(1, Math.round(m.lostWorkMinutes / 110))} feature-length film${Math.round(m.lostWorkMinutes / 110) > 1 ? 's' : ''}, every single day.`
        : 'At this rate, almost none of it is lost to refocusing. Try checking your phone more often.'
    $('refocusSource').textContent = SOURCES.refocus
    shell.setScore(fmtH(m.actualWorkHours))
    shell.setLevel(String(m.pieceCountAfter))
    shell.setMoves(String(m.totalInterruptions))
  }

  /* ------------------------------------------------------------------ */
  /* Sliders                                                             */
  /* ------------------------------------------------------------------ */

  const fill = (i: HTMLInputElement) => i.style.setProperty('--p', `${((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100}%`)
  const input = (id: string) => $<HTMLInputElement>(id)

  function readouts() {
    $('v-work').textContent = fmtHM(state.workHours)
    $('v-sleep').textContent = fmtHM(state.sleepHours)
    $('v-home').textContent = fmtHM(state.homeHours)
    $('v-morning').textContent = fmtMin(state.morningMin)
    $('v-lunch').textContent = fmtMin(state.lunchMin)
    $('v-dinner').textContent = fmtMin(state.dinnerMin)
    $('v-commute').textContent = fmtMin(state.commuteMin)
    const waking = 24 - state.sleepHours
    $('v-phone').textContent = state.phoneIntervalMin > 0
      ? `every ${state.phoneIntervalMin} min · ${Math.round((waking * 60) / state.phoneIntervalMin)} a day`
      : 'never'
    $('v-extra').textContent = String(Math.round(state.extraDistractionsPerDay))
  }

  /** Reads every slider into the state. Home is what work and sleep leave of a day. */
  function syncStateFromDOM(changed?: string) {
    let work = Number(input('workHours').value), sleep = Number(input('sleepHours').value)
    if (work + sleep > 24) {
      if (changed === 'sleepHours') work = 24 - sleep
      else sleep = 24 - work
      input('workHours').value = String(work); input('sleepHours').value = String(sleep)
      fill(input('workHours')); fill(input('sleepHours'))
    }
    state.workHours = work
    state.sleepHours = sleep
    state.homeHours = Math.max(0, 24 - work - sleep)
    for (const k of ['morningMin', 'lunchMin', 'dinnerMin', 'commuteMin', 'extraDistractionsPerDay'] as const) state[k] = Number(input(k).value)
    state.phoneIntervalMin = PHONE[Number(input('phoneStep').value)] ?? 0
    readouts()
  }

  document.querySelectorAll<HTMLInputElement>('.dg-sec input[type="range"]').forEach((el) => {
    fill(el)
    el.addEventListener('input', () => {
      fill(el)
      syncStateFromDOM(el.id)
      render()
    })
    // The value let go of, once the slider has settled.
    let settle = 0
    el.addEventListener('change', () => {
      clearTimeout(settle)
      const v = el.id === 'phoneStep' ? PHONE[Number(el.value)] : Number(el.value)
      settle = window.setTimeout(() => shell.pick('Typical day, as set', v, PICK_ROW[el.id]), 1500)
    })
  })

  /* ------------------------------------------------------------------ */
  /* Share + record. Declared before the pacing below on purpose: the     */
  /* first check can reach the reckoning at once on a page that loads     */
  /* already scrolled down, and a `let` read before its declaration runs  */
  /* throws.                                                              */
  /* ------------------------------------------------------------------ */

  let shareCard: import('../lib/result-card').ResultCard | null = null

  function updateShareCard() {
    const m = computeDay(state)
    shareCard = {
      slug: 'day-go',
      siteName: SITE.name,
      headline: `${fmtH(m.actualWorkHours)} of real work out of ${fmtH(m.perceivedWorkHours)}`,
      sub: `${m.pieceCountAfter} pieces a day, ${m.totalInterruptions} interruptions.`,
      stats: [
        { label: 'Perceived work', value: fmtH(m.perceivedWorkHours) },
        { label: 'Actual work', value: fmtH(m.actualWorkHours) },
        { label: 'Pieces', value: `${m.pieceCountAfter}` },
      ],
    }
    recordPlay('day-go', { actualWork: m.actualWorkHours, pieces: m.pieceCountAfter }, { actualWork: 'high' })
    finish(m)
  }

  /** The reckoning, as the shell's result card. It waits under the section
      rather than pulling the page past it. */
  function finish(m: DayModel) {
    if (m.actualWorkHours > 0) shell.considerBest(Math.round(m.actualWorkHours * 10), fmtH(m.actualWorkHours))
    shell.win({
      celebrate: false,
      scroll: false,
      kicker: `Out of ${fmtH(m.perceivedWorkHours)} you would call work`,
      title: m.actualWorkHours < 0.05 ? 'None of it is real work.' : `${fmtH(m.actualWorkHours)} of it is real work.`,
      score: fmtH(m.actualWorkHours),
      lines: [
        `${m.pieceCountAfter} pieces a day, cut apart by ${m.totalInterruptions} interruption${m.totalInterruptions === 1 ? '' : 's'}.`,
        m.lostWorkMinutes > 0.5 ? `${Math.round(m.lostWorkMinutes)} minutes a day go on getting back to what you were doing.` : 'Almost none of it goes on refocusing.',
      ],
      againLabel: 'Start the day again',
    })
    shell.resultExtra.innerHTML =
      '<div class="dg-report-acts"><button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share this</span></button></div>'
    $('shareBtn').addEventListener('click', async (e) => {
      if (!shareCard) return
      const label = (e.currentTarget as HTMLElement).querySelector('span')!
      const outcome = await shareResult(shareCard, { title: 'Where Does The Day Go?', text: `${shareCard.headline}.`, url: location.href })
      label.textContent = outcomeLabel[outcome]
      setTimeout(() => (label.textContent = 'Share this'), 1600)
    })
  }

  /* ------------------------------------------------------------------ */
  /* Pacing: each later section takes a real default the first time it   */
  /* scrolls into view, and the ring shows what the section in view knows. */
  /* One synchronous check on scroll, not IntersectionObserver: its        */
  /* callbacks are queued, and a jump straight to the reckoning could show */
  /* numbers from before the sections above it had taken their defaults.  */
  /* ------------------------------------------------------------------ */

  const DEFAULTS: Record<string, [string, number][]> = {
    'sec-morning': [['morningMin', 30]],
    'sec-meals': [['lunchMin', 30], ['dinnerMin', 30]],
    'sec-commute': [['commuteMin', 20]],
    'sec-phone': [['phoneStep', phoneStepOf(30)], ['extraDistractionsPerDay', 4]],
  }

  function activate(sectionId: string) {
    let any = false
    for (const [id, target] of DEFAULTS[sectionId] ?? []) {
      const el = input(id)
      if (!el || Number(el.value) !== 0) continue
      el.value = String(target)
      fill(el)
      any = true
    }
    return any
  }

  let recorded = false
  let reached = 1
  function checkSections() {
    let changed = false
    let now = 0
    CHECKPOINTS.forEach((cp, i) => {
      const el = $(cp.id)
      const top = el.getBoundingClientRect().top
      if (i > 0 && top < innerHeight * 0.9) {
        if (activate(cp.id)) changed = true
        if (i < 5 && i + 1 > reached) shell.progress(reached = i + 1)
      }
      // The section in view is the last one whose top has passed the middle of
      // the screen (or of the part of it under the ring, on a narrow one).
      if (i === 0 || top < innerHeight * (wide.matches ? 0.55 : 0.78)) now = i
    })
    const results = $('sec-results')
    if (!recorded && results.getBoundingClientRect().top < innerHeight) {
      for (const id of Object.keys(DEFAULTS)) if (activate(id)) changed = true
      recorded = true
      syncStateFromDOM()
      render()
      updateShareCard()
    }
    if (changed) syncStateFromDOM()
    if (changed || now !== active) { active = now; render() }
  }

  /* ------------------------------------------------------------------ */
  /* The glass, loaded after first paint; the page works without it.      */
  /* ------------------------------------------------------------------ */

  async function mountGlass() {
    try {
      const { createDayGlass } = await import('../lib/day-glass')
      glass = createDayGlass(canvas)
    } catch {
      glass = null
    }
    if (glass) {
      glass.frame(framing())
      wide.addEventListener('change', () => glass?.frame(framing()))
      paintStage(true)
    } else {
      canvas.hidden = true
      const flat = document.querySelector<HTMLCanvasElement>('.dg-flat')!
      flat.hidden = false
      new ResizeObserver(drawFlat).observe(flat)
      paintStage(true)
    }
  }

  syncStateFromDOM()
  render()
  mountGlass()

  if (prefersReducedMotion) {
    for (const id of Object.keys(DEFAULTS)) activate(id)
    syncStateFromDOM()
    recorded = true
    const io = new IntersectionObserver((rows) => {
      if (rows.some((r) => r.isIntersecting)) { io.disconnect(); syncStateFromDOM(); render(); updateShareCard() }
    })
    io.observe($('sec-results'))
  }
  let ticking = false
  addEventListener(
    'scroll',
    () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => { ticking = false; checkSections() })
    },
    { passive: true },
  )
  checkSections() // in case the page loads already scrolled (a reload, a deep link)

  /* ------------------------------------------------------------------ */
  /* The real clock                                                      */
  /* ------------------------------------------------------------------ */

  function paintClock() {
    const h = hoursLeftToday()
    const hh = Math.floor(h)
    const mm = Math.round((h - hh) * 60)
    $('clockLine').textContent = `You have ${hh}h ${mm}m left today, right now, for whatever this leaves you.`
  }
  paintClock()
  setInterval(paintClock, 30_000)
</script>

