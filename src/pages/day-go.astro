---
import GameLayout from '../layouts/GameLayout.astro'
import { withBase } from '../lib/base'

/**
 * Where Does The Day Go? — a live instrument, not a runner over stages.
 *
 * Every slider on this page feeds the same pure function,
 * `src/lib/day-model.ts`'s `computeDay`, which the day-bar redraws from on
 * every input event. The three headline sliders (work, home, sleep) always
 * summed to a tidy number; the point of the rest of the page is that
 * morning routine, meals and the commute were always happening *inside*
 * that tidy number, not on top of it — `computeDay` carves them out rather
 * than adding them on, so the bar never grows past where it started.
 *
 * Each later section's slider starts at 0 and animates in to a sensible
 * default the first time that section scrolls into view — a deliberate
 * pacing device (the day looks fine until you scroll to what it left out),
 * not a gate: nothing is locked, and moving a slider before its section
 * arrives works fine too.
 *
 * The one number on this whole page that is not a slider is
 * `REFOCUS_MINUTES` — Gloria Mark's real, published 23-minutes-15-seconds
 * figure for how long it takes to fully refocus after an interruption.
 * `scripts/check-day-model.mjs` checks the arithmetic and the citation both.
 */
---

<GameLayout slug="day-go" bar="#301a10" bodyClass="day-body">
  <div class="dg-bg" aria-hidden="true"></div>

  <header class="dg-head">
    <p class="dg-eyebrow">A live instrument, not a quiz</p>
    <h1>Where Does The Day Go?</h1>
    <p>
      Twenty-four hours felt like plenty this morning. Slide in what you
      think your day looks like, then keep scrolling — we're going to find
      everything that estimate left out, without ever making the day any
      longer than it already is.
    </p>
  </header>

  <main class="dg-body-content">
    <section class="dg-sec" id="sec-basics">
      <h2>First, your typical day</h2>
      <p>Take your time. This is just a rough sense of things.</p>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>Work / school</b><i id="v-work">8h</i></span>
        <input type="range" id="workHours" min="0" max="16" step="0.5" value="8">
      </label>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>Home</b><i id="v-home">8h</i></span>
        <input type="range" id="homeHours" min="0" max="16" step="0.5" value="8">
      </label>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>Sleep</b><i id="v-sleep">8h</i></span>
        <input type="range" id="sleepHours" min="0" max="12" step="0.5" value="8">
      </label>
      <p class="dg-note">Take your time and slide those. Done? Here's what your day looks like:</p>

      <div class="daybar" data-cp="basics">
        <p class="daybar-title">Your day</p>
        <div class="daybar-frame"><div class="daybar-col"></div></div>
        <div class="legend"></div>
        <p class="piececount"></p>
      </div>
      <p class="dg-note">It's beautiful. Obviously it doesn't stay that way — keep scrolling.</p>
    </section>

    <section class="dg-sec" id="sec-morning">
      <h2>The part before work even starts</h2>
      <p>
        Getting up, showering, getting dressed — none of that was ever
        "home" time in the sense you meant it. It's being carved out of
        your home block now, not added on top.
      </p>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>Morning routine</b><i id="v-morning">0m</i></span>
        <input type="range" id="morningMin" min="0" max="120" step="5" value="0">
      </label>

      <div class="daybar" data-cp="morning">
        <p class="daybar-title">Your day, updated</p>
        <div class="daybar-frame"><div class="daybar-col"></div></div>
        <div class="legend"></div>
        <p class="piececount"></p>
      </div>
    </section>

    <section class="dg-sec" id="sec-meals">
      <h2>And you have to eat. Twice.</h2>
      <p>Lunch comes out of work. Dinner comes out of home.</p>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>Lunch</b><i id="v-lunch">0m</i></span>
        <input type="range" id="lunchMin" min="0" max="90" step="5" value="0">
      </label>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>Dinner</b><i id="v-dinner">0m</i></span>
        <input type="range" id="dinnerMin" min="0" max="90" step="5" value="0">
      </label>

      <div class="daybar" data-cp="meals">
        <p class="daybar-title">Your day, degrading nicely</p>
        <div class="daybar-frame"><div class="daybar-col"></div></div>
        <div class="legend"></div>
        <p class="piececount"></p>
      </div>
    </section>

    <section class="dg-sec" id="sec-commute">
      <h2>Unless you teleport to work</h2>
      <p>Counted there and back — both trips happen, even if only one felt worth mentioning.</p>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>Commute, one way</b><i id="v-commute">0m</i></span>
        <input type="range" id="commuteMin" min="0" max="90" step="5" value="0">
      </label>

      <div class="daybar" data-cp="commute">
        <p class="daybar-title">Your day, fully honest so far</p>
        <div class="daybar-frame"><div class="daybar-col"></div></div>
        <div class="legend"></div>
        <p class="piececount"></p>
      </div>
      <p class="dg-note">Not one of those sliders made the day any longer. Now for the part that actually does.</p>
    </section>

    <section class="dg-sec" id="sec-phone">
      <h2>Now the part that actually does the damage</h2>
      <p>
        None of the above cut your day into more pieces — it just relabelled
        the same pieces honestly. This is the first thing that actually
        multiplies them.
      </p>
      <label class="dg-slider">
        <span class="dg-slider-label"><b>How often you check your phone</b><i id="v-phone">off</i></span>
        <input type="range" id="phoneIntervalMin" min="0" max="60" step="1" value="0">
      </label>
      <p class="dg-source">{'Published estimates of daily phone checks vary widely by study — roughly 80 to 200+ times a day. This page uses whichever interval you pick rather than asserting one.'}</p>

      <label class="dg-slider">
        <span class="dg-slider-label"><b>Other interruptions, in a typical day</b><i id="v-extra">0</i></span>
        <input type="range" id="extraDistractionsPerDay" min="0" max="20" step="1" value="0">
      </label>
      <ul class="dg-common" aria-label="Common examples">
        <li>A co-worker with a quick question</li>
        <li>An email that wasn't actually urgent</li>
        <li>A notification you didn't need to open</li>
        <li>Someone else in the house needing something</li>
        <li>A pet deciding this was the moment</li>
        <li>A thought about something completely unrelated</li>
      </ul>

      <div class="daybar daybar-big" data-cp="phone">
        <p class="daybar-title">Your day, shattered</p>
        <div class="daybar-frame"><div class="daybar-col"></div></div>
        <div class="legend"></div>
        <p class="piececount"></p>
      </div>
    </section>

    <section class="dg-sec dg-results" id="sec-results">
      <h2>So here's what's actually happening</h2>
      <p class="dg-piece-line" id="pieceLine">Your day started as 7 pieces. Right now it's 7.</p>

      <div class="dg-worklines">
        <div class="dg-workline">
          <span>Work you think you're doing</span>
          <b id="perceivedWork">8.0h</b>
        </div>
        <div class="dg-workline dg-actual">
          <span>Work you're actually doing</span>
          <b id="actualWork">8.0h</b>
        </div>
      </div>
      <p class="dg-lost" id="lostLine"></p>
      <p class="dg-source" id="refocusSource"></p>

      <p class="dg-clock" id="clockLine"></p>
    </section>

    <footer class="dg-outro">
      <div class="acts">
        <button type="button" data-share data-title="Where Does The Day Go?">Share this</button>
        <button type="button" id="again">Start over</button>
        <a href={withBase('/')}>try something else →</a>
      </div>

      <details class="how">
        <summary>How this actually works</summary>
        <p>
          The three headline sliders — work, home, sleep — set a total.
          Every slider after that (morning routine, lunch, dinner, commute)
          is carved out of "work" or "home" rather than added on top, so the
          bar never grows past the total you started with; it just gets
          more honest about what was always inside it.
        </p>
        <p>
          The interruption cost is a real, published figure rather than a
          guess: Gloria Mark, at UC Irvine, tracked information workers
          through real interruptions and found an average of 23 minutes 15
          seconds to fully return to a task afterwards — "The Cost of
          Interrupted Work: More Speed and Stress," CHI 2008. That number is
          fixed on this page on purpose; the only thing you control is how
          often the interruptions happen.
        </p>
        <p>
          "Work you're actually doing" applies that cost to however many of
          your interruptions statistically land inside your work block
          (proportional to how much of your waking day work takes up), then
          subtracts the total, floored at zero. It is a model, not a
          measurement of your specific day — the citation above is real; the
          way this page applies it to your sliders is this page's own.
        </p>
        <p>Related: <a href={withBase('/progress/')}>Progress</a> is the other page here about how much of something is already gone, computed live rather than looked up.</p>
      </details>
    </footer>
  </main>
</GameLayout>

<script>
  import { computeDay, hoursLeftToday, SOURCES, type DayInputs } from '../lib/day-model'
  import { recordPlay } from '../lib/stats'
  import { onShare } from '../lib/share-card'
  import { SITE } from '../site.config'
  import { prefersReducedMotion } from '../lib/fx'

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T

  const SEG_LABEL: Record<string, string> = {
    morning: 'Morning routine', commute: 'Commute', work: 'Work / school',
    lunch: 'Lunch', home: 'Home', dinner: 'Dinner', sleep: 'Sleep',
  }

  const state: DayInputs = {
    workHours: 8, homeHours: 8, sleepHours: 8,
    morningMin: 0, lunchMin: 0, dinnerMin: 0, commuteMin: 0,
    phoneIntervalMin: 0, extraDistractionsPerDay: 0,
  }

  const fmtH = (h: number) => `${h.toFixed(1)}h`
  const fmtMin = (m: number) => (m >= 60 ? `${(m / 60).toFixed(m % 60 ? 1 : 0)}h` : `${Math.round(m)}m`)

  /* ------------------------------------------------------------------ */
  /* Multiple day-bars, not one dock — each section gets its own fresh,   */
  /* large reveal of the day as it stands once that section's sliders are */
  /* folded in, echoing the way the real thing does this rather than      */
  /* shrinking the one visual that matters into a corner widget.          */
  /* ------------------------------------------------------------------ */

  type Bar = { col: HTMLElement; legend: HTMLElement; piece: HTMLElement; segEls: Map<string, HTMLElement> }

  const SEG_ORDER = ['morning', 'commute', 'work', 'lunch', 'home', 'dinner', 'sleep'] as const

  function buildBar(root: HTMLElement): Bar {
    const col = root.querySelector<HTMLElement>('.daybar-col')!
    const segEls = new Map<string, HTMLElement>()
    for (const key of SEG_ORDER) {
      const seg = document.createElement('div')
      seg.className = 'seg'
      seg.dataset.key = key
      const shine = document.createElement('i')
      seg.appendChild(shine)
      col.appendChild(seg)
      segEls.set(key, seg)
    }
    const cuts = document.createElement('div')
    cuts.className = 'cuts'
    cuts.setAttribute('aria-hidden', 'true')
    col.appendChild(cuts)
    return { col, legend: root.querySelector('.legend')!, piece: root.querySelector('.piececount')!, segEls }
  }

  const BARS = new Map<string, Bar>()
  document.querySelectorAll<HTMLElement>('.daybar').forEach((root) => {
    BARS.set(root.dataset.cp!, buildBar(root))
  })

  function paintBar(bar: Bar, m: ReturnType<typeof computeDay>) {
    for (const seg of m.segments) {
      const el = bar.segEls.get(seg.key)!
      const pct = m.totalHours > 0 ? (seg.hours / m.totalHours) * 100 : 0
      el.style.height = `${pct}%`
      el.classList.toggle('is-empty', pct < 0.3)
    }
    const nonSleepPct = m.totalHours > 0 ? (m.nonSleepHours / m.totalHours) * 100 : 0
    const cutsHost = bar.col.querySelector('.cuts')!
    cutsHost.innerHTML = m.cuts
      .map((f, i) => `<i style="top:${(f * nonSleepPct).toFixed(2)}%; animation-delay:${Math.min(i * 14, 900)}ms"></i>`)
      .join('')
    bar.legend.innerHTML = m.segments
      .filter((s) => s.hours > 0.05)
      .map((s) => `<span class="chip" data-key="${s.key}"><i></i>${SEG_LABEL[s.key]} · ${fmtH(s.hours)}</span>`)
      .join('')
    bar.piece.textContent = `${m.pieceCountAfter} piece${m.pieceCountAfter === 1 ? '' : 's'}.`
  }

  /** What each checkpoint has "found out about" so far — everything else is
   *  forced to 0, so an early bar doesn't quietly know about a slider its
   *  own section hasn't introduced yet, even if that slider already has a
   *  value because a later section activated first. */
  const CHECKPOINTS: { id: string; keys: (keyof DayInputs)[] }[] = [
    { id: 'basics', keys: [] },
    { id: 'morning', keys: ['morningMin'] },
    { id: 'meals', keys: ['morningMin', 'lunchMin', 'dinnerMin'] },
    { id: 'commute', keys: ['morningMin', 'lunchMin', 'dinnerMin', 'commuteMin'] },
    { id: 'phone', keys: ['morningMin', 'lunchMin', 'dinnerMin', 'commuteMin', 'phoneIntervalMin', 'extraDistractionsPerDay'] },
  ]

  function partialState(keys: (keyof DayInputs)[]): DayInputs {
    const only = new Set(keys)
    return {
      workHours: state.workHours, homeHours: state.homeHours, sleepHours: state.sleepHours,
      morningMin: only.has('morningMin') ? state.morningMin : 0,
      lunchMin: only.has('lunchMin') ? state.lunchMin : 0,
      dinnerMin: only.has('dinnerMin') ? state.dinnerMin : 0,
      commuteMin: only.has('commuteMin') ? state.commuteMin : 0,
      phoneIntervalMin: only.has('phoneIntervalMin') ? state.phoneIntervalMin : 0,
      extraDistractionsPerDay: only.has('extraDistractionsPerDay') ? state.extraDistractionsPerDay : 0,
    }
  }

  function render() {
    for (const cp of CHECKPOINTS) {
      const bar = BARS.get(cp.id)
      if (bar) paintBar(bar, computeDay(partialState(cp.keys)))
    }

    const m = computeDay(state)
    $('pieceLine').textContent =
      `Your day started as ${m.pieceCountBefore} piece${m.pieceCountBefore === 1 ? '' : 's'}. ` +
      `Right now it's ${m.pieceCountAfter}${m.totalInterruptions ? `, cut apart by ${m.totalInterruptions} interruption${m.totalInterruptions === 1 ? '' : 's'} a day` : ''}.`

    $('perceivedWork').textContent = fmtH(m.perceivedWorkHours)
    $('actualWork').textContent = fmtH(m.actualWorkHours)
    $('lostLine').textContent =
      m.lostWorkMinutes > 0.5
        ? `That's ${Math.round(m.lostWorkMinutes)} minutes a day spent refocusing rather than working — about ${(m.lostWorkMinutes / 60).toFixed(1)} hours, or roughly ${Math.max(1, Math.round(m.lostWorkMinutes / 110))} average feature-length films, every single day.`
        : 'At this rate, almost none of it is lost to refocusing. Try raising how often you check your phone.'
    $('refocusSource').textContent = SOURCES.refocus
  }

  document.querySelectorAll<HTMLInputElement>('.dg-sec input[type="range"]').forEach((input) => {
    input.addEventListener('input', () => {
      const key = input.id as keyof DayInputs
      state[key] = Number(input.value)
      if (key === 'workHours') $('v-work').textContent = fmtH(state.workHours)
      if (key === 'homeHours') $('v-home').textContent = fmtH(state.homeHours)
      if (key === 'sleepHours') $('v-sleep').textContent = fmtH(state.sleepHours)
      if (key === 'morningMin') $('v-morning').textContent = fmtMin(state.morningMin)
      if (key === 'lunchMin') $('v-lunch').textContent = fmtMin(state.lunchMin)
      if (key === 'dinnerMin') $('v-dinner').textContent = fmtMin(state.dinnerMin)
      if (key === 'commuteMin') $('v-commute').textContent = fmtMin(state.commuteMin)
      if (key === 'phoneIntervalMin') $('v-phone').textContent = state.phoneIntervalMin > 0 ? `every ${Math.round(state.phoneIntervalMin)}m` : 'off'
      if (key === 'extraDistractionsPerDay') $('v-extra').textContent = String(Math.round(state.extraDistractionsPerDay))
      render()
    })
  })

  /* ------------------------------------------------------------------ */
  /* Each later section activates its slider to a real default the first */
  /* time it scrolls into view — a pacing device, never a gate.          */
  /* ------------------------------------------------------------------ */

  const DEFAULTS: Partial<Record<keyof DayInputs, number>> = {
    morningMin: 30, lunchMin: 30, dinnerMin: 30, commuteMin: 20,
    phoneIntervalMin: 15, extraDistractionsPerDay: 4,
  }
  const SECTION_KEYS: Record<string, (keyof DayInputs)[]> = {
    'sec-morning': ['morningMin'],
    'sec-meals': ['lunchMin', 'dinnerMin'],
    'sec-commute': ['commuteMin'],
    'sec-phone': ['phoneIntervalMin', 'extraDistractionsPerDay'],
  }

  function activate(sectionId: string) {
    for (const key of SECTION_KEYS[sectionId] ?? []) {
      const el = document.getElementById(key) as HTMLInputElement | null
      if (!el || Number(el.value) !== 0) continue
      const target = DEFAULTS[key]!
      el.value = String(target)
      el.dispatchEvent(new Event('input', { bubbles: true }))
    }
  }

  /* ------------------------------------------------------------------ */
  /* One synchronous, scroll-driven check — not IntersectionObserver.     */
  /*                                                                      */
  /* An earlier version used IntersectionObserver for this (one instance  */
  /* per pacing section, plus a second instance watching the results      */
  /* section as a "did anything get skipped" safety net). Both instances  */
  /* worked, but IntersectionObserver callbacks are asynchronous by spec — */
  /* queued after layout rather than run inline — and jumping straight to */
  /* the results section (a real path: a11y "skip to results" navigation, */
  /* a fast trackpad flick, or simply this page's own `sec-results`       */
  /* scrollIntoView safety net firing before the *other* four observers'  */
  /* callbacks had been dispatched) could show the results section with   */
  /* stale, half-activated numbers for one to a few hundred milliseconds  */
  /* before the second observer's callback finally ran and corrected it.  */
  /* A `getBoundingClientRect` check driven by `scroll` + `requestAnimationFrame`  */
  /* is synchronous with the frame it runs in — there is no callback queue */
  /* to be behind — so the results section can never render a number      */
  /* before every earlier section has already been activated.             */
  /* ------------------------------------------------------------------ */

  const PACING_SECTIONS = Object.keys(SECTION_KEYS)
  let recorded = false

  /** Reads every slider's live DOM value straight into `state`, bypassing
   *  the input-event round trip entirely. `activate()` sets `.value` and
   *  dispatches a synthetic `input` event for the normal case (so typing in
   *  a slider and a section merely scrolling into view go through the same
   *  one code path) — but a *smooth* scroll (this site sets
   *  `scroll-behavior: smooth` globally) fires a real `scroll` event on
   *  nearly every animation frame of the scroll, and `checkSections` below
   *  runs on each one. Several `activate()` calls landing across
   *  consecutive frames, each synchronously dispatching and handling its
   *  own `input` event, is exactly the kind of interleaving that is easy to
   *  reason about wrong; reading the DOM directly has no such ordering to
   *  get wrong. This is what the results section actually relies on. */
  function syncStateFromDOM() {
    for (const key of Object.keys(state) as (keyof DayInputs)[]) {
      const el = document.getElementById(key) as HTMLInputElement | null
      if (el) state[key] = Number(el.value)
    }
  }

  function checkSections() {
    for (const id of PACING_SECTIONS) {
      const el = document.getElementById(id)
      if (el && el.getBoundingClientRect().top < innerHeight * 0.9) activate(id)
    }
    const results = document.getElementById('sec-results')
    if (!recorded && results && results.getBoundingClientRect().top < innerHeight) {
      // Belt and suspenders: whatever might have kept an earlier section
      // from activating on its own (this loop runs first every time, so in
      // the ordinary case there is nothing left to do here) is caught here
      // too, before the results section is allowed to compute anything.
      for (const id of PACING_SECTIONS) activate(id)
      recorded = true
      syncStateFromDOM()
      render()
      updateShareCard()
    }
  }

  if (prefersReducedMotion) {
    for (const id of PACING_SECTIONS) activate(id)
    recorded = true
  } else {
    let ticking = false
    addEventListener(
      'scroll',
      () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => { ticking = false; checkSections() })
      },
      { passive: true },
    )
    checkSections() // in case the page loads already scrolled (a reload, a deep link)
  }

  /* ------------------------------------------------------------------ */
  /* The real clock                                                      */
  /* ------------------------------------------------------------------ */

  function paintClock() {
    const h = hoursLeftToday()
    const hh = Math.floor(h)
    const mm = Math.round((h - hh) * 60)
    $('clockLine').textContent = `You have ${hh}h ${mm}m left today, right now, for whatever this leaves you.`
  }
  paintClock()
  setInterval(paintClock, 30_000)

  /* ------------------------------------------------------------------ */
  /* Share + record                                                      */
  /* ------------------------------------------------------------------ */

  let shareCard: import('../lib/result-card').ResultCard | null = null
  onShare(() => shareCard, (c) => ({ title: 'Where Does The Day Go?', text: `${c.headline}.` }))

  function updateShareCard() {
    const m = computeDay(state)
    shareCard = {
      slug: 'day-go',
      siteName: SITE.name,
      headline: `${fmtH(m.actualWorkHours)} of real work out of ${fmtH(m.perceivedWorkHours)}`,
      sub: `${m.pieceCountAfter} pieces a day, ${m.totalInterruptions} interruptions.`,
      stats: [
        { label: 'Perceived work', value: fmtH(m.perceivedWorkHours) },
        { label: 'Actual work', value: fmtH(m.actualWorkHours) },
        { label: 'Pieces', value: `${m.pieceCountAfter}` },
      ],
    }
    recordPlay('day-go', { actualWork: m.actualWorkHours, pieces: m.pieceCountAfter }, { actualWork: 'high' })
  }

  render()

  $('again').addEventListener('click', () => location.reload())
</script>

<style is:global>
  .day-body { background: #12090d; color: #fbeee0; }
  .day-body .game { position: relative; }

  .dg-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(60vmax 60vmax at 15% -10%, rgba(126, 200, 255, 0.1), transparent 70%),
      radial-gradient(60vmax 60vmax at 90% 110%, rgba(255, 210, 122, 0.09), transparent 70%);
  }
  .day-body .game > * { position: relative; z-index: 1; }

  .dg-head { max-width: 640px; margin: 8vh auto 0; padding: 0 22px; text-align: center; }
  .dg-eyebrow { font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #7ec8ff; opacity: 0.85; margin: 0 0 12px; font-weight: 600; }
  .dg-head h1 { font-size: clamp(32px, 6.4vw, 50px); margin: 0 0 14px; letter-spacing: -0.03em; }
  .dg-head p { font-size: 16.5px; line-height: 1.65; opacity: 0.8; max-width: 54ch; margin: 0 auto; }

  /* ---- the day-bar itself: big, vertical, and the actual point ---------
     A thin horizontal pill read as a footnote. A day is better read the way
     it is lived — top to bottom, morning to sleep — and big enough that the
     cuts later on genuinely register rather than needing a caption to
     explain them. Each section gets its own fresh one instead of a single
     shrunk dashboard that stays pinned the whole way down. */
  .daybar { margin: 34px auto 0; max-width: 340px; text-align: center; }
  .daybar-title {
    font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #ffb066; opacity: 0.85; margin: 0 0 14px;
  }
  .daybar-frame {
    padding: 14px; border-radius: 22px;
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
