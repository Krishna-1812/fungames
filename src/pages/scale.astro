---
import GameLayout from '../layouts/GameLayout.astro'
import { THINGS } from '../lib/scale-things'
import { SCALE_ART, artSvg } from '../lib/scale-art'
import { withBase } from '../lib/base'

/**
 * Scale — a continuous logarithmic zoom from a proton to the observable
 * universe, 42 orders of magnitude.
 *
 * The trick that makes it feel real: scroll position maps to how wide the
 * *screen* is in metres. Every object is then drawn at its true size relative
 * to that, so a thing grows from a speck, fills the view, and shrinks away
 * again as you keep going. Nothing is faked — the only non-linearity is that
 * the scroll axis itself is logarithmic, which is the honest way to cross
 * this many decades.
 *
 * What the objects are is in `lib/scale-things.ts`; what they look like is in
 * `lib/scale-art.ts`. Both are out here rather than inline because
 * `scripts/check-scale-art.mjs` renders them against this page's own sky.
 */

// Screen width in metres runs from 10^MIN to 10^MAX across the whole scroll.
const MIN_EXP = -15.6
const MAX_EXP = 27.6
const PX_PER_DECADE = 720

/**
 * Each thing's real footprint, in metres, on both axes.
 *
 * A drawing knows the object's width *and* height; the registry's `m` is only
 * one of them. That distinction was invisible while everything was a square
 * disc, and wrong: `m` for the Eiffel Tower is 330 metres of height, so the
 * old square drew it 330 metres wide — nearly three times its real footprint.
 */
function extent(t: (typeof THINGS)[number]) {
  const art = SCALE_ART[t.name]
  return art ? { w: art.wm, h: art.hm, dim: art.word } : { w: t.m, h: t.m, dim: 'across' }
}

const totalPx = Math.round((MAX_EXP - MIN_EXP) * PX_PER_DECADE)
---

<GameLayout slug="scale" bar="#04263f" bodyClass="night-body">
  <div class="sky" id="sky"></div>
  {/* The GPU environment sits over the CSS gradient, which stays as the
      fallback for anything without WebGL2. */}
  <div class="skygl" id="skygl" aria-hidden="true"></div>

  <div class="stage" id="stage" aria-hidden="true">
    {
      THINGS.map((t, i) => {
        const e = extent(t)
        const art = SCALE_ART[t.name]
        return (
          <div
            class="thing"
            data-m={t.m}
            data-wm={e.w}
            data-hm={e.h}
            data-i={i}
            data-art={art ? '1' : null}
            data-kind={t.kind ?? 'sphere'}
            style={`--c:${t.color}`}
          >
            {art ? <div class="art" set:html={artSvg(t.name, t.color)} /> : <div class="disc" />}
            <div class="label">
              <span class="name">{t.name}</span>
              <span class="size" data-size={t.m} data-dim={e.dim}></span>
              {t.note && <span class="note">{t.note}</span>}
            </div>
          </div>
        )
      })
    }
  </div>

  <div class="hud">
    <div class="hud-label">the screen is</div>
    <div class="hud-value" id="hudValue">—</div>
    <div class="hud-bar"><div class="hud-fill" id="hudFill"></div></div>
  </div>

  <div class="intro">
    <h1>Scale</h1>
    <p>Keep scrolling. The screen gets ten times wider every few seconds.</p>
    <div class="arrow" aria-hidden="true">↓</div>
  </div>

  <div class="reel" style={`height:${totalPx}px`}></div>

  <footer class="outro">
    <p>That was forty-two orders of magnitude.</p>
    <a href={withBase('/')}>← more things like this</a>
  </footer>

  {/* Text alternative for anyone who cannot use the scroll interaction. */}
  <ul class="visually-hidden">
    {THINGS.map((t) => <li>{t.name} — {t.m} metres {extent(t).dim}</li>)}
  </ul>
</GameLayout>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ MIN_EXP, MAX_EXP, totalPx })} />

  <script>
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { SCALE_FRAG, MAX_OBJECTS } from '../lib/scale-sky'
    const { MIN_EXP, MAX_EXP, totalPx } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  const stage = document.getElementById('stage')
  const sky = document.getElementById('sky')
  const hudValue = document.getElementById('hudValue')
  const hudFill = document.getElementById('hudFill')
  const reel = document.querySelector('.reel')
  /** '#rrggbb' -> linear RGB, because the shader works in linear light. */
  function toLinear(hex) {
    const n = parseInt(hex.trim().replace('#', ''), 16)
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => Math.pow(v / 255, 2.2))
  }

  const things = [...document.querySelectorAll('.thing')].map((el, i) => ({
    el,
    disc: el.querySelector('.disc') || el.querySelector('.art'),
    label: el.querySelector('.label'),
    m: Number(el.dataset.m),
    // Real extent on both axes. Equal for anything without a drawing.
    wm: Number(el.dataset.wm),
    hm: Number(el.dataset.hm),
    // A drawing is its own picture of the object; letting the shader paint a
    // lit sphere underneath it would render the thing twice.
    art: el.dataset.art === '1',
    // Kept as a number because the shader takes the whole object list as one
    // flat float array.
    kind: ({ sphere: 0, ring: 1, disc: 2, cloud: 3, wave: 4 })[el.dataset.kind] ?? 0,
    rgb: toLinear(el.style.getPropertyValue('--c') || '#ffffff'),
    // Stable per-object, so a surface belongs to a thing rather than shifting
    // as it grows.
    seed: (i * 0.1732) % 1,
    visible: false,
    size: 0,
    alpha: 0,
  }))

  /* --- GPU environment ---------------------------------------------------
     The CSS gradient sky and the CSS discs stay in place underneath; if the
     surface fails to come up, the page renders exactly as it did before. */
  const objData = new Float32Array(MAX_OBJECTS * 4)
  const objCol = new Float32Array(MAX_OBJECTS * 3)
  let objCount = 0
  let curExp = MIN_EXP
  const centreUv = [0.5, 0.5]

  const surface = new ShaderSurface(document.getElementById('skygl'), SCALE_FRAG, {
    // The regimes are all low frequency and the objects are antialiased against
    // their own derivatives, so three-quarter resolution is free.
    scale: 0.75,
    uniforms: () => ({
      u_exp: curExp,
      u_centre: centreUv,
      u_objN: objCount,
      u_obj: objData,
      u_objCol: objCol,
    }),
  })

  // Only take the CSS discs away once the GPU path is actually live.
  const glLive = surface.canvas.isConnected
  if (glLive) document.body.classList.add('gl-on')

  /** Human-readable length across 42 decades. */
  function fmt(m) {
    const units = [
      [1e-15, 'femtometres', 1e-15],
      [1e-12, 'picometres', 1e-12],
      [1e-9, 'nanometres', 1e-9],
      [1e-6, 'micrometres', 1e-6],
      [1e-3, 'millimetres', 1e-3],
      [1, 'metres', 1],
      [1e3, 'kilometres', 1e3],
      [1.496e11, 'astronomical units', 1.496e11],
      [9.461e15, 'light years', 9.461e15],
      [9.461e21, 'million light years', 9.461e21],
      [9.461e24, 'billion light years', 9.461e24],
    ]
    let pick = units[0]
    for (const u of units) if (m >= u[0]) pick = u
    const v = m / pick[2]
    const shown =
      v >= 100 ? v.toFixed(0) : v >= 10 ? v.toFixed(1) : v.toFixed(2)
    return `${Number(shown).toLocaleString('en-US')} ${pick[1]} across`
  }

  // Background palette keyed to the exponent, so the journey reads as a
  // sequence of worlds rather than one long gradient.
  const STOPS = [
    [-15, [16, 8, 26], [46, 14, 48]],
    [-9, [10, 22, 52], [16, 52, 82]],
    [-6, [8, 38, 44], [16, 70, 66]],
    [-3, [30, 44, 26], [72, 92, 54]],
    [0, [96, 138, 176], [186, 214, 232]],
    [4, [58, 96, 140], [122, 168, 206]],
    [7, [10, 22, 48], [30, 58, 102]],
    [12, [6, 10, 30], [22, 20, 66]],
    [18, [10, 4, 26], [46, 18, 74]],
    [24, [2, 2, 8], [14, 10, 34]],
  ]
  function skyAt(exp) {
    let a = STOPS[0], b = STOPS[STOPS.length - 1]
    for (let i = 0; i < STOPS.length - 1; i++) {
      if (exp >= STOPS[i][0] && exp <= STOPS[i + 1][0]) { a = STOPS[i]; b = STOPS[i + 1]; break }
      if (exp > STOPS[STOPS.length - 1][0]) { a = b = STOPS[STOPS.length - 1] }
    }
    const span = b[0] - a[0] || 1
    const t = Math.min(1, Math.max(0, (exp - a[0]) / span))
    const mix = (p, q) => p.map((v, i) => Math.round(v + (q[i] - v) * t))
    const top = mix(a[1], b[1])
    const bot = mix(a[2], b[2])
    return `linear-gradient(180deg, rgb(${top}) 0%, rgb(${bot}) 100%)`
  }

  let chime = 0
  let lastAnnounced = 0
  let ticking = false
  function update() {
    ticking = false
    const depth = Math.min(totalPx, Math.max(0, window.scrollY + window.innerHeight / 2 - reel.offsetTop))
    const t = depth / totalPx
    const exp = MIN_EXP + t * (MAX_EXP - MIN_EXP)
    const screenMetres = Math.pow(10, exp)

    hudValue.textContent = fmt(screenMetres)
    hudFill.style.width = `${t * 100}%`
    sky.style.background = skyAt(exp)

    // How many pixels one metre is worth right now.
    const px = Math.min(window.innerWidth, window.innerHeight) / screenMetres

    for (const th of things) {
      const w = th.wm * px
      const h = th.hm * px
      // The long axis is what decides whether a thing is a speck or a wall,
      // which is what the old single `size` meant when everything was square.
      const size = Math.max(w, h)
      // Below 3px it is an invisible dot; above 3 screens it is just a wall.
      const show = size > 3 && size < Math.max(window.innerWidth, window.innerHeight) * 3.2
      if (show !== th.visible) {
        th.el.classList.toggle('on', show)
        // Chime only when something arrives, and only once it is big enough to
        // read, so scrolling back and forth does not machine-gun.
        if (show && th.m > lastAnnounced) { sfx.blip(chime++); lastAnnounced = th.m }
        th.visible = show
      }
      if (!show) { th.alpha = 0; continue }
      th.disc.style.width = w + 'px'
      th.disc.style.height = h + 'px'
      // Fade in as it becomes legible and out as it engulfs the screen.
      const grow = Math.min(1, (size - 3) / 40)
      const shrink = Math.min(1, (Math.max(window.innerWidth, window.innerHeight) * 3.2 - size) / 400)
      const alpha = Math.min(grow, shrink)
      th.el.style.opacity = String(alpha)
      th.size = size
      th.alpha = alpha
    }

    /* Every object is centred on the same point, so whenever two are on screen
       their labels printed straight on top of each other. Anything sized by a
       clamp collides too, because both large objects hit the clamp. Distinct
       slots is the only thing that actually separates them: the smallest sits
       under its own body, and larger ones — which are the context, not the
       subject — stack upwards. */
    /* Labels are stacked against their measured heights rather than a fixed
       step. A note wraps to four lines on a phone and to two on a desktop, so
       any constant that clears one will collide on the other. */
    const vis = things.filter((t) => t.alpha > 0.001).sort((a, b) => a.size - b.size)
    // Past the third, a label is context nobody asked for. The body keeps
    // rendering; only its caption goes.
    vis.forEach((t, k) => t.el.style.setProperty('--labelShow', k < 3 ? '1' : '0'))

    /* Depth order. The shader composites its objects largest-first so the
       small thing in front lands on top of the big one behind it; drawings are
       DOM nodes and paint in registry order instead, which is ascending size —
       exactly backwards. Without this the football pitch covers the whale
       standing in front of it. */
    vis.forEach((t, k) => (t.el.style.zIndex = String(60 - Math.min(k, 59))))

    // Stack the context labels upwards from the centre.
    let cursor = -(window.innerHeight * 0.12)
    const placed = []
    for (const t of vis.slice(1, 3)) {
      const h = t.label.offsetHeight || 72
      cursor -= h / 2
      placed.push({ t, y: cursor, h })
      cursor -= h / 2 + 12
    }
    // The chrome bar and the HUD own the top of the viewport, so if the stack
    // reaches into them the whole thing slides down together — clamping labels
    // individually would just push them back into each other.
    const top = placed[placed.length - 1]
    if (top) {
      const centreY = 48 + (window.innerHeight - 48) / 2
      const gap = 150 - (centreY + top.y - top.h / 2)
      if (gap > 0) for (const p of placed) p.y += gap
    }
    for (const p of placed) p.t.el.style.setProperty('--labelY', `${p.y}px`)

    // The subject's own label goes last, because the HUD shift above may have
    // pushed the stack down into the space it wanted.
    if (vis[0]) {
      const h0 = vis[0].label.offsetHeight || 72
      // Below the object where there is room, and otherwise as low as it can
      // go while staying wholly on screen. The old clamp was a flat 26% of the
      // viewport, which was fine while every object was a plain ball and put
      // the caption straight across the middle of the drawings.
      const floor = (window.innerHeight - 48) / 2 - h0 / 2 - 14
      let y0 = Math.min(vis[0].size / 2 + 26, floor)
      const lowest = placed[0]
      if (lowest) y0 = Math.max(y0, lowest.y + lowest.h / 2 + h0 / 2 + 12)
      vis[0].el.style.setProperty('--labelY', `${y0}px`)
    }

    if (glLive) {
      curExp = exp
      // The stage is inset below the chrome bar, so its centre is not the
      // viewport's. The shader is told where in uv space to put the objects
      // rather than being given pixels.
      const top = 48
      centreUv[0] = 0.5
      centreUv[1] = 1 - (top + (window.innerHeight - top) / 2) / window.innerHeight

      // Largest first: the shader composites in array order, so the small
      // things in front land on top of the big ones behind them.
      const shown = things.filter((t) => t.alpha > 0.001 && !t.art)
        .sort((a, b) => b.size - a.size)
        .slice(0, MAX_OBJECTS)
      objCount = shown.length
      for (let i = 0; i < shown.length; i++) {
        const t = shown[i]
        objData[i * 4] = t.size / 2 / window.innerHeight
        objData[i * 4 + 1] = t.alpha
        objData[i * 4 + 2] = t.seed
        objData[i * 4 + 3] = t.kind
        objCol[i * 3] = t.rgb[0]
        objCol[i * 3 + 1] = t.rgb[1]
        objCol[i * 3 + 2] = t.rgb[2]
      }
      // The environment is a function of scroll, not of time. Under reduced
      // motion the shared ticker never runs, so the frame has to be asked for
      // explicitly or the sky freezes while the page keeps scrolling.
      if (prefersReducedMotion) surface.redraw()
    }
  }

  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update) }
  }, { passive: true })
  addEventListener('resize', update, { passive: true })
  addEventListener('pointerdown', unlock, { once: true })
  addEventListener('scroll', unlock, { once: true, passive: true })

  // Fill in each label's real-world size once.
  document.querySelectorAll('[data-size]').forEach((el) => {
    // "8.85 kilometres" says nothing about which way; Everest is quoted by
    // height and the Grand Canyon by length, and a drawing makes that visible
    // enough that not saying it starts to look like an evasion.
    el.textContent = fmt(Number(el.dataset.size)).replace(' across', ' ' + el.dataset.dim)
  })
  update()
</script>

<style>
  .sky {
    position: fixed; inset: 0; z-index: -3;
    background: linear-gradient(180deg, #100a1e, #2e0e30);
    transition: background 300ms linear;
  }
  .skygl { position: fixed; inset: 0; z-index: -2; pointer-events: none; }
  /* Created at runtime, so this cannot be a scoped rule. */
  .skygl :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* The GPU draws the bodies once it is live; the CSS disc stays in the layout
     so the label keeps centring on it, but stops painting. A drawing is not
     one of the shader's shapes, so it keeps painting either way. */
  :global(body.gl-on) .disc { opacity: 0; }
  :global(.night-body) { background: #100a1e; color: #fff; }

  /* One fixed stage; everything inside is positioned relative to the centre. */
  .stage { position: fixed; inset: 48px 0 0 0; z-index: -1; pointer-events: none; }

  .thing {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    display: none;
    place-items: center;
    opacity: 0;
    transition: opacity 160ms linear;
  }
  .thing.on { display: grid; }

  /* Scoped styles do not reach set:html content, so the svg carries its own
     sizing; this is only the box it fills. */
  .art {
    grid-area: 1 / 1;
    display: block;
    filter: drop-shadow(0 0 30px color-mix(in srgb, var(--c) 30%, transparent));
  }

  .disc {
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, color-mix(in srgb, var(--c) 92%, #fff), var(--c) 62%, color-mix(in srgb, var(--c) 62%, #000));
    box-shadow: 0 0 60px color-mix(in srgb, var(--c) 45%, transparent);
    grid-area: 1 / 1;
  }

  .label {
    grid-area: 1 / 1;
    position: relative;
    transform: translateY(var(--labelY, 0px));
    opacity: var(--labelShow, 1);
    transition: opacity 200ms linear;
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
    padding: 10px 16px;
    max-width: min(84vw, 460px);
    background: rgba(8, 8, 14, 0.74);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 12px;
  }
  .name { font-family: var(--display); font-size: clamp(20px, 3.4vw, 30px); font-weight: 700; }
  .size { font-size: 12.5px; opacity: 0.8; font-variant-numeric: tabular-nums; }
  .note { font-size: 14px; opacity: 0.78; margin-top: 4px; text-wrap: pretty; }

  .hud {
    position: fixed; top: 62px; left: 50%; transform: translateX(-50%);
    z-index: 40; width: min(92vw, 460px); text-align: center;
    padding: 10px 18px; border-radius: 14px;
    background: rgba(0, 0, 0, 0.66);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    pointer-events: none;
  }
  .hud-label { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.78; }
  .hud-value { font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .hud-bar { height: 3px; background: rgba(255, 255, 255, 0.18); border-radius: 2px; margin-top: 9px; }
  .hud-fill { height: 100%; width: 0; background: #fff; border-radius: 2px; }

  .intro { min-height: 86vh; display: grid; place-content: center; text-align: center; gap: 12px; padding: 160px 20px 0; }
  .intro h1 { font-size: clamp(44px, 11vw, 90px); letter-spacing: -0.04em; }
  .intro p { opacity: 0.72; margin: 0; font-size: 17px; max-width: 30ch; margin-inline: auto; }
  .arrow { font-size: 28px; opacity: 0.55; animation: bob 1.9s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(10px); } }

  .outro { padding: 30vh 20px 20vh; text-align: center; }
  .outro p { font-size: 20px; opacity: 0.82; }
  .outro a { display: inline-block; margin-top: 12px; opacity: 0.75; }
</style>
