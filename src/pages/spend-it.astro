---
import GameShell from '../layouts/GameShell.astro'
import { ITEMS, BUDGET } from '../lib/spend-items'
import { iconSvg } from '../lib/icons'
import { productSvg } from '../lib/spend-art'

/**
 * Spend It — the resource-disposal archetype. The list lives in lib/spend-items.
 *
 * In the shell: Score is what is left, Kinds and Things count what you have
 * bought, Best is the least you have ever had left, and getting to exactly
 * zero is the ending — the receipt is its result card. Sell anything after
 * that and the card goes away until you get back to zero.
 */

---

<GameShell
  slug="spend-it"
  labels={{ score: 'Left', best: 'Least left', level: 'Kinds', moves: 'Things' }}
  initial={{ score: '$100B', level: `0 / ${ITEMS.length}`, moves: '0' }}
>
  <div class="sp">
    {/* The balance stays in view while the shop scrolls under it. */}
    <div class="sp-bar">
      <div class="sp-money num" id="money" aria-live="polite" aria-atomic="true">$100,000,000,000</div>
      <div class="sp-acts">
        <button type="button" id="receiptBtn" class="pill pill--line pill--sm"><span>Receipt</span></button>
      </div>
      <div class="sp-track" id="track" aria-hidden="true"><div class="sp-track-fill" id="trackFill"></div></div>
    </div>

    <p class="sp-lede">
      You have one hundred billion dollars. Buying one of everything costs about
      ninety-seven billion, so getting to exactly zero is going to take some care.
    </p>

    <ul class="sp-grid">
      {
        ITEMS.map((item, i) => (
          <li class="sp-item" data-price={item.price} data-name={item.name} data-i={i}>
            <div class="sp-shot" aria-hidden="true" set:html={productSvg(item.name)} />
            <div class="sp-name">{item.name}</div>
            <div class="sp-price">${item.price.toLocaleString('en-US')}</div>
            <div class="sp-controls">
              <button type="button" class="sp-sell" data-buy="sell" aria-label={`Sell one ${item.name}`}>Sell</button>
              <input
                class="sp-qty" type="text" inputmode="numeric" value="0"
                aria-label={`Quantity of ${item.name}`}
              />
              <button type="button" class="sp-buy" data-buy="buy" aria-label={`Buy one ${item.name}`}>Buy</button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="panel" id="sheet" aria-labelledby="receiptTitle">
    <p class="label meta">Spend It</p>
    <h2 id="receiptTitle" style="margin-top:10px">Your receipt</h2>
    <div class="panel-body">
      <ul class="sp-lines" id="lines"></ul>
      <div class="sp-totals"><span>Total spent</span><b id="spent">$0</b></div>
      <div class="sp-totals"><span>Left over</span><b id="left">$100,000,000,000</b></div>
    </div>
    <div class="panel-actions">
      <button type="button" class="pill pill--hero" id="closeSheet"><span>Keep spending</span><span class="arrow" aria-hidden="true">→</span></button>
    </div>
  </dialog>

  <Fragment slot="howto">
    <p>
      You have $100,000,000,000. Spend every dollar of it: the game ends at
      exactly zero.
    </p>
    <ul>
      <li><b>Buy</b> and <b>Sell</b> one at a time, or hold <kbd>Shift</kbd> for ten. You can also type a quantity straight in.</li>
      <li>You can never go below zero; anything you can no longer afford greys out.</li>
      <li><b>Receipt</b> shows what you have bought so far. What you have bought is remembered on this device.</li>
    </ul>
    <p>Your best is the least you have ever had left. <b>Restart</b> gives all of it back.</p>
  </Fragment>
</GameShell>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ BUDGET, ICONS: Object.fromEntries(ITEMS.map((i) => [i.name, iconSvg(i.icon)])) })} />

  <script>
  import { burst, floatText, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface } from '../lib/gl'
  import { VAULT_FRAG } from '../lib/spend-vault'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { SITE } from '../site.config'
  import { createShell } from '../lib/game-shell'
  import { recordPlay } from '../lib/stats'
    const { BUDGET, ICONS } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  const money = document.getElementById('money')
  const trackFill = document.getElementById('trackFill')
  let shareCard = null
  const lines = document.getElementById('lines')
  const spentEl = document.getElementById('spent')
  const leftEl = document.getElementById('left')
  const items = [...document.querySelectorAll('.sp-item')].map((el) => ({
    el,
    price: Number(el.dataset.price),
    name: el.dataset.name,
    input: el.querySelector('.sp-qty'),
    sell: el.querySelector('.sp-sell'),
    buy: el.querySelector('.sp-buy'),
    glyph: el.querySelector('.sp-shot'),
    n: 0,
  }))

  const shell = createShell({
    slug: 'spend-it',
    // A fortune is not given back without asking.
    onRestart: () => {
      if (items.some((i) => i.n > 0) && !confirm('Give all of it back?')) return
      items.forEach((i) => (i.n = 0))
      shareCard = null
      won = false
      render()
    },
  })

  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumSignificantDigits: 3 })
  /** Money short enough for a score tile: "$100B", "$62.4M", "$0". */
  const short = (n) => (n <= 0 ? '$0' : n < 1000 ? '$' + Math.round(n) : '$' + compact.format(n))

  const KEY = 'spend-it:v1'
  const usd = (n) => '$' + Math.round(n).toLocaleString('en-US')

  /* The balance strip. 'level' eases toward the true figure rather than
     snapping, so spending reads as a level dropping instead of a value
     changing. */
  let level = 1, levelTarget = 1
  let splashAt = -1e6
  const vault = new ShaderSurface(document.getElementById('track'), VAULT_FRAG, {
    scale: 1,
    uniforms: () => ({
      u_level: level,
      u_splash: Math.max(0, 1 - (performance.now() - splashAt) / 620),
      u_motion: prefersReducedMotion ? 0 : 1,
    }),
  })

  /* Driven by the balance, not by time, so under reduced motion — where the
     shared ticker never runs — it has to be asked for each frame of the ease. */
  let easing = 0
  function easeLevel() {
    cancelAnimationFrame(easing)
    const step = () => {
      const d = levelTarget - level
      level += d * 0.18
      if (Math.abs(d) < 0.0004) level = levelTarget
      if (prefersReducedMotion) vault.redraw()
      if (level !== levelTarget) easing = requestAnimationFrame(step)
    }
    if (prefersReducedMotion) { level = levelTarget; vault.redraw() }
    else easing = requestAnimationFrame(step)
  }

  function balance() {
    return BUDGET - items.reduce((a, it) => a + it.n * it.price, 0)
  }

  let flashTimer
  let won = false

  function render(flash) {
    const left = balance()
    const bought = items.filter((i) => i.n > 0)
    shell.setScore(short(left))
    shell.setLevel(`${bought.length} / ${items.length}`)
    shell.setMoves(compact.format(bought.reduce((a, i) => a + i.n, 0)))
    if (left < BUDGET) shell.considerBest(BUDGET - left, `${short(left)} left`)
    // Zero is the ending; selling anything afterwards takes it back.
    if (left === 0 && !won) { won = true; finish() }
    else if (left > 0 && won) { won = false; shell.reset() }

    money.textContent = usd(left)
    money.classList.toggle('low', left < BUDGET * 0.1)
    // The CSS fallback keeps the original fill-as-you-spend direction; the
    // strip itself drains, matching the figure above it.
    trackFill.style.width = `${(1 - left / BUDGET) * 100}%`
    levelTarget = Math.max(0, Math.min(1, left / BUDGET))
    easeLevel()

    for (const it of items) {
      if (document.activeElement !== it.input) it.input.value = String(it.n)
      it.el.classList.toggle('owned', it.n > 0)
      it.sell.disabled = it.n === 0
      // Mark what can no longer be afforded, so the endgame is legible. The
      // button is genuinely disabled rather than merely styled: clicking it was
      // already a silent no-op, and saying so is both more honest and what
      // assistive technology needs to hear.
      it.buy.disabled = it.price > left
      it.el.classList.toggle('unaffordable', it.price > left && it.n === 0)
    }

    if (flash) {
      money.classList.remove('flash-buy', 'flash-sell')
      void money.offsetWidth
      money.classList.add(flash === 'buy' ? 'flash-buy' : 'flash-sell')
      clearTimeout(flashTimer)
      flashTimer = setTimeout(() => money.classList.remove('flash-buy', 'flash-sell'), 320)
    }
    save()
  }

  function save() {
    try { localStorage.setItem(KEY, JSON.stringify(items.map((i) => i.n))) } catch {}
  }
  function load() {
    try {
      const raw = JSON.parse(localStorage.getItem(KEY) || 'null')
      if (Array.isArray(raw) && raw.length === items.length) {
        raw.forEach((n, i) => (items[i].n = Math.max(0, Math.floor(Number(n) || 0))))
      }
    } catch {}
  }

  let comboAt = 0
  let combo = 0

  function change(it, delta) {
    it.glyph.classList.remove('jump')
    void it.glyph.offsetWidth
    it.glyph.classList.add('jump')
    if (delta > 0) {
      // Never allow the balance to go negative, and buy as many as will fit.
      const affordable = Math.floor(balance() / it.price)
      if (affordable < 1) return render()
      const got = Math.min(delta, affordable)
      it.n += got
      unlock()
      // Rapid buying builds a rising run of notes instead of one flat click.
      const now = performance.now()
      combo = now - comboAt < 480 ? Math.min(combo + 1, 11) : 0
      comboAt = now
      sfx.pop(combo)
      splashAt = performance.now()
      const r = it.el.getBoundingClientRect()
      floatText(r.left + r.width / 2, r.top + 24, '-' + usd(got * it.price), '#111318')
      burst(r.left + r.width / 2, r.top + 30, {
        count: 8, colors: ['#4fe3c1', '#5b82ff'], speed: 2.6, gravity: 0.2, life: 26, size: 3,
      })
    } else {
      it.n = Math.max(0, it.n + delta)
      unlock(); sfx.blip(2)
    }
    render(delta > 0 ? 'buy' : 'sell')
  }

  for (const it of items) {
    it.el.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-buy]')
      if (!btn) return
      // Shift buys or sells ten at a time — the only way to finish this game.
      const step = e.shiftKey ? 10 : 1
      change(it, btn.dataset.buy === 'buy' ? step : -step)
    })
    it.input.addEventListener('input', () => {
      const want = Math.max(0, Math.floor(Number(it.input.value.replace(/\D/g, '')) || 0))
      const others = BUDGET - balance() - it.n * it.price
      const max = Math.floor((BUDGET - others) / it.price)
      it.n = Math.min(want, max)
      render()
    })
    it.input.addEventListener('blur', () => render())
  }

  /** The lines of the receipt, as list items. */
  function receiptLines(bought) {
    return bought.length
      ? bought.map((i) => {
          const li = document.createElement('li')
          li.innerHTML =
            `<span class="sp-l-icon" aria-hidden="true">${ICONS[i.name] ?? ''}</span>` +
            `<span class="sp-l-name">${i.name}</span>` +
            `<span class="sp-l-qty">×${i.n.toLocaleString('en-US')}</span>` +
            `<span class="sp-l-sum">${usd(i.n * i.price)}</span>`
          return li
        })
      : [Object.assign(document.createElement('li'), { className: 'empty', textContent: 'You have not bought anything yet.' })]
  }

  /* Nothing bought is not a result — the card would read "$0 spent", which
     is a screenshot of not having played. */
  function buildShareCard(bought, left) {
    const spent = BUDGET - left
    const units = bought.reduce((a, i) => a + i.n, 0)
    const biggest = bought.slice().sort((a, b) => b.n * b.price - a.n * a.price)[0]
    const pct = (left / BUDGET) * 100
    shareCard = !bought.length
      ? null
      : {
          slug: 'spend-it',
          siteName: SITE.name,
          headline: usd(spent) + ' spent',
          /* Money is far too wide for a 150px chip — "$99,999,996,700" alone
             is most of the column — so every figure lives in the sentence and
             the chips carry counts. */
          sub:
            `Mostly on ${biggest.name.toLowerCase()}. ` +
            (left === 0 ? 'Not a dollar left.' : `${usd(left)} of it is still there.`),
          stats: [
            { label: 'Things', value: units.toLocaleString('en-US') },
            { label: 'Kinds', value: String(bought.length) },
            {
              /* Both ends need a word rather than a rounded figure. Spending
                 eighteen dollars of a hundred billion really does leave
                 99.999999982%, and printing "100.00% left" on a receipt for
                 something you bought reads as a bug. */
              label: 'Left',
              value:
                pct === 0 ? '0%'
                : pct < 0.01 ? '<0.01%'
                : pct > 99.99 ? '>99.99%'
                : pct.toFixed(2) + '%',
            },
          ],
        }
    return { units, biggest }
  }

  const sheet = document.getElementById('sheet')
  document.getElementById('receiptBtn').addEventListener('click', () => {
    unlock(); sfx.good()
    const bought = items.filter((i) => i.n > 0)
    lines.replaceChildren(...receiptLines(bought))
    const left = balance()
    spentEl.textContent = usd(BUDGET - left)
    leftEl.textContent = usd(left)
    buildShareCard(bought, left)
    sheet.showModal()
  })
  document.getElementById('closeSheet').addEventListener('click', () => sheet.close())
  sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close() })

  /** Exactly zero: the receipt becomes the result card. */
  function finish() {
    const bought = items.filter((i) => i.n > 0)
    const { units, biggest } = buildShareCard(bought, 0)
    recordPlay('spend-it', { kinds: bought.length, things: units }, {})
    shell.win({
      kicker: 'Spent, to the dollar',
      title: 'Not a dollar left.',
      score: '$100,000,000,000',
      from: '$000,000,000,000',
      lines: [
        `${units.toLocaleString('en-US')} things, ${bought.length} of the ${items.length} kinds.`,
        `Mostly on ${biggest.name.toLowerCase()}: ${usd(biggest.n * biggest.price)} of it.`,
      ],
      againLabel: 'Give it back and start again',
    })
    const ul = document.createElement('ul')
    ul.className = 'sp-lines sp-lines--ink'
    ul.replaceChildren(...receiptLines(bought))
    const acts = document.createElement('div')
    acts.className = 'sp-report-acts'
    acts.innerHTML = '<button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share the receipt</span></button>'
    shell.resultExtra.replaceChildren(ul, acts)
    document.getElementById('shareBtn').addEventListener('click', async (e) => {
      if (!shareCard) return
      const label = e.currentTarget.querySelector('span')
      const outcome = await shareResult(shareCard, { title: 'Spend It', text: `${shareCard.headline}.`, url: location.href })
      label.textContent = outcomeLabel[outcome]
      setTimeout(() => (label.textContent = 'Share the receipt'), 1600)
    })
  }

  load()
  render()
</script>

<style is:global>
  /* Receipt lines are built at runtime, so these rules cannot be scoped.
     Everything is prefixed. */
  .sp { display: grid; gap: 18px; }
  .sp [hidden] { display: none !important; }

  /* The balance: sticky, so it stays in view while the shop scrolls under it. */
  .sp-bar {
    position: sticky; top: 0; z-index: 30;
    display: grid; grid-template-columns: 1fr auto; gap: 8px 16px; align-items: center;
    margin: calc(-1 * clamp(16px, 3vw, 36px)) calc(-1 * clamp(16px, 3vw, 36px)) 0;
    padding: 14px clamp(16px, 3vw, 36px) 16px;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--paper3);
  }
  .sp-money {
    font-size: clamp(28px, 4.6vw, 48px); color: var(--ink);
    transition: color 160ms var(--ease);
  }
  .sp-money.low { color: var(--t-red); }
  html.play .sp-money.flash-buy { animation: sp-down 320ms var(--ease); }
  html.play .sp-money.flash-sell { animation: sp-up 320ms var(--ease); }
  @keyframes sp-down { 0% { transform: translateY(-4px); opacity: 0.55; } }
  @keyframes sp-up { 0% { transform: translateY(4px); opacity: 0.55; } }

  /* A channel with something in it, rather than a 4px progress rule. */
  .sp-track {
    grid-column: 1 / -1; position: relative; height: 14px;
    background: var(--paper3); border-radius: var(--r-pill); overflow: hidden;
    box-shadow: inset 0 1px 2px rgba(17, 19, 24, 0.2);
  }
  .sp-track .gl-surface { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* The still fallback for anything without WebGL2. */
  .sp-track-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--mint), var(--cobalt)); }
  html.play .sp-track-fill { transition: width 200ms var(--ease); }

  .sp-lede { font-size: var(--fs-lead); color: var(--ink2); max-width: 56ch; }

  .sp-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 12px;
    /* Two across even on a phone: thirty cards one per row is a very long shop. */
    grid-template-columns: repeat(auto-fill, minmax(min(210px, calc(50% - 6px)), 1fr));
  }
  /* The card these drawings are checked against (check-spend-art's CARD). */
  .sp-item {
    background: #fdfdfc; border-radius: var(--r); padding: 16px 14px 14px; text-align: center;
    box-shadow: inset 0 0 0 1.5px var(--paper3);
  }
  html.play .sp-item { transition: box-shadow 160ms var(--ease), background 160ms var(--ease); }
  .sp-item.owned { box-shadow: inset 0 0 0 2px var(--ink), 0 0 0 4px var(--mint); }
  /* Deliberately not opacity: that faded the card's figures under AA on the
     state whose whole job is to keep the endgame legible. */
  .sp-item.unaffordable { background: var(--paper2); box-shadow: none; }
  .sp-item.unaffordable .sp-shot { filter: saturate(0.2) opacity(0.75); }
  .sp-item.unaffordable .sp-name { color: var(--ink2); }
  /* The product shot sizes itself from inside (see productSvg); a rule
     targeting the <svg> would not reach it, because it arrives via set:html. */
  .sp-shot { width: 100%; max-width: 124px; aspect-ratio: 1 / 1; margin: 0 auto; display: block; }
  html.play .sp-shot { transition: filter 160ms var(--ease), transform 220ms var(--spring); }
  html.play .sp-item:hover .sp-shot { transform: translateY(-3px) scale(1.04); }
  html.play .sp-shot.jump { animation: sp-jump 340ms var(--spring); }
  @keyframes sp-jump { 40% { transform: translateY(-9px) scale(1.09); } }
  .sp-name { font-weight: 700; margin-top: 8px; font-size: 15px; }
  .sp-price { color: var(--ink2); font-size: 14px; }

  .sp-controls { display: flex; gap: 6px; margin-top: 12px; }
  .sp-controls button {
    flex: 1; min-height: 38px; border: 0; border-radius: var(--r-pill);
    font: 700 13.5px var(--sans); cursor: pointer;
  }
  .sp-sell { background: var(--paper2); color: var(--t-red); }
  .sp-sell:hover:not(:disabled) { background: var(--paper3); }
  .sp-sell:disabled { color: var(--ink3); cursor: default; }
  .sp-buy { background: var(--ink); color: var(--ink-paper); }
  .sp-buy:hover:not(:disabled) { background: var(--cobalt); color: var(--ink); }
  .sp-buy:disabled { background: var(--paper3); color: var(--ink2); cursor: default; }
  .sp-qty {
    width: 56px; text-align: center; border: 1.5px solid var(--paper3);
    border-radius: var(--r-pill); font: 600 14px var(--sans); padding: 6px 2px;
    background: var(--card); color: var(--ink);
  }

  /* The receipt, in the panel and on the ink result card. */
  .sp-l-icon { width: 22px; height: 22px; display: inline-block; flex: none; }
  .sp-lines { list-style: none; margin: 0 0 14px; padding: 0; }
  .sp-lines li {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 12px; align-items: center;
    padding: 8px 0; border-bottom: 1px dashed var(--paper3); font-size: 15px;
  }
  .sp-lines li.empty { display: block; color: var(--ink2); border: 0; }
  .sp-l-qty { color: var(--ink2); }
  .sp-l-sum { font-weight: 700; min-width: 96px; text-align: right; }
  .sp-totals { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1.5px solid var(--ink); font-size: 16px; }
  .sp-lines--ink { max-width: 640px; }
  .sp-lines--ink li { border-color: rgba(243, 245, 248, 0.22); }
  .sp-lines--ink .sp-l-qty { color: rgba(243, 245, 248, 0.72); }
  .sp-lines--ink .sp-l-icon { background: var(--ink-paper); border-radius: 6px; padding: 2px; box-sizing: content-box; }
  .sp-report-acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }

  @media (max-width: 620px) {
    .sp-item { padding: 12px 10px; }
    .sp-controls { display: grid; grid-template-columns: 1fr 1fr; }
    .sp-qty { grid-column: 1 / -1; order: -1; width: 100%; box-sizing: border-box; }
    .sp-bar { grid-template-columns: 1fr; }
    .sp-acts { justify-self: start; }
  }
</style>
