---
import GameShell from '../layouts/GameShell.astro'
import { DRAW_COLORS } from '../lib/constellation-code'
import { TIERS } from '../lib/constellation-trace'

/**
 * Constellation Draw — almost 9,000 real stars, at their real position and
 * real brightness, projected the way an actual planetarium does it.
 *
 * The data (src/data/star-catalog.ts, src/data/constellation-lines.ts) is
 * real: HYG v4.4 down to magnitude 6.5, and the real western constellation
 * line figures every planetarium app draws (scripts/build-star-data.mjs,
 * run once at author time — see that file for sources and licensing).
 *
 * The projection (lib/sky-projection.ts) is a real gnomonic tangent-plane
 * projection recomputed around the current look direction on every pan,
 * not a flat RA/Dec map — a flat map warps constellations badly near the
 * poles, which is the exact mistake this avoids. lib/star-color.ts turns
 * each star's real B-V colour index into a real approximate RGB colour via
 * a real published temperature formula, so Betelgeuse actually looks
 * redder than Rigel rather than every star being a plain white dot.
 *
 * In the shell it is a memory round: five real figures, smallest first. Each
 * is shown for a few seconds, then the lines go and you join the stars back
 * up from memory. lib/constellation-trace.ts scores the drawing against the
 * real figure, edge for edge. Score is the round's average so far, Figure is
 * progress, Moves are the lines in the current drawing, and Best is your best
 * round. The free sky — draw anything, name it, share the link — is the
 * other tab, and a shared link opens straight into it.
 */
const ROUND = TIERS.length
---

<GameShell
  slug="constellation-draw"
  labels={{ score: 'Accuracy', best: 'Best round', level: 'Figure', moves: 'Lines' }}
  initial={{ score: '—', level: `1 / ${ROUND}`, moves: '0' }}
>
  <div class="cd" id="cd" data-mode="round">
    <div class="cd-top">
      <ol class="cd-rail" id="rail" aria-label="The round">
        {TIERS.map((_, i) => (
          <li class={i === 0 ? 'is-now' : ''}>
            <span class="label">{i + 1}</span>
            <b data-name>?</b>
            <span class="num cd-got" data-got>—</span>
          </li>
        ))}
      </ol>
      <div class="cd-modes" role="group" aria-label="Mode">
        <button type="button" class="pill pill--sm" data-mode-btn="round" aria-pressed="true"><span>Memory round</span></button>
        <button type="button" class="pill pill--sm" data-mode-btn="free" aria-pressed="false"><span>Free sky</span></button>
      </div>
    </div>

    {/* What the current figure is and what to do about it; the verdict
        replaces it once a figure is checked. A bar above the sky rather than
        a card on it, so it never sits on the stars it is talking about. */}
    <div class="cd-head" data-for="round">
      <div class="cd-brief" id="brief">
        <p class="label meta" id="briefKicker">Figure 1 of {ROUND} · memorise it</p>
        <h2 class="cd-name" id="briefName">—</h2>
        <p class="cd-sub" id="briefSub"></p>
      </div>
      <div class="cd-memo" id="memo">
        <div class="cd-timer" aria-hidden="true"><i id="timerBar"></i></div>
        <span class="num cd-secs" id="timerSecs">0s</span>
        <button type="button" class="pill pill--ink pill--sm" id="gotIt"><span>Got it</span><span aria-hidden="true">→</span></button>
      </div>
      <div class="cd-verdict" id="verdict" hidden tabindex="-1">
        <span class="num cd-big" id="vScore">0%</span>
        <ul class="cd-facts" id="vFacts"></ul>
        <button type="button" class="pill pill--ink" id="nextBtn"><span id="nextLbl">Next figure</span><span aria-hidden="true">→</span></button>
      </div>
    </div>

    <div class="cd-head" data-for="free" hidden>
      <div class="cd-search">
        <label class="sr-only" for="search">Fly to a star</label>
        <input id="search" type="search" placeholder="Fly to a star — try Vega" autocomplete="off" spellcheck="false" />
        <ul id="searchResults" class="cd-results" hidden></ul>
      </div>
      <div class="cd-info" id="infoCard" hidden>
        <p class="label meta" id="infoKicker"></p>
        <p class="cd-info-name" id="infoName"></p>
        <p class="cd-info-fact" id="infoFact"></p>
      </div>
    </div>

    <div class="cd-scene" id="scene">
      <canvas id="sky" aria-label="A real, navigable map of the night sky. Drag to look around; click stars to join them."></canvas>
      <p class="cd-coords" id="coords" aria-hidden="true">RA 00h 00m · Dec +00°</p>
      <div class="cd-zoom" role="group" aria-label="Zoom">
        <button type="button" id="zoomIn" aria-label="Zoom in">+</button>
        <button type="button" id="zoomOut" aria-label="Zoom out">−</button>
      </div>
      <p class="cd-hint" id="hint">Drag to look around.</p>
      <p class="cd-wheel" id="wheelNote" hidden aria-hidden="true">Hold <kbd>Ctrl</kbd> and scroll to zoom</p>
    </div>

    <div class="cd-tools" data-for="round">
      <button type="button" class="pill pill--line pill--sm" id="peekBtn"><span>Peek</span><span class="cd-cost">−10</span></button>
      <button type="button" class="pill pill--line pill--sm" id="undoBtn"><span>Undo</span></button>
      <button type="button" class="pill pill--line pill--sm" id="clearBtn"><span>Clear</span></button>
      <span class="cd-keys"><kbd>Enter</kbd> check · <kbd>U</kbd> undo · <kbd>R</kbd> peek</span>
      <button type="button" class="pill pill--ink" id="checkBtn"><span>Check it</span><span aria-hidden="true">→</span></button>
    </div>

    <div class="cd-tools" data-for="free" hidden>
      <div class="cd-swatches" role="group" aria-label="Draw colour">
        {DRAW_COLORS.map((c) => (
          <button type="button" class="cd-swatch" data-color={c.key} style={`--sw:${c.css}`} aria-label={`Draw in ${c.key}`} aria-pressed={c.key === 'c' ? 'true' : 'false'}></button>
        ))}
      </div>
      <button type="button" class="pill pill--line pill--sm" id="toggleReal" aria-pressed="true"><span>Real lines</span></button>
      <button type="button" class="pill pill--line pill--sm" id="randomBtn"><span>Surprise me</span></button>
      <button type="button" class="pill pill--line pill--sm" id="freeUndo"><span>Undo</span></button>
      <button type="button" class="pill pill--line pill--sm" id="freeClear"><span>Clear</span></button>
      <button type="button" class="pill pill--ink" id="saveBtn"><span>Name &amp; share</span><span aria-hidden="true">→</span></button>
    </div>

    <dialog id="saveDialog" class="panel" aria-labelledby="saveTitle">
      <p class="label meta">Free sky</p>
      <h2 id="saveTitle" style="margin-top:10px">Name your constellation</h2>
      <div class="panel-body">
        <label class="sr-only" for="nameInput">Name</label>
        <input id="nameInput" class="cd-name-input" type="text" maxlength="40" placeholder="e.g. The Kettle" />
        <p class="cd-save-status" id="saveStatus" aria-live="polite"></p>
      </div>
      <div class="panel-actions">
        <button type="button" class="pill pill--hero" id="saveConfirm"><span>Copy the link</span><span class="arrow" aria-hidden="true">→</span></button>
        <button type="button" class="pill pill--line" id="saveCancel"><span>Close</span></button>
      </div>
    </dialog>
  </div>

  <Fragment slot="howto">
    <p>
      Five real constellations, smallest first. Each one is shown for a few
      seconds; then its lines disappear and you join its stars back up from
      memory.
    </p>
    <ul>
      <li>Click a star, then the next. Click the last star again, or empty sky, to lift the pen. Drag to look around. To zoom, pinch, use <b>+</b> and <b>−</b>, or hold <kbd>Ctrl</kbd> and scroll.</li>
      <li>Your score is how many of the real lines you drew, balanced against how many of yours are not in the figure. Order and direction do not matter.</li>
      <li><b>Peek</b> shows the figure again for a moment, for 10 points off that figure.</li>
      <li><kbd>Enter</kbd> checks and moves on, <kbd>U</kbd> undoes, <kbd>R</kbd> peeks.</li>
    </ul>
    <p>The round's score is the average of the five. <b>Free sky</b> is the whole sky with nothing to score: draw your own, name it and share the link.</p>
  </Fragment>
</GameShell>

<script>
  import { STARS, starById, constellationName, starLabel, brightestIn, searchStars, CONSTELLATIONS, type Star } from '../lib/star-catalog'
  import { project, unproject, wrapRa, clampDec } from '../lib/sky-projection'
  import { starRgb } from '../lib/star-color'
  import { encodeStrokes, decodeStrokes, colorCss, type Stroke } from '../lib/constellation-code'
  import {
    figureEdges, figureStars, figureView, figureName, chainsToEdges, traceScore, withPeeks,
    pickRound, memoMs, verdictFor, edgeKey, fitView, pickStar, PEEK_COST, type Trace,
  } from '../lib/constellation-trace'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { sfx } from '../lib/audio'
  import { recordPlay } from '../lib/stats'

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const root = $('cd')
  const scene = $('scene')
  const canvas = $<HTMLCanvasElement>('sky')
  const ctx = canvas.getContext('2d')!
  const hint = $('hint')
  const coordsEl = $('coords')
  const SANS = getComputedStyle(document.documentElement).getPropertyValue('--sans').trim() || 'sans-serif'

  /* Colours on the night sky. These are the picture, not the page, so they
     are literal: the system's blocks, tuned for a black ground. */
  const MINT = '#4fe3c1'
  const SKY = '#8ccbff'
  const RED = '#ff4f6e'
  const MISSED = 'rgba(243,245,248,0.72)'

  /* ---- view ----------------------------------------------------------- */

  let W = 0, H = 0, dpr = 1
  // Orion to begin with, until a figure is picked.
  let ra0 = 83.0
  let dec0 = 0.0
  /** Pixels per radian at the tangent point. */
  let scale = 480
  const SCALE_MIN = 120
  const SCALE_MAX = 6400

  const toScreen = (x: number, y: number): [number, number] => [W / 2 + x * scale, H / 2 - y * scale]
  function screenOf(ra: number, dec: number, pad = 40) {
    const p = project(ra, dec, ra0, dec0)
    if (!p.visible) return null
    const [sx, sy] = toScreen(p.x, p.y)
    if (sx < -pad || sx > W + pad || sy < -pad || sy > H + pad) return null
    return { sx, sy }
  }
  const starScreen = (id: number) => { const s = starById(id); return s ? screenOf(s.ra, s.dec, 400) : null }

  /* ---- drawing state, one pad per mode -------------------------------- */

  type Pad = { chains: number[][]; chain: number[] }
  const roundPad: Pad = { chains: [], chain: [] }
  const freePad: Pad = { chains: [], chain: [] }
  let mode: 'round' | 'free' = 'round'
  const pad = () => (mode === 'round' ? roundPad : freePad)
  const armed = () => { const c = pad().chain; return c.length ? c[c.length - 1] : null }
  function commitChain(p = pad()) {
    if (p.chain.length >= 2) p.chains.push(p.chain)
    p.chain = []
  }
  const padEdges = (p: Pad) => chainsToEdges([...p.chains, p.chain])
  const lineCount = (p: Pad) => new Set(padEdges(p).map(([a, b]) => edgeKey(a, b))).size

  /* ---- the round ------------------------------------------------------ */

  type Phase = 'memo' | 'draw' | 'checked' | 'done'
  type Result = { id: string; trace: Trace; peeks: number; score: number }
  let figures: string[] = []
  let idx = 0
  let phase: Phase = 'memo'
  let results: Result[] = []
  let peeks = 0
  let peeking = false
  let current: Result | null = null

  const shell = createShell({
    slug: 'constellation-draw',
    onRestart: () => { newRound(); scene.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'center' }) },
    onPause: pauseMemo,
    onResume: resumeMemo,
  })

  const railEls = [...$('rail').children] as HTMLLIElement[]
  const avg = () => (results.length ? Math.round(results.reduce((a, r) => a + r.score, 0) / results.length) : 0)

  function paintStrip() {
    shell.setScore(results.length ? `${avg()}%` : '—')
    shell.setLevel(`${Math.min(idx + 1, figures.length)} / ${figures.length}`)
    shell.setMoves(String(lineCount(roundPad)))
  }

  function paintRail() {
    railEls.forEach((li, i) => {
      const r = results[i]
      li.classList.toggle('is-now', i === idx && phase !== 'done')
      li.classList.toggle('is-done', !!r)
      // A figure's name is only given away once it is the one being drawn.
      li.querySelector('[data-name]')!.textContent = i <= idx || r ? figureName(figures[i]) : '?'
      li.querySelector('[data-got]')!.textContent = r ? `${r.score}%` : '—'
    })
  }

  function newRound() {
    figures = pickRound()
    idx = 0
    results = []
    shell.resultExtra.innerHTML = ''
    startFigure(false)
  }

  function startFigure(animate = true) {
    const id = figures[idx]
    roundPad.chains = []
    roundPad.chain = []
    peeks = 0
    peeking = false
    current = null
    phase = 'memo'
    const meta = constellationName(id)
    $('briefKicker').textContent = `Figure ${idx + 1} of ${figures.length} · memorise it`
    $('briefName').textContent = figureName(id)
    $('briefSub').textContent = meta && meta.english !== meta.name ? `${meta.english}. ${figureEdges(id).length} lines.` : `${figureEdges(id).length} lines.`
    $('memo').hidden = false
    $('verdict').hidden = true
    $('brief').hidden = false
    hint.textContent = 'Take it in. You will draw it from memory.'
    paintRail()
    paintStrip()
    paintTools()
    fitFigure(id, animate)
    startMemo(memoMs(figureEdges(id).length))
  }

  /* The memorise countdown, pausable: the shell's Pause and How-to panels
     both stop it, and it carries on with exactly what was left. */
  let memoT = 0, memoEnd = 0, memoLeft = 0, memoTotal = 1, memoRaf = 0
  function startMemo(ms: number) {
    memoTotal = memoLeft = ms
    resumeMemo()
  }
  function resumeMemo() {
    if (phase !== 'memo' || mode !== 'round') return
    clearTimeout(memoT)
    memoEnd = performance.now() + memoLeft
    memoT = window.setTimeout(endMemo, memoLeft)
    tickMemo()
  }
  function pauseMemo() {
    if (phase !== 'memo') return
    clearTimeout(memoT)
    cancelAnimationFrame(memoRaf)
    memoLeft = Math.max(0, memoEnd - performance.now())
  }
  function tickMemo() {
    cancelAnimationFrame(memoRaf)
    const left = Math.max(0, memoEnd - performance.now())
    $('timerBar').style.transform = `scaleX(${(left / memoTotal).toFixed(4)})`
    $('timerSecs').textContent = `${Math.ceil(left / 1000)}s`
    if (left > 0 && phase === 'memo') memoRaf = requestAnimationFrame(tickMemo)
  }
  function endMemo() {
    if (phase !== 'memo') return
    clearTimeout(memoT)
    cancelAnimationFrame(memoRaf)
    phase = 'draw'
    $('memo').hidden = true
    $('briefKicker').textContent = `Figure ${idx + 1} of ${figures.length} · from memory`
    hint.textContent = 'Click the stars to join them. Click the last one again, or empty sky, to lift the pen.'
    shell.announce(`The lines are gone. Draw ${figureName(figures[idx])}.`)
    sfx.blip(1)
    paintTools()
    invalidate()
  }

  let peekT = 0
  function peek() {
    if (mode !== 'round' || phase !== 'draw' || peeking || shell.paused) return
    peeks++
    peeking = true
    sfx.blip(3)
    $('briefSub').textContent = `${figureEdges(figures[idx]).length} lines. Peeked ${peeks} time${peeks === 1 ? '' : 's'} (−${PEEK_COST * peeks}).`
    invalidate()
    clearTimeout(peekT)
    peekT = window.setTimeout(() => { peeking = false; invalidate() }, 1600)
  }

  function check() {
    if (mode !== 'round' || phase !== 'draw' || shell.paused) return
    commitChain(roundPad)
    if (!roundPad.chains.length) {
      hint.textContent = 'Join at least two stars first.'
      shell.shake(scene)
      sfx.bad()
      invalidate()
      return
    }
    const id = figures[idx]
    const trace = traceScore(figureEdges(id), padEdges(roundPad))
    const score = withPeeks(trace.score, peeks)
    current = { id, trace, peeks, score }
    results.push(current)
    phase = 'checked'
    peeking = false

    const total = trace.hit.length + trace.missed.length
    $('vScore').textContent = `${score}%`
    const facts = [
      `<li><b>${trace.hit.length} of ${total}</b> real lines</li>`,
      `<li><b>${trace.extra.length}</b> not in the figure</li>`,
    ]
    if (peeks) facts.push(`<li><b>${peeks}</b> peek${peeks === 1 ? '' : 's'}, −${PEEK_COST * peeks}</li>`)
    $('vFacts').innerHTML = facts.join('')
    $('briefKicker').textContent = `Figure ${idx + 1} of ${figures.length} · ${verdictFor(score).name.replace(/\.$/, '')}`
    $('briefSub').textContent = trace.missed.length || trace.extra.length
      ? 'Mint you got, red is not in it, dashed you missed.'
      : 'Every line, and nothing else.'
    $('nextLbl').textContent = idx + 1 < figures.length ? 'Next figure' : 'See the round'
    $('verdict').hidden = false
    $('verdict').focus({ preventScroll: true })
    hint.textContent = 'Here is the real figure, over yours.'
    shell.announce(`${figureName(id)}: ${score} percent. ${trace.hit.length} of ${total} lines.`)
    if (score >= 75) { sfx.good(); shell.pop($('verdict')) } else if (score < 35) sfx.bad()
    else sfx.click()
    paintRail()
    paintStrip()
    paintTools()
    invalidate()
  }

  function next() {
    if (phase !== 'checked') return
    if (idx + 1 < figures.length) {
      idx++
      startFigure()
      return
    }
    finish()
  }

  function finish() {
    phase = 'done'
    paintRail()
    paintTools()
    const a = avg()
    const v = verdictFor(a)
    const top = [...results].sort((x, y) => y.score - x.score)[0]
    shell.considerBest(a, `${a}%`)
    recordPlay('constellation-draw', { accuracy: a, figures: results.map((r) => r.id).join(' ') }, { accuracy: 'high' })
    shell.resultExtra.innerHTML = `<ul class="cd-sheet" role="list">${results.map(thumb).join('')}</ul>`
    shell.win({
      kicker: `${results.length} figures, from memory`,
      title: v.name,
      score: `${a}%`,
      from: '0%',
      lines: [v.line, `Best: ${figureName(top.id)}, ${top.score}%.`],
      againLabel: 'Another round',
    })
  }

  /** A small chart of one figure for the result card: yours over the real one. */
  function thumb(r: Result): string {
    const view = figureView(r.id)
    const ids = new Set<number>(figureStars(r.id))
    const pairs = (keys: string[]) => keys.map((k) => k.split('-').map(Number) as [number, number])
    for (const [a, b] of pairs(r.trace.extra)) { ids.add(a); ids.add(b) }
    const pts = new Map<number, [number, number]>()
    for (const id of ids) {
      const s = starById(id)
      if (!s) continue
      const p = project(s.ra, s.dec, view.ra, view.dec)
      if (p.visible) pts.set(id, [p.x, -p.y])
    }
    const xs = [...pts.values()].map((p) => p[0]), ys = [...pts.values()].map((p) => p[1])
    const minX = Math.min(...xs), maxX = Math.max(...xs), minY = Math.min(...ys), maxY = Math.max(...ys)
    const VW = 160, VH = 110, P = 12
    const k = Math.min((VW - 2 * P) / (maxX - minX || 1), (VH - 2 * P) / (maxY - minY || 1))
    const ox = (VW - (maxX - minX) * k) / 2, oy = (VH - (maxY - minY) * k) / 2
    const at = (id: number) => { const p = pts.get(id)!; return [ox + (p[0] - minX) * k, oy + (p[1] - minY) * k].map((n) => n.toFixed(1)) }
    const line = ([a, b]: [number, number], attrs: string) => {
      if (!pts.has(a) || !pts.has(b)) return ''
      const [x1, y1] = at(a), [x2, y2] = at(b)
      return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" ${attrs}/>`
    }
    const svg =
      pairs(r.trace.missed).map((e) => line(e, `stroke="${MISSED}" stroke-width="1.4" stroke-dasharray="3 3"`)).join('') +
      pairs(r.trace.extra).map((e) => line(e, `stroke="${RED}" stroke-width="2"`)).join('') +
      pairs(r.trace.hit).map((e) => line(e, `stroke="${MINT}" stroke-width="2.2"`)).join('') +
      [...pts.keys()].map((id) => { const [x, y] = at(id); return `<circle cx="${x}" cy="${y}" r="2" fill="#f3f5f8"/>` }).join('')
    return `<li><svg viewBox="0 0 ${VW} ${VH}" aria-hidden="true" stroke-linecap="round">${svg}</svg>` +
      `<b class="num">${r.score}%</b><span>${figureName(r.id)}</span></li>`
  }

  /* ---- fitting and flying ---------------------------------------------- */

  let fly: { from: [number, number, number]; to: [number, number, number]; t0: number; ms: number } | null = null
  function flyTo(ra: number, dec: number, sc: number, animate = true) {
    sc = Math.max(SCALE_MIN, Math.min(SCALE_MAX, sc))
    if (!animate || !PLAY) {
      fly = null
      ra0 = wrapRa(ra); dec0 = clampDec(dec); scale = sc
      invalidate()
      return
    }
    // The short way round: RA 350° to 10° is twenty degrees, not 340.
    let dRa = wrapRa(ra) - ra0
    if (dRa > 180) dRa -= 360
    if (dRa < -180) dRa += 360
    fly = { from: [ra0, dec0, Math.log(scale)], to: [ra0 + dRa, clampDec(dec), Math.log(sc)], t0: performance.now(), ms: 950 }
    invalidate()
  }
  function fitFigure(id: string, animate = true) {
    const v = fitView(id, W, H, SCALE_MIN, SCALE_MAX)
    flyTo(v.ra0, v.dec0, v.scale, animate)
  }

  /* ---- rendering -------------------------------------------------------- */

  // A real astrophoto's brightest stars aren't flat dots: the optics bloom a
  // soft halo around them and throw a four-point diffraction spike off the
  // very brightest. Below this magnitude a halo would be sub-pixel anyway —
  // skipping it there keeps ~8,900 stars a frame cheap.
  const HALO_MAG = 4.2
  const SPIKE_MAG = 1.5

  function drawStar(star: Star, sx: number, sy: number) {
    const r = Math.max(0.5, 2.6 - star.mag * 0.35)
    const [cr, cg, cb] = starRgb(star.ci)
    const rgb = `${cr},${cg},${cb}`
    if (star.mag < HALO_MAG) {
      const haloR = r * (star.mag < 0 ? 9 : star.mag < 1.5 ? 7 : star.mag < 3 ? 4.5 : 2.6)
      const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, haloR)
      glow.addColorStop(0, `rgba(${rgb},0.55)`)
      glow.addColorStop(0.4, `rgba(${rgb},0.16)`)
      glow.addColorStop(1, `rgba(${rgb},0)`)
      ctx.fillStyle = glow
      ctx.beginPath()
      ctx.arc(sx, sy, haloR, 0, Math.PI * 2)
      ctx.fill()
      if (star.mag < SPIKE_MAG) {
        const len = haloR * 2.6
        for (const [dx, dy] of [[1, 0], [0, 1]]) {
          const g = ctx.createLinearGradient(sx - dx * len, sy - dy * len, sx + dx * len, sy + dy * len)
          g.addColorStop(0, `rgba(${rgb},0)`)
          g.addColorStop(0.5, `rgba(${rgb},0.65)`)
          g.addColorStop(1, `rgba(${rgb},0)`)
          ctx.strokeStyle = g
          ctx.lineWidth = 1
          ctx.beginPath(); ctx.moveTo(sx - dx * len, sy - dy * len); ctx.lineTo(sx + dx * len, sy + dy * len); ctx.stroke()
        }
      }
    }
    ctx.beginPath()
    ctx.fillStyle = `rgb(${rgb})`
    ctx.arc(sx, sy, r, 0, Math.PI * 2)
    ctx.fill()
  }

  function strokeEdges(edges: readonly (readonly [number, number])[], colour: string, width: number, dash: number[] = []) {
    ctx.strokeStyle = colour
    ctx.lineWidth = width
    ctx.setLineDash(dash)
    ctx.beginPath()
    for (const [a, b] of edges) {
      const p = starScreen(a), q = starScreen(b)
      if (!p || !q) continue
      ctx.moveTo(p.sx, p.sy)
      ctx.lineTo(q.sx, q.sy)
    }
    ctx.stroke()
    ctx.setLineDash([])
  }
  const keysToEdges = (keys: string[]) => keys.map((k) => k.split('-').map(Number) as [number, number])

  /** The real figure, lit: what you are memorising, or peeking at. */
  function drawFigure(id: string) {
    ctx.save()
    ctx.shadowColor = MINT
    ctx.shadowBlur = 12
    strokeEdges(figureEdges(id), 'rgba(79,227,193,0.9)', 2.2)
    ctx.restore()
    for (const sid of figureStars(id)) {
      const p = starScreen(sid)
      if (!p) continue
      ctx.beginPath()
      ctx.arc(p.sx, p.sy, 7, 0, Math.PI * 2)
      ctx.strokeStyle = 'rgba(79,227,193,0.55)'
      ctx.lineWidth = 1.2
      ctx.stroke()
    }
  }

  function drawAllFigures() {
    ctx.strokeStyle = 'rgba(184,161,255,0.24)'
    ctx.lineWidth = 1
    for (const c of CONSTELLATIONS) {
      for (const seg of c.segments) {
        ctx.beginPath()
        let started = false
        for (const [ra, dec] of seg) {
          const p = project(ra, dec, ra0, dec0)
          if (!p.visible) { started = false; continue }
          const [sx, sy] = toScreen(p.x, p.y)
          if (!started) { ctx.moveTo(sx, sy); started = true } else ctx.lineTo(sx, sy)
        }
        ctx.stroke()
      }
    }
    // Each name over its own figure, anchored to whichever of its points is
    // highest on screen this frame — the way a planetarium labels one.
    ctx.font = `600 12px ${SANS}`
    ctx.textAlign = 'center'
    ctx.fillStyle = 'rgba(214,222,240,0.62)'
    for (const c of CONSTELLATIONS) {
      let top: { sx: number; sy: number } | null = null
      let n = 0
      for (const seg of c.segments) for (const [ra, dec] of seg) {
        const p = screenOf(ra, dec, 0)
        if (!p) continue
        n++
        if (!top || p.sy < top.sy) top = p
      }
      if (top && n >= 2) ctx.fillText(figureName(c.id).toUpperCase(), top.sx, top.sy - 10)
    }
  }

  let drawColor = colorCss('c')

  function render() {
    ctx.clearRect(0, 0, W, H)
    const bg = ctx.createRadialGradient(W * 0.5, H * 0.35, 0, W * 0.5, H * 0.35, Math.max(W, H) * 0.8)
    bg.addColorStop(0, '#0b1224')
    bg.addColorStop(1, '#04060c')
    ctx.fillStyle = bg
    ctx.fillRect(0, 0, W, H)

    if (mode === 'free' && showReal) drawAllFigures()
    const id = figures[idx]
    if (mode === 'round' && id && (phase === 'memo' || peeking)) drawFigure(id)

    for (const star of STARS) {
      const p = screenOf(star.ra, star.dec)
      if (p) drawStar(star, p.sx, p.sy)
    }

    ctx.lineCap = 'round'
    if (mode === 'round' && (phase === 'checked' || phase === 'done') && current) {
      strokeEdges(keysToEdges(current.trace.missed), MISSED, 1.6, [5, 6])
      strokeEdges(keysToEdges(current.trace.extra), RED, 2.6)
      strokeEdges(keysToEdges(current.trace.hit), MINT, 2.8)
    } else {
      const p = pad()
      strokeEdges(padEdges(p), mode === 'round' ? SKY : drawColor, 2.4)
      const a = armed()
      if (a !== null) {
        const s = starScreen(a)
        if (s) {
          ctx.beginPath()
          ctx.arc(s.sx, s.sy, 8, 0, Math.PI * 2)
          ctx.strokeStyle = mode === 'round' ? SKY : drawColor
          ctx.lineWidth = 1.6
          ctx.stroke()
        }
      }
    }

    const raH = wrapRa(ra0) / 15
    const h = String(Math.floor(raH)).padStart(2, '0')
    const m = String(Math.floor((raH % 1) * 60)).padStart(2, '0')
    const dAbs = Math.abs(dec0)
    const text = `RA ${h}h ${m}m · Dec ${dec0 >= 0 ? '+' : '−'}${String(Math.floor(dAbs)).padStart(2, '0')}° ${String(Math.floor((dAbs % 1) * 60)).padStart(2, '0')}′`
    if (coordsEl.textContent !== text) coordsEl.textContent = text
  }

  /* Drawn on demand, not every frame: nine thousand stars is cheap once and
     wasteful sixty times a second while nothing is moving. */
  let raf = 0
  function invalidate() {
    if (!raf) raf = requestAnimationFrame(frame)
  }
  function frame(now: number) {
    raf = 0
    if (fly) {
      const t = Math.min(1, (now - fly.t0) / fly.ms)
      const e = 1 - Math.pow(1 - t, 3)
      ra0 = wrapRa(fly.from[0] + (fly.to[0] - fly.from[0]) * e)
      dec0 = fly.from[1] + (fly.to[1] - fly.from[1]) * e
      scale = Math.exp(fly.from[2] + (fly.to[2] - fly.from[2]) * e)
      if (t >= 1) fly = null
    }
    render()
    if (fly) invalidate()
  }

  function resize() {
    const r = scene.getBoundingClientRect()
    W = Math.max(1, Math.round(r.width))
    H = Math.max(1, Math.round(r.height))
    dpr = Math.min(devicePixelRatio || 1, 2)
    canvas.width = Math.round(W * dpr)
    canvas.height = Math.round(H * dpr)
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    invalidate()
  }
  resize()
  new ResizeObserver(resize).observe(scene)

  /* ---- pan, zoom, pinch -------------------------------------------------- */

  const pointers = new Map<number, { x: number; y: number }>()
  let dragMoved = false
  let dragStart = { x: 0, y: 0, ra0: 0, dec0: 0 }
  let pinch: { d: number; scale: number } | null = null

  function zoomBy(f: number) {
    fly = null
    scale = Math.max(SCALE_MIN, Math.min(SCALE_MAX, scale * f))
    invalidate()
  }

  canvas.addEventListener('pointerdown', (e) => {
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })
    canvas.setPointerCapture(e.pointerId)
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()]
      pinch = { d: Math.hypot(a.x - b.x, a.y - b.y), scale }
      dragMoved = true
      return
    }
    dragMoved = false
    dragStart = { x: e.clientX, y: e.clientY, ra0, dec0 }
  })
  canvas.addEventListener('pointermove', (e) => {
    if (!pointers.has(e.pointerId)) return
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })
    if (pinch && pointers.size === 2) {
      const [a, b] = [...pointers.values()]
      scale = Math.max(SCALE_MIN, Math.min(SCALE_MAX, pinch.scale * (Math.hypot(a.x - b.x, a.y - b.y) / pinch.d)))
      invalidate()
      return
    }
    const dx = e.clientX - dragStart.x
    const dy = e.clientY - dragStart.y
    if (!dragMoved && Math.hypot(dx, dy) > 5) dragMoved = true
    if (!dragMoved) return
    fly = null
    const moved = unproject(-dx / scale, dy / scale, dragStart.ra0, dragStart.dec0)
    ra0 = wrapRa(moved.ra)
    dec0 = clampDec(moved.dec)
    invalidate()
  })
  const lift = (e: PointerEvent) => {
    const was = pointers.has(e.pointerId)
    pointers.delete(e.pointerId)
    if (pointers.size < 2) pinch = null
    if (was && e.type === 'pointerup' && !dragMoved && pointers.size === 0) {
      const r = canvas.getBoundingClientRect()
      handleClick(e.clientX - r.left, e.clientY - r.top)
    }
    if (pointers.size === 1) {
      const [p] = [...pointers.values()]
      dragStart = { x: p.x, y: p.y, ra0, dec0 }
    }
  }
  canvas.addEventListener('pointerup', lift)
  canvas.addEventListener('pointercancel', lift)
  // A plain wheel scrolls the page past the sky, the way an embedded map does;
  // Ctrl or ⌘ with it zooms, and so does a trackpad pinch, which arrives as a
  // wheel event with ctrlKey set.
  let wheelHintT = 0
  canvas.addEventListener('wheel', (e) => {
    if (!e.ctrlKey && !e.metaKey) {
      $('wheelNote').hidden = false
      clearTimeout(wheelHintT)
      wheelHintT = window.setTimeout(() => { $('wheelNote').hidden = true }, 1400)
      return
    }
    e.preventDefault()
    zoomBy(Math.exp(-e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0025)))
  }, { passive: false })
  $('zoomIn').addEventListener('click', () => zoomBy(1.4))
  $('zoomOut').addEventListener('click', () => zoomBy(1 / 1.4))

  /* ---- joining stars ----------------------------------------------------- */

  const DRAW_HINT = 'Click the stars to join them. Click the last one again, or empty sky, to lift the pen.'

  function handleClick(cx: number, cy: number) {
    if (shell.paused) return
    if (mode === 'round' && phase === 'memo') {
      hint.textContent = 'Not yet: take it in first. Press Got it when you are ready.'
      return
    }
    if (mode === 'round' && phase !== 'draw') return
    const p = pad()
    const hit = pickStar(cx, cy, { ra0, dec0, scale, W, H })
    if (!hit) {
      commitChain(p)
      hint.textContent = mode === 'round' ? DRAW_HINT : 'Drag to look around. Click two stars to join them.'
    } else if (armed() === hit.id) {
      commitChain(p)
      hint.textContent = `Pen lifted at ${starLabel(hit)}.`
    } else {
      sfx.click()
      p.chain.push(hit.id)
      hint.textContent = p.chain.length === 1
        ? `${starLabel(hit)}. Now the next star.`
        : `${starLabel(hit)}. Keep going, or click it again to lift the pen.`
    }
    changed()
  }

  function undo() {
    const p = pad()
    if (p.chain.length > 1) p.chain.pop()
    else if (p.chain.length === 1) p.chain = []
    else if (p.chains.length) { p.chain = p.chains.pop()!; p.chain.pop() }
    const a = armed()
    const s = a !== null ? starById(a) : null
    hint.textContent = s ? `${starLabel(s)}. Pick the next star.` : 'Undone.'
    changed()
  }
  function clearPad() {
    const p = pad()
    p.chains = []
    p.chain = []
    hint.textContent = 'Cleared.'
    changed()
  }
  function changed() {
    if (mode === 'round') shell.setMoves(String(lineCount(roundPad)))
    invalidate()
  }

  $('undoBtn').addEventListener('click', () => { if (phase === 'draw') undo() })
  $('clearBtn').addEventListener('click', () => { if (phase === 'draw') clearPad() })
  $('peekBtn').addEventListener('click', peek)
  $('checkBtn').addEventListener('click', check)
  $('gotIt').addEventListener('click', endMemo)
  $('nextBtn').addEventListener('click', next)

  function paintTools() {
    const drawing = phase === 'draw'
    for (const id of ['peekBtn', 'undoBtn', 'clearBtn', 'checkBtn']) $<HTMLButtonElement>(id).disabled = !drawing
  }

  addEventListener('keydown', (e) => {
    if (mode !== 'round' || shell.paused || e.metaKey || e.ctrlKey || e.altKey) return
    const t = e.target as HTMLElement
    if (t.closest('input, textarea, select, dialog[open]')) return
    if (e.key === 'Enter') {
      // A focused button already answers Enter with its own click.
      if (t.closest('button, a')) return
      e.preventDefault()
      if (phase === 'memo') endMemo()
      else if (phase === 'draw') check()
      else if (phase === 'checked') next()
    } else if (e.key === 'u' || e.key === 'U') { if (phase === 'draw') undo() }
    else if (e.key === 'r' || e.key === 'R') peek()
  })

  /* ---- modes --------------------------------------------------------------- */

  function setMode(m: 'round' | 'free') {
    if (m === mode) return
    if (mode === 'round') pauseMemo()
    mode = m
    root.dataset.mode = m
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]')) b.setAttribute('aria-pressed', String(b.dataset.modeBtn === m))
    for (const el of root.querySelectorAll<HTMLElement>('[data-for]')) el.hidden = el.dataset.for !== m
    if (m === 'round') {
      hint.textContent = phase === 'memo' ? 'Take it in. You will draw it from memory.' : phase === 'draw' ? DRAW_HINT : 'Here is the real figure, over yours.'
      if (figures[idx]) fitFigure(figures[idx])
      resumeMemo()
    } else {
      hint.textContent = 'The whole sky. Drag to look around; click two stars to join them.'
    }
    sfx.click()
    invalidate()
  }
  root.querySelector('.cd-modes')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mode-btn]')
    if (b) setMode(b.dataset.modeBtn as 'round' | 'free')
  })

  /* ---- the free sky ---------------------------------------------------------- */

  let showReal = true
  $('toggleReal').addEventListener('click', (e) => {
    showReal = !showReal
    ;(e.currentTarget as HTMLButtonElement).setAttribute('aria-pressed', String(showReal))
    invalidate()
  })
  $('freeUndo').addEventListener('click', undo)
  $('freeClear').addEventListener('click', clearPad)
  root.querySelectorAll<HTMLButtonElement>('.cd-swatch').forEach((btn) => {
    btn.addEventListener('click', () => {
      drawColor = colorCss(btn.dataset.color!)
      root.querySelectorAll('.cd-swatch').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)))
      invalidate()
    })
  })

  function showConstellation(id: string) {
    const meta = constellationName(id)
    if (!meta) return
    const brightest = brightestIn(id)
    $('infoKicker').textContent = meta.english !== meta.name ? meta.english : 'A real IAU constellation'
    $('infoName').textContent = meta.name
    $('infoFact').textContent = brightest
      ? `Genitive: ${meta.genitive}. Its brightest star is ${starLabel(brightest)}, magnitude ${brightest.mag.toFixed(2)}.`
      : `Genitive: ${meta.genitive}. Nothing in it is bright enough for this catalogue's naked-eye cutoff.`
    $('infoCard').hidden = false
  }

  $('randomBtn').addEventListener('click', () => {
    const c = CONSTELLATIONS[Math.floor(Math.random() * CONSTELLATIONS.length)]
    fitFigure(c.id)
    showConstellation(c.id)
    sfx.blip(2)
  })

  const searchInput = $<HTMLInputElement>('search')
  const resultsEl = $<HTMLUListElement>('searchResults')
  searchInput.addEventListener('input', () => {
    const stars = searchStars(searchInput.value, 6)
    resultsEl.innerHTML = ''
    for (const s of stars) {
      const li = document.createElement('li')
      const b = document.createElement('button')
      b.type = 'button'
      b.textContent = `${starLabel(s)} · ${constellationName(s.con)?.name ?? s.con}`
      b.addEventListener('click', () => {
        flyTo(s.ra, s.dec, 1100)
        resultsEl.hidden = true
        searchInput.value = ''
        showConstellation(s.con)
        hint.textContent = `${starLabel(s)}, magnitude ${s.mag.toFixed(2)}.`
      })
      li.append(b)
      resultsEl.append(li)
    }
    resultsEl.hidden = stars.length === 0
  })

  const saveDialog = $<HTMLDialogElement>('saveDialog')
  const nameInput = $<HTMLInputElement>('nameInput')
  const saveStatus = $('saveStatus')
  $('saveBtn').addEventListener('click', () => {
    commitChain(freePad)
    invalidate()
    if (!freePad.chains.length) {
      hint.textContent = 'Join at least two stars first.'
      shell.shake(scene)
      return
    }
    saveStatus.textContent = ''
    saveDialog.showModal()
  })
  $('saveCancel').addEventListener('click', () => saveDialog.close())
  saveDialog.addEventListener('click', (e) => { if (e.target === saveDialog) saveDialog.close() })
  $('saveConfirm').addEventListener('click', async () => {
    const strokes: Stroke[] = freePad.chains.map((starIds) => ({ starIds }))
    const url = new URL(location.href)
    url.searchParams.set('c', encodeStrokes(strokes))
    url.searchParams.set('n', nameInput.value.trim() || 'Untitled')
    try {
      await navigator.clipboard.writeText(url.toString())
      saveStatus.textContent = 'Link copied. Anyone who opens it sees your constellation.'
      sfx.good()
    } catch {
      saveStatus.textContent = url.toString()
    }
  })

  /* ---- boot: a shared drawing opens the free sky, anything else the round ---- */

  newRound()
  {
    const params = new URLSearchParams(location.search)
    const loaded = decodeStrokes(params.get('c') ?? '')
    if (loaded.length) {
      freePad.chains = loaded.map((s) => s.starIds)
      setMode('free')
      const pts = loaded.flatMap((s) => s.starIds).map(starById).filter((s): s is Star => !!s)
      if (pts.length) {
        // The mean direction on the sphere, so a drawing across RA 0° centres on itself.
        let x = 0, y = 0, z = 0
        for (const s of pts) {
          const r = (s.ra * Math.PI) / 180, d = (s.dec * Math.PI) / 180
          x += Math.cos(d) * Math.cos(r); y += Math.cos(d) * Math.sin(r); z += Math.sin(d)
        }
        flyTo((Math.atan2(y, x) * 180) / Math.PI, (Math.atan2(z, Math.hypot(x, y)) * 180) / Math.PI, 700, false)
      }
      const name = params.get('n')
      if (name) hint.textContent = `“${name}”, drawn by someone on this sky. Drag to look around.`
    }
  }
</script>

<style is:global>
  /* The head, the verdict and the result sheet are filled in by the script,
     so these rules are global on purpose. Everything is prefixed. */
  .cd { display: grid; gap: 12px; container-type: inline-size; }
  .cd [hidden] { display: none !important; }

  .cd-top { display: flex; flex-wrap: wrap; gap: 10px; align-items: stretch; justify-content: space-between; }
  .cd-rail { list-style: none; margin: 0; padding: 0; flex: 1 1 520px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .cd-rail li {
    display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 2px 8px;
    padding: 10px 12px; border-radius: var(--r); background: var(--paper2); min-width: 0;
  }
  .cd-rail li .label { color: var(--ink3); }
  .cd-rail li b { font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cd-rail .cd-got { grid-column: 1 / -1; font-size: 18px; }
  .cd-rail li.is-now { background: var(--card); box-shadow: inset 0 0 0 2px var(--ink); }
  .cd-rail li.is-done { background: var(--mint); }
  .cd-rail li.is-done .label { color: var(--ink); }
  .cd[data-mode='free'] .cd-rail { opacity: 0.5; }

  .cd-modes { display: flex; gap: 6px; align-items: center; flex: none; }
  .cd-modes .pill { background: var(--paper2); color: var(--ink); }
  .cd-modes .pill[aria-pressed='true'] { background: var(--ink); color: var(--ink-paper); }

  /* The bar above the sky: the figure's name and the countdown, then the
     verdict. A fixed minimum height, so the sky under it never jumps. */
  .cd-head {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px;
    min-height: 92px; padding: 14px 18px; border-radius: var(--r); background: var(--paper2);
  }
  .cd-brief { flex: 1 1 260px; min-width: 0; display: grid; gap: 2px; }
  .cd-name {
    font-family: var(--display); font-variation-settings: var(--display-axes);
    font-size: clamp(26px, 3.2vw, 38px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 600;
  }
  .cd-sub { font-size: 14px; color: var(--ink2); }
  .cd-memo { display: flex; align-items: center; gap: 12px; flex: 0 1 360px; }
  .cd-timer { flex: 1; height: 10px; border-radius: var(--r-pill); background: var(--paper3); overflow: hidden; min-width: 90px; }
  .cd-timer i { display: block; height: 100%; background: var(--ink); transform-origin: left center; border-radius: inherit; }
  .cd-secs { font-size: 20px; min-width: 2.2em; text-align: right; }
  .cd-verdict { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; outline: none; }
  .cd-big { font-size: clamp(40px, 5vw, 56px); line-height: 1; }
  .cd-facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font-size: 14px; color: var(--ink2); }
  .cd-facts b { color: var(--ink); }

  /* The free sky's bar: search and whatever constellation you just flew to. */
  .cd-search { position: relative; flex: 0 1 320px; min-width: 220px; }
  .cd-search input {
    width: 100%; box-sizing: border-box; padding: 11px 16px; border-radius: var(--r-pill);
    border: 2px solid var(--ink); background: var(--card); color: var(--ink); font: 500 15px var(--sans);
  }
  .cd-results {
    position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 6px);
    list-style: none; margin: 0; padding: 6px; border-radius: var(--r);
    background: var(--card); box-shadow: var(--shadow-block), 0 0 0 1.5px var(--paper3);
    max-height: 240px; overflow-y: auto;
  }
  .cd-results button {
    width: 100%; text-align: left; padding: 9px 10px; border: 0; border-radius: 10px;
    background: none; color: var(--ink); font: 500 14px var(--sans); cursor: pointer;
  }
  .cd-results button:hover, .cd-results button:focus-visible { background: var(--paper2); }
  .cd-info { flex: 1 1 280px; min-width: 0; display: grid; gap: 2px; }
  .cd-info-name { font-family: var(--display); font-variation-settings: var(--display-axes); font-size: 26px; font-weight: 600; line-height: 1.1; }
  .cd-info-fact { font-size: 14px; color: var(--ink2); }

  /* The sky itself: the one dark thing on the page, framed like a picture. */
  .cd-scene {
    position: relative; overflow: hidden; isolation: isolate;
    height: clamp(420px, 68vh, 760px);
    border: 2px solid var(--ink); border-radius: var(--r-lg); background: #04060c;
  }
  .cd-scene canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: crosshair; }
  .cd-coords {
    position: absolute; top: 14px; right: 16px; pointer-events: none;
    font-size: 12px; font-weight: 600; letter-spacing: 0.02em; color: rgba(214, 222, 240, 0.6);
  }
  .cd-zoom { position: absolute; right: 14px; bottom: 14px; display: grid; gap: 6px; }
  .cd-zoom button {
    width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid rgba(214, 222, 240, 0.35);
    background: rgba(4, 6, 12, 0.7); color: #f3f5f8; font: 600 20px/1 var(--sans); cursor: pointer;
  }
  .cd-zoom button:hover { background: rgba(40, 52, 80, 0.85); }
  .cd-wheel {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); pointer-events: none;
    padding: 12px 18px; border-radius: var(--r-pill); background: rgba(4, 6, 12, 0.82);
    color: #f3f5f8; font-size: 15px; font-weight: 600;
