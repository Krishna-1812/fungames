---
import GameLayout from '../layouts/GameLayout.astro'
import { iconSvg } from '../lib/icons'
import { DRAW_COLORS } from '../lib/constellation-code'

/**
 * Constellation Draw — almost 9,000 real stars, at their real position and
 * real brightness, projected the way an actual planetarium does it.
 *
 * The data (src/data/star-catalog.ts, src/data/constellation-lines.ts) is
 * real: HYG v4.4 down to magnitude 6.5, and the real western constellation
 * line figures every planetarium app draws (scripts/build-star-data.mjs,
 * run once at author time — see that file for sources and licensing).
 *
 * The projection (lib/sky-projection.ts) is a real gnomonic tangent-plane
 * projection recomputed around the current look direction on every pan,
 * not a flat RA/Dec map — a flat map warps constellations badly near the
 * poles, which is the exact mistake this avoids. lib/star-color.ts turns
 * each star's real B-V colour index into a real approximate RGB colour via
 * a real published temperature formula, so Betelgeuse actually looks
 * redder than Rigel rather than every star being a plain white dot.
 */
---

<GameLayout slug="constellation-draw" bar="#0a0612" fixed bodyClass="cdraw-body">
  <canvas id="sky" aria-label="A real, navigable map of the night sky"></canvas>

  <div class="chrome" aria-hidden="true">
    <div class="coords" id="coords">RA 00h 00m 00s Dec +00° 00&prime;</div>
    <p class="hint" id="hint">Drag to look around. Click two stars to connect them.</p>

    <div class="search-wrap">
      <input id="search" type="text" placeholder="Fly to a star or constellation…" autocomplete="off" />
      <ul id="searchResults" class="search-results" hidden></ul>
    </div>

    <div class="card" id="infoCard" hidden>
      <button class="card-close" id="infoClose" type="button" aria-label="Close">&times;</button>
      <p class="card-kicker" id="infoKicker"></p>
      <h2 id="infoName"></h2>
      <p id="infoFact"></p>
    </div>

    <div class="toolbar">
      <div class="swatch-wrap">
        <button class="swatch-btn" id="swatchBtn" type="button" style={`--sw:${DRAW_COLORS[0].css}`} aria-label="Choose a draw colour"></button>
        <div class="swatches" id="swatches" hidden>
          {DRAW_COLORS.map((c, i) => (
            <button class="swatch" data-color={c.key} style={`--sw:${c.css}`} aria-label="Draw in this colour" aria-pressed={i === 0 ? 'true' : 'false'}></button>
          ))}
        </div>
      </div>
      <span class="tsep" aria-hidden="true"></span>
      <button class="tbtn" id="toggleReal" type="button" aria-pressed="true" data-tip="Real constellations">
        <span class="tbtn-icon" set:html={iconSvg('star')} />
      </button>
      <button class="tbtn" id="randomBtn" type="button" data-tip="Surprise me">
        <span class="tbtn-icon" set:html={iconSvg('compass')} />
      </button>
      <button class="tbtn" id="undoBtn" type="button" data-tip="Undo">
        <span class="tbtn-icon" set:html={iconSvg('undo')} />
      </button>
      <button class="tbtn" id="clearBtn" type="button" data-tip="Clear">
        <span class="tbtn-icon" set:html={iconSvg('trash')} />
      </button>
      <button class="tbtn primary" id="saveBtn" type="button" data-tip="Name &amp; save">
        <span class="tbtn-icon" set:html={iconSvg('link')} />
      </button>
    </div>
  </div>

  <dialog id="saveDialog" class="save-dialog" aria-labelledby="saveTitle">
    <h2 id="saveTitle">Name your constellation</h2>
    <input id="nameInput" type="text" maxlength="40" placeholder="e.g. The Kettle" />
    <div class="save-actions">
      <button id="saveCancel" type="button">Cancel</button>
      <button id="saveConfirm" type="button" class="primary">Save &amp; copy link</button>
    </div>
    <p class="save-status" id="saveStatus" aria-live="polite"></p>
  </dialog>
</GameLayout>

<script>
  import { STARS, CONSTELLATIONS, constellationName, starLabel, brightestIn, nearestStar, searchStars, type Star } from '../lib/star-catalog'
  import { project, unproject, angularSeparationDeg, wrapRa, clampDec } from '../lib/sky-projection'
  import { starRgb } from '../lib/star-color'
  import { encodeStrokes, decodeStrokes, colorCss, DRAW_COLORS, type Stroke } from '../lib/constellation-code'
  import { sfx } from '../lib/audio'

  const canvas = document.getElementById('sky') as HTMLCanvasElement
  const ctx = canvas.getContext('2d')!
  const hint = document.getElementById('hint')!
  const coordsEl = document.getElementById('coords')!

  let W = 0, H = 0, dpr = 1
  function resize() {
    W = innerWidth
    H = innerHeight
    dpr = Math.min(devicePixelRatio || 1, 2)
    canvas.width = Math.round(W * dpr)
    canvas.height = Math.round(H * dpr)
    canvas.style.width = W + 'px'
    canvas.style.height = H + 'px'
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
  }
  resize()
  let resizeTimer = 0
  addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(resize, 150) })

  /* ---- view state ----------------------------------------------------- */

  // Start looking at Orion, the most recognisable real constellation there is.
  let ra0 = 83.0
  let dec0 = 0.0
  // Pixels per radian of arc at the tangent point. ~110deg field of view at start.
  let scale = 480
  const SCALE_MIN = 120
  const SCALE_MAX = 6000

  let showReal = true
  let strokes: Stroke[] = []
  let currentChain: number[] = []
  let armedStar: Star | null = null
  let drawColor = DRAW_COLORS[0].css

  function toScreen(x: number, y: number): [number, number] {
    return [W / 2 + x * scale, H / 2 - y * scale]
  }
  function project2(star: Star) {
    const p = project(star.ra, star.dec, ra0, dec0)
    if (!p.visible) return null
    const [sx, sy] = toScreen(p.x, p.y)
    if (sx < -40 || sx > W + 40 || sy < -40 || sy > H + 40) return null
    return { sx, sy }
  }

  /* ---- rendering -------------------------------------------------------- */

  // A real astrophoto's brightest stars aren't flat dots: the optics bloom a
  // soft halo around them and throw a four-point diffraction spike off the
  // very brightest. Below this magnitude a halo would be sub-pixel anyway —
  // skipping it there keeps ~8,900 stars/frame cheap.
  const HALO_MAG = 4.2
  const SPIKE_MAG = 1.5

  function drawStar(star: Star, sx: number, sy: number) {
    const r = Math.max(0.5, 2.6 - star.mag * 0.35)
    const [cr, cg, cb] = starRgb(star.ci)
    const rgb = `${cr},${cg},${cb}`

    if (star.mag < HALO_MAG) {
      const haloR = r * (star.mag < 0 ? 9 : star.mag < 1.5 ? 7 : star.mag < 3 ? 4.5 : 2.6)
      const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, haloR)
      glow.addColorStop(0, `rgba(${rgb},0.55)`)
      glow.addColorStop(0.4, `rgba(${rgb},0.16)`)
      glow.addColorStop(1, `rgba(${rgb},0)`)
      ctx.fillStyle = glow
      ctx.beginPath()
      ctx.arc(sx, sy, haloR, 0, Math.PI * 2)
      ctx.fill()

      if (star.mag < SPIKE_MAG) {
        const spikeLen = haloR * 2.6
        const spike = ctx.createLinearGradient(sx - spikeLen, sy, sx + spikeLen, sy)
        spike.addColorStop(0, `rgba(${rgb},0)`)
        spike.addColorStop(0.5, `rgba(${rgb},0.65)`)
        spike.addColorStop(1, `rgba(${rgb},0)`)
        ctx.strokeStyle = spike
        ctx.lineWidth = 1
        ctx.beginPath(); ctx.moveTo(sx - spikeLen, sy); ctx.lineTo(sx + spikeLen, sy); ctx.stroke()
        const spikeV = ctx.createLinearGradient(sx, sy - spikeLen, sx, sy + spikeLen)
        spikeV.addColorStop(0, `rgba(${rgb},0)`)
        spikeV.addColorStop(0.5, `rgba(${rgb},0.65)`)
        spikeV.addColorStop(1, `rgba(${rgb},0)`)
        ctx.strokeStyle = spikeV
        ctx.beginPath(); ctx.moveTo(sx, sy - spikeLen); ctx.lineTo(sx, sy + spikeLen); ctx.stroke()
      }
    }

    ctx.beginPath()
    ctx.fillStyle = `rgb(${rgb})`
    ctx.arc(sx, sy, r, 0, Math.PI * 2)
    ctx.fill()
  }

  // A constellation's name, floating over its own figure — the same way a
  // planetarium labels one — rather than only on click. Anchored to whichever
  // of its projected points lands highest on screen this frame.
  function drawConstellationLabels() {
    ctx.font = '500 12.5px "Bricolage Grotesque", sans-serif'
    ctx.textAlign = 'center'
    ctx.fillStyle = 'rgba(229,219,250,0.62)'
    for (const c of CONSTELLATIONS) {
      let top: { sx: number; sy: number } | null = null
      let visiblePoints = 0
      for (const seg of c.segments) {
        for (const [ra, dec] of seg) {
          const p = project(ra, dec, ra0, dec0)
          if (!p.visible) continue
          const [sx, sy] = toScreen(p.x, p.y)
          if (sx < 0 || sx > W || sy < 0 || sy > H) continue
          visiblePoints++
          if (!top || sy < top.sy) top = { sx, sy }
        }
      }
      if (!top || visiblePoints < 2) continue
      const meta = constellationName(c.id)
      ctx.fillText((meta?.name ?? c.id).toUpperCase(), top.sx, top.sy - 10)
    }
  }

  function render() {
    ctx.clearRect(0, 0, W, H)
    ctx.fillStyle = '#05040a'
    ctx.fillRect(0, 0, W, H)

    if (showReal) {
      ctx.strokeStyle = 'rgba(201,184,255,0.22)'
      ctx.lineWidth = 1
      for (const c of CONSTELLATIONS) {
        for (const seg of c.segments) {
          ctx.beginPath()
          let started = false
          for (const [ra, dec] of seg) {
            const p = project(ra, dec, ra0, dec0)
            if (!p.visible) { started = false; continue }
            const [sx, sy] = toScreen(p.x, p.y)
            if (!started) { ctx.moveTo(sx, sy); started = true } else ctx.lineTo(sx, sy)
          }
          ctx.stroke()
        }
      }
      drawConstellationLabels()
    }

    for (const star of STARS) {
      const p = project2(star)
      if (!p) continue
      drawStar(star, p.sx, p.sy)
    }

    // the visitor's own strokes
    ctx.lineWidth = 2.4
    ctx.lineCap = 'round'
    for (const stroke of [...strokes, { starIds: currentChain }] as Stroke[]) {
      if (stroke.starIds.length < 2) continue
      ctx.strokeStyle = drawColor
      ctx.beginPath()
      let started = false
      for (const id of stroke.starIds) {
        const star = STARS.find((s) => s.id === id)
        if (!star) continue
        const p = project2(star)
        if (!p) { started = false; continue }
        if (!started) { ctx.moveTo(p.sx, p.sy); started = true } else ctx.lineTo(p.sx, p.sy)
      }
      ctx.stroke()
    }

    if (armedStar) {
      const p = project2(armedStar)
      if (p) {
        ctx.beginPath()
        ctx.arc(p.sx, p.sy, 7, 0, Math.PI * 2)
        ctx.strokeStyle = drawColor
        ctx.lineWidth = 1.6
        ctx.stroke()
      }
    }

    const raHours = wrapRa(ra0) / 15
    const h = String(Math.floor(raHours)).padStart(2, '0')
    const raMinFull = (raHours % 1) * 60
    const m = String(Math.floor(raMinFull)).padStart(2, '0')
    const s = String(Math.floor((raMinFull % 1) * 60)).padStart(2, '0')
    const decSign = dec0 >= 0 ? '+' : '−'
    const decAbs = Math.abs(dec0)
    const decDeg = String(Math.floor(decAbs)).padStart(2, '0')
    const decMin = String(Math.floor((decAbs % 1) * 60)).padStart(2, '0')
    coordsEl.textContent = `RA ${h}h ${m}m ${s}s Dec ${decSign}${decDeg}° ${decMin}′`
  }

  let raf = 0
  function loop() { render(); raf = requestAnimationFrame(loop) }
  loop()

  /* ---- pan / zoom --------------------------------------------------------- */

  let dragging = false
  let dragMoved = false
  let dragStart = { x: 0, y: 0, ra0: 0, dec0: 0 }

  canvas.addEventListener('pointerdown', (e) => {
    dragging = true
    dragMoved = false
    dragStart = { x: e.clientX, y: e.clientY, ra0, dec0 }
    canvas.setPointerCapture(e.pointerId)
  })
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return
    const dx = e.clientX - dragStart.x
    const dy = e.clientY - dragStart.y
    if (Math.hypot(dx, dy) > 4) dragMoved = true
    if (!dragMoved) return
    const x = -dx / scale
    const y = dy / scale
    const moved = unproject(x, y, dragStart.ra0, dragStart.dec0)
    ra0 = wrapRa(moved.ra)
    dec0 = clampDec(moved.dec)
  })
  canvas.addEventListener('pointerup', (e) => {
    dragging = false
    if (!dragMoved) handleClick(e.clientX, e.clientY)
  })

  canvas.addEventListener('wheel', (e) => {
    e.preventDefault()
    const factor = Math.exp(-e.deltaY * 0.0012)
    scale = Math.max(SCALE_MIN, Math.min(SCALE_MAX, scale * factor))
  }, { passive: false })

  /* ---- click to connect ---------------------------------------------------- */

  function handleClick(clientX: number, clientY: number) {
    const rect = canvas.getBoundingClientRect()
    const x = (clientX - rect.left - W / 2) / scale
    const y = -(clientY - rect.top - H / 2) / scale
    const { ra, dec } = unproject(x, y, ra0, dec0)
    const maxDeg = (16 / scale) * (180 / Math.PI)
    const hit = nearestStar(ra, dec, maxDeg)

    if (!hit) {
      if (currentChain.length >= 2) strokes.push({ starIds: currentChain })
      currentChain = []
      armedStar = null
      return
    }
    sfx.click()
    if (!armedStar) {
      armedStar = hit
      currentChain = [hit.id]
      hint.textContent = `${starLabel(hit)} — pick another star to connect it to.`
      return
    }
    if (armedStar.id === hit.id) {
      if (currentChain.length >= 2) strokes.push({ starIds: currentChain })
      currentChain = []
      armedStar = null
      hint.textContent = 'Drag to look around. Click two stars to connect them.'
      return
    }
    currentChain.push(hit.id)
    armedStar = hit
    hint.textContent = `${starLabel(hit)} — keep going, or click it again to finish.`
  }

  /* ---- toolbar ------------------------------------------------------------- */

  document.getElementById('toggleReal')!.addEventListener('click', (e) => {
    showReal = !showReal
    ;(e.currentTarget as HTMLButtonElement).setAttribute('aria-pressed', String(showReal))
  })
  document.getElementById('undoBtn')!.addEventListener('click', () => {
    if (currentChain.length > 1) currentChain.pop()
    else if (currentChain.length === 1) currentChain = [] // a lone armed star with nothing connected yet: cancel it
    else if (strokes.length) { currentChain = strokes.pop()!.starIds; currentChain.pop() }
    armedStar = currentChain.length ? STARS.find((s) => s.id === currentChain[currentChain.length - 1]) ?? null : null
    hint.textContent = armedStar ? `${starLabel(armedStar)} — pick another star to connect it to.` : 'Drag to look around. Click two stars to connect them.'
  })
  document.getElementById('clearBtn')!.addEventListener('click', () => {
    strokes = []
    currentChain = []
    armedStar = null
    hint.textContent = 'Drag to look around. Click two stars to connect them.'
  })
  const swatchBtn = document.getElementById('swatchBtn') as HTMLButtonElement
  const swatchesEl = document.getElementById('swatches') as HTMLElement
  swatchBtn.addEventListener('click', () => { swatchesEl.hidden = !swatchesEl.hidden })
  document.querySelectorAll<HTMLButtonElement>('.swatch').forEach((btn) => {
    btn.addEventListener('click', () => {
      drawColor = colorCss(btn.dataset.color!)
      swatchBtn.style.setProperty('--sw', drawColor)
      document.querySelectorAll('.swatch').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)))
      swatchesEl.hidden = true
    })
  })
  document.addEventListener('click', (e) => {
    if (!swatchesEl.hidden && !(e.target as HTMLElement).closest('.swatch-wrap')) swatchesEl.hidden = true
  })

  /* ---- info card: constellation facts, and "surprise me" ------------------- */

  const infoCard = document.getElementById('infoCard') as HTMLElement
  const infoKicker = document.getElementById('infoKicker')!
  const infoName = document.getElementById('infoName')!
  const infoFact = document.getElementById('infoFact')!
  document.getElementById('infoClose')!.addEventListener('click', () => (infoCard.hidden = true))

  function flyTo(ra: number, dec: number) {
    ra0 = wrapRa(ra)
    dec0 = clampDec(dec)
  }

  function showConstellationCard(id: string) {
    const meta = constellationName(id)
    if (!meta) return
    const brightest = brightestIn(id)
    infoKicker.textContent = meta.english !== meta.name ? meta.english : 'A real IAU constellation'
    infoName.textContent = meta.name
    infoFact.textContent = brightest
      ? `Genitive: ${meta.genitive}. Its brightest catalogued star is ${starLabel(brightest)}, real magnitude ${brightest.mag.toFixed(2)}.`
      : `Genitive: ${meta.genitive}. Nothing in it is bright enough for this catalogue's naked-eye cutoff.`
    infoCard.hidden = false
  }

  document.getElementById('randomBtn')!.addEventListener('click', () => {
    const c = CONSTELLATIONS[Math.floor(Math.random() * CONSTELLATIONS.length)]
    const pts = c.segments.flat()
    const ra = pts.reduce((a, [r]) => a + r, 0) / pts.length
    const dec = pts.reduce((a, [, d]) => a + d, 0) / pts.length
    flyTo(ra, dec)
    scale = 700
    showConstellationCard(c.id)
  })

  /* ---- search --------------------------------------------------------------- */

  const searchInput = document.getElementById('search') as HTMLInputElement
  const resultsEl = document.getElementById('searchResults') as HTMLUListElement
  searchInput.addEventListener('input', () => {
    const q = searchInput.value
    const stars = searchStars(q, 6)
    resultsEl.innerHTML = ''
    for (const s of stars) {
      const li = document.createElement('li')
      li.textContent = `${starLabel(s)} — ${constellationName(s.con)?.name ?? s.con}`
      li.addEventListener('click', () => {
        flyTo(s.ra, s.dec)
        scale = 900
        resultsEl.hidden = true
        searchInput.value = ''
      })
      resultsEl.append(li)
    }
    resultsEl.hidden = stars.length === 0
  })

  /* ---- save / share ----------------------------------------------------------- */

  const saveDialog = document.getElementById('saveDialog') as HTMLDialogElement
  const nameInput = document.getElementById('nameInput') as HTMLInputElement
  const saveStatus = document.getElementById('saveStatus')!

  document.getElementById('saveBtn')!.addEventListener('click', () => {
    if (currentChain.length >= 2) strokes.push({ starIds: currentChain })
    currentChain = []
    armedStar = null
    if (!strokes.length) {
      hint.textContent = 'Connect at least two stars first.'
      return
    }
    saveStatus.textContent = ''
    saveDialog.showModal()
  })
  document.getElementById('saveCancel')!.addEventListener('click', () => saveDialog.close())
  document.getElementById('saveConfirm')!.addEventListener('click', async () => {
    const code = encodeStrokes(strokes)
    const name = nameInput.value.trim() || 'Untitled'
    const url = new URL(location.href)
    url.searchParams.set('c', code)
    url.searchParams.set('n', name)
    try {
      await navigator.clipboard.writeText(url.toString())
      saveStatus.textContent = 'Link copied.'
      sfx.good()
    } catch {
      saveStatus.textContent = url.toString()
    }
  })

  /* ---- load a shared drawing from the URL -------------------------------------- */

  {
    const params = new URLSearchParams(location.search)
    const code = params.get('c')
    if (code) {
      const loaded = decodeStrokes(code)
      if (loaded.length) {
        strokes = loaded
        const allIds = loaded.flatMap((s) => s.starIds)
        const pts = allIds.map((id) => STARS.find((s) => s.id === id)).filter((s): s is Star => !!s)
        if (pts.length) {
          flyTo(pts.reduce((a, s) => a + s.ra, 0) / pts.length, pts.reduce((a, s) => a + s.dec, 0) / pts.length)
          scale = 700
        }
        const name = params.get('n')
        if (name) hint.textContent = `Viewing "${name}" — drag to look around.`
      }
    }
  }
</script>

<style>
  :global(.cdraw-body) { background: #05040a; overflow: hidden; }

  #sky { position: fixed; inset: 0; touch-action: none; cursor: grab; }
  #sky:active { cursor: grabbing; }

  .chrome { position: fixed; inset: 0; pointer-events: none; font-family: 'Bricolage Grotesque', sans-serif; }
  .chrome > * { pointer-events: auto; }

  .coords {
    position: absolute; top: 58px; right: 16px;
    font-family: 'Space Mono', monospace; font-size: 12px; color: #d8cdf0;
    opacity: 0.55; white-space: nowrap; letter-spacing: 0.01em;
  }
  .hint {
    position: absolute; bottom: 92px; left: 50%; transform: translateX(-50%);
    margin: 0; width: max-content; max-width: min(560px, calc(100vw - 40px)); text-align: center;
    color: #f1ecfb; font-size: 15px; letter-spacing: 0.01em;
    text-shadow: 0 1px 10px rgba(0,0,0,0.7), 0 0 26px rgba(0,0,0,0.5);
    opacity: 0.92; transition: opacity 200ms var(--ease, ease);
  }

  .search-wrap { position: absolute; top: 92px; left: 16px; width: min(280px, calc(100vw - 32px)); }
  #search {
    width: 100%; box-sizing: border-box; padding: 9px 12px; border-radius: 10px;
    border: 1px solid rgba(201,184,255,0.25); background: rgba(10,6,18,0.75); color: #eee5ff;
    font: inherit; font-size: 13px; backdrop-filter: blur(6px);
  }
  #search::placeholder { color: rgba(216,205,240,0.45); }
  .search-results {
    list-style: none; margin: 6px 0 0; padding: 4px; border-radius: 10px;
    background: rgba(10,6,18,0.92); border: 1px solid rgba(201,184,255,0.2);
    font-size: 12.5px; color: #d8cdf0; max-height: 220px; overflow-y: auto;
  }
  .search-results li { padding: 7px 8px; border-radius: 6px; cursor: pointer; }
  .search-results li:hover { background: rgba(201,184,255,0.14); }

  .card {
    position: absolute; top: 92px; right: 16px; width: min(280px, calc(100vw - 32px));
    padding: 16px 18px; border-radius: 14px; background: rgba(12,8,22,0.88);
    border: 1px solid rgba(201,184,255,0.22); color: #e5dbfa; backdrop-filter: blur(8px);
  }
  .card-close { position: absolute; top: 8px; right: 10px; background: none; border: 0; color: #b7a6dd; font-size: 16px; cursor: pointer; }
  .card-kicker { margin: 0; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #b39ce8; }
  .card h2 { margin: 2px 0 8px; font-family: 'Oswald', sans-serif; font-size: 20px; }
  .card p:not(.card-kicker) { margin: 0; font-size: 12.5px; line-height: 1.5; color: #c9bce8; }

  .toolbar {
    position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%);
    display: flex; align-items: center; gap: 6px;
    padding: 7px; border-radius: 999px;
    background: rgba(10,6,18,0.82); border: 1px solid rgba(201,184,255,0.18); backdrop-filter: blur(10px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.45);
  }
  .swatch-wrap { position: relative; }
  .swatch-btn {
    width: 34px; height: 34px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.5);
    background: var(--sw); cursor: pointer; padding: 0; flex: none;
    transition: transform 140ms var(--ease-bounce, ease);
  }
  .swatch-btn:hover { transform: scale(1.08); }
  .swatches {
    position: absolute; bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%);
    display: flex; gap: 6px; padding: 8px; border-radius: 999px;
    background: rgba(10,6,18,0.92); border: 1px solid rgba(201,184,255,0.22); backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.45);
  }
  .swatches[hidden] { display: none; }
