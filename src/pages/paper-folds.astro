    --well: #14100c;
    --ink: #f8f0e2;
    --ink-soft: #baaa8e;
    --line: #3e3326;
    --accent: #f5b242;
    --rim: #604d36;
    --lift: #2b241c;
    --sink: #0e0b08;
    --on-accent: #14100c;
    --glow: rgb(245 178 66 / 0.34);
    --glow-soft: rgb(245 178 66 / 0.14);
    --rim-a: rgb(96 77 54 / 0.55);
    --line-a: rgb(62 51 38 / 0.85);
  }

  .sky {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: 0; pointer-events: none;
