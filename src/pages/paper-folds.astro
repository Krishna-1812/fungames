    overflow: hidden;
    border-radius: 26px;
    text-align: left;
    background:
      radial-gradient(120% 60% at 50% -18%, var(--glow-soft), transparent 62%),
      linear-gradient(180deg, var(--lift) 0, var(--surface) 210px);
    background-color: var(--surface);
    box-shadow:
      inset 0 1px 0 var(--rim-a),
      inset 0 0 0 1px rgb(255 255 255 / 0.035),
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 2px 6px rgb(0 0 0 / 0.4),
      0 34px 90px -26px rgb(0 0 0 / 0.85);
    transition: background-color 380ms var(--ease), box-shadow 500ms var(--ease);
  }
  /* A milestone lights the edge rather than shouting. */
  .console.pulse { animation: con-pulse 900ms var(--ease); }
  @keyframes con-pulse {
    0%, 100% { box-shadow:
      inset 0 1px 0 var(--rim-a), inset 0 0 0 1px rgb(255 255 255 / 0.035),
      0 0 0 1px rgb(0 0 0 / 0.6), 0 2px 6px rgb(0 0 0 / 0.4),
      0 34px 90px -26px rgb(0 0 0 / 0.85); }
    30% { box-shadow:
      inset 0 1px 0 var(--accent), inset 0 0 0 1px var(--glow),
      0 0 0 1px var(--glow), 0 2px 6px rgb(0 0 0 / 0.4),
      0 20px 70px -14px var(--glow); }
