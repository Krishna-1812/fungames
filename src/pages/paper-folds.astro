---
import GameLayout from '../layouts/GameLayout.astro'
import { MARKS } from '../lib/fold-marks'
import { SHEETS } from '../lib/fold-paper'
import { iconSvg } from '../lib/icons'

/**
 * Paper Folds — fold a real sheet until it stops you, then keep going anyway.
 *
 * The game is in two halves and they are different kinds of thing, which the
 * page now says out loud rather than blurring.
 *
 * The first half is real. You fold an actual sheet by dragging its edge over,
 * and it stops when a sheet of that size and thickness stops — seven times for
 * A4, twelve for the 1,219-metre roll Britney Gallivan used in 2002. The limit
 * is not a number typed in here; it comes out of her equations in
 * lib/fold-paper.ts, and scripts/check-fold.mjs holds those to what people
 * have actually managed.
 *
 * The second half is the old one, and it is imaginary: thickness 0.1 mm × 2^n
 * up to fold 103, where the stack is wider than the observable universe. It
 * used to be presented as something you were doing, with a button that folded
 * a hundred and three times and no hint that seven is where paper gives up.
 * That was the more misleading half of an otherwise honest game, so reaching
 * it now takes a button that says what you are doing.
 */
const START_MM = 0.1
const MAX_FOLDS = 103

---

<GameLayout slug="paper-folds" bar="#43310f" bodyClass="fold-body">
  <div class="wrap">
    <header class="head">
      <h1>Paper Folds</h1>
      <p class="lede">
        A sheet of paper is a tenth of a millimetre thick. Every fold doubles
        it — and every fold is harder than the last, for a reason that is not
        the one everybody says.
      </p>
    </header>

    <section class="bench" aria-labelledby="benchH">
      <h2 id="benchH" class="sr-only">Fold a sheet</h2>

      <div class="picker" id="picker" role="radiogroup" aria-label="Which sheet">
        {SHEETS.map((s, i) => (
          <button type="button" class="chip" data-sheet={s.id} role="radio"
                  aria-checked={i === 0 ? 'true' : 'false'}>{s.name}</button>
        ))}
      </div>

      <div class="ways" role="radiogroup" aria-label="Which way you fold">
        <button type="button" class="way" data-mode="alternate" role="radio" aria-checked="true">
          Turning it each time
        </button>
        <button type="button" class="way" data-mode="single" role="radio" aria-checked="false">
          Always the same way
        </button>
      </div>

      <svg class="bed" id="bed" viewBox="0 0 300 172"
           role="application" tabindex="0"
           aria-label="The sheet, seen edge-on. Drag it leftwards to fold it, or press the right arrow key."></svg>

      <p class="grip" id="grip">Drag the right-hand edge over to the left.</p>

      <div class="budget">
        <div class="budget-bar"><div class="budget-fill" id="budgetFill"></div></div>
        <p class="budget-text" id="budgetText"></p>
      </div>

      <p class="sheet-note" id="sheetNote"></p>
    </section>

    <section class="readout" id="readout">
      <div class="fold-count"><span id="folds">0</span> <small>folds</small></div>
      <div class="thick" id="thick" aria-live="polite">0.1 millimetres</div>
      <div class="layers"><span id="layers">1</span> layers of paper</div>
    </section>

    <svg class="scale" id="scale" viewBox="0 0 300 190" aria-hidden="true"></svg>

    <p class="mark" id="mark"><span class="mark-glyph" id="markGlyph" set:html={iconSvg(MARKS[0].icon)} /><span id="markText">A single sheet of paper.</span></p>

    <div class="actions">
      <button type="button" id="unfoldBtn" class="ghost">Unfold</button>
      <button type="button" id="foldBtn" class="primary">Fold in half</button>
    </div>
    <p class="hint" id="hint">In reality nobody has folded a sheet more than twelve times.</p>
  </div>
</GameLayout>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({
      START_MM,
      MAX_FOLDS,
      MARKS,
      ICONS: Object.fromEntries(MARKS.map((m) => [m.icon, iconSvg(m.icon)])),
    })} />

  <script>
  import { burst, floatIcon, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock, tone } from '../lib/audio'
  import {
    SHEETS, sheetById, maxFolds, need, have, reach, profile,
    thicknessAt, bendRadius, mm,
  } from '../lib/fold-paper'
    const { START_MM, MAX_FOLDS, MARKS, ICONS } = JSON.parse(
      document.getElementById('game-data')!.textContent!,
    ) as any

  const el = (id) => document.getElementById(id)
  let n = 0
  let lastMark = null

  /* The real half. `sheet` and `mode` decide where paper gives up; `imaginary`
     records that you have gone past that on purpose, which changes what every
     readout on the page is claiming. */
  let sheet = SHEETS[0]
  let mode = 'alternate'
  let imaginary = false
  const limit = () => maxFolds(sheet, mode)

  /** Pick a sensible unit across 30 orders of magnitude. */
  function fmt(mm) {
    const m = mm / 1000
    const units = [
      [0, 'millimetres', 1e-3],
      [0.01, 'centimetres', 1e-2],
      [1, 'metres', 1],
      [1000, 'kilometres', 1e3],
      [1.496e11, 'astronomical units', 1.496e11],
      [9.461e15, 'light years', 9.461e15],
      [9.461e21, 'million light years', 9.461e21],
      [9.461e24, 'billion light years', 9.461e24],
    ]
    let pick = units[0]
    for (const u of units) if (m >= u[0]) pick = u
    const v = m / pick[2]
    if (v >= 1e6) return `${v.toExponential(2).replace('e+', ' × 10^')} ${pick[1]}`
    const shown = v >= 100 ? v.toFixed(0) : v >= 10 ? v.toFixed(1) : v.toFixed(2)
    return `${Number(shown).toLocaleString('en-US')} ${pick[1]}`
  }

  function bigInt(exp) {
    // 2^n exactly, via BigInt, so the layer count stays truthful past 2^53.
    return (1n << BigInt(exp)).toLocaleString('en-US')
  }

  function currentMark() {
    let m = MARKS[0]
    for (const mk of MARKS) if (n >= mk.at) m = mk
    return m
  }

  /* ----------------------------------------------------------------------
     The scale.

     What used to be here was a stack of bars that doubled until it hit
     sixty-four and then stopped changing -- which is fold six. The other
     ninety-seven folds, the ones that go past the Moon and out of the galaxy,
     had no picture at all, which is a strange thing for a game about a number
     you cannot picture.

     A logarithmic axis fixes it, and it fixes it in the way the subject wants:
     because every fold doubles, every fold is the SAME distance up this ruler.
     Constant effort, constant ratio, and the labels beside it going from a
     credit card to the observable universe. That is the whole argument of the
     game, drawn.
     ---------------------------------------------------------------------- */

  /* ----------------------------------------------------------------------
     The bench: one sheet, edge-on, drawn true to itself.

     Both dimensions are to the same scale, which is the whole argument. A
     sheet of A4 starts 297 mm long and 0.1 mm thick — a hairline — and after
     seven folds it is 2.3 mm long and 12.8 mm thick, five times taller than
     it is wide. Nothing about that is stylised: the block genuinely turns on
     its side as you fold it, and the half-circle at the end, which is the
     paper going round the bend, ends up bigger than the flat part. That is
     where the length goes, and it is why the eighth fold is not close.
     ---------------------------------------------------------------------- */

  const BED = el('bed')
  const BX = 22, BY = 12, BW = 256, BH = 112

  /** The fold being made, 0 to 1, purely for the drawing. */
  let dragU = 0
  let dragging = false
  let springing = 0

  function bedGeometry() {
    const flat = have(sheet, mode) / 2 ** n
    const thick = thicknessAt(sheet.thickness, n)
    // One scale for both axes, or the picture stops being an argument.
    // The ghost turn sticks out half a stack past the edge, and is labelled
    // above, so the space to fit is the sheet plus that circle.
    const s = Math.min(BW / (flat + thick), (BH - 14) / (thick * 1.2))
    return { flat, thick, s, w: flat * s, h: Math.max(1.5, thick * s) }
  }

  function drawBed() {
    const g = bedGeometry()
    const left = BX + (BW - g.w) / 2
    // Centred, so the stack grows both ways and the ghost turn has room to
    // be labelled above it. The ruler stays on the floor of the bed.
    const base = BY + BH
    const top = BY + (BH - g.h) / 2

    let out = ''
    out += '<rect class="bench-bed" x="' + BX + '" y="' + BY + '" width="' + BW +
           '" height="' + BH + '" rx="6"/>'

    /* Solid is the paper you have. Dashed is the turn the next fold needs.
       Keeping those two separate is the whole point of the picture.

       An earlier version drew the rounded ends at the radius the paper *would*
       have to bend through, which at the seventh fold of A4 came out as a
       clean circle 12.8 mm across — a coin, drawn out of a sheet 1.6 mm wide.
       It was a picture of the fold succeeding, which is the opposite of what
       is happening. So the block is now only ever as big as the sheet is, and
       the requirement is a ghost laid over it.

       The ghost is exact: turning a stack of thickness h through 180° and
       bringing it back parallel takes a semicircle of radius h/2. The stack
       doubles every fold while the sheet halves, so the circle grows at
       precisely the rate the paper shrinks, and somewhere around the seventh
       fold it stops fitting. That crossing is the answer to the question the
       game asks. */
    const midX = left + g.w / 2
    const cy = top + g.h / 2
    const round = Math.min(g.h / 2, g.w / 2)

    const prof = profile(n, g.h)
    out += '<g class="stack">'
    out += '<rect class="sheet-block" x="' + left.toFixed(2) + '" y="' + top.toFixed(2) +
           '" width="' + g.w.toFixed(2) + '" height="' + g.h.toFixed(2) +
           '" rx="' + round.toFixed(2) + '"/>'
    if (!prof.merged && prof.layers.length > 1 && g.w > 3)
      for (const l of prof.layers.slice(1))
        out += '<path class="crease" d="M' + left.toFixed(2) + ' ' +
               (top + l.y).toFixed(2) + ' h' + g.w.toFixed(2) + '"/>'
    out += '</g>'

    // The turn fold n+1 has to make, whether or not there is paper for it.
    if (!imaginary && n < MAX_FOLDS) {
      const rNeed = g.h / 2
      const gx = left + g.w
      out += '<circle class="ghost" cx="' + gx.toFixed(2) + '" cy="' + cy.toFixed(2) +
             '" r="' + rNeed.toFixed(2) + '"/>'
      if (rNeed > g.w * 0.9)
        out += '<text class="ghost-t" x="' + gx.toFixed(2) + '" y="' +
               (cy - rNeed - 5).toFixed(2) + '" text-anchor="middle">the bend it needs</text>'
    }

    /* The flap coming over, at the real bend radius for the fold being made.
       Half the stack it has to carry round — so it grows as fast as the stack
       does, while the flat length it has to come out of is halving. */
    if (dragU > 0.001) {
      const r = Math.max(0.6, bendRadius(sheet.thickness, n + 1) * g.s)
      const a = Math.PI * dragU
      const hinge = left + g.w
      const cy = top + g.h / 2
      const len = g.w
      const tipX = hinge - Math.cos(a) * len
      const tipY = cy - Math.sin(a) * (len * 0.55) - r * dragU
      out += '<path class="flap" d="M' + hinge.toFixed(2) + ' ' + cy.toFixed(2) +
             ' Q' + (hinge + r).toFixed(2) + ' ' + (cy - r * 1.6).toFixed(2) +
             ' ' + tipX.toFixed(2) + ' ' + tipY.toFixed(2) + '"/>'
      out += '<circle class="grabdot" cx="' + tipX.toFixed(2) + '" cy="' + tipY.toFixed(2) + '" r="5"/>'
    } else {
      out += '<circle class="grabdot" cx="' + (left + g.w).toFixed(2) + '" cy="' +
             (top + g.h / 2).toFixed(2) + '" r="5"/>'
    }

    // A ruler, so "it got shorter" is a measurement rather than an impression.
    out += '<path class="rule" d="M' + left.toFixed(2) + ' ' + (base + 9) + ' h' + g.w.toFixed(2) + '"/>'
    out += '<text class="rule-t" x="' + (left + g.w / 2).toFixed(2) + '" y="' + (base + 22) +
           '" text-anchor="middle">' + mm(g.flat) + ' across, ' + mm(g.thick) + ' thick</text>'
    BED.innerHTML = out
  }

  /* ---- folding it by hand --------------------------------------------- */

  function attempt(u) {
    // Never further than this sheet will actually go.
    dragU = Math.min(u, reach(sheet, n + 1, mode))
    drawBed()
  }

  function release() {
    const got = reach(sheet, n + 1, mode)
    if (got >= 1 && dragU > 0.55) {
      dragU = 0
      doFold()
    } else {
      if (got < 1 && dragU > 0.05) refuse()
      spring()
    }
  }

  function spring() {
    cancelAnimationFrame(springing)
    if (prefersReducedMotion) { dragU = 0; drawBed(); return }
    const from = dragU
    const t0 = performance.now()
    const step = (now) => {
      const k = Math.min(1, (now - t0) / 220)
      dragU = from * (1 - k * k)
      drawBed()
      if (k < 1) springing = requestAnimationFrame(step)
    }
    springing = requestAnimationFrame(step)
  }

  let refusedAt = 0
  function refuse() {
    unlock(); sfx.bad()
    refusedAt = performance.now()
    BED.classList.remove('refuse')
    void BED.offsetWidth
    BED.classList.add('refuse')
    render()
  }

  function doFold() {
    const wasMark = currentMark().at
    n++
    unlock()
    tone({ freq: 180 * Math.pow(1.055, n), to: 120 * Math.pow(1.055, n), dur: 0.14, type: 'triangle', gain: 0.2 })
    render(1)
    celebrate(wasMark)
  }

  function celebrate(wasMark) {
    const mk = currentMark()
    if (mk.at === wasMark) return
    sfx.great()
    const r = BED.getBoundingClientRect()
    burst(r.left + r.width / 2, r.top + r.height / 2, {
      count: 22, colors: ['#c9a13f', '#e8d59a', '#fff'], speed: 4.5, gravity: 0.14, life: 44, size: 4,
    })
    floatIcon(r.left + r.width / 2, r.top + r.height / 2 - 20, ICONS[mk.icon])
  }

  /* Pointer, with the drag measured against the sheet's own width so the
     gesture means the same thing on a phone as on a desktop. */
  let grabX = 0
  BED.addEventListener('pointerdown', (e) => {
    if (imaginary) return
    dragging = true
    grabX = e.clientX
    BED.setPointerCapture(e.pointerId)
    cancelAnimationFrame(springing)
  })
  BED.addEventListener('pointermove', (e) => {
    if (!dragging) return
    const span = Math.max(60, BED.getBoundingClientRect().width * 0.62)
    attempt(Math.max(0, (grabX - e.clientX) / span))
  })
  const endDrag = (e) => {
    if (!dragging) return
    dragging = false
    try { BED.releasePointerCapture(e.pointerId) } catch { /* already gone */ }
    release()
  }
  BED.addEventListener('pointerup', endDrag)
  BED.addEventListener('pointercancel', endDrag)

  /* The keyboard gets the same fold, not a different one: one press runs the
     whole gesture, so a person who cannot drag still meets the resistance. */
  function foldByKey() {
    if (imaginary) { n = Math.min(n + 1, MAX_FOLDS); render(1); return }
    const got = reach(sheet, n + 1, mode)
    if (got >= 1) { doFold(); return }
    attempt(got)
    refuse()
    spring()
  }

  BED.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
      e.preventDefault()
      foldByKey()
    }
    if (e.key === 'ArrowLeft') { e.preventDefault(); el('unfoldBtn').click() }
  })

  /* ---- the picker ------------------------------------------------------ */

  function reset() {
    n = 0
    dragU = 0
    imaginary = false
    lastMark = null
    render()
  }

  el('picker').addEventListener('click', (e) => {
    const b = e.target.closest('.chip')
    if (!b) return
    const s = sheetById(b.dataset.sheet)
    if (!s || s === sheet) return
    sheet = s
    unlock(); sfx.click()
    reset()
  })

  document.querySelector('.ways').addEventListener('click', (e) => {
    const b = e.target.closest('.way')
    if (!b || b.dataset.mode === mode) return
    mode = b.dataset.mode
    unlock(); sfx.click()
    reset()
  })

  const SCALE = el('scale')
  const TOP = 12, BOT = 178
  const COL_X = 26, COL_W = 46

  /** Folds map linearly onto the axis, because log2 of a doubling is 1. */
  const yOf = (folds) => BOT - (folds / MAX_FOLDS) * (BOT - TOP)

  /* Anchors, chosen for even spacing rather than for every milestone: the
     marks all get a tick, but a label every few pixels is a wall of text. */
  const ANCHORS = [
    [0, 'a sheet of paper'],
    [16, 'a house'],
    [30, 'space begins'],
    [42, 'the Moon'],
    [69, 'the nearest star'],
    [83, 'the Milky Way'],
    [103, 'the observable universe'],
  ]

  function buildScale() {
    // The gradient lives inside the SVG because buildScale replaces its whole
    // contents, so a defs block in the template would be wiped on first paint.
    let out = '<defs><linearGradient id="foldGrad" x1="0" y1="0" x2="1" y2="0">' +
      '<stop offset="0" stop-color="#f0e0ab"/>' +
      '<stop offset="0.5" stop-color="#d8b558"/>' +
      '<stop offset="1" stop-color="#b98f2f"/>' +
      '</linearGradient></defs>'
    // The empty channel the paper climbs.
    out += '<rect class="chan" x="' + COL_X + '" y="' + TOP + '" width="' + COL_W +
           '" height="' + (BOT - TOP) + '" rx="4"/>'
    // A tick for every comparison in the list, labelled or not.
    for (const mk of MARKS) {
      const y = yOf(mk.at)
      out += '<path class="tick" d="M' + (COL_X + COL_W + 3) + ' ' + y + ' h6"/>'
    }
    for (const [at, label] of ANCHORS) {
      const y = yOf(at)
      out += '<path class="tick big" d="M' + (COL_X + COL_W + 3) + ' ' + y + ' h11"/>'
      out += '<text class="axis" x="' + (COL_X + COL_W + 18) + '" y="' + (y + 3.4) + '">' + label + '</text>'
    }
    // The paper itself, and the marker riding its top edge.
    out += '<g id="paperCol"><rect class="paper" x="' + COL_X + '" width="' + COL_W + '" rx="3"/>' +
           '<g id="grain"></g></g>'
    out += '<g id="head"><path class="edge" d="M' + (COL_X - 6) + ' 0 h' + (COL_W + 12) + '"/></g>'
    SCALE.innerHTML = out
  }

  /* One striation per fold, so the column is literally made of the folds you
     have done.

     Note the spacing is CONSTANT, not a function of the count: the axis is
     linear in folds, so each fold always adds the same height and therefore
     the same one line. It works out at about 1.6px, which is a fine lamination
     rather than something you could count -- which is the right impression for
     a stack whose layer count has thirty-one digits. */
  function grainFor(folds, topY) {
    const step = (BOT - topY) / Math.max(1, folds)
    if (folds < 2 || step < 1.1) return ''
    let out = ''
    for (let k = 1; k < folds; k++) {
      const y = BOT - k * step
      out += '<path d="M' + (COL_X + 3) + ' ' + y + ' h' + (COL_W - 6) + '"/>'
    }
    return out
  }

  let anim = 0
  let shownFolds = 0
  function paintCol(folds) {
    const topY = yOf(folds)
    const rect = SCALE.querySelector('.paper')
    if (!rect) return
    rect.setAttribute('y', String(topY))
    rect.setAttribute('height', String(Math.max(0, BOT - topY)))
    SCALE.querySelector('#grain').innerHTML = grainFor(folds, topY)
    const head = SCALE.querySelector('#head')
    head.setAttribute('transform', 'translate(0,' + topY + ')')
    head.style.opacity = folds > 0 ? '1' : '0.35'
  }

  function drawScale(target) {
    cancelAnimationFrame(anim)
    if (prefersReducedMotion) { shownFolds = target; paintCol(target); return }
    const from = shownFolds
    const t0 = performance.now()
    const DUR = 260
    const step = (now) => {
      const u = Math.min(1, (now - t0) / DUR)
      const e = u * u * (3 - 2 * u)
      shownFolds = from + (target - from) * e
      paintCol(shownFolds)
      if (u < 1) anim = requestAnimationFrame(step)
      else { shownFolds = target; paintCol(target) }
    }
    anim = requestAnimationFrame(step)
  }

  /* Which way the sheet is short, and by how much: the bar is the sentence
     "you need this much paper and you have that much", drawn. */
  function paintBench() {
    for (const b of el('picker').querySelectorAll('.chip'))
      b.setAttribute('aria-checked', String(b.dataset.sheet === sheet.id))
    for (const b of document.querySelectorAll('.way'))
      b.setAttribute('aria-checked', String(b.dataset.mode === mode))

    const lim = limit()
    el('sheetNote').textContent =
      sheet.note + ' Folded this way it goes ' + lim + ' time' + (lim === 1 ? '' : 's') + '.'

    const room = have(sheet, mode)
    const wanted = need(sheet, n + 1, mode)
    const frac = Math.max(0, Math.min(1, room / wanted))
    const fill = el('budgetFill')
    fill.style.width = (frac * 100).toFixed(1) + '%'
    fill.classList.toggle('short', frac < 1)

    el('budgetText').textContent = imaginary
      ? 'No sheet is involved any more.'
      : n >= MAX_FOLDS
        ? ''
        : 'Fold ' + (n + 1) + ' needs ' + mm(wanted) + ' of paper. You have ' + mm(room) + '.'

    el('grip').textContent =
      imaginary ? 'The sheet stopped a while ago.'
      : n >= lim
        ? (performance.now() - refusedAt < 2200
            ? 'It moves, and then it will not close. That is the paper, not you.'
            : 'It will not take another. The bend at the end has eaten the length.')
      : 'Drag the right-hand edge over to the left.'
  }

  buildScale()

  function render(dir) {
    el('folds').textContent = String(n)
    el('thick').textContent = fmt(START_MM * Math.pow(2, n))
    el('layers').textContent = bigInt(n)

    const mk = currentMark()
    if (mk !== lastMark) {
      lastMark = mk
      el('markGlyph').innerHTML = ICONS[mk.icon]
      el('markText').textContent = mk.text
      const glyphEl = el('markGlyph')
      glyphEl.classList.remove('jump')
      void glyphEl.offsetWidth
      glyphEl.classList.add('jump')
    }

    drawScale(n)
    drawBed()
    paintBench()

    el('foldBtn').disabled = n >= MAX_FOLDS
    el('unfoldBtn').disabled = n === 0
    el('foldBtn').textContent = imaginary || n >= limit() ? 'Carry on anyway' : 'Fold in half'
    el('readout').classList.toggle('imaginary', imaginary)
    el('hint').textContent =
      n >= MAX_FOLDS ? 'There is nothing left to fold it through.'
      : imaginary ? 'From here on nothing is being folded. This is only what the doubling does.'
      : n >= limit() ? 'That is as far as this sheet goes. The button carries on without it.'
      : 'Everything above is a sheet you could actually hold.'

    if (dir) {
      el('thick').classList.remove('bump')
      void el('thick').offsetWidth
      el('thick').classList.add('bump')
    }
  }

  /* The button does the honest thing at both ends of the sheet's life: it
     folds while there is paper, and once there is not it stops pretending and
     says so. Everything past the limit is the second, imaginary half. */
  el('foldBtn').addEventListener('click', (e) => {
    if (n >= MAX_FOLDS) return
    if (!imaginary && n >= limit()) imaginary = true
    const wasMark = currentMark().at
    n++
    unlock()
    // Pitch climbs with the fold count, so the exponential is audible.
    tone({ freq: 180 * Math.pow(1.055, n), to: 120 * Math.pow(1.055, n), dur: 0.14, type: 'triangle', gain: 0.2 })
    render(1)
    const mk = currentMark()
    if (mk.at !== wasMark) {
      sfx.great()
      const r = (e.currentTarget as HTMLElement).getBoundingClientRect()
      burst(r.left + r.width / 2, r.top, {
        count: 22, colors: ['#c9a13f', '#e8d59a', '#fff'], speed: 4.5, gravity: 0.14, life: 44, size: 4,
      })
      floatIcon(r.left + r.width / 2, r.top - 20, ICONS[mk.icon])
    }
  })
  el('unfoldBtn').addEventListener('click', () => {
    if (n <= 0) return
    n--
    if (n <= limit()) imaginary = false
    unlock(); sfx.blip(Math.max(0, 6 - (n % 6)))
    render(-1)
  })
  addEventListener('keydown', (e) => {
    if (document.activeElement === BED) return   // the bed has its own keys
    if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); el('foldBtn').click() }
    if (e.key === 'ArrowLeft') { e.preventDefault(); el('unfoldBtn').click() }
  })

  render()
</script>

<style>
  :global(.fold-body) { background: #faf6ea; }

  .wrap { max-width: 620px; margin: 0 auto; padding: 30px 22px 80px; text-align: center; }
  .head h1 { font-size: clamp(34px, 6vw, 52px); }
  .lede { color: var(--ink-soft); margin: 10px auto 20px; max-width: 40ch; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }

  /* --- the bench: the half of the game with real paper in it ------------- */

  .bench {
    background: #fff; border: 1px solid #ece0c4; border-radius: var(--radius-lg);
    padding: 16px 16px 18px; box-shadow: var(--shadow-sm); margin-bottom: 16px;
  }

  .picker { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .chip {
    border: 1px solid #e2d5b4; background: #fdfaf2; color: #4a3d1c;
    border-radius: 999px; padding: 6px 13px; font-size: 13px; font-weight: 600;
    cursor: pointer; transition: background 140ms var(--ease), border-color 140ms var(--ease);
  }
  .chip:hover { background: #f6eeda; }
  .chip[aria-checked='true'] { background: #43310f; border-color: #43310f; color: #fdfaf2; }

  .ways { display: flex; gap: 6px; justify-content: center; margin-top: 8px; }
  .way {
    border: 0; background: none; color: #7d6a3a; font-size: 12.5px; cursor: pointer;
    padding: 4px 8px; border-radius: 6px; border-bottom: 2px solid transparent;
  }
  .way:hover { color: #43310f; }
  .way[aria-checked='true'] { color: #43310f; font-weight: 700; border-bottom-color: #c9a13f; }

  .bed {
    display: block; width: 100%; height: auto; margin: 10px auto 0;
    touch-action: none; cursor: ew-resize; border-radius: 8px;
  }
  .bed:focus-visible { outline: 3px solid #c9a13f; outline-offset: 2px; }
  /* A shake for the fold the sheet will not take. It is the one piece of
     feedback that has to arrive without being read. */
  .bed.refuse { animation: bed-refuse 340ms var(--ease); }
  @keyframes bed-refuse {
    20% { transform: translateX(5px); } 50% { transform: translateX(-4px); }
    80% { transform: translateX(2px); }
  }
  /* Built at runtime, so every rule has to be :global or it matches nothing
     and the whole drawing falls back to fill:black. */
  .bed :global(.bench-bed) { fill: #f7f1e0; stroke: #e8ddc0; }
  .bed :global(.sheet-block) { fill: #ddb95f; stroke: #8a6f2e; stroke-width: 0.8; }
  .bed :global(.ghost) {
    fill: none; stroke: #b4653f; stroke-width: 1.1; stroke-dasharray: 4 3.5; opacity: 0.85;
  }
  .bed :global(.ghost-t) { fill: #b4653f; font-size: 8px; letter-spacing: 0.02em; }
  .bed :global(.crease) { stroke: rgba(96, 70, 18, 0.35); stroke-width: 0.4; }
  .bed :global(.flap) {
    fill: none; stroke: #c69f3c; stroke-width: 3; stroke-linecap: round;
  }
  .bed :global(.grabdot) { fill: #43310f; stroke: #fff; stroke-width: 1.6; }
  .bed :global(.rule) { stroke: #b6a276; stroke-width: 1; }
  .bed :global(.rule-t) { fill: #7d6a3a; font-size: 9px; }

  .grip { font-size: 13px; color: #6f5c28; margin: 8px 0 0; min-height: 34px; text-wrap: pretty; }

  .budget { margin-top: 4px; }
  .budget-bar {
    height: 7px; background: #f1e8d0; border-radius: 999px; overflow: hidden;
    border: 1px solid #e3d5ae;
  }
  .budget-fill {
    height: 100%; background: #6f9c5a; border-radius: 999px;
    transition: width 220ms var(--ease), background 220ms var(--ease);
  }
  .budget-fill.short { background: #c0603c; }
  .budget-text {
    font-size: 12.5px; color: #7d6a3a; margin: 6px 0 0;
    font-variant-numeric: tabular-nums; min-height: 18px;
  }
  .sheet-note { font-size: 12.5px; color: var(--ink-faint); margin: 8px 0 0; text-wrap: pretty; }

  .readout {
    background: #fff; border: 1px solid #ece0c4; border-radius: var(--radius-lg);
    padding: 18px 20px; box-shadow: var(--shadow-sm);
    transition: opacity 200ms var(--ease);
  }
  /* Past the sheet's limit nothing is being folded, and the readout should not
     go on looking like a measurement of something. */
  .readout.imaginary { background: #fbf7ec; border-style: dashed; }
  .fold-count {
    font-family: var(--display); font-size: 15px; color: #8a6f2e;
    letter-spacing: 0.02em; font-weight: 600;
  }
  .fold-count span { font-size: 22px; }
  .thick {
    font-family: var(--display);
    font-size: clamp(28px, 6.4vw, 48px); font-weight: 800;
    letter-spacing: -0.03em; margin: 4px 0 2px;
    font-variant-numeric: tabular-nums;
    color: #43310f;
    text-wrap: balance;
  }
  .thick.bump { animation: bump 280ms var(--ease); }
  @keyframes bump { 0% { transform: scale(0.94); opacity: 0.5; } }
  .layers { font-size: 13px; color: var(--ink-soft); font-variant-numeric: tabular-nums; word-break: break-all; }

  .scale {
    display: block; width: min(310px, 100%); height: auto;
    margin: 12px auto 6px;
  }
  /* Everything inside is built at runtime, and runtime nodes do not carry
     Astro's scoped-style attribute -- without :global these match nothing and
     the SVG falls back to fill:black. */
  .scale :global(.chan) { fill: #f1e8d0; stroke: #e3d5ae; stroke-width: 1; }
  /* Darker than they look like they need to be: the milestone ticks carry
     position information the labels do not repeat, so they are held to the 3:1
     non-text threshold. At #cbbb90 they measured 1.76:1 on this page. */
  .scale :global(.tick) { stroke: #93804a; stroke-width: 1.5; stroke-linecap: round; }
  .scale :global(.tick.big) { stroke: #6f5c28; stroke-width: 2; }
  .scale :global(.axis) { fill: #6a5828; font-size: 9px; letter-spacing: 0.01em; }
  .scale :global(.paper) { fill: url(#foldGrad); }
  .scale :global(#grain path) { stroke: rgba(96, 70, 18, 0.30); stroke-width: 0.6; }
  .scale :global(.edge) { stroke: #43310f; stroke-width: 2.5; stroke-linecap: round; }

  .mark {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    font-size: 17px; color: #4a3d1c; min-height: 44px; margin: 0 auto 16px;
    max-width: 34ch; text-wrap: pretty;
  }
  /* The drawing sizes itself from inside — see iconSvg. A rule here that
     targeted the <svg> would not apply to it, because it arrives via set:html. */
  .mark-glyph { width: 26px; height: 26px; display: inline-block; vertical-align: -6px; margin-right: 8px; }

  .actions { display: flex; gap: 10px; justify-content: center; }
  .actions button {
    border-radius: 999px; padding: 13px 26px; font-weight: 600; font-size: 16px;
    cursor: pointer; border: 0;
    transition: transform 180ms var(--ease-bounce), filter 140ms var(--ease);
  }
  .actions button:hover:not(:disabled) { transform: translateY(-2px) scale(1.03); filter: brightness(1.06); }
  .actions button:active:not(:disabled) { transform: scale(0.95); }
  .actions button:disabled { cursor: default; }
  /* A little jump whenever the milestone text actually changes underneath it —
     see Spend It's identical .jump for why this needs a toggled class. */
  .mark-glyph.jump { animation: jump-glyph 380ms var(--ease-bounce); }
  @keyframes jump-glyph { 40% { transform: translateY(-5px) scale(1.2) rotate(-8deg); } }
  .primary:disabled { background: #8b7b52; color: #fdfaf2; }
  .ghost:disabled { color: #6f6b78; border-color: #e6ddc2 !important; }
  .primary { background: #43310f; color: #fff; }
  .ghost { background: #fff; border: 1px solid #ddcfa8 !important; color: var(--ink); }

  .hint { color: var(--ink-faint); font-size: 13.5px; margin-top: 18px; }
</style>
