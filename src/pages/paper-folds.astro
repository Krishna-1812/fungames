---
import GameLayout from '../layouts/GameLayout.astro'
import { MARKS } from '../lib/fold-marks'
import { SHEETS } from '../lib/fold-paper'
import { iconSvg } from '../lib/icons'

/**
 * Paper Folds — fold a real sheet until it stops you, then keep going anyway.
 *
 * The game is in two halves and they are different kinds of thing, which the
 * page says out loud rather than blurring.
 *
 * The first half is real. You fold an actual sheet by dragging its edge over,
 * and it stops when a sheet of that size and thickness stops — seven times for
 * A4, twelve for the 1,219-metre roll Britney Gallivan used in 2002. The limit
 * is not a number typed in here; it comes out of her equations in
 * lib/fold-paper.ts, and scripts/check-fold.mjs holds those to what people
 * have actually managed.
 *
 * The second half is imaginary: 0.1 mm × 2^n up to fold 103, where the stack
 * is wider than the observable universe. Reaching it takes a button that says
 * what you are doing.
 *
 * What is new is that the page stopped *describing* the second half and
 * started going there. The backdrop is the altitude: fold zero is a warm desk,
 * by thirty you are past the Kármán line, and the last fold has nothing behind
 * it but other galaxies. lib/fold-sky.ts holds that journey and
 * check-fold-scene.mjs holds it to being readable at every one of the hundred
 * and four stops — a page whose background travels that far has exactly one
 * catastrophic failure mode, and it is that somewhere in the middle the ink
 * and the paper it sits on pass through the same grey.
 *
 * The sheet itself is drawn as an object on that desk rather than as a line in
 * a box, by lib/fold-scene.ts. The old edge-on diagram was and is the honest
 * picture — both axes to one scale, so the bend at the crease can be seen
 * outgrowing the paper — so it stays, as an inset, labelled.
 */
const START_MM = 0.1
const MAX_FOLDS = 103
---

<GameLayout slug="paper-folds" bar="#241b12" bodyClass="fold-body">
  <canvas class="sky" id="sky" aria-hidden="true"></canvas>

  <div class="wrap">
    <header class="head card">
      <p class="where" id="where">on the desk</p>
      <h1>Paper Folds</h1>
      <p class="lede">
        A sheet of paper is a tenth of a millimetre thick. Every fold doubles
        it — and every fold is harder than the last, for a reason that is not
        the one everybody says.
      </p>
    </header>

    <div class="picker" id="picker" role="radiogroup" aria-label="Which sheet">
      {SHEETS.map((s, i) => (
        <button type="button" class="chip" data-sheet={s.id} role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}>{s.name}</button>
      ))}
    </div>

    <div class="deck">
      <section class="card stage-card">
        <div class="card-top">
          <p class="sheet-note" id="sheetNote"></p>
          <div class="ways" role="radiogroup" aria-label="Which way you fold">
            <button type="button" class="way" data-mode="alternate" role="radio" aria-checked="true">
              Turning it
            </button>
            <button type="button" class="way" data-mode="single" role="radio" aria-checked="false">
              Same way
            </button>
          </div>
        </div>

        <div class="stage-hold">
          <canvas id="stage" role="application" tabindex="0"
            aria-label="The sheet on a desk. Drag its right edge to the left to fold it, or press the right arrow key."
          ></canvas>
          <svg class="inset" id="inset" viewBox="0 0 132 86" aria-hidden="true"></svg>
          <p class="inset-cap" aria-hidden="true">true scale, edge on</p>
        </div>

        <p class="grip" id="grip">Drag the right-hand edge over to the left.</p>

        <div class="budget">
          <div class="budget-bar"><i id="budgetFill"></i></div>
          <p class="budget-text" id="budgetText"></p>
        </div>
      </section>

      <aside class="card ladder-card" aria-hidden="true">
        <canvas id="ladder"></canvas>
      </aside>
    </div>

    <section class="figures card" id="figures">
      <div class="fig fig-lead">
        <b id="thick">0.1 millimetres</b>
        <span>thick</span>
      </div>
      <div class="fig">
        <b id="folds">0</b>
        <span id="foldsLabel">folds</span>
      </div>
      <div class="fig">
        <b id="layers">1</b>
        <span id="layersLabel">layer of paper</span>
      </div>

      <p class="mark" id="mark">
        <span class="mark-glyph" id="markGlyph" set:html={iconSvg(MARKS[0].icon)} />
        <span id="markText">A single sheet of paper.</span>
      </p>
    </section>

    <div class="actions">
      <button type="button" id="unfoldBtn" class="ghost">Unfold</button>
      <button type="button" id="foldBtn" class="primary">Fold in half</button>
    </div>
    <p class="hint card" id="hint">Everything above is a sheet you could actually hold.</p>
  </div>
</GameLayout>

{/* Data for the module below: modules cannot take define:vars, and modules
    are what let every game share one synthesiser. */}
<script type="application/json" id="game-data" set:html={JSON.stringify({
  START_MM,
  MAX_FOLDS,
  MARKS,
  ICONS: Object.fromEntries(MARKS.map((m) => [m.icon, iconSvg(m.icon)])),
})} />

<script>
  import { burst, floatIcon, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock, tone } from '../lib/audio'
  import {
    SHEETS, sheetById, maxFolds, need, have, reach, footprint,
    thicknessAt, mm,
  } from '../lib/fold-paper'
  import { fold3d, fitCam, fitCorners } from '../lib/fold-scene'
  import { skyAt, starField, rgb, rgba } from '../lib/fold-sky'

  const { START_MM, MAX_FOLDS, MARKS, ICONS } = JSON.parse(
    document.getElementById('game-data')!.textContent!,
  ) as any

  const el = (id: string) => document.getElementById(id)!
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v))
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t
  const plural = (n: number, one: string, many = one + 's') => (n === 1 ? one : many)

  /* ---------------------------------------------------------------------- */
  /* State                                                                   */
  /* ---------------------------------------------------------------------- */

  let n = 0
  let sheet = SHEETS[0]
  let mode: 'alternate' | 'single' = 'alternate'
  let imaginary = false
  let lastMark: any = null
  let refusedAt = -1e9
  const limit = () => maxFolds(sheet, mode)

  /** The fold under the hand, 0 to 1. */
  let u = 0
  let dragging = false

  /** The turn the sheet is part way through, after an alternating fold. */
  let yaw = 0
  /** Smoothed fold position, so the sky and the ladder move with the hand. */
  let shown = 0

  /**
   * The sheet as it is drawn — derived from the fold count every time rather
   * than carried forward. Accumulating it worked and was wrong to do: two
   * places would then be keeping the same fact, and the moment they disagreed
   * the picture and the numbers under it would be describing different sheets.
   */
  function geoAt(folds: number) {
    const f = footprint(sheet, Math.min(folds, limit()), mode)
    return {
      halfW: f.w / 2,
      halfD: f.d / 2,
      // Past the sheet's limit the stack keeps doubling but the paper does not
      // keep shrinking, because there is no longer any paper.
      height: thicknessAt(sheet.thickness, Math.min(folds, limit())),
    }
  }
  let geo = { halfW: 0, halfD: 0, height: 0 }

  /* ---------------------------------------------------------------------- */
  /* Numbers a person reads                                                  */
  /* ---------------------------------------------------------------------- */

  /** A sensible unit across thirty orders of magnitude. */
  function fmt(v: number) {
    const m = v / 1000
    const units: [number, string, number][] = [
      [0, 'millimetres', 1e-3],
      [0.01, 'centimetres', 1e-2],
      [1, 'metres', 1],
      [1000, 'kilometres', 1e3],
      [1.496e11, 'astronomical units', 1.496e11],
      [9.461e15, 'light years', 9.461e15],
      [9.461e21, 'million light years', 9.461e21],
      [9.461e24, 'billion light years', 9.461e24],
    ]
    let pick = units[0]
    for (const un of units) if (m >= un[0]) pick = un
    const q = m / pick[2]
    if (q >= 1e6) return q.toExponential(2).replace('e+', ' × 10^') + ' ' + pick[1]
    const shownV = q >= 100 ? q.toFixed(0) : q >= 10 ? q.toFixed(1) : q.toFixed(2)
    return Number(shownV).toLocaleString('en-US') + ' ' + pick[1]
  }

  /** 2^n exactly, via BigInt, so the layer count stays truthful past 2^53. */
  const bigInt = (e: number) => (1n << BigInt(e)).toLocaleString('en-US')

  /** Metres of stack, which is what the sky is a function of. */
  const heightM = (folds: number) => (START_MM * Math.pow(2, folds)) / 1000

  function currentMark() {
    let m = MARKS[0]
    for (const mk of MARKS) if (n >= mk.at) m = mk
    return m
  }

  /* ---------------------------------------------------------------------- */
  /* Canvases                                                                */
  /* ---------------------------------------------------------------------- */

  type Surface = { c: HTMLCanvasElement; g: CanvasRenderingContext2D; w: number; h: number }
  const surf = (id: string): Surface => {
    const c = el(id) as HTMLCanvasElement
    return { c, g: c.getContext('2d')!, w: 0, h: 0 }
  }
  const SKY = surf('sky'), STAGE = surf('stage'), LADDER = surf('ladder')

  function size(s: Surface) {
    const dpr = Math.min(2, devicePixelRatio || 1)
    const r = s.c.getBoundingClientRect()
    const w = Math.max(1, Math.round(r.width)), h = Math.max(1, Math.round(r.height))
    if (s.w === w && s.h === h && s.c.width === w * dpr) return false
    s.w = w; s.h = h
    s.c.width = Math.round(w * dpr); s.c.height = Math.round(h * dpr)
    s.g.setTransform(dpr, 0, 0, dpr, 0, 0)
    return true
  }

  /* Paper is not a flat colour. One tile of fibre, drawn over the sheet in
     overlay, is the whole difference between card stock and construction
     paper — and it costs one 96-pixel canvas. */
  let fibre: CanvasPattern | null = null
  function makeFibre() {
    const c = document.createElement('canvas')
    c.width = c.height = 96
    const g = c.getContext('2d')!
    const im = g.createImageData(96, 96)
    for (let i = 0; i < 96 * 96; i++) {
      const v = 116 + ((Math.random() * 76) | 0)
      im.data[i * 4] = im.data[i * 4 + 1] = im.data[i * 4 + 2] = v
      im.data[i * 4 + 3] = 255
    }
    g.putImageData(im, 0, 0)
    fibre = STAGE.g.createPattern(c, 'repeat')
  }

  const STARS = starField(260, 7)
  const GALAXIES = starField(14, 91)

  /* ---------------------------------------------------------------------- */
  /* The sky                                                                 */
  /* ---------------------------------------------------------------------- */

  let sky = skyAt(heightM(0))

  function drawSky() {
    const { g, w, h } = SKY
    g.clearRect(0, 0, w, h)

    const grad = g.createLinearGradient(0, 0, 0, h)
    grad.addColorStop(0, rgb(sky.top))
    grad.addColorStop(1, rgb(sky.bottom))
    g.fillStyle = grad
    g.fillRect(0, 0, w, h)

    if (sky.galaxies > 0.01) {
      for (const s of GALAXIES) {
        const x = s.x * w, y = s.y * h * 0.9
        const r = 30 + s.r * 90
        const gg = g.createRadialGradient(x, y, 0, x, y, r)
        gg.addColorStop(0, 'rgb(150 160 210 / ' + (0.1 * sky.galaxies * s.a).toFixed(3) + ')')
        gg.addColorStop(1, 'rgb(120 130 190 / 0)')
        g.fillStyle = gg
        g.save(); g.translate(x, y); g.rotate(s.hue); g.scale(1, 0.42)
        g.beginPath(); g.arc(0, 0, r, 0, Math.PI * 2); g.fill(); g.restore()
      }
    }

    if (sky.stars > 0.01) {
      for (const s of STARS) {
        g.globalAlpha = s.a * sky.stars
        g.fillStyle = 'hsl(' + s.hue + ' 60% 88%)'
        g.beginPath()
        g.arc(s.x * w, s.y * h, s.r, 0, Math.PI * 2)
        g.fill()
      }
      g.globalAlpha = 1
    }

    // The limb of the Earth: one enormous circle, most of it off the bottom of
    // the screen, with the air above it as a bright rim.
    if (sky.curve > 0.01) {
      const R = w * 2.6
      const cy = h + R - h * 0.24 * sky.curve
      g.save()
      g.globalAlpha = sky.curve
      const rim = g.createRadialGradient(w / 2, cy, R * 0.985, w / 2, cy, R * 1.05)
      rim.addColorStop(0, 'rgb(120 178 236 / 0.85)')
      rim.addColorStop(0.5, 'rgb(90 150 220 / 0.3)')
      rim.addColorStop(1, 'rgb(70 130 210 / 0)')
      g.fillStyle = rim
      g.beginPath(); g.arc(w / 2, cy, R * 1.05, 0, Math.PI * 2); g.fill()
      const ball = g.createLinearGradient(0, cy - R, 0, h)
      ball.addColorStop(0, 'rgb(56 104 158)')
      ball.addColorStop(1, 'rgb(22 46 78)')
      g.fillStyle = ball
      g.beginPath(); g.arc(w / 2, cy, R, 0, Math.PI * 2); g.fill()
      g.restore()
    }

    if (sky.clouds > 0.01) {
      g.save()
      g.globalAlpha = sky.clouds * 0.6
      for (let i = 0; i < 7; i++) {
        const x = ((i * 137) % 100) / 100 * w
        const y = h * (0.52 + ((i * 53) % 40) / 100)
        const rx = w * (0.1 + ((i * 31) % 20) / 100)
        const gg = g.createRadialGradient(x, y, 0, x, y, rx)
        gg.addColorStop(0, 'rgb(255 255 255 / 0.5)')
        gg.addColorStop(1, 'rgb(255 255 255 / 0)')
        g.fillStyle = gg
        g.save(); g.translate(x, y); g.scale(1, 0.3)
        g.beginPath(); g.arc(0, 0, rx, 0, Math.PI * 2); g.fill(); g.restore()
      }
      g.restore()
    }

    // The room you started in: a warm floor and a pool of lamplight.
    if (sky.ground > 0.01) {
      g.save()
      g.globalAlpha = sky.ground
      const fl = g.createLinearGradient(0, h * 0.52, 0, h)
      fl.addColorStop(0, 'rgb(196 172 128 / 0)')
      fl.addColorStop(1, 'rgb(158 128 84 / 0.55)')
      g.fillStyle = fl
      g.fillRect(0, h * 0.52, w, h * 0.48)
      const pool = g.createRadialGradient(w * 0.42, h * 0.42, 0, w * 0.42, h * 0.42, w * 0.7)
      pool.addColorStop(0, 'rgb(255 244 214 / 0.4)')
      pool.addColorStop(1, 'rgb(255 240 200 / 0)')
      g.fillStyle = pool
      g.fillRect(0, 0, w, h)
      g.restore()
    }

    // The corners of anything are darker than the middle.
    const vig = g.createRadialGradient(w / 2, h * 0.44, 0, w / 2, h * 0.44, Math.max(w, h) * 0.78)
    vig.addColorStop(0.55, 'rgb(0 0 0 / 0)')
    vig.addColorStop(1, 'rgb(0 0 0 / 0.3)')
    g.fillStyle = vig
    g.fillRect(0, 0, w, h)
  }

  /* ---------------------------------------------------------------------- */
  /* The sheet                                                               */
  /* ---------------------------------------------------------------------- */

  const BASE_CAM = { yaw: 0, pitch: 0.44, dist: 3.1, f: 1, cx: 0, cy: 0 }
  /** The camera eases between fits, so a commit is a move rather than a cut. */
  let camNow: { f: number; cx: number; cy: number } | null = null

  /** Paper, by which face of it you are looking at. */
  const PAPER: Record<string, [number, number, number]> = {
    top: [251, 247, 238],
    under: [226, 217, 197],
    side: [232, 223, 202],
    end: [228, 218, 197],
    bend: [244, 237, 220],
    desk: [200, 176, 132],
  }

  function faceFill(kind: string, shade: number) {
    const b = PAPER[kind] ?? PAPER.top
    const k = 0.4 + 0.68 * shade
    return [
      clamp(Math.round(b[0] * k), 0, 255),
      clamp(Math.round(b[1] * k), 0, 255),
      clamp(Math.round(b[2] * k), 0, 255),
    ] as [number, number, number]
  }

  function drawStage() {
    const { g, w, h } = STAGE
    g.clearRect(0, 0, w, h)
    if (w < 8 || h < 8) return

    // Everything in scene units where the sheet's own millimetres are the unit,
    // normalised so the numbers stay near 1 and the perspective stays sane.
    const norm = Math.max(geo.halfW, geo.halfD, geo.height) || 1
    const a = geo.halfW / norm, d = geo.halfD / norm, hh = geo.height / norm

    const want = fitCam(fitCorners(a, d, hh), { ...BASE_CAM, yaw },
      Math.min(w, h * 1.45), { x: w / 2, y: h * 0.56 }, 0.8)
    if (!camNow) camNow = { f: want.f, cx: want.cx, cy: want.cy }
    const kk = prefersReducedMotion ? 1 : 0.18
    camNow.f = lerp(camNow.f, want.f, kk)
    camNow.cx = lerp(camNow.cx, want.cx, kk)
    camNow.cy = lerp(camNow.cy, want.cy, kk)
    const cam = { ...BASE_CAM, yaw, f: camNow.f, cx: camNow.cx, cy: camNow.cy }

    const scene = fold3d({
      halfW: a, halfD: d, height: hh, layers: 2 ** Math.min(n, 30),
      u, cam, grounded: sky.ground > 0.05,
    })
    const topY = Math.min(...scene.faces.flatMap((f) => f.pts.map((q) => q[1])))

    // The desk: a soft pool of light under the sheet rather than a rectangle,
    // so the sheet sits in a place instead of on a shape.
    if (sky.ground > 0.02) {
      g.save()
      g.globalAlpha = sky.ground
      const pool = g.createRadialGradient(w * 0.5, h * 0.66, 0, w * 0.5, h * 0.66, w * 0.62)
      pool.addColorStop(0, 'rgb(226 202 158 / 0.55)')
      pool.addColorStop(1, 'rgb(206 178 130 / 0)')
      g.fillStyle = pool
      g.fillRect(0, 0, w, h)
      g.restore()
    }

    if (imaginary) drawColumn(g, w, h, topY + 4)

    if (scene.shadow.length) {
      g.save()
      if ('filter' in g) g.filter = 'blur(' + (6 + hh * 40).toFixed(1) + 'px)'
      g.globalAlpha = 0.34 * (1 - 0.4 * u)
      g.fillStyle = '#3a2a12'
      poly(g, scene.shadow)
      g.fill()
      g.restore()
    }

    for (const f of scene.faces) {
      const c = faceFill(f.kind, f.shade)
      // A gradient across each face rather than a flat fill: a real sheet is
      // never one value from edge to edge, and at this size that reads as the
      // difference between paper and cardboard.
      let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity
      for (const [px, py] of f.pts) {
        x0 = Math.min(x0, px); x1 = Math.max(x1, px)
        y0 = Math.min(y0, py); y1 = Math.max(y1, py)
      }
      const gr = g.createLinearGradient(x0, y0, x1, y1)
      gr.addColorStop(0, 'rgb(' + c.map((v) => clamp(Math.round(v * 1.045), 0, 255)).join(' ') + ')')
      gr.addColorStop(1, 'rgb(' + c.map((v) => Math.round(v * 0.93)).join(' ') + ')')
      g.fillStyle = gr
      poly(g, f.pts)
      g.fill()
    }

    // Fibre, over the whole sheet at once, clipped to it.
    if (fibre && scene.faces.length) {
      g.save()
      g.beginPath()
      for (const f of scene.faces) poly(g, f.pts, false)
      g.clip()
      g.globalCompositeOperation = 'overlay'
      g.globalAlpha = 0.2
      g.fillStyle = fibre
      g.fillRect(0, 0, w, h)
      g.restore()
    }

    // A hairline where two faces meet. Without it a folded stack is a blob.
    g.save()
    g.strokeStyle = 'rgb(120 100 66 / 0.34)'
    g.lineWidth = 0.6
    for (const f of scene.faces) { poly(g, f.pts); g.stroke() }
    g.restore()

    if (scene.laminations.length) {
      g.save()
      g.strokeStyle = 'rgb(126 104 62 / 0.4)'
      g.lineWidth = 0.55
      g.beginPath()
      for (const l of scene.laminations) {
        g.moveTo(l[0][0], l[0][1])
        g.lineTo(l[1][0], l[1][1])
      }
      g.stroke()
      g.restore()
    }

    // The sheen: one soft highlight raked across the top, which is what tells
    // you the surface is smooth.
    const top = scene.faces.filter((f) => f.kind === 'top')
    if (top.length) {
      g.save()
      g.beginPath()
      for (const f of top) poly(g, f.pts, false)
      g.clip()
      const sx = w * 0.3, sy = h * 0.34
      const sh = g.createRadialGradient(sx, sy, 0, sx, sy, Math.max(w, h) * 0.5)
      sh.addColorStop(0, 'rgb(255 253 244 / 0.5)')
      sh.addColorStop(1, 'rgb(255 250 235 / 0)')
      g.fillStyle = sh
      g.fillRect(0, 0, w, h)
      g.restore()
    }

  }

  /**
   * Past the sheet's limit there is no sheet, and the stage should not go on
   * implying there is. What there is instead is the stack, still doubling,
   * drawn to the same scale as the paper it came from — which puts its top off
   * the frame immediately and keeps it there for ninety-six more folds. That
   * is the only honest way to draw a number that does that: not smaller, gone.
   */
  function drawColumn(g: CanvasRenderingContext2D, w: number, h: number, baseY: number) {
    const colW = Math.max(6, w * 0.055)
    const x = w / 2 - colW / 2
    g.save()
    const glow = g.createLinearGradient(x - colW, 0, x + colW * 2, 0)
    glow.addColorStop(0, rgba(sky.accent, 0))
    glow.addColorStop(0.5, rgba(sky.accent, 0.22))
    glow.addColorStop(1, rgba(sky.accent, 0))
    g.fillStyle = glow
    g.fillRect(x - colW, 0, colW * 3, baseY)
    const body = g.createLinearGradient(x, 0, x + colW, 0)
    body.addColorStop(0, rgba(sky.accent, 0.5))
    body.addColorStop(0.35, 'rgb(255 250 236 / 0.92)')
    body.addColorStop(1, rgba(sky.accent, 0.4))
    g.fillStyle = body
    g.fillRect(x, 0, colW, baseY)
    // It does not fade out at the top; it is cut off by the frame, which is
    // the whole point.
    const fade = g.createLinearGradient(0, baseY - 26, 0, baseY)
    fade.addColorStop(0, 'rgb(255 250 236 / 0)')
    fade.addColorStop(1, rgba(sky.accent, 0.34))
    g.fillStyle = fade
    g.fillRect(x, baseY - 26, colW, 26)
    g.restore()
  }

  function poly(g: CanvasRenderingContext2D, pts: any[], begin = true) {
    if (begin) g.beginPath()
    g.moveTo(pts[0][0], pts[0][1])
    for (let i = 1; i < pts.length; i++) g.lineTo(pts[i][0], pts[i][1])
    g.closePath()
  }

  /* ---------------------------------------------------------------------- */
  /* The inset: the argument, drawn true                                     */
  /* ---------------------------------------------------------------------- */

  /* Both axes to one scale. This is the picture that answers the question, and
     it is worth keeping precisely because the pretty one does not: the dashed
     circle is the turn the *next* fold has to make, and watching it swell past
     the paper is why there is no eighth fold. */
  function drawInset() {
    const W = 132, H = 86, PAD = 9
    const flat = geo.halfW * 2
    // geo is clamped at the sheet's limit, and so is this: past it the stack
    // is still doubling but the *paper* is not, and printing a twenty-five
    // digit thickness beside a drawing of a sheet claims otherwise.
    const thick = thicknessAt(sheet.thickness, Math.min(n, limit()))
    const rNeed = thick / 2
    const s = Math.min((W - PAD * 2) / (flat + rNeed * 2), (H - PAD * 2 - 12) / Math.max(thick, rNeed * 2))
    const bw = flat * s, bh = Math.max(1.1, thick * s)
    const left = PAD + (W - PAD * 2 - bw) / 2
    const cy = PAD + 6 + (H - PAD * 2 - 12) / 2

    let out = '<rect class="in-bed" x="1" y="1" width="' + (W - 2) + '" height="' + (H - 2) + '" rx="7"/>'
    out += '<rect class="in-block" x="' + left.toFixed(2) + '" y="' + (cy - bh / 2).toFixed(2) +
      '" width="' + bw.toFixed(2) + '" height="' + bh.toFixed(2) +
      '" rx="' + Math.min(bh / 2, bw / 2).toFixed(2) + '"/>'
    if (!imaginary && n < MAX_FOLDS) {
      const r = rNeed * s
      out += '<circle class="in-ghost" cx="' + (left + bw).toFixed(2) + '" cy="' + cy.toFixed(2) +
        '" r="' + r.toFixed(2) + '"/>'
    }
    out += '<path class="in-rule" d="M' + left.toFixed(2) + ' ' + (H - 15) + ' h' + bw.toFixed(2) + '"/>'
    out += '<text class="in-t" x="' + (W / 2) + '" y="' + (H - 5) + '" text-anchor="middle">' +
      (imaginary ? 'the sheet stopped at ' + limit() : mm(flat) + ' × ' + mm(thick)) + '</text>'
    el('inset').innerHTML = out
  }

  /* ---------------------------------------------------------------------- */
  /* The ladder: the whole climb, as one strip                               */
  /* ---------------------------------------------------------------------- */

  const ANCHORS: [number, string][] = [
    [0, 'paper'],
    [16, 'a house'],
    [30, 'space'],
    [42, 'the Moon'],
    [69, 'nearest star'],
    [83, 'the galaxy'],
    [103, 'everything'],
  ]

  let ladderStrip: HTMLCanvasElement | null = null

  /** The gradient is the journey, so it is drawn once and kept. */
  function buildLadder() {
    const h = Math.max(40, LADDER.h)
    const c = document.createElement('canvas')
    c.width = 1
    c.height = h
    const g = c.getContext('2d')!
    for (let y = 0; y < h; y++) {
      const folds = (1 - y / (h - 1)) * MAX_FOLDS
      g.fillStyle = rgb(skyAt(heightM(folds)).bottom)
      g.fillRect(0, y, 1, 1)
    }
    ladderStrip = c
  }

  function drawLadder() {
    const { g, w, h } = LADDER
    if (!ladderStrip || ladderStrip.height !== h) buildLadder()
    g.clearRect(0, 0, w, h)
    const BAR = 22
    const yOf = (f: number) => h - (f / MAX_FOLDS) * h

    g.save()
    g.beginPath()
    ;(g as any).roundRect ? (g as any).roundRect(0, 0, BAR, h, 5) : g.rect(0, 0, BAR, h)
    g.clip()
    g.drawImage(ladderStrip!, 0, 0, 1, ladderStrip!.height, 0, 0, BAR, h)
    g.restore()

    g.strokeStyle = rgba(sky.line, 0.9)
    g.lineWidth = 1
    for (const [at, label] of ANCHORS) {
      const y = Math.round(yOf(at)) + 0.5
      g.beginPath(); g.moveTo(BAR + 2, y); g.lineTo(BAR + 7, y); g.stroke()
      g.fillStyle = rgb(sky.inkSoft)
      g.font = '500 9px ui-sans-serif, system-ui, sans-serif'
      g.textBaseline = 'middle'
      g.fillText(label, BAR + 11, clamp(y, 6, h - 6))
    }

    // Where you are: a bright line across the strip and a dot on it.
    const y = clamp(yOf(shown), 1, h - 1)
    g.strokeStyle = rgb(sky.ink)
    g.lineWidth = 2
    g.beginPath(); g.moveTo(0, y); g.lineTo(BAR, y); g.stroke()
    g.fillStyle = rgb(sky.accent)
    g.beginPath(); g.arc(BAR + 0.5, y, 3.2, 0, Math.PI * 2); g.fill()
    g.strokeStyle = rgb(sky.surface)
    g.lineWidth = 1.2
    g.stroke()
  }

  /* ---------------------------------------------------------------------- */
  /* Folding                                                                 */
  /* ---------------------------------------------------------------------- */

  /** Land the fold: halve one way, and in alternate mode turn the sheet. */
  function commit() {
    const wasMark = currentMark().at
    n++
    u = 0
    geo = geoAt(n)
    // The quarter turn is what "alternate" means, and seeing it happen says so
    // better than the label on the button does.
    if (mode === 'alternate' && !prefersReducedMotion) yaw = -Math.PI / 2
    unlock()
    tone({ freq: 180 * Math.pow(1.055, n), to: 120 * Math.pow(1.055, n), dur: 0.16, type: 'triangle', gain: 0.2 })
    paint(1)
    const mk = currentMark()
    if (mk.at !== wasMark) {
      sfx.great()
      const r = STAGE.c.getBoundingClientRect()
      burst(r.left + r.width / 2, r.top + r.height * 0.5, {
        count: 24, colors: ['#e2c47a', '#f4e6bd', '#fff'],
        speed: 4.6, gravity: 0.14, life: 46, size: 4,
      })
      floatIcon(r.left + r.width / 2, r.top + r.height * 0.4, ICONS[mk.icon])
    }
  }

  /** One press runs the same gesture a drag does, so both meet the same paper. */
  let running = 0
  function runFold() {
    if (n >= MAX_FOLDS || running) return
    const got = imaginary ? 1 : reach(sheet, n + 1, mode)
    if (prefersReducedMotion) {
      if (got >= 1) commit()
      else { u = got; refuse(); u = 0; paint() }
      return
    }
    const t0 = performance.now()
    const DUR = got >= 1 ? 340 : 240
    running = requestAnimationFrame(function step(now) {
      const k = clamp((now - t0) / DUR, 0, 1)
      u = got * (k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2)
      paint()
      if (k < 1) { running = requestAnimationFrame(step); return }
      running = 0
      if (got >= 1) commit()
      else { refuse(); spring() }
    })
  }

  function refuse() {
    unlock(); sfx.bad()
    refusedAt = performance.now()
    STAGE.c.classList.remove('refuse')
    void STAGE.c.offsetWidth
    STAGE.c.classList.add('refuse')
    paint()
  }

  let springing = 0
  function spring() {
    cancelAnimationFrame(springing)
    if (prefersReducedMotion) { u = 0; paint(); return }
    const from = u, t0 = performance.now()
    springing = requestAnimationFrame(function step(now) {
      const k = clamp((now - t0) / 260, 0, 1)
      u = from * (1 - k * k)
      paint()
      if (k < 1) springing = requestAnimationFrame(step)
    })
  }

  /* Pointer, measured against the canvas's own width so the gesture means the
     same thing on a phone as on a desktop. */
  let grabX = 0
  STAGE.c.addEventListener('pointerdown', (e) => {
    if (imaginary || running) return
    dragging = true
    grabX = e.clientX
    STAGE.c.setPointerCapture(e.pointerId)
    cancelAnimationFrame(springing)
  })
  STAGE.c.addEventListener('pointermove', (e) => {
    if (!dragging) return
    const span = Math.max(70, STAGE.c.getBoundingClientRect().width * 0.6)
    u = clamp((grabX - e.clientX) / span, 0, reach(sheet, n + 1, mode))
    paint()
  })
  const endDrag = (e: PointerEvent) => {
    if (!dragging) return
    dragging = false
    try { STAGE.c.releasePointerCapture(e.pointerId) } catch { /* already gone */ }
    const got = reach(sheet, n + 1, mode)
    if (got >= 1 && u > 0.5) { u = 0; commit() }
    else { if (got < 1 && u > 0.05) refuse(); spring() }
  }
  STAGE.c.addEventListener('pointerup', endDrag)
  STAGE.c.addEventListener('pointercancel', endDrag)

  STAGE.c.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
      e.preventDefault()
      el('foldBtn').click()
    }
    if (e.key === 'ArrowLeft') { e.preventDefault(); el('unfoldBtn').click() }
  })

  /* ---------------------------------------------------------------------- */
  /* Wiring                                                                  */
  /* ---------------------------------------------------------------------- */

  function reset() {
    n = 0; u = 0; imaginary = false; lastMark = null
    yaw = 0
    geo = geoAt(0)
    camNow = null
    paint()
  }

  el('picker').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.chip') as HTMLElement | null
    if (!b) return
    const s = sheetById(b.dataset.sheet!)
    if (!s || s === sheet) return
    sheet = s
    unlock(); sfx.click()
    reset()
  })

  document.querySelector('.ways')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.way') as HTMLElement | null
    if (!b || b.dataset.mode === mode) return
    mode = b.dataset.mode as any
    unlock(); sfx.click()
    reset()
  })

  el('foldBtn').addEventListener('click', () => {
    if (n >= MAX_FOLDS) return
    if (!imaginary && n >= limit()) {
      // The button stops pretending, and says so, before it carries on.
      imaginary = true
      unlock(); sfx.click()
      paint()
      return
    }
    if (imaginary) {
      n = Math.min(n + 1, MAX_FOLDS)
      unlock()
      tone({ freq: 180 * Math.pow(1.055, n), to: 120 * Math.pow(1.055, n), dur: 0.16, type: 'triangle', gain: 0.2 })
      const wasMark = currentMark().at
      paint(1)
      const mk = currentMark()
      if (mk.at !== wasMark) {
        sfx.great()
        const r = el('figures').getBoundingClientRect()
        burst(r.left + r.width / 2, r.top, {
          count: 22, colors: ['#e2c47a', '#f4e6bd', '#fff'],
          speed: 4.5, gravity: 0.14, life: 44, size: 4,
        })
        floatIcon(r.left + r.width / 2, r.top - 20, ICONS[mk.icon])
      }
      return
    }
    runFold()
  })

  el('unfoldBtn').addEventListener('click', () => {
    if (n <= 0) return
    n--
    u = 0
    if (n <= limit()) imaginary = false
    geo = geoAt(n)
    unlock(); sfx.blip(Math.max(0, 6 - (n % 6)))
    paint(-1)
  })

  addEventListener('keydown', (e) => {
    if (document.activeElement === STAGE.c) return
    const t = e.target as HTMLElement
    if (t && /^(BUTTON|INPUT|A)$/.test(t.tagName)) return
    if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); el('foldBtn').click() }
    if (e.key === 'ArrowLeft') { e.preventDefault(); el('unfoldBtn').click() }
  })

  /* ---------------------------------------------------------------------- */
  /* Paint                                                                   */
  /* ---------------------------------------------------------------------- */

  function paintText(dir?: number) {
    const lim = limit()

    el('thick').textContent = fmt(START_MM * Math.pow(2, n))
    el('folds').textContent = String(n)
    el('foldsLabel').textContent = plural(n, 'fold')
    el('layers').textContent = bigInt(n)
    el('layersLabel').textContent = plural(2 ** Math.min(n, 40), 'layer') + ' of paper'
    el('where').textContent = sky.where

    for (const b of el('picker').querySelectorAll('.chip'))
      b.setAttribute('aria-checked', String((b as HTMLElement).dataset.sheet === sheet.id))
    for (const b of document.querySelectorAll('.way'))
      b.setAttribute('aria-checked', String((b as HTMLElement).dataset.mode === mode))

    el('sheetNote').textContent =
      sheet.note + ' Folded this way it goes ' + lim + ' time' + (lim === 1 ? '' : 's') + '.'

    const room = have(sheet, mode)
    const wanted = need(sheet, n + 1, mode)
    const frac = clamp(room / wanted, 0, 1)
    const fill = el('budgetFill') as HTMLElement
    fill.style.width = (frac * 100).toFixed(1) + '%'
    fill.classList.toggle('short', frac < 1)
    el('budgetText').textContent = imaginary
      ? 'No sheet is involved any more.'
      : n >= MAX_FOLDS ? ''
      : 'Fold ' + (n + 1) + ' needs ' + mm(wanted) + ' of paper. You have ' + mm(room) + '.'

    el('grip').textContent =
      imaginary ? 'The sheet stopped a while ago.'
      : n >= lim
        ? (performance.now() - refusedAt < 2400
            ? 'It moves, and then it will not close. That is the paper, not you.'
            : 'It will not take another. The bend at the end has eaten the length.')
      : 'Drag the right-hand edge over to the left.'

    const mk = currentMark()
    if (mk !== lastMark) {
      lastMark = mk
      el('markGlyph').innerHTML = ICONS[mk.icon]
      el('markText').textContent = mk.text
      const gl = el('markGlyph')
      gl.classList.remove('jump'); void gl.offsetWidth; gl.classList.add('jump')
    }

    const fb = el('foldBtn') as HTMLButtonElement
    fb.disabled = n >= MAX_FOLDS
    ;(el('unfoldBtn') as HTMLButtonElement).disabled = n === 0
    fb.textContent = n >= MAX_FOLDS ? 'Nothing left'
      : imaginary ? 'Double it again'
      : n >= lim ? 'Carry on without the paper'
      : 'Fold in half'
    el('figures').classList.toggle('imaginary', imaginary)
    document.body.classList.toggle('is-imaginary', imaginary)
    el('hint').textContent =
      n >= MAX_FOLDS ? 'There is nothing left to fold it through.'
      : imaginary ? 'From here on nothing is being folded. This is only what the doubling does.'
      : n >= lim ? 'That is as far as this sheet goes. The button carries on without it.'
      : 'Everything above is a sheet you could actually hold.'

    if (dir) {
      const t = el('thick')
      t.classList.remove('bump'); void t.offsetWidth; t.classList.add('bump')
    }
  }

  /** The palette every panel on the page is drawn from. */
  function paintPalette() {
    const s = document.body.style
    s.setProperty('--surface', rgb(sky.surface))
    s.setProperty('--ink', rgb(sky.ink))
    s.setProperty('--ink-soft', rgb(sky.inkSoft))
    s.setProperty('--line', rgb(sky.line))
    s.setProperty('--accent', rgb(sky.accent))
    s.setProperty('--glow', rgba(sky.accent, 0.28))
  }

  /* One loop. The sky, the ladder and the sheet all read the same eased fold
     position, so dragging the paper halfway moves the sky halfway — which is
     the only way the two halves of the page feel like one thing. */
  let loop = 0
  let dirty = true
  function frame() {
    loop = 0
    const target = n + (imaginary ? 0 : u)
    const moved = Math.abs(target - shown) > 0.0005
    shown = prefersReducedMotion ? target : lerp(shown, target, 0.16)
    if (moved || dirty) {
      sky = skyAt(heightM(shown))
      paintPalette()
      drawSky()
      drawLadder()
    }
    drawStage()
    if (yaw !== 0) {
      yaw = Math.abs(yaw) < 0.004 ? 0 : lerp(yaw, 0, 0.14)
      dirty = true
    }
    const camMoving = !!camNow && Math.abs(camNow.f - 0) >= 0 && dirty
    dirty = moved || yaw !== 0 || dragging || !!running
    if (dirty || camMoving) loop = requestAnimationFrame(frame)
  }

  function paint(dir?: number) {
    paintText(dir)
    drawInset()
    dirty = true
    if (!loop) loop = requestAnimationFrame(frame)
  }

  function relayout() {
    size(SKY); size(STAGE); size(LADDER)
    buildLadder()
    if (!fibre) makeFibre()
    camNow = null
    paint()
  }

  let rt = 0
  addEventListener('resize', () => {
    clearTimeout(rt)
    rt = window.setTimeout(relayout, 120)
  })

  geo = geoAt(0)
  relayout()
  // Fonts and late layout both move the canvases; one more pass costs nothing.
  addEventListener('load', relayout)
</script>

<style is:global>
  /* A class, not a bare `body`: global.css sets the site's paper background on
     the element selector, and two rules of equal specificity are settled by
     order, which is not something a page should rely on. */
  .fold-body {
    background: #0d1220;
    /* Set from lib/fold-sky.ts every frame. The values here are only what the
       page looks like for the instant before the first paint. */
    --surface: #fffdf6;
    --ink: #2a2010;
    --ink-soft: #685834;
    --line: #e8dbbd;
    --accent: #b28428;
    --glow: rgb(178 132 40 / 0.28);
  }

  .sky {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: 0; pointer-events: none;
  }
  .fold-body .chrome { position: relative; z-index: 3; }

  .wrap {
    position: relative; z-index: 1;
    max-width: 760px; margin: 0 auto; padding: 26px 20px 90px;
    text-align: center;
  }

  /* --- head -------------------------------------------------------------- */

  /* Nothing on this page sits directly on the sky.
     It is tempting — a big title floating over deep space looks wonderful, and
     it looks wonderful at exactly two of the hundred and four altitudes. In
     between, the backdrop passes through every luminance there is, and no
     single text colour survives that. So every word is on a surface, and
     check-fold-scene.mjs holds that surface to 4.5:1 at every fold. */
  .head { margin-bottom: 14px; padding: 20px 24px 22px; }
  .where {
    margin: 0 0 8px; font: 600 11px/1 var(--mono);
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent);
  }
  .head h1 {
    font-size: clamp(34px, 6.4vw, 52px); letter-spacing: -0.035em; margin: 0;
    color: var(--ink); line-height: 1;
  }
  .lede {
    color: var(--ink-soft); margin: 12px auto 0; max-width: 46ch;
    text-wrap: pretty;
  }

  /* --- panels ------------------------------------------------------------ */

  .card {
    background: var(--surface);
    border-radius: 18px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.16),
      0 14px 40px rgb(0 0 0 / 0.3),
      0 0 0 1px rgb(255 255 255 / 0.04);
    transition: background 400ms var(--ease);
  }

  .picker {
    display: flex; flex-wrap: wrap; gap: 6px; justify-content: center;
    margin: 0 0 14px;
  }
  /* Unselected is ink on the surface; selected is the surface on ink. One
     pair of colours, so one contrast ratio covers both states. */
  .chip {
    border: 0; border-radius: 999px; padding: 8px 15px; min-height: 34px;
    font-size: 13px; font-weight: 600; cursor: pointer;
    background: var(--surface); color: var(--ink-soft);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
    transition: transform 200ms var(--ease-bounce), color 160ms var(--ease),
                background 300ms var(--ease);
  }
  .chip:hover { transform: translateY(-1px); color: var(--ink); }
  .chip[aria-checked='true'] {
    background: var(--ink); color: var(--surface);
    box-shadow: 0 3px 14px rgb(0 0 0 / 0.32);
  }

  .deck {
    display: grid; grid-template-columns: minmax(0, 1fr) 118px;
    gap: 14px; align-items: stretch;
  }

  .stage-card { padding: 14px 14px 16px; text-align: left; overflow: hidden; }
  .card-top {
    display: flex; align-items: flex-start; gap: 12px;
    padding-bottom: 10px; border-bottom: 1px solid var(--line);
  }
  .sheet-note {
    flex: 1; margin: 0; font-size: 12.5px; line-height: 1.45;
    color: var(--ink-soft); text-wrap: pretty;
  }
  .ways {
    flex: none; display: flex; gap: 2px; padding: 3px; border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 7%, var(--surface));
  }
  .way {
    border: 0; background: none; cursor: pointer; color: var(--ink-soft);
    font: 600 11.5px/1 var(--font); padding: 7px 11px; min-height: 26px;
    border-radius: 999px; white-space: nowrap;
    transition: background 150ms var(--ease), color 150ms var(--ease);
  }
  .way:hover { color: var(--ink); }
  .way[aria-checked='true'] {
    background: var(--surface); color: var(--ink);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.16);
  }

  .stage-hold { position: relative; margin-top: 10px; }
  #stage {
    display: block; width: 100%; height: 268px;
    touch-action: none; cursor: ew-resize; border-radius: 12px;
  }
  #stage:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  /* The one piece of feedback that has to arrive without being read. */
  #stage.refuse { animation: refuse 360ms var(--ease); }
  @keyframes refuse {
    20% { transform: translateX(6px); } 50% { transform: translateX(-5px); }
    80% { transform: translateX(2px); }
  }

  .inset {
    position: absolute; right: 4px; bottom: 20px; width: 132px; height: 86px;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.14));
  }
  .inset-cap {
    position: absolute; right: 8px; bottom: 6px; margin: 0;
    font: 500 9px/1 var(--mono); letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--ink-soft); opacity: 0.75;
  }
  .inset .in-bed { fill: color-mix(in srgb, var(--ink) 6%, var(--surface)); stroke: var(--line); }
  .inset .in-block { fill: var(--accent); }
  .inset .in-ghost {
    fill: none; stroke: #c0603c; stroke-width: 1.1; stroke-dasharray: 3.5 3;
  }
  .inset .in-rule { stroke: var(--ink-soft); stroke-width: 0.8; opacity: 0.6; }
  .inset .in-t { fill: var(--ink-soft); font-size: 8px; }

  .grip {
    margin: 10px 0 0; font-size: 13px; color: var(--ink-soft);
    min-height: 34px; text-wrap: pretty;
  }
  .budget-bar {
    height: 6px; border-radius: 999px; overflow: hidden;
    background: color-mix(in srgb, var(--ink) 9%, var(--surface));
  }
  .budget-bar i {
    display: block; height: 100%; border-radius: 999px; background: #4f8c52;
    transition: width 260ms var(--ease), background 260ms var(--ease);
  }
  .budget-bar i.short { background: #b4562f; }
  .budget-text {
    margin: 6px 0 0; font-size: 12px; color: var(--ink-soft);
    font-variant-numeric: tabular-nums; min-height: 17px;
  }

  .ladder-card { padding: 10px 8px; }
  #ladder { display: block; width: 100%; height: 100%; min-height: 260px; }

  /* --- figures ----------------------------------------------------------- */

  .figures {
    display: grid; grid-template-columns: 1.6fr 0.7fr 1fr;
    column-gap: 10px; row-gap: 4px;
    align-items: end; text-align: left;
    margin-top: 14px; padding: 16px 18px 18px;
  }
  /* Past the sheet's limit nothing is being measured, and the panel should
     stop looking like a measurement. Marked with a ring rather than with
     transparency: a see-through card over a sky that travels from daylight to
     deep space has a different contrast at every fold. */
  .figures.imaginary {
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.16), 0 14px 40px rgb(0 0 0 / 0.3),
      inset 0 0 0 2px var(--line);
  }
  .figures.imaginary .mark { border-top-style: dashed; }
  .fig b {
    display: block; font-family: var(--display); font-weight: 800;
    letter-spacing: -0.03em; color: var(--ink);
    font-variant-numeric: tabular-nums; line-height: 1.02;
    font-size: 20px; word-break: break-word;
  }
  .fig span {
    display: block; margin-top: 3px;
    font: 600 10.5px/1.2 var(--mono); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-soft);
  }
  .fig-lead b { font-size: clamp(26px, 5.2vw, 40px); }
  .fig-lead b.bump { animation: bump 300ms var(--ease); }
  @keyframes bump { 0% { transform: scale(0.94); opacity: 0.55; } }

  .mark {
    grid-column: 1 / -1;
    display: flex; align-items: center; gap: 11px;
    font-size: 16px; color: var(--ink); min-height: 40px;
    margin: 4px 0 0; padding-top: 14px; border-top: 1px solid var(--line);
