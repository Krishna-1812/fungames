  .pm-hero-note { margin: 18px auto 0; max-width: 48ch; font-size: 13px; opacity: 0.62; line-height: 1.6; }
  .pm-hero-bar { height: 7px; border-radius: 4px; background: rgba(255, 255, 255, 0.06); overflow: hidden; position: relative; margin: 16px auto 0; max-width: 440px; }
  .pm-hero-fill {
