---
import GameShell from '../layouts/GameShell.astro'
import { withBase } from '../lib/base'
import {
  TIERS, dollarsPerHour, billCount, billStripLengthM, LITERAL_RENDER_MAX_BILLS,
  nearestComparison, describeComparison, formatMoney,
} from '../lib/printing-money'
import { billDataUri, BILL_W, BILL_H } from '../lib/bill-art'
import { digitCellHTML } from '../lib/seven-segment'

/**
 * Printing Money — nine real rates of earning, reduced to the one thing that
 * makes them comparable: how many one-dollar bills is that, laid end to end.
 *
 * `src/lib/printing-money.ts` is the whole model: every tier's hourly rate is
 * *derived* from an annual figure and a real hours-per-year (2,080 for a
 * person, 8,760 for a continuous institution), never typed in twice.
 * `scripts/check-printing-money.mjs` holds the arithmetic to account — it
 * cannot and does not grade whether the salaries themselves are exactly
 * right, only that the derivation, the bill counts and the comparison ladder
 * are internally consistent.
 *
 * The picture is the same idea Paper Folds' own scale ladder uses: draw the
 * real thing where it's small enough to draw (five tiers, seven to a
 * hundred and twenty-five bills, an actual tiled strip of them), and switch
 * to a named real-world comparison the moment literally laying out the bills
 * would mean a scrollbar several thousand kilometres long.
 *
 * Every number below the hero is precomputed at build time from the real
 * model — nothing here is typed in independently of `printing-money.ts`.
 * Only the live "since you opened this page" counters run client-side.
 *
 * In the shell it is a read with a clock running: Score is what the US
 * government has spent since you opened the page, Rates read counts the nine
 * rates you have scrolled past, Moves is how long you have been here, and
 * reaching the bottom is the ending — the report says what was spent while
 * you read, measured in working years of your own wage (or the minimum wage,
 * if you did not give one). Best is your longest read. The page is paper; the
 * debt clock and the bills keep their own dark ground, as the pictures.
 */

const BILL_PX_W = 132
const BILL_PX_H = Math.round((BILL_PX_W * BILL_H) / BILL_W)
const BILL_URI = billDataUri()

/** The hero odometer: a real debt-clock shape, $99,999,999,999 at the
 *  widest — grouped 2/3/3/3, the way an eleven-digit number actually reads
 *  with commas. That is about five and a half days of the spending tier's
 *  own rate; nobody leaves a tab open that long, but eleven digits means
 *  nobody has to find out what happens if they do. */
const HERO_GROUPS = [2, 3, 3, 3] as const

const rows = TIERS.map((t) => {
  const rate = dollarsPerHour(t)
  const bills = billCount(rate)
  const literal = bills <= LITERAL_RENDER_MAX_BILLS
  const lengthM = billStripLengthM(bills)
  const cmp = literal ? null : nearestComparison(lengthM)
  return { tier: t, rate, bills, literal, lengthM, cmp }
})

const spending = rows.find((r) => r.tier.id === 'spending')!
---

<GameShell
  slug="printing-money"
  labels={{ score: 'Spent', best: 'Longest read', level: 'Rates read', moves: 'On this page' }}
  initial={{ score: '$0', level: `0 / ${TIERS.length}`, moves: '0:00' }}
>
  <div class="pm">
  <header class="pm-head">
    <p class="label meta pm-eyebrow">Nine real rates, one dollar bill at a time</p>
    <p class="pm-lead">
      A wage, a salary, a government's own hourly rate of spending — nine
      real figures that live at wildly different scales, all reduced to the
      one thing that makes them comparable: how many one-dollar bills that
      buys, laid end to end. Keep this tab open and watch the top of the
      page move while the bottom barely does.
    </p>
  </header>

  <section class="pm-hero" aria-label="Live counter">
    <i class="bolt bolt-tl" aria-hidden="true"></i><i class="bolt bolt-tr" aria-hidden="true"></i>
    <i class="bolt bolt-bl" aria-hidden="true"></i><i class="bolt bolt-br" aria-hidden="true"></i>
    <p class="hero-label"><i class="live-dot" aria-hidden="true"></i>Live — US government spending, since you opened this page</p>
    <div class="hero-screen">
      <div class="hero-clock" aria-hidden="true">
        <span class="ccy">$</span>
        {
          HERO_GROUPS.map((width, i) => (
            <>
              {i > 0 && <span class="hero-comma">,</span>}
              <span class="odometer hero-odo" data-grp={i} set:html={Array.from({ length: width }, () => digitCellHTML()).join('')} />
            </>
          ))
        }
      </div>
      <p class="sr-only" id="heroAmount">$0.00</p>
      <div class="screen-glass" aria-hidden="true"></div>
    </div>
    <p class="pm-hero-note">
      About {formatMoney(spending.rate)} an hour, {formatMoney(spending.rate / 3600)} every second.
      {spending.tier.note}
    </p>
    <div class="pm-hero-bar">
      <div class="pm-hero-fill" id="heroFill"></div>
    </div>
    <p class="pm-hero-ref" id="heroRef"></p>
  </section>

  <div class="pm-body-content">
    {
      rows.slice(0, 6).map((r, i) => (
        <section class="pm-stage" data-tier={r.tier.id} data-rate={r.rate}>
          <p class="pm-kicker">Rate {i + 1} of 9</p>
          <h2>{r.tier.label}</h2>
          <p class="pm-rate">
            {formatMoney(r.rate)}<span>/hr</span>
          </p>
          <p class="pm-note">{r.tier.note}</p>
          <p class="pm-since">
            Since you've been on this page: <b data-since>$0.00</b>
          </p>
          {r.literal ? (
            <div class="pm-strip-wrap">
              <div
                class="pm-strip"
                style={`width:${r.bills * BILL_PX_W}px;height:${BILL_PX_H}px;background-image:url("${BILL_URI}");background-size:${BILL_PX_W}px ${BILL_PX_H}px`}
                title={`${r.bills.toLocaleString('en-US')} one-dollar bills`}
              />
              <p class="pm-strip-caption">
                {r.bills.toLocaleString('en-US')} bills, {r.lengthM.toFixed(1)}m of them end to end — scroll to see them all →
              </p>
            </div>
          ) : (
            <div class="pm-compare">
              <div class="pm-compare-track">
                <div
                  class="pm-compare-fill"
                  style={`width:${Math.min(1, r.cmp!.kind === 'fraction' ? r.cmp!.fraction : 1) * 100}%`}
                />
              </div>
              <p class="pm-compare-caption">
                {r.bills.toLocaleString('en-US')} bills — {(r.lengthM / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })} km of them, end to end.{' '}
                {describeComparison(r.cmp!)}
              </p>
            </div>
          )}
        </section>
      ))
    }

    <section class="pm-stage pm-wage" id="wageStage">
      <p class="pm-kicker">Where you fit</p>
      <h2>What's your hourly wage?</h2>
      <p class="pm-note">
        Salaried? Divide by 2,080 — the same standard work-year every human
        rate on this page uses. Typed in, not stored anywhere.
      </p>
      <div class="pm-wage-input">
        <span>$</span>
        <input type="text" inputmode="decimal" id="wageBox" placeholder="25.00" aria-label="Your hourly wage" />
        <span>/hr</span>
      </div>
      <p class="pm-wage-out" id="wageOut" hidden></p>
      <div class="pm-strip-wrap pm-wage-strip-wrap" id="wageStripWrap" hidden>
        <div class="pm-strip" id="wageStrip" />
        <p class="pm-strip-caption" id="wageStripCaption"></p>
      </div>
      <p class="pm-since" id="wageSinceWrap" hidden>
        Since you've been on this page, at that rate: <b id="wageSince">$0.00</b>
      </p>
    </section>

    {
      rows.slice(6).map((r, i) => (
        <section class="pm-stage pm-institution" data-tier={r.tier.id} data-rate={r.rate}>
          <p class="pm-kicker">Rate {i + 7} of 9 — an institution, not a person</p>
          <h2>{r.tier.label}</h2>
          <p class="pm-rate">
            {formatMoney(r.rate)}<span>/hr</span>
          </p>
          <p class="pm-note">{r.tier.note}</p>
          <p class="pm-since">
            Since you've been on this page: <b data-since>$0.00</b>
          </p>
          <div class="pm-compare">
            <div class="pm-compare-track">
              <div
                class="pm-compare-fill"
                style={`width:${Math.min(1, r.cmp!.kind === 'fraction' ? r.cmp!.fraction : 1) * 100}%`}
              />
            </div>
            <p class="pm-compare-caption">
              {r.bills.toLocaleString('en-US')} bills — {(r.lengthM / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })} km of them, end to end.{' '}
              {describeComparison(r.cmp!)}
            </p>
          </div>
        </section>
      ))
    }

    <footer class="pm-outro">
      <details class="how">
        <summary>Which of this is real</summary>
        <p>
          <b>The bill counts and the ladder are exact,</b> given the number
          above them: a real US $1 bill is 6.14 x 2.61 inches per the Bureau
          of Engraving and Printing's own spec, and the comparison distances
          — a marathon, Manhattan Island, the Earth's circumference, the
          distance to the Moon — are real, published figures.
          <code>scripts/check-printing-money.mjs</code> holds that arithmetic
          to account.
        </p>
        <p>
          <b>The nine salaries and budgets are honestly approximate</b> — see
          the note under each one. They move every year; the maths built on
          top of them does not care which year it is.
        </p>
        <p>
          <b>Every human rate uses the same 2,080-hour work-year</b> — 40
          hours a week, 52 weeks — even though a Fortune 500 CEO's real hours
          and a minimum-wage worker's real hours are not actually
          comparable. The institutional rates use a real continuous
          8,760-hour year instead, because a government does not clock off.
        </p>
        <p>
          Related: <a href={withBase('/scale/')}>Scale</a> is the other game
          here about what happens when a number gets too big to picture
          directly, and <a href={withBase('/spend-it/')}>Spend It</a> is the
          other one about money at a size nobody actually holds.
        </p>
      </details>
      {/* Reaching this is the ending. */}
      <div id="pmEnd" aria-hidden="true"></div>
    </footer>
  </div>
  </div>

  <Fragment slot="howto">
    <p>
      Nine real rates of earning, from the minimum wage to the US government's
      own spending, all reduced to one thing: how many one-dollar bills an hour
      of each buys, laid end to end.
    </p>
    <ul>
      <li>The clock at the top is live: it is what the government has spent since you opened the page.</li>
      <li>Scroll down through the rates. Where the bills are few enough, they are drawn; past that, they are measured against something real.</li>
      <li>Put your own hourly wage in to see where you fit. It is not stored anywhere.</li>
    </ul>
    <p>The bottom of the page is the end. Your best is your longest read.</p>
  </Fragment>
</GameShell>

{/* Data for the module below: modules cannot take define:vars, and modules
    are what let every game share one synthesiser. */}
<script type="application/json" id="pm-data" set:html={JSON.stringify({ BILL_PX_W, BILL_PX_H, billUri: BILL_URI })} />

<script>
  import {
    billCount, billStripLengthM, LITERAL_RENDER_MAX_BILLS, formatMoney, parseWage, withCustomWage,
  } from '../lib/printing-money'
  import { segmentsFor, fitWidth, SEGMENT_KEYS } from '../lib/seven-segment'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { recordPlay } from '../lib/stats'
  import { SITE } from '../site.config'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'

  const { BILL_PX_W, BILL_PX_H, billUri } = JSON.parse(document.getElementById('pm-data')!.textContent!) as {
    BILL_PX_W: number; BILL_PX_H: number; billUri: string
  }

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T

  const stages = [...document.querySelectorAll<HTMLElement>('.pm-stage[data-rate]')].map((el) => ({
    el, rate: Number(el.dataset.rate), since: el.querySelector('[data-since]') as HTMLElement,
  }))
  const spendingRate = Number((document.querySelector('[data-tier="spending"]') as HTMLElement).dataset.rate)

  let currentWageRate: number | null = null

  // ---- the hero odometer: a real seven-segment debt-clock ------------------
  // Same toggle-the-segments approach as Days Since Incident's own odometer:
  // a changed digit flickers the way a real display does rather than the
  // text silently becoming a different string.
  const prefersReducedMotion = !PLAY
  const heroGroups = [...document.querySelectorAll<HTMLElement>('[data-grp]')].sort(
    (a, b) => Number(a.dataset.grp) - Number(b.dataset.grp),
  )
  const heroDigitCount = heroGroups.reduce((n, g) => n + g.children.length, 0)

  function setSegDigit(cell: HTMLElement, ch: string) {
    if (cell.dataset.v === ch) return
    const changed = cell.dataset.v !== undefined
    cell.dataset.v = ch
    const lit = segmentsFor(ch)
    const segs = cell.children
    for (let i = 0; i < SEGMENT_KEYS.length; i++) segs[i]!.classList.toggle('on', lit[i])
    if (changed && !prefersReducedMotion) {
      cell.classList.remove('flicker')
      void cell.offsetWidth
      cell.classList.add('flicker')
    }
  }
  function setHeroOdometer(wholeDollars: number) {
    const raw = fitWidth(String(Math.floor(wholeDollars)), heroDigitCount)
    let i = 0
    for (const grp of heroGroups) {
      for (const cell of grp.children) {
        setSegDigit(cell as HTMLElement, raw[i])
        i++
      }
    }
  }

  const t0 = performance.now()
  function tick() {
    const elapsed = (performance.now() - t0) / 1000
    const spentSoFar = (spendingRate / 3600) * elapsed
    setHeroOdometer(spentSoFar)
    $('heroAmount').textContent = formatMoney(spentSoFar)
    for (const s of stages) s.since.textContent = formatMoney((s.rate / 3600) * elapsed)
    if (currentWageRate != null) $('wageSince').textContent = formatMoney((currentWageRate / 3600) * elapsed)
    requestAnimationFrame(tick)
  }
  requestAnimationFrame(tick)

  // The hero's own little bar: how far its live total has grown toward the
  // same "distance to the Moon" scale the spending stage below uses.
  const MOON_M = 384_400_000
  function paintHeroBar() {
    const elapsed = (performance.now() - t0) / 1000
    const dollars = (spendingRate / 3600) * elapsed
    const m = billStripLengthM(billCount(dollars))
    const frac = Math.min(1, m / MOON_M)
    $('heroFill').style.width = `${(frac * 100).toFixed(6)}%`
    $('heroRef').textContent = `${(m / 1000).toLocaleString('en-US', { maximumFractionDigits: 2 })} km of bills so far — the distance to the Moon is 384,400 km`
    requestAnimationFrame(paintHeroBar)
  }
  requestAnimationFrame(paintHeroBar)

  // ---- your own wage --------------------------------------------------------
  const wageBox = $<HTMLInputElement>('wageBox')
  const wageOut = $('wageOut')
  const stripWrap = $('wageStripWrap')
  const strip = $('wageStrip')
  const stripCaption = $('wageStripCaption')
  const sinceWrap = $('wageSinceWrap')

  /** A label mid-sentence: only its first letter drops, so "US" stays "US". */
  const inSentence = (label: string) => label.charAt(0).toLowerCase() + label.slice(1)

  function paintWage() {
    const hourly = parseWage(wageBox.value)
    currentWageRate = hourly
    if (hourly == null) {
      wageOut.hidden = true
      stripWrap.hidden = true
      sinceWrap.hidden = true
      return
    }
    const withYou = withCustomWage(hourly)
    const idx = withYou.findIndex((t) => t.id === 'you')
    const below = withYou[idx - 1]
    const above = withYou[idx + 1]
    const placement = below && above
      ? `That puts you between ${inSentence(below.label)} and ${inSentence(above.label)}.`
      : above
        ? `That's below every other rate on this page — even ${inSentence(above.label)}.`
        : below
          ? `That's above every other rate on this page — including ${inSentence(below.label)}.`
          : ''
    wageOut.hidden = false
    wageOut.textContent = `${formatMoney(hourly)}/hr. ${placement}`

    const bills = billCount(hourly)
    if (bills <= LITERAL_RENDER_MAX_BILLS) {
      stripWrap.hidden = false
      strip.style.width = `${bills * BILL_PX_W}px`
      strip.style.height = `${BILL_PX_H}px`
      strip.style.backgroundImage = `url("${billUri}")`
      strip.style.backgroundSize = `${BILL_PX_W}px ${BILL_PX_H}px`
      stripCaption.textContent = `${bills.toLocaleString('en-US')} bills, ${billStripLengthM(bills).toFixed(2)}m of them end to end.`
    } else {
      stripWrap.hidden = true
    }
    sinceWrap.hidden = false
  }
  wageBox.addEventListener('input', paintWage)

  // ---- reveal each stage as it actually arrives -----------------------------
  // Only a stage that is genuinely below the fold at load ever gets hidden —
  // see the CSS note on `.pm-pending`. A stage already on screen (the first
  // one or two, on a tall enough viewport) is never touched, so there is
  // nothing for a slow script to be "too late" to reveal.
  if (!prefersReducedMotion && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('pm-in'); e.target.classList.remove('pm-pending'); io.unobserve(e.target) }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    )
    for (const el of document.querySelectorAll<HTMLElement>('.pm-stage')) {
      if (el.getBoundingClientRect().top > innerHeight * 0.85) el.classList.add('pm-pending')
      io.observe(el)
    }
  }

  // ---- the shell ----------------------------------------------------------------

  // Restart is a reload, the default: the clock starting again from zero is
  // exactly what starting again means here.
  const shell = createShell({ slug: 'printing-money' })
  const minWageRate = Number((document.querySelector('[data-tier="min-wage"]') as HTMLElement).dataset.rate)
  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumSignificantDigits: 3 })
  const shortMoney = (n: number) => (n < 1000 ? '$' + Math.floor(n) : '$' + compact.format(n))
  const clock = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, '0')}`
  const elapsedS = () => (performance.now() - t0) / 1000

  // A rate counts as read once most of it has been on screen.
  const read = new Set<Element>()
  if ('IntersectionObserver' in window) {
    const seen = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { read.add(e.target); seen.unobserve(e.target) }
    }, { threshold: 0.5 })
    for (const st of stages) seen.observe(st.el)
  }

  // The strip rolls its digits, so it is told once a second rather than
  // every frame; the debt clock is the live one.
  function paintStrip() {
    shell.setScore(shortMoney((spendingRate / 3600) * elapsedS()))
    shell.setLevel(`${read.size} / ${stages.length}`)
    shell.setMoves(clock(elapsedS()))
  }
  paintStrip()
  setInterval(paintStrip, 1000)

  function shareCardNow() {
    const elapsed = elapsedS()
    const dollars = (spendingRate / 3600) * elapsed
    return {
      slug: 'printing-money',
      siteName: SITE.name,
      headline: `The government spent ${formatMoney(dollars)} while you read this`,
      sub: 'Nine real rates of earning, from minimum wage to a government.',
      stats: [
        { label: 'Time on page', value: `${elapsed.toFixed(0)}s` },
        { label: 'Govt. spending', value: formatMoney(dollars) },
        { label: 'Your rate', value: currentWageRate != null ? formatMoney(currentWageRate) + '/hr' : 'not entered' },
      ],
    }
  }

  /** The bottom of the page: what was spent while you read it. */
  let ended = false
  function finish() {
    if (ended) return
    ended = true
    const elapsed = elapsedS()
    const dollars = (spendingRate / 3600) * elapsed
    const wage = currentWageRate ?? minWageRate
    const years = dollars / (wage * 2080)
    const yearsText = years >= 10 ? Math.round(years).toLocaleString('en-US') : years.toFixed(1)
    paintStrip()
    shell.considerBest(Math.round(elapsed), clock(elapsed))
    shell.win({
      celebrate: false,
      kicker: `While you read · ${clock(elapsed)}`,
      title: `The US government spent ${formatMoney(dollars)}.`,
      score: shortMoney(dollars),
      from: '$0',
      lines: [
        currentWageRate != null
          ? `At your ${formatMoney(wage)} an hour, earning that would take ${yearsText} working years.`
          : `At the federal minimum wage, earning that would take ${yearsText} working years.`,
        'And it is still going.',
      ],
      againLabel: 'Start the clock again',
    })
    shell.resultExtra.innerHTML =
      '<div class="pm-report-acts"><button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share this</span></button></div>'
    $('shareBtn').addEventListener('click', async (e) => {
      const label = (e.currentTarget as HTMLElement).querySelector('span')!
      const c = shareCardNow()
      const outcome = await shareResult(c, { title: 'Printing Money', text: c.headline, url: location.href })
      label.textContent = outcomeLabel[outcome]
      setTimeout(() => (label.textContent = 'Share this'), 1600)
    })
  }
  if ('IntersectionObserver' in window) {
    const end = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { end.disconnect(); finish() }
    })
    end.observe($('pmEnd'))
  }

  recordPlay('printing-money')
</script>

<style is:global>
  /* The page is paper. The debt clock and the bills keep their own dark
     ground — they are the pictures — and the LED red is the clock's own. */
  .pm {
    --money-led: #ff5a3c;
    --money-green: var(--t-green);
  }
  .pm [hidden] { display: none !important; }

  .pm-head { max-width: 660px; margin: 2vh auto 0; text-align: center; }
  .pm-eyebrow { display: block; margin-bottom: 14px; color: var(--ink2); }
  .pm-lead { font-size: var(--fs-lead); line-height: 1.6; color: var(--ink2); max-width: 56ch; margin: 0 auto; }

  /* ---- the hero: a real debt-clock signboard, bolted to the page --------- */
  .pm-hero {
    position: relative; max-width: 640px; margin: 5vh auto 0; padding: 30px clamp(14px, 4vw, 30px) 26px;
    border-radius: var(--r-lg); text-align: center; color: #eef1f5;
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.05), transparent 40%),
      linear-gradient(175deg, #1a1d24, #0f1116 60%, #090a0d);
    border: 2px solid var(--ink);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06), inset 0 0 40px rgba(0, 0, 0, 0.5),
      0 40px 80px -30px rgba(0, 0, 0, 0.9), 0 2px 0 rgba(255, 255, 255, 0.03);
  }
  .hero-label {
    display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0 0 16px;
    font-size: 12.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #c4ccd8;
  }
  .live-dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--money-led);
    box-shadow: 0 0 8px var(--money-led);
  }
  html.play .live-dot { animation: pm-live 1.7s ease-in-out infinite; }
  @keyframes pm-live { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .hero-screen {
    position: relative; display: inline-block; border-radius: 10px;
    padding: 16px clamp(10px, 3vw, 22px); background: #050403;
    box-shadow: inset 0 4px 14px rgba(0, 0, 0, 0.85), inset 0 0 0 1px rgba(255, 90, 60, 0.12);
  }
  .hero-clock { position: relative; display: flex; justify-content: center; align-items: baseline; gap: 0.02em; flex-wrap: wrap; }
  .ccy {
    font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 700; margin-right: 0.08em;
