  .bolt-tl { top: 10px; left: 11px; } .bolt-tr { top: 10px; right: 11px; }
  .bolt-bl { bottom: 10px; left: 11px; } .bolt-br { bottom: 10px; right: 11px; }

  /* ---- the stages ---------------------------------------------------------- */
  .pm-body-content { max-width: 660px; margin: 0 auto; }
  .pm-stage {
