     this whole block is already `is:global`, so `:global(.digit)` is not
     "extra-safe", it's a pseudo-class the browser has never heard of, and
     an unknown pseudo-class invalidates the entire selector it's in. Every
     one of these rules silently matched nothing until this was plain
     `.digit` — the same failure shape as the Astro-scoped-CSS trap this
     file's siblings keep hitting, just from the opposite direction. */
  .odometer { display: inline-flex; line-height: 1; --seg-on: var(--money-led); --seg-off: rgba(255, 79, 110, 0.09); }
  .digit { position: relative; display: inline-block; width: 0.56em; height: 1em; margin: 0 0.045em; flex: none; }
  .digit.flicker { animation: pm-flicker 320ms steps(1, end); }
  @keyframes pm-flicker { 0%, 18%, 36% { filter: brightness(1.9); } 9%, 27%, 100% { filter: brightness(1); } }
  .seg { position: absolute; background: var(--seg-off); transition: background 140ms linear, box-shadow 140ms linear; }
  .seg.on { background: var(--seg-on); box-shadow: 0 0 0.08em var(--seg-on), 0 0 0.26em rgba(255, 79, 110, 0.6); }
  .seg-a, .seg-g, .seg-d {
    left: 0.065em; width: 0.43em; height: 0.085em;
    clip-path: polygon(14% 0, 86% 0, 100% 50%, 86% 100%, 14% 100%, 0 50%);
  }
  .seg-a { top: 0; } .seg-g { top: 0.4575em; } .seg-d { top: 0.915em; }
  .seg-f, .seg-b, .seg-e, .seg-c {
    width: 0.085em; height: 0.41em; clip-path: polygon(0 14%, 50% 0, 100% 14%, 100% 86%, 50% 100%, 0 86%);
  }
  .seg-f, .seg-e { left: 0; } .seg-b, .seg-c { right: 0; }
  .seg-f, .seg-b { top: 0.085em; } .seg-e, .seg-c { top: 0.505em; }

  .screen-glass {
