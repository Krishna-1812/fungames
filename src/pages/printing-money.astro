  }
  .pg-start { display: inline-block; margin: 0; }
  .pg-start::before { content: ''; }
  .pg-start { padding: 10px 0 0 4px; transform-origin: 0 0; }
  .pg-start i { left: -5px; top: -5px; }
  .pg-head b { display: inline-block; margin: -26px 0 0 12px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .pg-head.is-left b { position: absolute; right: 12px; margin: -26px 0 0; }
  .pg-start.is-left { transform-origin: 0 0; }
