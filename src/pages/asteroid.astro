---
import GameShell from '../layouts/GameShell.astro'
import { ROCK_MATERIAL, renderRock, starField, lt, dk } from '../lib/asteroid-art'
import type { Composition } from '../lib/impact'

/**
 * Asteroid Launcher — choose a rock, choose somewhere to put it.
 *
 * All of the substance lives in lib/impact.ts (the Collins, Melosh & Marcus
 * scaling relations, checked against four real impacts) and lib/casualties.ts.
 * This page is the instrument panel around them: pick the thing, pick the
 * target, and read what the model says happens.
 *
 * Both maps are real: Leaflet over free, keyless tiles (Esri World Imagery
 * for satellite, OpenStreetMap for streets — see the SAT_URL/STREET_URL
 * constants in the client script for why no API key is needed or wanted).
 * The blast rings are genuine geodesic `L.circle`s sized in metres from the
 * model's own output, not hand-projected ellipses, so a strike on Svalbard
 * and a strike on Ecuador are both simply correct rather than needing a
 * manual 1/cos(latitude) stretch factor to agree with each other. One
 * consequence worth knowing: picking the Meteor Crater or Chicxulub preset
 * flies the target-picker map to the real coordinates at a preset-specific
 * zoom, and the satellite layer actually shows Meteor Crater's bowl.
 *
 * The rock itself is real geometry, not a texture — see lib/asteroid-art.ts.
 * It is server-rendered once here (so there is a real rock on first paint,
 * before any JS runs) and then the client script owns the same markup,
 * turning it slowly and re-lighting it when the composition changes.
 *
 * In the shell the builder and the impact are two views of one stage: build
 * a rock and aim it, launch, and the stage becomes the real satellite map with
 * the tour over it. The tour's last step opens the report — the shell's
 * result card, as an ending rather than a win, because a death toll is not
 * something to throw confetti at. Score is the last impact's energy, Crater is
 * its crater (or its burst), Moves are launches, and Best is the biggest
 * impact you have made.
 */
const COMP_ORDER: { key: Composition; label: string }[] = [
  { key: 'ice', label: 'Comet ice' },
  { key: 'porous', label: 'Porous rock' },
  { key: 'rock', label: 'Dense rock' },
  { key: 'iron', label: 'Iron' },
  { key: 'gold', label: 'Solid gold' },
]
const ROCK_STARS = starField(51, 60)
const INITIAL_ROCK = renderRock({ id: 'rock', composition: 'rock', rotation: 0.6, stars: ROCK_STARS })
---

<GameShell
  slug="asteroid"
  labels={{ score: 'Energy', best: 'Biggest', level: 'Crater', moves: 'Launches' }}
  initial={{ score: '—', level: '—', moves: '0' }}
>
  <div class="impactFlash" id="impactFlash" aria-hidden="true"></div>

  <div class="as">
    <div class="as-build" id="build">
      <section class="as-panel" aria-labelledby="buildH">
        <h2 class="label meta" id="buildH">The rock</h2>

        {/* A scrap of space to put the thing in: the one dark picture on the
            builder, so "made of iron" means something before a number is read. */}
        <div class="rockStage" id="rockStage" aria-hidden="true">
          <svg id="rockSvg" viewBox="0 0 200 200" set:html={INITIAL_ROCK} />
        </div>

        <div class="as-presets" id="presets" role="group" aria-label="Real impacts">
          <button type="button" data-preset="chelyabinsk">Chelyabinsk</button>
          <button type="button" data-preset="tunguska">Tunguska</button>
          <button type="button" data-preset="barringer">Meteor Crater</button>
          <button type="button" data-preset="chicxulub">Dinosaur killer</button>
        </div>

        <label class="as-ctl">
          <span class="as-ctl-label">Diameter</span>
          <output id="diameterOut" class="num">50 m</output>
          <input id="diameter" type="range" min="0" max="1000" value="420" />
        </label>

        <fieldset class="as-comp">
          <legend class="as-ctl-label">Made of</legend>
          <div class="as-comp-row" id="comp">
            {COMP_ORDER.map(({ key, label }) => {
              const m = ROCK_MATERIAL[key]
              const style =
                `--sw-lt:${lt(m.base, 0.5)}; --sw:${m.base}; --sw-dk:${dk(m.base, 0.55)};`
              return (
                <button type="button" data-comp={key} aria-pressed={key === 'rock' ? 'true' : 'false'} style={style}>
                  <span class="as-swatch"></span>{label}
                </button>
              )
            })}
          </div>
        </fieldset>

        <label class="as-ctl">
          <span class="as-ctl-label">Speed</span>
          <output id="velocityOut" class="num">17 km/s</output>
          <input id="velocity" type="range" min="11" max="72" value="17" />
        </label>

        <label class="as-ctl">
          <span class="as-ctl-label">Angle</span>
          <output id="angleOut" class="num">45°</output>
          <input id="angle" type="range" min="5" max="90" value="45" />
        </label>

        <p class="as-mass" id="massOut"></p>
      </section>

      <section class="as-panel as-aim" aria-labelledby="aimH">
        <h2 class="label meta" id="aimH">The target</h2>

        <div class="as-search">
          <input
            id="cityInput" type="search" autocomplete="off" spellcheck="false"
            placeholder="Search a city, or click the map" aria-label="Search for a city"
          />
          <ul class="as-hits" id="hits" hidden></ul>
        </div>

        <div class="as-mapwrap">
          <div id="map" class="leafletMap" role="img" aria-label="World map, real satellite imagery. Click to choose an impact site."></div>
          <div class="as-layers" id="mapLayers">
            <button type="button" data-layer="sat" aria-pressed="true">Satellite</button>
            <button type="button" data-layer="street" aria-pressed="false">Street</button>
          </div>
        </div>

        <p class="as-target" id="targetOut">Nowhere selected yet.</p>
        <button type="button" class="pill pill--hero as-fire" id="fire" disabled>
          <span>Launch</span><span class="arrow" aria-hidden="true">→</span>
        </button>
      </section>
    </div>

    {/* The impact itself: the stage becomes the real map of where it landed.
        The frame stays put while the tour changes the scale of what is in it,
        which is the whole point — each radius is read against the last. */}
    <section class="as-impact" id="impact" hidden aria-label="Impact">
      <div id="zoom" class="leafletMap" role="img" aria-label="Real satellite imagery of the impact site, with damage rings"></div>
      <svg id="entryFx" class="entryFx" aria-hidden="true"></svg>

      <div class="as-head">
        <div>
          <p class="as-energy" id="energyOut"></p>
          <p class="as-compare" id="compareOut"></p>
        </div>
        <button type="button" class="pill pill--sm pill--paper" id="stageClose"><span>Build another</span></button>
      </div>

      <div class="tour" id="tour" aria-live="polite">
        <div class="tour-card">
          <p class="tour-kicker" id="tourKicker"></p>
          <p class="tour-figure" id="tourFigure"></p>
          <p class="tour-note" id="tourNote"></p>
          <ul class="tour-facts" id="tourFacts"></ul>
        </div>
        <div class="tour-nav">
          <button type="button" class="tour-prev" id="tourPrev">Back</button>
          <div class="tour-dots" id="tourDots" aria-hidden="true"></div>
          <button type="button" class="tour-next" id="tourNext">Next</button>
        </div>
      </div>

      <details class="as-method" id="method">
        <summary>How these numbers are worked out</summary>
        <div class="as-method-body">
          <p>
            Crater, fireball, blast and seismic figures come from Collins, Melosh &amp;
            Marcus (2005), the peer-reviewed model behind the Imperial College and
            Purdue impact calculator. The implementation is checked against four
            impacts with measured answers — Chelyabinsk, Tunguska, Meteor Crater and
            Chicxulub — and reproduces all four.
          </p>
          <p>
            Casualties are a much rougher thing and should be read as an order of
            magnitude. Each of the 1,200 largest cities on Earth is treated as an
            evenly-populated disc, and anyone living outside those cities is not
            counted at all — which is about right for an ocean strike and badly
            wrong for a densely-populated countryside. The fatality rates per blast
            band are anchored on Hiroshima; the mildest band is anchored on
            Chelyabinsk, where a 2 kPa wave over 1.1 million people injured about
            1,500 and killed nobody.
          </p>
          <p>Tsunami, ejecta and the global climate effects of the very largest impacts are not modelled.</p>
        </div>
      </details>
    </section>
  </div>

  <Fragment slot="howto">
    <p>
      Build a rock, drop it anywhere on Earth, and see what it does. The numbers
      come from the impact model planetary scientists actually use.
    </p>
    <ul>
      <li>Set its size, what it is made of, how fast it is going and how steeply it comes in, or start from a real impact: Chelyabinsk, Tunguska, Meteor Crater or the one that ended the dinosaurs.</li>
      <li>Search for a city or click anywhere on the map, then <b>Launch</b>.</li>
      <li>The impact is shown one effect at a time on real satellite imagery: the crater, the fireball, the shockwave, the wind, the earthquake and who it reaches. <kbd>←</kbd> and <kbd>→</kbd> step through them; <kbd>Esc</kbd> goes back to the builder.</li>
    </ul>
    <p>The last step opens the report. Your best is the biggest impact you have made.</p>
  </Fragment>
</GameShell>

<script>
  import L from 'leaflet'
  import 'leaflet/dist/leaflet.css'
  import { simulate, DENSITIES, type Composition } from '../lib/impact'
  import { estimateCasualties, cityRadius } from '../lib/casualties'
  import { CITIES, isLand, type City } from '../data/world'
  import { sfx, unlock } from '../lib/audio'
  import { burst, shake, ring as sparkRing } from '../lib/fx'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { recordPlay } from '../lib/stats'
  import { SITE } from '../site.config'
  import { rockStatic, rockFeatures, rockFeaturesInner, starField, ROCK_MATERIAL, dk } from '../lib/asteroid-art'

  const el = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T
  const prefersReducedMotion = !PLAY

  /* Real tiles, no API key: Esri's public World Imagery service (satellite)
     and OpenStreetMap's own tile server (street map), both free for
     reasonable, attributed, non-bulk use — which is what a page that loads
     tiles only when a visitor is actually looking at the map is. No key, no
     billing account, and — unlike the old hand-rolled coastline — this is
     the actual planet: Meteor Crater's bowl and Chicxulub's ring of cenotes
     are really there to look at, not implied by a diagram. */
  const SAT_URL = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'
  const STREET_URL = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png'
  const SAT_ATTR = 'Tiles &copy; Esri — Esri, Maxar, Earthstar Geographics, and the GIS User Community'
  const OSM_ATTR = '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors'

  const nf = (n: number, d = 0) =>
    n.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: d })

  /** Distances read very differently across nine orders of magnitude. */
  function dist(m: number): string {
    if (m < 1000) return `${nf(m)} m`
    if (m < 100_000) return `${nf(m / 1000, 1)} km`
    return `${nf(m / 1000)} km`
  }

  function bigNumber(n: number): string {
    if (n >= 1e9) return `${nf(n / 1e9, 1)} billion`
    if (n >= 1e6) return `${nf(n / 1e6, 1)} million`
    return nf(n)
  }

  /** How often an impact comes round, from the model's recurrence interval. */
  function years(y: number): string {
    if (y >= 1e6) return `${nf(y / 1e6, 1)} million years`
    if (y >= 1000) return `${nf(y / 1000)},000 years`
    return `${nf(Math.max(1, y))} years`
  }

  /* ---------------------------------------------------------------- state */

  let composition: Composition = 'rock'
  let target: { lat: number; lon: number; name: string } | null = null

  /** Slider 0–1000 maps logarithmically onto 1 m … 20 km. */
  const sliderToDiameter = (v: number) => Math.round(Math.exp(Math.log(1) + (v / 1000) * Math.log(20_000)))
  const diameterToSlider = (d: number) => Math.round((Math.log(d) / Math.log(20_000)) * 1000)

  const inputs = {
    diameter: el<HTMLInputElement>('diameter'),
    velocity: el<HTMLInputElement>('velocity'),
    angle: el<HTMLInputElement>('angle'),
  }

  function currentInput() {
    return {
      diameter: sliderToDiameter(Number(inputs.diameter.value)),
      composition,
      velocity: Number(inputs.velocity.value) * 1000,
      angle: Number(inputs.angle.value),
    }
  }

  /* ------------------------------------------------------------- the rock */

  /* The rock is real geometry (lib/asteroid-art.ts), not a picture: the same
     projection the checker verifies runs live here, at whatever rate the
     display can afford. It is server-rendered once already (see INITIAL_ROCK
     in the frontmatter) so there is something to look at before this script
     even runs; from here on this owns it. */
  const rockSvg = el<SVGSVGElement & HTMLElement>('rockSvg') as unknown as SVGSVGElement
  const ROCK_ID = 'rock'
  const ROCK_STARS = starField(51, 60) // same seed as the server render — identical field
  let rockRotation = 0.6 // matches the server-rendered frame, so nothing jumps on hydration
  let rockAcc = 0

  function featuresGroup(): SVGGElement | null {
    return rockSvg.querySelector<SVGGElement>('.ast-features')
  }

  /** Full redraw: defs, gradients and the sphere itself all depend on the
   *  material, so a composition change has to rebuild everything — cheap,
   *  since it only happens on a click, never per frame. */
  function drawRockFull() {
    rockSvg.innerHTML =
      rockStatic({ id: ROCK_ID, composition, stars: ROCK_STARS }) +
      rockFeatures({ id: ROCK_ID, composition, rotation: rockRotation })
  }

  if (!prefersReducedMotion) {
    let lastT = performance.now()
    const stepRock = (now: number) => {
      requestAnimationFrame(stepRock)
      const dt = Math.min((now - lastT) / 1000, 1 / 20)
      lastT = now
      rockRotation += dt * 0.32 // a slow tumble, not a spin
      rockAcc += dt
      // Throttled well below frame rate — the rock turns slowly enough that
      // 18 updates a second is indistinguishable from 60, at a fraction of
      // the DOM churn.
      if (rockAcc < 1 / 18) return
      rockAcc = 0
      const g = featuresGroup()
      if (g) g.innerHTML = rockFeaturesInner({ id: ROCK_ID, composition, rotation: rockRotation })
    }
    requestAnimationFrame(stepRock)
  }

  function syncReadouts() {
    const i = currentInput()
    el('diameterOut').textContent = dist(i.diameter)
    el('velocityOut').textContent = `${nf(i.velocity / 1000)} km/s`
    el('angleOut').textContent = `${i.angle}°`
    const kg = (Math.PI / 6) * DENSITIES[composition] * i.diameter ** 3
    el('massOut').textContent =
      kg >= 1e12
        ? `Weighs about ${bigNumber(kg / 1e9)} tonnes.`
        : `Weighs about ${bigNumber(Math.round(kg / 1000))} tonnes.`
    // The rock's own size follows the diameter slider — a scale transform on
    // the stage, not a change to the sphere's own geometry, so the craters'
    // projection math never has to know about it.
    const f = Number(inputs.diameter.value) / 1000
    el('rockStage').style.setProperty('--rockScale', (0.58 + f * 0.56).toFixed(3))
  }

  for (const input of Object.values(inputs)) {
    input.addEventListener('input', syncReadouts)
  }

  el('comp').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-comp]')
    if (!btn) return
    composition = btn.dataset.comp as Composition
    el('comp')
      .querySelectorAll<HTMLButtonElement>('[data-comp]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)))
    drawRockFull()
    unlock(); sfx.blip(2)
    syncReadouts()
  })

  /* ----------------------------------------------------------- the map */

  const satLayer = L.tileLayer(SAT_URL, { maxZoom: 19, attribution: SAT_ATTR })
  const streetLayer = L.tileLayer(STREET_URL, { maxZoom: 19, attribution: OSM_ATTR, subdomains: 'abc' })

  const map = L.map('map', {
    center: [51.507, -0.128], zoom: 5, layers: [satLayer], worldCopyJump: true,
  })

  let mapIsSat = true
  el('mapLayers').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-layer]')
    if (!btn) return
    const wantSat = btn.dataset.layer === 'sat'
    if (wantSat !== mapIsSat) {
      map.removeLayer(wantSat ? streetLayer : satLayer)
      map.addLayer(wantSat ? satLayer : streetLayer)
      mapIsSat = wantSat
    }
    el('mapLayers')
      .querySelectorAll<HTMLButtonElement>('[data-layer]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)))
    unlock(); sfx.click()
  })

  // A CircleMarker, not an L.marker — Leaflet's default pin is an image asset
  // that needs its own bundler wiring to resolve under Vite, and a plain
  // filled circle reads better against satellite imagery than a drop-shadow
  // pin does anyway.
  let targetMarker: L.CircleMarker | null = null

  function setTarget(lat: number, lon: number, name?: string) {
    const label =
      name ??
      (isLand(lat, lon)
        ? `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lon).toFixed(2)}°${lon >= 0 ? 'E' : 'W'}`
        : 'Open ocean')
    target = { lat, lon, name: label }

    if (!targetMarker) {
      targetMarker = L.circleMarker([lat, lon], {
        radius: 9, color: '#ff4f6e', weight: 3, fillColor: '#ff4f6e', fillOpacity: 0.85, interactive: false,
      }).addTo(map)
    } else {
      targetMarker.setLatLng([lat, lon])
    }
    el('targetOut').textContent = isLand(lat, lon)
      ? `Target: ${label}`
      : `Target: ${label} — nothing but water for a long way.`
    el<HTMLButtonElement>('fire').disabled = false
  }

  map.on('click', (e: L.LeafletMouseEvent) => {
    setTarget(e.latlng.lat, e.latlng.lng)
    unlock(); sfx.click()
  })

  /* -------------------------------------------------------- city search */

  const hits = el<HTMLUListElement>('hits')
  const cityInput = el<HTMLInputElement>('cityInput')

  cityInput.addEventListener('input', () => {
    const q = cityInput.value.trim().toLowerCase()
    if (q.length < 2) { hits.hidden = true; hits.innerHTML = ''; return }
    const found = CITIES.filter((c) => c.n.toLowerCase().startsWith(q)).slice(0, 8)
    hits.innerHTML = found
      .map(
        (c, i) =>
          `<li><button type="button" data-i="${i}">${c.n}<span>${c.c} · ${bigNumber(c.p)}</span></button></li>`,
      )
      .join('')
    hits.dataset.found = JSON.stringify(found.map((c) => [c.lat, c.lon, c.n, c.c]))
    hits.hidden = found.length === 0
  })

  hits.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-i]')
    if (!btn) return
    const found = JSON.parse(hits.dataset.found ?? '[]') as [number, number, string, string][]
    const pick = found[Number(btn.dataset.i)]
    if (!pick) return
    setTarget(pick[0], pick[1], `${pick[2]}, ${pick[3]}`)
    map.flyTo([pick[0], pick[1]], Math.max(map.getZoom(), 9))
    cityInput.value = pick[2]
    hits.hidden = true
    unlock(); sfx.click()
  })

  /* ------------------------------------------------------------ presets */

  const PRESETS: Record<
    string,
    { d: number; c: Composition; v: number; a: number; at?: [number, number, string]; zoom?: number }
  > = {
    chelyabinsk: { d: 19, c: 'rock', v: 19, a: 18, at: [55.15, 61.43, 'Chelyabinsk, Russia'], zoom: 10 },
    tunguska: { d: 55, c: 'rock', v: 17, a: 45, at: [60.89, 101.9, 'Tunguska, Siberia'], zoom: 8 },
    // Zoomed in close enough that the satellite layer actually shows the
    // real bowl — Meteor Crater is barely 1.2 km across.
    barringer: { d: 50, c: 'iron', v: 13, a: 45, at: [35.03, -111.02, 'Winslow, Arizona'], zoom: 14 },
    // Wide enough to hold the stretch of Yucatán coastline the crater's rim
    // traces — a real ring of cenotes, documented in gravity and radar
    // surveys, though not the kind of thing a casual satellite tile makes
    // obvious at a glance the way Meteor Crater's bowl is.
    chicxulub: { d: 10_000, c: 'rock', v: 20, a: 60, at: [21.4, -89.51, 'Chicxulub, Mexico'], zoom: 8 },
  }

  el('presets').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-preset]')
    if (!btn) return
    const p = PRESETS[btn.dataset.preset!]
    if (!p) return
    inputs.diameter.value = String(diameterToSlider(p.d))
    inputs.velocity.value = String(p.v)
    inputs.angle.value = String(p.a)
    composition = p.c
    el('comp')
      .querySelectorAll<HTMLButtonElement>('[data-comp]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.comp === p.c)))
    drawRockFull()
    if (p.at) {
      setTarget(p.at[0], p.at[1], p.at[2])
      map.flyTo([p.at[0], p.at[1]], p.zoom ?? map.getZoom())
    }
    syncReadouts()
    unlock(); sfx.good()
  })

  /* ------------------------------------------------------------- launch */

  const RING_COLOURS = ['#fff1c9', '#ffd166', '#ff9a3c', '#ff5f2e', '#e0341c', '#8d1f12']
  /** How long the entry streak takes to fall, in ms. Everything else about
   *  the impact — the flash, the shockwave, the boom, the rings' own reveal —
   *  fires from the streak's own animation-complete callback in drawZoom(),
   *  not a second timer racing it, so they cannot drift out of sync. */
  const FLIGHT_MS = 460

  /* ---- the result, as a picture ----------------------------------------- */

  let shareCard: import('../lib/result-card').ResultCard | null = null

  function buildCard(
    r: ReturnType<typeof simulate>,
    cas: ReturnType<typeof estimateCasualties>,
  ) {
    const mt = r.energyMt
    const energy =
      mt >= 1
        ? `${bigNumber(Math.round(mt))} megatonnes`
        : `${nf(mt * 1000, 1)} kilotonnes`

    /* An airburst has no crater, and printing "0 m across" for one is a lie
       the page itself does not tell — it swaps in the burst altitude. The card
       does the same rather than carrying an empty chip. */
    const shape = r.crater
      ? { label: 'Crater', value: dist(r.crater.final) }
      : { label: 'Burst at', value: dist(r.entry.burstAltitude) }

    recordPlay(
      'asteroid',
      { megatonnes: Math.round(mt), place: target?.name ?? '', dead: cas.dead },
      { megatonnes: 'high' },
    )

    shareCard = {
      slug: 'asteroid',
      siteName: SITE.name,
      headline: energy,
      /* Three sentences did not fit, and the one that got cut was the
         casualty count — a truncated number, which is the one thing the card
         refuses to print. The crater is a chip already, so the sentence keeps
         the place and the cost and says the rest through the chips. */
      sub:
        `${target?.name ?? 'An unnamed spot'}. ` +
        (cas.dead > 0
          ? `${bigNumber(cas.dead)} people do not survive it.`
          : r.crater
            ? `Nobody lives close enough to be killed by it.`
            : `It comes apart in the air and never lands.`),
      stats: [
        shape,
        { label: 'Fireball', value: dist(r.fireball) },
        { label: 'Quake', value: 'M' + r.magnitude.toFixed(1) },
      ],
    }
  }

  /* ---- the shell ---------------------------------------------------------- */

  const shell = createShell({ slug: 'asteroid', onRestart: closeStage })
  let launches = 0
  let lastRun: { r: ReturnType<typeof simulate>; cas: ReturnType<typeof estimateCasualties> } | null = null

  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumSignificantDigits: 3 })
  /** Energy short enough for a score tile: "480 t", "15 kt", "1.2M Mt". */
  function energyShort(mt: number): string {
    if (mt >= 1) return `${compact.format(mt)} Mt`
    if (mt >= 1e-3) return `${compact.format(mt * 1000)} kt`
    return `${compact.format(mt * 1e6)} t`
  }

  el('fire').addEventListener('click', () => {
    if (!target) return
    const result = simulate(currentInput())
    const casualties = estimateCasualties(result, target.lat, target.lon)
    launches++
    lastRun = { r: result, cas: casualties }
    // First: render() starts a new run in the shell, so a best this launch
    // beats has to be offered after it, or the reset wipes the badge.
    render(result, casualties)
    shell.setScore(energyShort(result.energyMt))
    shell.setLevel(result.crater ? dist(result.crater.final) : 'Airburst')
    shell.setMoves(String(launches))
    shell.considerBest(result.energyMt, energyShort(result.energyMt))
    unlock()
    sfx.whoosh()
  })

  el('stageClose').addEventListener('click', closeStage)
  addEventListener('keydown', (e) => {
    if (el('impact').hidden || document.querySelector('dialog[open]')) return
    if (e.key === 'Escape') closeStage()
    else if (e.key === 'ArrowRight') goStep(stepIndex + 1)
    else if (e.key === 'ArrowLeft') goStep(stepIndex - 1)
  })

  /** Back to the builder, with the rock and the target as you left them. */
  function closeStage() {
    el('impact').hidden = true
    el('build').hidden = false
    // Leaflet measured the builder's map while it was hidden, if it was.
    map.invalidateSize()
    el('build').scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' })
    el('fire').focus({ preventScroll: true })
  }

  /* ---- the report: the shell's result card ------------------------------ */

  function report() {
    if (!lastRun || !target || !shareCard) return
    const { r, cas } = lastRun
    const mt = r.energyMt
    const hiroshimas = (mt * 1000) / 15
    shell.win({
      celebrate: false,
      kicker: `Impact report · ${target.name}`,
      title: cas.dead > 0
        ? `${bigNumber(cas.dead)} people do not survive it.`
        : r.crater ? 'Nobody lives close enough to be killed by it.' : 'It comes apart in the air and never lands.',
      score: energyShort(mt),
      lines: [
        hiroshimas < 1
          ? `About ${nf(hiroshimas, 2)} times the Hiroshima bomb.`
          : mt < 50 ? `About ${bigNumber(Math.round(hiroshimas))} Hiroshima bombs.` : `About ${bigNumber(Math.round(mt / 50))} times the largest bomb ever tested.`,
        `Something this size hits the Earth about once every ${years(r.recurrenceYears)}.`,
      ],
      againLabel: 'Launch another',
    })
    shell.resultExtra.innerHTML =
      `<ul class="as-sheet" role="list">${steps.map((st) => `<li><span class="label">${st.kicker}</span><b>${st.figure}</b></li>`).join('')}</ul>` +
      `<div class="as-report-acts"><button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share the report</span></button>` +
      `<button type="button" class="pill pill--line pill--line-paper" id="reTour"><span>Back to the map</span></button></div>`
    el('shareBtn').addEventListener('click', async (e) => {
      const btn = (e.currentTarget as HTMLElement).querySelector('span')!
      const outcome = await shareResult(shareCard!, { title: 'Asteroid Launcher', text: `${shareCard!.headline}, where I dropped it.`, url: location.href })
      btn.textContent = outcomeLabel[outcome]
      setTimeout(() => (btn.textContent = 'Share the report'), 1600)
    })
    el('reTour').addEventListener('click', () => {
      shell.reset()
      el('impact').scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' })
    })
  }

  /* ---- the tour ---------------------------------------------------------
   *
   * One effect at a time, each framed on the map at its own real radius.
   * Every ring was already drawn at once in the first version of this page,
   * which is an information display: it shows you that six circles exist. The
   * thing being modelled is a sequence — a hole, then a fireball, then a wave
   * of pressure arriving — and showing it one step at a time is the only way
   * the sizes mean anything, because each step is framed against the last.
   */

  type TourStep = {
    key: string
    kicker: string
    figure: string
    note: string
    facts: string[]
    /** Metres from the impact point that the map should frame for this step. */
    radius: number
  }

  let steps: TourStep[] = []
  let stepIndex = 0

  function buildTour(
    r: ReturnType<typeof simulate>,
    cas: ReturnType<typeof estimateCasualties>,
  ): TourStep[] {
    const out: TourStep[] = []
    const thermal = (e: string) => r.thermal.find((t) => t.effect === e)
    const burns3 = thermal('thirdDegreeBurns')
    const clothes = thermal('clothingIgnites')
    const trees = thermal('treesIgnite')

    if (r.crater) {
      out.push({
        key: 'crater',
        kicker: 'The crater',
        figure: `${dist(r.crater.final)} across`,
        note: 'Everything that was standing here is now part of the rim.',
        facts: [
          `${dist(r.crater.depth)} deep`,
          `The cavity opens to ${dist(r.crater.transient)} before its walls slump back in`,
        ],
        radius: r.crater.final / 2,
      })
    } else {
      out.push({
        key: 'airburst',
        kicker: 'It never lands',
        figure: `${dist(r.entry.burstAltitude)} up`,
        note: 'The air tears it apart before it reaches the ground and it detonates there. No crater — this is what Tunguska did.',
        facts: [
          r.entry.breakupAltitude
            ? `It starts coming apart at ${dist(r.entry.breakupAltitude)}`
            : 'It comes apart on the way down',
          'The damage below is all pressure and heat, with nothing to dig',
        ],
        radius: r.fireball,
      })
    }

    out.push({
      key: 'fireball',
      kicker: 'The fireball',
      figure: `${dist(r.fireball)} radius`,
      note: 'A ball of glowing vapour, briefly several times brighter than the Sun.',
      facts: [
        clothes ? `Clothing catches fire out to ${dist(clothes.radius)}` : 'Not hot enough to set clothing alight',
        burns3 ? `Third-degree burns to ${dist(burns3.radius)}` : 'No third-degree burns beyond the fireball itself',
        trees ? `Trees ignite to ${dist(trees.radius)}` : 'Nothing catches light at a distance',
      ],
      radius: Math.max(r.fireball, burns3?.radius ?? 0),
    })

    if (r.blast.length) {
      const worst = r.blast[0]
      const outer = r.blast[r.blast.length - 1]
      out.push({
        key: 'shock',
        kicker: 'The shockwave',
        figure: `${dist(outer.radius)} out`,
        note: `${worst.label} at the centre, and it is still breaking windows at the far edge.`,
        facts: r.blast.map((b) => `${b.label} to ${dist(b.radius)} — ${b.note}`),
        radius: outer.radius,
      })

      const fastest = r.blast.reduce((a, b) => (b.wind > a.wind ? b : a))
      out.push({
        key: 'wind',
        kicker: 'The wind',
        figure: `${nf(fastest.wind * 3.6)} km/h`,
        note: 'Peak gust behind the pressure front. A strong hurricane is about 250 km/h.',
        facts: r.blast
          .slice(0, 4)
          .map((b) => `${nf(b.wind * 3.6)} km/h at ${dist(b.radius)}`),
        radius: outer.radius,
      })
    }

    const rec = r.recurrenceYears
    out.push({
      key: 'quake',
      kicker: 'The earthquake',
      figure: `M${r.magnitude.toFixed(1)}`,
      note: 'The ground shock, on the same scale a seismologist would give it.',
      facts: [
        `An impact this size happens somewhere on Earth about every ${years(rec)}`,
        `${bigNumber(Math.round(r.energyMt * 1000 / 15))} Hiroshima bombs of energy, released at once`,
      ],
      radius: r.maxRadius,
    })

    const toll: TourStep = {
      key: 'toll',
      kicker: 'Who it reaches',
      figure: cas.dead > 0 ? `${bigNumber(cas.dead)} dead` : 'Nobody',
      note:
        cas.dead > 0 || cas.injured > 0
          ? `${bigNumber(cas.injured)} more are injured.`
          : isLand(target!.lat, target!.lon)
            ? 'No city in the dataset is close enough to be hurt. Empty land absorbs it.'
            : 'Open water. Nobody is under it — though a strike this size at sea would raise waves this model does not attempt.',
      facts: cas.cities
        .slice(0, 6)
        .map((c) => `${c.city.n} — ${bigNumber(Math.round(c.dead))} dead, ${dist(c.distance)} away`),
      radius: r.maxRadius,
    }
    out.push(toll)
    return out
  }

  function goStep(i: number) {
    if (!steps.length) return
    stepIndex = Math.max(0, Math.min(steps.length - 1, i))
    const s = steps[stepIndex]

    el('tourKicker').textContent = s.kicker
    el('tourFigure').textContent = s.figure
    el('tourNote').textContent = s.note
    el('tourFacts').innerHTML = s.facts.map((f) => `<li>${f}</li>`).join('')

    el('tourDots').innerHTML = steps
      .map((_, k) => `<span class="as-dot${k === stepIndex ? ' on' : ''}"></span>`)
      .join('')

    const prev = el<HTMLButtonElement>('tourPrev')
    const next = el<HTMLButtonElement>('tourNext')
    prev.disabled = stepIndex === 0
    next.textContent = stepIndex === steps.length - 1
      ? 'See the report'
      : `Next: ${steps[stepIndex + 1].kicker.replace(/^The /, '').replace(/^./, (c) => c.toLowerCase())}`

    // The card re-announces itself on every step, so the figure reads as a
    // new arrival rather than text quietly swapping underneath you.
    const card = document.querySelector<HTMLElement>('.tour-card')
    if (card && !prefersReducedMotion) {
      card.classList.remove('stepIn')
      void card.offsetWidth
      card.classList.add('stepIn')
    }

    ;(el('zoom') as HTMLElement).dataset.step = s.key
    frameStep(s.radius)
    sfx.blip(stepIndex)
  }

  /**
   * Fly the map so this step's own radius fills a comfortable part of the view.
   *
   * The padding is the point, not a margin: the tour card sits over the bottom
   * of the stage and the impact point is the middle of the bounds, so fitting
   * to the raw viewport put the crater directly behind the card describing it.
   * Leaflet's own padding options fit the circle into the part of the map that
   * is actually visible, which is what the numbers are being compared against.
   */
  function frameStep(radius: number) {
    if (!zoomMap || !target) return
    const center = L.latLng(target.lat, target.lon)
    const card = document.querySelector<HTMLElement>('.tour')
    const below = card ? Math.min(card.offsetHeight + 26, innerHeight * 0.52) : 0
    zoomMap.flyToBounds(center.toBounds(Math.max(radius, 60) * 2 * 1.9), {
      duration: prefersReducedMotion ? 0 : 0.85,
      easeLinearity: 0.25,
      paddingTopLeft: [0, 56],
      paddingBottomRight: [0, below],
    })
  }

  function render(r: ReturnType<typeof simulate>, cas: ReturnType<typeof estimateCasualties>) {
    shell.reset()
    el('build').hidden = true
    el('impact').hidden = false
    el('impact').scrollIntoView({ behavior: 'auto', block: 'start' })
    buildCard(r, cas)

    /* headline ------------------------------------------------------- */
    const mt = r.energyMt
    el('energyOut').textContent =
      mt >= 1
        ? `${bigNumber(Math.round(mt))} megatonnes of TNT`
        : `${nf(mt * 1000, 1)} kilotonnes of TNT`

    // Hiroshima was 15 kt; Tsar Bomba, the largest device ever detonated, 50 Mt.
    const hiroshimas = (mt * 1000) / 15
    el('compareOut').textContent =
      hiroshimas < 1
        ? `About ${nf(hiroshimas, 2)} times the Hiroshima bomb.`
        : mt < 50
          ? `About ${bigNumber(Math.round(hiroshimas))} Hiroshima bombs.`
          : `About ${bigNumber(Math.round(mt / 50))} times the largest bomb ever tested.`

    steps = buildTour(r, cas)
    stepIndex = 0
    drawZoom(r)
  }

  /* --------------------------------------------------------- zoom view */

  // Fireball and crater are lit glows rather than a flat tint — the same
  // radial-gradient technique the rest of the site uses for "a bright thing"
  // and "a dark hole." They live in their own <defs>, seeded once into
  // Leaflet's SVG renderer the moment it exists (see ensureZoomMap), because
  // the renderer is created once for the map's lifetime and never rebuilds
  // its <defs> on pan or zoom — only the rings' own d/transform change.
  const ZOOM_DEFS = `<defs>
    <radialGradient id="zoom-fire" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fffef2"/>
      <stop offset="38%" stop-color="#ffe9a8" stop-opacity="0.95"/>
      <stop offset="72%" stop-color="#ff9a3c" stop-opacity="0.75"/>
      <stop offset="100%" stop-color="#ff5f2e" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="zoom-crater" cx="42%" cy="36%" r="68%">
      <stop offset="0%" stop-color="#4a2115"/>
      <stop offset="65%" stop-color="#2b0b06"/>
      <stop offset="100%" stop-color="#140502"/>
    </radialGradient>
  </defs>`

  let zoomMap: L.Map | null = null
  let ringsGroup: L.LayerGroup | null = null

  /**
   * Seed the gradient <defs> into Leaflet's own SVG renderer, and keep asking.
   *
   * Calling this once from ensureZoomMap was a silent, invisible bug: adding
   * the renderer to the map does not necessarily create its <svg> element in
   * the same tick, so `querySelector('svg')` returned null, the defs were
   * never inserted, and the crater and fireball — whose fills are
   * `url(#zoom-crater)` and `url(#zoom-fire)` — painted as nothing at all.
   * Nothing errors when an SVG paint server is missing; the shape is simply
   * not there. So this runs again on every launch, after the rings exist,
   * where the element is guaranteed.
   */
  function ensureDefs() {
    const svg = (el('zoom') as HTMLElement).querySelector('svg')
    if (svg && !svg.querySelector('#zoom-fire')) svg.insertAdjacentHTML('afterbegin', ZOOM_DEFS)
  }

  function ensureZoomMap() {
    if (zoomMap) return
    // No zoom buttons: the tour drives the camera, and a pair of +/- controls
    // in the corner invites you to fight it. Attribution stays — the tiles
    // require it.
    zoomMap = L.map('zoom', {
      attributionControl: true, scrollWheelZoom: false, doubleClickZoom: false,
      zoomControl: false,
    })
    L.tileLayer(SAT_URL, { maxZoom: 19, attribution: SAT_ATTR }).addTo(zoomMap)
    // Explicitly instantiates the SVG renderer (rather than waiting for the
    // first vector layer) so ZOOM_DEFS can be seeded before any ring ever
    // references it by url(#...).
    L.svg().addTo(zoomMap)
    ensureDefs()
    L.control.scale({ imperial: false, maxWidth: 110 }).addTo(zoomMap)
    ringsGroup = L.layerGroup().addTo(zoomMap)
  }

  function drawZoom(r: ReturnType<typeof simulate>) {
    ensureZoomMap()
    const zmap = zoomMap!
    ringsGroup!.clearLayers()

    const center = L.latLng(target!.lat, target!.lon)
    // A real geodesic bound around the centre, sized off the model's own
    // largest radius — Leaflet's own projection handles the fact that a
    // degree of longitude is shorter near the poles, which used to be a
    // hand-written stretch factor here.
    // The impact view was hidden a moment ago, so Leaflet has to measure it
    // before it can fit anything into it.
    zmap.invalidateSize()
    zmap.fitBounds(center.toBounds(r.maxRadius * 2 * 1.35), { animate: false })

    // Each ring carries what kind of thing it is, so the tour can dim
    // everything that is not the step you are on without re-drawing anything.
    const ring = (metres: number, colour: string, i: number, kind: string, dashed = false) => {
      const c = L.circle(center, {
        radius: metres, color: colour, weight: 1.6, opacity: 0.85,
        fillColor: colour, fillOpacity: 0.13, className: `ring ${kind}`, interactive: false,
        dashArray: dashed ? '6 5' : undefined,
      }).addTo(ringsGroup!)
      ;(c.getElement() as HTMLElement | undefined)?.style.setProperty('--i', String(i))
    }

    // Largest first so the small, hot rings paint on top.
    const ordered = [...r.blast].sort((a, b) => b.radius - a.radius)
    ordered.forEach((b, i) => ring(b.radius, RING_COLOURS[Math.min(i, 5)], i, 'blast'))
    const burns = r.thermal.find((t) => t.effect === 'thirdDegreeBurns')
    if (burns) ring(burns.radius, '#ffd166', ordered.length, 'thermal', true)
    if (r.crater) {
      const c = L.circle(center, {
        radius: r.crater.final / 2, color: '#6b4231', weight: 1.6, opacity: 0.55,
        fillColor: 'url(#zoom-crater)', fillOpacity: 0.95, className: 'ring crater', interactive: false,
      }).addTo(ringsGroup!)
      ;(c.getElement() as HTMLElement | undefined)?.style.setProperty('--i', String(ordered.length + 1))
    }
    {
      // Its own class, not just "ring" — the fireball gets a bouncier,
      // overshooting reveal in CSS (a bright thing should punch past its
      // final size and settle, not politely fade in like an information
      // ring) that would look wrong on anything else in the set.
      const c = L.circle(center, {
        radius: r.fireball, stroke: false, fillColor: 'url(#zoom-fire)', fillOpacity: 0.95,
        className: 'ring fireball', interactive: false,
      }).addTo(ringsGroup!)
      ;(c.getElement() as HTMLElement | undefined)?.style.setProperty('--i', String(ordered.length + 2))
    }

    ensureDefs()

    // Nearby cities, so the rings have something real to sit next to —
    // Leaflet's own bounds after fitBounds, not a hand-measured radius.
    const bounds = zmap.getBounds()
    const near = CITIES.filter((c) => bounds.contains([c.lat, c.lon]))
      .sort((a, b) => b.p - a.p)
      .slice(0, 12)
    for (const c of near) {
      L.circleMarker([c.lat, c.lon], {
        radius: 4, color: '#9fd0ff', weight: 1, fillColor: '#9fd0ff', fillOpacity: 1, interactive: false,
      })
        .bindTooltip(c.n, { permanent: true, direction: 'right', offset: [6, 0], className: 'placeLabel' })
        .addTo(ringsGroup!)
    }

    // Rings are appended invisible (see the #zoom path.ring CSS)
    // and revealed by adding .impacted once the streak below actually lands
    // — resetting it here means a second launch always starts from
    // invisible again rather than a stale class popping the new rings in
    // instantly.
    const zoomEl = el('zoom') as HTMLElement
    zoomEl.classList.remove('impacted')

    // The entry streak lives in its own screen-space overlay, not on the
    // map itself — there is no real bearing in the model to plot (only an
    // elevation angle), so this is a cosmetic flourish and pixel space is
    // the honest place to build one, rather than dressing it up as geodata.
    const fx = el<SVGSVGElement & HTMLElement>('entryFx') as unknown as SVGSVGElement
    const box = zoomEl.getBoundingClientRect()
    fx.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`)
    const targetPt = zmap.latLngToContainerPoint(center)
    const m = ROCK_MATERIAL[composition]

    /**
     * Fires once, whether the streak actually flew or (under reduced motion)
     * was skipped outright — the single moment "impact" happens, and every
     * effect keys off it instead of a second guessed timer racing the
     * animation. `getBoundingClientRect()` is re-read here rather than
     * reusing `box`: the page is still mid-`scrollIntoView` when this runs,
     * so the map's screen position genuinely moves during the flight.
     */
    function impact() {
      zoomEl.classList.add('impacted')
      sfx.boom()
      shake(el('impact'), 10, 420)
      // The rings arrive at their real sizes first, so the tour's first fly-in
      // reads as zooming into something already there rather than as the map
      // simply starting somewhere arbitrary.
      setTimeout(() => goStep(0), prefersReducedMotion ? 0 : 620)

      const live = zoomEl.getBoundingClientRect()
      const sx = live.left + targetPt.x
      const sy = live.top + targetPt.y

      if (!prefersReducedMotion) {
        const flash = el('impactFlash')
        flash.style.setProperty('--fx', `${(sx / innerWidth) * 100}%`)
        flash.style.setProperty('--fy', `${(sy / innerHeight) * 100}%`)
        // Removing and re-adding the class restarts the CSS animation even
        // on a second launch in a row, where it would otherwise still be
        // "on" and not fire again.
        flash.classList.remove('hit')
        void (flash as HTMLElement).offsetWidth
        flash.classList.add('hit')

        const wrap = zoomEl.closest<HTMLElement>('.as-impact')
        wrap?.classList.remove('impactPunch')
        void wrap?.offsetWidth
        wrap?.classList.add('impactPunch')

        // A fast, forceful shockwave — distinct from the slower, informational
        // blast rings on the map itself — read together as "something has
        // actually happened here" a beat before the numbers do.
        sparkRing(sx, sy, '#fff4d6', 20)
        setTimeout(() => sparkRing(sx, sy, m.glow, 46), 70)
      }

      // Debris is tinted to the material actually dropped, not a fixed
      // orange — the same ROCK_MATERIAL the build panel's rock and its
      // composition swatches use, so an iron impact throws rust-coloured
      // sparks and a gold one throws its own glow.
      burst(sx, sy, {
        count: 34, colors: [m.glow, m.fleck, '#fff4d6', '#ff7a33'], speed: 6.5,
        gravity: 0.18, shape: 'streak', size: 3, life: 42,
      })
      // A ground impact throws a second, heavier wave of dust that falls
      // back rather than streaking away — an airburst has nothing to dig up.
      if (r.crater) {
        burst(sx, sy, {
          count: 22, colors: [dk(m.base, 0.3), m.base], speed: 3, gravity: 0.05,
          drag: 0.94, shape: 'square', size: 4, life: 60,
        })
      }
    }

    // A moving streak is exactly the motion prefers-reduced-motion asks this
    // site to skip. Left out entirely rather than freezing it full-length,
    // which would just leave a static line with no obvious reason to exist
    // — impact() still fires immediately, so nothing else about the result
    // depends on the streak having played.
    if (prefersReducedMotion) {
      fx.innerHTML = ''
      impact()
      return
    }

    // Direction (cos, -sin) of the model's own "angle" input from the
    // horizontal — steep means nearly straight down, shallow means nearly
    // grazing — scaled out past the edge of the view.
    const theta = (r.input.angle * Math.PI) / 180
    const reach = Math.max(box.width, box.height) * 0.9
    const startX = targetPt.x + Math.cos(theta) * reach
    const startY = targetPt.y - Math.sin(theta) * reach

    fx.innerHTML =
      `<defs><linearGradient id="entry-core" x1="0" y1="0" x2="1" y2="1">` +
      `<stop offset="0%" stop-color="${m.glow}" stop-opacity="0"/>` +
      `<stop offset="100%" stop-color="#fffef2"/></linearGradient></defs>` +
      `<line id="streakGlow" x1="${startX}" y1="${startY}" x2="${startX}" y2="${startY}" ` +
      `stroke="${m.glow}" stroke-width="11" stroke-linecap="round" opacity="0.4"/>` +
      `<line id="streakCore" x1="${startX}" y1="${startY}" x2="${startX}" y2="${startY}" ` +
      `stroke="url(#entry-core)" stroke-width="3.5" stroke-linecap="round"/>`

    const glowLine = fx.querySelector<SVGLineElement>('#streakGlow')!
    const coreLine = fx.querySelector<SVGLineElement>('#streakCore')!
    // A plain rAF loop rather than SMIL — driving it by hand is what lets
    // embers spawn along the actual path each frame and lets `impact()` fire
    // from the animation's own completion instead of a second timer.
    const t0 = performance.now()
    let lastEmber = 0

    function frame(now: number) {
      const t = Math.min(1, (now - t0) / FLIGHT_MS)
      // t*t, not linear or eased-out — a falling body accelerates, so the
      // streak should visibly speed up as it drops rather than travel at a
      // constant rate.
      const k = t * t
      const cx = startX + (targetPt.x - startX) * k
      const cy = startY + (targetPt.y - startY) * k
      glowLine.setAttribute('x2', String(cx))
      glowLine.setAttribute('y2', String(cy))
      coreLine.setAttribute('x2', String(cx))
      coreLine.setAttribute('y2', String(cy))

      if (now - lastEmber > 24 && t < 0.96) {
        lastEmber = now
        const live = zoomEl.getBoundingClientRect()
        burst(live.left + cx, live.top + cy, {
          count: 2, colors: [m.glow, '#fff4d6'], speed: 1, gravity: 0.02,
          shape: 'dot', size: 2, life: 20,
        })
      }

      if (t < 1) requestAnimationFrame(frame)
      else {
        // The impact flash covers the same instant, so the line vanishing
        // abruptly here reads as swallowed by the light rather than as a pop.
        fx.innerHTML = ''
        impact()
      }
    }
    requestAnimationFrame(frame)
  }

  /* --------------------------------------------------------------- boot */

  el('tourPrev').addEventListener('click', () => goStep(stepIndex - 1))
  el('tourNext').addEventListener('click', () => {
    if (stepIndex === steps.length - 1) report()
    else goStep(stepIndex + 1)
  })

  syncReadouts()
  setTarget(51.507, -0.128, 'London, United Kingdom')
</script>

<style is:global>
  /* Leaflet builds its own markup and the tour, the hits and the report are
     built by the script, so these rules are global on purpose. Everything is
     prefixed or scoped under .as. */
