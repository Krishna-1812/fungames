---
import GameShell from '../layouts/GameShell.astro'
import { COUNTRIES, REST, annualBirths, annualDeaths, perSecond, globalTotals, WORLD_POPULATION } from '../data/population-live'
import { COUNTRY_SHAPES, MAP_W, MAP_H } from '../data/population-geo'
import { project, EARTH_LAT } from '../lib/population-map'

/**
 * Every Second, Somewhere — a live simulation of real birth and death rates,
 * forty real countries at a time, drawn on their own real borders.
 *
 * Nothing here is a live feed: there is no backend, and no page on this site
 * has one. What runs instead is a genuine Poisson process — the standard
 * model for events that happen independently at a known average rate — seeded
 * with each country's real population and its real published crude birth and
 * death rate. `lib/population-map.ts` carries the one function both the page
 * and `scripts/check-population-live.mjs` call: given a rate and a random
 * draw, how many seconds until the next event. The maths is checked directly
 * — not just "does it average out right" but "is it really the exponential
 * distribution a Poisson process has, and not merely a right mean wearing a
 * wrong shape."
 *
 * The map itself is real: every one of the 176 shapes drawn here is Natural
 * Earth's own admin-0 country geometry (`scripts/build-population-geo.mjs`,
 * `data/population-geo.ts`), projected equirectangular — not a hand-drawn
 * approximation. The forty simulated countries get their own real outline
 * lit up on a birth or death, the same way the real thing this is modelled
 * after does it.
 *
 * Under those borders is the Earth as it looks at the instant on the page's
 * clock (lib/every-second-earth.ts): daylight, the real edge of night for
 * that date and hour, and lights on the dark side where the people are. A
 * birth or a death is a point of light on it that opens into a ring. Run the
 * clock at a day a minute and night goes round the world once a minute.
 *
 * In the shell the map is framed on the stage, with the live count above it
 * and the speed below. A birth lights mint, a death blue-violet. Score is births since you opened the page, Net is births minus
 * deaths, Speed is the playback speed, Best is the most births you have
 * watched in one visit, and one whole simulated day is the ending (a minute,
 * at the fastest speed). Pausing stops the clock.
 */

const shapeByName = new Map(COUNTRY_SHAPES.map((s) => [s.name, s]))

type Layer = { name: string; path: string; cx: number; cy: number; simIndex: number }
const layers: Layer[] = COUNTRY_SHAPES.filter((s) => s.name !== 'Antarctica').map((s) => ({
  name: s.name,
  path: s.path,
  cx: s.cx,
  cy: s.cy,
  simIndex: COUNTRIES.findIndex((c) => (c.atlasName ?? c.name) === s.name),
}))

const fmt = (n: number) => Math.round(n).toLocaleString('en-US')

const simData = COUNTRIES.map((c) => {
  const shape = shapeByName.get(c.atlasName ?? c.name)
  const [capX, capY] = project(c.lat, c.lon)
  return {
    name: c.name,
    population: c.population,
    birthRate: c.birthRate,
    deathRate: c.deathRate,
    bps: perSecond(annualBirths(c)),
    dps: perSecond(annualDeaths(c)),
    cx: shape?.cx ?? capX,
    cy: shape?.cy ?? capY,
  }
})

const totals = globalTotals()
const restBps = perSecond(annualBirths(REST))
const restDps = perSecond(annualDeaths(REST))
---

<GameShell
  slug="every-second"
  labels={{ score: 'Born', best: 'Most seen', level: 'Speed', moves: 'Net' }}
  initial={{ score: '0', level: 'Live', moves: '+0' }}
>
  <div class="es-scene" id="scene">
    <div class="mapwrap">
      <div class="earth" id="earth" aria-hidden="true"></div>
      <svg id="map" viewBox={`0 ${90 - EARTH_LAT.north} ${MAP_W} ${EARTH_LAT.north - EARTH_LAT.south}`} preserveAspectRatio="none">
        {
          layers.map((l) =>
            l.simIndex >= 0 ? (
              <path
                class="country sim"
                data-i={l.simIndex}
                d={l.path}
                tabindex="0" role="button"
                aria-label={`${l.name}. Population ${fmt(simData[l.simIndex].population)}. ${simData[l.simIndex].birthRate} births and ${simData[l.simIndex].deathRate} deaths per thousand people a year.`}
              />
            ) : (
              <path class="country" d={l.path} aria-hidden="true" />
            )
          )
        }
        {
          simData.map((d, i) => (
            <circle class="es-marker" data-i={i} cx={d.cx} cy={d.cy} r="1.3" aria-hidden="true" />
          ))
        }
      </svg>
    </div>

    <div class="hud">
      <div class="pop-label">world population, estimated live</div>
      <div class="pop-value" id="popValue">{fmt(WORLD_POPULATION)}</div>
      <div class="rate-row">
        <span class="rate birth"><i aria-hidden="true"></i><b id="birthCount">0</b> births</span>
        <span class="rate death"><i aria-hidden="true"></i><b id="deathCount">0</b> deaths</span>
        <span class="rate net">net <b id="netCount">+0</b></span>
      </div>
      <div class="since">since you opened this page</div>
    </div>

    <div class="under" aria-hidden="true">
      <span class="clock" id="clock"></span>
      <span class="feed" id="feed"></span>
    </div>

    <div class="speed" role="radiogroup" aria-label="Playback speed">
      <button type="button" class="opt" data-speed="1" aria-checked="true" role="radio">Live</button>
      <button type="button" class="opt" data-speed="60" aria-checked="false" role="radio">1 min = 1 hour</button>
      <button type="button" class="opt" data-speed="1440" aria-checked="false" role="radio">1 min = 1 day</button>
    </div>

    <section class="inspector" id="inspector" hidden aria-labelledby="inspectorName">
      <button type="button" class="close" id="inspectorClose" aria-label="Close">×</button>
      <h2 id="inspectorName"></h2>
      <dl>
        <dt>Population</dt><dd id="inspectorPop"></dd>
        <dt>Births</dt><dd id="inspectorBirth"></dd>
        <dt>Deaths</dt><dd id="inspectorDeath"></dd>
        <dt>A birth here, on average</dt><dd id="inspectorBirthAvg"></dd>
        <dt>A death here, on average</dt><dd id="inspectorDeathAvg"></dd>
      </dl>
    </section>

    <p class="hint" id="hint">Click any lit-up country for its own numbers.</p>
  </div>

  {/* Text alternative for anyone who cannot use the live map. */}
  <ul class="sr-only">
    <li>World population, estimated: {fmt(WORLD_POPULATION)}</li>
    <li>Real global rate: {totals.birthsPerSecond.toFixed(2)} births and {totals.deathsPerSecond.toFixed(2)} deaths per second</li>
    {simData.map((d) => (
      <li>{d.name}: population {fmt(d.population)}, {d.birthRate} births and {d.deathRate} deaths per 1,000 people a year</li>
    ))}
  </ul>

  <Fragment slot="howto">
    <p>
      A live simulation of the world's real birth and death rates: every birth
      and every death in forty real countries lights up where it happens, at
      the rate the real country has them. The map is the Earth right now: day
      where it is day, night where it is night.
    </p>
    <ul>
      <li>Each event is drawn from the same random process real, independent events follow, so the gaps are as uneven as the real ones.</li>
      <li>Speed it up to watch an hour, or a whole day, go by in a minute. At a day a minute you can watch night cross the world.</li>
      <li>Click a country for its population and its own rates.</li>
    </ul>
    <p>A whole simulated day is the end. Your best is the most births you have watched in one visit.</p>
  </Fragment>
</GameShell>

  <script type="application/json" id="game-data" set:html={JSON.stringify({
    simData, restBps, restDps, worldPopulation: WORLD_POPULATION,
  })} />

  <script>
  import { nextInterval } from '../lib/population-map'
  import { prefersReducedMotion, ShaderSurface } from '../lib/gl'
  import { EVERY_SECOND_FRAG, EARTH_EVENTS, EARTH_PLACES } from '../lib/every-second-earth'
  import { subsolar } from '../lib/progress-watch'
  import { unlock } from '../lib/audio'
  import { createShell } from '../lib/game-shell'
  import { recordPlay } from '../lib/stats'

  const { simData, restBps, restDps, worldPopulation } = JSON.parse(
    document.getElementById('game-data')!.textContent!,
  ) as any

  const countryEls = [...document.querySelectorAll<SVGPathElement>('.country.sim')]
  const markerEls = [...document.querySelectorAll<SVGCircleElement>('.es-marker')]
  // Both are indexed by the same data-i as simData, so a country's shape and
  // its marker are always found together.
  const byIndex = new Map<number, { country: SVGPathElement; marker: SVGCircleElement }>()
  countryEls.forEach((el) => byIndex.set(Number(el.dataset.i), { country: el, marker: null as any }))
  markerEls.forEach((el) => (byIndex.get(Number(el.dataset.i))!.marker = el))

  type Live = { d: any, els: { country: SVGPathElement; marker: SVGCircleElement }, nextBirthAt: number, nextDeathAt: number }
  const live: Live[] = simData.map((d: any, i: number) => ({
    d, els: byIndex.get(i)!,
    nextBirthAt: d.bps > 0 ? nextInterval(d.bps, Math.random()) : Infinity,
    nextDeathAt: d.dps > 0 ? nextInterval(d.dps, Math.random()) : Infinity,
  }))

  const BIRTH_COLOR = '#4fe3c1'
  const DEATH_COLOR = '#8892e8'

  /* ---- the Earth under the borders ---------------------------------- */

  // The map is 360 by 180, a degree to a unit, so a country's centre is its longitude and latitude.
  const lonOf = (d: any) => d.cx - 180
  const latOf = (d: any) => 90 - d.cy
  const maxPop = Math.max(...simData.map((d: any) => d.population))
  const places = new Float32Array(EARTH_PLACES * 3)
  simData.slice(0, EARTH_PLACES).forEach((d: any, i: number) => { places[i * 3] = lonOf(d); places[i * 3 + 1] = latOf(d); places[i * 3 + 2] = d.population / maxPop })
  const events = new Float32Array(EARTH_EVENTS * 4)
  let eventAt = 0
  const RAD = Math.PI / 180
  const sun = [0, 0]
  const startedAt = Date.now()
  const clockNow = () => performance.now() / 1000
  let drift = 0
  const earth = new ShaderSurface(document.getElementById('earth')!, EVERY_SECOND_FRAG, {
    textures: { u_land: '/deep-time/land.webp' },
    // Three-quarter resolution on a dense screen: the picture is soft by nature, and the frame rate is not.
    scale: devicePixelRatio > 1.5 ? 0.75 : 1,
    uniforms: () => ({ u_sun: sun, u_now: clockNow(), u_drift: drift, u_events: events, u_places: places }),
  })
  // Without WebGL2 the borders are the map, as they were.
  if (!earth.canvas.isConnected) document.getElementById('scene')!.classList.add('flat')
  // The ticker is parked under reduced motion: a light still comes on and goes off, in a few steps and not sixty a second.
  if (prefersReducedMotion) setInterval(() => earth.redraw(), 250)

  const feed = document.getElementById('feed')!
  let feedAt = 0
  function pulse(c: Live, kind: 'birth' | 'death') {
    // Somewhere in the country, not always its middle: further afield in a bigger one.
    const reach = 0.5 + 3.2 * Math.sqrt(c.d.population / maxPop)
    const k = eventAt++ % EARTH_EVENTS
    events[k * 4] = lonOf(c.d) + (Math.random() - 0.5) * 2 * reach
    events[k * 4 + 1] = latOf(c.d) + (Math.random() - 0.5) * 1.3 * reach
    events[k * 4 + 2] = clockNow()
    events[k * 4 + 3] = kind === 'birth' ? 1 : 2
    const el = c.els.country
    el.classList.remove('flash-birth', 'flash-death')
    void el.getBoundingClientRect() // restarts the animation even if it just fired
    el.classList.add(kind === 'birth' ? 'flash-birth' : 'flash-death')
    // Said in words too, but no faster than it can be read.
    const now = performance.now()
    if (now - feedAt > 450) {
      feedAt = now
      feed.textContent = (kind === 'birth' ? 'A birth in ' : 'A death in ') + c.d.name
      feed.dataset.kind = kind
    }
  }

  let births = 0
  let deaths = 0
  let restBirthAccum = 0
  let restDeathAccum = 0
  let speed = 1
  let simNow = 0
  let lastReal = performance.now()
  let paused = false

  /* ---- the shell ------------------------------------------------------ */

  const DAY = 86_400
  const SPEED_NAME: Record<string, string> = { '1': 'Live', '60': '1 hr/min', '1440': '1 day/min' }
  // Restart is a reload, the default. Pause and How to play stop the clock.
  const shell = createShell({
    slug: 'every-second',
    onPause: () => { paused = true },
    onResume: () => { paused = false; lastReal = performance.now() },
  })
  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumSignificantDigits: 3 })
  const short = (n: number) => (Math.abs(n) < 10_000 ? Math.round(n).toLocaleString('en-US') : compact.format(n))
  let shown = { births: 0, deaths: 0 }
  let ended = false

  // The strip rolls its digits, so it is told once a second; the count over
  // the map is the live one.
  function paintStrip() {
    const net = shown.births - shown.deaths
    shell.setScore(short(shown.births))
    shell.setMoves((net >= 0 ? '+' : '−') + short(Math.abs(net)))
    shell.setLevel(SPEED_NAME[String(speed)] ?? 'Live')
    if (shown.births > 0) shell.considerBest(shown.births, short(shown.births))
  }
  setInterval(paintStrip, 1000)

  function oneDay() {
    ended = true
    paintStrip()
    const net = shown.births - shown.deaths
    recordPlay('every-second', { births: shown.births, deaths: shown.deaths }, {})
    shell.levelUp('One day on Earth')
    // The map carries on; the card waits under it rather than pulling the
    // page away from what is still happening.
    shell.win({
      celebrate: false,
      scroll: false,
      kicker: 'One simulated day',
      title: `${fmt(net)} more people than yesterday.`,
      score: short(shown.births),
      lines: [
        `${fmt(shown.births)} born and ${fmt(shown.deaths)} died, in the forty countries on the map and the rest of the world together.`,
        'Tomorrow, about the same again.',
      ],
      againLabel: 'Watch another day',
    })
  }

  const fmt = (n: number) => Math.round(n).toLocaleString('en-US')
  const popValue = document.getElementById('popValue')!
  const birthCount = document.getElementById('birthCount')!
  const deathCount = document.getElementById('deathCount')!
  const netCount = document.getElementById('netCount')!

  let hoursTold = 0
  let lastShownAt = 0
  const clockEl = document.getElementById('clock')!
  const clockFmt = new Intl.DateTimeFormat(undefined, { timeZone: 'UTC', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false })
  let clockMinute = -1
  shell.progress(0)
  function frame(now: number) {
    requestAnimationFrame(frame)
    // Clamped so a backgrounded tab does not resume with an enormous dt and
    // spend the next frame processing a day of events at once.
    const dtReal = paused ? 0 : Math.min((now - lastReal) / 1000, 0.25)
    lastReal = now
    const dtSim = dtReal * speed
    simNow += dtSim
    // The Sun is wherever it is at the page's own instant, which runs ahead of the real one at speed.
    const at = new Date(startedAt + simNow * 1000)
    const ss = subsolar(at)
    sun[0] = ss.lon * RAD
    sun[1] = ss.lat * RAD
    drift += dtSim / 86_400 / 9 // weather goes round far more slowly than the day does
    const minute = Math.floor(+at / 60_000)
    if (minute !== clockMinute) { clockMinute = minute; clockEl.textContent = clockFmt.format(at) + ' UTC' }
    // At speed there are thousands a second: a few a frame is all that can be seen, and more is a white smear.
    const visualBudget = speed === 1 ? 24 : now - lastShownAt > 85 ? 1 : 0 // per-frame cap; about a dozen a second at speed
    // Which ones are shown is drawn fairly from all of them, or the first country in the list would get every light.
    const shownNow: [Live, 'birth' | 'death'][] = []
    let seen = 0 // the counters below are exact regardless of how many are shown

    for (const c of live) {
      while (c.nextBirthAt <= simNow) {
        births++
        seen++
        if (shownNow.length < visualBudget) shownNow.push([c, 'birth']); else if (visualBudget && Math.random() < visualBudget / seen) shownNow[Math.floor(Math.random() * visualBudget)] = [c, 'birth']
        c.nextBirthAt += nextInterval(c.d.bps, Math.random())
      }
      while (c.nextDeathAt <= simNow) {
        deaths++
        seen++
        if (shownNow.length < visualBudget) shownNow.push([c, 'death']); else if (visualBudget && Math.random() < visualBudget / seen) shownNow[Math.floor(Math.random() * visualBudget)] = [c, 'death']
        c.nextDeathAt += nextInterval(c.d.dps, Math.random())
      }
    }
    for (const [c, kind] of shownNow) pulse(c, kind)
    if (shownNow.length) lastShownAt = now
    restBirthAccum += restBps * dtSim
    restDeathAccum += restDps * dtSim

    const shownBirths = births + Math.floor(restBirthAccum)
    const shownDeaths = deaths + Math.floor(restDeathAccum)
    const net = shownBirths - shownDeaths
    const worldNow = worldPopulation + (restBps + live.reduce((s: number, c: any) => s + c.d.bps, 0)
      - restDps - live.reduce((s: number, c: any) => s + c.d.dps, 0)) * simNow

    popValue.textContent = fmt(worldNow)
    birthCount.textContent = fmt(shownBirths)
    deathCount.textContent = fmt(shownDeaths)
    netCount.textContent = (net >= 0 ? '+' : '') + fmt(net)
    shown = { births: shownBirths, deaths: shownDeaths }
    // Where people stop: whole simulated hours watched, told only as each one passes.
    const hours = Math.min(24, Math.floor(simNow / 3600))
    if (hours > hoursTold) shell.progress(hoursTold = hours)
    if (!ended && simNow >= DAY) oneDay()
  }
  requestAnimationFrame(frame)

  /* ---- speed toggle -------------------------------------------------- */
  const speedBtns = [...document.querySelectorAll<HTMLButtonElement>('.speed .opt')]
  for (const b of speedBtns) {
    b.addEventListener('click', () => {
      if (Number(b.dataset.speed) !== speed) shell.pick('Speed chosen', b.textContent!)
      speed = Number(b.dataset.speed)
      for (const o of speedBtns) o.setAttribute('aria-checked', String(o === b))
      paintStrip()
    })
  }

  /* ---- inspector ------------------------------------------------------- */
  const inspector = document.getElementById('inspector')!
  const inspectorName = document.getElementById('inspectorName')!
  const inspectorPop = document.getElementById('inspectorPop')!
  const inspectorBirth = document.getElementById('inspectorBirth')!
  const inspectorDeath = document.getElementById('inspectorDeath')!
  const inspectorBirthAvg = document.getElementById('inspectorBirthAvg')!
  const inspectorDeathAvg = document.getElementById('inspectorDeathAvg')!
  const hint = document.getElementById('hint')!

  function fmtInterval(seconds: number) {
    if (!Number.isFinite(seconds)) return 'never, in this data'
    if (seconds < 60) return `every ${seconds.toFixed(1)} seconds`
    if (seconds < 3600) return `every ${(seconds / 60).toFixed(1)} minutes`
    if (seconds < 86400) return `every ${(seconds / 3600).toFixed(1)} hours`
    return `every ${(seconds / 86400).toFixed(1)} days`
  }

  const inspected = new Set<number>()
  function openInspector(i: number) {
    const d = simData[i]
    if (!inspected.has(i)) { inspected.add(i); shell.pick('Country inspected', d.name) }
    inspectorName.textContent = d.name
    inspectorPop.textContent = fmt(d.population) + ' people'
    inspectorBirth.textContent = `${d.birthRate} per 1,000 people a year`
    inspectorDeath.textContent = `${d.deathRate} per 1,000 people a year`
    inspectorBirthAvg.textContent = d.bps > 0 ? fmtInterval(1 / d.bps) : 'never, in this data'
    inspectorDeathAvg.textContent = d.dps > 0 ? fmtInterval(1 / d.dps) : 'never, in this data'
    inspector.hidden = false
    hint.hidden = true
  }
  for (const [i, els] of byIndex) {
    els.country.addEventListener('click', () => openInspector(i))
    els.country.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openInspector(i) } })
  }
  document.getElementById('inspectorClose')!.addEventListener('click', () => {
    inspector.hidden = true
    hint.hidden = false
  })

  addEventListener('pointerdown', unlock, { once: true })
</script>

<style>
  /* The map is a night scene framed on the stage: the live count above it,
     the speed below, the map itself full width between them. */
  .es-scene {
    position: relative; overflow: hidden; color: #fff;
    display: grid; justify-items: center; gap: 12px;
    padding: 14px 10px 14px;
    border: 2px solid var(--ink); border-radius: var(--r-lg); background: #04070d;
  }

  /* The Earth is a canvas under the borders; the borders are only lines over it. */
  .mapwrap { position: relative; width: 100%; max-width: 1320px; aspect-ratio: 360 / 142; border-radius: 10px; overflow: hidden; background: #060c18; box-shadow: 0 0 0 1px rgb(140 170 220 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9); }
  .earth { position: absolute; inset: 0; }
  .earth :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  #map { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .country { fill: transparent; stroke: rgb(200 220 255 / 0.07); stroke-width: 0.18; }
  .country.sim { stroke: rgb(200 220 255 / 0.20); stroke-width: 0.22; cursor: pointer; }
  .country.sim:hover, .country.sim:focus-visible { fill: rgb(200 220 255 / 0.12); stroke: rgb(255 255 255 / 0.7); outline: none; }
  .country.sim.flash-birth { animation: flashCountryBirth 900ms ease-out; }
  .country.sim.flash-death { animation: flashCountryDeath 1100ms ease-out; }
  @keyframes flashCountryBirth {
    0% { fill: rgb(79 227 193 / 0.26); stroke: rgb(79 227 193 / 0.9); } 100% { fill: transparent; stroke: rgb(200 220 255 / 0.20); }
  }
  @keyframes flashCountryDeath {
    0% { fill: rgb(142 152 255 / 0.26); stroke: rgb(142 152 255 / 0.9); } 100% { fill: transparent; stroke: rgb(200 220 255 / 0.20); }
  }
  /* Without the Earth, the borders are the map, as they were. */
  .flat .country { fill: #16232e; stroke: #223140; }
  .flat .country.sim { fill: #1e3345; stroke: #2f4a60; }
  .es-marker { display: none; }

  .under { display: flex; gap: 6px 22px; flex-wrap: wrap; justify-content: center; align-items: baseline; font-size: 13px; min-height: 1.5em; }
  .clock { font-variant-numeric: tabular-nums; letter-spacing: 0.06em; opacity: 0.72; }
  .feed { opacity: 0.92; }
  .feed[data-kind='birth'] { color: #7cf0d6; }
  .feed[data-kind='death'] { color: #aab2ff; }

  .es-marker {
    fill: #6e879c;
    stroke: rgba(255, 255, 255, 0.25);
    stroke-width: 0.2;
    pointer-events: none;
  }
  .es-marker.flash-birth { animation: flashMarkerBirth 650ms ease-out; }
  .es-marker.flash-death { animation: flashMarkerDeath 900ms ease-out; }
  @keyframes flashMarkerBirth {
    0% { fill: #e9fff9; r: 3.4; } 100% { fill: #6e879c; r: 1.3; }
  }
  @keyframes flashMarkerDeath {
    0% { fill: #dfe3ff; r: 3; } 100% { fill: #6e879c; r: 1.3; }
  }

  .hud { order: -1; text-align: center; pointer-events: none; max-width: 100%; padding: 6px 12px 2px; }
  .pop-label { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.7; }
  .pop-value { font-family: var(--display); font-weight: 400; font-size: clamp(34px, 6.4vw, 64px); letter-spacing: -0.02em; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .rate-row { display: flex; gap: 14px; justify-content: center; margin-top: 6px; font-size: 13px; flex-wrap: wrap; }
  .rate i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }
  .rate.birth i { background: #4fe3c1; }
  .rate.death i { background: #8892e8; }
  .since { font-size: 12px; opacity: 0.6; margin-top: 3px; }

  .speed {
    display: flex; gap: 6px; background: rgba(255, 255, 255, 0.06); border-radius: 999px;
