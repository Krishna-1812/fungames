---
import GameLayout from '../layouts/GameLayout.astro'
import { SITE } from '../site.config'

/** Fusion resolves pairs from saved recipes, then the built-in table, then
 * the optional API. Personal discoveries stay on this device. */
const API = SITE.fusionApi
---

<GameLayout slug="fusion" bar="#241e4e" fixed bodyClass="fusion-body">
  <div class="stage">
    <h1 class="visually-hidden">Fusion</h1>
    <div class="board" id="board">
      {/* First child, so every piece appended later paints over it. */}
      <div class="field" id="field" aria-hidden="true"></div>
      <p class="tip" id="tip">Drag one thing onto another.</p>
    </div>

    <aside class="tray">
      <div class="tray-head">
        <strong id="found">4</strong> discovered
        <button type="button" id="reset" title="Start over">reset</button>
      </div>
      <input id="filter" type="search" placeholder="search…" aria-label="Filter elements" />
      <details class="recipe-controls">
        <summary>Combine without dragging</summary>
        <form id="recipeForm">
          <label for="firstIngredient">First element</label>
          <select id="firstIngredient" required></select>
          <label for="secondIngredient">Second element</label>
          <select id="secondIngredient" required></select>
          <button type="submit" id="combineButton">Combine elements</button>
          <p id="recipeStatus" role="status">Choose two discoveries. You can use the same element twice.</p>
        </form>
      </details>
      <div class="tray-list" id="tray"></div>
    </aside>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  </div>
</GameLayout>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ API })} />

  <script>
  import { burst, ring, floatText, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface } from '../lib/gl'
  import { pairKey as norm } from '../lib/fusion-pair.js'
  import { LOCAL } from '../lib/fusion-recipes.js'
  import { KEY, SEED, loadState, saveState, restoreState } from '../lib/fusion-state.js'
  import { FIELD_FRAG } from '../lib/fusion-field'
    const { API } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  const board = document.getElementById('board')
  const tray = document.getElementById('tray')
  const filter = document.getElementById('filter')
  const foundEl = document.getElementById('found')
  const toast = document.getElementById('toast')
  const tip = document.getElementById('tip')
  const firstIngredient = document.getElementById('firstIngredient') as HTMLSelectElement
  const secondIngredient = document.getElementById('secondIngredient') as HTMLSelectElement
  const recipeStatus = document.getElementById('recipeStatus')!
  const combineButton = document.getElementById('combineButton') as HTMLButtonElement
  let recipeBusy = false
  document.getElementById('reset').addEventListener('click', () => {
    if (confirm('Throw away every discovery?')) {
      try { localStorage.removeItem(KEY); location.reload() }
      catch { show('Could not reset saved discoveries on this device.') }
    }
  })

  let state
  // Accessing window.localStorage itself may throw in restricted contexts.
  try { state = loadState(localStorage) } catch { state = restoreState(null) }
  const save = () => {
    try { if (saveState(localStorage, state)) return } catch {}
    show('Your discoveries are safe for this session, but could not be saved on this device.')
  }

  function show(msg) {
    toast.textContent = msg
    toast.hidden = false
    clearTimeout(show.t)
    show.t = setTimeout(() => (toast.hidden = true), 2200)
  }

  /** Resolve a pair: memory -> local table -> edge worker. */
  async function combine(a, b) {
    const key = norm(a.text, b.text)
    if (state.recipes[key] && typeof state.recipes[key].text === 'string' && typeof state.recipes[key].emoji === 'string') return state.recipes[key]
    if (LOCAL[key]) {
      return (state.recipes[key] = LOCAL[key])
    }
    if (!API) return null
    try {
      const url = `${API}?first=${encodeURIComponent(a.text)}&second=${encodeURIComponent(b.text)}`
      const r = await fetch(url, { signal: AbortSignal.timeout(10_000) })
      if (!r.ok) throw new Error(String(r.status))
      const j = await r.json()
      if (!j || typeof j.result !== 'string' || !j.result.trim() || j.result.length > 60 || (j.emoji != null && typeof j.emoji !== 'string')) throw new Error('invalid recipe')
      return (state.recipes[key] = { text: j.result, emoji: j.emoji || '✨' })
    } catch {
      // No backend yet — say so plainly instead of inventing a result.
      return null
    }
  }

  // ---- the field ----------------------------------------------------------

  /* Board-space coordinates, matching what centred() builds in the shader:
     origin at the board's centre, units of half its short axis, y upward. */
  function fieldPos(el) {
    const b = board.getBoundingClientRect()
    const r = el.getBoundingClientRect()
    const m = Math.min(b.width, b.height) || 1
    return [
      (2 * (r.left + r.width / 2 - b.left) - b.width) / m,
      (b.height - 2 * (r.top + r.height / 2 - b.top)) / m,
    ]
  }

  let dragPos = [0, 0], dragOn = 0
  let bondPos = [0, 0], bondOn = 0

  /* The nearest other piece, and how strongly the filament should pull toward
     it.

     Deliberately proximity rather than overlap. The hit test only fires once
     two pieces are already touching, so a filament keyed to it could never be
     longer than it was wide -- it drew a blob, not a line. Keying it to
     distance means the link forms as you approach and goes taut as you arrive,
     which tells you which piece you are about to land on while you can still
     change your mind. */
  function bondTo(el) {
    const r = el.getBoundingClientRect()
    const cx = r.left + r.width / 2, cy = r.top + r.height / 2
    let best = null, bestD = Infinity
    for (const other of board.querySelectorAll('.piece')) {
      if (other === el || other.disabled) continue
      const o = other.getBoundingClientRect()
      const d = Math.hypot(o.left + o.width / 2 - cx, o.top + o.height / 2 - cy)
      if (d < bestD) { bestD = d; best = other }
    }
    if (!best) return { on: 0, pos: [0, 0] }
    // Fades in over roughly one piece-width of approach.
    const k = Math.max(0, Math.min(1, (230 - bestD) / 130))
    return { on: k * k * (3 - 2 * k), pos: fieldPos(best) }
  }
  let flashPos = [0, 0], flashAt = -1e6, flashNew = 0

  const field = new ShaderSurface(document.getElementById('field'), FIELD_FRAG, {
    // The nebula is the expensive layer and has no edges worth resolving.
    scale: 0.7,
    uniforms: () => ({
      u_drag: dragPos,
      u_dragOn: dragOn,
      u_bond: bondPos,
      u_bondOn: bondOn,
      u_flash: flashPos,
      u_flashT: (performance.now() - flashAt) / 1000,
      u_flashNew: flashNew,
      // Four starters is an empty board; forty-odd things is a world.
      u_rich: Math.min(1, Math.max(0, (state.items.length - SEED.length) / 40)),
      u_motion: prefersReducedMotion ? 0 : 1,
    }),
  })

  /* Under reduced motion the shared ticker never runs, so the field has to be
     asked for the frames that matter: a drag moving, and a merge landing. */
  function nudgeField() { if (prefersReducedMotion) field.redraw() }

  // ---- board pieces -------------------------------------------------------
  let dragging = null
  let offset = { x: 0, y: 0 }

  function spawn(item, x, y) {
    const el = document.createElement('button')
    el.type = 'button'
    el.className = 'piece'
    el.textContent = `${item.emoji} ${item.text}`
    el.dataset.text = item.text
    el.dataset.emoji = item.emoji
    el.style.left = x + 'px'
    el.style.top = y + 'px'
    board.appendChild(el)
    return el
  }

  board.addEventListener('pointerdown', (e) => {
    const el = e.target.closest('.piece')
    if (!el || el.disabled) return
    unlock(); sfx.tick()
    dragging = el
    const r = el.getBoundingClientRect()
    const b = board.getBoundingClientRect()
    offset = { x: e.clientX - r.left, y: e.clientY - r.top }
    // Can throw if the pointer is already gone by the time this runs, which
    // takes the whole drag down with it. Powder already guards the same call.
    try { el.setPointerCapture(e.pointerId) } catch {}
    el.classList.add('held')
    dragOn = 1
    dragPos = fieldPos(el)
    const b0 = bondTo(el)
    bondOn = b0.on
    bondPos = b0.pos
    nudgeField()
    // Raise it above its siblings while held.
    board.appendChild(el)
    tip.hidden = true
    e.preventDefault()
  })

  board.addEventListener('pointermove', (e) => {
    if (!dragging) return
    const b = board.getBoundingClientRect()
    const clamp = (v, max) => Math.max(0, Math.min(max, v))
    dragging.style.left = clamp(e.clientX - b.left - offset.x, b.width - dragging.offsetWidth) + 'px'
    dragging.style.top = clamp(e.clientY - b.top - offset.y, b.height - dragging.offsetHeight) + 'px'
    // Highlight whatever we are hovering over.
    const target = hitTest(dragging)
    board.querySelectorAll('.piece.target').forEach((p) => p.classList.remove('target'))
    if (target) target.classList.add('target')

    dragPos = fieldPos(dragging)
    const bond = bondTo(dragging)
    bondOn = bond.on
    bondPos = bond.pos
    nudgeField()
  })

  function hitTest(el) {
    const a = el.getBoundingClientRect()
    for (const other of board.querySelectorAll('.piece')) {
      if (other === el || other.disabled) continue
      const b = other.getBoundingClientRect()
      const overlap =
        a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top
      if (overlap) return other
    }
    return null
  }

  async function drop(e) {
    if (!dragging) return
    const el = dragging
    dragging = null
    el.classList.remove('held')
    dragOn = 0
    bondOn = 0
    nudgeField()
    const target = hitTest(el)
    board.querySelectorAll('.piece.target').forEach((p) => p.classList.remove('target'))
    if (!target) return

    await mergePieces(el, target)
  }

  async function mergePieces(el, target) {
    if (el.disabled || target.disabled || el === target) return null

    const a = { text: el.dataset.text, emoji: el.dataset.emoji }
    const b = { text: target.dataset.text, emoji: target.dataset.emoji }
    const left = parseFloat(target.style.left)
    const top = parseFloat(target.style.top)

    el.disabled = target.disabled = true
    target.classList.add('working')
    const res = await combine(a, b)
    target.classList.remove('working')
    el.disabled = target.disabled = false

    if (!res) {
      sfx.bad()
      show(`No recipe for ${a.text} + ${b.text} yet. Try a different pair.`)
      return null
    }

    el.remove()
    target.remove()
    const made = spawn(res, left, top)
    made.classList.add('pop')

    const isNew = !state.items.some((i) => i.text.toLowerCase() === res.text.toLowerCase())
    const br = made.getBoundingClientRect()
    const cx = br.left + br.width / 2, cy = br.top + br.height / 2

    // The shockwave goes off where the two things actually met.
    flashPos = fieldPos(made)
    flashNew = isNew ? 1 : 0
    flashAt = performance.now()
    nudgeField()
    if (isNew) {
      sfx.great()
      ring(cx, cy, '#ffd166', 22)
      burst(cx, cy, { count: 26, colors: ['#ffd166', '#c04cfd', '#fff'], speed: 4.5, gravity: 0.1, life: 48, size: 4 })
      floatText(cx, cy - 26, 'new!', '#ffd166')
    } else {
      sfx.pop(state.items.length % 10)
      burst(cx, cy, { count: 10, colors: ['#c04cfd', '#fff'], speed: 3, gravity: 0.12, life: 28, size: 3 })
    }
    if (isNew) {
      state.items.push(res)
      show(`First time discovering ${res.emoji} ${res.text}`)
      made.classList.add('fresh')
    }
    save()
    renderTray()
    return made
  }
  board.addEventListener('pointerup', drop)
  board.addEventListener('pointercancel', () => {
    dragging?.classList.remove('held')
    dragging = null
    dragOn = bondOn = 0
    board.querySelectorAll('.piece.target').forEach((p) => p.classList.remove('target'))
    nudgeField()
  })

  // ---- tray ---------------------------------------------------------------
  function refreshIngredients() {
    for (const [index, select] of [firstIngredient, secondIngredient].entries()) {
      const previous = select.value
      select.replaceChildren(...state.items.map(item => {
        const option = document.createElement('option')
        option.value = item.text; option.textContent = `${item.emoji} ${item.text}`
        return option
      }))
      select.value = state.items.some(item => item.text === previous) ? previous : state.items[Math.min(index, state.items.length - 1)].text
    }
  }
  document.getElementById('recipeForm')!.addEventListener('submit', async e => {
    e.preventDefault()
    if (recipeBusy) return
    const a = state.items.find(item => item.text === firstIngredient.value)
    const b = state.items.find(item => item.text === secondIngredient.value)
    if (!a || !b) return
    recipeBusy = true; combineButton.disabled = true
    firstIngredient.disabled = secondIngredient.disabled = true
    recipeStatus.textContent = `Combining ${a.text} and ${b.text}…`
    unlock(); tip.hidden = true
    const bounds = board.getBoundingClientRect()
    const x = Math.max(8, bounds.width / 2 - 70), y = Math.max(8, bounds.height / 2 - 25)
    const first = spawn(a, x, y), second = spawn(b, x, y)
    try {
      const made = await mergePieces(first, second)
      if (made) recipeStatus.textContent = `${a.text} + ${b.text} = ${made.dataset.text}. Ready for another pair.`
      else {
        first.remove(); second.remove()
        recipeStatus.textContent = `No recipe for ${a.text} + ${b.text} yet. Try another pair.`
      }
    } catch {
      first.remove(); second.remove()
      recipeStatus.textContent = 'Could not complete this combination. Please try again.'
    } finally {
      recipeBusy = false; combineButton.disabled = false
      firstIngredient.disabled = secondIngredient.disabled = false
      if (document.activeElement === document.body) combineButton.focus({ preventScroll: true })
    }
  })
  function renderTray() {
    const q = filter.value.trim().toLowerCase()
    const items = state.items.filter((i) => !q || i.text.toLowerCase().includes(q))
    tray.replaceChildren(
      ...items.map((item) => {
        const b = document.createElement('button')
        b.type = 'button'
        b.className = 'chip'
        b.textContent = `${item.emoji} ${item.text}`
        b.addEventListener('click', () => {
          const r = board.getBoundingClientRect()
          spawn(item, Math.random() * (r.width - 160) + 20, Math.random() * (r.height - 90) + 20)
          tip.hidden = true
        })
        return b
      })
    )
    foundEl.textContent = String(state.items.length)
    refreshIngredients()
  }
  filter.addEventListener('input', renderTray)

  renderTray()
  // Put the four starters on the board so the first move is obvious. Spread
  // them across whatever width is actually available rather than a fixed pitch,
  // which pushed the last one off-screen on narrow boards.
  //
  // This deliberately does not use requestAnimationFrame: rAF is paused in
  // background tabs, so a page opened in one and switched to later would show
  // an empty board. Seed immediately if the board has been laid out, and
  // otherwise wait for the first resize that gives it a size.
  function seedBoard() {
    const r = board.getBoundingClientRect()
    if (r.width < 40 || r.height < 40) return false
    const PIECE_W = 96
    const usable = Math.max(PIECE_W, r.width - PIECE_W - 24)
    SEED.forEach((s, i) => {
      const x = 12 + (usable * i) / Math.max(1, SEED.length - 1)
      // Stagger vertically so a cramped board does not overlap the starters.
      const y = r.height / 2 - 20 + (i % 2 ? 34 : -34)
      spawn(s, x, Math.max(12, y))
    })
    return true
  }

  if (!seedBoard() && 'ResizeObserver' in window) {
    const ro = new ResizeObserver(() => { if (seedBoard()) ro.disconnect() })
    ro.observe(board)
  }
</script>

<!-- .piece / .chip are created in JS, and JS-created nodes do not get Astro's
     scoped-style attribute, so these rules must be global. -->
<style is:global>
  .recipe-controls { margin: 0 12px 10px; border: 1px solid #51457e; border-radius: 10px; background: #211b43; overflow-y: auto; flex-shrink: 0; max-height: 50%; }
  .recipe-controls summary { padding: 10px; cursor: pointer; font-size: 12px; color: #e7dbff; }
  #recipeForm { display: grid; gap: 7px; padding: 0 10px 10px; }
  #recipeForm label { font-size: 12px; color: #c9bde5; }
  #recipeForm select, #recipeForm button { width: 100%; min-width: 0; padding: 9px; border-radius: 7px; border: 1px solid #685b94; color: #fff; background: #302751; font: inherit; font-size: 13px; }
  #recipeForm button { cursor: pointer; background: #ded0ff; color: #241d3b; font-weight: 600; }
  #recipeForm button:disabled { opacity: .65; cursor: wait; }
  #recipeStatus { font-size: 12px; line-height: 1.5; color: #dacdea; margin: 2px 0; }
  .stage { position: relative; height: 100%; display: flex; background: #16122e; color: #fff; }

  .board { position: relative; flex: 1; overflow: hidden; touch-action: none; }
  /* The still fallback, for anything without WebGL2. */
  .field {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(120% 80% at 50% 100%, #241a4c 0%, transparent 62%),
      #16122e;
  }
  .field .gl-surface { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .tip {
    position: absolute; inset: auto 0 24px 0; text-align: center;
    opacity: 0.62; font-size: 15px; margin: 0;
  }

  .piece {
    position: absolute;
    /* A tile with a top face, rather than a rectangle with a border. */
    background: linear-gradient(180deg, #fcfaff 0%, #e4ddf8 100%);
    color: #1a1533;
    border: 1px solid rgba(255, 255, 255, 0.55); border-radius: 11px;
    padding: 8px 14px; font-size: 15px; font-weight: 500;
    cursor: grab; user-select: none; white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(80, 60, 140, 0.20),
      0 1px 2px rgba(5, 2, 20, 0.55),
      0 7px 16px rgba(5, 2, 20, 0.34);
    transition: transform 140ms var(--ease), box-shadow 180ms var(--ease);
  }
  .piece.held {
    cursor: grabbing; z-index: 5;
    transform: scale(1.06) rotate(-0.7deg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 18px 34px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(192, 76, 253, 0.55);
  }
  /* A ring and a glow rather than a 2px outline: it has to read at a glance,
     mid-drag, while the filament in the field is already pointing at it. */
  .piece.target {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 2px 6px rgba(5, 2, 20, 0.5),
      0 0 0 2px #c04cfd,
      0 0 24px rgba(192, 76, 253, 0.8);
  }
  /* A sweep, not opacity. Fading a light tile toward a dark board takes its
     text down with it, and this state is on screen while a request is in
     flight -- exactly when it should still be readable. */
  .piece.working {
    background:
      linear-gradient(100deg, transparent 36%, rgba(192, 76, 253, 0.35) 50%, transparent 64%),
      linear-gradient(180deg, #fcfaff 0%, #e4ddf8 100%);
    background-size: 300% 100%, 100% 100%;
    animation: workSweep 900ms linear infinite;
  }
  @keyframes workSweep { from { background-position: 150% 0, 0 0; } to { background-position: -150% 0, 0 0; } }
  .piece.fresh {
    background: linear-gradient(180deg, #fff8db 0%, #f7e6a4 100%);
    border-color: rgba(255, 240, 190, 0.8);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 1px 2px rgba(5, 2, 20, 0.55),
      0 7px 16px rgba(5, 2, 20, 0.34),
      0 0 26px rgba(255, 209, 102, 0.45);
  }
  .piece.pop { animation: pop 380ms var(--ease-bounce); }
  @keyframes pop { from { transform: scale(0.6); opacity: 0; } }

  .tray {
    width: 260px; flex: none; display: flex; flex-direction: column;
    background: #1e1940; border-left: 1px solid #322a5e;
  }
  .tray-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; font-size: 13px; opacity: 0.85; border-bottom: 1px solid #322a5e;
  }
  .tray-head button {
    background: none; border: 1px solid #4a3f80; color: inherit;
    border-radius: 8px; padding: 3px 10px; font-size: 12px; cursor: pointer;
    transition: transform 180ms var(--ease-bounce), background 140ms var(--ease);
  }
  .tray-head button:hover { transform: scale(1.06); background: #322a5e; }
  .tray-head button:active { transform: scale(0.94); }
  #filter {
    margin: 10px 12px; padding: 8px 10px; border-radius: 8px;
    border: 1px solid #3b3270; background: #16122e; color: #fff; font: inherit; font-size: 14px;
  }
  .tray-list { flex: 1; overflow-y: auto; padding: 0 12px 16px; display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
  .chip {
    background: #2b2456; border: 1px solid #3d3470; color: #fff;
    border-radius: 8px; padding: 6px 10px; font-size: 13px; cursor: pointer;
    transition: background 140ms var(--ease), transform 180ms var(--ease-bounce);
  }
  .chip:hover { background: #3a3170; transform: translateY(-1px) scale(1.05); }
  .chip:active { transform: scale(0.95); }

  .toast {
    position: absolute; left: 50%; top: 18px; transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.75); padding: 10px 18px; border-radius: 999px;
    font-size: 14px; max-width: 80vw; text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .piece { transition: none; }
    .piece.working { animation: none; }
    .piece.pop { animation: none; }
  }

  @media (max-width: 760px) {
    .stage { flex-direction: column; }
    .tray { width: auto; height: 42%; border-left: 0; border-top: 1px solid #322a5e; }
  }
</style>
