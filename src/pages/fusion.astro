---
import GameShell from '../layouts/GameShell.astro'
import { SITE } from '../site.config'
import { FUSION_ART, elementSvg } from '../lib/fusion-art'
import { LOCAL } from '../lib/fusion-recipes.js'
import { SEED } from '../lib/fusion-state.js'

/** Fusion resolves pairs from saved recipes, then the built-in table, then
 * the optional API. Personal discoveries stay on this device.
 *
 * In the shell the board is the stage, framed rather than filling the window.
 * Score is how much of the built-in tree you have discovered, This visit the
 * new ones since the page opened, Merges every successful combination, and
 * Best the most you have ever had at once (it survives the tray's reset).
 * Discovering the whole built-in tree is the ending. Restart tidies the board
 * back to the four starters and keeps every discovery; throwing discoveries
 * away is still the tray's own reset. A new discovery glows mint rather than
 * gold. */
const API = SITE.fusionApi

/** Everything the built-in table can make, plus the four you start with. */
const TREE = [...new Set([...SEED.map((s) => s.text), ...Object.values(LOCAL).map((r) => r.text)])]

/* Every element in the tree, drawn. Serialised into the page once rather
   than imported by the client module, because the board builds its pieces
   at runtime and needs the markup as data. */
const toneOf = (name: string) => /fill="(#[0-9a-fA-F]{6})"/.exec(FUSION_ART[name].draw())?.[1] ?? '#8f7bd8'
const ART_BY_NAME = Object.fromEntries(
  Object.keys(FUSION_ART).map((name) => [name, { svg: elementSvg(name), tone: toneOf(name) }]),
)
---

<GameShell
  slug="fusion"
  labels={{ score: 'Discovered', best: 'Most found', level: 'This visit', moves: 'Merges' }}
  initial={{ score: `${SEED.length} / ${TREE.length}`, level: '0', moves: '0' }}
>
  <div class="fusion-body">
    <div class="board" id="board">
      {/* First child, so every piece appended later paints over it. */}
      <div class="field" id="field" aria-hidden="true"></div>
      <p class="tip" id="tip">Drag one thing onto another — or throw it.</p>
    </div>

    <aside class="tray">
      <div class="tray-head">
        <strong id="found">4</strong> discovered
        <button type="button" id="reset" title="Start over">reset</button>
      </div>
      <input id="filter" type="search" placeholder="search…" aria-label="Filter elements" />
      <details class="recipe-controls">
        <summary>Combine without dragging</summary>
        <form id="recipeForm">
          <label for="firstIngredient">First element</label>
          <select id="firstIngredient" required></select>
          <label for="secondIngredient">Second element</label>
          <select id="secondIngredient" required></select>
          <button type="submit" id="combineButton">Combine elements</button>
          <p id="recipeStatus" role="status">Choose two discoveries. You can use the same element twice.</p>
        </form>
      </details>
      <div class="tray-list" id="tray"></div>
    </aside>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  </div>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="art-data" set:html={JSON.stringify(ART_BY_NAME)} />
  <script type="application/json" id="game-data" set:html={JSON.stringify({ API, TREE })} />

  <Fragment slot="howto">
    <p>
      Start with water, fire, earth and wind. Drag one thing onto another and
      see what the two of them make.
    </p>
    <ul>
      <li>Everything you discover goes in the tray. Tap it there to put another one on the board.</li>
      <li>Two of the same thing can combine too.</li>
      <li>Rather not drag? "Combine without dragging" in the tray takes any two discoveries from a list.</li>
      <li>Restart clears the board back to the four starters. Your discoveries stay; the tray's reset is what throws them away.</li>
    </ul>
    <p>Discover everything in the tree to finish.</p>
  </Fragment>
</GameShell>

  <script>
  import { burst, ring, floatText } from '../lib/fx'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface } from '../lib/gl'
  import { pairKey as norm } from '../lib/fusion-pair.js'
  import { LOCAL } from '../lib/fusion-recipes.js'
  import { KEY, SEED, loadState, saveState, restoreState } from '../lib/fusion-state.js'
  import { FIELD_FRAG } from '../lib/fusion-field'
  import { UNKNOWN_MARK } from '../lib/fusion-art'
  import { World } from '../lib/fusion-physics'
  const prefersReducedMotion = !PLAY
  const { API, TREE } = JSON.parse(document.getElementById('game-data')!.textContent!) as { API: string; TREE: string[] }
  // Restart tidies the board; discoveries are kept.
  const shell = createShell({
    slug: 'fusion',
    onRestart: () => {
      for (const p of [...board.querySelectorAll('.piece')]) unspawn(p)
      seedBoard()
      tip.hidden = false
    },
  })
  let newThisVisit = 0
  let merges = 0
  let ended = false
  const ART = JSON.parse(document.getElementById('art-data')!.textContent!) as Record<string, { svg: string; tone: string }>
  const UNKNOWN = UNKNOWN_MARK

  const board = document.getElementById('board')
  const tray = document.getElementById('tray')
  const filter = document.getElementById('filter')
  const foundEl = document.getElementById('found')
  const toast = document.getElementById('toast')
  const tip = document.getElementById('tip')
  const firstIngredient = document.getElementById('firstIngredient') as HTMLSelectElement
  const secondIngredient = document.getElementById('secondIngredient') as HTMLSelectElement
  const recipeStatus = document.getElementById('recipeStatus')!
  const combineButton = document.getElementById('combineButton') as HTMLButtonElement
  let recipeBusy = false
  document.getElementById('reset').addEventListener('click', () => {
    if (confirm('Throw away every discovery?')) {
      try { localStorage.removeItem(KEY); location.reload() }
      catch { show('Could not reset saved discoveries on this device.') }
    }
  })

  let state
  // Accessing window.localStorage itself may throw in restricted contexts.
  try { state = loadState(localStorage) } catch { state = restoreState(null) }
  const save = () => {
    try { if (saveState(localStorage, state)) return } catch {}
    show('Your discoveries are safe for this session, but could not be saved on this device.')
  }

  function show(msg) {
    toast.textContent = msg
    toast.hidden = false
    clearTimeout(show.t)
    show.t = setTimeout(() => (toast.hidden = true), 2200)
  }

  /** Resolve a pair: memory -> local table -> edge worker. */
  async function combine(a, b) {
    const key = norm(a.text, b.text)
    if (state.recipes[key] && typeof state.recipes[key].text === 'string') return state.recipes[key]
    if (LOCAL[key]) {
      return (state.recipes[key] = LOCAL[key])
    }
    if (!API) return null
    try {
      const url = `${API}?first=${encodeURIComponent(a.text)}&second=${encodeURIComponent(b.text)}`
      const r = await fetch(url, { signal: AbortSignal.timeout(10_000) })
      if (!r.ok) throw new Error(String(r.status))
      const j = await r.json()
      if (!j || typeof j.result !== 'string' || !j.result.trim() || j.result.length > 60) throw new Error('invalid recipe')
      // Any emoji the pair API sends is ignored: an element invented at runtime
      // gets UNKNOWN_MARK, not somebody else’s artwork.
      return (state.recipes[key] = { text: j.result })
    } catch {
      // No backend yet — say so plainly instead of inventing a result.
      return null
    }
  }

  // ---- the field ----------------------------------------------------------

  /* Board-space coordinates, matching what centred() builds in the shader:
     origin at the board's centre, units of half its short axis, y upward. */
  function fieldPos(b) {
    const m = Math.min(world.w, world.h) || 1
    return [(2 * b.x - world.w) / m, (world.h - 2 * b.y) / m]
  }

  let dragPos = [0, 0], dragOn = 0
  let bondPos = [0, 0], bondOn = 0

  /* The nearest other token, and how strongly the filament should pull toward
     it. Proximity rather than overlap: the link forms as you approach and goes
     taut as you arrive, which tells you which one you are about to land on
     while you can still change your mind. */
  function bondTo(b) {
    const n = world.nearest(b)
    if (!n) return { on: 0, pos: [0, 0] }
    const k = Math.max(0, Math.min(1, (n.body.r * 5.5 - n.d) / (n.body.r * 3)))
    return { on: k * k * (3 - 2 * k), pos: fieldPos(n.body) }
  }
  let flashPos = [0, 0], flashAt = -1e6, flashNew = 0

  const field = new ShaderSurface(document.getElementById('field'), FIELD_FRAG, {
    // The nebula is the expensive layer and has no edges worth resolving.
    scale: 0.7,
    uniforms: () => ({
      u_drag: dragPos,
      u_dragOn: dragOn,
      u_bond: bondPos,
      u_bondOn: bondOn,
      u_flash: flashPos,
      u_flashT: (performance.now() - flashAt) / 1000,
      u_flashNew: flashNew,
      // Four starters is an empty board; forty-odd things is a world.
      u_rich: Math.min(1, Math.max(0, (state.items.length - SEED.length) / 40)),
      u_motion: prefersReducedMotion ? 0 : 1,
    }),
  })

  /* Under reduced motion the shared ticker never runs, so the field has to be
     asked for the frames that matter: a drag moving, and a merge landing. */
  function nudgeField() { if (prefersReducedMotion) field.redraw() }

  // ---- the bench ------------------------------------------------------------
  /* Every token is a body in lib/fusion-physics: a puck on an air table. The
     page's part is the hand (pointer events), putting each element where its
     body is once a frame, and deciding which collisions are fusions — a token
     set down on another, or one thrown into another. A knock is only a knock. */
  const world = new World()
  if (prefersReducedMotion) world.drag = 9
  const bodyOf = new Map()
  const elOf = new Map()
  const MAX_ON_BOARD = 40
  const radius = () => (board.clientWidth < 560 ? 36 : board.clientWidth < 900 ? 44 : 50)
  const sizeWorld = () => { world.resize(board.clientWidth, board.clientHeight); wake() }
  new ResizeObserver(sizeWorld).observe(board)
  world.resize(board.clientWidth, board.clientHeight)

  const place = (el, b) => { el.style.transform = `translate3d(${(b.x - b.r).toFixed(1)}px,${(b.y - b.r).toFixed(1)}px,0)` }

  function spawn(item, x, y) {
    const r = radius()
    const el = document.createElement('button')
    el.type = 'button'
    el.className = 'piece'
    // A drawing and a label, not one string with a picture character in it.
    // Unknown elements (anything a deployed pair API invents at runtime) get
    // the neutral mark rather than an emoji: see UNKNOWN_MARK in lib/fusion-art.
    const art = ART[item.text]
    el.innerHTML =
      `<span class="orb"><span class="pic" aria-hidden="true">${art?.svg ?? UNKNOWN}</span>` +
      `<span class="lbl"></span></span>`
    el.querySelector('.lbl').textContent = item.text
    el.dataset.text = item.text
    el.style.setProperty('--d', r * 2 + 'px')
    el.style.setProperty('--tone', art?.tone ?? '#8f7bd8')
    const b = world.add(
      Math.max(r, Math.min(world.w - r, x)), Math.max(r, Math.min(world.h - r, y)), r)
    bodyOf.set(el, b)
    elOf.set(b, el)
    place(el, b)
    board.appendChild(el)
    // A crowded bench loses its oldest token, not its newest.
    if (bodyOf.size > MAX_ON_BOARD) {
      const old = world.bodies.find((o) => !o.held && !o.frozen && o !== b)
      if (old) unspawn(elOf.get(old))
    }
    wake()
    return el
  }

  function unspawn(el) {
    const b = bodyOf.get(el)
    if (b) { world.remove(b); elOf.delete(b) }
    bodyOf.delete(el)
    if (dragging === el) dragging = null
    el.remove()
  }

  // ---- the loop: runs while anything is moving, sleeps when the bench is still
  let raf = 0, lastT = 0, lastKnock = 0, fusing = 0
  function wake() {
    if (raf) return
    lastT = performance.now()
    raf = requestAnimationFrame(frame)
  }
  function frame(now) {
    raf = 0
    const hits = world.advance((now - lastT) / 1000)
    lastT = now
    for (const h of hits) {
      const thrower = h.a.thrown > 0 ? h.a : h.b.thrown > 0 ? h.b : null
      if (thrower) {
        // Thrown into something: that is a fusion, if the two will fuse.
        thrower.thrown = 0
        mergePieces(elOf.get(thrower), elOf.get(thrower === h.a ? h.b : h.a))
      } else if (h.speed > 170 && now - lastKnock > 80) {
        lastKnock = now
        sfx.tick()
      }
    }
    for (const [el, b] of bodyOf) if (!b.frozen) place(el, b)
    if (dragging) {
      const b = bodyOf.get(dragging)
      dragPos = fieldPos(b)
      const bond = bondTo(b)
      bondOn = bond.on
      bondPos = bond.pos
      const u = world.under(b)
      const t = u ? elOf.get(u) : null
      for (const p of board.querySelectorAll('.piece.target')) if (p !== t) p.classList.remove('target')
      if (t) t.classList.add('target')
      nudgeField()
    }
    if (dragging || fusing || world.energy() > 0.4) wake()
  }

  // ---- the hand ----------------------------------------------------------------
  let dragging = null
  let grab = { x: 0, y: 0 }
  const local = (e) => { const r = board.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top } }

  board.addEventListener('pointerdown', (e) => {
    const el = e.target.closest('.piece')
    const b = el && bodyOf.get(el)
    if (!b || b.frozen) return
    unlock(); sfx.tick()
    dragging = el
    const p = local(e)
    grab = { x: b.x - p.x, y: b.y - p.y }
    world.grab(b, b.x, b.y)
    // Can throw if the pointer is already gone by the time this runs, which
    // takes the whole drag down with it. Powder already guards the same call.
    try { el.setPointerCapture(e.pointerId) } catch {}
    el.classList.add('held')
    el.classList.remove('fresh')
    dragOn = 1
    // Raise it above its siblings while held.
    board.appendChild(el)
    tip.hidden = true
    wake()
    e.preventDefault()
  })

  board.addEventListener('pointermove', (e) => {
    const b = dragging && bodyOf.get(dragging)
    if (!b) return
    const p = local(e)
    b.tx = Math.max(b.r, Math.min(world.w - b.r, p.x + grab.x))
    b.ty = Math.max(b.r, Math.min(world.h - b.r, p.y + grab.y))
    wake()
  })

  function letGo() {
    const el = dragging
    dragging = null
    dragOn = bondOn = 0
    board.querySelectorAll('.piece.target').forEach((p) => p.classList.remove('target'))
    nudgeField()
    if (!el) return null
    el.classList.remove('held')
    const b = bodyOf.get(el)
    if (b) world.release(b)
    wake()
    return el
  }

  board.addEventListener('pointerup', () => {
    const el = letGo()
    const b = el && bodyOf.get(el)
    if (!b) return
    // Set down on another: fuse them. Otherwise it coasts, and may yet hit one.
    const u = world.under(b)
    if (u) { b.thrown = 0; mergePieces(el, elOf.get(u)) }
  })
  board.addEventListener('pointercancel', letGo)

  const wait = (ms) => new Promise((r) => setTimeout(r, ms))

  async function mergePieces(el, target) {
    const A = el && bodyOf.get(el), B = target && bodyOf.get(target)
    if (!A || !B || A.frozen || B.frozen || el === target) return null

    const a = { text: el.dataset.text }
    const b = { text: target.dataset.text }
    // They are drawn together to where they will fuse: nearer the heavier.
    const mx = (A.x * A.m + B.x * B.m) / (A.m + B.m), my = (A.y * A.m + B.y * B.m) / (A.m + B.m)
    const from = { ax: A.x, ay: A.y, bx: B.x, by: B.y }
    A.frozen = B.frozen = true
    A.held = false
    fusing++
    el.classList.add('fusing')
    target.classList.add('fusing', 'working')
    A.x = B.x = mx; A.y = B.y = my
    place(el, A); place(target, B)
    const [res] = await Promise.all([combine(a, b), wait(prefersReducedMotion ? 0 : 190)])
    fusing--
    target.classList.remove('working')

    if (!res) {
      // They will not fuse: they spring apart again.
      el.classList.remove('fusing'); target.classList.remove('fusing')
      A.frozen = B.frozen = false
      A.x = from.ax; A.y = from.ay; B.x = from.bx; B.y = from.by
      const dx = A.x - B.x || 1, dy = A.y - B.y, d = Math.hypot(dx, dy) || 1
      A.vx = (dx / d) * 260; A.vy = (dy / d) * 260
      B.vx = (-dx / d) * 120; B.vy = (-dy / d) * 120
      wake()
      sfx.bad()
      show(`No recipe for ${a.text} + ${b.text} yet. Try a different pair.`)
      return null
    }

    unspawn(el)
    unspawn(target)
    const made = spawn(res, mx, my)
    made.classList.add('pop')

    const isNew = !state.items.some((i) => i.text.toLowerCase() === res.text.toLowerCase())
    merges++
    if (isNew) newThisVisit++
    // The release of energy shoves everything nearby outwards.
    if (!prefersReducedMotion) world.blast(mx, my, isNew ? 15000 : 8000, 300, bodyOf.get(made))
    const br = board.getBoundingClientRect()
    const cx = br.left + mx, cy = br.top + my

    // The shockwave goes off where the two things actually met.
    flashPos = fieldPos(bodyOf.get(made))
    flashNew = isNew ? 1 : 0
    flashAt = performance.now()
    nudgeField()
    if (isNew) {
      sfx.great()
      ring(cx, cy, '#4fe3c1', 22)
      burst(cx, cy, { count: 26, colors: ['#4fe3c1', '#c04cfd', '#fff'], speed: 4.5, gravity: 0.1, life: 48, size: 4 })
      floatText(cx, cy - 56, 'new!', '#4fe3c1')
    } else {
      sfx.pop(state.items.length % 10)
      burst(cx, cy, { count: 10, colors: ['#c04cfd', '#fff'], speed: 3, gravity: 0.12, life: 28, size: 3 })
    }
    if (isNew) {
      state.items.push(res)
      // For the crowd: every first discovery, and how far into the tree it leaves people.
      shell.pick('Element discovered', res.text)
      shell.progress(treeFound())
      show(`First time discovering ${res.text}`)
      made.classList.add('fresh')
    }
    save()
    renderTray()
    if (isNew) maybeFinish(res.text)
    return made
  }

  /** How much of the built-in tree is in the tray. Things a pair API invents
      are discoveries too, but they are not in the tree, so they cannot be
      what stands between anybody and the end. */
  function treeFound() {
    const have = new Set(state.items.map((i) => i.text.toLowerCase()))
    return TREE.filter((t) => have.has(t.toLowerCase())).length
  }
  function paintStrip() {
    shell.setScore(`${treeFound()} / ${TREE.length}`)
    shell.setLevel(String(newThisVisit))
    shell.setMoves(String(merges))
    shell.considerBest(state.items.length, String(state.items.length))
  }
  function maybeFinish(last) {
    if (ended || treeFound() < TREE.length) return
    ended = true
    shell.win({
      kicker: 'The whole tree',
      title: 'Everything, discovered.',
      score: `${TREE.length} / ${TREE.length}`,
      lines: [
        `The last one was ${last}. It took ${merges} merge${merges === 1 ? '' : 's'} this visit.`,
        'Your discoveries stay in the tray. The tray\'s reset starts the tree again.',
      ],
      againLabel: 'Clear the board',
    })
  }

  // ---- tray ---------------------------------------------------------------
  function refreshIngredients() {
    for (const [index, select] of [firstIngredient, secondIngredient].entries()) {
      const previous = select.value
      select.replaceChildren(...state.items.map(item => {
        const option = document.createElement('option')
        option.value = item.text; option.textContent = item.text
        return option
      }))
      select.value = state.items.some(item => item.text === previous) ? previous : state.items[Math.min(index, state.items.length - 1)].text
    }
  }
  document.getElementById('recipeForm')!.addEventListener('submit', async e => {
    e.preventDefault()
    if (recipeBusy) return
    const a = state.items.find(item => item.text === firstIngredient.value)
    const b = state.items.find(item => item.text === secondIngredient.value)
    if (!a || !b) return
    recipeBusy = true; combineButton.disabled = true
    firstIngredient.disabled = secondIngredient.disabled = true
    recipeStatus.textContent = `Combining ${a.text} and ${b.text}…`
    unlock(); tip.hidden = true
    const first = spawn(a, world.w / 2 - 30, world.h / 2), second = spawn(b, world.w / 2 + 30, world.h / 2)
    try {
      const made = await mergePieces(first, second)
      if (made) recipeStatus.textContent = `${a.text} + ${b.text} = ${made.dataset.text}. Ready for another pair.`
      else {
        unspawn(first); unspawn(second)
        recipeStatus.textContent = `No recipe for ${a.text} + ${b.text} yet. Try another pair.`
      }
    } catch {
      unspawn(first); unspawn(second)
      recipeStatus.textContent = 'Could not complete this combination. Please try again.'
    } finally {
      recipeBusy = false; combineButton.disabled = false
      firstIngredient.disabled = secondIngredient.disabled = false
      if (document.activeElement === document.body) combineButton.focus({ preventScroll: true })
    }
  })
  function renderTray() {
    const q = filter.value.trim().toLowerCase()
    const items = state.items.filter((i) => !q || i.text.toLowerCase().includes(q))
    tray.replaceChildren(
      ...items.map((item) => {
        const b = document.createElement('button')
        b.type = 'button'
        b.className = 'fu-chip'
        b.innerHTML =
          `<span class="pic" aria-hidden="true">${ART[item.text]?.svg ?? UNKNOWN}</span>` +
          `<span class="lbl"></span>`
        b.querySelector(".lbl").textContent = item.text
        b.addEventListener('click', () => {
          // It arrives from the tray's side and drifts in.
          const side = world.w > 620
          const el = spawn(item, side ? world.w - 50 : world.w * (0.2 + 0.6 * Math.random()), side ? world.h * (0.2 + 0.6 * Math.random()) : world.h - 50)
          const body = bodyOf.get(el)
          if (!prefersReducedMotion) { body.vx = side ? -420 - 300 * Math.random() : (Math.random() - 0.5) * 300; body.vy = side ? (Math.random() - 0.5) * 300 : -420 - 300 * Math.random() }
          tip.hidden = true
          wake()
        })
        return b
      })
    )
    foundEl.textContent = String(state.items.length)
    refreshIngredients()
    paintStrip()
  }
  filter.addEventListener('input', renderTray)

  renderTray()
  // Put the four starters on the board so the first move is obvious. Spread
  // them across whatever width is actually available rather than a fixed pitch,
  // which pushed the last one off-screen on narrow boards.
  //
  // This deliberately does not use requestAnimationFrame: rAF is paused in
  // background tabs, so a page opened in one and switched to later would show
  // an empty board. Seed immediately if the board has been laid out, and
  // otherwise wait for the first resize that gives it a size.
  function seedBoard() {
    if (board.clientWidth < 40 || board.clientHeight < 40) return false
    world.resize(board.clientWidth, board.clientHeight)
    const r = radius()
    const gap = Math.min(r * 3.4, (world.w - r * 2 - 24) / Math.max(1, SEED.length - 1))
    SEED.forEach((s, i) => {
      const x = world.w / 2 + (i - (SEED.length - 1) / 2) * gap
      // Staggered, so a narrow board does not start with them touching.
      spawn(s, x, world.h / 2 + (i % 2 ? r * 0.9 : -r * 0.9))
    })
    return true
  }

  if (!seedBoard() && 'ResizeObserver' in window) {
    const ro = new ResizeObserver(() => { if (seedBoard()) ro.disconnect() })
    ro.observe(board)
  }
</script>

