---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * Life in Weeks — 90 years as 4,680 small squares.
 *
 * Everything is derived from one date the visitor types, entirely in the
 * browser. The date is stored in localStorage and sent nowhere; the page has no
 * backend and no analytics on the value.
 */
const YEARS = 90
const WEEKS = 52
---

<GameLayout slug="life-in-weeks" bar="#1b1f2e" bodyClass="weeks-body">
  <div class="field" id="field" aria-hidden="true"></div>
  <div class="wrap">
    <header class="head">
      <h1>Life in Weeks</h1>
      <p class="lede">
        Ninety years, one square per week. It fits on a single screen, which is
        the entire point.
      </p>
    </header>

    <form class="ask" id="ask">
      <label for="dob">When were you born?</label>
      <div class="ask-row">
        <input type="date" id="dob" name="dob" required max="" />
        <button type="submit" class="primary">Show me</button>
      </div>
      <p class="privacy">Stays in your browser. Nothing is sent anywhere.</p>
    </form>

    <section class="result" id="result" hidden>
      <div class="stats" id="stats"></div>

      <div class="chart">
        <div class="legend">
          <span><i class="k-lived"></i> lived</span>
          <span><i class="k-now"></i> this week</span>
          <span><i class="k-left"></i> if you reach 90</span>
        </div>
        <div class="grid-wrap">
          <div class="decades" id="decades" aria-hidden="true"></div>
          <div class="grid" id="grid" role="img" aria-label="Your life so far, as a grid of weeks"></div>
        </div>
        <p class="caption" id="caption"></p>
      </div>

      <div class="facts" id="facts"></div>

      <div class="actions">
        <button type="button" data-share data-title="Life in Weeks">Share</button>
        <button type="button" id="changeBtn" class="ghost">Use a different date</button>
      </div>
    </section>
  </div>
</GameLayout>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ YEARS, WEEKS })} />

  <script>
  import { burst } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface } from '../lib/gl'
  import { weeksGridFrag } from '../lib/weeks-grid'
  import { WEEKS_FIELD_FRAG } from '../lib/weeks-field'
    const { YEARS, WEEKS } = JSON.parse(document.getElementById('game-data')!.textContent!) as any

  const el = (id) => document.getElementById(id)
  const KEY = 'life-in-weeks:dob'
  const TOTAL = YEARS * WEEKS
  const WEEK_MS = 604_800_000

  el('dob').max = new Date().toISOString().slice(0, 10)

  // Build the grid once — 4,680 nodes is fine, and reusing them keeps the
  // recalculation on a new date to a class flip rather than a re-render.
  const cells = []
  const frag = document.createDocumentFragment()
  for (let i = 0; i < TOTAL; i++) {
    const s = document.createElement('i')
    if (i % WEEKS === 0 && (i / WEEKS) % 10 === 0) s.classList.add('decade')
    frag.appendChild(s)
    cells.push(s)
  }
  el('grid').appendChild(frag)

  const dec = document.createDocumentFragment()
  for (let y = 0; y < YEARS; y += 10) {
    const d = document.createElement('span')
    d.textContent = String(y)
    d.style.setProperty('--y', String(y))
    dec.appendChild(d)
  }
  el('decades').appendChild(dec)

  // TDZ guard: both surfaces' uniforms() callbacks run synchronously inside
  // the ShaderSurface constructor (first paint never waits on rAF), so these
  // must exist before either call.
  let livedCount = 0
  let livedPct = 0 // 0..1, read by the field's ambient horizon glow
  const gridSurface = new ShaderSurface(el('grid'), weeksGridFrag(YEARS, WEEKS), {
    uniforms: () => ({ u_lived: livedCount }),
  })
  if (gridSurface.canvas.isConnected) el('grid').classList.add('gl')
  const fieldSurface = new ShaderSurface(el('field'), WEEKS_FIELD_FRAG, {
    still: true,
    uniforms: () => ({ u_pct: livedPct }),
  })

  const nf = (n) => Math.round(n).toLocaleString('en-US')

  /**
   * A stat tile. `bar` is a share of the tile's own width, 0..100, drawn as a
   * hairline underneath the number — the same device the register on
   * Progress uses for its rows, at a fifth the size. Only two of the four
   * tiles get one: "weeks lived" and "weeks left" are two readings of the
   * same 4,680, and their bars always sum to a full width between them even
   * though they sit in separate tiles. The other two — the percentage and the
   * day count — are each already a single number with nothing beneath them to
   * compare against, so a bar under either would be decoration rather than a
   * second reading of the same fact.
   */
  function stat(value, label, bar) {
    return `<div class="stat">` +
      `<b>${value}</b><span>${label}</span>` +
      (bar ? `<i class="stat-bar ${bar.cls}" style="--p:${bar.pct}"></i>` : '') +
      `</div>`
  }

  function show(dobStr) {
    const dob = new Date(dobStr + 'T00:00:00')
    if (Number.isNaN(+dob)) return
    const now = new Date()
    const ms = +now - +dob
    if (ms < 0) return

    const weeks = Math.floor(ms / WEEK_MS)
    const days = Math.floor(ms / 86_400_000)
    const lived = Math.min(weeks, TOTAL)
    const pct = (weeks / TOTAL) * 100
    const pctClamped = Math.min(100, pct) // someone past 90 does not overrun a bar

    for (let i = 0; i < TOTAL; i++) {
      const c = cells[i]
      c.className = (i % WEEKS === 0 && (i / WEEKS) % 10 === 0 ? 'decade ' : '') +
        (i < lived ? 'lived' : i === lived ? 'now' : '')
    }
    livedCount = lived
    gridSurface.redraw()
    livedPct = pctClamped / 100
    fieldSurface.redraw()

    // Exact years, accounting for the actual calendar rather than 365.25.
    let years = now.getFullYear() - dob.getFullYear()
    const had = now.getMonth() > dob.getMonth() ||
      (now.getMonth() === dob.getMonth() && now.getDate() >= dob.getDate())
    if (!had) years--

    el('stats').innerHTML =
      stat(nf(weeks), 'weeks lived', { cls: 'lived', pct: pctClamped }) +
      stat(nf(Math.max(0, TOTAL - weeks)), 'weeks left, if you reach 90',
        { cls: 'left', pct: 100 - pctClamped }) +
      stat(pct.toFixed(1) + '%', 'of a 90-year life') +
      stat(nf(days), 'days')

    el('caption').textContent =
      weeks >= TOTAL
        ? 'You are past the ninetieth row. The grid ran out before you did.'
        : `You are in week ${nf(weeks + 1)} of ${nf(TOTAL)}. Each row is one year of your life.`

    // Physiological figures are population averages, stated as such.
    const heartbeats = days * 24 * 60 * 75
    const breaths = days * 24 * 60 * 15
    const sleepYears = (days * 8) / 24 / 365.2425
    const moons = days / 29.530588853
    el('facts').innerHTML =
      `<h2>In that time</h2><ul>` +
      `<li>Your heart has beaten about <b>${nf(heartbeats)}</b> times.</li>` +
      `<li>You have taken roughly <b>${nf(breaths)}</b> breaths.</li>` +
      `<li>You have slept for about <b>${sleepYears.toFixed(1)} years</b> of it.</li>` +
      `<li>There have been <b>${nf(moons)}</b> full moons.</li>` +
      `<li>The Earth has gone round the Sun <b>${years}</b> times with you on it.</li>` +
      `</ul><p class="src">Heart rate and breathing use adult population averages, so treat them as an order of magnitude, not a measurement.</p>`

    el('ask').hidden = true
    el('result').hidden = false
    unlock(); sfx.good()
    // One rising note per decade lived, so the reveal has a shape.
    const decades = Math.min(9, Math.floor(years / 10))
    for (let k = 0; k <= decades; k++) setTimeout(() => sfx.blip(k), 90 + k * 85)
    setTimeout(() => burst(innerWidth / 2, innerHeight * 0.36, {
      count: 24, colors: ['#8fa2c4', '#ffd166', '#fff'], speed: 4, gravity: 0.12, life: 46, size: 3,
    }), 120)
    try { localStorage.setItem(KEY, dobStr) } catch {}
  }

  el('ask').addEventListener('submit', (e) => {
    e.preventDefault()
    if (el('dob').value) show(el('dob').value)
  })

  el('changeBtn').addEventListener('click', () => {
    el('result').hidden = true
    el('ask').hidden = false
    el('dob').focus()
  })

  try {
    const saved = localStorage.getItem(KEY)
    if (saved) { el('dob').value = saved; show(saved) }
  } catch {}
</script>

<style is:global>
  /* Stats, facts and grid cells are all built at runtime.

     Every accent colour below is lifted from the grid's own shader rather
     than invented to match it: --wk-young and --wk-old are the sRGB values
     `weeks-grid.ts` mixes a lived week's colour from (birth-blue to
     lived-in-amber), --wk-now is the exact colour of the pulsing current
     week, and --wk-future/--wk-void are its unlived field and the page's own
     backdrop. A card built from these five numbers cannot drift from the
     picture above it, because they are not a second description of that
     picture — they are the same one. */
  .weeks-body {
    background: #101320; color: #e8ecf5;
    --wk-young: #6687bd;
    --wk-old: #e8a94f;
    --wk-now: #ffd166;
    --wk-future: #21273d;
    /* A lifted reading of --wk-future for the "weeks left" bar's fill. The
       grid can afford the true, near-black future colour because a lived cell
       sits right beside it in the same row; a bar has only its own empty
       track to be read against, and at that low a contrast the fill and the
       track measured as the same flat line. */
    --wk-future-fill: #4a5678;
    --wk-void: #090a12;
    --wk-ink2: #9aa7c2;
    --wk-ink3: #8f9cb8;
    --wk-arc: linear-gradient(90deg, var(--wk-young), var(--wk-old));
  }

  .weeks-body .field {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    /* The still fallback, roughly what the shader settles to: without
       WebGL2 this is the page's own background and nothing looks missing. */
    background: radial-gradient(120% 70% at 50% 0%, #171b2b 0%, #0c0e18 70%);
  }
  .weeks-body .field .gl-surface { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .weeks-body .wrap { position: relative; z-index: 1; max-width: 860px; margin: 0 auto; padding: 46px 22px 80px; }
  .weeks-body .head { text-align: center; margin-bottom: 28px; }
  .weeks-body .head h1 { font-size: clamp(34px, 6vw, 52px); }
  .weeks-body .lede { color: var(--wk-ink2); margin: 10px auto 0; max-width: 44ch; }

  /* --------------------------------------------------------------- ask -- */

  .weeks-body .ask {
    position: relative;
    background: linear-gradient(180deg, #181c2d, #10131f);
    border: 1px solid rgb(102 135 189 / 0.16);
    border-radius: var(--radius-lg);
    padding: 28px 24px; text-align: center; max-width: 460px; margin: 0 auto;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      inset 0 -1px 0 rgb(0 0 0 / 0.4),
      0 30px 60px -34px rgb(0 0 0 / 0.8);
  }
  .weeks-body .ask label { display: block; font-weight: 600; margin-bottom: 12px; }
  .weeks-body .ask-row { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .weeks-body input[type='date'] {
    /* A recessed slot rather than a raised field: it is the one thing on the
       page you actually touch, so it is the one thing carved in rather than
       stacked on. */
    background: var(--wk-void);
    border: 1px solid rgb(102 135 189 / 0.22);
    color: #e8ecf5;
    border-radius: 10px; padding: 10px 12px; font-size: 15px;
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.55);
    color-scheme: dark;
    transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease);
  }
  .weeks-body input[type='date']:focus-visible {
    outline: none;
    border-color: var(--wk-now);
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.55), 0 0 0 3px rgb(255 209 102 / 0.22);
  }
  .weeks-body .primary {
    /* The birth-to-now arc, baked into the one button that starts it. */
    background: var(--wk-arc);
    color: #16130a; border: 0; border-radius: 10px;
    padding: 10px 22px; font-weight: 700; cursor: pointer;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.35) inset, 0 8px 20px -10px rgb(232 169 79 / 0.55);
    transition: transform 180ms var(--ease-bounce), box-shadow 180ms var(--ease);
  }
  .weeks-body .primary:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.4) inset, 0 12px 26px -10px rgb(232 169 79 / 0.7);
  }
  .weeks-body .primary:active { transform: scale(0.96); }
  .weeks-body .privacy { color: var(--wk-ink3); font-size: 12.5px; margin: 12px 0 0; }

  /* -------------------------------------------------------------- stats -- */

  /* One plate, not four floating cards — the same move the register on
     Progress makes: a shared background shows through the hairline gaps as a
     seam rather than a hole back to the page, so four numbers read as one
     instrument rather than four unrelated widgets. */
  .weeks-body .stats {
    display: grid; gap: 1px; margin-bottom: 26px;
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    background: linear-gradient(180deg, #171b2b, #10131f);
    border-radius: var(--radius-lg);
    padding: 7px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      inset 0 -1px 0 rgb(0 0 0 / 0.4),
      0 24px 50px -30px rgb(0 0 0 / 0.85);
  }
  .weeks-body .stat {
    position: relative;
    background: transparent; border-radius: 9px;
    padding: 16px 14px 20px; text-align: center;
  }
  .weeks-body .stat b {
    display: block; font-family: var(--display); font-size: clamp(22px, 3.4vw, 30px);
    font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  }
  .weeks-body .stat span { font-size: 12px; color: var(--wk-ink3); }

  /* A hairline underline standing in for a second bar chart. Two tiles carry
     one each, always summing to a full width between them — see the note by
     stat() in the script. */
  .weeks-body .stat-bar {
    position: absolute; left: 14px; right: 14px; bottom: 10px;
    height: 3px; border-radius: 2px;
    background: rgb(255 255 255 / 0.07);
    overflow: hidden;
  }
  .weeks-body .stat-bar::after {
    content: ''; display: block; height: 100%; width: calc(var(--p) * 1%);
    border-radius: 2px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22);
  }
  .weeks-body .stat-bar.lived::after { background: var(--wk-arc); }
  .weeks-body .stat-bar.left::after { background: var(--wk-future-fill); }

  /* --------------------------------------------------------------- chart -- */

  .weeks-body .chart {
    background: linear-gradient(180deg, #171b2b, #10131f);
    border: 1px solid rgb(102 135 189 / 0.14);
    border-radius: var(--radius-lg);
    padding: 20px 18px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      inset 0 -1px 0 rgb(0 0 0 / 0.45),
      0 30px 70px -36px rgb(0 0 0 / 0.85);
  }
  .weeks-body .legend {
    display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
    font-size: 12.5px; color: var(--wk-ink2); margin-bottom: 14px;
  }
  .weeks-body .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .weeks-body .legend i { width: 10px; height: 10px; border-radius: 2px; display: block; }
  /* Swatches drawn from the same materials the grid paints with, not flat
     restatements of them: the lived chip is the actual birth-to-now gradient,
     the "left" chip carries one faint point the way an unlived week does. */
  .weeks-body .k-lived { background: var(--wk-arc); }
  .weeks-body .k-now {
    background: var(--wk-now);
    box-shadow: 0 0 5px 1px rgb(255 209 102 / 0.6);
    animation: wk-pulse 2.6s ease-in-out infinite;
  }
  .weeks-body .k-left {
    background:
      radial-gradient(circle at 68% 32%, rgb(255 255 255 / 0.55) 0 0.5px, transparent 0.5px),
      var(--wk-future);
  }
  @keyframes wk-pulse {
    0%, 100% { box-shadow: 0 0 4px 0.5px rgb(255 209 102 / 0.45); }
    50% { box-shadow: 0 0 7px 1.5px rgb(255 209 102 / 0.8); }
  }

  .weeks-body .grid-wrap { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 8px; }
  .weeks-body .decades { position: relative; font-size: 10px; color: var(--wk-ink3); }
  .weeks-body .decades span {
    position: absolute; right: 0;
    /* Row height is derived from the same fraction the grid uses. */
    top: calc(var(--y) * (100% / 90));
  }

  .weeks-body .grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(52, minmax(0, 1fr));
    gap: 1.5px;
  }
  .weeks-body .grid .gl-surface { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .weeks-body .grid i {
    display: block; aspect-ratio: 1; border-radius: 1.5px;
    background: var(--wk-future);
    transition: background 260ms var(--ease);
  }
  .weeks-body .grid i.lived { background: var(--wk-young); }
  .weeks-body .grid i.now { background: var(--wk-now); box-shadow: 0 0 0 2px rgb(255 209 102 / 0.35); }
  .weeks-body .grid i.decade { box-shadow: inset -1px 0 0 rgb(255 255 255 / 0.14); }
  /* The DOM cells stay in the layout — their aspect-ratio squares are what
     give the canvas its size — but paint nothing once the shader is live. */
  .weeks-body .grid.gl i { visibility: hidden; }

  .weeks-body .caption { text-align: center; color: var(--wk-ink3); font-size: 13px; margin: 14px 0 0; }

  /* -------------------------------------------------------------- facts -- */

  .weeks-body .facts {
    background: linear-gradient(180deg, #171b2b, #10131f);
    border: 1px solid rgb(102 135 189 / 0.14);
    border-radius: var(--radius-lg);
    padding: 22px 20px; margin-top: 18px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      inset 0 -1px 0 rgb(0 0 0 / 0.45),
      0 24px 55px -32px rgb(0 0 0 / 0.85);
  }
  .weeks-body .facts h2 { font-size: 22px; margin-bottom: 12px; }
  .weeks-body .facts ul {
    margin: 0; padding: 0; list-style: none;
    display: grid; gap: 9px; color: #c3cde0;
  }
  /* A small lit dot in place of a browser bullet — the same legend mark the
     register uses for a channel, here standing for "since you were born"
     rather than for a rate. */
  .weeks-body .facts li { position: relative; padding-left: 18px; }
  .weeks-body .facts li::before {
    content: ''; position: absolute; left: 0; top: 0.55em;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--wk-old);
    box-shadow: 0 0 4px 0.5px rgb(232 169 79 / 0.5);
  }
  .weeks-body .facts b { color: var(--wk-old); font-variant-numeric: tabular-nums; }
  .weeks-body .facts .src { color: var(--wk-ink3); font-size: 12.5px; margin: 14px 0 0; }

  /* ------------------------------------------------------------ actions -- */

  .weeks-body .actions { display: flex; gap: 10px; justify-content: center; margin-top: 22px; flex-wrap: wrap; }
  .weeks-body .actions button {
    border: 0; border-radius: 999px; padding: 11px 24px; font-weight: 700;
    cursor: pointer; background: var(--wk-arc); color: #16130a;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.3) inset;
    transition: transform 180ms var(--ease-bounce), box-shadow 180ms var(--ease);
  }
  .weeks-body .actions button:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.35) inset, 0 10px 22px -12px rgb(232 169 79 / 0.6);
  }
  .weeks-body .actions button:active { transform: scale(0.95); }
  .weeks-body .actions .ghost {
    background: transparent; border: 1px solid rgb(102 135 189 / 0.3); color: #e8ecf5;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .weeks-body .k-now { animation: none; box-shadow: 0 0 5px 1px rgb(255 209 102 / 0.6); }
  }
</style>
