---
import GameShell from '../layouts/GameShell.astro'
import { YEARS, WEEKS } from '../lib/weeks-life'

/**
 * Life in Weeks — ninety years as 4,680 small lamps on one board.
 *
 * Everything is derived from one date the visitor types, entirely in the
 * browser. The date is stored in localStorage and sent nowhere.
 *
 * The board is there before the date is: every lamp off. Giving a date
 * counts the lived ones on from birth, and from then on any week can be
 * looked at (its dates, the age it belongs to, how far it is from now), the
 * weeks the world did something in carry a pinhole, and the list under the
 * board says how old you were. Score is weeks lived, Age and Weeks left are
 * the other two readings, and Best is the oldest you have been on a visit
 * here, which is always now.
 */
---

<GameShell
  slug="life-in-weeks"
  labels={{ score: 'Weeks lived', best: 'Oldest yet', level: 'Age', moves: 'Weeks left' }}
  initial={{ score: '—', level: '—', moves: '—' }}
>
  <div class="weeks-body">
  <div class="lw-wrap" id="wrap">
    <form class="ask" id="ask">
      <p class="lede">
        Ninety years, one small lamp for each week. Say when you were born and
        yours come on.
      </p>
      <div class="ask-row">
        <label for="dob">Born</label>
        <input type="date" id="dob" name="dob" required min="1900-01-01" max="" />
        <button type="submit" class="primary">Light them</button>
      </div>
      <p class="privacy">Stays in your browser. Nothing is sent anywhere.</p>
    </form>

    <header class="lw-head" id="head" hidden>
      <div>
        <p class="lw-kick" id="kick"></p>
        <h2 class="lw-line" id="headline"></h2>
      </div>
      <p class="lw-born"><span id="bornTxt"></span> <button type="button" id="changeBtn" class="lw-link">Change</button></p>
    </header>

    <div class="board-box" id="box">
      <div class="axis" id="axis" aria-hidden="true"></div>
      <div class="board" id="board" tabindex="0" role="application" aria-label="Ninety years of weeks. Arrow keys move from week to week."></div>
    </div>

    <div class="under" id="under" hidden>
      <p class="inspect" id="inspect" aria-live="polite"></p>
      <p class="legend" aria-hidden="true">
        <span><i class="k-lived"></i> lived</span>
        <span><i class="k-now"></i> this week</span>
        <span><i class="k-left"></i> if you reach 90</span>
        <span><i class="k-pin"></i> the world did something</span>
      </p>
    </div>

    <section class="lw-more" id="more" hidden>
      <div class="lw-col">
        <h3>Still ahead, if you reach ninety</h3>
        <div class="lw-left" id="left"></div>
      </div>
      <div class="lw-col">
        <h3>In your lifetime</h3>
        <ol class="lw-world" id="world"></ol>
        <form class="lw-add" id="add">
          <label for="mineText">Add a date of your own</label>
          <div class="lw-add-row">
            <input type="text" id="mineText" maxlength="48" placeholder="Moved to the city" autocomplete="off" required />
            <input type="date" id="mineDate" aria-label="Its date" required />
            <button type="submit" class="lw-add-btn">Add</button>
          </div>
          <p class="lw-add-msg" id="addMsg" role="status">Yours stay in this browser as well.</p>
        </form>
        <p class="lw-note">Each line of fifty-two is one year of your life, birthday to birthday. So a lamp is a week and about half an hour.</p>
      </div>
    </section>
  </div>
  </div>

  <Fragment slot="howto">
    <p>
      Ninety years, one lamp per week: 4,680 of them, on one board. Put in
      your date of birth and every week you have lived comes on.
    </p>
    <ul>
      <li>Each line of fifty-two is one year of your life, starting on your birthday. The lilac lamp is this week.</li>
      <li>Point at any week, or tap it, to see its dates and how old you were. The arrow keys work too.</li>
      <li>A lamp with a pinhole is a week the world did something in. The list under the board says what, and you can add dates of your own to it.</li>
      <li>The date stays in your browser, so the board is here next time. Nothing is sent anywhere.</li>
    </ul>
    <p>Your best is the oldest you have been on a visit here.</p>
  </Fragment>
</GameShell>

  {/* Data for the module below: modules cannot take define:vars, and
      modules are what let every game share one synthesiser. */}
  <script type="application/json" id="game-data" set:html={JSON.stringify({ YEARS, WEEKS })} />

  <script>
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface, prefersReducedMotion } from '../lib/gl'
  import { weeksBoardFrag, BOARD_MARGIN, BOARD_PINS } from '../lib/weeks-board'
  import { YEARS, WEEKS, TOTAL, DAY_MS, parseDay, lifeAt, cellSpan, cellOf, ageAt, worldFor, moonsIn, type Placed } from '../lib/weeks-life'
  import { createShell } from '../lib/game-shell'
  import { shareResult, outcomeLabel } from '../lib/share-card'
  import { SITE } from '../site.config'
  import { recordPlay } from '../lib/stats'

  const el = (id: string) => document.getElementById(id)!
  // Restart is a reload, the default: the saved date brings the board back.
  const shell = createShell({ slug: 'life-in-weeks' })
  const KEY = 'life-in-weeks:dob'
  /* The visitor's own dates. Like the date of birth, this key is not on the
     list a save code carries (lib/sync.ts), so it never leaves the browser. */
  const MINE_KEY = 'life-in-weeks:mine'
  const MINE_MAX = 24
  type Mine = { t: string; d: string }
  let mine: Mine[] = []
  try {
    const raw = JSON.parse(localStorage.getItem(MINE_KEY) || '[]')
    if (Array.isArray(raw)) mine = raw.filter((m) => m && typeof m.t === 'string' && typeof m.d === 'string' && parseDay(m.d)).slice(0, MINE_MAX)
  } catch {}
  const saveMine = () => { try { localStorage.setItem(MINE_KEY, JSON.stringify(mine)) } catch {} }
  const M = BOARD_MARGIN
  const board = el('board')
  const wrap = el('wrap')
  const box = el('box')
  const dobInput = el('dob') as HTMLInputElement

  const today = new Date()
  dobInput.max = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`

  const nf = (n: number) => Math.round(n).toLocaleString('en-US')
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!))

  /* ------------------------------------------------------------ state -- */

  let dob: Date | null = null
  let lived = 0        // lamps that should be lit
  let litShown = 0     // lamps that are, while the count runs
  let nowIdx = -1      // this week, or -1 before a date and past ninety
  let look = -1        // the week being looked at, or -1
  let pinnedLook = false // a tap or a key holds the look; a passing mouse does not
  let head = 0
  let tall = false
  let placed: (Placed & { mine?: number })[] = []
  const pins = new Float32Array(BOARD_PINS).fill(-1)
  const rest = () => (tall ? [0.5, 0.16] : [0.3, 0.2])
  const light = rest()
  let lightTo: number[] | null = null

  /* ----------------------------------------------------------- layout -- */

  const axis = el('axis')
  for (let y = 0; y < YEARS; y += 10) {
    const s = document.createElement('span')
    s.textContent = String(y)
    s.style.setProperty('--at', String(((M + y) / (YEARS + 2 * M)) * 100))
    axis.appendChild(s)
  }

  /* The first run on a phone can see a desktop width, and a container cannot
     restyle itself from its own query: so the class is set from here, and
     kept right by the observer. */
  function measure() {
    const was = tall
    tall = wrap.clientWidth < 720
    wrap.classList.toggle('tall', tall)
    if (was !== tall && !lightTo) { const r = rest(); light[0] = r[0]; light[1] = r[1] }
    /* A lamp is a whole number of screen pixels wide. At eleven and a bit,
       every few rows land differently on the pixel grid and the unlit glass
       turns into a pattern of dashes. */
    const cs = getComputedStyle(wrap)
    const gutter = tall ? 26 : 0
    const availW = wrap.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight) - gutter
    const availH = innerHeight - (tall ? 190 : 270)
    const nx = (tall ? WEEKS : YEARS) + 2 * M, ny = (tall ? YEARS : WEEKS) + 2 * M
    const dpr = Math.min(devicePixelRatio || 1, 2)
    const floor = Math.min(availW, tall ? 250 : 560) / nx
    const cell = Math.floor(Math.min(availW / nx, Math.max(availH / ny, floor)) * dpr) / dpr
    box.style.width = cell * nx + gutter + 'px'
    paint()
  }

  /* ------------------------------------------------------------ board -- */

  const surface = new ShaderSurface(board, weeksBoardFrag(YEARS, WEEKS), {
    uniforms: () => {
      const to = lightTo ?? rest()
      const k = prefersReducedMotion ? 1 : 0.07
      light[0] += (to[0] - light[0]) * k
      light[1] += (to[1] - light[1]) * k
      return { u_lit: litShown, u_now: nowIdx, u_hover: look, u_tall: tall ? 1 : 0, u_head: head, u_light: light, u_pins: pins }
    },
  })
  const gl = surface.canvas.isConnected

  // Without WebGL2: the same board as flat squares, drawn when something changes.
  let flat: HTMLCanvasElement | null = null
  if (!gl) {
    flat = document.createElement('canvas')
    flat.className = 'gl-surface'
    board.appendChild(flat)
  }
  function paintFlat() {
    if (!flat) return
    const r = board.getBoundingClientRect()
    const dpr = Math.min(devicePixelRatio || 1, 2)
    flat.width = Math.max(1, Math.round(r.width * dpr))
    flat.height = Math.max(1, Math.round(r.height * dpr))
    const c = flat.getContext('2d')!
    const nx = tall ? WEEKS : YEARS, ny = tall ? YEARS : WEEKS
    const cw = flat.width / (nx + 2 * M), ch = flat.height / (ny + 2 * M)
    const gap = Math.max(1, cw * 0.16)
    const isPin = new Set(pins)
    c.fillStyle = '#0d1019'
    c.fillRect(0, 0, flat.width, flat.height)
    for (let y = 0; y < YEARS; y++) for (let w = 0; w < WEEKS; w++) {
      const i = y * WEEKS + w
      const gx = tall ? w : y, gy = tall ? y : w
      const a = y / (YEARS - 1)
      c.fillStyle = i === nowIdx ? '#b8a1ff' : i < litShown
        ? `rgb(${Math.round(92 - 13 * a)} ${Math.round(128 + 99 * a)} ${Math.round(199 - 5 * a)})`
        : '#21273d'
      c.fillRect((gx + M) * cw + gap / 2, (gy + M) * ch + gap / 2, cw - gap, ch - gap)
      if (isPin.has(i)) { c.fillStyle = i < litShown ? '#0a1220' : '#8fa2c4'; c.fillRect((gx + M + 0.36) * cw, (gy + M + 0.36) * ch, cw * 0.28, ch * 0.28) }
      if (i === look) { c.strokeStyle = '#fff'; c.lineWidth = dpr; c.strokeRect((gx + M) * cw + gap / 2, (gy + M) * ch + gap / 2, cw - gap, ch - gap) }
    }
  }
  const paint = () => { surface.redraw(); paintFlat() }

  new ResizeObserver(measure).observe(wrap)
  addEventListener('resize', measure)
  measure()

  /* -------------------------------------------------- looking at a week -- */

  /** The week under a point on the screen, or -1 off the lamps. */
  function weekAt(clientX: number, clientY: number) {
    const r = board.getBoundingClientRect()
    const nx = tall ? WEEKS : YEARS, ny = tall ? YEARS : WEEKS
    const gx = Math.floor(((clientX - r.left) / r.width) * (nx + 2 * M) - M)
    const gy = Math.floor(((clientY - r.top) / r.height) * (ny + 2 * M) - M)
    if (gx < 0 || gy < 0 || gx >= nx || gy >= ny) return -1
    return tall ? gy * WEEKS + gx : gx * WEEKS + gy
  }

  const dayFmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', year: 'numeric' })
  const shortFmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short' })

  function describe(idx: number) {
    if (!dob) return ''
    const { start, end } = cellSpan(dob, idx)
    const last = new Date(+end - DAY_MS / 2)
    const y = Math.floor(idx / WEEKS)
    const span = start.getFullYear() === last.getFullYear()
      ? `${shortFmt.format(start)} to ${dayFmt.format(last)}`
      : `${dayFmt.format(start)} to ${dayFmt.format(last)}`
    const from = nowIdx < 0 ? null : idx - nowIdx
    const when = from === null ? '' : from === 0 ? 'This week' : from < 0 ? `${nf(-from)} ${from === -1 ? 'week' : 'weeks'} ago` : `In ${nf(from)} ${from === 1 ? 'week' : 'weeks'}`
    const what = placed.filter((e) => e.idx === idx).map((e) => esc(e.text)).join('; ')
    return `<b>${span}</b>` +
      `<span>Age ${y}, week ${idx - y * WEEKS + 1} of ${WEEKS}</span>` +
      (when ? `<span>${when}</span>` : '') +
      (what ? `<em>${what}</em>` : '')
  }

  function setLook(idx: number, hold = false) {
    if (!dob) return
    look = idx
    pinnedLook = hold && idx >= 0
    const shown = idx >= 0 ? idx : nowIdx
    el('inspect').innerHTML = shown >= 0 ? describe(shown) : '<span>Past the last lamp. The board ran out before you did.</span>'
    for (const b of el('world').querySelectorAll<HTMLElement>('button[data-idx]')) b.classList.toggle('on', +b.dataset.idx! === idx)
    paint()
  }

  board.addEventListener('pointermove', (e) => {
    const r = board.getBoundingClientRect()
    if (e.pointerType === 'mouse') {
      lightTo = [(e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height]
      if (!pinnedLook) setLook(weekAt(e.clientX, e.clientY))
      if (prefersReducedMotion) paint()
    }
  })
  board.addEventListener('pointerleave', () => {
    lightTo = null
    if (!pinnedLook) setLook(-1)
    if (prefersReducedMotion) paint()
  })
  board.addEventListener('click', (e) => {
    const i = weekAt(e.clientX, e.clientY)
    // A second tap on the held week lets it go.
    if (i >= 0 && !(pinnedLook && i === look)) { setLook(i, true); sfx.tick() } else setLook(-1)
  })
  board.addEventListener('keydown', (e) => {
    if (!dob) return
    if (e.key === 'Escape') { setLook(-1); return }
    const step = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key]
    if (!step) return
    e.preventDefault()
    const from = look >= 0 ? look : Math.max(0, nowIdx)
    let y = Math.floor(from / WEEKS), w = from - y * WEEKS
    // On screen, "right" is the next year on a wide board and the next week on a tall one.
    const [dx, dy] = step
    if (tall) { w += dx; y += dy } else { y += dx; w += dy }
    setLook(Math.max(0, Math.min(YEARS - 1, y)) * WEEKS + Math.max(0, Math.min(WEEKS - 1, w)), true)
  })
  board.addEventListener('blur', () => { if (pinnedLook) setLook(-1) })

  /* -------------------------------------------------------- the count -- */

  let raf = 0
  function count(from: number, to: number, years: number) {
    cancelAnimationFrame(raf)
    if (prefersReducedMotion || to <= 0) { litShown = to; head = 0; paint(); return }
    const dur = 1300 + 28 * years
    const t0 = performance.now()
    let decade = 0
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / dur)
      // Quick out of childhood, slowing as it nears now.
      litShown = from + (to - from) * (1 - Math.pow(1 - k, 2.2))
      head = k < 1 ? 1 : Math.max(0, 1 - (t - t0 - dur) / 600)
      // One rising note per decade passed, so the count has a shape.
      while (decade < 9 && litShown >= (decade + 1) * 10 * WEEKS) sfx.blip(decade++)
      paintFlat()
      if (k < 1 || head > 0) raf = requestAnimationFrame(step)
      else sfx.good()
    }
    raf = requestAnimationFrame(step)
  }

  /* ------------------------------------------------------------- show -- */

  const bornFmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'long', year: 'numeric' })

  function tile(value: string, label: string) {
    return `<div class="lw-tile"><b>${value}</b><span>${label}</span></div>`
  }

  /** Put the world's dates and the visitor's own on this life's board, and list them. */
  function place() {
    if (!dob) return
    const now = new Date()
    placed = worldFor(dob, now)
    mine.forEach((m, k) => {
      const date = parseDay(m.d)!
      const idx = cellOf(dob!, date)
      if (+date >= +dob! && idx < TOTAL) placed.push({ text: m.t, date, idx, age: ageAt(dob!, date), ahead: +date > +now, mine: k })
    })
    placed.sort((a, b) => +a.date - +b.date)
    pins.fill(-1)
    // If there are more than the board can mark, the visitor's own come first.
    const marked = [...placed.filter((e) => e.mine !== undefined), ...placed.filter((e) => e.mine === undefined).reverse()].slice(0, BOARD_PINS)
    marked.forEach((e, i) => (pins[i] = e.idx))
    el('world').innerHTML = placed.length
      ? placed.map((e) => {
          const age = e.age === 0 ? (e.ahead ? 'in your first year' : 'you were a baby') : e.ahead ? `you would be ${e.age}` : `you were ${e.age}`
          return `<li class="${e.mine !== undefined ? 'mine' : ''}"><button type="button" data-idx="${e.idx}" class="${e.ahead ? 'ahead' : ''}">` +
            `<span class="yr">${e.date.getFullYear()}</span><span class="tx">${esc(e.text)}</span><span class="ag">${age}</span></button>` +
            (e.mine !== undefined ? `<button type="button" class="rm" data-rm="${e.mine}" aria-label="Remove ${esc(e.text)}">&times;</button>` : '') + `</li>`
        }).join('')
      : '<li class="none">Nothing on the list falls inside these ninety years.</li>'
    paint()
  }

  el('add').addEventListener('submit', (e) => {
    e.preventDefault()
    if (!dob) return
    const text = (el('mineText') as HTMLInputElement).value.trim().slice(0, 48)
    const dStr = (el('mineDate') as HTMLInputElement).value
    const date = parseDay(dStr)
    const msg = el('addMsg')
    if (!text || !date) return
    if (+date < +dob || cellOf(dob, date) >= TOTAL) { msg.textContent = 'That date is not on your board: it is before you were born, or after ninety.'; return }
    if (mine.length >= MINE_MAX) { msg.textContent = `The board holds ${MINE_MAX} of your own. Remove one to add another.`; return }
    mine.push({ t: text, d: dStr })
    saveMine()
    // Only that one was added, never what it says or when it was.
    shell.pick('Own date', 'Added')
    ;(el('add') as HTMLFormElement).reset()
    msg.textContent = 'Added. It stays in this browser.'
    place()
    setLook(cellOf(dob, date), true)
    sfx.tick()
  })

  function show(dobStr: string) {
    const d = parseDay(dobStr)
    const now = new Date()
    if (!d || +d > +now) return
    dob = d
    const life = lifeAt(d, now)
    lived = life.lived
    nowIdx = life.inside ? life.lived : -1

    place()

    const left = life.left
    el('kick').textContent = life.inside ? `Week ${nf(lived + 1)} of ${nf(TOTAL)}` : 'Past the last lamp'
    el('headline').textContent = `${life.pct.toFixed(1)}% of ninety years`
    el('bornTxt').textContent = `Born ${bornFmt.format(d)}`
    board.setAttribute('aria-label', `Ninety years of weeks: ${nf(lived)} lived, ${nf(left.weeks)} left. Arrow keys move from week to week.`)

    el('left').innerHTML =
      tile(nf(left.weeks), 'weeks') +
      tile(nf(left.weekends), 'weekends') +
      tile(nf(left.moons), 'full moons') +
      tile(nf(left.newYears), left.newYears === 1 ? 'New Year’s Day' : 'New Year’s Days') +
      tile(nf(left.leapDays), left.leapDays === 1 ? '29th of February' : '29ths of February')

    shell.setScore(nf(lived))
    shell.setLevel(String(life.years))
    shell.setMoves(nf(left.weeks))
    shell.considerBest(lived, nf(lived))

    el('ask').hidden = true
    for (const id of ['head', 'under', 'more']) el(id).hidden = false
    setLook(-1)

    // Physiological figures are population averages, stated as such.
    const days = life.days
    const heartbeats = days * 24 * 60 * 75
    const breaths = days * 24 * 60 * 15
    const sleepYears = (days * 8) / 24 / 365.2425
    const moons = moonsIn(days)
    const sunKm = days * 2_573_000

    /* The board is the answer; the result card under it is what happened in
       that time. It waits there rather than pulling the page past the board. */
    shell.reset()
    shell.win({
      celebrate: false,
      scroll: false,
      kicker: life.inside ? `Week ${nf(lived + 1)} of ${nf(TOTAL)}` : 'Past the last lamp',
      title: `${life.pct.toFixed(1)}% of a ninety-year life.`,
      score: nf(lived),
      lines: [
        `${nf(days)} days, and the Earth has gone round the Sun ${life.years} times with you on it.`,
      ],
      againLabel: 'Use a different date',
    })
    shell.resultExtra.innerHTML =
      `<ul class="lw-facts">` +
      `<li>Your heart has beaten about <b>${nf(heartbeats)}</b> times.</li>` +
      `<li>You have taken roughly <b>${nf(breaths)}</b> breaths.</li>` +
      `<li>You have slept for about <b>${sleepYears.toFixed(1)} years</b> of it.</li>` +
      `<li>There have been <b>${nf(moons)}</b> full moons.</li>` +
      `<li>You have ridden the Earth about <b>${nf(sunKm / 1e9)} billion km</b> round the Sun.</li>` +
      `</ul><p class="lw-src">Heart rate and breathing use adult population averages, so treat them as an order of magnitude, not a measurement.</p>` +
      `<div class="lw-report-acts"><button type="button" class="pill pill--line pill--line-paper" id="shareBtn"><span>Share this</span></button></div>`
    el('shareBtn').addEventListener('click', async (e) => {
      const label = (e.currentTarget as HTMLElement).querySelector('span')!
      const card = {
        slug: 'life-in-weeks', siteName: SITE.name,
        headline: `${nf(lived)} weeks lived`,
        sub: `${life.pct.toFixed(1)}% of a ninety-year life.`,
        stats: [
          { label: 'Weeks left', value: nf(left.weeks) },
          { label: 'Days', value: nf(days) },
          { label: 'Full moons', value: nf(moons) },
        ],
      }
      const outcome = await shareResult(card, { title: 'Life in Weeks', text: card.headline + '.', url: location.href })
      label.textContent = outcomeLabel[outcome]
      setTimeout(() => (label.textContent = 'Share this'), 1600)
    })
    recordPlay('life-in-weeks', { weeks: lived }, { weeks: 'high' })
    unlock()
    count(0, lived, life.years)
    try { localStorage.setItem(KEY, dobStr) } catch {}
  }

  el('ask').addEventListener('submit', (e) => {
    e.preventDefault()
    // Only how the board came up, never the date.
    if (dobInput.value) {
      shell.pick('Grid shown from', changedVia ? 'A changed date' : 'A date typed in')
      if (changedVia) shell.pick('Date changed with', changedVia)
      changedVia = null
      show(dobInput.value)
    }
  })

  let changedVia: string | null = null
  function askAgain(via: string) {
    changedVia = via
    shell.reset()
    cancelAnimationFrame(raf)
    dob = null; lived = 0; litShown = 0; nowIdx = -1; look = -1; head = 0
    pins.fill(-1)
    for (const id of ['head', 'under', 'more']) el(id).hidden = true
    el('ask').hidden = false
    paint()
    el('ask').scrollIntoView({ block: 'center' })
    dobInput.focus({ preventScroll: true })
  }
  el('changeBtn').addEventListener('click', () => askAgain('The button under the grid'))
  // The result card's own button means the same thing here, and the shell
  // would otherwise reload the page — which brings the same date straight back.
  document.querySelector('[data-act="again"]')!.addEventListener('click', (e) => {
    e.stopPropagation()
    askAgain('The result card')
  }, { capture: true })

  el('world').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button')
    if (!b) return
    if (b.dataset.rm !== undefined) {
      mine.splice(+b.dataset.rm, 1)
      saveMine()
      shell.pick('Own date', 'Removed')
      place()
      setLook(-1)
      return
    }
    const i = +b.dataset.idx!
    if (pinnedLook && look === i) setLook(-1)
    else { setLook(i, true); sfx.tick(); if (tall) board.scrollIntoView({ block: 'nearest', behavior: prefersReducedMotion ? 'auto' : 'smooth' }) }
  })
  el('world').addEventListener('pointerover', (e) => {
    const b = (e.target as HTMLElement).closest('button')
    if (b && b.dataset.idx && (e as PointerEvent).pointerType === 'mouse' && !pinnedLook) setLook(+b.dataset.idx)
  })
  el('world').addEventListener('pointerleave', () => { if (!pinnedLook) setLook(-1) })

  try {
    const saved = localStorage.getItem(KEY)
    if (saved) { dobInput.value = saved; shell.pick('Grid shown from', 'A saved date'); show(saved) }
  } catch {}
</script>

<style is:global>
