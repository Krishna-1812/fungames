---
import GameShell from '../layouts/GameShell.astro'
import { DILEMMAS } from '../data/dilemmas'

/**
 * Trolley — the moral-dilemma archetype.
 *
 * The reference game shows "what % of players chose this", which needs a
 * backend collecting votes. Rather than invent plausible-looking percentages,
 * this version scores your own answers against four named ethical positions and
 * tells you which one you actually argued for. No fabricated statistics.
 *
 * The problems and the scoring live in data/dilemmas.ts, where every case
 * records what each position says about it. scripts/check-trolley.mjs plays the
 * whole game as a strict follower of each of the four and checks it gets named
 * correctly, and that no two positions agree often enough to be the same thing
 * under different names.
 *
 * In the shell: Score is lives saved against the worst outcome on offer each
 * time, Problem is progress, Moves are levers pulled. Best is the one number
 * here that is a skill rather than a verdict — how consistently you argued
 * for a single position. Nobody loses: there is no wrong ending.
 */
const total = DILEMMAS.length
const first = DILEMMAS[0]
---

<GameShell
  slug="trolley"
  labels={{ score: 'Lives saved', best: 'Most consistent', level: 'Problem', moves: 'Levers pulled' }}
  initial={{ score: '0', level: `1 / ${total}`, moves: '0' }}
>
  <div class="tr">
    <figure class="tr-scene">
      <svg id="scene" viewBox="0 0 320 152" aria-hidden="true"></svg>
      <ol class="tr-rail" id="rail" aria-hidden="true">
        {DILEMMAS.map(() => <li></li>)}
      </ol>
    </figure>

    <div class="tr-side">
      <p class="label meta" id="tag">Problem 1 of {total}</p>
      <h2 class="tr-title" id="title">{first.title}</h2>
      <p class="tr-setup" id="setup">{first.setup}</p>

      <div class="tr-choices" role="group" aria-label="Your choice">
        <button type="button" class="pill tr-choice" data-side="left" id="btnLeft">
          <kbd aria-hidden="true">←</kbd><span id="lblLeft">{first.left.label}</span>
        </button>
        <button type="button" class="pill tr-choice" data-side="right" id="btnRight">
          <kbd aria-hidden="true">→</kbd><span id="lblRight">{first.right.label}</span>
        </button>
      </div>

      <div class="tr-outcome" id="outcome" hidden>
        <p class="label tr-toll" id="toll">1 death</p>
        <p class="tr-outcome-text" id="outcomeText"></p>
        <button type="button" class="pill pill--ink" id="nextBtn">
          <span id="nextLbl">Next problem</span><span aria-hidden="true">→</span>
        </button>
        <p class="tr-keys"><kbd>N</kbd> or <kbd>Enter</kbd></p>
      </div>
    </div>
  </div>

  <Fragment slot="howto">
    <p>
      Twenty-six problems, one at a time. A trolley is coming. Each time you
      get two choices — usually <b>do nothing</b> or <b>pull the lever</b>.
    </p>
    <ul>
      <li>There is no right answer, and no way to lose.</li>
      <li>At the end your choices are compared against four ethical positions, and you are told which one you actually argued for — and how consistently.</li>
      <li>Nothing here is a crowd statistic. Every percentage is about your own answers.</li>
    </ul>
    <p>Keys: <kbd>←</kbd> or <kbd>1</kbd> for the left choice, <kbd>→</kbd> or <kbd>2</kbd> for the right, <kbd>N</kbd> for the next problem.</p>
  </Fragment>

  <details class="tr-real" slot="after">
    <summary class="label">Why there are no crowd percentages</summary>
    <p>
      The famous version of this game tells you what percentage of other
      players chose the same as you. That needs a server counting votes, and
      this site has none — so rather than invent plausible-looking numbers,
      every problem records what four named ethical positions say about it,
      and the ending measures you against those.
    </p>
    <p>
      A position that genuinely has nothing to say about a case is left out
      of that case, so it is never scored on a side it does not hold.
      <code>scripts/check-trolley.mjs</code> plays the whole game as a strict
      follower of each position and checks it comes out named correctly.
    </p>
  </details>
</GameShell>

<script>
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { recordPlay } from '../lib/stats'
  import { sfx, unlock, hit } from '../lib/audio'
  import { sceneSvg, GEO } from '../lib/trolley-scene'
  import { DILEMMAS, POSITIONS, scoreAnswers, REPEAT_OF_FIRST } from '../data/dilemmas'
  import type { Side } from '../data/dilemmas'
  import { dailyFor, dailyTarget } from '../data/game-meta'

  const TOTAL = DILEMMAS.length
  const $ = (id: string) => document.getElementById(id)!
  const SCENE = $('scene')
  const outcome = $('outcome')
  const btn = { left: $('btnLeft') as HTMLButtonElement, right: $('btnRight') as HTMLButtonElement }
  const rail = [...$('rail').children] as HTMLLIElement[]

  let i = 0
  let deaths = 0
  let pulls = 0
  let saved = 0
  let chosen = false
  /** One side per problem, in order — the only input the scoring needs. */
  let picks: Side[] = []

  const shell = createShell({ slug: 'trolley', onRestart: restart })

  /* ---- the scene ------------------------------------------------------ */

  function setTrolley(x: number, y: number) {
    document.getElementById('trolley')?.setAttribute('transform', `translate(${x},${y})`)
  }

  /** Roll to the end of whichever track was chosen. */
  let rolling = 0
  function rollTrolley(diverted: boolean, done: () => void) {
    cancelAnimationFrame(rolling)
    const sc = DILEMMAS[i].scene
    const endY = diverted && !sc.loop ? GEO.Y_BRANCH : GEO.Y_STRAIGHT
    const endX = GEO.STOP - 30
    if (!PLAY) { setTrolley(endX, endY); done(); return }
    const t0 = performance.now()
    const DUR = 780
    const step = (now: number) => {
      const u = Math.min(1, (now - t0) / DUR)
      const e = u * u * (3 - 2 * u)
      const x = GEO.START + (endX - GEO.START) * e
      // Only climbs once it is past the fork.
      const climb = Math.max(0, Math.min(1, (x - GEO.FORK) / (214 - GEO.FORK)))
      setTrolley(x, GEO.Y_STRAIGHT + (endY - GEO.Y_STRAIGHT) * climb * climb)
      if (u < 1) rolling = requestAnimationFrame(step)
      else done()
    }
    rolling = requestAnimationFrame(step)
  }

  /* ---- a problem ------------------------------------------------------ */

  function paintStrip() {
    shell.setScore(String(saved))
    shell.setLevel(`${Math.min(i + 1, TOTAL)} / ${TOTAL}`)
    shell.setMoves(String(pulls))
  }

  function render() {
    const d = DILEMMAS[i]
    chosen = false
    SCENE.innerHTML = sceneSvg(d.scene)
    $('tag').textContent = `Problem ${i + 1} of ${TOTAL}`
    $('title').textContent = d.title
    $('setup').textContent = d.setup
    $('lblLeft').textContent = d.left.label
    $('lblRight').textContent = d.right.label
    for (const b of [btn.left, btn.right]) { b.disabled = false; b.classList.remove('is-chosen') }
    outcome.hidden = true
    rail.forEach((li, k) => { li.className = k < i ? 'is-done' : k === i ? 'is-now' : '' })
    const side = document.querySelector('.tr-side')!
    side.classList.remove('is-turning')
    void (side as HTMLElement).offsetWidth
    side.classList.add('is-turning')
    paintStrip()
    if (i === Math.floor(TOTAL / 2)) shell.levelUp('Halfway.')
    else if (i === TOTAL - 1) shell.levelUp('Last one.')
  }

  function choose(side: Side) {
    if (chosen || shell.paused) return
    chosen = true
    const d = DILEMMAS[i]
    const opt = d[side]
    unlock()
    if (opt.acts) {
      // A mechanical clunk for the lever, then the trolley rolling on.
      hit({ dur: 0.07, gain: 0.3, freq: 340, q: 3 })
      hit({ dur: 0.5, gain: 0.16, freq: 220, sweepTo: 90, type: 'lowpass', delay: 0.08 })
    } else {
      hit({ dur: 0.6, gain: 0.14, freq: 200, sweepTo: 80, type: 'lowpass' })
    }
    deaths += opt.deaths
    saved += Math.max(d.left.deaths, d.right.deaths) - opt.deaths
    if (opt.acts) pulls++
    picks[i] = side

    btn[side].classList.add('is-chosen')
    btn.left.disabled = true
    btn.right.disabled = true
    // A lever that is not connected still throws; that is the joke. There is
    // no switch rail on the footbridge problem, and no lever to throw.
    if (opt.acts) document.getElementById('switchRail')?.classList.add('thrown')
    paintStrip()

    // The outcome waits for the trolley to arrive, so the picture and the text
    // land together instead of the text pre-empting it.
    rollTrolley(opt.acts, () => {
      const n = opt.deaths
      $('toll').textContent = n === 0 ? '✓ Nobody dies' : `${n} ${n === 1 ? 'death' : 'deaths'}`
      outcome.className = 'tr-outcome ' + (n === 0 ? 'is-none' : n >= 5 ? 'is-many' : 'is-some')
      $('outcomeText').textContent = opt.outcome
      $('nextLbl').textContent = i + 1 >= TOTAL ? 'See your verdict' : 'Next problem'
      outcome.hidden = false
      if (n >= 5) { sfx.thud(); shell.shake($('scene').parentElement!) }
      else if (n === 0) { sfx.sparkle(); shell.pop(outcome) }
      shell.announce(`${$('toll').textContent}. ${opt.outcome}`)
      rail[i].className = 'is-done'
      ;($('nextBtn') as HTMLButtonElement).focus({ preventScroll: true })
      outcome.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    })
  }

  function next() {
    if (!chosen || outcome.hidden) return
    unlock(); sfx.click()
    i++
    if (i < TOTAL) return render()
    finish()
  }

  btn.left.addEventListener('click', () => choose('left'))
  btn.right.addEventListener('click', () => choose('right'))
  $('nextBtn').addEventListener('click', next)

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || shell.paused || i >= TOTAL) return
    const t = e.target as HTMLElement
    if (t.closest('input, textarea, select, dialog')) return
    const k = e.key.toLowerCase()
    if (k === 'arrowleft' || k === '1') { e.preventDefault(); choose('left') }
    else if (k === 'arrowright' || k === '2') { e.preventDefault(); choose('right') }
    else if (k === 'n' || (k === 'enter' && !t.closest('button, a'))) { e.preventDefault(); next() }
  })

  /* ---- the verdict ---------------------------------------------------- */

  function finish() {
    /* Every percentage below is your own agreement rate with a position, over
       the problems that position actually takes a side on. Nothing here is a
       crowd statistic, because there is no crowd. */
    const scored = scoreAnswers(picks)
    const [top, runner] = scored
    const tie = top.pct === runner.pct

    shell.resultExtra.innerHTML = `
      <div class="tr-verdict">
        <dl class="tr-stats">
          <div><dt class="label">Deaths</dt><dd class="num">${deaths}</dd></div>
          <div><dt class="label">Levers pulled</dt><dd class="num">${pulls} / ${TOTAL}</dd></div>
          <div><dt class="label">Saved vs. the worst option</dt><dd class="num">${saved}</dd></div>
        </dl>
        <p class="label">How often you agreed with each</p>
        <ul class="tr-positions">${scored.map((s, k) => `
          <li class="${k === 0 ? 'is-top' : ''}">
            <p class="tr-pos-row"><b>${s.name}</b><span class="num">${s.pct}%</span></p>
            <span class="tr-bar"><i style="--w: ${s.pct / 100}"></i></span>
            <p>${POSITIONS[s.key].short}</p>
            <small>You agreed with it on ${s.agreed} of the ${s.of} problems it has a view about.</small>
          </li>`).join('')}
        </ul>
      </div>`

    // The twenty-fifth problem is the first one again. Whether you answered it
    // the same way is the one thing this game can measure about you directly.
    const changed = picks[0] && picks[REPEAT_OF_FIRST] && picks[0] !== picks[REPEAT_OF_FIRST]
    const stat = recordPlay('trolley', { position: top.name, pulls, saved, deaths }, { saved: 'high' })
    const beat = shell.considerBest(top.pct, `${top.pct}%`)

    const lines = [
      tie
        ? `You split evenly between ${top.name.toLowerCase()} and ${runner.name.toLowerCase()}, at ${top.pct}% each. No single account of your answers wins.`
        : top.pct >= 85
          ? `You argued for it ${top.pct}% of the time, which is more consistent than most people manage. Next closest: ${runner.name.toLowerCase()}, at ${runner.pct}%.`
          : `You argued for it ${top.pct}% of the time — ahead of ${runner.name.toLowerCase()} at ${runner.pct}%, but not by much. Most people are a mixture, and the mixture is the interesting part.`,
      changed
        ? 'Problem 25 was problem 1, word for word. You answered it differently the second time.'
        : 'Problem 25 was problem 1, word for word. You gave the same answer both times.',
    ]
    if (beat === 'beaten') lines.push('✓ Your most consistent run yet.')
    else if (beat === 'first') lines.push('Your first run — that consistency is the number to beat now.')
    else if (shell.best) lines.push(`Your most consistent run is still ${shell.best.text}.`)
    if (stat.plays > 1) lines.push(`Run ${stat.plays}.`)
    const now = new Date()
    if (dailyFor(now).slug === 'trolley') {
      const need = dailyTarget.consistency(now)
      lines.push(top.pct >= need ? `✓ Daily challenge beaten: ${need}% or more for one position.` : `✗ Daily challenge: argue for one position ${need}% of the time.`)
    }

    const article = (name: string) => (/^[aeio]/i.test(name) ? 'an' : 'a')
    shell.win({
      kicker: `${TOTAL} levers later`,
      title: tie ? 'Split down the middle.' : `You argued like ${article(top.name)} ${top.name.toLowerCase()}.`,
      score: `${top.pct}%`,
      from: '0%',
      lines,
      againLabel: 'Start again',
    })
  }

  function restart() {
    cancelAnimationFrame(rolling)
    i = 0; deaths = 0; pulls = 0; saved = 0; picks = []
    render()
    shell.stage.scrollIntoView({ behavior: 'smooth', block: 'start' })
    btn.left.focus({ preventScroll: true })
  }

  render()
</script>

<style is:global>
  /* The scene and the verdict are built by the script, so these rules are
     global on purpose. The drawing carries its own fills (see the header of
     lib/trolley-scene.ts); what is here is the frame around it and the two
     things that have to be CSS because they are animation. */
  .tr { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(18px, 3vw, 44px); align-items: start; }
  @media (max-width: 900px) { .tr { grid-template-columns: minmax(0, 1fr); } }

  .tr-scene { margin: 0; position: sticky; top: 16px; }
  /* One column: read the setup, see the picture, then choose. The side
     column dissolves into the grid so the scene can sit between the two. */
  @media (max-width: 900px) {
    .tr > .tr-side { display: contents; }
    .tr-scene { position: static; order: 1; }
    .tr-choices { order: 2; }
    .tr-outcome { order: 3; }
  }
  .tr-scene svg {
    display: block; width: 100%; height: auto;
    border: 2px solid var(--ink); border-radius: var(--r-lg);
    overflow: hidden;
  }
  .tr-scene .switch { transform-box: fill-box; transform-origin: 0% 100%; }
  .tr-scene .switch.thrown { transform: rotate(38deg); }
  html.play .tr-scene .switch { transition: transform 300ms var(--spring); }

  /* Twenty-six sleepers: the ones behind you are ink, this one is cobalt. */
  .tr-rail { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(26, minmax(0, 1fr)); gap: 3px; }
  .tr-rail li { height: 10px; border-radius: 3px; background: var(--paper3); }
  .tr-rail li.is-done { background: var(--ink); }
  .tr-rail li.is-now { background: var(--cobalt); }

  .tr-side { display: grid; gap: 14px; align-content: start; }
  .tr-title { font-size: var(--fs-h2); line-height: 0.98; }
  .tr-setup { font-size: var(--fs-lead); line-height: 1.5; color: var(--ink2); max-width: 44ch; text-wrap: pretty; }

  .tr-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 6px; }
  @media (max-width: 480px) { .tr-choices { grid-template-columns: minmax(0, 1fr); } }
  .tr-choice {
    --pill-flood: var(--ink);
    --pill-flood-ink: var(--ink-paper);
    min-height: 64px; justify-content: flex-start; padding: 0 20px 0 12px;
    background: var(--card); color: var(--ink); border-color: var(--ink);
    font-size: 16px; font-weight: 700; white-space: normal; text-align: left; line-height: 1.2;
  }
  .tr-choice:not([disabled]):hover { background: var(--ink); color: var(--ink-paper); }
  .tr-choice kbd {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: var(--paper2); color: var(--ink); font: 700 15px/1 var(--sans);
  }
  .tr-choice.is-chosen, .tr-choice.is-chosen[disabled] { background: var(--ink); color: var(--ink-paper); opacity: 1; }
  .tr-choice.is-chosen kbd { background: var(--cobalt); }

  /* The toll, in whole blocks: nobody is sky, a few is lilac, many is red.
     The words always say the number too. */
  .tr-outcome { display: grid; gap: 10px; justify-items: start; margin-top: 4px; padding: 22px; border-radius: var(--r-lg); color: var(--ink); background: var(--lilac); box-shadow: var(--shadow-block); }
  .tr-outcome.is-none { background: var(--sky); }
  .tr-outcome.is-many { background: var(--red); }
  .tr-toll { font-size: 13px; }
  .tr-outcome-text { font-size: 17px; line-height: 1.45; font-weight: 500; max-width: 46ch; text-wrap: pretty; }
  .tr-keys { font-size: 13px; }
  .tr-keys kbd, .tr-real kbd {
    display: inline-block; min-width: 22px; padding: 0 6px; border-radius: 6px;
    border: 1.5px solid currentColor; font: 700 12px/1.5 var(--sans); text-align: center;
  }

  /* ---- the verdict, inside the ink result card ---------------------- */
  .tr-verdict { display: grid; gap: 16px; }
  .tr-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0 0 12px; }
  @media (max-width: 560px) { .tr-stats { grid-template-columns: minmax(0, 1fr); } }
  .tr-stats div { padding: 16px 18px; border-radius: var(--r); box-shadow: inset 0 0 0 1.5px rgba(246, 244, 240, 0.28); }
  .tr-stats dd { margin: 10px 0 0; font-size: clamp(30px, 4vw, 48px); }
  .tr-positions { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; max-width: 70ch; }
  .tr-positions li { display: grid; gap: 6px; padding-top: 14px; border-top: 1px solid rgba(246, 244, 240, 0.22); }
  .tr-pos-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .tr-pos-row b { font-size: 18px; }
  .tr-pos-row .num { font-size: 22px; }
  .tr-positions li.is-top .tr-pos-row { color: var(--mint); }
  .tr-bar { display: block; height: 8px; border-radius: 4px; background: rgba(246, 244, 240, 0.18); overflow: hidden; }
  .tr-bar i { display: block; height: 100%; background: var(--ink-paper); transform-origin: left center; transform: scaleX(var(--w, 0)); }
  .tr-positions li.is-top .tr-bar i { background: var(--mint); }
  .tr-positions p:not(.tr-pos-row) { font-size: 15px; opacity: 0.86; }
  .tr-positions small { font-size: 13px; opacity: 0.7; }

  .tr-real { margin-top: 16px; padding: 20px 24px; border-radius: var(--r-lg); background: var(--card); box-shadow: var(--shadow-block); }
  .tr-real summary { cursor: pointer; }
  .tr-real p { margin-top: 12px; max-width: 64ch; color: var(--ink2); }
  .tr-real code { font-size: 13px; background: var(--paper2); padding: 1px 6px; border-radius: 6px; }

  /* ---- motion: armed only under html.play --------------------------- */
  html.play .tr-side.is-turning > * { animation: tr-turn 520ms var(--ease) both; }
  @keyframes tr-turn { from { opacity: 0; transform: translateY(12px); } }
  html.play .tr-outcome:not([hidden]) { animation: tr-settle 620ms var(--spring) both; }
  @keyframes tr-settle { from { transform: scale(0.94); border-radius: 48px; } }
  html.play .result.is-in .tr-bar i { animation: tr-bar 1100ms var(--glide) 500ms both; }
  /* Both ends explicit: a from-only keyframe resolving to an inline
     transform was painted at its start state once finished. */
  @keyframes tr-bar { from { transform: scaleX(0); } to { transform: scaleX(var(--w, 0)); } }
</style>
