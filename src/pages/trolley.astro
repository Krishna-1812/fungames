---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * Trolley — the moral-dilemma archetype.
 *
 * The reference game shows "what % of players chose this", which needs a
 * backend collecting votes. Rather than invent plausible-looking percentages,
 * this version scores your own answers against four named ethical positions and
 * tells you which one you actually argued for. No fabricated statistics.
 *
 * The problems and the scoring live in data/dilemmas.ts, where every case
 * records what each position says about it. scripts/check-trolley.mjs plays the
 * whole game as a strict follower of each of the four and checks it gets named
 * correctly, and that no two positions agree often enough to be the same thing
 * under different names.
 */

---

<GameLayout slug="trolley" bar="#3d1f14" bodyClass="trolley-body">
  <div class="wrap">
    <header class="head">
      <h1>Trolley</h1>
      <p class="lede">Twenty-six levers. There is no right answer, but there is definitely a you-shaped pattern.</p>
    </header>

    <div class="dots" id="dots" aria-hidden="true"></div>

    <section class="card" id="card" aria-live="polite">
      <div class="tag" id="tag">Problem 1 of 26</div>
      <h2 id="title">—</h2>
      <p class="setup" id="setup">—</p>

<svg class="scene" id="scene" viewBox="0 0 320 152" aria-hidden="true"></svg>

      <div class="choices">
        <button type="button" class="choice" data-side="left" id="btnLeft"></button>
        <button type="button" class="choice" data-side="right" id="btnRight"></button>
      </div>

      <div class="outcome" id="outcome" hidden>
        <p id="outcomeText"></p>
        <button type="button" id="nextBtn">Next →</button>
      </div>
    </section>

    <section class="verdict" id="verdict" hidden>
      <h2>Your verdict</h2>
      <div class="stat-row">
        <div class="stat"><b id="vDeaths">0</b><span>deaths</span></div>
        <div class="stat"><b id="vPulls">0</b><span>levers pulled</span></div>
        <div class="stat"><b id="vSaved">0</b><span>lives saved vs. doing nothing</span></div>
      </div>
      <h3 id="vLabel">—</h3>
      <p id="vBlurb"></p>
      <ul class="positions" id="vBars"></ul>
      <p class="repeat" id="vRepeat"></p>
      <div class="verdict-actions">
        <button type="button" data-share data-title="Trolley">Share</button>
        <button type="button" id="againBtn" class="ghost">Start again</button>
      </div>
    </section>
  </div>
</GameLayout>

  <script>
  import { burst, shake, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock, hit } from '../lib/audio'
  import { DILEMMAS, POSITIONS, scoreAnswers, REPEAT_OF_FIRST } from '../data/dilemmas'

  const el = (id) => document.getElementById(id)
  const dots = el('dots')
  const card = el('card')
  const outcome = el('outcome')
  const verdict = el('verdict')

  let i = 0
  let deaths = 0
  let pulls = 0
  let answered = []
  /** One side per problem, in order — the only input the scoring needs. */
  let picks = []

  dots.replaceChildren(
    ...DILEMMAS.map(() => {
      const d = document.createElement('span')
      d.className = 'dot'
      return d
    })
  )
  const dotEls = [...dots.children]

  /* ----------------------------------------------------------------------
     The scene.

     Twelve problems used to share one picture: a line, some sleepers, a dot,
     and a diagonal. Nobody was on either track, so the one thing every dilemma
     turns on -- who is where -- was the one thing the illustration did not say.
     ---------------------------------------------------------------------- */

  const SCENE = el('scene')
  const Y_STRAIGHT = 112
  const Y_BRANCH = 58
  const FORK = 148
  const STOP = 268          // where the trolley ends up, just short of the group

  /** One person: a head and a body, which reads at twelve pixels. */
  function person(x, y, cls) {
    return '<g class="fig ' + cls + '">' +
      '<circle cx="' + x + '" cy="' + (y - 15) + '" r="3.4"/>' +
      '<path d="M' + x + ' ' + (y - 11) + ' v7 M' + (x - 4) + ' ' + (y - 8) + ' h8 ' +
             'M' + x + ' ' + (y - 4) + ' l-3.5 4.5 M' + x + ' ' + (y - 4) + ' l3.5 4.5"/>' +
      '</g>'
  }

  /** Not a person, and it has to be obvious at a glance that it is not. */
  function lobster(x, y) {
    return '<g class="fig lobster">' +
      '<ellipse cx="' + x + '" cy="' + (y - 5) + '" rx="4.2" ry="3"/>' +
      '<circle cx="' + (x - 4) + '" cy="' + (y - 9) + '" r="1.7"/>' +
      '<circle cx="' + (x + 4) + '" cy="' + (y - 9) + '" r="1.7"/>' +
      '</g>'
  }

  /** Not a person either, and rounder than a lobster so the two do not blur. */
  function chicken(x, y) {
    return '<g class="fig chicken">' +
      '<ellipse cx="' + x + '" cy="' + (y - 5) + '" rx="3.6" ry="4.2"/>' +
      '<circle cx="' + x + '" cy="' + (y - 11) + '" r="2.4"/>' +
      '<path d="M' + (x + 2.2) + ' ' + (y - 11) + ' l3 1.4 l-3 1.4z"/>' +
      '</g>'
  }

  function tokens(t, cx, y) {
    if (!t || t.kind === 'empty' || !t.n) return ''
    if (t.kind === 'box') {
      return '<g class="fig box">' +
        '<rect x="' + (cx - 19) + '" y="' + (y - 30) + '" width="38" height="30" rx="3"/>' +
        '<text x="' + cx + '" y="' + (y - 10) + '" text-anchor="middle">?</text></g>'
    }
    // Fifty million people and ten thousand chickens cannot be drawn one at a
    // time, so a handful stand for the group and the number is written above
    // them. Pretending the picture is a headcount would be worse than saying so.
    const pitch = t.label ? 9 : 13
    const n = t.n
    const x0 = cx - ((n - 1) * pitch) / 2
    let out = ''
    for (let k = 0; k < n; k++) {
      const x = x0 + k * pitch
      if (t.kind === 'lobsters') out += lobster(x, y)
      else if (t.kind === 'chickens') out += chicken(x, y)
      else out += person(x, y, t.kind === 'you' ? 'self' : t.kind === 'friend' ? 'friend' : '')
    }
    if (t.label) out += '<text class="mark" x="' + cx + '" y="' + (y - 26) + '" text-anchor="middle">' + t.label + '</text>'
    // A small tick over a group that signed the form; the dilemma turns on it.
    if (t.consent) out += '<text class="mark" x="' + cx + '" y="' + (y - 26) + '" text-anchor="middle">signed</text>'
    if (t.kind === 'you') out += '<text class="mark" x="' + cx + '" y="' + (y - 26) + '" text-anchor="middle">you</text>'
    if (t.kind === 'friend') out += '<text class="mark" x="' + cx + '" y="' + (y - 26) + '" text-anchor="middle">friend</text>'
    return out
  }

  function sleepers(x1, x2, y, step) {
    let out = ''
    for (let x = x1; x <= x2; x += step) out += '<path class="tie" d="M' + x + ' ' + (y - 7) + ' v14"/>'
    return out
  }

  function drawScene(d) {
    const sc = d.scene
    // The branch leaves the fork, climbs, and runs on; or loops back into the
    // straight track at exactly the point the person is standing.
    const branchPath = sc.loop
      ? 'M' + FORK + ' ' + Y_STRAIGHT + ' C 178 ' + Y_BRANCH + ', 214 ' + Y_BRANCH + ', 236 ' + Y_BRANCH +
        ' C 262 ' + Y_BRANCH + ', 286 ' + (Y_BRANCH + 20) + ', 286 ' + Y_STRAIGHT
      : 'M' + FORK + ' ' + Y_STRAIGHT + ' C 176 ' + Y_STRAIGHT + ', 186 ' + Y_BRANCH + ', 214 ' + Y_BRANCH + ' H 312'

    SCENE.innerHTML =
      sleepers(16, 140, Y_STRAIGHT, 15) +
      sleepers(160, 312, Y_STRAIGHT, 15) +
      (sc.loop || sc.bridge ? '' : sleepers(222, 312, Y_BRANCH, 15)) +
      '<path class="rail" d="M8 ' + Y_STRAIGHT + ' H 312"/>' +
      (sc.bridge ? '' : '<path class="rail branch' + (sc.dead ? ' dead' : '') + '" d="' + branchPath + '"/>') +
      // On the footbridge case there is no second track and no lever at all —
      // drawing one would contradict the setup, which is the whole point of
      // that problem.
      (sc.bridge
        ? '<path class="bridge" d="M96 ' + (Y_STRAIGHT - 46) + ' H 200"/>' +
          '<path class="bridge leg" d="M100 ' + (Y_STRAIGHT - 46) + ' v34 M196 ' + (Y_STRAIGHT - 46) + ' v34"/>' +
          person(172, Y_STRAIGHT - 46, 'bystander')
        : '<path class="stand" d="M' + (FORK - 26) + ' ' + (Y_STRAIGHT + 12) + ' v-16"/>' +
          '<path class="switch" id="switchRail" d="M' + (FORK - 26) + ' ' + (Y_STRAIGHT - 4) + ' l14 -9"/>') +
      tokens(sc.straight, STOP, Y_STRAIGHT) +
      (sc.loop ? '' : tokens(sc.branch, STOP, Y_BRANCH)) +
      (sc.money ? '<text class="mark money" x="' + STOP + '" y="' + (Y_BRANCH - 26) + '" text-anchor="middle">$1,000,000</text>' : '') +
      // The trolley itself, parked at the left until a choice is made.
      '<g class="trolley" id="trolley">' +
        '<rect x="-13" y="-19" width="26" height="15" rx="3.5"/>' +
        '<rect class="win" x="-9" y="-16" width="8" height="6" rx="1.5"/>' +
        '<circle cx="-7" cy="-2.5" r="2.6"/><circle cx="7" cy="-2.5" r="2.6"/>' +
      '</g>'
    setTrolley(28, Y_STRAIGHT)
  }

  function setTrolley(x, y) {
    const g = el('trolley')
    if (g) g.setAttribute('transform', 'translate(' + x + ',' + y + ')')
  }

  /** Roll to the end of whichever track was chosen. */
  let rolling = 0
  function rollTrolley(diverted, done) {
    cancelAnimationFrame(rolling)
    const sc = DILEMMAS[i].scene
    const endY = diverted && !sc.loop ? Y_BRANCH : Y_STRAIGHT
    const endX = STOP - 26
    if (prefersReducedMotion) { setTrolley(endX, endY); done(); return }
    const t0 = performance.now()
    const DUR = 780
    const step = (now) => {
      const u = Math.min(1, (now - t0) / DUR)
      const e = u * u * (3 - 2 * u)
      const x = 28 + (endX - 28) * e
      // Only climbs once it is past the fork.
      const climb = Math.max(0, Math.min(1, (x - FORK) / (214 - FORK)))
      const y = Y_STRAIGHT + (endY - Y_STRAIGHT) * climb * climb
      setTrolley(x, y)
      if (u < 1) rolling = requestAnimationFrame(step)
      else done()
    }
    rolling = requestAnimationFrame(step)
  }

  function render() {
    const d = DILEMMAS[i]
    drawScene(d)
    el('tag').textContent = `Problem ${i + 1} of ${DILEMMAS.length}`
    el('title').textContent = d.title
    el('setup').textContent = d.setup
    el('btnLeft').textContent = d.left.label
    el('btnRight').textContent = d.right.label
    el('btnLeft').disabled = false
    el('btnRight').disabled = false
    outcome.hidden = true
    card.classList.remove('resolved')
    dotEls.forEach((dot, k) => dot.classList.toggle('done', k < i))
    card.classList.remove('enter')
    void card.offsetWidth
    card.classList.add('enter')
  }

  function choose(side) {
    const d = DILEMMAS[i]
    const opt = side === 'left' ? d.left : d.right
    unlock()
    if (opt.acts) {
      // A mechanical clunk for the lever, then the trolley rolling on.
      hit({ dur: 0.07, gain: 0.3, freq: 340, q: 3 })
      hit({ dur: 0.5, gain: 0.16, freq: 220, sweepTo: 90, type: 'lowpass', delay: 0.08 })
    } else {
      hit({ dur: 0.6, gain: 0.14, freq: 200, sweepTo: 80, type: 'lowpass' })
    }
    if (opt.deaths >= 5) { sfx.thud(); shake(document.querySelector('.card'), 7, 300) }
    else if (opt.deaths === 0) sfx.sparkle()
    deaths += opt.deaths
    if (opt.acts) pulls++
    answered.push({ deaths: opt.deaths, acts: opt.acts, min: Math.min(d.left.deaths, d.right.deaths) })
    picks[i] = side

    el('btnLeft').disabled = true
    el('btnRight').disabled = true
    card.classList.add('resolved')
    // A lever that is not connected still throws; that is the joke.
    // There is no switch rail on the footbridge problem, and no lever to throw.
    if (opt.acts) el('switchRail')?.classList.add('thrown')

    // The outcome waits for the trolley to arrive, so the picture and the text
    // land together instead of the text pre-empting it.
    el('outcomeText').textContent = opt.outcome
    rollTrolley(opt.acts, () => {
      outcome.hidden = false
      el('nextBtn').focus({ preventScroll: true })
    })
  }

  el('btnLeft').addEventListener('click', () => choose('left'))
  el('btnRight').addEventListener('click', () => choose('right'))

  el('nextBtn').addEventListener('click', () => {
    unlock(); sfx.click()
    i++
    if (i < DILEMMAS.length) return render()
    finish()
  })

  function finish() {
    card.hidden = true
    dots.hidden = true
    // "Saved" measured against the worst available outcome each round, so the
    // number means something rather than being a raw body count.
    const worst = DILEMMAS.reduce((a, d) => a + Math.max(d.left.deaths, d.right.deaths), 0)
    const saved = worst - deaths
    const optimal = answered.filter((a) => a.deaths === a.min).length

    el('vDeaths').textContent = String(deaths)
    el('vPulls').textContent = String(pulls)
    el('vSaved').textContent = String(saved)

    /* Every percentage below is your own agreement rate with a position, over
       the problems that position actually takes a side on. Nothing here is a
       crowd statistic, because there is no crowd. */
    const scored = scoreAnswers(picks)
    el('vBars').innerHTML = scored.map((s) =>
      `<li class="pos${s === scored[0] ? ' top' : ''}">
         <div class="posrow"><b>${s.name}</b><span>${s.pct}%</span></div>
         <div class="bar"><i style="width:${s.pct}%"></i></div>
         <p>${POSITIONS[s.key].short}</p>
         <small>You agreed with it on ${s.agreed} of the ${s.of} problems it has a view about.</small>
       </li>`).join('')

    const top = scored[0]
    const runner = scored[1]
    el('vLabel').textContent = top.name
    el('vBlurb').textContent =
      top.pct === runner.pct
        ? `You split evenly between ${top.name.toLowerCase()} and ${runner.name.toLowerCase()}, at ${top.pct}% each. No single account of your answers wins.`
        : top.pct >= 85
          ? `You argued for it ${top.pct}% of the time, which is more consistent than most people manage. The next closest was ${runner.name.toLowerCase()}, at ${runner.pct}%.`
          : `You argued for it ${top.pct}% of the time — ahead of ${runner.name.toLowerCase()} at ${runner.pct}%, but not by much. Most people are a mixture, and the mixture is the interesting part.`

    // The twenty-fifth problem is the first one again. Whether you answered it
    // the same way is the one thing this game can measure about you directly.
    const changed = picks[0] && picks[REPEAT_OF_FIRST] && picks[0] !== picks[REPEAT_OF_FIRST]
    el('vRepeat').textContent = changed
      ? 'Problem 25 was problem 1, word for word. You answered it differently the second time.'
      : 'Problem 25 was problem 1, word for word. You gave the same answer both times.'

    verdict.hidden = false
    sfx.great()
    burst(innerWidth / 2, innerHeight * 0.4, {
      count: 26, colors: ['#d97742', '#3d1f14', '#ffd166'], speed: 5, gravity: 0.2, life: 50, size: 4,
    })
    verdict.scrollIntoView({ behavior: 'smooth', block: 'center' })
  }

  el('againBtn').addEventListener('click', () => {
    i = 0; deaths = 0; pulls = 0; answered = []; picks = []
    card.hidden = false; dots.hidden = false; verdict.hidden = true
    render()
    card.scrollIntoView({ behavior: 'smooth', block: 'center' })
  })

  render()
</script>

<style>
  :global(.trolley-body) { background: #fbf3ec; }

  .wrap { max-width: 720px; margin: 0 auto; padding: 44px 22px 80px; }
  .head { text-align: center; margin-bottom: 26px; }
  .head h1 { font-size: clamp(34px, 6vw, 52px); }
  .lede { color: var(--ink-soft); margin: 10px auto 0; max-width: 44ch; }

  .dots { display: flex; justify-content: center; gap: 6px; margin-bottom: 18px; }
  .dots :global(.dot) {
    width: 7px; height: 7px; border-radius: 50%;
    background: #e2d3c6; transition: background 200ms var(--ease);
  }
  .dots :global(.dot.done) { background: #d97742; }

  .card {
    background: #fff; border: 1px solid #ecdccd; border-radius: var(--radius-lg);
    padding: 26px 24px 22px; box-shadow: var(--shadow);
  }
  .card.enter { animation: slide 300ms var(--ease); }
  @keyframes slide { from { opacity: 0; transform: translateY(10px); } }

  .tag {
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: #a3542f; font-weight: 600;
  }
  .card h2 { font-size: clamp(24px, 4vw, 32px); margin: 6px 0 10px; }
  .setup { margin: 0; font-size: 16.5px; color: #4b4038; text-wrap: pretty; }

  .scene { display: block; width: 100%; height: auto; margin: 16px 0 4px; overflow: visible; }
/* Every node below .scene is built at runtime, and runtime-created nodes do
     not carry Astro's scoped-style attribute -- so without :global these
     rules silently match nothing and the SVG falls back to fill:black,
     stroke:none. That renders the branch rail as a solid black wedge. */
  .scene :global(.rail) { fill: none; stroke: #c9ab96; stroke-width: 4; stroke-linecap: round; }
  /* A lever wired to nothing, drawn as wired to nothing. */
  .scene :global(.rail.branch.dead) { stroke: #ded0c4; stroke-dasharray: 7 7; }
  .scene :global(.tie) { fill: none; stroke: #e8dbd0; stroke-width: 3; stroke-linecap: round; }
  .scene :global(.stand) { fill: none; stroke: #b9a08d; stroke-width: 3; stroke-linecap: round; }
  .scene :global(.switch) {
    fill: none; stroke: #d97742; stroke-width: 4.5; stroke-linecap: round;
    transform-box: fill-box; transform-origin: 0% 100%;
    transition: transform 300ms var(--ease);
  }
  .scene :global(.switch.thrown) { transform: rotate(38deg); }

  .scene :global(.fig path) { fill: none; stroke: #6b4a37; stroke-width: 2; stroke-linecap: round; }
  .scene :global(.fig circle) { fill: #6b4a37; }
  .scene :global(.fig.self path) { stroke: #b5643c; }
  .scene :global(.fig.self circle) { fill: #b5643c; }
  .scene :global(.fig.friend path) { stroke: #8a5a9e; }
  .scene :global(.fig.friend circle) { fill: #8a5a9e; }
  .scene :global(.fig.lobster ellipse), .scene :global(.fig.lobster circle) { fill: #c0442e; }
  .scene :global(.fig.chicken ellipse), .scene :global(.fig.chicken circle) { fill: #b98a3d; }
  .scene :global(.fig.chicken path) { fill: #c0442e; stroke: none; }
  /* The bystander on the footbridge is the one you would have to push, so they
     are marked out from the five on the track below. */
  .scene :global(.fig.bystander path) { stroke: #8a5a9e; }
  .scene :global(.fig.bystander circle) { fill: #8a5a9e; }
  .scene :global(.bridge) { fill: none; stroke: #9c7f6a; stroke-width: 3; stroke-linecap: round; }
  .scene :global(.bridge.leg) { stroke-width: 2.2; opacity: 0.75; }
  .scene :global(.fig.box rect) { fill: #efe1d5; stroke: #b9a08d; stroke-width: 2.5; }
  /* Darker than the other marks because it sits on the box fill, not on the
     card: #8a6a55 measured 3.84:1 there. */
  .scene :global(.fig.box text) { fill: #5f4232; font-size: 15px; font-weight: 700; }
  .scene :global(.mark) {
    fill: #8a6a55; font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600;
  }
  .scene :global(.mark.money) { fill: #3f6b4c; font-size: 10px; letter-spacing: 0; text-transform: none; }
  .scene :global(.trolley rect) { fill: #3d1f14; }
  .scene :global(.trolley circle) { fill: #2a140c; }
  .scene :global(.trolley .win) { fill: #d9b9a3; }

  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }
  .choice {
    border: 1px solid #e3cdbb; background: #fff; border-radius: 14px;
    padding: 15px 14px; font-size: 15.5px; font-weight: 600; cursor: pointer;
    transition: transform 140ms var(--ease), border-color 140ms var(--ease), background 140ms var(--ease);
  }
  .choice:hover:not(:disabled) { transform: translateY(-2px); border-color: #d97742; background: #fff8f3; }
  .choice:disabled { opacity: 0.45; cursor: default; }

  .outcome {
    margin-top: 16px; padding-top: 16px; border-top: 1px dashed #ecdccd;
    animation: slide 260ms var(--ease);
  }
  .outcome p { margin: 0 0 14px; color: #4b4038; font-size: 16px; text-wrap: pretty; }
  .outcome button, .verdict-actions button {
    border: 0; border-radius: 999px; padding: 11px 24px;
    background: #3d1f14; color: #fff; font-weight: 600; cursor: pointer;
    transition: filter 140ms var(--ease), transform 180ms var(--ease-bounce);
  }
  .outcome button:hover { filter: brightness(1.15); transform: translateY(-2px) scale(1.03); }
  .outcome button:active, .verdict-actions button:active { transform: scale(0.96); }

  .verdict {
    background: #fff; border: 1px solid #ecdccd; border-radius: var(--radius-lg);
    padding: 30px 24px; text-align: center; box-shadow: var(--shadow);
    animation: slide 320ms var(--ease);
  }
  .verdict h2 { font-size: 26px; }
  .stat-row { display: flex; justify-content: center; gap: 26px; flex-wrap: wrap; margin: 20px 0 22px; }
  .stat { display: grid; }
  .stat b { font-family: var(--display); font-size: 38px; font-variant-numeric: tabular-nums; }
  .stat span { font-size: 12px; color: var(--ink-soft); max-width: 14ch; }
  .verdict h3 { font-size: 28px; color: #b5643c; }
  .verdict p { color: #4b4038; max-width: 48ch; margin: 10px auto 0; text-wrap: pretty; }
  /* The four positions, best first. Left-aligned inside a centred card because
     these are paragraphs to read, not figures to scan. */
  /* The list items are built in JS, and JS-created nodes never get Astro's
     scoped-style attribute — so everything below the <ul> has to be :global,
     the same way the scene figures are. Without this the bars simply do not
     exist and the name and percentage run together. */
  .positions { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 16px; text-align: left; }
  .positions :global(.pos) { border-top: 1px solid #ecdccd; padding-top: 14px; }
  .positions :global(.posrow) { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .positions :global(.posrow b) { font-size: 16px; }
  .positions :global(.posrow span) { font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--ink-soft); font-size: 15px; }
  .positions :global(.pos.top .posrow b), .positions :global(.pos.top .posrow span) { color: #a84f2a; }
  .positions :global(.bar) { height: 7px; border-radius: 4px; background: #f0e2d6; overflow: hidden; margin: 7px 0 9px; }
  .positions :global(.bar i) { display: block; height: 100%; background: #c98a5e; transition: width 600ms var(--ease); }
