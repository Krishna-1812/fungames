---
import { iconSvg } from '../lib/icons'
import Base from '../layouts/Base.astro'
import Backdrop from '../components/Backdrop.astro'
import { SITE } from '../site.config'
import { withBase } from '../lib/base'
---

<Base title={`Lost — ${SITE.name}`} favicon="compass" noindex>
  <Backdrop variant="paper" />
  <div class="lost">
    <span class="glyph" aria-hidden="true" set:html={iconSvg('compass')} />
    <h1>Nothing here</h1>
    <p>That page does not exist, or it was retired.</p>
    <a class="btn" href={withBase('/')}>Back to the games →</a>
  </div>
</Base>

<style>
  .lost {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 8px;
    padding: 24px;
    animation: rise-in 480ms var(--ease) backwards;
  }
  .glyph {
    /* The drawing sizes itself from inside — see iconSvg. A rule here that
       targeted the <svg> would not apply to it, because it arrives via
       set:html. */
    display: inline-block;
    width: 44px;
    height: 44px;
    margin-bottom: 6px;
    filter: drop-shadow(0 8px 18px rgba(20, 18, 28, 0.14));
    /* A compass that can't settle — it's lost too. */
    animation: spin-hunt 3.6s ease-in-out infinite;
  }
  @keyframes spin-hunt {
    0%, 100% { transform: rotate(-14deg); }
    50% { transform: rotate(14deg); }
  }
  h1 { font-size: 48px; margin: 0; }
  p { color: var(--ink-soft); margin: 0; }
  .btn {
    margin-top: 16px;
    border: var(--sticker-border);
    border-radius: 999px;
    padding: 10px 22px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    background: linear-gradient(180deg, #fff 0%, color-mix(in oklab, var(--card) 88%, var(--line)) 100%);
    box-shadow: var(--sticker-shadow);
    transition: transform 180ms var(--ease-bounce), box-shadow 180ms var(--ease-bounce);
  }
  .btn:hover {
    transform: translateY(-3px) rotate(-1.5deg);
    box-shadow: var(--sticker-shadow-hover);
  }
  .btn:active { transform: translateY(0) rotate(0deg); box-shadow: 1px 2px 0 rgba(22, 21, 26, 0.18); }
  @keyframes rise-in { from { opacity: 0; transform: translateY(10px); } }
</style>
