---
import GameLayout from '../layouts/GameLayout.astro'

/**
 * Steady Hand — draw one unbroken stroke between two dots.
 *
 * Scoring is honest geometry, not vibes: every sampled point's perpendicular
 * distance to the ideal segment is measured, averaged, and normalised by the
 * segment length, so the difficulty does not change when the dots move.
 */
---

<GameLayout slug="steady-hand" bar="#5b2333" fixed>
  <div class="stage">
    <h1 class="visually-hidden">Steady Hand</h1>
    {/* Behind the canvas, which clears to transparent. */}
    <div class="felt" id="felt" aria-hidden="true"></div>
    <canvas id="c"></canvas>

    <div class="hud">
      <div class="hint" id="hint">Press on the first dot and drag to the second. One stroke.</div>
      <div class="scores">
        <div><span class="k">Last</span><b id="last">—</b></div>
        <div><span class="k">Best</span><b id="best">—</b></div>
        <div><span class="k">Tries</span><b id="tries">0</b></div>
      </div>
    </div>

    <div class="result" id="result" hidden>
      <div class="big" id="bigScore">0.0%</div>
      <div class="verdict" id="verdict"></div>
      <button type="button" id="again">Again</button>
    </div>
  </div>
</GameLayout>

<script>
  import { burst, ring, floatText, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface } from '../lib/gl'
  import { FELT_FRAG } from '../lib/steady-felt'
  const canvas = document.getElementById('c')
  const ctx = canvas.getContext('2d')
  const hint = document.getElementById('hint')
  const elLast = document.getElementById('last')
  const elBest = document.getElementById('best')
  const elTries = document.getElementById('tries')
  const result = document.getElementById('result')
  const bigScore = document.getElementById('bigScore')
  const verdict = document.getElementById('verdict')
  const again = document.getElementById('again')

  const STORE = 'steady-hand:best'
  const DOT_R = 14        // visual radius of a target dot
  const SNAP = 46         // how close the stroke must start/end to a dot
  // Average deviation of this fraction of the segment length scores zero.
  const TOLERANCE = 0.06

  let W = 0, H = 0, dpr = 1
  let A = { x: 0, y: 0 }, B = { x: 0, y: 0 }
  let stroke = []
  let drawing = false
  let locked = false
  let tries = 0
  let best = Number(localStorage.getItem(STORE) || 0) || 0
  if (best) elBest.textContent = best.toFixed(1) + '%'

  /* Canvas CSS pixels to the space centred() builds: origin at the middle,
     units of half the short axis, y upward. */
  function toField(q) {
    const m = Math.min(W, H) || 1
    return [(2 * q.x - W) / m, (H - 2 * q.y) / m]
  }

  let pen = { x: 0, y: 0 }
  const felt = new ShaderSurface(document.getElementById('felt'), FELT_FRAG, {
    // Every layer is low frequency by design; see the note in steady-felt.ts.
    scale: 0.7,
    uniforms: () => ({
      u_a: toField(A),
      u_b: toField(B),
      u_pen: toField(pen),
      u_penOn: drawing ? 1 : 0,
      u_locked: locked ? 1 : 0,
      u_motion: prefersReducedMotion ? 0 : 1,
    }),
  })
  // Under reduced motion the shared ticker never runs, so the surface has to be
  // asked for the frames that matter.
  function nudge() { if (prefersReducedMotion) felt.redraw() }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2)
    W = canvas.clientWidth
    H = canvas.clientHeight
    canvas.width = Math.round(W * dpr)
    canvas.height = Math.round(H * dpr)
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    place()
  }

  function place() {
    /* Keep the pair long enough to be a real test and inside a safe margin.
       The bottom margin is larger than the rest because the hint and the score
       pills live down there: a dot placed under them is sitting behind text you
       cannot click through, which made it needlessly hard to start a stroke. */
    const m = 90
    const bottom = 150
    const usableH = Math.max(m + 40, H - m - bottom)
    const minLen = Math.min(W, H) * 0.55
    let guard = 0
    const pick = () => ({ x: m + Math.random() * (W - 2 * m), y: m + Math.random() * (usableH - m) })
    do {
      A = pick()
      B = pick()
    } while (Math.hypot(B.x - A.x, B.y - A.y) < minLen && ++guard < 200)
    stroke = []
    locked = false
    render()
  }

  const dist = (p, q) => Math.hypot(p.x - q.x, p.y - q.y)

  /** Perpendicular distance from p to the infinite line through A and B. */
  function deviation(p) {
    const dx = B.x - A.x, dy = B.y - A.y
    const len = Math.hypot(dx, dy) || 1
    return Math.abs(dy * p.x - dx * p.y + B.x * A.y - B.y * A.x) / len
  }

  /** On the line to badly off it. */
  function strokeColour(t) {
    return [
      Math.round(255 - t * 15),
      Math.round(214 - t * 136),
      Math.round(150 - t * 90),
    ].join(',')
  }

  function drawReveal() {
    const len = dist(A, B) || 1
    /* The band whose *average* deviation scores exactly zero. Drawing it is
       what turns a percentage into something you can learn from: you can see
       how far off you were relative to what the scoring actually cares about,
       instead of being told a number. */
    const band = TOLERANCE * len
    const nx = -(B.y - A.y) / len, ny = (B.x - A.x) / len
    ctx.save()
    ctx.fillStyle = 'rgba(255, 232, 205, 0.055)'
    ctx.beginPath()
    ctx.moveTo(A.x + nx * band, A.y + ny * band)
    ctx.lineTo(B.x + nx * band, B.y + ny * band)
    ctx.lineTo(B.x - nx * band, B.y - ny * band)
    ctx.lineTo(A.x - nx * band, A.y - ny * band)
    ctx.closePath()
    ctx.fill()

    // The ideal line itself, still dashed so it never reads as your stroke.
    ctx.setLineDash([7, 9])
    ctx.strokeStyle = 'rgba(255, 242, 228, 0.5)'
    ctx.lineWidth = 2
    ctx.lineCap = 'round'
    ctx.beginPath(); ctx.moveTo(A.x, A.y); ctx.lineTo(B.x, B.y); ctx.stroke()
    ctx.restore()
  }

  function drawStroke() {
    if (stroke.length < 2) return
    const len = dist(A, B) || 1
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'

    /* The glow is one path and one stroke, not one per segment. Stroking each
       segment separately at low alpha makes overlapping round caps accumulate,
       and the line comes out beaded rather than glowing. */
    ctx.save()
    ctx.globalAlpha = 0.18
    ctx.strokeStyle = '#ff9d55'
    ctx.lineWidth = 14
    ctx.beginPath()
    ctx.moveTo(stroke[0].x, stroke[0].y)
    for (let i = 1; i < stroke.length; i++) ctx.lineTo(stroke[i].x, stroke[i].y)
    ctx.stroke()
    ctx.restore()

    /* The line itself: quadratics through the midpoints, which smooths the
       raw pointer samples without moving them, and a width that thins as you
       speed up the way a real pen does. Colour still says how far off the
       ideal each part of the stroke drifted. */
    for (let i = 1; i < stroke.length - 1; i++) {
      const p0 = stroke[i - 1], p1 = stroke[i], p2 = stroke[i + 1]
      const t = Math.min(1, deviation(p1) / len / TOLERANCE)
      const sp = Math.min(1, dist(p0, p1) / 20)
      ctx.strokeStyle = 'rgb(' + strokeColour(t) + ')'
      ctx.lineWidth = 6.0 - sp * 3.0
      ctx.beginPath()
      ctx.moveTo((p0.x + p1.x) / 2, (p0.y + p1.y) / 2)
      ctx.quadraticCurveTo(p1.x, p1.y, (p1.x + p2.x) / 2, (p1.y + p2.y) / 2)
      ctx.stroke()
    }
  }

  function drawDots() {
    for (const [q, label] of [[A, 'A'], [B, 'B']]) {
      // A ring standing off the body, so the target has a footprint.
      ctx.beginPath(); ctx.arc(q.x, q.y, DOT_R + 7, 0, Math.PI * 2)
      ctx.strokeStyle = 'rgba(255, 196, 128, 0.28)'; ctx.lineWidth = 1.5; ctx.stroke()
      // Lit from the same direction as the surface behind it, which is what
      // stops it reading as a circle printed on a flat colour.
      const g = ctx.createRadialGradient(q.x - 4, q.y - 5, 1, q.x, q.y, DOT_R)
      g.addColorStop(0, '#ffdcaa')
      g.addColorStop(1, '#d08f42')
      ctx.beginPath(); ctx.arc(q.x, q.y, DOT_R, 0, Math.PI * 2)
      ctx.fillStyle = g; ctx.fill()
      ctx.strokeStyle = 'rgba(70, 30, 14, 0.42)'; ctx.lineWidth = 1; ctx.stroke()
      ctx.fillStyle = '#3a121d'
      ctx.font = '600 13px Inter, system-ui, sans-serif'
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle'
      ctx.fillText(label, q.x, q.y + 1)
    }
  }

  function render() {
    ctx.clearRect(0, 0, W, H)
    // Shown only after the attempt, so it cannot be traced.
    if (locked) drawReveal()
    drawStroke()
    drawDots()
  }

  /**
   * Put the score card where it does not cover the line it is scoring.
   *
   * It used to sit dead centre, which hid dot B and most of the stroke behind
   * the number describing them. Of the four corners, the one furthest from the
   * A-B segment wins.
   */
  function placeResult() {
    const pad = 18
    const w = result.offsetWidth || 250
    const h = result.offsetHeight || 200
    const hud = 110                     // the score pills live along the bottom
    const seg = (q) => {
      const dx = B.x - A.x, dy = B.y - A.y
      const L2 = dx * dx + dy * dy || 1
      const u = Math.max(0, Math.min(1, ((q.x - A.x) * dx + (q.y - A.y) * dy) / L2))
      return Math.hypot(q.x - (A.x + dx * u), q.y - (A.y + dy * u))
    }
    const cx = [pad + w / 2, W - pad - w / 2]
    const cy = [pad + h / 2, H - pad - h / 2 - hud]
    let best = null, bestD = -1
    for (const x of cx) for (const y of cy) {
      // A board too small for a corner falls back to the middle rather than
      // pushing the card off the edge.
      const q = { x: Math.max(w / 2, Math.min(W - w / 2, x)),
                  y: Math.max(h / 2, Math.min(H - h / 2, y)) }
      const d = seg(q)
      if (d > bestD) { bestD = d; best = q }
    }
    result.style.left = best.x + 'px'
    result.style.top = best.y + 'px'
  }

  function score() {
    const len = dist(A, B) || 1
    // Resample by arc length so a slow, dense stroke is not weighted differently
    // from a fast, sparse one.
    let total = 0, sum = 0
    for (let i = 1; i < stroke.length; i++) {
      const seg = dist(stroke[i - 1], stroke[i])
      sum += ((deviation(stroke[i - 1]) + deviation(stroke[i])) / 2) * seg
      total += seg
    }
    const avg = total ? sum / total : len
    const raw = 1 - avg / len / TOLERANCE
    // A stroke that wanders far past the dots should not score well either.
    const overshoot = Math.max(0, total / len - 1.06)
    return Math.max(0, Math.min(100, (raw - overshoot) * 100))
  }

  function pos(e) {
    const r = canvas.getBoundingClientRect()
    return { x: e.clientX - r.left, y: e.clientY - r.top }
  }

  canvas.addEventListener('pointerdown', (e) => {
    if (locked) return
    const p = pos(e)
    if (dist(p, A) > SNAP) {
      hint.textContent = 'Start on dot A.'
      return
    }
    // Capture keeps the stroke alive if the pointer leaves the canvas; it is
    // not available for synthetic events, so failing here must not break play.
    try { canvas.setPointerCapture(e.pointerId) } catch {}
    unlock(); sfx.click()
    drawing = true
    stroke = [p]
    pen = p
    hint.textContent = 'Keep going to B. Do not lift.'
    render()
    nudge()
  })

  let tickAt = 0
  canvas.addEventListener('pointermove', (e) => {
    if (!drawing) return
    const q = pos(e)
    stroke.push(q)
    pen = q
    // A quiet tick every few samples turns a silent drag into a felt one.
    if (stroke.length - tickAt > 5) { tickAt = stroke.length; sfx.tick() }
    render()
    nudge()
  })

  function finish() {
    if (!drawing) return
    drawing = false
    const end = stroke[stroke.length - 1]
    if (!end || dist(end, B) > SNAP) {
      stroke = []
      hint.textContent = 'You have to finish on dot B. Try again.'
      render()
      return
    }
    locked = true
    tries++
    elTries.textContent = tries
    const s = score()
    elLast.textContent = s.toFixed(1) + '%'
    if (s > best) {
      best = s
      localStorage.setItem(STORE, String(best))
      elBest.textContent = best.toFixed(1) + '%'
    }
    bigScore.textContent = s.toFixed(1) + '%'

    const r = canvas.getBoundingClientRect()
    const bx = r.left + B.x, by = r.top + B.y
    if (s >= 95) {
      sfx.great()
      burst(bx, by, { count: 30, colors: ['#e8a75c', '#fff', '#ffd166'], speed: 5, gravity: 0.12, life: 46, size: 4 })
      ring(bx, by, '#ffd166', 22)
    } else if (s >= 70) {
      sfx.good()
      burst(bx, by, { count: 14, colors: ['#e8a75c', '#fff'], speed: 3.4, gravity: 0.16, life: 34, size: 3 })
    } else {
      sfx.bad()
    }
    floatText(bx, by - 26, s.toFixed(1) + '%', s >= 70 ? '#ffd166' : '#ff8f7a')

    verdict.textContent =
      s >= 99 ? 'Suspicious.' :
      s >= 95 ? 'Genuinely steady.' :
      s >= 85 ? 'Solid. Human.' :
      s >= 70 ? 'A bit of a wobble.' :
      s >= 40 ? 'That is a banana.' : 'That is not a line.'
    result.hidden = false
    // Measurable only once it is laid out, so this has to follow the unhide.
    placeResult()
    hint.textContent = 'Press Again for a new pair.'
    render()
    nudge()
  }

  canvas.addEventListener('pointerup', finish)
  canvas.addEventListener('pointercancel', finish)
  canvas.addEventListener('pointerleave', finish)

  again.addEventListener('click', () => {
    unlock(); sfx.whoosh()
    result.hidden = true
    hint.textContent = 'Press on the first dot and drag to the second. One stroke.'
    place()
    nudge()
  })

  addEventListener('resize', resize)
  resize()
</script>

<style>
  .stage { position: relative; height: 100%; background: #3a121d; touch-action: none; }
  /* The still fallback, for anything without WebGL2. */
  .felt {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(90% 70% at 34% 4%, #4a1826 0%, transparent 62%),
      #3a121d;
  }
  .felt :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: crosshair; }

  .hud {
    position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    color: #fff; text-align: center; pointer-events: none; width: min(92vw, 560px);
  }
  .hint { font-size: 15px; opacity: 0.8; }
  .scores {
    display: flex; gap: 26px;
    background: rgba(0,0,0,0.3); padding: 10px 22px; border-radius: 999px;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .scores div { display: flex; flex-direction: column; align-items: center; }
  .k { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
  .scores b { font-size: 17px; font-variant-numeric: tabular-nums; }

  .result {
    /* left/top are set from placeResult(); these are only the pre-layout
       defaults for the first frame before it runs. */
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    transition: left 260ms var(--ease), top 260ms var(--ease);
    background: rgba(0,0,0,0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: #fff; border-radius: 18px; padding: 26px 38px; text-align: center;
  }
  .big { font-size: 56px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .verdict { opacity: 0.8; margin-bottom: 16px; }
  .result button {
    background: #e0a458; color: #3a121d; border: 0; border-radius: 999px;
    padding: 10px 26px; font-weight: 600; cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .result { transition: none; }
  }
</style>
