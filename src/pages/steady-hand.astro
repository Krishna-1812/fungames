---
import GameShell from '../layouts/GameShell.astro'
import { SHAPES } from '../lib/steady-shapes'
import { GASES } from '../lib/steady/neon'

/** A small glyph of each shape, drawn in its own gas. */
const GLYPH: Record<string, string> = {
  line: 'M5 19 L19 5',
  circle: 'M12 4 a8 8 0 1 1 -0.01 0',
  square: 'M5 5 H19 V19 H5 Z',
  spiral: 'M12 12 m0 -1.2 a1.2 1.2 0 1 1 -1.2 1.2 a3 3 0 0 1 3 -3 a4.6 4.6 0 0 1 4.6 4.6 a6.4 6.4 0 0 1 -6.4 6.4 a8 8 0 0 1 -8 -8',
}
const gasCss = (id: string) => GASES[id]?.rgb.join(', ') ?? '140, 200, 255'

/**
 * Steady Hand — four shapes, one unbroken stroke each.
 *
 * Scoring is honest geometry rather than vibes, and it lives in
 * lib/steady-shapes.ts so it can be run without a browser: every point's
 * distance to the ideal is measured, weighted by arc length, and normalised by
 * the shape's size, so the difficulty does not change with the window or the
 * angle. scripts/check-steady.mjs feeds it drawings whose right answer is
 * known and checks the properties the score is supposed to have.
 *
 * Nothing is traced. Dots anchor each shape — two for a line, four corners for
 * a square — and the circle fixes only its centre, taking its radius from
 * whatever you drew, so it measures roundness rather than obedience.
 *
 * In the shell it is a round: the four shapes in order, one scored stroke
 * each (redo as often as you like), and the round's rating at the end is the
 * mean of the four — the same `rating()` the per-shape bests always had.
 * Score is the round so far, Shape is progress, Moves are strokes, and Best
 * is your best round.
 */
---

<GameShell
  slug="steady-hand"
  labels={{ score: 'This round', best: 'Best round', level: 'Shape', moves: 'Strokes' }}
  initial={{ score: '—', level: `1 / ${SHAPES.length}`, moves: '0' }}
  fonts={['Caveat:wght@600']}
>
  <div class="sh">
    <div class="sh-top">
    <ol class="sh-round" id="round" aria-label="The round">
      {SHAPES.map((sh, i) => (
        <li data-shape={sh.id} class={i === 0 ? 'is-now' : ''} style={`--gas: ${gasCss(sh.id)}`}>
          <svg class="sh-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d={GLYPH[sh.id]} /></svg>
          <b><span class="label">{i + 1}</span> {sh.name}</b>
          <span class="num sh-got" data-got>—</span>
          <span class="sh-best">best <span data-best>—</span></span>
        </li>
      ))}
    </ol>

    {/* Drawing without a mouse or a finger: a practice pen moved by the keys, never ranked. */}
    <div class="sh-kb">
      <button type="button" class="sh-kb-btn" id="keyboardPractice" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M6 10h1.5M9.5 10H11M13 10h1.5M16.5 10H18M7 14h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        <span>Keyboard practice</span>
      </button>
      <p id="keyboardHelp" class="sh-kb-help"><kbd>←</kbd><kbd>↑</kbd><kbd>→</kbd><kbd>↓</kbd> move the pen · <kbd>Shift</kbd> small steps · <kbd>Space</kbd> starts and ends a stroke · <kbd>Home</kbd> back to the first mark · <kbd>N</kbd> next shape. Not ranked.</p>
    </div>
    </div>
    <div class="sh-board" id="board">
      <canvas id="c" tabindex="0" aria-describedby="keyboardHelp hint" aria-label="The drawing board. Press on the first mark and drag, in one stroke."></canvas>

      <p class="sh-hint" id="hint" aria-live="polite">Press on the first mark and drag to the second. One stroke.</p>

      <div class="sh-card" id="result" hidden tabindex="-1">
        <p class="label meta" id="cardShape">Line</p>
        <p class="sh-big num" id="bigScore">0.0%</p>
        <p class="sh-verdict" id="verdict"></p>
        <ul class="sh-factors" id="factors"></ul>
        <div class="sh-crowd" id="shCrowd" aria-live="polite"></div>
        <div class="sh-acts">
          <button type="button" class="pill pill--ink" id="next"><span id="nextLbl">Next shape</span><span aria-hidden="true">→</span></button>
          <button type="button" class="pill pill--line pill--sm" id="redo"><span>Redo</span></button>
        </div>
        <p class="sh-keys"><kbd>N</kbd> next · <kbd>R</kbd> redo</p>
      </div>
    </div>
  </div>

  <Fragment slot="howto">
    <p>
      You are bending neon. Four shapes, freehand, one unbroken stroke each: a
      <b>line</b>, a <b>circle</b>, a <b>square</b> and a <b>spiral</b>. Steel
      marks on the wall show where to start and finish; nothing is traced for you.
    </p>
    <ul>
      <li>Press on the first mark, drag without lifting, and finish on the last one. Closed shapes finish where they started. Finish on the mark and the tube lights; miss it and the glass breaks.</li>
      <li>Your score is how close the stroke stayed to the ideal shape, how much of it you drew, and how directly you travelled. The ideal is chalked on the wall afterwards.</li>
      <li>Redo any shape as often as you like before moving on. The shape turns to a new angle every time.</li>
    </ul>
    <p>The round's rating is the mean of the four, and your four tubes become one sign. Your best is your best round.</p>
  </Fragment>
</GameShell>

<script>
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { sfx, unlock } from '../lib/audio'
  import { hit, tone } from '../lib/audio'
  import { createNeon, GASES } from '../lib/steady/neon'
  import {
    SHAPES, scoreStroke, rating, verdictFor, ratingName,
    TOLERANCE, distToPath, dist, sizeOf,
  } from '../lib/steady-shapes'
  import type { Score } from '../lib/steady-shapes'
  import { recordPlay } from '../lib/stats'
  import { dailyFor, dailyTarget } from '../data/game-meta'
  import { loadCrowd, fillCrowd, clearCrowd, standing, people, FEW } from '../lib/crowd'

  type P = { x: number; y: number; t?: number }
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const canvas = $<HTMLCanvasElement>('c')
  const hint = $('hint')
  const result = $('result')
  const roundEls = [...$('round').children] as HTMLLIElement[]
  const prefersReducedMotion = !PLAY

  const STORE = 'steady-hand:bests.v1'
  const SNAP = 52         // how close the stroke must start and finish

  let W = 0, H = 0, dpr = 1
  let idx = 0
  let shape = SHAPES[0]
  let rot = 0
  let dots: { x: number; y: number; label?: string }[] = []
  let stroke: P[] = []    // each point carries the deviation it was drawn at
  let liveTarget: P[] = [] // the ideal, for colouring the stroke as it is drawn
  let drawing = false
  let keyboardPractice = false
  let locked = false
  let lastScore: Score | null = null
  let strokes = 0
  let round: Record<string, number> = {}
  /** The tube each kept score was drawn with, for the sign at the end. */
  let kept: Record<string, P[]> = {}

  const shell = createShell({ slug: 'steady-hand', onRestart: restart })
  loadCrowd('steady-hand')

  /* Bests are per shape, and the old single number was the line. Reading it
     back rather than dropping it means nobody loses a score they earned. */
  const bests: Record<string, number> = {}
  try {
    const raw = localStorage.getItem(STORE)
    if (raw) Object.assign(bests, JSON.parse(raw))
    const old = Number(localStorage.getItem('steady-hand:best'))
    if (old > 0 && !(bests.line > old)) bests.line = old
  } catch { /* private mode. Start fresh. */ }
  function save() {
    try { localStorage.setItem(STORE, JSON.stringify(bests)) } catch { /* fine */ }
  }

  /* Canvas CSS pixels to the space centred() builds: origin at the middle,
     units of half the short axis, y upward. */
  function toField(q: P) {
    const m = Math.min(W, H) || 1
    return [(2 * q.x - W) / m, (H - 2 * q.y) / m]
  }


  let pen: P = { x: 0, y: 0 }
  /* The wall, the glass and the light (lib/steady/neon.ts). Shards of a
     broken tube tick as they land. */
  const neon = createNeon(canvas, {
    animate: !prefersReducedMotion,
    onLand: (k) => hit({ dur: 0.03, gain: 0.04 + k * 0.1, freq: 4200 + Math.random() * 2400, q: 6 }),
  })
  /** What the tube is doing: nothing yet, warm under the pen, or lit. */
  let tubeMode: 'none' | 'warm' | 'lit' = 'none'
  const gasOf = () => GASES[shape.id]?.rgb ?? [120, 200, 255]
  const nudge = () => {}

  /** The tube catching: a click, the buzz of the transformer, then a hum. */
  function igniteSound() {
    hit({ dur: 0.02, gain: 0.2, freq: 3000, q: 3 })
    for (const [d, gn] of [[0.06, 0.05], [0.16, 0.03], [0.26, 0.06]]) tone({ freq: 120, dur: 0.07, type: 'sawtooth', gain: gn, filter: 700, delay: d })
    tone({ freq: 120, dur: 0.9, type: 'sawtooth', gain: 0.035, filter: 420, delay: 0.32 })
  }
  /** Glass going: a crack, then the pieces. */
  function breakSound() {
    hit({ dur: 0.06, gain: 0.32, freq: 2600, q: 1.2 })
    for (let k = 0; k < 7; k++) hit({ dur: 0.04, gain: 0.07, freq: 3800 + Math.random() * 3000, q: 8, delay: 0.03 + k * 0.035 + Math.random() * 0.03 })
  }

  const box = () => ({ w: W, h: H })

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2)
    W = canvas.clientWidth
    H = canvas.clientHeight
    neon.resize(W, H, dpr)
    // A resize moves the dots, so a stroke in progress or a scored one no
    // longer lines up with them: start this shape again at the new size.
    place()
  }

  function place() {
    // A fresh angle every attempt, so the shape cannot be learned as a
    // muscle movement in one particular direction.
    rot = Math.random() * Math.PI * 2
    dots = shape.dots(box(), rot)
    if (keyboardPractice && dots[0]) pen = { ...dots[0] }
    stroke = []
    tubeMode = 'none'
    locked = false
    lastScore = null
    result.hidden = true
    clearCrowd($('shCrowd'))
    hint.textContent = shape.brief
    render()
  }



  /* ---- the board -------------------------------------------------------- */

  /**
   * Everything on the wall, from the game's state. After an attempt the ideal
   * is chalked on, with the band whose average deviation scores zero: you can
   * see how far off you were against what the scoring actually cares about.
   */
  function render() {
    const ideal = locked ? (lastScore ? lastScore.target : shape.target(box(), rot, [])) : null
    neon.set({
      marks: dots,
      startRing: !shape.closed,
      centreMark: shape.id === 'circle',
      ideal,
      band: TOLERANCE * (lastScore?.size || 1) * 2,
      tube: stroke,
      gas: gasOf(),
      mode: tubeMode,
      cursor: keyboardPractice ? pen : null,
      extra: [],
    })
  }

  /* ---- the round -------------------------------------------------------- */

  const roundMean = () => {
    const v = Object.values(round)
    return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null
  }

  function paintRound() {
    roundEls.forEach((li, k) => {
      const id = li.dataset.shape!
      const got = round[id]
      li.className = k === idx ? 'is-now' : got !== undefined ? 'is-done' : ''
      ;(li.querySelector('[data-got]') as HTMLElement).textContent = got !== undefined ? got.toFixed(0) + '%' : '—'
      const b = bests[id]
      ;(li.querySelector('[data-best]') as HTMLElement).textContent = typeof b === 'number' ? b.toFixed(0) + '%' : '—'
    })
  }

  function paintStrip() {
    const m = roundMean()
    shell.setScore(m === null ? '—' : m.toFixed(1) + '%')
    shell.setLevel(`${Math.min(idx + 1, SHAPES.length)} / ${SHAPES.length}`)
    shell.setMoves(String(strokes))
  }

  /**
   * Put the score card where it does not cover the shape it is scoring.
   *
   * Of the four corners, the one furthest from the ideal wins. A spiral fills
   * the middle of the board completely, so this matters. On a narrow board
   * the card sits under it instead (see the CSS), and nothing is placed.
   */
  function placeResult() {
    // Under the board (a narrow container): the CSS places it, and the board
    // makes room for it below.
    if (getComputedStyle(result).transform === 'none') {
      result.style.left = ''; result.style.top = ''
      $('board').style.setProperty('--sh-card-h', result.offsetHeight + 14 + 'px')
      return
    }
    const pad = 16
    const w = result.offsetWidth || 260
    const h = result.offsetHeight || 220
    const path = lastScore ? lastScore.target : shape.target(box(), rot, [])
    const cx = [pad + w / 2, W - pad - w / 2]
    const cy = [pad + h / 2, H - pad - h / 2]
    let best = { x: W / 2, y: H / 2 }, bestD = -1
    for (const x of cx) for (const y of cy) {
      const q = { x: Math.max(w / 2, Math.min(W - w / 2, x)), y: Math.max(h / 2, Math.min(H - h / 2, y)) }
      const d = distToPath(q, path)
      if (d > bestD) { bestD = d; best = q }
    }
    result.style.left = best.x + 'px'
    result.style.top = best.y + 'px'
  }

  /* ---- drawing ---------------------------------------------------------- */

  function pos(e: PointerEvent): P {
    const r = canvas.getBoundingClientRect()
    return { x: e.clientX - r.left, y: e.clientY - r.top }
  }

  /** Where a stroke is allowed to begin. Closed shapes: anywhere. */
  function startOk(p: P) {
    if (shape.closed) return true
    return dist(p, dots[0]) <= SNAP
  }

  /* The scale of the ideal fixed at the start of the stroke, so colouring a
     point does not need the whole shape measured again per sample. */
  let strokeScale = 1

  /**
   * Add a point, remembering how far off the ideal it was.
   *
   * The deviation is measured once, as the point arrives, and only decides the
   * colour of the line. The score at the end is computed properly from the
   * whole stroke — and for the circle, against a radius fitted to it.
   */
  function push(p: P) {
    const d = liveTarget.length ? distToPath(p, liveTarget) : 0
    stroke.push({ x: p.x, y: p.y, t: Math.min(1, d / (TOLERANCE * strokeScale)) })
  }

  function beginStroke(p: P) {
    if (locked || shell.paused || idx >= SHAPES.length) return false
    if (!startOk(p)) {
      hint.textContent = 'Start on the first mark.'
      return false
    }
    unlock(); sfx.click()
    drawing = true
    tubeMode = 'warm'
    liveTarget = shape.target(box(), rot, [p])
    strokeScale = sizeOf(liveTarget) || 1
    stroke = []
    push(p)
    pen = p
    hint.textContent = shape.closed
      ? 'All the way round, back to where you started.'
      : 'Keep going. Do not lift.'
    render()
    nudge()
    return true
  }
  canvas.addEventListener('pointerdown', (e) => {
    if (keyboardPractice) return
    if (!beginStroke(pos(e))) return
    try { canvas.setPointerCapture(e.pointerId) } catch { /* synthetic input has no capture */ }
    e.preventDefault()
  })

  let tickAt = 0
  canvas.addEventListener('pointermove', (e) => {
    if (!drawing) return
    const q = pos(e)
    push(q)
    pen = q
    // A quiet tick every few samples turns a silent drag into a felt one.
    if (stroke.length - tickAt > 5) { tickAt = stroke.length; sfx.tick() }
    render()
    nudge()
  })

  const abandoned = new Set<string>()
  function finishStroke() {
    if (!drawing) return
    drawing = false
    if(!keyboardPractice)strokes++
    const end = stroke[stroke.length - 1]
    const home = shape.closed ? stroke[0] : dots[dots.length - 1]
    if (!end || stroke.length < 6 || dist(end, home) > SNAP) {
      // The glass breaks where it lies.
      neon.set({ tube: stroke })
      neon.shatter()
      if (stroke.length > 3) breakSound()
      stroke = []
      tubeMode = 'none'
      hint.textContent = shape.closed
        ? 'It has to come back to where it started, or the glass breaks. Try again.'
        : 'It has to end on the last mark, or the glass breaks. Try again.'
      shell.shake($('board'))
      // Once a shape a page: a missed ending can come many times over.
      if (!keyboardPractice && !abandoned.has(shape.id)) { abandoned.add(shape.id); shell.pick('Stroke abandoned', shape.name) }
      paintStrip()
      render()
      nudge()
      return
    }
    if (keyboardPractice) {
      const score = scoreStroke(shape, box(), rot, stroke)
      hint.textContent = `Practice stroke: ${score.score.toFixed(1)}%. No ranked result saved. Home repositions the pen; Space starts again; N changes shape.`
      tubeMode = 'lit'; render(); neon.ignite(); igniteSound(); return
    }
    locked = true
    tubeMode = 'lit'
    result.style.setProperty('--gas', gasOf().join(', '))

    const s = scoreStroke(shape, box(), rot, stroke)
    lastScore = s
    round[shape.id] = s.score
    const beatShape = !(bests[shape.id] >= s.score)
    if (beatShape) { bests[shape.id] = s.score; save() }

    $('cardShape').textContent = shape.name + (beatShape ? ' · ✓ your best' : '')
    const big = $('bigScore')
    const txt = s.score.toFixed(1) + '%'
    // The number is neon too: it catches with the tube rather than rolling,
    // which would clip its glow into boxes.
    big.textContent = txt
    big.classList.remove('is-catching'); void big.offsetWidth; big.classList.add('is-catching')
    $('verdict').textContent = verdictFor(s.score)
    $('factors').innerHTML = [
      ['Accuracy', s.accuracy, 'how close you were'],
      ['Coverage', s.coverage, 'how much of it you drew'],
      ['Economy', s.economy, 'against how far you travelled'],
    ].map(([k, v, why]) =>
      `<li><span>${k}</span><b class="num">${Math.round((v as number) * 100)}%</b><i>${why}</i></li>`).join('')
    $('nextLbl').textContent = idx + 1 >= SHAPES.length ? 'See the round' : 'Next shape'

    igniteSound()
    if (s.score >= 92) sfx.great()
    else if (s.score >= 62) sfx.good()

    /* A play here is a stroke, which is what the word means in this game.
       The per-shape bests stay in their own key — `stats.ts` deliberately
       leaves that alone — and what the shared store gets is the score. */
    recordPlay('steady-hand', { shape: shape.id, score: Math.round(s.score * 10) / 10 }, { score: 'high' })

    result.hidden = false
    // Measurable only once it is laid out, so this has to follow the unhide.
    placeResult()
    // Where this stroke stands among everyone else's kept score on the same shape.
    const kept = Math.round(s.score), drawn = shape
    fillCrowd($('shCrowd'), 'steady-hand', (c) => {
      const st = standing(c, 'Score kept, per shape', drawn.name, kept)
      if (!st) return FEW
      return st.pct >= 50
        ? `Steadier than <b>${st.pct}%</b> of ${people(st.n)} players on this shape.`
        : `${100 - st.pct}% of ${people(st.n)} players drew this shape better. Redraw it?`
    }).then(() => { if (!result.hidden) placeResult() })
    hint.textContent = ''
    shell.announce(`${shape.name}: ${txt}. ${verdictFor(s.score)}`)
    paintRound()
    paintStrip()
    render()
    neon.ignite()
    ;($('next') as HTMLButtonElement).focus({ preventScroll: true })
  }

  canvas.addEventListener('pointerup', finishStroke)
  canvas.addEventListener('pointercancel', finishStroke)
  canvas.addEventListener('pointerleave', finishStroke)

  let restoreScoredRound: (() => void) | null = null
  $('keyboardPractice').addEventListener('click', () => {
    if (drawing) { drawing = false; stroke = [] }
    if(!keyboardPractice){
      const previous={idx,shape,rot,dots,pen,stroke,liveTarget,locked,hidden:result.hidden,hint:hint.textContent}
      restoreScoredRound=()=>{
        idx=previous.idx;shape=previous.shape;rot=previous.rot;dots=previous.dots;pen=previous.pen
        stroke=previous.stroke;liveTarget=previous.liveTarget;locked=previous.locked;result.hidden=previous.hidden
        hint.textContent=previous.hint;paintRound();paintStrip()
      }
    }
    keyboardPractice = !keyboardPractice
    $('keyboardPractice').setAttribute('aria-pressed', String(keyboardPractice))
    if (keyboardPractice) {
      locked = false; result.hidden = true; pen = { ...dots[0] };stroke=[];liveTarget=[]
      hint.textContent = 'Keyboard practice. Arrows position the pen; Space starts a stroke. Home returns to the first mark.'
      canvas.focus()
    } else {restoreScoredRound?.();restoreScoredRound=null}
    render(); nudge()
  })
  canvas.addEventListener('keydown', (e) => {
    if (!keyboardPractice || shell.paused || e.metaKey || e.ctrlKey || e.altKey) return
    const moves: Record<string, P> = { ArrowLeft: {x:-1,y:0}, ArrowRight: {x:1,y:0}, ArrowUp: {x:0,y:-1}, ArrowDown: {x:0,y:1} }
    if (moves[e.key]) {
      e.preventDefault();const d=moves[e.key],step=e.shiftKey?1:4
      pen={x:Math.max(0,Math.min(W,pen.x+d.x*step)),y:Math.max(0,Math.min(H,pen.y+d.y*step))}
      if(drawing)push(pen)
      render();nudge()
    } else if (e.key === ' ' && !e.repeat) {
      e.preventDefault(); if(drawing)finishStroke();else beginStroke({...pen})
      // beginStroke/finishStroke own the outcome message, including failures.
    } else if (e.key === 'Home' && !drawing) {
      e.preventDefault();pen={...dots[0]};render();nudge()
    } else if (e.key.toLowerCase() === 'n' && !drawing) {
      e.preventDefault();idx=(idx+1)%SHAPES.length;shape=SHAPES[idx];place();paintRound();paintStrip();nudge()
    }
  })

  function redo() {
    if (!locked || idx >= SHAPES.length) return
    unlock(); sfx.whoosh()
    shell.pick('Shape redrawn', shape.name)
    delete round[shape.id]
    place()
    paintRound()
    paintStrip()
    nudge()
  }

  function next() {
    if (!locked || idx >= SHAPES.length) return
    unlock(); sfx.click()
    // The score kept, not every attempt (recordPlay has those).
    shell.pick('Score kept, per shape', Math.round(round[shape.id]), shape.name)
    kept[shape.id] = stroke.map((q) => ({ x: q.x, y: q.y }))
    idx++
    if (idx >= SHAPES.length) return finishRound()
    shape = SHAPES[idx]
    place()
    paintRound()
    paintStrip()
    if (idx === SHAPES.length - 1) shell.levelUp('Last one.')
    nudge()
  }

  $('redo').addEventListener('click', redo)
  $('next').addEventListener('click', next)

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || shell.paused) return
    const t = e.target as HTMLElement
    if (t.closest('input, textarea, select, dialog')) return
    const k = e.key.toLowerCase()
    if (k === 'n' || (k === 'enter' && !t.closest('button, a'))) { if (locked) { e.preventDefault(); next() } }
    else if (k === 'r') { if (locked) { e.preventDefault(); redo() } }
  })

  /* ---- the round's rating ---------------------------------------------- */

  function finishRound() {
    const r = rating(round)!
    result.hidden = true
    locked = false
    hint.textContent = 'Round over. Restart for another.'
    paintRound()
    paintStrip()

    const ranked = SHAPES.map((sh) => ({ name: sh.name, v: round[sh.id] })).sort((a, b) => b.v - a.v)
    shell.resultExtra.innerHTML = `
      <figure class="sh-sign"><canvas aria-label="Your four tubes, lit, side by side on the wall"></canvas>
        <figcaption>Your sign, as you bent it</figcaption></figure>
      <ul class="sh-summary">${SHAPES.map((sh) => `
        <li style="--gas: ${(GASES[sh.id]?.rgb ?? [140, 200, 255]).join(', ')}"><span class="label">${sh.name}</span><b class="num">${round[sh.id].toFixed(1)}%</b><i>${verdictFor(round[sh.id])}</i></li>`).join('')}
      </ul>`
    paintSign(shell.resultExtra.querySelector('.sh-sign canvas') as HTMLCanvasElement)
    const beat = shell.considerBest(Math.round(r * 10), `${r.toFixed(1)}%`)
    const lines = [`Steadiest on the ${ranked[0].name.toLowerCase()}, shakiest on the ${ranked[ranked.length - 1].name.toLowerCase()}.`]
    if (beat === 'beaten') lines.push('✓ Your best round yet.')
    else if (beat === 'first') lines.push('Your first full round — that rating is the one to beat now.')
    else if (shell.best) lines.push(`Your best round is still ${shell.best.text}.`)
    const now = new Date()
    if (dailyFor(now).slug === 'steady-hand') {
      const need = dailyTarget.steadiness(now)
      shell.daily(r >= need, `The target: a round rated ${need}% or better. Yours was ${Math.round(r * 10) / 10}%.`)
    }
    shell.win({
      kicker: `${SHAPES.length} shapes · ${strokes} strokes`,
      title: ratingName(r) + '.',
      score: r.toFixed(1) + '%',
      lines,
      againLabel: 'Another round',
    })
  }

  /**
   * The round's four tubes, each scaled into its own bay and lit together on
   * one piece of wall: the sign you made. Drawn once, still.
   */
  function paintSign(cv: HTMLCanvasElement, tries = 0) {
    // The result card is laid out a frame or two after the round ends.
    if (!cv.clientWidth && tries < 30) { requestAnimationFrame(() => paintSign(cv, tries + 1)); return }
    const w = cv.clientWidth || 640
    const cols = w < 520 ? 2 : 4, rows = cols === 2 ? 2 : 1
    const h = Math.round((w / cols) * (rows === 2 ? 1.8 : 0.82))
    cv.style.height = h + 'px'
    const sign = createNeon(cv, { animate: false })
    const cw = w / cols, ch = h / rows, pad = Math.min(cw, ch) * 0.17
    const extra = SHAPES.map((sh, i) => {
      const pts = kept[sh.id] ?? []
      if (pts.length < 2) return null
      const xs = pts.map((q) => q.x), ys = pts.map((q) => q.y)
      const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys)
      const k = Math.min((cw - pad * 2) / Math.max(1, x1 - x0), (ch - pad * 2) / Math.max(1, y1 - y0))
      const ox = (i % cols) * cw + cw / 2, oy = Math.floor(i / cols) * ch + ch / 2
      return { pts: pts.map((q) => ({ x: ox + (q.x - (x0 + x1) / 2) * k, y: oy + (q.y - (y0 + y1) / 2) * k })), gas: GASES[sh.id].rgb }
    }).filter(Boolean) as Array<{ pts: P[]; gas: [number, number, number] }>
    sign.resize(w, h, Math.min(2, devicePixelRatio || 1))
    sign.set({ marks: [], startRing: false, centreMark: false, ideal: null, tube: [], mode: 'none', cursor: null, extra })
  }

  function restart() {
    kept = {}
    idx = 0
    shape = SHAPES[0]
    round = {}
    strokes = 0
    place()
    paintRound()
    paintStrip()
    shell.stage.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
  }

  if (import.meta.env.DEV) (window as any).__steady = { canvas, neon, get dots() { return dots }, get shape() { return shape.id }, get rot() { return rot } }
  document.fonts?.ready.then(() => render())

  new ResizeObserver(() => {
    if (canvas.clientWidth !== W || canvas.clientHeight !== H) resize()
  }).observe(canvas)
  resize()
  paintRound()
</script>

<style is:global>
