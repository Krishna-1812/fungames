---
import GameLayout from '../layouts/GameLayout.astro'
import { SHAPES } from '../lib/steady-shapes'

/**
 * Steady Hand — four shapes, one unbroken stroke each.
 *
 * Scoring is honest geometry rather than vibes, and it lives in
 * lib/steady-shapes.ts so it can be run without a browser: every point's
 * distance to the ideal is measured, weighted by arc length, and normalised by
 * the shape's size, so the difficulty does not change with the window or the
 * angle. scripts/check-steady.mjs feeds it drawings whose right answer is
 * known and checks the properties the score is supposed to have.
 *
 * Nothing is traced. Dots anchor each shape — two for a line, four corners for
 * a square — and the circle fixes only its centre, taking its radius from
 * whatever you drew, so it measures roundness rather than obedience.
 */
---

<GameLayout slug="steady-hand" bar="#5b2333" fixed>
  <div class="stage">
    <h1 class="visually-hidden">Steady Hand</h1>
    {/* Behind the canvas, which clears to transparent. */}
    <div class="felt" id="felt" aria-hidden="true"></div>
    <canvas id="c"></canvas>

    <div class="shapes" id="shapes" role="tablist" aria-label="Shape">
      {SHAPES.map((sh, i) => (
        <button type="button" class="shape" role="tab" data-shape={sh.id}
                aria-selected={i === 0 ? 'true' : 'false'}>
          <b>{sh.name}</b>
          <span class="sbest">—</span>
        </button>
      ))}
    </div>

    <div class="hud">
      <div class="hint" id="hint">Press on the first dot and drag to the second. One stroke.</div>
      <div class="scores">
        <div><span class="k">Last</span><b id="last">—</b></div>
        <div><span class="k">Best</span><b id="best">—</b></div>
        <div><span class="k">Rating</span><b id="rating">—</b></div>
      </div>
    </div>

    <div class="result" id="result" hidden>
      <div class="big" id="bigScore">0.0%</div>
      <div class="verdict" id="verdict"></div>
      <p class="ready" id="ready" hidden>Share makes a card of this.</p>
      <ul class="factors" id="factors"></ul>
      <button type="button" id="again">Again</button>
    </div>
  </div>
</GameLayout>

<script>
  import { burst, ring, floatText, prefersReducedMotion } from '../lib/fx'
  import { sfx, unlock } from '../lib/audio'
  import { ShaderSurface } from '../lib/gl'
  import { FELT_FRAG } from '../lib/steady-felt'
  import {
    SHAPES, shapeById, scoreStroke, rating, verdictFor, ratingName,
    TOLERANCE, distToPath, dist, sizeOf,
  } from '../lib/steady-shapes'
  import { recordPlay } from '../lib/stats'
  import { onShare } from '../lib/share-card'
  import { SITE } from '../site.config'

  const canvas = document.getElementById('c')
  const ctx = canvas.getContext('2d')
  const hint = document.getElementById('hint')
  const elLast = document.getElementById('last')
  const elBest = document.getElementById('best')
  const elRating = document.getElementById('rating')
  const result = document.getElementById('result')
  const bigScore = document.getElementById('bigScore')
  const verdict = document.getElementById('verdict')
  const factors = document.getElementById('factors')
  const again = document.getElementById('again')
  const ready = document.getElementById('ready')
  const tabs = document.getElementById('shapes')

  const STORE = 'steady-hand:bests.v1'
  const DOT_R = 13        // visual radius of a target dot
  const SNAP = 52         // how close the stroke must start and finish

  let W = 0, H = 0, dpr = 1
  let shape = SHAPES[0]
  let rot = 0
  let dots = []
  let stroke = []         // each point carries the deviation it was drawn at
  let liveTarget = []     // the ideal, for colouring the stroke as it is drawn
  let drawing = false
  let locked = false
  let lastScore = null
  let strokesDrawn = 0     // lifetime, from the shared store

  /* Bests are per shape now, and the old single number was the line. Reading
     it back rather than dropping it means nobody loses a score they earned. */
  const bests = {}
  try {
    const raw = localStorage.getItem(STORE)
    if (raw) Object.assign(bests, JSON.parse(raw))
    const old = Number(localStorage.getItem('steady-hand:best'))
    if (old > 0 && !(bests.line > old)) bests.line = old
  } catch { /* private mode. Start fresh. */ }

  function save() {
    try { localStorage.setItem(STORE, JSON.stringify(bests)) } catch { /* fine */ }
  }

  /* Canvas CSS pixels to the space centred() builds: origin at the middle,
     units of half the short axis, y upward. */
  function toField(q) {
    const m = Math.min(W, H) || 1
    return [(2 * q.x - W) / m, (H - 2 * q.y) / m]
  }

  let pen = { x: 0, y: 0 }
  const felt = new ShaderSurface(document.getElementById('felt'), FELT_FRAG, {
    // Every layer is low frequency by design; see the note in steady-felt.ts.
    scale: 0.7,
    uniforms: () => ({
      // The shader lights the two ends of the task. A shape with one dot
      // passes the same point twice, which reads as a single glow.
      u_a: toField(dots[0] ?? { x: W / 2, y: H / 2 }),
      u_b: toField(dots[dots.length - 1] ?? { x: W / 2, y: H / 2 }),
      u_pen: toField(pen),
      u_penOn: drawing ? 1 : 0,
      u_locked: locked ? 1 : 0,
      u_motion: prefersReducedMotion ? 0 : 1,
    }),
  })
  // Under reduced motion the shared ticker never runs, so the surface has to be
  // asked for the frames that matter.
  function nudge() { if (prefersReducedMotion) felt.redraw() }

  const box = () => ({ w: W, h: H })

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2)
    W = canvas.clientWidth
    H = canvas.clientHeight
    canvas.width = Math.round(W * dpr)
    canvas.height = Math.round(H * dpr)
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    place()
  }

  function place() {
    // A fresh angle every attempt, so the shape cannot be learned as a
    // muscle movement in one particular direction.
    rot = Math.random() * Math.PI * 2
    dots = shape.dots(box(), rot)
    stroke = []
    locked = false
    lastScore = null
    paintHud()
    render()
  }

  /* ---- the board -------------------------------------------------------- */

  /** On the line to badly off it. */
  const strokeColour = (t) => [
    Math.round(255 - t * 15),
    Math.round(214 - t * 136),
    Math.round(150 - t * 90),
  ].join(',')

  /**
   * The ideal, and the band around it whose average deviation scores zero.
   *
   * Drawing the band is what turns a percentage into something you can learn
   * from: you can see how far off you were relative to what the scoring
   * actually cares about, instead of being told a number. It is a wide
   * translucent stroke along the same polyline, which gets the corners of the
   * square and the turns of the spiral right for free.
   */
  function drawReveal() {
    const path = lastScore ? lastScore.target : shape.target(box(), rot, [])
    if (path.length < 2) return
    const size = lastScore ? lastScore.size : 0
    const band = TOLERANCE * (size || 1) * 2

    ctx.save()
    ctx.lineJoin = 'round'
    ctx.lineCap = 'round'
    ctx.beginPath()
    ctx.moveTo(path[0].x, path[0].y)
    for (let i = 1; i < path.length; i++) ctx.lineTo(path[i].x, path[i].y)
    ctx.strokeStyle = 'rgba(255, 232, 205, 0.055)'
    ctx.lineWidth = band
    ctx.stroke()

    // The ideal itself, dashed so it never reads as your stroke.
    ctx.setLineDash([7, 9])
    ctx.strokeStyle = 'rgba(255, 242, 228, 0.5)'
    ctx.lineWidth = 2
    ctx.stroke()
    ctx.restore()
  }

  function drawStroke() {
    if (stroke.length < 2) return
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'

    /* The glow is one path and one stroke, not one per segment. Stroking each
       segment separately at low alpha makes overlapping round caps accumulate,
       and the line comes out beaded rather than glowing. */
    ctx.save()
    ctx.globalAlpha = 0.18
    ctx.strokeStyle = '#ff9d55'
    ctx.lineWidth = 14
    ctx.beginPath()
    ctx.moveTo(stroke[0].x, stroke[0].y)
    for (let i = 1; i < stroke.length; i++) ctx.lineTo(stroke[i].x, stroke[i].y)
    ctx.stroke()
    ctx.restore()

    /* The line itself: quadratics through the midpoints, which smooths the
       raw pointer samples without moving them, and a width that thins as you
       speed up the way a real pen does. Colour still says how far off the
       ideal each part of the stroke drifted. */
    for (let i = 1; i < stroke.length - 1; i++) {
      const p0 = stroke[i - 1], p1 = stroke[i], p2 = stroke[i + 1]
      const t = Math.min(1, p1.t ?? 0)
      const sp = Math.min(1, dist(p0, p1) / 20)
      ctx.strokeStyle = 'rgb(' + strokeColour(t) + ')'
      ctx.lineWidth = 6.0 - sp * 3.0
      ctx.beginPath()
      ctx.moveTo((p0.x + p1.x) / 2, (p0.y + p1.y) / 2)
      ctx.quadraticCurveTo(p1.x, p1.y, (p1.x + p2.x) / 2, (p1.y + p2.y) / 2)
      ctx.stroke()
    }
  }

  function drawDots() {
    for (const q of dots) {
      // A ring standing off the body, so the target has a footprint.
      ctx.beginPath(); ctx.arc(q.x, q.y, DOT_R + 7, 0, Math.PI * 2)
      ctx.strokeStyle = 'rgba(255, 196, 128, 0.28)'; ctx.lineWidth = 1.5; ctx.stroke()
      // Lit from the same direction as the surface behind it, which is what
      // stops it reading as a circle printed on a flat colour.
      const g = ctx.createRadialGradient(q.x - 4, q.y - 5, 1, q.x, q.y, DOT_R)
      g.addColorStop(0, '#ffdcaa')
      g.addColorStop(1, '#d08f42')
      ctx.beginPath(); ctx.arc(q.x, q.y, DOT_R, 0, Math.PI * 2)
      ctx.fillStyle = g; ctx.fill()
      ctx.strokeStyle = 'rgba(70, 30, 14, 0.42)'; ctx.lineWidth = 1; ctx.stroke()
      if (q.label) {
        ctx.fillStyle = '#3a121d'
        ctx.font = '600 12px Inter, system-ui, sans-serif'
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle'
        ctx.fillText(q.label, q.x, q.y + 1)
      }
    }
  }

  function render() {
    ctx.clearRect(0, 0, W, H)
    // Shown only after the attempt, so it cannot be traced.
    if (locked) drawReveal()
    drawStroke()
    drawDots()
  }

  /* ---- the readouts ----------------------------------------------------- */

  function paintHud() {
    const b = bests[shape.id]
    elBest.textContent = typeof b === 'number' ? b.toFixed(1) + '%' : '—'
    elLast.textContent = lastScore ? lastScore.score.toFixed(1) + '%' : '—'
    const r = rating(bests)
    elRating.textContent = r === null ? '—' : r.toFixed(0) + '%'
    elRating.title = r === null
      ? 'Set a best on all four shapes'
      : ratingName(r)
    for (const el of tabs.querySelectorAll('.shape')) {
      const id = el.dataset.shape
      el.setAttribute('aria-selected', String(id === shape.id))
      const v = bests[id]
      el.querySelector('.sbest').textContent = typeof v === 'number' ? v.toFixed(0) : '—'
    }
  }

  /**
   * Put the score card where it does not cover the shape it is scoring.
   *
   * Of the four corners, the one furthest from the ideal wins. With four
   * shapes rather than one segment this matters more, not less: a spiral
   * fills the middle of the board completely.
   */
  function placeResult() {
    const pad = 18
    const w = result.offsetWidth || 250
    const h = result.offsetHeight || 200
    const hud = 110                     // the score pills live along the bottom
    const path = lastScore ? lastScore.target : shape.target(box(), rot, [])
    const cx = [pad + w / 2, W - pad - w / 2]
    const cy = [pad + h / 2 + 56, H - pad - h / 2 - hud]
    let best = null, bestD = -1
    for (const x of cx) for (const y of cy) {
      // A board too small for a corner falls back to the middle rather than
      // pushing the card off the edge.
      const q = { x: Math.max(w / 2, Math.min(W - w / 2, x)),
                  y: Math.max(h / 2, Math.min(H - h / 2, y)) }
      const d = distToPath(q, path)
      if (d > bestD) { bestD = d; best = q }
    }
    result.style.left = best.x + 'px'
    result.style.top = best.y + 'px'
  }

  /* ---- drawing ---------------------------------------------------------- */

  function pos(e) {
    const r = canvas.getBoundingClientRect()
    return { x: e.clientX - r.left, y: e.clientY - r.top }
  }

  /** Where a stroke is allowed to begin. Closed shapes: anywhere. */
  function startOk(p) {
    if (shape.closed) return true
    return dist(p, dots[0]) <= SNAP
  }

  /* The scale of the ideal fixed at the start of the stroke, so colouring a
     point does not need the whole shape measured again per sample. */
  let strokeScale = 1

  /**
   * Add a point, remembering how far off the ideal it was.
   *
   * The deviation is measured once, as the point arrives, and only decides the
   * colour of the line. The score at the end is computed properly from the
   * whole stroke — and for the circle, against a radius fitted to it.
   */
  function push(p) {
    const d = liveTarget.length ? distToPath(p, liveTarget) : 0
    stroke.push({ x: p.x, y: p.y, t: Math.min(1, d / (TOLERANCE * strokeScale)) })
  }

  canvas.addEventListener('pointerdown', (e) => {
    if (locked) return
    const p = pos(e)
    if (!startOk(p)) {
      hint.textContent = 'Start on the first dot.'
      return
    }
    // Capture keeps the stroke alive if the pointer leaves the canvas; it is
    // not available for synthetic events, so failing here must not break play.
    try { canvas.setPointerCapture(e.pointerId) } catch {}
    unlock(); sfx.click()
    drawing = true
    liveTarget = shape.target(box(), rot, [p])
    strokeScale = sizeOf(liveTarget) || 1
    stroke = []
    push(p)
    pen = p
    hint.textContent = shape.closed
      ? 'All the way round, back to where you started.'
      : 'Keep going. Do not lift.'
    render()
    nudge()
  })

  let tickAt = 0
  canvas.addEventListener('pointermove', (e) => {
    if (!drawing) return
    const q = pos(e)
    push(q)
    pen = q
    // A quiet tick every few samples turns a silent drag into a felt one.
    if (stroke.length - tickAt > 5) { tickAt = stroke.length; sfx.tick() }
    render()
    nudge()
  })

  function finish() {
    if (!drawing) return
    drawing = false
    const end = stroke[stroke.length - 1]
    const home = shape.closed ? stroke[0] : dots[dots.length - 1]
    if (!end || stroke.length < 6 || dist(end, home) > SNAP) {
      stroke = []
      hint.textContent = shape.closed
        ? 'You have to come back to where you started. Try again.'
        : 'You have to finish on the last dot. Try again.'
      render()
      nudge()
      return
    }
    locked = true

    const s = scoreStroke(shape, box(), rot, stroke)
    lastScore = s
    if (!(bests[shape.id] >= s.score)) { bests[shape.id] = s.score; save() }
    paintHud()

    bigScore.textContent = s.score.toFixed(1) + '%'
    factors.innerHTML = [
      ['Accuracy', s.accuracy, 'how close you were'],
      ['Coverage', s.coverage, 'how much of it you drew'],
      ['Economy', s.economy, 'against how far you travelled'],
    ].map(([k, v, why]) =>
      `<li><span>${k}</span><b>${Math.round(v * 100)}%</b><i>${why}</i></li>`).join('')

    const r = canvas.getBoundingClientRect()
    const bx = r.left + end.x, by = r.top + end.y
    if (s.score >= 92) {
      sfx.great()
      burst(bx, by, { count: 30, colors: ['#e8a75c', '#fff', '#ffd166'], speed: 5, gravity: 0.12, life: 46, size: 4 })
      ring(bx, by, '#ffd166', 22)
    } else if (s.score >= 62) {
      sfx.good()
      burst(bx, by, { count: 14, colors: ['#e8a75c', '#fff'], speed: 3.4, gravity: 0.16, life: 34, size: 3 })
    } else {
      sfx.bad()
    }
    floatText(bx, by - 26, s.score.toFixed(1) + '%', s.score >= 62 ? '#ffd166' : '#ff8f7a')

    /* A play here is a stroke, which is what the word means in this game:
       there is no run to finish, only shapes you keep re-drawing. The per-shape
       bests stay in their own key — `stats.ts` deliberately leaves that alone —
       and what the shared store gets is the score, which is the number that
       compares with anything else. */
    const stat = recordPlay(
      'steady-hand',
      { shape: shape.id, score: Math.round(s.score * 10) / 10 },
      { score: 'high' },
    )
    // Lifetime, to match the bests beside it. `plays` is strokes here.
    strokesDrawn = stat.plays

    const r2 = rating(bests)
    verdict.textContent = r2 !== null && Object.keys(bests).length === SHAPES.length
      ? `${verdictFor(s.score)} Overall: ${ratingName(r2)}.`
      : verdictFor(s.score)

    /* Nothing is worth a card until all four shapes have a best: a rating
       built from the two you happen to be good at is not a steadiness rating,
       which is exactly why `rating()` returns null until then. */
    shareCard = r2 === null ? null : cardFor(r2)
    ready.hidden = r2 === null
    result.hidden = false
    // Measurable only once it is laid out, so this has to follow the unhide.
    placeResult()
    hint.textContent = 'Press Again, or pick another shape.'
    render()
    nudge()
  }

  /* ---- the result, as a picture ----------------------------------------- */

  let shareCard = null

  function cardFor(r) {
    const ranked = SHAPES.map((sh) => ({ name: sh.name, best: bests[sh.id] }))
      .sort((a, b) => b.best - a.best)
    /* The four numbers are the interesting part, so they go in the sentence.
       The narrowest a chip gets is 150px and three of those is most of the
       column, so the chips carry only the short facts. */
    const line = ranked
      .map((v, i) => `${i ? v.name.toLowerCase() : v.name} ${v.best.toFixed(0)}`)
      .join(', ')
    return {
      slug: 'steady-hand',
      siteName: SITE.name,
      headline: ratingName(r),
      /* The four numbers go last. A sub-line too long for the card is
         ellipsised, and losing "freehand" off the end costs nothing while
         losing "line 66" costs the result. */
      sub: `Freehand, one stroke each: ${line}.`,
      stats: [
        { label: 'Steadiest', value: ranked[0].name },
        { label: 'Rating', value: r.toFixed(0) + '%' },
        { label: 'Strokes', value: String(strokesDrawn) },
      ],
    }
  }

  onShare(() => shareCard, (c) => ({
    title: 'Steady Hand',
    text: `I draw like a ${c.headline.toLowerCase()}.`,
  }))

  canvas.addEventListener('pointerup', finish)
  canvas.addEventListener('pointercancel', finish)
  canvas.addEventListener('pointerleave', finish)

  again.addEventListener('click', () => {
    unlock(); sfx.whoosh()
    result.hidden = true
    hint.textContent = shape.brief
    place()
    nudge()
  })

  tabs.addEventListener('click', (e) => {
    const b = e.target.closest('.shape')
    if (!b) return
    const s = shapeById(b.dataset.shape)
    if (!s || s === shape) return
    shape = s
    unlock(); sfx.click()
    result.hidden = true
    hint.textContent = shape.brief
    place()
    nudge()
  })

  addEventListener('resize', resize)
  hint.textContent = shape.brief
  resize()
</script>

<style>
  .stage { position: relative; height: 100%; background: #3a121d; touch-action: none; }
  /* The still fallback, for anything without WebGL2. */
  .felt {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(90% 70% at 34% 4%, #4a1826 0%, transparent 62%),
      #3a121d;
  }
  .felt :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: crosshair; }

  .hud {
    position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    color: #fff; text-align: center; pointer-events: none; width: min(92vw, 560px);
  }
  .hint { font-size: 15px; opacity: 0.8; }
  .scores {
    display: flex; gap: 26px;
    background: rgba(0,0,0,0.3); padding: 10px 22px; border-radius: 999px;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .scores div { display: flex; flex-direction: column; align-items: center; }
  .k { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
  .scores b { font-size: 17px; font-variant-numeric: tabular-nums; }

  .result {
    /* left/top are set from placeResult(); these are only the pre-layout
       defaults for the first frame before it runs. */
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    transition: left 260ms var(--ease), top 260ms var(--ease);
    background: rgba(0,0,0,0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: #fff; border-radius: 18px; padding: 26px 38px; text-align: center;
  }
  .big { font-size: 56px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .verdict { opacity: 0.8; margin-bottom: 10px; }
  .ready { opacity: 0.55; font-size: 0.82rem; margin: 0 0 14px; }
  .result button {
    background: #e0a458; color: #3a121d; border: 0; border-radius: 999px;
    padding: 10px 26px; font-weight: 600; cursor: pointer;
    transition: transform 180ms var(--ease-bounce);
  }
  .result button:hover { transform: translateY(-2px) scale(1.05); }
  .result button:active { transform: scale(0.95); }

  @media (prefers-reduced-motion: reduce) {
    .result { transition: none; }
  }

  /* ---- the four shapes -------------------------------------------------- */
  .shapes {
    position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 5px; z-index: 3; max-width: 94vw;
    background: rgba(30, 10, 16, 0.6); border: 1px solid rgba(255, 196, 128, 0.18);
    border-radius: 999px; padding: 4px;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .shape {
    display: flex; align-items: baseline; gap: 6px; cursor: pointer;
    background: transparent; border: 0; border-radius: 999px;
    padding: 7px 14px; color: #f3d9c2; font: inherit; white-space: nowrap;
    transition: background 140ms var(--ease), color 140ms var(--ease);
  }
  .shape b { font-size: 13px; font-weight: 600; }
  .shape .sbest {
    font-size: 11px; color: #c49a7c; font-variant-numeric: tabular-nums;
  }
  .shape:hover { background: rgba(255, 196, 128, 0.1); }
  .shape[aria-selected='true'] { background: #e8a75c; color: #3a121d; }
  .shape[aria-selected='true'] .sbest { color: #6b2a1c; }

  /* ---- what the score is made of ---------------------------------------- */
  .factors {
    list-style: none; margin: 10px 0 0; padding: 0;
    display: grid; gap: 4px; text-align: left;
  }
  /* Every one of these children is built by JS, and Astro's scoped styles do
     not reach nodes the markup never contained — so they have to be :global.
     Without it the whole block silently renders unstyled, which is exactly
     how it first shipped: "Accuracy74%how close you were", all one run.

     The name and the number share a row; the explanation gets its own, because
     at this card width three columns collapse into one line of words. */
  .factors :global(li) {
    display: grid; grid-template-columns: 1fr auto; column-gap: 10px;
    align-items: baseline; font-size: 11.5px;
  }
  .factors :global(span) { color: #c9a68d; }
  .factors :global(b) { color: #ffe0bb; font-variant-numeric: tabular-nums; }
  .factors :global(i) {
    grid-column: 1 / -1; color: #a8836c; font-style: normal; font-size: 10.5px;
