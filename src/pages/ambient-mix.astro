---
import GameShell from '../layouts/GameShell.astro'

/**
 * Ambient Mix — a soundscape mixer with no audio files at all.
 *
 * Every layer is synthesised live in the Web Audio graph: filtered noise for
 * the textures, scheduled bursts for the events. That means the page weighs a
 * few kilobytes instead of a few megabytes, nothing has to be licensed, and
 * the loops never repeat audibly because there is no loop.
 *
 * In the shell the mixer is a dark stage. Score is how many layers are playing,
 * Heard how many of the twelve you have brought in at least once, Listened how
 * long the sound has been on, and Best the most layers you have ever had going
 * at once. Hearing all twelve is the ending. The shell's Pause suspends the
 * whole mix and its Resume brings it back; its Sound button is for the site's
 * own clicks and chimes, and the mix keeps its own switch, because the mix is
 * the thing you came for. Three class names were the design system's
 * (`.wrap`, `.grid`, `.meta`) and are prefixed.
 */

import { LAYERS, PRESETS } from '../lib/mix-code'
import { MOOD, sceneSvg } from '../lib/ambient-art'

/** #rrggbb -> "r, g, b", for the drop-shadow glow's rgba(). */
function rgb(hex: string) {
  const v = parseInt(hex.slice(1), 16)
  return `${(v >> 16) & 255}, ${(v >> 8) & 255}, ${v & 255}`
}

/**
 * Each volume control is a real rotary knob rather than a linear slider — the
 * one mechanic neal.fun's own mixer has that this page didn't. A 270-degree
 * sweep, 135deg to 405deg, is the standard hardware-pot layout: a ninety-degree
 * dead zone at the bottom, full off at seven o'clock, full on at five.
 *
 * The same trig runs again, client-side, in the script below — it has to,
 * since nothing from this frontmatter ships to the browser — so both copies
 * are kept to these same few lines on purpose.
 */
const KNOB = { cx: 22, cy: 22, track: 17, ptrIn: 13, ptrOut: 16, start: 135, sweep: 270 }
const toRad = (d: number) => (d * Math.PI) / 180
function knobPoint(r: number, deg: number) {
  return {
    x: (KNOB.cx + r * Math.cos(toRad(deg))).toFixed(2),
    y: (KNOB.cy + r * Math.sin(toRad(deg))).toFixed(2),
  }
}
function knobArc(r: number, startDeg: number, endDeg: number) {
  if (endDeg <= startDeg + 0.01) return ''
  const s = knobPoint(r, startDeg)
  const e = knobPoint(r, endDeg)
  const large = endDeg - startDeg > 180 ? 1 : 0
  return `M${s.x} ${s.y} A${r} ${r} 0 ${large} 1 ${e.x} ${e.y}`
}
const KNOB_DEFAULT = 45
const KNOB_TRACK_D = knobArc(KNOB.track, KNOB.start, KNOB.start + KNOB.sweep)
const KNOB_DEFAULT_ANGLE = KNOB.start + (KNOB_DEFAULT / 100) * KNOB.sweep
const KNOB_DEFAULT_FILL_D = knobArc(KNOB.track, KNOB.start, KNOB_DEFAULT_ANGLE)
const KNOB_DEFAULT_P1 = knobPoint(KNOB.ptrIn, KNOB_DEFAULT_ANGLE)
const KNOB_DEFAULT_P2 = knobPoint(KNOB.ptrOut, KNOB_DEFAULT_ANGLE)
---

<GameShell
  slug="ambient-mix"
  labels={{ score: 'Playing', best: 'Most at once', level: 'Heard', moves: 'Listened' }}
  initial={{ score: '0', level: `0 / ${LAYERS.length}`, moves: '0:00' }}
>
  <div class="mix-body">
  {/* The view: a landscape the mix assembles (lib/ambient/scene-frag.ts),
      with the transport over it and a line of narration in the corner. */}
  <section class="am-hero">
    <div class="view" id="view" aria-hidden="true"></div>
    <p class="caption" id="caption" aria-hidden="true"></p>
    <div class="hud">
      <div class="hud-panel">
        <button type="button" id="masterBtn" class="am-play" aria-pressed="false">
          <svg class="i-play" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M4.5 2.8v10.4a.6.6 0 0 0 .92.5l8.1-5.2a.6.6 0 0 0 0-1L5.42 2.3a.6.6 0 0 0-.92.5Z" fill="currentColor" /></svg>
          <svg class="i-pause" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><rect x="3.5" y="2.5" width="3.2" height="11" rx="0.9" fill="currentColor" /><rect x="9.3" y="2.5" width="3.2" height="11" rx="0.9" fill="currentColor" /></svg>
          <span class="play-label">Play</span>
        </button>
        <label class="master">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2.5 6h2.2L8 3.2v9.6L4.7 10H2.5Z" fill="currentColor" /><path d="M10.6 5.4a3.6 3.6 0 0 1 0 5.2M12.4 3.6a6.2 6.2 0 0 1 0 8.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
          <input type="range" id="master" min="0" max="100" value="70" aria-label="Master volume" />
        </label>
      </div>
      <div class="hud-side">
        <button type="button" id="clearBtn" class="ghost">Silence</button>
        <button type="button" id="shareBtn" class="ghost">Copy link</button>
      </div>
    </div>
  </section>

  <div class="am-wrap">
    <p class="lede">
      Twelve places, each built from the physics of how it sounds: rain as
      separate drops, thunder from the shape of its lightning, every passing
      car Doppler-shifted. Nothing here is a recording. Start with rain and
      see how long you last.
    </p>

    {/* Twelve layers is a lot of combinations, and most of them are bad. These
        are the ones worth arriving at. */}
    <h2 class="am-label" id="presetsLabel">Start from</h2>
    <div class="presets" role="group" aria-labelledby="presetsLabel">
      {PRESETS.map((p) => (
        <button type="button" class="preset" data-preset={p.id} title={p.note}>{p.name}</button>
      ))}
    </div>

    <h2 class="am-label">Layers</h2>

    <ul class="am-grid" id="grid">
      {
        LAYERS.map((l) => (
          <li class="layer" data-id={l.id} style={`--mood:${MOOD[l.id]};--moodRgb:${rgb(MOOD[l.id])}`}>
            <button type="button" class="toggle" aria-pressed="false">
              <span class="scene" aria-hidden="true" set:html={sceneSvg(l.id)} />
              <span class="am-meta">
                <span class="name">{l.name}</span>
                <span class="hint">{l.hint}</span>
              </span>
              <span class="viz" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            </button>
            <div class="knob-row">
              <div
                class="knob" role="slider" tabindex="0"
                aria-label={`${l.name} volume`} aria-valuemin="0" aria-valuemax="100"
                aria-valuenow={KNOB_DEFAULT} aria-orientation="vertical"
              >
                <svg viewBox="0 0 44 44" class="knob-face" aria-hidden="true">
                  <path class="knob-track" d={KNOB_TRACK_D} />
                  <path class="knob-fill" d={KNOB_DEFAULT_FILL_D} />
                  <circle class="knob-cap" cx="22" cy="22" r="12" />
                  <line
                    class="knob-pointer"
                    x1={KNOB_DEFAULT_P1.x} y1={KNOB_DEFAULT_P1.y}
                    x2={KNOB_DEFAULT_P2.x} y2={KNOB_DEFAULT_P2.y}
                  />
                </svg>
              </div>
              <span class="knob-val" aria-hidden="true">{KNOB_DEFAULT}%</span>
            </div>
            <input
              class="vol" type="range" min="0" max="100" value="45"
              aria-hidden="true" tabindex="-1"
            />
          </li>
        ))
      }
    </ul>

    <p class="note" id="note">Click a card to bring that layer in. Turn its knob to set how much.</p>
  </div>
  </div>

  <Fragment slot="howto">
    <p>
      A soundscape mixer with no recordings in it. Every layer — rain, waves,
      a fire, a café, a thunderstorm, a dial-up modem — is synthesised live in
      this tab.
    </p>
    <ul>
      <li>Press the sound button, then click a card to bring that layer in. Click it again to take it out.</li>
      <li>Each card's knob sets how loud it is: drag it up or down, scroll on it, or use the arrow keys. Double-click puts it back.</li>
      <li>The presets are mixes worth arriving at. Copy link puts the whole mix in the address.</li>
      <li>Pause suspends the mix. The Sound button up top is for the site's clicks, not for this.</li>
    </ul>
    <p>Bring in all twelve layers, at least once each, to finish.</p>
  </Fragment>
</GameShell>

<script>
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { recordPlay } from '../lib/stats'

  const prefersReducedMotion = !PLAY
  /* The shell's Pause holds the whole mix: the context is suspended, and only
     brought back if it was playing when Pause was pressed. Restart is the
     default reload, and the address still carries the mix. */
  let heldByPause = false
  const shell = createShell({
    slug: 'ambient-mix',
    onPause: () => { if (running && ctx) { heldByPause = true; ctx.suspend() } },
    onResume: () => { if (heldByPause && ctx) { heldByPause = false; ctx.resume() } },
  })
  import { createEngine } from '../lib/ambient/engine'
  import { Scene } from '../lib/ambient/scene'
  import { LAYERS, PRESETS, encode, decode, presetById } from '../lib/mix-code'

  const grid = document.getElementById('grid')
  const masterBtn = document.getElementById('masterBtn')
  const masterSlider = document.getElementById('master')
  const note = document.getElementById('note')

  let ctx = null
  let masterGain = null
  let engine = null
  let enginePromise = null
  const layers = new Map()

  /* Declared before the scene: its surface draws one frame synchronously as
     it is made, and that frame reads these. */
  let running = false
  let masterAnalyser = null

  /* ---- the view -----------------------------------------------------------
     A landscape the mix puts together: every layer adds its part of it, and
     where a layer has a physical model the picture follows that model — the
     waves break when the sound does, the cars are where the sound is coming
     from, lightning flashes before its thunder. Under reduced motion it is a
     still picture that changes as the mix does. */
  const view = new Scene(document.getElementById('view'), () => (engine ? engine.heard() : performance.now() / 1000), prefersReducedMotion)

  /* ---- the sound ----------------------------------------------------------
     Every layer is a physical model of the thing it is named after — rain as
     drops and bubbles, thunder from the shape of its lightning, a passing car
     with Doppler — running in an AudioWorklet (lib/ambient). The page owns
     the knobs: one gain per layer, and the master. */
  const recent = []
  const caption = document.getElementById('caption')
  let captionTimer = 0
  let captionHold = 0
  /** One line in the corner of the view, for a while. */
  function say(text, ms = 6000, hold = 0) {
    if (performance.now() < captionHold && !hold) return
    caption.textContent = text
    caption.classList.add('show')
    clearTimeout(captionTimer)
    captionTimer = setTimeout(() => caption.classList.remove('show'), ms)
    if (hold) captionHold = performance.now() + hold
  }
  /* The first time each layer comes in, a line on what it is made of. Some
     wait for the model to report a number worth quoting. */
  const ABOUT = {
    rain: () => 'Every drop is its own sound: a click on a leaf, or a bubble ringing in a puddle and rising in pitch.',
    waves: () => 'Each wave builds, breaks and drains on its own schedule, every eight to thirteen seconds, bigger ones in sets.',
    wind: (s) => s ? `Wind at ${s.speed.toFixed(0)} m/s. The wires whistle at 0.2 × speed ÷ thickness, so the pitch rises with every gust.` : '',
    fire: () => 'Fire is mostly wood: water and sap boiling inside it until it splits with a crack.',
    cafe: () => 'Ten synthesised voices at four tables, taking turns. No words — just what you hear from across a room.',
    birds: () => 'Four birds close, five further off. Each sings one of its songs a few times, then switches.',
    crickets: (s) => s ? `${Math.round(s.perMin)} chirps a minute. By Dolbear's law (1897), that makes it about ${s.temp} °C tonight.` : '',
    traffic: () => 'Every car is heard higher coming and lower going — Doppler, worked out from where it is.',
    clock: () => 'An escapement: two tiny impacts per tick, landing on your real seconds. It strikes the hour.',
    thunder: () => 'Watch for the flash, then count. Sound covers a kilometre in about three seconds.',
    mower: () => 'One cylinder at 3000 rpm: 25 firings a second, no two quite alike.',
    dial: () => 'A real modem handshake, stage by stage. It goes quiet once it connects, as they did.',
  }
  const told = new Set()
  function tell(id) {
    if (told.has(id) || !ABOUT[id]) return
    const line = ABOUT[id](engine?.state?.[id])
    if (!line) { setTimeout(() => tell(id), 600); return }
    told.add(id)
    say(line, 7000)
  }
  const MODEM = ['', 'Off the hook: dial tone, 350 + 440 Hz.', 'Dialling, in touch tones.', 'Ringing the other end.', '', 'Answered: 2100 Hz, its phase flipping every 450 ms.', 'Introductions, at 300 bits a second.', 'Line probe: a chord of tones every 150 Hz.', 'Training: the hiss.', 'Training: the hiss.', 'Connected. The speaker switches off.']
  let countdown = 0
  function onEngineEvent(e) {
    recent.push(e)
    if (recent.length > 64) recent.shift()
    const L = layers.get(e.id)
    if (!L || !L.on) return
    const wait = Math.max(0, (e.at - engine.heard()) * 1000)
    if (e.kind === 'flash' && !e.far) {
      // Shown with the flash; counted down to the thunder.
      setTimeout(() => {
        const arrive = e.at + Number(e.delay)
        clearInterval(countdown)
        const tick = () => {
          const left = arrive - engine.heard()
          if (left <= 0) {
            clearInterval(countdown)
            say(`Thunder: ${Number(e.delay).toFixed(1)} s after the flash, so it struck ${Number(e.km).toFixed(1)} km away.`, 6000, 2500)
            return
          }
          say(`Lightning, ${Number(e.km).toFixed(1)} km away. Thunder in ${Math.ceil(left)} s…`, 2500, 1200)
        }
        tick()
        countdown = setInterval(tick, 1000)
      }, wait)
    } else if (e.kind === 'modem' && MODEM[e.stage]) {
      setTimeout(() => say(MODEM[e.stage], 4000), wait)
    }
  }

  async function ensureEngine() {
    if (engine) return
    if (!enginePromise) enginePromise = createEngine(LAYERS.map((l) => l.id), Number(masterSlider.value) / 100)
    engine = await enginePromise
    ctx = engine.ctx
    masterGain = engine.master
    masterAnalyser = engine.analyser
    engine.onEvent = (e) => { onEngineEvent(e); view.event(e) }
    // For headless checks in development only: the graph, its state, its events.
    if (import.meta.env.DEV) (window as any).__mix = { engine, layers, recent, view }
    for (const li of grid.querySelectorAll('.layer')) {
      const id = li.dataset.id
      const node = engine.layers.get(id)
      layers.set(id, {
        id, li, out: node.gain, on: false, vol: Number(li.querySelector('.vol').value) / 100,
        an: node.analyser, bins: new Uint8Array(node.analyser.frequencyBinCount),
        bars: [...li.querySelectorAll('.viz i')],
      })
    }
  }

  /* ---- the knobs ----------------------------------------------------------
     Same 270-degree sweep as the frontmatter's server-rendered default state
     (see the comment there for why the trig is duplicated rather than
     shared), driving the hidden native range input rather than replacing it —
     everything downstream (the audio graph, the URL codec, presets, shared
     links) already reads that input and stays untouched. */
  const KNOB = { cx: 22, cy: 22, track: 17, ptrIn: 13, ptrOut: 16, start: 135, sweep: 270 }
  const toRad = (d) => (d * Math.PI) / 180
  function knobPoint(r, deg) {
    return { x: (KNOB.cx + r * Math.cos(toRad(deg))).toFixed(2), y: (KNOB.cy + r * Math.sin(toRad(deg))).toFixed(2) }
  }
  function knobArc(r, startDeg, endDeg) {
    if (endDeg <= startDeg + 0.01) return ''
    const s = knobPoint(r, startDeg), e = knobPoint(r, endDeg)
    const large = endDeg - startDeg > 180 ? 1 : 0
    return `M${s.x} ${s.y} A${r} ${r} 0 ${large} 1 ${e.x} ${e.y}`
  }

  const knobPaints = new Map()
  function bindKnobs() {
    for (const li of grid.querySelectorAll('.layer')) {
      const knob = li.querySelector('.knob')
      const input = li.querySelector('.vol')
      const fill = knob.querySelector('.knob-fill')
      const pointer = knob.querySelector('.knob-pointer')
      const val = li.querySelector('.knob-val')

      function paint(v) {
        v = Math.max(0, Math.min(100, v))
        const angle = KNOB.start + (v / 100) * KNOB.sweep
        fill.setAttribute('d', knobArc(KNOB.track, KNOB.start, angle))
        const p1 = knobPoint(KNOB.ptrIn, angle), p2 = knobPoint(KNOB.ptrOut, angle)
        pointer.setAttribute('x1', p1.x); pointer.setAttribute('y1', p1.y)
        pointer.setAttribute('x2', p2.x); pointer.setAttribute('y2', p2.y)
        knob.setAttribute('aria-valuenow', String(Math.round(v)))
        val.textContent = `${Math.round(v)}%`
      }
      knobPaints.set(li.dataset.id, paint)

      function setValue(v, commit) {
        v = Math.max(0, Math.min(100, Math.round(v)))
        input.value = String(v)
        paint(v)
        input.dispatchEvent(new Event('input', { bubbles: true }))
        if (commit) input.dispatchEvent(new Event('change', { bubbles: true }))
      }

      let dragging = false, startY = 0, startV = 45
      knob.addEventListener('pointerdown', (e) => {
        dragging = true
        startY = e.clientY
        startV = Number(input.value)
        knob.setPointerCapture(e.pointerId)
        knob.classList.add('grabbed')
      })
      knob.addEventListener('pointermove', (e) => {
        if (!dragging) return
        // A full-range drag (0 to 100) in about 165px — vertical, because
        // that is how a real hand actually turns a small knob: up to open it,
        // down to close it, no need to trace the arc itself.
        setValue(startV + (startY - e.clientY) * 0.6, false)
      })
      const release = () => {
        if (!dragging) return
        dragging = false
        knob.classList.remove('grabbed')
        setValue(Number(input.value), true)
      }
      knob.addEventListener('pointerup', release)
      knob.addEventListener('pointercancel', release)

      knob.addEventListener('keydown', (e) => {
        const cur = Number(input.value)
        const STEP = { ArrowUp: 2, ArrowRight: 2, ArrowDown: -2, ArrowLeft: -2, PageUp: 10, PageDown: -10 }
        if (e.key === 'Home') { setValue(0, true); e.preventDefault() }
        else if (e.key === 'End') { setValue(100, true); e.preventDefault() }
        else if (e.key in STEP) { setValue(cur + STEP[e.key], true); e.preventDefault() }
      })

      knob.addEventListener('wheel', (e) => {
        e.preventDefault()
        setValue(Number(input.value) - Math.sign(e.deltaY) * 3, true)
      }, { passive: false })

      knob.addEventListener('dblclick', () => setValue(45, true))

      paint(Number(input.value))
    }
  }
  bindKnobs()

  /* ---- the strip ----------------------------------------------------------- */
  const heard = new Set()
  let listened = 0
  let ended = false
  const clockText = (sec) => `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`
  function paintStrip() {
    let on = 0
    for (const L of layers.values()) if (L.on) on++
    shell.setScore(String(on))
    if (on > 0) shell.considerBest(on, String(on))
    shell.setLevel(`${heard.size} / ${LAYERS.length}`)
  }
  setInterval(() => {
    if (!running || shell.paused || document.hidden) return
    listened++
    shell.setMoves(clockText(listened))
  }, 1000)
  function noteHeard(id) {
    heard.add(id)
    if (ended || heard.size < LAYERS.length) return
    ended = true
    recordPlay('ambient-mix', { heard: heard.size }, { heard: 'high' })
    shell.win({
      celebrate: false,
      // The card waits under the mixer; nobody wants the page yanked mid-mix.
      scroll: false,
      kicker: 'Every layer, heard',
      title: `All ${LAYERS.length} of them.`,
      score: `${LAYERS.length} / ${LAYERS.length}`,
      lines: [
        'Not one of them was a recording. Every sound here was worked out in this tab as you heard it.',
        `${clockText(listened)} of listening so far. The mix is still going.`,
      ],
      againLabel: 'Listen again',
    })
  }

  function setLayer(L, on) {
    L.on = on
    engine.setOn(L.id, on)
    if (on && running) noteHeard(L.id)
    const target = on ? L.vol : 0
    view.setLevel(L.id, on ? Math.min(1, 0.35 + L.vol) : 0)
    L.out.gain.cancelScheduledValues(ctx.currentTime)
    L.out.gain.setTargetAtTime(target, ctx.currentTime, 0.12)
    L.li.classList.toggle('on', on)
    L.li.querySelector('.toggle').setAttribute('aria-pressed', String(on))
    paintStrip()
    if (on && running) setTimeout(() => tell(L.id), 1200)
    if (on) {
      const scene = L.li.querySelector('.scene')
      scene.classList.remove('jump')
      void scene.offsetWidth
      scene.classList.add('jump')
    }
  }

  /* One loop for every meter on the page, started with the audio and stopped
     with it, so a silent page costs nothing. */
  let meterRaf = 0
  function meters() {
    meterRaf = requestAnimationFrame(meters)
    if (!masterAnalyser) return

    view.state = engine.state

    for (const L of layers.values()) {
      if (!L.bars.length) continue
      L.an.getByteFrequencyData(L.bins)
      const per = Math.max(1, Math.floor(L.bins.length / 4))
      for (let b = 0; b < L.bars.length; b++) {
        let acc = 0
        for (let k = 0; k < per; k++) acc += L.bins[b * per + k] || 0
        const v = Math.min(1, acc / per / 190)
        // scaleY rather than height: it keeps the meters off the layout path.
        L.bars[b].style.setProperty('--v', (0.12 + v * 0.88).toFixed(3))
      }
    }

    // The ticker is parked under reduced motion: a new still now and then.
    if (prefersReducedMotion && performance.now() - lastStill > 400) { lastStill = performance.now(); view.redraw() }
  }
  let lastStill = 0

  async function start() {
    await ensureEngine()
    if (ctx.state === 'suspended') await ctx.resume()
    running = true
    // A mix that arrived in a link sets the cards before there is any sound;
    // bring those layers in now.
    for (const L of layers.values()) {
      if (L.li.classList.contains('on') && !L.on) setLayer(L, true)
    }
    for (const L of layers.values()) if (L.on) view.setLevel(L.id, Math.min(1, 0.35 + L.vol))
    cancelAnimationFrame(meterRaf)
    meters()
    paintPlay(true)
    note.textContent = 'Click a card to bring that layer in. Turn its knob to set how much.'
    for (const L of layers.values()) if (L.on) noteHeard(L.id)
  }

  const playLabel = masterBtn.querySelector('.play-label')
  function paintPlay(on) {
    masterBtn.classList.toggle('live', on)
    masterBtn.setAttribute('aria-pressed', String(on))
    masterBtn.setAttribute('aria-label', on ? 'Pause the mix' : 'Play the mix')
    playLabel.textContent = on ? 'Pause' : 'Play'
  }

  masterBtn.addEventListener('click', async () => {
    if (!running) return start()
    await ctx.suspend()
    running = false
    heldByPause = false
    cancelAnimationFrame(meterRaf)
    // Settle everything to rest rather than freezing mid-reading.
    for (const L of layers.values()) for (const b of L.bars || []) b.style.setProperty('--v', '0.12')
    for (const L of layers.values()) view.setLevel(L.id, 0)
    if (prefersReducedMotion) view.redraw()
    paintPlay(false)
  })

  // Each layer a visitor brings in by hand, once a page.
  const chosen = new Set()
  function chose(L: { id: string; on: boolean }) {
    if (!L.on || chosen.has(L.id)) return
    chosen.add(L.id)
    shell.pick('Layer brought in', LAYERS.find((l) => l.id === L.id)?.name ?? L.id)
  }

  grid.addEventListener('click', async (e) => {
    const btn = e.target.closest('.toggle')
    if (!btn) return
    const li = btn.closest('.layer')
    if (!running) await start()
    const L = layers.get(li.dataset.id)
    setLayer(L, !L.on)
    chose(L)
  })

  grid.addEventListener('input', async (e) => {
    if (!e.target.classList.contains('vol')) return
    const li = e.target.closest('.layer')
    if (!running) await start()
    const L = layers.get(li.dataset.id)
    L.vol = Number(e.target.value) / 100
    if (!L.on) { setLayer(L, true); chose(L) }
    else {
      L.out.gain.setTargetAtTime(L.vol, ctx.currentTime, 0.08)
      view.setLevel(L.id, Math.min(1, 0.35 + L.vol))
    }
  })

  masterSlider.addEventListener('input', () => {
    if (masterGain) masterGain.gain.setTargetAtTime(Number(masterSlider.value) / 100, ctx.currentTime, 0.06)
  })

  document.getElementById('clearBtn').addEventListener('click', () => {
    if (!ctx) return
    for (const L of layers.values()) setLayer(L, false)
    writeUrl()
  })

  /* ----------------------------------------------------------------------
     Presets, and the mix code in the URL.

     Everything about the format lives in lib/mix-code.ts and is checked by
     scripts/check-mix.mjs. What is left here is the two directions: putting
     the page into a mix, and reading the mix back out of the page.
     ---------------------------------------------------------------------- */

  /** What the controls currently say, whether or not there is any audio yet. */
  function readMix() {
    const levels = {}
    for (const l of LAYERS) {
      const li = grid.querySelector(`.layer[data-id="${l.id}"]`)
      if (!li) continue
      const on = li.classList.contains('on')
      const v = Number(li.querySelector('.vol').value) / 100
      if (on && v > 0) levels[l.id] = v
    }
    return { master: Number(masterSlider.value) / 100, levels }
  }

  /**
   * Put the page into a mix.
   *
   * This has to work before there is an AudioContext, because a shared link
   * arrives without a gesture and browsers will not start audio without one.
   * So it always sets the controls, and only touches the audio graph if one
   * happens to exist.
   */
  function applyMix(mix) {
    masterSlider.value = String(Math.round(mix.master * 100))
    if (masterGain) masterGain.gain.setTargetAtTime(mix.master, ctx.currentTime, 0.06)
    for (const l of LAYERS) {
      const li = grid.querySelector(`.layer[data-id="${l.id}"]`)
      if (!li) continue
      const v = mix.levels[l.id] ?? 0
      const on = v > 0
      const pct = Math.round((on ? v : 0.45) * 100)
      li.querySelector('.vol').value = String(pct)
      knobPaints.get(l.id)?.(pct)
      const L = layers.get(l.id)
      if (L) { L.vol = on ? v : 0.45; setLayer(L, on) }
      else {
        li.classList.toggle('on', on)
        li.querySelector('.toggle').setAttribute('aria-pressed', String(on))
      }
    }
  }

  /* Written by us, so the hashchange listener knows to ignore it. */
  let ownHash = ''
  function writeUrl() {
    const code = encode(readMix())
    ownHash = '#m=' + code
    history.replaceState(null, '', ownHash)
    return code
  }

  const shareBtn = document.getElementById('shareBtn')
  shareBtn.addEventListener('click', async () => {
    writeUrl()
    shell.pick('Layers in a shared mix', Object.keys(readMix().levels).length)
    const url = location.href
    let copied = false
    try {
      await navigator.clipboard.writeText(url)
      copied = true
    } catch { /* denied, or no clipboard: the URL bar has it either way. */ }
    shareBtn.textContent = copied ? 'Link copied' : 'Link is in the address bar'
    note.textContent = copied
      ? 'That link carries the whole mix. Twenty-six characters at the very most.'
      : 'The address bar now holds the mix — copy it from there.'
    clearTimeout(shareBtn._t)
    shareBtn._t = setTimeout(() => { shareBtn.textContent = 'Copy link' }, 2600)
  })

  document.querySelector('.presets').addEventListener('click', async (e) => {
    const btn = e.target.closest('.preset')
    if (!btn) return
    const p = presetById(btn.dataset.preset)
    if (!p) return
    if (!running) await start()
    applyMix(p.mix)
    writeUrl()
    shell.pick('Preset picked', p.name)
    for (const b of document.querySelectorAll('.preset')) b.classList.toggle('on', b === btn)
    note.textContent = p.note
  })

  /* A mix arriving from somebody else. The controls are set and the page waits
     for a click, because no browser will start audio without one. */
  function loadFromHash(announce) {
    const m = /(?:^|[#&])m=([^&]*)/.exec(location.hash)
    const mix = m ? decode(decodeURIComponent(m[1])) : null
    if (!mix) return false
    applyMix(mix)
    if (announce) {
      note.textContent = 'A shared mix — press the button above to hear it.'
    }
    return true
  }

  addEventListener('hashchange', () => {
    if (location.hash === ownHash) return
    loadFromHash(false)
  })

  // Keep the URL honest as the mix is fiddled with, but only once there is
  // something to describe.
  for (const el of [masterSlider]) el.addEventListener('change', () => { if (ctx) writeUrl() })
  grid.addEventListener('change', (e) => {
    if (e.target.classList.contains('vol') && ctx) writeUrl()
  })
  grid.addEventListener('click', (e) => {
    if (e.target.closest('.toggle') && ctx) setTimeout(writeUrl, 0)
  })

  loadFromHash(true)
</script>

