---
import GameLayout from '../layouts/GameLayout.astro'
import { withBase } from '../lib/base'
import { iconSvg } from '../lib/icons'
import {
  PEOPLE, CATEGORY_ORDER, MIN_YEAR, maxYear, toAxis, formatYear, lifespanLabel,
  peopleAliveIn, isAliveIn, oldestAliveIn, youngestAliveIn, ageIn, emptyStretches,
  type Category,
} from '../data/historical-figures'

/**
 * Who Was Alive — a brass year counter over a chart of eighty-nine real lives.
 *
 * `src/data/historical-figures.ts` is the whole model: the record itself and
 * the arithmetic over it, pure functions over plain data so
 * `scripts/check-who-was-alive.mjs` can run the lot headlessly. Nothing on
 * this page recomputes a span by hand — the one subtraction that matters
 * (`yearsBetween`, which knows there is no year zero) lives there and is
 * called from here.
 *
 * The page is one object: an engraved brass counter bolted to a walnut plate,
 * the chart it indexes on the sheet below it, and the roster of names under
 * that. No LED anywhere — the subject is a paper record, not an instrument
 * with a power supply, and the seven-segment module the other counters on
 * this site share would be the wrong century.
 *
 * Everything the year changes is a `textContent` write or a class toggle on
 * markup that already exists. All eighty-nine chart bars and all eighty-nine
 * roster rows are rendered here, at build time, and hidden or lit rather
 * than rebuilt — which is why there is no `innerHTML` on this page and
 * therefore none of the scoped-style trap that has bitten every game here
 * that did use one. (The style block is `is:global` anyway, prefixed `wa-`.)
 */

const TOTAL = PEOPLE.length
const MAXY = maxYear()
const START_YEAR = 1900

/* ---- the chart ---------------------------------------------------------- */

// Chart geometry, in viewBox units. The head-room above the first row has to
// hold the needle's own label and flag, which sit outside the plotted rows —
// the first pass put the label at a negative y and resvg simply clipped it
// away, which is exactly the class of bug check-art exists for one slot up.
const ROW_H = 8
const BAR_H = 5
const TOP = 58
const BOTTOM = 34
const LABEL_Y = 22
const FLAG_Y = 36
const CHART_W = 1000
const CHART_H = TOP + PEOPLE.length * ROW_H + BOTTOM
const RULE_TOP = 30
const TICK_TOP = 26
const FOOT = CHART_H - BOTTOM
const X0 = 44
const X1 = 988

// Plotted in astronomical years so a bar's drawn length is its real length:
// the era boundary is one year wide, not two.
const DOM0 = toAxis(Math.min(...PEOPLE.map((p) => p.birth))) - 24
const DOM1 = MAXY + 14
const px = (year: number) => X0 + ((toAxis(year) - DOM0) / (DOM1 - DOM0)) * (X1 - X0)

// A bolder, jewel-toned palette than lib/icons.ts's own PALETTE on purpose:
// that one is deliberately mid-tone so a 24px glyph clears 3:1 on both a
// cream and a near-black page, and painted onto an 89-row chart at that same
// muted band, the whole thing read as washed-out rather than illuminated.
// This chart only ever sits on parchment, so it is free to go richer — like
// a hand-tinted engraving instead of a filing cabinet's colour-coded tabs.
// Reused for the legend swatches and the roster's own category icons below,
// so recolouring here recolours the whole page consistently from one table.
const BAR_COLOUR: Record<Category, string> = {
  ruler: '#c17f0a',
  leader: '#ad2142',
  military: '#3f5871',
  philosopher: '#6a3aa0',
  scientist: '#0f8f68',
  inventor: '#c1521a',
  explorer: '#146fa8',
  writer: '#a02e82',
  artist: '#c23a5e',
  athlete: '#4f7f1e',
  other: '#7a6a4a',
}

const byBirth = [...PEOPLE].sort((a, b) => a.birth - b.birth || a.name.localeCompare(b.name))
const bars = byBirth.map((p, i) => {
  const x = px(p.birth)
  const w = Math.max(3, px(p.death ?? MAXY) - x)
  return {
    p, i, x, w,
    y: TOP + i * ROW_H + (ROW_H - BAR_H) / 2,
    fill: BAR_COLOUR[p.category],
    alive: isAliveIn(p, START_YEAR),
    title: `${p.name}, ${lifespanLabel(p)} — ${p.place}`,
  }
})

const MINOR = [-500, -250, 1, 250, 500, 750, 1000, 1250, 1500, 1750, 2000]
const MAJOR: { year: number; label: string }[] = [
  { year: -500, label: '500 BC' },
  { year: 1, label: 'AD 1' },
  { year: 500, label: 'AD 500' },
  { year: 1000, label: 'AD 1000' },
  { year: 1500, label: '1500' },
  { year: 2000, label: '2000' },
]

/* ---- the roster --------------------------------------------------------- */

const sections = CATEGORY_ORDER.map((c) => ({
  ...c,
  colour: BAR_COLOUR[c.key],
  mark: iconSvg(c.icon),
  people: PEOPLE.filter((p) => p.category === c.key).sort((a, b) => a.birth - b.birth),
})).filter((s) => s.people.length > 0)

/* ---- the opening readout, computed here rather than guessed -------------- */

const startAlive = peopleAliveIn(START_YEAR)
const startOldest = oldestAliveIn(START_YEAR)!
const startYoungest = youngestAliveIn(START_YEAR)!

/* ---- the hole in the record --------------------------------------------- */

const gaps = emptyStretches()
if (!gaps.length) throw new Error('who-was-alive: the record has no empty stretch — the note below the chart is a lie')
const biggest = gaps.reduce((a, b) => (toAxis(b.to) - toAxis(b.from) > toAxis(a.to) - toAxis(a.from) ? b : a))
const biggestSpan = toAxis(biggest.to) - toAxis(biggest.from) + 1

const startDigits = String(Math.abs(START_YEAR)).padStart(4, '0').split('')
const DRUM_CELLS = 30
---

<GameLayout slug="who-was-alive" bar="#3a2b18" bodyClass="wa-body">
  <div class="wa-grain" aria-hidden="true"></div>

  <header class="wa-head">
    <p class="wa-eyebrow">Eighty-nine lives, one shared timeline</p>
    <h1>Who Was Alive</h1>
    <p class="wa-lede">
      Set the counter to any year between 700 BC and this one. Every life in
      the record that reached that year lights up on the chart, and the roster
      underneath names them. Every birth and death year here is a settled
      fact — nothing is rounded to make a tidier picture, and nobody has been
      invented to fill a quiet century.
    </p>
  </header>

  <!-- ---- the instrument ------------------------------------------------ -->
  <section class="wa-instrument" aria-labelledby="wa-inst-h">
    <h2 class="wa-sr" id="wa-inst-h">The year counter</h2>

    <div class="wa-plate">
      <i class="wa-bolt wa-bolt-tl" aria-hidden="true"></i><i class="wa-bolt wa-bolt-tr" aria-hidden="true"></i>
      <i class="wa-bolt wa-bolt-bl" aria-hidden="true"></i><i class="wa-bolt wa-bolt-br" aria-hidden="true"></i>

      <p class="wa-engraved">Register of the living &middot; {TOTAL} entries &middot; 551 BC&ndash;{MAXY}</p>

      <div class="wa-counter">
        <span class="wa-era" id="waEra">AD</span>
        <div class="wa-drums">
          {
            startDigits.map((d, k) => (
              <div class="wa-drum" data-drum={k}>
                <div class="wa-strip" data-strip={k} data-pos={10 + Number(d)}
                     style={`transform:translateY(-${((10 + Number(d)) * 100) / DRUM_CELLS}%)`}>
                  {Array.from({ length: DRUM_CELLS }, (_, j) => <span class="wa-cell">{j % 10}</span>)}
                </div>
              </div>
            ))
          }
        </div>
        <div class="wa-glass" aria-hidden="true"></div>
      </div>

      <div
        class="wa-wheel"
        id="waWheel"
        role="slider"
        tabindex="0"
        aria-label="Year"
        aria-valuemin={MIN_YEAR}
        aria-valuemax={MAXY}
        aria-valuenow={START_YEAR}
        aria-valuetext={formatYear(START_YEAR)}
      >
        <span class="wa-knurl" id="waKnurl" aria-hidden="true"></span>
      </div>

      <div class="wa-steps">
        <button type="button" class="wa-step" data-step="-100">&minus;100</button>
        <button type="button" class="wa-step" data-step="-10">&minus;10</button>
        <button type="button" class="wa-step" data-step="-1">&minus;1</button>
        <button type="button" class="wa-step" data-step="1">+1</button>
        <button type="button" class="wa-step" data-step="10">+10</button>
        <button type="button" class="wa-step" data-step="100">+100</button>
      </div>

      <p class="wa-hint">Drag the wheel, scroll over it, or use the arrow keys.</p>
    </div>

    <div class="wa-jumps">
      <form class="wa-jump" id="waGoForm" novalidate>
        <label for="waGo">Go to a year</label>
        <div class="wa-field">
          <input
            id="waGo" name="year" type="text" inputmode="text" autocomplete="off" spellcheck="false"
            placeholder="1492, 44 BC, AD 800"
          />
          <button type="submit">Set</button>
        </div>
        <p class="wa-err" id="waGoErr" role="status">&nbsp;</p>
      </form>

      <div class="wa-jump">
        <label for="waDob">Jump to the year you were born</label>
        <div class="wa-field">
          <input id="waDob" type="date" max={`${MAXY}-12-31`} />
        </div>
        <p class="wa-note">Stays in your browser. Nothing is sent anywhere.</p>
      </div>
    </div>
  </section>

  <!-- ---- the readout --------------------------------------------------- -->
  <section class="wa-readout">
    <div aria-live="polite" aria-atomic="true">
      <p class="wa-count">
        <b id="waCount">{startAlive.length}</b>
        <span>of {TOTAL} were alive in <b id="waYearWord">{formatYear(START_YEAR)}</b></span>
      </p>

      <dl class="wa-ends" id="waEnds">
        <div>
          <dt>Oldest that year</dt>
          <dd><b id="waOldest">{startOldest.person.name}</b><span id="waOldestAge">{startOldest.age}</span></dd>
        </div>
        <div>
          <dt>Youngest that year</dt>
          <dd><b id="waYoungest">{startYoungest.person.name}</b><span id="waYoungestAge">{startYoungest.age}</span></dd>
        </div>
      </dl>
    </div>

    <p class="wa-nobody" id="waNobody" hidden>
      Nobody in this record was alive then.
      <button type="button" id="waNearest">Go to the nearest year that has somebody</button>
    </p>
  </section>

  <!-- ---- the chart ----------------------------------------------------- -->
  <section class="wa-chart" aria-labelledby="wa-chart-h">
    <h2 id="wa-chart-h">All {TOTAL} lives, on one scale</h2>
    <p class="wa-sub">
      One bar per person, sorted by year of birth, on a single linear axis —
      so a long life is drawn long and the empty stretches are really empty.
      The needle stands in the year the counter shows. Click a bar to go to
      the year that person was born.
    </p>

    <div class="wa-chart-frame">
      <svg
        class="wa-svg"
        viewBox={`0 0 ${CHART_W} ${CHART_H}`}
        role="img"
        aria-label={`All ${TOTAL} lifespans in the record, drawn as bars on one shared timeline from 551 BC to ${MAXY}. The ones alive in the year the counter shows are lit; the rest are faded.`}
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          {/* The needle's own light: a soft vertical wash that stands in the
              selected year and moves with it, so "now" reads as illuminated
              rather than just marked by a line. */}
          <radialGradient id="wa-spot-grad" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#f0d28f" stop-opacity="0.65" />
            <stop offset="55%" stop-color="#e8cd8a" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#e8cd8a" stop-opacity="0" />
          </radialGradient>
        </defs>

        <g class="wa-rules">
          {MINOR.map((y) => <path d={`M${px(y).toFixed(1)} ${RULE_TOP}V${FOOT + 6}`} />)}
        </g>
        <g class="wa-axis">
          {MAJOR.map((t) => <path class="wa-axis-tick" d={`M${px(t.year).toFixed(1)} ${TICK_TOP}V${FOOT + 10}`} />)}
          {MAJOR.map((t) => <text x={px(t.year).toFixed(1)} y={CHART_H - 10} text-anchor="middle">{t.label}</text>)}
        </g>

        <rect
          class="wa-spot"
          id="waSpot"
          x={(px(START_YEAR) - 90).toFixed(1)}
          y={RULE_TOP}
          width="180"
          height={FOOT + 6 - RULE_TOP}
          fill="url(#wa-spot-grad)"
          aria-hidden="true"
        />

        <g class="wa-bars">
          {
            bars.map((b) => (
              <rect
                class:list={['wa-bar', { 'is-alive': b.alive }]}
                style={`--c:${b.fill}`}
                x={b.x.toFixed(1)}
                y={b.y}
                width={b.w.toFixed(1)}
                height={BAR_H}
                rx={BAR_H / 2}
                fill={b.fill}
                data-birth={b.p.birth}
                data-name={b.p.name}
                data-years={lifespanLabel(b.p)}
                data-place={b.p.place}
                data-colour={b.fill}
                data-category={b.p.category}
              >
                <title>{b.title}</title>
              </rect>
            ))
          }
        </g>

        <g class="wa-needle" id="waNeedle" transform={`translate(${px(START_YEAR).toFixed(1)} 0)`}>
          <path class="wa-needle-glow" d={`M0 ${FLAG_Y}V${FOOT + 12}`} />
          <path d={`M0 ${FLAG_Y}V${FOOT + 12}`} />
          <path class="wa-needle-head" d={`M0 ${FLAG_Y - 9} 8 ${FLAG_Y} 0 ${FLAG_Y + 9} -8 ${FLAG_Y}Z`} />
        </g>
        <text class="wa-needle-label" id="waNeedleLabel" x={px(START_YEAR).toFixed(1)} y={LABEL_Y} text-anchor="middle">
          {formatYear(START_YEAR)}
        </text>
      </svg>
      <div class="wa-tip" id="waTip" aria-hidden="true" hidden>
        <p class="wa-tip-name" id="waTipName"></p>
        <p class="wa-tip-meta"><span id="waTipYears"></span> &middot; <span id="waTipPlace"></span></p>
      </div>
    </div>

    <ul class="wa-legend" id="waLegend">
      {
        sections.map((s) => (
          <li>
            <button type="button" class="wa-legend-btn" data-category={s.key} aria-pressed="false">
              <i style={`background:${s.colour}`} aria-hidden="true"></i>{s.label}
            </button>
          </li>
        ))
      }
    </ul>

    <p class="wa-gap-note">
      The longest stretch this record cannot speak for runs from
      <b>{formatYear(biggest.from)}</b> to <b>{formatYear(biggest.to)}</b> —
      {biggestSpan.toLocaleString('en-US')} years in which none of these {TOTAL} people
      was alive. That is a hole in the list, not in history.
    </p>
  </section>

  <!-- ---- the roster ---------------------------------------------------- -->
  <section class="wa-roster" aria-labelledby="wa-roster-h">
    <h2 id="wa-roster-h">Who that was</h2>
    <p class="wa-sub">
      Grouped by what each one was known for, oldest first inside each group.
      Ages are differences of years — without birthdays they can be a year
      high either side.
    </p>

    {
      sections.map((s) => {
        const shown = s.people.filter((p) => isAliveIn(p, START_YEAR))
        return (
          <section class="wa-group" data-cat={s.key} hidden={shown.length === 0}>
            <h3 class="wa-group-h">
              <span class="wa-cat-mark" style={`color:${s.colour}`} set:html={s.mark} />
              <span class="wa-group-name">{s.label}</span>
              <span class="wa-group-note">{s.note}</span>
              <span class="wa-group-count" data-count>{shown.length}</span>
            </h3>
            <ol class="wa-rows">
              {
                s.people.map((p) => (
                  <li
                    class="wa-row"
                    data-birth={p.birth}
                    data-death={p.death ?? ''}
                    hidden={!isAliveIn(p, START_YEAR)}
                  >
                    <span class="wa-row-name">{p.name}</span>
                    <span class="wa-row-years">{lifespanLabel(p)}</span>
                    <span class="wa-row-age" data-age>{ageIn(p, START_YEAR)}</span>
                    <span class="wa-row-place">{p.place}</span>
                    <span class="wa-row-blurb">{p.blurb}</span>
                  </li>
                ))
              }
            </ol>
          </section>
        )
      })
    }

    <p class="wa-roster-empty" id="waRosterEmpty" hidden>
      The roster is empty for this year.
    </p>
  </section>

  <footer class="wa-outro">
    <div class="wa-acts">
      <button type="button" data-share data-title="Who Was Alive">Share this</button>
      <a href={withBase('/')}>try something else &rarr;</a>
    </div>

    <details class="wa-how">
      <summary>Which of this is real</summary>
      <p>
        <b>Every year in the record is a fact,</b> at the level Wikipedia and
        Britannica agree on, and none of them has been rounded. Where a
        scholar would write <i>c.</i> in front of a year, the person is not in
        the list at all — which is why the first millennium is so thin here,
        and why the gap between Augustus and Charlemagne is stated above
        rather than filled in.
      </p>
      <p>
        <b>There is no year zero,</b> and that is load-bearing.
        <code>1 BC</code> is written <code>-1</code> in the data and
        <code>AD 1</code> is written <code>1</code>, with exactly one year
        between them — so every span is measured with a function that knows
        it, not with a subtraction. The first version subtracted, and put
        Augustus at 77 years old against a real 76 calendar years from 63 BC
        to AD 14. <code>scripts/check-who-was-alive.mjs</code> holds all of
        that to account, along with the roster and the two named extremes,
        against answers worked out by hand for five fixed years.
      </p>
      <p>
        <b>Ages are differences of years.</b> The record holds years, not
        dates, so somebody whose birthday falls late in the year reads a year
        older here than they were for most of it. Stated rather than hidden;
        adding fake birthdays to fix it would be worse.
      </p>
      <p>
        Related: <a href={withBase('/deep-time/')}>Deep Time</a> is the other
        page here about a span too long to picture, and
        <a href={withBase('/life-in-weeks/')}>Life in Weeks</a> is the other
        one that starts from the year you were born.
      </p>
    </details>
  </footer>
</GameLayout>

{/* Data for the module below: modules cannot take define:vars, and modules
    are what let every game share one synthesiser. */}
<script
  type="application/json"
  id="wa-data"
  set:html={JSON.stringify({
    minYear: MIN_YEAR, maxYear: MAXY, startYear: START_YEAR, total: TOTAL,
    x0: X0, x1: X1, dom0: DOM0, dom1: DOM1, drumCells: DRUM_CELLS,
    top: TOP, chartW: CHART_W,
  })}
/>

<script>
  import {
    PEOPLE, MIN_YEAR, clampYear, formatYear, isAliveIn, peopleAliveIn, yearsBetween,
    oldestAliveIn, youngestAliveIn, nearestPopulatedYear, parseYearInput, toAxis,
  } from '../data/historical-figures'
  import { sfx, unlock } from '../lib/audio'
  import { onShare } from '../lib/share-card'
  import { recordPlay } from '../lib/stats'
  import { SITE } from '../site.config'
  import { prefersReducedMotion } from '../lib/gl'

  const D = JSON.parse(document.getElementById('wa-data')!.textContent!) as {
    minYear: number; maxYear: number; startYear: number; total: number
    x0: number; x1: number; dom0: number; dom1: number; drumCells: number
    top: number; chartW: number
  }

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T

  const wheel = $('waWheel')
  const knurl = $('waKnurl')
  const era = $('waEra')
  const strips = [...document.querySelectorAll<HTMLElement>('.wa-strip')]
  const needle = $('waNeedle')
  const needleLabel = $('waNeedleLabel')
  const bars = [...document.querySelectorAll<SVGRectElement>('.wa-bar')]
  const barsGroup = document.querySelector<SVGGElement>('.wa-bars')!
  const spot = document.getElementById('waSpot') as unknown as SVGRectElement
  const rows = [...document.querySelectorAll<HTMLElement>('.wa-row')]
  const groups = [...document.querySelectorAll<HTMLElement>('.wa-group')]
  const chartFrame = document.querySelector<HTMLElement>('.wa-chart-frame')!
  const tip = $('waTip')
  const tipName = $('waTipName')
  const tipYears = $('waTipYears')
  const tipPlace = $('waTipPlace')
  const legend = $('waLegend')
  const legendBtns = [...document.querySelectorAll<HTMLButtonElement>('.wa-legend-btn')]
  const goForm = $<HTMLFormElement>('waGoForm')
  const goBox = $<HTMLInputElement>('waGo')
  const goErr = $('waGoErr')
  const dob = $<HTMLInputElement>('waDob')

  // Each bar's own centre, in chart units, read once from the markup rather
  // than recomputed — the wave-delay effect below needs a fixed distance
  // from the needle per bar on every repaint, and re-parsing 89 attributes
  // on a drag is exactly the kind of per-frame cost paintCounter's own
  // comment already warns against.
  const barCentres = bars.map((b) => Number(b.getAttribute('x')) + Number(b.getAttribute('width')) / 2)

  // The chart rows are in the same order as PEOPLE sorted by birth; the roster
  // rows are in section order. Both are matched to a person once, here, so no
  // lookup by name happens on the hot path.
  const byBirth = [...PEOPLE].sort((a, b) => a.birth - b.birth || a.name.localeCompare(b.name))
  const rowPeople = rows.map((r) => ({
    birth: Number(r.dataset.birth),
    death: r.dataset.death === '' ? null : Number(r.dataset.death),
    age: r.querySelector<HTMLElement>('[data-age]')!,
  }))
  // Queried once, not once per repaint: a drag repaints every few
  // milliseconds and `querySelectorAll` inside that loop is the difference
  // between a wheel that turns and one that stutters.
  const groupRows = groups.map((g) => ({
    el: g,
    rows: [...g.querySelectorAll<HTMLElement>('.wa-row')],
    count: g.querySelector<HTMLElement>('[data-count]')!,
  }))

  const px = (y: number) => D.x0 + ((toAxis(y) - D.dom0) / (D.dom1 - D.dom0)) * (D.x1 - D.x0)

  let year = D.startYear
  let lastTick = 0

  /* ---- the drums ---------------------------------------------------------
   * A real rolling counter takes the short way round: 9 to 0 is one step
   * forward, not nine steps back. The strip carries three copies of 0-9 so
   * there is always room to roll either way, and re-seats itself into the
   * middle copy — without a transition, so the seat is invisible — whenever
   * it drifts near an end. Driving it off a single copy is what makes a
   * cheap odometer spin backwards through eight digits at every decade.
   */
  function setDrum(strip: HTMLElement, digit: number) {
    const cells = D.drumCells
    let pos = Number(strip.dataset.pos)
    const cur = ((pos % 10) + 10) % 10
    let delta = digit - cur
    if (delta > 5) delta -= 10
    if (delta < -5) delta += 10
    if (delta === 0) return
    let next = pos + delta
    if (next < 3 || next > cells - 4) {
      const seat = 10 + cur
      strip.style.transition = 'none'
      strip.style.transform = `translateY(${(-seat * 100) / cells}%)`
      void strip.offsetHeight
      strip.style.transition = ''
      next = seat + delta
    }
    strip.dataset.pos = String(next)
    strip.style.transform = `translateY(${(-next * 100) / cells}%)`
  }

  function paintCounter(y: number) {
    const digits = String(Math.abs(y)).padStart(4, '0')
    strips.forEach((s, i) => setDrum(s, Number(digits[i])))
    const bc = y < 0
    era.textContent = bc ? 'BC' : 'AD'
    era.classList.toggle('is-bc', bc)
  }

  /* ---- everything the year changes -------------------------------------- */

  function paint(y: number, { quiet = false } = {}) {
    year = y
    paintCounter(y)

    wheel.setAttribute('aria-valuenow', String(y))
    wheel.setAttribute('aria-valuetext', formatYear(y))
    knurl.style.backgroundPositionX = `${(y * 7) % 1000}px`

    const x = px(y)
    needle.setAttribute('transform', `translate(${x.toFixed(1)} 0)`)
    needleLabel.setAttribute('x', String(Math.min(D.chartW - 46, Math.max(46, x)).toFixed(1)))
    needleLabel.textContent = formatYear(y)
    spot.setAttribute('x', (x - 90).toFixed(1))

    // Only when the chart is actually wider than its frame — on a desktop it
    // never is, and scrolling a frame that does not scroll is a no-op that
    // still costs a layout read.
    if (chartFrame.scrollWidth > chartFrame.clientWidth + 1) {
      const at = (x / D.chartW) * chartFrame.scrollWidth
      chartFrame.scrollLeft = Math.max(0, at - chartFrame.clientWidth / 2)
    }

    // A bar's transition-delay rides on its own distance from the needle, so
    // a life crossing into or out of "alive" doesn't just flip — it catches
    // light in a wave that spreads out from the year itself, front-most bars
    // first. Recomputed every paint rather than once, since the needle is
    // the thing moving: fixed per-bar delays would only ripple correctly
    // from a single fixed year.
    for (let i = 0; i < bars.length; i++) {
      const bar = bars[i]
      bar.classList.toggle('is-alive', isAliveIn(byBirth[i], y))
      if (!prefersReducedMotion) {
        bar.style.transitionDelay = `${Math.min(150, Math.abs(barCentres[i] - x) * 0.1).toFixed(0)}ms`
      }
    }

    let alive = 0
    for (let i = 0; i < rows.length; i++) {
      const p = rowPeople[i]
      const on = p.birth <= y && (p.death === null || y <= p.death)
      rows[i].hidden = !on
      if (on) {
        alive++
        p.age.textContent = String(yearsBetween(p.birth, y))
      }
    }
    for (const g of groupRows) {
      let shown = 0
      for (const r of g.rows) if (!r.hidden) shown++
      g.el.hidden = shown === 0
      g.count.textContent = String(shown)
    }

    $('waCount').textContent = String(alive)
    $('waYearWord').textContent = formatYear(y)

    const oldest = oldestAliveIn(y)
    const youngest = youngestAliveIn(y)
    const ends = $('waEnds')
    ends.hidden = !oldest
    $('waNobody').hidden = !!oldest
    $('waRosterEmpty').hidden = !!oldest
    if (oldest && youngest) {
      $('waOldest').textContent = oldest.person.name
      $('waOldestAge').textContent = String(oldest.age)
      $('waYoungest').textContent = youngest.person.name
      $('waYoungestAge').textContent = String(youngest.age)
    }

    if (!quiet) {
      const now = performance.now()
      if (now - lastTick > 55) { lastTick = now; sfx.tick() }
    }
  }

  const setYear = (y: number, opts?: { quiet?: boolean }) => {
    const c = clampYear(y, D.maxYear)
    if (c === year) return
    paint(c, opts)
  }

  /* ---- the wheel ---------------------------------------------------------- */

  const PX_PER_YEAR = 2.4
  let dragFrom: { x: number; year: number } | null = null

  wheel.addEventListener('pointerdown', (e) => {
    unlock()
    dragFrom = { x: e.clientX, year }
    wheel.setPointerCapture(e.pointerId)
    wheel.classList.add('is-dragging')
  })
  wheel.addEventListener('pointermove', (e) => {
    if (!dragFrom) return
    e.preventDefault()
    setYear(dragFrom.year + Math.round((e.clientX - dragFrom.x) / PX_PER_YEAR))
  })
  const endDrag = () => { dragFrom = null; wheel.classList.remove('is-dragging') }
  wheel.addEventListener('pointerup', endDrag)
  wheel.addEventListener('pointercancel', endDrag)

  // Contained to the wheel itself: nowhere else on the page takes the scroll
  // away from you.
  wheel.addEventListener('wheel', (e) => {
    e.preventDefault()
    const dir = Math.sign(e.deltaY || e.deltaX)
    setYear(year + dir * (e.shiftKey ? 10 : 1))
  }, { passive: false })

  wheel.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 10 : 1
    const moves: Record<string, number> = {
      ArrowRight: step, ArrowUp: step, ArrowLeft: -step, ArrowDown: -step,
      PageUp: 50, PageDown: -50,
    }
    if (e.key in moves) { e.preventDefault(); setYear(year + moves[e.key]) }
    else if (e.key === 'Home') { e.preventDefault(); setYear(MIN_YEAR) }
    else if (e.key === 'End') { e.preventDefault(); setYear(D.maxYear) }
  })

  for (const b of document.querySelectorAll<HTMLButtonElement>('.wa-step')) {
    b.addEventListener('click', () => { unlock(); sfx.click(); setYear(year + Number(b.dataset.step)) })
  }

  /* ---- typing a year, and your own ---------------------------------------- */

  // Implicit submission on Enter is a browser behaviour, not a guarantee —
  // it is suppressed in enough real situations (and in enough automation)
  // that the one control whose whole job is "type a year and go there"
  // should not depend on it.
  goBox.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); goForm.requestSubmit() }
  })

  goForm.addEventListener('submit', (e) => {
    e.preventDefault()
    const parsed = parseYearInput(goBox.value, D.maxYear)
    if (parsed === null) {
      goErr.textContent = `Try a year between 700 BC and ${D.maxYear} — "1492", "44 BC", "AD 800".`
      sfx.bad()
      return
    }
    goErr.innerHTML = '&nbsp;'
    sfx.click()
    setYear(parsed)
    document.querySelector('.wa-readout')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  })

  dob.addEventListener('change', () => {
    const v = dob.valueAsDate
    if (!v) return
    sfx.click()
    setYear(v.getUTCFullYear())
  })

  $('waNearest').addEventListener('click', () => {
    sfx.click()
    setYear(nearestPopulatedYear(year))
  })

  /* ---- the chart is a control too ------------------------------------------ */

  for (const b of bars) {
    b.addEventListener('click', () => { unlock(); sfx.click(); setYear(Number(b.dataset.birth)) })
  }

  // One pair of listeners on the group rather than 89 pairs on each bar —
  // `pointerover`/`pointerout` bubble, and the target is always the bar
  // itself since nothing else in the group can receive a pointer event.
  const frameRect = () => chartFrame.getBoundingClientRect()
  barsGroup.addEventListener('pointerover', (e) => {
    const bar = (e.target as Element).closest?.('.wa-bar') as SVGRectElement | null
    if (!bar) return
    tipName.textContent = bar.dataset.name ?? ''
    tipYears.textContent = bar.dataset.years ?? ''
    tipPlace.textContent = bar.dataset.place ?? ''
    tip.hidden = false
    requestAnimationFrame(() => tip.classList.add('is-shown'))
  })
  barsGroup.addEventListener('pointermove', (e) => {
    if (tip.hidden) return
    const r = frameRect()
    // .wa-tip is positioned inside the frame's own scrollable content, so a
    // narrow-viewport horizontal scroll (see .wa-chart-frame's own comment)
    // has to be added back in, or the tooltip drifts left of the cursor by
    // exactly however far the chart has been scrolled.
    tip.style.left = `${(e as PointerEvent).clientX - r.left + chartFrame.scrollLeft}px`
    tip.style.top = `${(e as PointerEvent).clientY - r.top}px`
  })
  barsGroup.addEventListener('pointerout', (e) => {
    const bar = (e.target as Element).closest?.('.wa-bar')
    if (!bar) return
    tip.classList.remove('is-shown')
    tip.hidden = true
  })

  // The legend doubles as a filter: click a category to isolate it (every
  // other bar and every other chip steps back), click it again — or click a
  // different one — to change or clear the isolation. A Set of one, but
  // written as one so a future "compare two categories" doesn't need a
  // rewrite, only a second add().
  const activeCats = new Set<string>()
  function applyLegendFilter() {
    legend.classList.toggle('has-active', activeCats.size > 0)
    barsGroup.classList.toggle('has-filter', activeCats.size > 0)
    for (const btn of legendBtns) btn.setAttribute('aria-pressed', String(activeCats.has(btn.dataset.category!)))
    for (const b of bars) b.classList.toggle('wa-cat-match', activeCats.size === 0 || activeCats.has(b.dataset.category!))
  }
  for (const btn of legendBtns) {
    btn.addEventListener('click', () => {
      sfx.click()
      const cat = btn.dataset.category!
      if (activeCats.has(cat)) activeCats.delete(cat)
      else { activeCats.clear(); activeCats.add(cat) }
      applyLegendFilter()
    })
  }

  // Visible by default (see the .wa-chart-frame rule itself); JS only ever
  // adds .wa-pending to a frame already confirmed below the fold, so a slow
  // or blocked script never leaves the chart stuck invisible — the same
  // fix Printing Money's own reveal needed after a rapid-scroll stress test
  // first turned up a blank frame there.
  if (!prefersReducedMotion && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue
          chartFrame.classList.add('wa-in')
          chartFrame.classList.remove('wa-pending')
          io.unobserve(en.target)
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
    )
    if (chartFrame.getBoundingClientRect().top > innerHeight * 0.85) chartFrame.classList.add('wa-pending')
    io.observe(chartFrame)
  }

  /* ---- share ---------------------------------------------------------------- */

  onShare(
    () => {
      const alive = peopleAliveIn(year)
      const oldest = oldestAliveIn(year)
      return {
        slug: 'who-was-alive',
        siteName: SITE.name,
        headline: alive.length
          ? `${alive.length} of ${D.total} were alive in ${formatYear(year)}`
          : `Nobody in the record was alive in ${formatYear(year)}`,
        sub: 'Eighty-nine real lives on one timeline.',
        stats: [
          { label: 'Year', value: formatYear(year) },
          { label: 'Alive then', value: `${alive.length} of ${D.total}` },
          { label: 'Oldest', value: oldest ? `${oldest.person.name}, ${oldest.age}` : 'nobody' },
        ],
      }
    },
    (c) => ({ title: 'Who Was Alive', text: c.headline }),
  )

  paint(D.startYear, { quiet: true })
  recordPlay('who-was-alive')
</script>

