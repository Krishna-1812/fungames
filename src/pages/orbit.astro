---
import GameShell from '../layouts/GameShell.astro'
import { GOALS } from '../lib/orbit-goals'

/**
 * Orbit - an n-body gravity sandbox, with nine things to attempt in it.
 *
 * The physics moved to lib/orbit-sim.ts and the challenges live in
 * lib/orbit-goals.ts, both of which run headlessly so scripts/check-orbit.mjs
 * can drive them against closed-form answers. What is left here is the page:
 * input, presentation, and the panel.
 *
 * Every body pulls on every other body with real Newtonian gravity, softened
 * at short range and integrated symplectically so orbits stay stable for
 * minutes instead of spiralling apart. Collisions merge bodies and conserve
 * momentum, so a crowded system genuinely settles into a few large survivors
 * on its own.
 *
 * Trails come from fading the canvas rather than storing history, which costs
 * one fill per frame instead of thousands of stored points.
 *
 * In the shell the sky is the stage, framed rather than filling the window.
 * Score is the bodies in it, Collisions the merges, Challenges the eight, and
 * Most laps the longest orbit you have flown. Each challenge gets its headline as
 * it lands; all eight is the ending. Restart is a fresh solar system. Freeze
 * holds the sky without covering it (a loaded scene arrives frozen), and the
 * shell's Pause holds it too. Scene links moved from the old share button to
 * a Share scene button in the dock.
 */
---

<GameShell
  slug="orbit"
  labels={{ score: 'Bodies', best: 'Most laps', level: 'Challenges', moves: 'Collisions' }}
  initial={{ score: '0', level: `0 / ${GOALS.length}`, moves: '0' }}
>
  <div class="orbit-body" id="stage">
    <canvas id="sky" tabindex="0" aria-label="Gravity simulation" aria-describedby="keyboardHelp"></canvas>
    <p id="keyboardHelp" class="sr-only">Press K to aim a launch. Arrow keys move the starting point. Hold Shift and use arrow keys to change launch direction and speed. Enter launches. Escape cancels.</p>
    <p id="keyboardStatus" class="sr-only" role="status" aria-live="polite"></p>
    {/* The aim indicator is interface, not scene. Keeping it on its own 2D
        layer means a crisp dashed line rather than one that picks up bloom and
        the trail fade along with everything else. */}
    <canvas id="aimLayer" aria-hidden="true"></canvas>

    <div class="hud">
      <p class="tip" id="tip">Drag anywhere to fling a new body. Longer drag, faster throw.</p>
    </div>

    <button type="button" class="mission-readout" id="missionBtn" aria-haspopup="dialog">
      <span id="missionTitle">Your first orbit</span>
      <small id="missionDetail">Launch a body to begin · Open flight log</small>
    </button>

    <dialog id="flightLog" class="scene-dialog" aria-labelledby="logTitle">
      <p class="flight-kicker">PERSONAL FLIGHT LOG</p>
      <h2 id="logTitle">Every orbit starts with a leap.</h2>
      <p id="logSummary"></p>
      <ul id="logEntries" class="log-entries"></ul>
      <p>Achievements belong to this browser. Scene links share the simulation, not these results.</p>
      <div class="flight-actions">
        <button type="button" id="downloadLog">Download flight log</button>
        <button type="button" id="closeLog">Back to the sky</button>
      </div>
    </dialog>

    <section class="flight-card" id="flightCard" aria-labelledby="flightTitle">
      <p class="flight-kicker">FLIGHT SCHOOL · 01</p>
      <h2 id="flightTitle">Give a moon<br />a way around.</h2>
      <p id="flightBrief">An orbit is a fall that keeps missing. Start beside the star and launch sideways.</p>
      <div class="flight-actions">
        <button type="button" id="learnBtn">Try a launch <span aria-hidden="true">↗</span></button>
        <button type="button" id="demoBtn">Watch an example</button>
      </div>
      <button type="button" id="dismissLesson">Explore freely</button>
    </section>

    <dialog id="sceneDialog" class="scene-dialog" aria-labelledby="sceneTitle">
      <h2 id="sceneTitle">Send a little universe.</h2>
      <p>This link opens this exact scene, paused. Your personal challenge progress stays here.</p>
      <label for="sceneLink">Scene link</label>
      <input id="sceneLink" type="text" readonly />
      <p id="sceneCopyStatus" role="status"></p>
      <div class="flight-actions">
        <button type="button" id="copyScene">Copy link</button>
        <button type="button" id="closeScene">Done</button>
      </div>
    </dialog>

    <div class="goalwrap" id="goalPanel" hidden>
      <div class="goalhead">
        <h2>Challenges</h2>
        <button type="button" id="goalClose">Close</button>
      </div>
      <ul class="goals" id="goalList">
        {GOALS.map((g) => (
          <li class="goal" data-goal={g.id}>
            <span class="mark" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none"
                   stroke="currentColor" stroke-width="2.4"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 8.5 L6.5 12 L13 4" />
              </svg>
            </span>
            <b>{g.name}<span class="sr-only">, not yet done</span></b>
            <span class="brief">{g.brief}</span>
            <span class="note">{g.note}</span>
          </li>
        ))}
      </ul>
      <p class="goalnote">
        Progress is kept in this browser only.
        <span id="bestLaps"></span>
        <button type="button" id="goalReset">Start over</button>
      </p>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <aside class="dock">
      <div class="group" role="radiogroup" aria-label="What to launch">
        <button type="button" class="opt" data-mass="6" aria-checked="true" role="radio">Moon</button>
        <button type="button" class="opt" data-mass="30" aria-checked="false" role="radio">Planet</button>
        <button type="button" class="opt" data-mass="260" aria-checked="false" role="radio">Star</button>
      </div>
      <div class="group">
        <button type="button" class="opt" id="presetSolar">Solar system</button>
        <button type="button" class="opt" id="presetBinary">Binary</button>
        <button type="button" class="opt" id="presetChaos">Chaos</button>
      </div>
      <div class="group">
        <button type="button" class="opt" id="trailsBtn" aria-pressed="true">Trails</button>
        <button type="button" class="opt" id="pauseBtn" aria-pressed="false">Freeze</button>
        <button type="button" class="opt" id="clearBtn">Clear</button>
      </div>
      <div class="group" aria-label="Scene controls">
        <button type="button" class="opt" id="saveScene">Save scene</button>
        <button type="button" class="opt" id="loadScene">Load scene</button>
        <button type="button" class="opt" id="shareScene">Share scene</button>
        <button type="button" class="opt" id="helpBtn">Learn</button>
        <button type="button" class="opt" id="keyboardBtn">Keyboard</button>
      </div>
      <div class="group">
        <button type="button" class="opt wide" id="goalBtn" aria-expanded="false">
          Challenges <b id="goalCount">0/{GOALS.length}</b>
        </button>
      </div>
    </aside>
  </div>

  <Fragment slot="howto">
    <p>
      A gravity sandbox: every body pulls on every other with real Newtonian
      gravity, and bodies that touch merge, keeping their momentum.
    </p>
    <ul>
      <li>Drag across the sky to launch a body. The drag is the throw: longer is faster, and the line shows where it goes.</li>
      <li>Pick Moon, Planet or Star for what you launch. The presets set up a solar system, a binary pair, or ninety bodies of chaos.</li>
      <li>Learn walks you through a first orbit. Keyboard (or K on the sky) aims a launch with the arrow keys.</li>
      <li>Freeze holds the sky without hiding it. Share scene makes a link to exactly what is on screen.</li>
    </ul>
    <p>Nine challenges, from a first orbit to the last one standing. Only bodies you launch yourself count. Earn all nine to finish.</p>
  </Fragment>
</GameShell>

<script>
  import { sfx, unlock, tone } from '../lib/audio'

  import { SCENE_KEY, captureScene, readScene, sceneBodies, encodeScene, decodeScene, fitScene, type Scene } from '../lib/orbit-scene'
  import { adjustAim } from '../lib/orbit-input'
  import { FixedClock } from '../lib/fixed-clock'
  import { createRenderer } from '../lib/orbit-render'
  import { launchFrame, predict, type Path } from '../lib/orbit-predict'
  import * as presets from '../lib/orbit-presets'
  import {
    type Body, type StepEvents, type Merge,
    makeBody, step, circularV, radiusFor, MAX_BODIES,
  } from '../lib/orbit-sim'
  import { GOALS, Tracker, type Progress } from '../lib/orbit-goals'
  import { createShell } from '../lib/game-shell'

  // Restart is a fresh solar system, running.
  const shell = createShell({ slug: 'orbit', onRestart: () => { solar(); setPaused(false) } })

  const canvas = document.getElementById('sky') as HTMLCanvasElement
  const aimCanvas = document.getElementById('aimLayer') as HTMLCanvasElement
  const aimCtx = aimCanvas.getContext('2d')!
  const stage = document.getElementById('stage') as HTMLElement
  const renderer = createRenderer(canvas)

  let bodies: Body[] = []
  let W = 0, H = 0, dpr = 1, viewScale = 1
  let guide = false
  let paused = false
  let trails = true
  let merges = 0
  let launchMass = 6

  const heaviestMass = () => bodies.reduce((m, b) => Math.max(m, b.m), 0)

  function add(x: number, y: number, vx: number, vy: number, m: number, mine = false) {
    if (bodies.length >= MAX_BODIES) return
    bodies.push(makeBody(x, y, vx, vy, m, mine))
  }

  function resize() {
    const r = stage.getBoundingClientRect()
    if (r.width < 8) return false
    if (!W) { W = r.width; H = r.height }
    const fit = fitScene(W, H, r.width, r.height)
    viewScale = fit.scale
    // Allocate pixels for the displayed view, even for a large imported world.
    dpr = Math.min(devicePixelRatio || 1, 2) * viewScale
    for (const layer of [canvas, aimCanvas]) {
      layer.style.width = `${W * viewScale}px`; layer.style.height = `${H * viewScale}px`
      layer.style.left = `${fit.left}px`; layer.style.top = `${fit.top}px`
    }
    renderer.resize(W, H, dpr)
    aimCanvas.width = Math.round(W * dpr)
    aimCanvas.height = Math.round(H * dpr)
    aimCtx.setTransform(dpr, 0, 0, dpr, 0, 0)
    return true
  }

  // ---- challenges ---------------------------------------------------------
  const SAVE = 'orbit.progress.v1'
  const tracker = new Tracker()
  try {
    const raw = localStorage.getItem(SAVE)
    if (raw) tracker.load(JSON.parse(raw) as Progress)
  } catch { /* private mode, or a cleared profile. Start fresh. */ }

  const goalPanel = document.getElementById('goalPanel') as HTMLElement
  const goalBtn = document.getElementById('goalBtn') as HTMLButtonElement
  const goalCount = document.getElementById('goalCount')!
  const bestLaps = document.getElementById('bestLaps')!
  const toast = document.getElementById('toast')!

  const flightLog = document.getElementById('flightLog') as HTMLDialogElement
  let resumeAfterLog = false
  function missionReadout() {
    const complete = tracker.done.size === GOALS.length
    const laps = tracker.liveLaps()
    document.getElementById('missionTitle')!.textContent = complete
      ? `All ${GOALS.length} discoveries. Your universe.`
      : tracker.done.has('orbit') ? `${tracker.done.size} of ${GOALS.length} discoveries` : 'Mission 01 · Your first orbit'
    document.getElementById('missionDetail')!.textContent = !tracker.done.has('orbit')
      ? `${laps > 0 ? `${Math.min(100, Math.floor(laps * 100))}% around the star` : 'Launch your own body to begin'} · Flight log ↗`
      : `Longest orbit: ${tracker.bestLaps} laps · Flight log ↗`
  }
  function logText() {
    return ['ORBIT — PERSONAL FLIGHT LOG', `${tracker.done.size} / ${GOALS.length} discoveries`,
      `Longest orbit: ${tracker.bestLaps} laps`, '',
      ...GOALS.filter(g => tracker.done.has(g.id)).map(g => `${g.name}\n${g.note}\n`),
      'Recorded in this browser. Scene links do not transfer achievements.'].join('\n')
  }
  document.getElementById('missionBtn')!.addEventListener('click', () => {
    resumeAfterLog = !paused; setPaused(true)
    document.getElementById('logSummary')!.textContent = tracker.done.size
      ? `${tracker.done.size} discoveries earned. Longest orbit: ${tracker.bestLaps} laps.`
      : 'Your log is waiting for its first discovery. Use Learn to set up a star, then launch your own moon sideways.'
    document.getElementById('logEntries')!.replaceChildren(...GOALS.filter(g => tracker.done.has(g.id)).map(g => {
      const li = document.createElement('li')
      const title = document.createElement('strong'); title.textContent = g.name
      const note = document.createElement('p'); note.textContent = g.note
      li.append(title, note); return li
    }))
    flightLog.showModal()
  })
  document.getElementById('closeLog')!.addEventListener('click', () => flightLog.close())
  flightLog.addEventListener('close', () => { if (resumeAfterLog) setPaused(false) })
  document.getElementById('downloadLog')!.addEventListener('click', () => {
    const url = URL.createObjectURL(new Blob([logText()], { type: 'text/plain;charset=utf-8' }))
    const a = document.createElement('a'); a.href = url; a.download = 'orbit-flight-log.txt'
    a.click(); window.setTimeout(() => URL.revokeObjectURL(url), 1000)
  })

  function paintGoals() {
    for (const g of GOALS) {
      const li = goalPanel.querySelector<HTMLElement>(`[data-goal="${g.id}"]`)
      if (!li) continue
      const done = tracker.done.has(g.id)
      li.classList.toggle('done', done)
      // The tick is decorative, so the state has to be in the text as well.
      const hidden = li.querySelector('b .sr-only')
      if (hidden) hidden.textContent = done ? ', done' : ', not yet done'
    }
    goalCount.textContent = `${tracker.done.size}/${GOALS.length}`
    shell.setLevel(`${tracker.done.size} / ${GOALS.length}`)
    shell.progress(tracker.done.size)
    if (tracker.bestLaps > 0) shell.considerBest(tracker.bestLaps, lapsText(tracker.bestLaps))
    missionReadout()
    bestLaps.textContent = tracker.bestLaps
      ? ` Longest orbit so far: ${tracker.bestLaps} lap${tracker.bestLaps === 1 ? '' : 's'}.`
      : ''
  }

  const lapsText = (n: number) => `${n} lap${n === 1 ? '' : 's'}`

  function save() {
    try { localStorage.setItem(SAVE, JSON.stringify(tracker.progress())) } catch { /* fine */ }
  }

  let toastTimer = 0
  function celebrate(ids: string[]) {
    save()
    for (const id of ids) shell.pick('Challenge completed', GOALS.find((x) => x.id === id)?.name ?? id)
    paintGoals()
    // One lap can settle two or three of these at once — a near-circular first
    // orbit is First orbit and Round trip together — so name all of them
    // rather than the first and a silence.
    const names = ids
      .map((id) => GOALS.find((x) => x.id === id)?.name)
      .filter(Boolean) as string[]
    if (!names.length) return
    const said = names.length > 1
      ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`
      : names[0]
    toast.textContent = `${said} — ${tracker.done.size} of ${GOALS.length}`
    toast.classList.add('show')
    clearTimeout(toastTimer)
    toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3600)
    goalBtn.classList.remove('picked')
    void goalBtn.offsetWidth
    goalBtn.classList.add('picked')
    unlock()
    if (tracker.done.size === GOALS.length) {
      // The card waits under the sky; the sky is still worth watching.
      shell.win({
        scroll: false,
        kicker: `All ${GOALS.length} challenges`,
        title: 'Every orbit, earned.',
        score: `${GOALS.length} / ${GOALS.length}`,
        lines: [
          `Longest orbit: ${lapsText(tracker.bestLaps)}. The last one was ${names[names.length - 1]}.`,
          'The sky is still running up there. Launch whatever you like.',
        ],
        againLabel: 'A fresh solar system',
      })
    } else {
      sfx.great()
      shell.levelUp(names.length > 1 ? `${names.length} at once` : names[0])
    }
  }

  const showGoals = (open: boolean) => {
    goalPanel.hidden = !open
    goalBtn.setAttribute('aria-expanded', String(open))
    // The panel is only 97% opaque, which is enough to feel the simulation
    // still running behind it and not enough to stop the body count reading
    // straight through the heading.
    stage.classList.toggle('reading', open)
    if (open) document.getElementById('goalClose')!.focus()
    else goalBtn.focus()
  }
  goalBtn.addEventListener('click', () => { unlock(); sfx.click(); showGoals(goalPanel.hidden) })
  document.getElementById('goalClose')!.addEventListener('click', () => { sfx.click(); showGoals(false) })
  document.getElementById('goalReset')!.addEventListener('click', () => {
    tracker.done.clear()
    tracker.bestLaps = 0
    tracker.reset()
    save()
    paintGoals()
    sfx.click()
  })
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !goalPanel.hidden) showGoals(false) })

  // ---- the launch: its frame, and where it goes ---------------------------
  /** Velocity per pixel of drag. */
  const THROW = 0.055
  /**
   * What the launch is thrown relative to (see lib/orbit-predict.ts), and where
   * on it the drag started. The start rides along with the body while you aim,
   * so a launch beside a moving planet is still beside it when you let go.
   */
  let anchor: { body: Body; ox: number; oy: number; reach: number } | null = null
  let path: Path | null = null

  function anchorAt(x: number, y: number) {
    const f = launchFrame(bodies, x, y)
    anchor = f ? { body: f.body, ox: x - f.body.x, oy: y - f.body.y, reach: f.reach } : null
  }
  /** Move the aim with its body, and fly the launch forward from where it is now. */
  function follow() {
    if (!aim) { path = null; return }
    if (anchor && !bodies.includes(anchor.body)) anchor = null
    if (anchor) {
      const dx = anchor.body.x + anchor.ox - aim.x0, dy = anchor.body.y + anchor.oy - aim.y0
      aim.x0 += dx; aim.y0 += dy; aim.x1 += dx; aim.y1 += dy
    }
    const v = launchVelocity()
    path = predict(bodies, aim.x0, aim.y0, v.vx, v.vy, launchMass, anchor?.body ?? null, 420, W, H)
  }
  function launchVelocity() {
    const a = aim!
    return {
      vx: (anchor?.body.vx ?? 0) + (a.x1 - a.x0) * THROW,
      vy: (anchor?.body.vy ?? 0) + (a.y1 - a.y0) * THROW,
    }
  }

  /** The predicted path: bright where it starts, fading as it goes. */
  function drawPath() {
    if (!path || path.n < 2) return
    const p = path.pts, n = path.n
    // A body that is not the star or near enough at rest gets its sphere of
    // influence drawn, so it is clear what the throw is relative to.
    if (anchor && Math.hypot(anchor.body.vx, anchor.body.vy) > 0.05 && Number.isFinite(anchor.reach) && anchor.reach < Math.max(W, H)) {
      aimCtx.strokeStyle = 'rgba(160, 200, 255, 0.28)'; aimCtx.lineWidth = 1
      aimCtx.setLineDash([2, 6]); aimCtx.beginPath()
      aimCtx.arc(anchor.body.x, anchor.body.y, anchor.reach, 0, Math.PI * 2); aimCtx.stroke()
      aimCtx.setLineDash([])
    }
    // In runs, each a little fainter than the last.
    const RUN = 6
    aimCtx.lineCap = 'round'; aimCtx.lineJoin = 'round'
    for (let i = 0; i < n - 1; i += RUN) {
      const t = i / (n - 1)
      const a = path.closed ? 0.75 - t * 0.45 : 0.75 * (1 - t) ** 1.3
      aimCtx.strokeStyle = `rgba(196, 226, 255, ${a.toFixed(3)})`
      aimCtx.lineWidth = 1.6
      aimCtx.beginPath(); aimCtx.moveTo(p[i * 2], p[i * 2 + 1])
      for (let j = i + 1; j <= Math.min(n - 1, i + RUN); j++) aimCtx.lineTo(p[j * 2], p[j * 2 + 1])
      aimCtx.stroke()
    }
    if (path.hit) {
      const { x, y } = path.hit, s = 5
      aimCtx.strokeStyle = 'rgba(255, 255, 255, 0.85)'; aimCtx.lineWidth = 1.5
      aimCtx.beginPath()
      aimCtx.moveTo(x - s, y - s); aimCtx.lineTo(x + s, y + s)
      aimCtx.moveTo(x + s, y - s); aimCtx.lineTo(x - s, y + s)
      aimCtx.stroke()
    }
  }

  // ---- render ------------------------------------------------------------
  function render() {
    renderer.draw(bodies, aim, trails, radiusFor(launchMass))

    aimCtx.clearRect(0, 0, W, H)
    if (guide && !aim) {
      const r = lessonRadius()
      aimCtx.strokeStyle = '#b5d6ff'; aimCtx.lineWidth = 1.5
      aimCtx.setLineDash([5, 8]); aimCtx.beginPath()
      aimCtx.arc(W / 2, H / 2, r, 0, Math.PI * 2); aimCtx.stroke(); aimCtx.setLineDash([])
      aimCtx.fillStyle = '#e4efff'; aimCtx.beginPath()
      aimCtx.arc(W / 2 + r, H / 2, 7, 0, Math.PI * 2); aimCtx.fill()
      aimCtx.font = '14px sans-serif'; aimCtx.textAlign = 'center'
      aimCtx.fillText('Start here · drag downward', W / 2, H / 2 - r - 18)
      const length = circularV(1200, r) / THROW
      aimCtx.strokeStyle = '#e4efff'; aimCtx.beginPath()
      aimCtx.moveTo(W / 2 + r, H / 2 + 12); aimCtx.lineTo(W / 2 + r, H / 2 + length)
      aimCtx.lineTo(W / 2 + r - 5, H / 2 + length - 8)
      aimCtx.moveTo(W / 2 + r, H / 2 + length); aimCtx.lineTo(W / 2 + r + 5, H / 2 + length - 8)
      aimCtx.stroke()
    }
    if (aim) {
      drawPath()
      aimCtx.strokeStyle = 'rgba(255,255,255,0.5)'
      aimCtx.lineWidth = 1.5
      aimCtx.setLineDash([4, 5])
      aimCtx.beginPath(); aimCtx.moveTo(aim.x0, aim.y0); aimCtx.lineTo(aim.x1, aim.y1); aimCtx.stroke()
      aimCtx.setLineDash([])
      aimCtx.fillStyle = 'rgba(255,255,255,0.85)'
      aimCtx.beginPath(); aimCtx.arc(aim.x0, aim.y0, radiusFor(launchMass), 0, Math.PI * 2); aimCtx.fill()
    }
  }

  let mergeSoundBudget = 0
  /** A collision: drawn in the scene itself — hot debris, a flash, and heat
   *  left glowing in whatever survived — not confetti over the top of it. */
  function onMerge(e: Merge) {
    const s = bodies.find((b) => b.id === e.survivor)
    renderer.impact({
      cx: e.cx, cy: e.cy, x: e.x, y: e.y, vx: s?.vx ?? 0, vy: s?.vy ?? 0,
      total: e.total, star: e.star, m: e.m, speed: e.speed, survivor: e.survivor, absorbed: e.absorbed,
    })
    // Cap sound so a hundred simultaneous merges do not machine-gun.
    if (mergeSoundBudget > 0) {
      mergeSoundBudget--
      tone({ freq: 220 + Math.random() * 160, to: 90, dur: 0.22, type: 'sine', gain: 0.16 })
    }
  }

  // ---- loop --------------------------------------------------------------
  let fpsFrames = 0, lastFps = performance.now()
  let savedBestLaps = tracker.bestLaps

  const clock = new FixedClock()
  document.addEventListener('visibilitychange', () => clock.reset())

  function frame(now = performance.now()) {
    mergeSoundBudget = 2
    if (!paused && !shell.paused && W && !document.hidden) {
      clock.advance(now, () => {
        // Two half-steps per 60 Hz simulation tick preserve the tuned physics.
        const ev: StepEvents = { merges: [], escaped: [] }
        for (let s = 0; s < 2; s++) {
          const r = step(bodies, 0.5, W, H)
          bodies = r.bodies
          ev.merges.push(...r.events.merges)
          ev.escaped.push(...r.events.escaped)
        }
        renderer.record(bodies)
        for (const m of ev.merges) { merges++; onMerge(m) }

        const won = tracker.observe(bodies, ev)
        if (won.length) celebrate(won)
      })
    } else clock.reset()
    if (W) { follow(); render() }

    fpsFrames++
    if (now - lastFps > 500) {
      shell.setScore(String(bodies.length))
      shell.setMoves(String(merges))
      missionReadout()
      if (tracker.bestLaps !== savedBestLaps) {
        save(); savedBestLaps = tracker.bestLaps
        shell.considerBest(tracker.bestLaps, lapsText(tracker.bestLaps))
      }
      lastFps = now; fpsFrames = 0
    }
    requestAnimationFrame(frame)
  }

  // ---- input -------------------------------------------------------------
  let keyboardAim = false
  let aim: { x0: number; y0: number; x1: number; y1: number } | null = null
  const tip = document.getElementById('tip')!

  let lastPointer = { x: 0, y: 0 }
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect()
    return { x: (e.clientX - r.left) / viewScale, y: (e.clientY - r.top) / viewScale }
  }

  canvas.addEventListener('pointerdown', (e) => {
    keyboardAim = false
    unlock()
    const p = local(e)
    aim = { x0: p.x, y0: p.y, x1: p.x, y1: p.y }
    lastPointer = p
    anchorAt(p.x, p.y)
    try { canvas.setPointerCapture(e.pointerId) } catch {}
    tip.classList.add('faded')
    e.preventDefault()
  })
  canvas.addEventListener('pointermove', (e) => {
    if (!aim || keyboardAim) return
    const p = local(e)
    aim.x1 += p.x - lastPointer.x; aim.y1 += p.y - lastPointer.y
    lastPointer = p
  })
  let launches = 0
  function release() {
    if (!aim) return
    follow()
    // Velocity follows the drag direction shown by the aiming line, on top of
    // the motion of whatever it was launched beside.
    const { vx, vy } = launchVelocity()
    add(aim.x0, aim.y0, vx, vy, launchMass, true)
    // How far people get, at a few milestones rather than every throw.
    if ([1, 5, 10, 25, 50, 100].includes(++launches)) shell.pick('Bodies launched', launches)
    guide = false
    flightCard.hidden = true
    const speed = Math.hypot(aim.x1 - aim.x0, aim.y1 - aim.y0) * THROW
    sfx.pop(Math.min(9, Math.round(speed * 2)))
    renderer.launch(aim.x0, aim.y0)
    aim = null; anchor = null; path = null
  }
  canvas.addEventListener('pointerup', () => { if (!keyboardAim) release() })
  canvas.addEventListener('pointercancel', () => { if (!keyboardAim) { aim = null; anchor = null } })

  const keyboardStatus = document.getElementById('keyboardStatus')!
  function startKeyboardAim() {
    if (!W) return
    keyboardAim = true; flightCard.hidden = true
    const x = Math.min(W - 12, W / 2 + lessonRadius()), y = H / 2
    aim = { x0: x, y0: y, x1: x, y1: y }
    anchorAt(x, y)
    canvas.focus()
    tip.classList.remove('faded')
    tip.textContent = 'Arrows: position · Shift + arrows: velocity · Enter: launch · Esc: cancel'
    keyboardStatus.textContent = 'Launch ready. Use arrows to position, Shift and arrows to set velocity, then Enter to launch.'
  }
  document.getElementById('keyboardBtn')!.addEventListener('click', startKeyboardAim)
  canvas.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() === 'k') { event.preventDefault(); startKeyboardAim(); return }
    if (!keyboardAim || !aim) return
    if (event.key === 'Escape') {
      event.preventDefault(); aim = null; anchor = null; keyboardAim = false
      keyboardStatus.textContent = 'Launch cancelled.'; return
    }
    if (event.key === 'Enter') {
      event.preventDefault(); unlock(); release(); keyboardAim = false
      keyboardStatus.textContent = 'Body launched.'; return
    }
    const directions: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }
    const direction = directions[event.key]
    if (!direction) return
    event.preventDefault()
    aim = adjustAim(aim, direction, event.shiftKey, W, H)
    // Moving the start can move it into or out of a body's reach.
    if (!event.shiftKey) anchorAt(aim.x0, aim.y0)
    keyboardStatus.textContent = `Start ${Math.round(100 * aim.x0 / W)} percent across, ${Math.round(100 * aim.y0 / H)} percent down. Horizontal velocity ${((aim.x1 - aim.x0) * THROW).toFixed(1)}, vertical velocity ${((aim.y1 - aim.y0) * THROW).toFixed(1)}${anchor && anchor.body.m < heaviestMass() ? ', relative to the body beside it' : ''}.`
  })

  document.querySelectorAll<HTMLButtonElement>('.opt[data-mass]').forEach((b) => {
    b.addEventListener('click', () => {
      launchMass = Number(b.dataset.mass)
      document.querySelectorAll('.opt[data-mass]').forEach((o) =>
        o.setAttribute('aria-checked', String(o === b)))
      b.classList.remove('picked')
      void b.offsetWidth
      b.classList.add('picked')
      unlock(); sfx.blip(Number(b.dataset.mass) > 100 ? 4 : 1)
      shell.pick('Launch size picked', b.textContent!.trim())
    })
  })

  // ---- presets -----------------------------------------------------------
  function clear() {
    bodies = []; merges = 0; guide = false; aim = null; anchor = null; path = null; keyboardAim = false
    clock.reset(); tracker.reset(); renderer.clear()
    tip.classList.remove('faded')
    tip.textContent = 'Drag across the sky to launch a body. Longer drag, faster throw.'
  }

  // The systems themselves are built in lib/orbit-presets.ts, where the
  // checker can prove each one holds together at every screen size.
  function solar() { clear(); bodies = presets.solar(W, H); sfx.great() }
  function binary() { clear(); bodies = presets.binary(W, H); sfx.great() }
  function chaos() { clear(); bodies = presets.chaos(W, H); sfx.whoosh() }

  document.getElementById('presetSolar')!.addEventListener('click', () => { unlock(); solar(); shell.pick('Scene started', 'Solar system') })
  document.getElementById('presetBinary')!.addEventListener('click', () => { unlock(); binary(); shell.pick('Scene started', 'Binary') })
  document.getElementById('presetChaos')!.addEventListener('click', () => { unlock(); chaos(); shell.pick('Scene started', 'Chaos') })
  document.getElementById('clearBtn')!.addEventListener('click', () => { unlock(); sfx.click(); clear() })
  document.getElementById('pauseBtn')!.addEventListener('click', () => {
    setPaused(!paused)
    unlock(); sfx.click()
  })
  document.getElementById('trailsBtn')!.addEventListener('click', (e) => {
    trails = !trails
    ;(e.currentTarget as HTMLButtonElement).setAttribute('aria-pressed', String(trails))
    unlock(); sfx.click()
  })

  // ---- flight school and scene snapshots ---------------------------------
  const flightCard = document.getElementById('flightCard')!
  const sceneDialog = document.getElementById('sceneDialog') as HTMLDialogElement
  const sceneLink = document.getElementById('sceneLink') as HTMLInputElement
  const copyStatus = document.getElementById('sceneCopyStatus')!
  function message(text: string) {
    toast.textContent = text; toast.classList.add('show')
    clearTimeout(toastTimer)
    toastTimer = window.setTimeout(() => toast.classList.remove('show'), 4200)
  }
  function setPaused(value: boolean) {
    paused = value; clock.reset()
    const b = document.getElementById('pauseBtn')!
    b.textContent = paused ? 'Resume' : 'Freeze'
    b.setAttribute('aria-pressed', String(paused))
  }
  const lessonRadius = () => Math.min(150, Math.min(W, H) * .24)
  function lesson(example: boolean) {
    if (!W) return
    clear(); setPaused(false); flightCard.hidden = true
    launchMass = 6
    document.querySelectorAll<HTMLButtonElement>('.opt[data-mass]').forEach((b) => b.setAttribute('aria-checked', String(Number(b.dataset.mass) === 6)))
    add(W / 2, H / 2, 0, 0, 1200)
    const r = lessonRadius()
    guide = !example
    if (example) {
      add(W / 2 + r, H / 2, 0, circularV(1200, r), 6)
      message('Watch the sideways motion turn into a fall around the star. Try your own with Learn.')
    } else {
      tip.classList.remove('faded')
      tip.textContent = 'Start on the bright dot. Drag downward a little, then release. Learn lets you retry.'
    }
  }
  document.getElementById('learnBtn')!.addEventListener('click', () => { lesson(false); shell.pick('Scene started', 'Try a launch') })
  document.getElementById('demoBtn')!.addEventListener('click', () => { lesson(true); shell.pick('Scene started', 'Watch an example') })
  document.getElementById('dismissLesson')!.addEventListener('click', () => { flightCard.hidden = true })
  document.getElementById('helpBtn')!.addEventListener('click', () => { flightCard.hidden = !flightCard.hidden })

  function applyScene(scene: Scene, shared = false) {
    clear(); W = scene.w; H = scene.h
    bodies = sceneBodies(scene, shared); trails = scene.trails; launchMass = scene.mass
    resize(); setPaused(true); flightCard.hidden = true
    document.getElementById('trailsBtn')!.setAttribute('aria-pressed', String(trails))
    document.querySelectorAll<HTMLButtonElement>('.opt[data-mass]').forEach((b) =>
      b.setAttribute('aria-checked', String(Number(b.dataset.mass) === launchMass)))
    tip.classList.remove('faded'); tip.textContent = 'Scene ready. Press Resume when you are ready to explore.'
    render()
  }
  document.getElementById('saveScene')!.addEventListener('click', () => {
    if (!W) return
    try {
      localStorage.setItem(SCENE_KEY, JSON.stringify(captureScene(bodies, W, H, trails, launchMass)))
      message('Scene saved on this device. Save scene replaces this snapshot.')
    } catch { message('This device could not save the scene. You can still share a scene link.') }
  })
  document.getElementById('loadScene')!.addEventListener('click', () => {
    try {
      const raw = localStorage.getItem(SCENE_KEY)
      if (!raw) { message('No saved scene yet. Save one you would like to revisit.'); return }
      const scene = readScene(JSON.parse(raw))
      if (!scene) { message('That saved scene could not be read. Your current scene is unchanged.'); return }
      applyScene(scene); message('Saved scene loaded, frozen. Completed challenges are kept; partial laps start fresh.')
    } catch { message('The saved scene could not be opened. Your current scene is unchanged.') }
  })
  document.getElementById('shareScene')!.addEventListener('click', () => {
    unlock(); sfx.click()
    if (!W) return
    const code = encodeScene(captureScene(bodies, W, H, trails, launchMass))
    if (!code) { message('This scene is too large for a link. Try sharing a smaller system.'); return }
    const url = new URL(location.href); url.hash = `scene=${code}`
    sceneLink.value = url.href; copyStatus.textContent = ''
    sceneDialog.showModal()
  })
  document.getElementById('closeScene')!.addEventListener('click', () => sceneDialog.close())
  document.getElementById('copyScene')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(sceneLink.value); copyStatus.textContent = 'Copied. Your scene is ready to send.' }
    catch { sceneLink.focus(); sceneLink.select(); copyStatus.textContent = 'Select and copy the link above.' }
  })
  function initialize() {
    if (!resize()) return false
    const code = new URLSearchParams(location.hash.slice(1)).get('scene')
    if (code !== null) {
      const scene = decodeScene(code)
      if (scene) { applyScene(scene, true); message('Shared scene loaded, frozen. Launch your own bodies to earn challenges.'); return true }
      solar(); message('This scene link could not be opened. Here is a fresh solar system.'); return true
    }
    solar()
    return true
  }
  paintGoals()
  if (!initialize() && 'ResizeObserver' in window) {
    const ro = new ResizeObserver(() => { if (initialize()) ro.disconnect() })
    ro.observe(stage)
  }
  const dock = document.querySelector('.dock') as HTMLElement
  function dockEdges() {
    dock.classList.toggle('more-left', dock.scrollLeft > 2)
    dock.classList.toggle('more-right', dock.scrollLeft + dock.clientWidth < dock.scrollWidth - 2)
  }
  dock.addEventListener('scroll', dockEdges, { passive: true })
  dockEdges()

  // For headless checks: the live system, and where a body sits on screen.
  if (import.meta.env.DEV) (window as any).__orbit = {
    get bodies() { return bodies }, get path() { return path }, get anchor() { return anchor },
    screen: (b: Body) => { const r = canvas.getBoundingClientRect(); return { x: r.left + b.x * viewScale, y: r.top + b.y * viewScale } },
    add, setPaused,
  }

  let rt = 0
  addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { resize(); dockEdges() }, 200) })
  frame()
</script>

<style is:global>
  .orbit-body .mission-readout { position: absolute; top: 48px; right: 18px; z-index: 4; display: grid; gap: 5px; max-width: calc(100% - 36px); text-align: left; padding: 12px 16px; background: #101b2ee8; color: #e1edff; border: 1px solid #435778; border-radius: 14px; cursor: pointer; }
  .orbit-body .mission-readout span { font-size: 13px; font-weight: 650; }
  .orbit-body .mission-readout small { font-size: 11px; color: #b6c5df; }
  .orbit-body:has(.flight-card:not([hidden])) .mission-readout { display: none; }
  .orbit-body .log-entries { list-style: none; padding: 0; display: grid; gap: 12px; }
  .orbit-body .log-entries li { border-left: 2px solid #8fcdb5; padding: 4px 0 4px 14px; }
  .orbit-body .log-entries strong { color: #b9ebd6; }
  .orbit-body .log-entries p { margin: 5px 0; }
  .orbit-body #flightLog { max-height: 85dvh; overflow-y: auto; }
  /* The sky fills the stage edge to edge, framed at a fixed height rather
     than the whole window. */
  .stage:has(> .orbit-body) { padding: 0; overflow: hidden; background: #05060f; }
  .orbit-body { position: relative; color: #e9edff; height: clamp(500px, 78vh, 860px); }
  @media (max-width: 620px) { .orbit-body { height: clamp(560px, 84vh, 860px); } }
  .orbit-body canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: crosshair; }
  /* The aim layer sits above the scene but must never swallow the pointer —
     every drag is captured by #sky underneath it. */
  .orbit-body #aimLayer { pointer-events: none; z-index: 2; }

  .orbit-body .hud {
    position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
    text-align: center; pointer-events: none; width: max-content; max-width: 92%;
  }
  .orbit-body .tip {
    margin: 0; font-size: 13px; color: #8b98c4;
    transition: opacity 600ms var(--ease);
  }
  .orbit-body .tip.faded { opacity: 0; }
  .orbit-body.reading .hud { opacity: 0; transition: opacity 160ms var(--ease); }

  .orbit-body .flight-card {
    position: absolute; z-index: 5; top: 100px; left: clamp(16px, 5vw, 72px);
    width: min(330px, calc(100% - 32px)); padding: 26px;
    border: 1px solid #354664; border-radius: 20px;
    background: rgba(9, 17, 34, .94); box-shadow: 0 24px 80px #0005;
    color: #d9e5fa;
  }
  .orbit-body .flight-card[hidden] { display: none; }
  .orbit-body:has(.flight-card:not([hidden])) .tip { visibility: hidden; }
  .orbit-body .flight-kicker { margin: 0 0 16px; font-size: 10px; letter-spacing: .2em; color: #8cbbfa; }
  .orbit-body .flight-card h2 { margin: 0 0 14px; font-size: clamp(26px, 3vw, 38px); line-height: 1.08; letter-spacing: -.035em; color: #f1f6ff; }
  .orbit-body .flight-card p:not(.flight-kicker), .orbit-body .scene-dialog p { font-size: 14px; line-height: 1.65; color: #b6c5df; }
  .orbit-body .flight-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .orbit-body .flight-actions button { padding: 11px 14px; border-radius: 10px; border: 1px solid #435778; color: #edf4ff; background: #1c2b44; cursor: pointer; font: inherit; font-size: 13px; }
  .orbit-body .flight-actions button:first-child { background: #cce2ff; color: #0d2240; border-color: #cce2ff; font-weight: 650; }
  .orbit-body #dismissLesson { background: none; color: #b6c5df; border: 0; text-decoration: underline; padding: 14px 0 0; cursor: pointer; }
  .orbit-body .scene-dialog { color: #edf4ff; background: #101b2e; border: 1px solid #435778; border-radius: 20px; padding: 28px; width: min(480px, calc(100vw - 32px)); }
  .orbit-body .scene-dialog::backdrop { background: #020713bd; }
  .orbit-body .scene-dialog h2 { margin-top: 0; font-size: 26px; }
  .orbit-body .scene-dialog label { display: block; margin-bottom: 8px; }
  .orbit-body #sceneLink { width: 100%; padding: 12px; border: 1px solid #526a91; border-radius: 8px; color: #e1edff; background: #070e1c; }
  .orbit-body #sceneCopyStatus { min-height: 24px; }
  @media (max-width: 620px), (max-height: 600px) {
    .orbit-body .flight-card { top: 66px; padding: 20px; max-height: calc(100% - 220px); overflow-y: auto; }
    .orbit-body .flight-card h2 { font-size: 27px; }
  }

  /* One row that scrolls sideways when it does not fit, rather than wrapping.
     Wrapped, the dock was five rows and a quarter of a phone's sky, and it ran
     under the lesson card. */
  .orbit-body .dock {
    position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%);
    display: flex; gap: 8px; flex-wrap: nowrap;
    width: max-content; max-width: 96%; z-index: 6;
    overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none;
    border-radius: 999px;
  }
  .orbit-body .dock::-webkit-scrollbar { display: none; }
  /* A fade at whichever end has more, so a row that scrolls says so. */
  .orbit-body .dock.more-right { mask-image: linear-gradient(90deg, #000 84%, transparent); }
  .orbit-body .dock.more-left { mask-image: linear-gradient(270deg, #000 84%, transparent); }
  .orbit-body .dock.more-left.more-right { mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent); }
  .orbit-body .group {
    display: flex; flex: none; gap: 4px; padding: 4px;
    background: rgba(12, 16, 34, 0.82); border: 1px solid #1e2647; border-radius: 999px;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .orbit-body .opt {
    background: transparent; border: 0; color: #c3cdf0;
    border-radius: 999px; padding: 8px 15px; font-size: 13px; cursor: pointer;
    transition: background 140ms var(--ease), color 140ms var(--ease), transform 180ms var(--ease-bounce);
    white-space: nowrap;
  }
  .orbit-body .opt:hover { background: #1c2447; color: #fff; transform: translateY(-1px) scale(1.05); }
  .orbit-body .opt:active { transform: scale(0.94); }
  .orbit-body .opt[aria-checked='true'],
  .orbit-body .opt[aria-pressed='true'] { background: #2c65d8; color: #fff; }
  .orbit-body .opt.wide b { color: #fff; margin-left: 3px; }
  /* A one-shot bounce when a launch mass is actually picked — see Powder's
     identical .picked pattern for why this needs a toggled class rather
     than an attribute selector. */
  html.play .orbit-body .opt.picked { animation: pop-opt 360ms var(--ease-bounce); }
  @keyframes pop-opt { 40% { transform: scale(1.14); } }

  /* ---- the challenge panel ---------------------------------------------- */
  /* Over the whole field rather than beside it: the list is eight items long
     with a paragraph each, and there is nowhere on a canvas to put that. */
  .orbit-body .goalwrap {
    position: absolute; inset: 0; z-index: 7; display: flex; flex-direction: column;
    background: rgba(5, 6, 15, 0.97); padding: 16px 18px 12px;
  }
  /* An author `display` beats the user-agent [hidden] rule, so it has to be
     said again here or the panel never closes. */
  .orbit-body .goalwrap[hidden] { display: none; }
  .orbit-body .goalhead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .orbit-body .goalhead h2 { font-size: 17px; color: #f0f3ff; }
  .orbit-body .goalhead button {
    background: none; border: 1px solid #2a3358; color: #c3cdf0; border-radius: 7px;
    padding: 5px 12px; font-size: 12px; cursor: pointer;
  }
  .orbit-body .goalhead button:hover { border-color: #5b8cf0; color: #fff; }

  .orbit-body .goals {
    list-style: none; margin: 12px 0 0; padding: 0 4px 0 0; overflow-y: auto; flex: 1;
    display: grid; gap: 7px; align-content: start;
  }
  .orbit-body .goal {
    display: grid; grid-template-columns: 20px 1fr; column-gap: 9px;
    padding: 9px 12px; border-radius: 8px; background: #0d1122;
  }
  .orbit-body .goal .mark {
    grid-row: 1 / span 2; margin-top: 2px; width: 18px; height: 18px; border-radius: 50%;
    border: 1px solid #2a3358; color: transparent;
    display: grid; place-items: center;
  }
  .orbit-body .goal b { font-size: 13.5px; color: #cfd8f8; }
  .orbit-body .goal .brief { font-size: 12.5px; color: #8b98c4; line-height: 1.5; }
  /* The physics is the reward, so it is not there until it is earned. */
  .orbit-body .goal .note { display: none; grid-column: 2; }

  .orbit-body .goal.done { background: #10201a; }
  .orbit-body .goal.done .mark { border-color: #7fd6a0; color: #7fd6a0; }
  .orbit-body .goal.done b { color: #7fd6a0; }
  .orbit-body .goal.done .brief { color: #7f8cb8; }
  .orbit-body .goal.done .note {
    display: block; font-size: 12.5px; color: #a9b6dd; line-height: 1.55; margin-top: 5px;
  }

  .orbit-body .goalnote { font-size: 11.5px; color: #8b98c4; margin: 10px 0 0; line-height: 1.6; }
  .orbit-body .goalnote button {
    background: none; border: 0; color: #8b98c4; text-decoration: underline;
    font-size: 11.5px; cursor: pointer; padding: 0; margin-left: 4px;
  }
  .orbit-body .goalnote button:hover { color: #cfd8f8; }

  .orbit-body .toast {
    position: absolute; left: 50%; top: 16px; transform: translate(-50%, -14px);
    z-index: 8; background: #10201a; border: 1px solid #7fd6a0; color: #cdf3dd;
    padding: 8px 16px; border-radius: 999px; font-size: 13px; pointer-events: none;
    opacity: 0; transition: opacity 240ms var(--ease), transform 240ms var(--ease);
    max-width: 90%; text-align: center;
  }
  .orbit-body .toast.show { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 620px) {
    .orbit-body .dock { gap: 6px; bottom: 10px; }
    /* The tip is two lines here; the readout goes under both. */
    .orbit-body .mission-readout { top: 64px; }
    .orbit-body .group { padding: 3px; gap: 1px; }
    .orbit-body .opt { padding: 7px; min-height: 40px; font-size: 11px; }
  }
</style>
