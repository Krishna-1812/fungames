---
import GameShell from '../layouts/GameShell.astro'

/**
 * The Auction Game — fourteen lots, five rivals, twelve thousand pounds.
 *
 * The engine is src/lib/auction.ts and it runs headless, so the bidding
 * ladder, the buyer's premium, the reserve, the chandelier bids and the
 * winner's curse are all checked by scripts/check-auction.mjs over thousands
 * of simulated sales rather than eyeballed once.
 *
 * In the shell: the Score tile is your funds (the only number that is honest
 * to show mid-sale — what a lot is really worth is the appraisal, and that
 * stays sealed until the ledger), Lot is progress through the fourteen,
 * Moves are bids, and Best is the best finish you have ever had.
 */
---

<GameShell
  slug="auction"
  labels={{ score: 'Funds', best: 'Best finish', level: 'Lot', moves: 'Bids' }}
  initial={{ score: '£12,000', level: '0 / 14', moves: '0' }}
>
  <div class="au">
    <section class="au-rostrum" aria-label="The rostrum">
      <article class="au-lot is-intro" id="card">
        <div class="au-art" id="lotArt" aria-hidden="true"></div>
        <p class="label au-cat" id="cat">Curiosities</p>
        <h2 class="au-title" id="title">The Auction Game</h2>
        <p class="au-blurb" id="blurb">
          Fourteen lots. Five rivals with their own money and their own bad
          habits. The hammer price is not what you pay.
        </p>
        <p class="au-est"><span class="label">Estimate</span><span class="num" id="est">£300 – £500</span></p>
      </article>

      <div class="au-block" id="block" hidden>
        <p class="label" id="priceLbl">Current bid</p>
        <p class="au-price">
          <span class="num" id="price">£180</span>
          <span class="au-holder" id="holder">no bids yet</span>
        </p>
        <p class="au-calls" id="calls" aria-live="polite"></p>
        <p class="au-update" id="bidUpdate" role="status"></p>
        <div class="au-acts">
          <button class="pill pill--hero au-bid" type="button" id="bid">
            <span id="bidAmt">Bid £200</span>
          </button>
          <button class="pill pill--line" type="button" id="letgo"><span>Let it go</span></button>
        </div>
        <p class="au-cost" id="bidCost">costs you £250</p>
        <p class="au-keys"><kbd>B</kbd> bid · <kbd>L</kbd> let it go · <kbd>P</kbd> pause</p>
      </div>

      <div class="au-open" id="openActs">
        <button class="pill pill--hero" type="button" id="start">
          <span id="startLbl">Start the sale</span><span class="arrow" aria-hidden="true">→</span>
        </button>
        <p class="au-keys"><kbd>N</kbd> or <kbd>Enter</kbd> for the next lot</p>
      </div>

      <ol class="au-log" id="log" aria-label="The auctioneer"></ol>
    </section>

    <aside class="au-room" aria-label="The room">
      <p class="label">The room</p>
      <ul id="rivals" role="list"></ul>
      <p class="au-note">Their money runs out too. The two with the worst discipline have the least of it.</p>
    </aside>
  </div>

  <Fragment slot="howto">
    <p>
      Fourteen lots come up one at a time. You start with <b>£12,000</b>. Bid,
      or let a lot go and watch the room fight over it.
    </p>
    <ul>
      <li><b>The hammer price is not what you pay.</b> A 25% buyer's premium goes on top of every lot you win — the button always shows the real cost.</li>
      <li>Each rival values lots by their own taste and bids in their own style. Some snipe at the last second.</li>
      <li>Sometimes the auctioneer takes a bid "off the wall" — from nobody — to reach the reserve. This is legal.</li>
      <li>At the end, what you bought is appraised. Finish <b>up</b> on the appraisal and you have beaten the room.</li>
    </ul>
    <p>Keys: <kbd>B</kbd> bid, <kbd>L</kbd> let it go, <kbd>N</kbd> next lot.</p>
  </Fragment>

  <details class="au-real" slot="after">
    <summary class="label">Which of this is real</summary>
    <p>
      <b>All of it.</b> The buyer's premium is how auction houses actually make
      their money — 25% here, and real houses charge about that on the first
      slice. It is added to the hammer price, so the number you shout is never
      the number you owe.
    </p>
    <p>
      <b>Chandelier bidding</b> is an auctioneer taking bids that do not exist
      — "off the wall", "off the chandelier" — against a real bidder, to lift
      the price to the seller's secret reserve. It is legal in the UK and in
      most US states so long as it stops at the reserve, and this sale tells
      you every time it happens.
    </p>
    <p>
      <b>The winner's curse</b> is not scripted. Every bidder values a lot as
      what it is really worth times their own taste, so the one who wins is
      disproportionately the one who most overrated it.
      <code>scripts/check-auction.mjs</code> measures it emerging from the model.
    </p>
  </details>
</GameShell>

<script>
  import { createShell } from '../lib/game-shell'
  import { roll, PLAY } from '../lib/motion'
  import { sfx, unlock, tone } from '../lib/audio'
  import { dealLots } from '../data/lots'
  import {
    makeRivals, mulberry32, openLot, step, placeBid, commit,
    askingPrice, withPremium, affordableHammer,
  } from '../lib/auction'
  import type { Bidder, LotState, LotOutcome } from '../lib/auction'
  import type { Lot } from '../data/lots'
  import { lotArt } from '../lib/auction-art'
  import { bidderPortrait } from '../lib/auction-bidders'
  import { recordPlay } from '../lib/stats'
  import { dailyFor } from '../data/game-meta'

  const $ = (id: string) => document.getElementById(id)!
  const money = (n: number) => '£' + Math.round(n).toLocaleString('en-GB')
  const signed = (n: number) => (n >= 0 ? '+' : '−') + money(Math.abs(n))

  const START_FUNDS = 12_000
  const BEAT = 950

  const rng = mulberry32((Date.now() ^ (Math.random() * 2 ** 32)) >>> 0)
  const lots: Lot[] = dealLots(rng)
  const rivals: Bidder[] = makeRivals()
  const startingBudgets = new Map(rivals.map((b) => [b.id, b.budget]))
  const you: Bidder = {
    id: 'you', name: 'You', note: '', budget: START_FUNDS,
    taste: {}, style: 'grinder', ignoresPremium: false, won: [],
  }
  const everyone = [...rivals, you]
  const outcomes: LotOutcome[] = []

  let idx = -1
  let state: LotState | null = null
  let timer = 0
  let fast = false
  let bids = 0
  let finished = false

  const shell = createShell({
    slug: 'auction',
    onPause: () => clearTimeout(timer),
    onResume: () => { if (state && !state.over) tick() },
  })

  $('lotArt').innerHTML = lotArt('fox')

  /* ---- the room ---------------------------------------------------- */

  $('rivals').innerHTML = rivals.map((b) =>
    `<li class="au-rival" data-id="${b.id}">
       <div class="au-face" aria-hidden="true">${bidderPortrait(b.id)}</div>
       <div class="au-who"><b>${b.name}</b><span class="au-chip" data-chip="${b.id}"></span></div>
       <p class="au-react" data-reaction="${b.id}">Taking their seat</p>
       <div class="au-purse" aria-hidden="true"><i data-purse="${b.id}"></i></div>
       <details class="au-habit"><summary>Bidding style</summary><p>${b.note}</p></details>
     </li>`).join('')

  function paintRoom() {
    const ask = state && !state.over ? askingPrice(state) : 0
    for (const b of rivals) {
      const bar = document.querySelector(`[data-purse="${b.id}"]`) as HTMLElement
      const chip = document.querySelector(`[data-chip="${b.id}"]`) as HTMLElement
      const li = document.querySelector(`.au-rival[data-id="${b.id}"]`) as HTMLElement
      bar.style.transform = `scaleX(${Math.max(0, b.budget / startingBudgets.get(b.id)!)})`
      const broke = affordableHammer(b.budget) < ask
      const leading = state?.leader === b.id
      chip.textContent = leading ? (state?.over ? (state.sold ? '✓ Won' : 'Unsold') : '↑ Holding') : broke && ask ? '✗ Out' : money(b.budget)
      li.classList.toggle('is-leading', !!leading)
      li.classList.toggle('is-out', broke && !!ask && !leading)
      const reaction = document.querySelector(`[data-reaction="${b.id}"]`)!
      reaction.textContent = state?.over
        ? state.sold && state.leader === b.id ? 'This lot is theirs' : 'Waiting for the next lot'
        : leading ? 'Paddle raised · leading'
        : broke && ask ? 'Cannot cover the next bid'
        : ask ? (b.style === 'sniper' ? 'Waiting for the hammer' : 'Watching the bidding')
        : 'Ready for the sale'
    }
  }

  /* ---- the log ------------------------------------------------------ */

  const nameOf = (id?: string | null) =>
    id === 'you' ? 'You' : rivals.find((b) => b.id === id)?.name ?? 'the auctioneer'

  function say(text: string, cls = '') {
    const li = document.createElement('li')
    li.className = cls
    li.textContent = text
    $('log').prepend(li)
    while ($('log').children.length > 40) $('log').lastElementChild!.remove()
  }

  /* ---- a lot -------------------------------------------------------- */

  function paintStrip() {
    shell.setScore(money(you.budget))
    shell.setLevel(`${Math.max(0, idx + 1)} / ${lots.length}`)
    shell.setMoves(String(bids))
  }

  function showCard(lot: Lot) {
    $('lotArt').innerHTML = lotArt(lot.id)
    $('cat').textContent = lot.category
    $('title').textContent = lot.title
    $('blurb').textContent = lot.blurb
    $('est').textContent = `${money(lot.low)} – ${money(lot.high)}`
  }

  function nextLot() {
    clearTimeout(timer)
    idx++
    if (idx >= lots.length) return finish()
    const lot = lots[idx]
    $('card').classList.remove('is-intro')
    showCard(lot)
    $('log').innerHTML = ''
    state = openLot(lot, rivals, rng)
    fast = false
    $('block').hidden = false
    $('openActs').hidden = true
    $('calls').textContent = ''
    say(`Lot ${idx + 1}. ${lot.title}. I have ${money(state.current)} to start.`, 'auctioneer')
    shell.levelUp(`Lot ${idx + 1}`)
    paintStrip()
    paintPrice(true)
    paintRoom()
    ;($('bid') as HTMLButtonElement).focus({ preventScroll: true })
    tick()
  }

  let lastPrice = ''
  function paintPrice(first = false) {
    if (!state) return
    const ask = askingPrice(state)
    const opening = state.leader === null && state.events.length === 1
    const update = state.leader === 'you' ? 'You lead. The next move belongs to the room.'
      : state.leader ? `${nameOf(state.leader)} leads. You can bid or let this one go.`
      : opening ? 'The room is open. Your total includes a 25% buyer’s premium.' : 'The auctioneer is bidding toward the reserve.'
    if ($('bidUpdate').textContent !== update) $('bidUpdate').textContent = update
    $('priceLbl').textContent = opening ? 'Opening at' : 'Current bid'
    const p = money(state.current)
    if (p !== lastPrice) {
      if (first || fast || !PLAY) $('price').textContent = p
      else roll($('price'), p, { ms: 520 })
      lastPrice = p
    }
    $('holder').textContent =
      state.leader === 'you' ? '✓ yours' :
      state.leader ? `with ${nameOf(state.leader)}` :
      opening ? 'no bids yet' : 'off the wall'
    $('holder').className = 'au-holder' + (state.leader === 'you' ? ' is-yours' : '')

    const canAfford = ask <= affordableHammer(you.budget)
    const btn = $('bid') as HTMLButtonElement
    btn.disabled = state.leader === 'you' || !canAfford || state.over
    $('bidAmt').textContent = state.leader === 'you' ? 'You hold the bid' : `Bid ${money(ask)}`
    $('bidCost').textContent =
      state.leader === 'you' ? `${money(withPremium(state.current))} with the premium if it lands`
      : !canAfford ? '✗ More than you have'
      : `That bid costs you ${money(withPremium(ask))} with the premium`
  }

  function tick() {
    clearTimeout(timer)
    if (!state || state.over || shell.paused) return
    timer = window.setTimeout(() => {
      const wasYours = state!.leader === 'you'
      const ev = step(state!, rivals, rng)
      if (ev) narrate(ev)
      if (wasYours && state!.leader && state!.leader !== 'you') {
        shell.shake($('block'))
        shell.announce(`Outbid by ${nameOf(state!.leader)}.`)
      }
      paintPrice()
      paintRoom()
      if (state!.over) return endLot()
      tick()
    }, fast ? 90 : BEAT)
  }

  function narrate(ev: ReturnType<typeof step>) {
    if (!ev || !state) return
    switch (ev.kind) {
      case 'bid':
        say(`${nameOf(ev.by)} bids ${money(ev.amount!)}.`)
        if (!fast) sfx.tick()
        break
      case 'jump':
        say(`${nameOf(ev.by)} jumps straight to ${money(ev.amount!)}.`, 'jump')
        if (!fast) sfx.blip(5)
        break
      case 'chandelier':
        say(`The auctioneer takes ${money(ev.amount!)} off the wall.`, 'wall')
        if (!fast) sfx.drip()
        break
      case 'call':
        $('calls').textContent = ev.call === 1 ? 'Going once…' : 'Going twice…'
        say(ev.call === 1 ? 'Going once.' : 'Going twice.', 'auctioneer')
        if (!fast) tone({ freq: ev.call === 1 ? 420 : 340, dur: 0.16, type: 'triangle', gain: 0.14 })
        break
    }
  }

  function endLot() {
    if (!state) return
    $('calls').textContent = ''
    const wasYours = state.sold && state.leader === 'you'
    const out = commit(state, everyone)
    outcomes.push(out)
    if (!out.sold) {
      say('Not sold. It did not reach the reserve.', 'auctioneer')
      sfx.bad()
    } else if (wasYours) {
      say(`✓ Sold to you at ${money(out.hammer)} — ${money(withPremium(out.hammer))} with the premium.`, 'won')
      sfx.great()
      shell.pop($('card'))
    } else {
      say(`Sold to ${nameOf(out.winner)} at ${money(out.hammer)}.`, 'auctioneer')
      sfx.thud()
    }
    paintStrip()
    paintRoom()
    $('block').hidden = true
    $('openActs').hidden = false
    $('startLbl').textContent = idx + 1 >= lots.length ? 'See the ledger' : 'Next lot'
    ;($('start') as HTMLButtonElement).focus({ preventScroll: true })
    state = null
  }

  /* ---- controls ----------------------------------------------------- */

  function bid() {
    if (!state || state.over || shell.paused) return
    unlock()
    const ask = askingPrice(state)
    if (ask > affordableHammer(you.budget) || state.leader === 'you') { shell.shake($('bid')); return }
    if (placeBid(state, 'you', ask)) {
      bids++
      say(`You bid ${money(ask)}.`, 'you')
      sfx.pop(3)
      shell.pop($('price'))
      paintStrip()
      paintPrice()
      paintRoom()
      tick()
    }
  }
  function letGo() {
    if (!state || state.over) return
    fast = true
    sfx.whoosh()
    tick()
  }
  function start() {
    if ((state && !state.over) || finished) return
    unlock()
    sfx.click()
    nextLot()
  }

  $('bid').addEventListener('click', bid)
  $('letgo').addEventListener('click', letGo)
  $('start').addEventListener('click', start)

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || shell.paused) return
    if ((e.target as HTMLElement).closest('input, textarea, select, dialog')) return
    const k = e.key.toLowerCase()
    if (k === 'b' && !$('block').hidden) { e.preventDefault(); bid() }
    else if (k === 'l' && !$('block').hidden) { e.preventDefault(); letGo() }
    else if (k === 'n' && !$('openActs').hidden) { e.preventDefault(); start() }
  })

  /* ---- the ledger --------------------------------------------------- */

  function finish() {
    finished = true
    $('openActs').hidden = true
    const byId = new Map(lots.map((l) => [l.id, l]))
    const mine = outcomes.filter((o) => o.winner === 'you')
    let hammer = 0, worth = 0, cursed = 0, wall = 0
    const rows = mine.map((o) => {
      const lot = byId.get(o.lotId)!
      hammer += o.hammer
      worth += lot.value
      if (o.hammer > lot.value) cursed++
      if (o.chandelier > 0) wall++
      const paid = withPremium(o.hammer)
      const up = paid <= lot.value
      return `<tr><th scope="row">${lot.title}</th><td class="num">${money(o.hammer)}</td><td class="num">${money(paid)}</td>` +
        `<td class="num ${up ? 'up' : 'down'}">${up ? '↑ ' : '↓ '}${money(lot.value)}</td></tr>`
    })
    const paid = START_FUNDS - you.budget
    const net = worth - paid

    const mechs: string[] = []
    if (paid > hammer)
      mechs.push(`<b>The buyer's premium.</b> ${money(paid - hammer)} of what you spent was the house's 25%, on top of every hammer price — ${Math.round(((paid - hammer) / paid) * 100)}% of your total outlay, and you never bid it.`)
    if (cursed)
      mechs.push(`<b>The winner's curse.</b> On ${cursed} of your ${mine.length} lots the hammer alone was more than the thing was worth. You won those precisely because you overrated them.`)
    if (wall)
      mechs.push(`<b>Chandelier bidding.</b> On ${wall} of your lots the auctioneer took a bid off the wall — from nobody — and you bid over it. This is legal.`)
    if (!mechs.length) mechs.push('<b>Nothing got you.</b> You did not buy enough for any of it to matter.')

    const board = everyone
      .map((b) => {
        const theirs = outcomes.filter((o) => o.winner === b.id)
        const w = theirs.reduce((n, o) => n + byId.get(o.lotId)!.value, 0)
        const spent = theirs.reduce((n, o) => n + withPremium(o.hammer), 0)
        return { b, lots: theirs.length, net: w - spent }
      })
      .sort((x, y) => y.net - x.net || y.lots - x.lots)
    const place = board.findIndex((r) => r.b.id === 'you') + 1

    shell.resultExtra.innerHTML =
      `<div class="au-ledger">
        <table class="au-sheet">
          <caption class="label">What you bought</caption>
          <thead><tr><th scope="col">Lot</th><th scope="col">Hammer</th><th scope="col">You paid</th><th scope="col">Worth</th></tr></thead>
          <tbody>${rows.length ? rows.join('') + `<tr class="tot"><th scope="row">Total</th><td class="num">${money(hammer)}</td><td class="num">${money(paid)}</td><td class="num">${money(worth)}</td></tr>`
            : '<tr><td colspan="4">You bought nothing. That is, technically, the winning strategy.</td></tr>'}</tbody>
        </table>
        <p class="label au-sub">How they got you</p>
        <ul class="au-mechs">${mechs.map((m) => `<li>${m}</li>`).join('')}</ul>
        <table class="au-sheet">
          <caption class="label">The room</caption>
          <tbody>${board.map(({ b, lots: n, net: v }) =>
            `<tr class="${b.id === 'you' ? 'me' : ''}"><th scope="row">${b.id === 'you' ? '→ You' : b.name}</th><td class="num">${n} lot${n === 1 ? '' : 's'}</td>` +
            `<td class="num ${v >= 0 ? 'up' : 'down'}">${v >= 0 ? '↑ ' : '↓ '}${signed(v)}</td></tr>`).join('')}</tbody>
        </table>
      </div>`

    recordPlay('auction', { net, bought: mine.length }, { net: 'high' })
    // Stored best must be positive; the offset is an internal detail only.
    const beat = shell.considerBest(net + 1_000_000, mine.length ? signed(net) : '±£0')
    const daily = dailyFor(new Date())
    const need = Number(daily.goal.match(/at least (\d+)/)?.[1] ?? 0)
    const lines = [
      !mine.length
        ? 'Fourteen lots went past and you kept every penny. The room thinks less of you; your accountant does not.'
        : `You spent ${money(paid)} on ${mine.length} lot${mine.length === 1 ? '' : 's'} appraised at ${money(worth)}.`,
      `You finished ${place === 1 ? '1st' : place === 2 ? '2nd' : place === 3 ? '3rd' : place + 'th'} of ${board.length} in the room.`,
    ]
    if (beat === 'beaten') lines.push('✓ That is a new personal best.')
    else if (beat === 'first') lines.push('Your first finish — that is the best to beat now.')
    else if (shell.best) lines.push(`Your best finish is still ${shell.best.text}.`)
    if (daily.slug === 'auction' && need)
      lines.push(mine.length >= need && net >= 0 ? `✓ Daily challenge beaten: ${need}+ lots and up on the appraisal.` : `✗ Daily challenge: win ${need}+ lots and finish up.`)

    const ending = {
      kicker: `Lot ${lots.length} of ${lots.length} · the ledger`,
      score: mine.length ? signed(net) : '£0',
      lines,
    }
    if (mine.length && net >= 0) shell.win({ ...ending, title: 'You beat the room.' })
    else shell.lose({ ...ending, title: mine.length ? 'The room beat you.' : 'Kept every penny.' })
  }

  paintStrip()
  paintRoom()
</script>

<style is:global>
  /* The room, the log and the ledger are built by the script, so their
     styles are global on purpose: scoped styles never reach those nodes. */
  .au { display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, 300px); gap: clamp(16px, 2.4vw, 32px); align-items: start; }
  @media (max-width: 860px) { .au { grid-template-columns: minmax(0, 1fr); } }

  .au-lot { display: grid; gap: 8px; }
  .au-art {
    height: clamp(200px, 28vw, 320px);
    border-radius: var(--r);
    background: var(--ink);
    overflow: hidden;
    margin-bottom: 10px;
  }
  .au-art svg { width: 100%; height: 100%; display: block; }
  .au-lot.is-intro .au-cat, .au-lot.is-intro .au-est { display: none; }
  .au-cat { color: var(--ink3); }
  .au-title { font-size: var(--fs-h3); }
  .au-blurb { color: var(--ink2); max-width: 58ch; }
  .au-est { display: flex; align-items: baseline; gap: 12px; margin-top: 4px; }
  .au-est .label { color: var(--ink3); }
  .au-est .num { font-size: 20px; }

  .au-block, .au-open {
    margin-top: 18px;
    padding: 20px;
    border-radius: var(--r-lg);
    background: var(--mint);
    color: var(--ink);
  }
  .au-open { background: var(--paper2); }
  .au-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-top: 6px; }
  .au-price .num { font-size: clamp(44px, 6vw, 72px); }
  .au-holder { font-weight: 600; }
  .au-holder.is-yours { background: var(--ink); color: var(--ink-paper); padding: 4px 12px; border-radius: var(--r-pill); }
  .au-calls { min-height: 1.3em; margin-top: 6px; font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 600; font-size: 22px; font-style: italic; }
  .au-update { margin-top: 4px; font-size: 15px; font-weight: 500; }
  .au-acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .au-bid { min-width: 210px; }
  .au-cost { margin-top: 10px; font-size: 14px; font-weight: 600; }
  .au-keys { margin-top: 10px; font-size: 13px; color: var(--ink2); }
  .au-block .au-keys { color: var(--ink); }
  .au-keys kbd, .au-real kbd {
    display: inline-block; min-width: 22px; padding: 0 6px; border-radius: 6px;
    border: 1.5px solid currentColor; font: 700 12px/1.5 var(--sans); text-align: center;
  }
  .au-open .au-keys { margin-top: 12px; }

  .au-log { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 2px; max-height: 230px; overflow-y: auto; }
  .au-log li { padding: 8px 12px; border-radius: 10px; background: var(--paper2); font-size: 14px; }
  .au-log li.auctioneer { background: transparent; font-style: italic; color: var(--ink2); padding-left: 2px; }
