---
/**
 * /walk/ — the island on foot, in 3D (lib/walk): built in the browser from
 * the same facts Unity builds the realistic island from, and walked in third
 * person, with the island's own traffic on its roads. Walk up to any game's
 * building and it offers to take you in. Cars of your own stand parked by
 * the road: get in and drive one. The day passes, an hour a minute; the
 * clock lets you pause it or go to any hour, and choose the weather (or let
 * it change by itself). It all sounds as it should (the sea, the wind and
 * the rain, your steps, the traffic, the birds); the speaker turns it off.
 * To find your way: a map in the corner (M for the whole island, and a
 * waypoint to any game), a compass, the district's name as you come into it;
 * and a photo mode (P) to hold everything still and take a picture.
 */
import Base from '../layouts/Base.astro'
import { withBase } from '../lib/base'
---

<Base title="Walk the island" description="Walk round Tiny Island in 3D, or drive it: its streets, its traffic, its harbour and its mountain, and every game's building to walk into.">
  <main class="wk" id="main">
    <canvas class="wk-canvas" id="wk" aria-label="The island in 3D"></canvas>
    <div class="wk-top">
      <a class="wk-btn wk-back" href={withBase('/')} aria-label="Back to the map"><span aria-hidden="true">←</span><span class="wk-long">The map</span></a>
      <span class="wk-right"><button class="wk-btn wk-icon" id="wkPhoto" type="button" aria-pressed="false" aria-label="Photo mode (P)"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6.5h3l1.4-2h5.2l1.4 2h3v9.5H3z"/><circle cx="10" cy="11" r="3.2"/></svg></button> <button class="wk-btn wk-icon" id="wkSound" type="button" aria-pressed="true" aria-label="Sound"><svg viewBox="0 0 20 20" aria-hidden="true"><path class="wk-spk" d="M3 7.5h3l4-3.5v12l-4-3.5H3z"/><path class="wk-waves" d="M13 7a4 4 0 0 1 0 6M15.3 4.8a7 7 0 0 1 0 10.4"/><path class="wk-mute" d="M13 7.5l5 5M18 7.5l-5 5"/></svg></button> <button class="wk-btn wk-icon" id="wkSettings" type="button" aria-expanded="false" aria-controls="wkSet" aria-label="Settings"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h7.5M15.5 6H17M3 14h1.5M9.5 14H17"/><circle cx="13" cy="6" r="2.3"/><circle cx="7" cy="14" r="2.3"/></svg></button> <button class="wk-btn wk-air" id="wkAir" type="button" aria-pressed="false" aria-label="Aerial view"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 13.5 10 6l7.5 7.5M5.5 16.5 10 12l4.5 4.5"/></svg><span class="wk-long">Aerial</span></button> <button class="wk-btn wk-clock" id="wkClock" type="button" aria-expanded="false" aria-controls="wkTime" aria-label="Time of day"><svg class="wk-sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="4"/><path d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.8 1.8M14.2 14.2 16 16M4 16l1.8-1.8M14.2 5.8 16 4"/></svg><svg class="wk-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 12.8A6.5 6.5 0 0 1 7.2 4.5a6.5 6.5 0 1 0 8.3 8.3z"/></svg><span id="wkClockText">16:30</span></button></span>
    </div>
    <div class="wk-time" id="wkTime" hidden>
      <label class="wk-time-label" for="wkHour">Time of day <output id="wkHourOut">16:30</output></label>
      <input id="wkHour" type="range" min="0" max="24" step="0.05" value="16.5" />
      <div class="wk-time-row">
        <button class="wk-chip" id="wkPause" type="button" aria-pressed="false">Pause</button>
        <button class="wk-chip" type="button" data-hour="5.8">Dawn</button>
        <button class="wk-chip" type="button" data-hour="12">Noon</button>
        <button class="wk-chip" type="button" data-hour="18.2">Sunset</button>
        <button class="wk-chip" type="button" data-hour="22">Night</button>
      </div>
      <p class="wk-time-label" id="wkSkyLabel">Weather <output id="wkSkyOut">Changing</output></p>
      <div class="wk-time-row" role="group" aria-labelledby="wkSkyLabel">
        <button class="wk-chip" type="button" data-sky="auto" aria-pressed="true">Changing</button>
        <button class="wk-chip" type="button" data-sky="clear" aria-pressed="false">Clear</button>
        <button class="wk-chip" type="button" data-sky="cloudy" aria-pressed="false">Cloudy</button>
        <button class="wk-chip" type="button" data-sky="rain" aria-pressed="false">Rain</button>
        <button class="wk-chip" type="button" data-sky="storm" aria-pressed="false">Storm</button>
      </div>
    </div>
    <div class="wk-time wk-set" id="wkSet" hidden>
      <p class="wk-time-label" id="wkQLabel">Picture <output id="wkQOut">Auto</output></p>
      <div class="wk-time-row" role="group" aria-labelledby="wkQLabel">
        <button class="wk-chip" type="button" data-q="auto" aria-pressed="true">Auto</button>
        <button class="wk-chip" type="button" data-q="low" aria-pressed="false">Low</button>
        <button class="wk-chip" type="button" data-q="medium" aria-pressed="false">Medium</button>
        <button class="wk-chip" type="button" data-q="high" aria-pressed="false">High</button>
        <button class="wk-chip" type="button" data-q="ultra" aria-pressed="false">Ultra</button>
      </div>
      <p class="wk-set-note" id="wkQNote">Auto picks a level for this device, and steps down if it struggles.</p>
      <p class="wk-time-label" id="wkMLabel">Motion <output id="wkMOut">Full</output></p>
      <div class="wk-time-row" role="group" aria-labelledby="wkMLabel">
        <button class="wk-chip" type="button" data-motion="system" aria-pressed="true">As the device</button>
        <button class="wk-chip" type="button" data-motion="full" aria-pressed="false">Full</button>
        <button class="wk-chip" type="button" data-motion="calm" aria-pressed="false">Calm</button>
      </div>
      <p class="wk-set-note">Calm: the sea lies flat, the trees barely stir, lighter rain, no lightning or flashes.</p>
      <div class="wk-time-row"><button class="wk-chip" type="button" id="wkFps" aria-pressed="false">Show frame rate</button></div>
      <p class="wk-set-note wk-credit">The ground is photographed: CC0 sets from <a href="https://polyhaven.com/" rel="noopener" target="_blank">Poly Haven</a>.</p>
    </div>
    <p class="wk-fps" id="wkFpsOut" hidden aria-hidden="true"></p>
    <p class="wk-help" id="wkHelp">W A S D or the arrow keys to walk · Shift to run · Space to jump · drag to look round · scroll to step back</p>
    <a class="wk-near" id="wkNear" hidden href="/"><span>Play</span> <b id="wkNearTitle"></b> <kbd>E</kbd></a>
    <button class="wk-near wk-drive" id="wkDrive" type="button" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 16.5V12l1.8-4.6A2 2 0 0 1 8.7 6h6.6a2 2 0 0 1 1.9 1.4L19 12v4.5M5 12h14M5 16.5h14M7.5 19v-2.5M16.5 19v-2.5"/><circle cx="8" cy="14.2" r="0.9"/><circle cx="16" cy="14.2" r="0.9"/></svg><span>Drive</span> <kbd>F</kbd></button>
    <div class="wk-dash" id="wkDash" hidden aria-live="off">
      <span class="wk-speed"><b id="wkKmh">0</b><small>km/h</small></span>
      <span class="wk-gear" id="wkGear">N</span>
      <span class="wk-flood" id="wkFlood" hidden>Engine flooded</span>
      <button class="wk-chip wk-out" id="wkOut" type="button">Get out <kbd>F</kbd></button>
    </div>
    <div class="wk-stick" id="wkStick" aria-hidden="true"><i id="wkKnob"></i></div>
    <div class="wk-photo" id="wkPhotoPanel" hidden>
      <div class="wk-photo-row">
        <label class="wk-time-label" for="wkExpo">Exposure <output id="wkExpoOut">0</output></label>
        <input id="wkExpo" type="range" min="-1.5" max="1.5" step="0.1" value="0" />
      </div>
      <div class="wk-time-row" role="group" aria-label="Look">
        <button class="wk-chip" type="button" data-look="natural" aria-pressed="true">Natural</button>
        <button class="wk-chip" type="button" data-look="vivid" aria-pressed="false">Vivid</button>
        <button class="wk-chip" type="button" data-look="golden" aria-pressed="false">Golden</button>
        <button class="wk-chip" type="button" data-look="film" aria-pressed="false">Film</button>
        <button class="wk-chip" type="button" data-look="mono" aria-pressed="false">Mono</button>
        <button class="wk-chip" type="button" id="wkMe" aria-pressed="true">Me in it</button>
      </div>
      <p class="wk-photo-help" id="wkPhotoHelp">Drag to turn · scroll to go nearer · W A S D to move · R F up and down</p>
      <div class="wk-time-row">
        <button class="wk-chip wk-shoot" type="button" id="wkShoot">Take picture</button>
        <button class="wk-chip" type="button" id="wkPhotoOut">Done <kbd>P</kbd></button>
      </div>
    </div>
    <p class="wk-load" id="wkLoad">Building the island…</p>
  </main>
</Base>

<script>
  import type { WorldData } from '../lib/walk/build3d'
  const canvas = document.getElementById('wk') as HTMLCanvasElement
  const near = document.getElementById('wkNear') as HTMLAnchorElement
  const nearTitle = document.getElementById('wkNearTitle')!
  const load = document.getElementById('wkLoad')!
  const clockBtn = document.getElementById('wkClock') as HTMLButtonElement, clockText = document.getElementById('wkClockText')!
  const timePanel = document.getElementById('wkTime')!, hourIn = document.getElementById('wkHour') as HTMLInputElement, hourOut = document.getElementById('wkHourOut')!
  const pauseBtn = document.getElementById('wkPause') as HTMLButtonElement
  const hhmm = (h: number) => { const m = Math.floor((((h % 24) + 24) % 24) * 60); return `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}` }
  const stickEl = document.getElementById('wkStick')!, knob = document.getElementById('wkKnob')!
  const help = document.getElementById('wkHelp')!, driveBtn = document.getElementById('wkDrive') as HTMLButtonElement
  const dash = document.getElementById('wkDash')!, kmh = document.getElementById('wkKmh')!, gear = document.getElementById('wkGear')!, flood = document.getElementById('wkFlood')!, outBtn = document.getElementById('wkOut') as HTMLButtonElement
  const WALK_HELP = help.textContent!, DRIVE_HELP = 'W or ↑ to drive · S or ↓ to brake and reverse · A D or ← → to steer · Space for the handbrake · F to get out'
  let nearGame = false

  // A thumb-stick for a phone: where the thumb is from the stick's middle, as a direction and how far.
  let stick: [number, number] = [0, 0]
  const touch = matchMedia('(pointer: coarse)').matches
  if (touch) stickEl.classList.add('on')
  stickEl.addEventListener('pointerdown', (e) => {
    stickEl.setPointerCapture(e.pointerId)
    const r = stickEl.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2, R = r.width / 2
    const move = (ev: PointerEvent) => {
      let dx = (ev.clientX - cx) / R, dy = (ev.clientY - cy) / R
      const m = Math.hypot(dx, dy); if (m > 1) { dx /= m; dy /= m }
      stick = [dx, dy]; knob.style.transform = `translate(${dx * R * 0.6}px, ${dy * R * 0.6}px)`
    }
    move(e)
    const up = () => { stick = [0, 0]; knob.style.transform = ''; stickEl.removeEventListener('pointermove', move); stickEl.removeEventListener('pointerup', up) }
    stickEl.addEventListener('pointermove', move); stickEl.addEventListener('pointerup', up)
  })

  // The settings, kept on this device: the picture's level (or Auto), motion (as the device asks, full, calm), the frame rate shown.
  const kept = (k: string, d: string) => { try { return localStorage.getItem(k) ?? d } catch { return d } }
  const keep = (k: string, v: string) => { try { localStorage.setItem(k, v) } catch {} }
  const LEVELS = ['auto', 'low', 'medium', 'high', 'ultra'] as const
  type Level = (typeof LEVELS)[number]
  let level = kept('walk-quality', 'auto') as Level
  if (!LEVELS.includes(level)) level = 'auto'
  let motion = kept('walk-motion', 'system')
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')
  const calm = () => motion === 'calm' || (motion === 'system' && reduce.matches)

  Promise.all([fetch('world.json').then((r) => r.json() as Promise<WorldData>), import('../lib/walk/walker'), import('../lib/walk/map')]).then(([data, { startWalk }, { wayfinding }]) => {
    const walk = startWalk(canvas, data, {
      onNear(g) {
        nearGame = !!g
        near.hidden = !g
        if (g) { nearTitle.textContent = g.title; near.href = (g as { href?: string }).href ?? '/' }
      },
      move: () => stick,
      quality: level === 'auto' ? undefined : level,
      still: calm(),
      onCar(c) {
        driveBtn.hidden = !c.near || c.driving
        // (A game's door and a car both near: the car's button sits above the game's.)
        driveBtn.classList.toggle('wk-up', nearGame)
        dash.hidden = !c.driving
        help.textContent = c.driving ? DRIVE_HELP : WALK_HELP
        kmh.textContent = String(c.kmh); gear.textContent = c.gear; flood.hidden = !c.flooded
      },
    })
    driveBtn.addEventListener('click', () => walk.toggleCar())
    outBtn.addEventListener('click', () => walk.toggleCar())
    load.remove()
    ;(window as unknown as { __walk: typeof walk }).__walk = walk
    addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.closest?.('input, textarea')) return
      // F gets you in and out of a car; E takes you into a game (or, with none near, into the car).
      if (e.code === 'KeyF') walk.toggleCar()
      if (e.code === 'KeyE') { const g = walk.near(); if (g) location.href = g.href; else walk.toggleCar() }
      if (e.code === 'KeyN') { const h = walk.time(); walk.setNight(h > 6 && h < 19.5) }
    })
    // Sound: on unless turned off before (it starts at the first key or touch).
    const soundBtn = document.getElementById('wkSound') as HTMLButtonElement
    let soundOn = true
    try { soundOn = localStorage.getItem('walk-sound') !== 'off' } catch {}
    const showSound = () => { soundBtn.setAttribute('aria-pressed', String(soundOn)); soundBtn.setAttribute('aria-label', soundOn ? 'Sound on' : 'Sound off'); walk.setSound(soundOn) }
    showSound()
    soundBtn.addEventListener('click', () => { soundOn = !soundOn; try { localStorage.setItem('walk-sound', soundOn ? 'on' : 'off') } catch {} showSound() })
    // Finding your way: the map in the corner (and the whole island), the compass, the district's name.
    const main = document.getElementById('main')!
    const ways = wayfinding(main, data, walk, { phone: matchMedia('(pointer: coarse)').matches || Math.min(innerWidth, innerHeight) < 600 })
    // Photo mode: everything held still, the camera free; a look, the exposure, you in the picture or not; a picture to keep.
    const photoBtn = document.getElementById('wkPhoto') as HTMLButtonElement, photoPanel = document.getElementById('wkPhotoPanel')!
    const expo = document.getElementById('wkExpo') as HTMLInputElement, expoOut = document.getElementById('wkExpoOut')!, meBtn = document.getElementById('wkMe') as HTMLButtonElement
    const LOOKS: Record<string, { sat?: number; warm?: number; film?: number; vignette?: number; grain?: number }> = {
      natural: {}, vivid: { sat: 1.3, vignette: 0.2 }, golden: { warm: 1, sat: 1.08, vignette: 0.3 }, film: { film: 0.8, sat: 0.86, grain: 0.05, vignette: 0.42 }, mono: { sat: 0, film: 0.35, grain: 0.045, vignette: 0.38 },
    }
    let look = 'natural', photoOn = false
    const lookBtns = [...photoPanel.querySelectorAll<HTMLButtonElement>('[data-look]')]
    const applyLook = () => { walk.photoLook({ ...LOOKS[look], expo: Math.pow(2, +expo.value) }); expo.style.setProperty('--at', ((+expo.value + 1.5) / 3) * 100 + '%'); expoOut.textContent = (+expo.value > 0 ? '+' : '') + (+expo.value).toFixed(1) }
    const setPhoto = (on: boolean) => {
      photoOn = on; walk.setPhoto(on); main.classList.toggle('wk-photo-on', on); photoPanel.hidden = !on; ways.show(!on)
      photoBtn.setAttribute('aria-pressed', String(on))
      if (on) applyLook()
      else { look = 'natural'; expo.value = '0'; for (const b of lookBtns) b.setAttribute('aria-pressed', String(b.dataset.look === 'natural')); meBtn.setAttribute('aria-pressed', 'true') }
    }
    photoBtn.addEventListener('click', () => setPhoto(!photoOn))
    document.getElementById('wkPhotoOut')!.addEventListener('click', () => setPhoto(false))
    expo.addEventListener('input', applyLook)
    for (const b of lookBtns) b.addEventListener('click', () => { look = b.dataset.look!; for (const x of lookBtns) x.setAttribute('aria-pressed', String(x === b)); applyLook() })
    meBtn.addEventListener('click', () => { const on = meBtn.getAttribute('aria-pressed') !== 'true'; meBtn.setAttribute('aria-pressed', String(on)); walk.showMe(on) })
    document.getElementById('wkShoot')!.addEventListener('click', async () => {
      main.classList.add('wk-flash'); setTimeout(() => main.classList.remove('wk-flash'), 220)
      const blob = await walk.snap()
      if (!blob) return
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'tiny-island-' + new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-') + '.png'
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000)
    })
    addEventListener('keydown', (e) => { if (!(e.target as HTMLElement)?.closest?.('input, textarea') && e.code === 'KeyP') setPhoto(!photoOn) })
    const air = document.getElementById('wkAir') as HTMLButtonElement
    const airText = air.querySelector('.wk-long')!
    air.addEventListener('click', () => { const on = air.getAttribute('aria-pressed') !== 'true'; air.setAttribute('aria-pressed', String(on)); airText.textContent = on ? 'On foot' : 'Aerial'; air.setAttribute('aria-label', on ? 'Back on foot' : 'Aerial view'); walk.setAerial(on) })
    if (new URLSearchParams(location.search).has('aerial')) air.click()
    // Settings: the picture's level, motion, the frame rate.
    const setBtn = document.getElementById('wkSettings') as HTMLButtonElement, setPanel = document.getElementById('wkSet')!
    const qOut = document.getElementById('wkQOut')!, mOut = document.getElementById('wkMOut')!, qNote = document.getElementById('wkQNote')!
    const qBtns = [...setPanel.querySelectorAll<HTMLButtonElement>('[data-q]')], mBtns = [...setPanel.querySelectorAll<HTMLButtonElement>('[data-motion]')]
    const fpsBtn = document.getElementById('wkFps') as HTMLButtonElement, fpsOut = document.getElementById('wkFpsOut')!
    const TIER: Record<string, string> = { low: 'Low', medium: 'Medium', high: 'High', ultra: 'Ultra' }
    const NOTES: Record<string, string> = {
      auto: 'Auto picks a level for this device, and steps down if it struggles.',
      low: 'For a phone or an older laptop: softer shadows, less grass, fewer people out.',
      medium: 'For most phones and small laptops.',
      high: 'For a desktop or a good laptop: the full picture.',
      ultra: 'For a strong graphics card: every edge drawn finer, grass to the horizon.',
    }
    const showSettings = () => {
      const p = walk.perf()
      qOut.textContent = level === 'auto' ? `Auto · ${TIER[p.tier]}` : TIER[level]
      for (const b of qBtns) b.setAttribute('aria-pressed', String(b.dataset.q === level))
      qNote.textContent = NOTES[level]
      mOut.textContent = (motion === 'system' ? 'As the device · ' : '') + (calm() ? 'Calm' : 'Full')
      for (const b of mBtns) b.setAttribute('aria-pressed', String(b.dataset.motion === motion))
      main.classList.toggle('wk-still', calm())
    }
    const applyMotion = () => { walk.setMotion(calm()); showSettings() }
    setBtn.addEventListener('click', () => {
      const open = setPanel.hidden; setPanel.hidden = !open; setBtn.setAttribute('aria-expanded', String(open))
      // (One panel at a time up there: the clock's closes.)
      if (open && !timePanel.hidden) { timePanel.hidden = true; clockBtn.setAttribute('aria-expanded', 'false') }
      showSettings()
    })
    for (const b of qBtns) b.addEventListener('click', () => { level = b.dataset.q as Level; keep('walk-quality', level); walk.setQuality(level); showSettings() })
    for (const b of mBtns) b.addEventListener('click', () => { motion = b.dataset.motion!; keep('walk-motion', motion); applyMotion() })
    reduce.addEventListener('change', applyMotion)
    let fpsOn = kept('walk-fps', 'off') === 'on'
    const showFps = () => {
      fpsBtn.setAttribute('aria-pressed', String(fpsOn)); fpsOut.hidden = !fpsOn
      if (fpsOn) { const p = walk.perf(); fpsOut.textContent = `${p.fps ? Math.round(p.fps) : "–"} fps · ${p.cpu.toFixed(1)} ms · ${TIER[p.tier]}${p.sharp < 1 ? ' ' + Math.round(p.sharp * 100) + '%' : ''}` }
    }
    fpsBtn.addEventListener('click', () => { fpsOn = !fpsOn; keep('walk-fps', fpsOn ? 'on' : 'off'); showFps() })
    setInterval(() => { showFps(); if (!setPanel.hidden) showSettings() }, 1000)
    showSettings(); showFps()
    // On a phone, photo mode is moved with the stick and two fingers.
    if (touch) document.getElementById('wkPhotoHelp')!.textContent = 'Drag to turn · pinch to go nearer · the stick to move'
    // The clock: the hour, a sun or a moon; open, a slider for any hour, a pause, and the day's moments.
    let dragging = false
    const show = () => {
      const h = walk.time()
      clockText.textContent = hhmm(h); hourOut.textContent = hhmm(h)
      clockBtn.dataset.night = String(h < 5.6 || h > 18.6)
      if (!dragging) hourIn.value = String(h)
      hourIn.style.setProperty('--at', `${(+hourIn.value / 24) * 100}%`)
    }
    show(); setInterval(show, 250)
    clockBtn.addEventListener('click', () => {
      const open = timePanel.hidden; timePanel.hidden = !open; clockBtn.setAttribute('aria-expanded', String(open))
      if (open && !setPanel.hidden) { setPanel.hidden = true; setBtn.setAttribute('aria-expanded', 'false') }
    })
    hourIn.addEventListener('input', () => { dragging = true; walk.setTime(+hourIn.value); show() })
    hourIn.addEventListener('change', () => { dragging = false })
    pauseBtn.addEventListener('click', () => { const on = walk.clock(); walk.setClock(!on); pauseBtn.setAttribute('aria-pressed', String(on)); pauseBtn.textContent = on ? 'Play' : 'Pause' })
    for (const b of timePanel.querySelectorAll<HTMLButtonElement>('[data-hour]')) b.addEventListener('click', () => { walk.setTime(+b.dataset.hour!); show() })
    // The weather: left to change by itself, or one chosen.
    const skyOut = document.getElementById('wkSkyOut')!, skyBtns = [...timePanel.querySelectorAll<HTMLButtonElement>('[data-sky]')]
    const NAMES: Record<string, string> = { clear: 'Clear', cloudy: 'Cloudy', overcast: 'Overcast', rain: 'Rain', storm: 'Storm' }
    const showSky = () => {
      const w = walk.weather()
      skyOut.textContent = (w.auto ? 'Changing · ' : '') + NAMES[w.kind]
      for (const b of skyBtns) b.setAttribute('aria-pressed', String(w.auto ? b.dataset.sky === 'auto' : b.dataset.sky === w.kind))
    }
    for (const b of skyBtns) b.addEventListener('click', () => { walk.setWeather(b.dataset.sky as Parameters<typeof walk.setWeather>[0]); showSky() })
    showSky(); setInterval(showSky, 1000)
  }).catch((e) => { console.error(e); load.textContent = 'The island could not be built here (this browser needs WebGL).' })
</script>

<style>
  .wk { position: fixed; inset: 0; background: #0b1220; overflow: hidden; }
  .wk-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
  .wk-canvas:active { cursor: grabbing; }
  .wk-top { position: absolute; top: 14px; left: 14px; right: 14px; display: flex; justify-content: space-between; gap: 8px; pointer-events: none; }
  .wk-btn {
    pointer-events: auto; font: 600 14px/1 var(--font-ui, system-ui, sans-serif); color: #0f1730; background: rgb(255 255 255 / 0.9);
    border: 0; border-radius: 999px; padding: 10px 16px; text-decoration: none; cursor: pointer; box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
  }
