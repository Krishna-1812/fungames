---
/**
 * /walk/ — the island on foot, in 3D (lib/walk): built in the browser from
 * the same facts Unity builds the realistic island from, and walked in third
 * person, with the island's own traffic on its roads. Walk up to any game's
 * building and it offers to take you in.
 */
import Base from '../layouts/Base.astro'
import { withBase } from '../lib/base'
---

<Base title="Walk the island" description="Walk round Tiny Island in 3D: its streets, its traffic, its harbour and its mountain, and every game's building to walk into.">
  <main class="wk" id="main">
    <canvas class="wk-canvas" id="wk" aria-label="The island in 3D"></canvas>
    <div class="wk-top">
      <a class="wk-btn" href={withBase('/')}>← The map</a>
      <span class="wk-right"><button class="wk-btn" id="wkAir" type="button" aria-pressed="false">Aerial</button> <button class="wk-btn" id="wkNight" type="button" aria-pressed="false">Night</button></span>
    </div>
    <p class="wk-help" id="wkHelp">W A S D or the arrow keys to walk · Shift to run · Space to jump · drag to look round · scroll to step back</p>
    <a class="wk-near" id="wkNear" hidden href="/"><span>Play</span> <b id="wkNearTitle"></b> <kbd>E</kbd></a>
    <div class="wk-stick" id="wkStick" aria-hidden="true"><i id="wkKnob"></i></div>
    <p class="wk-load" id="wkLoad">Building the island…</p>
  </main>
</Base>

<script>
  import type { WorldData } from '../lib/walk/build3d'
  const canvas = document.getElementById('wk') as HTMLCanvasElement
  const near = document.getElementById('wkNear') as HTMLAnchorElement
  const nearTitle = document.getElementById('wkNearTitle')!
  const load = document.getElementById('wkLoad')!
  const nightBtn = document.getElementById('wkNight') as HTMLButtonElement
  const stickEl = document.getElementById('wkStick')!, knob = document.getElementById('wkKnob')!

  // A thumb-stick for a phone: where the thumb is from the stick's middle, as a direction and how far.
  let stick: [number, number] = [0, 0]
  const touch = matchMedia('(pointer: coarse)').matches
  if (touch) stickEl.classList.add('on')
  stickEl.addEventListener('pointerdown', (e) => {
    stickEl.setPointerCapture(e.pointerId)
    const r = stickEl.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2, R = r.width / 2
    const move = (ev: PointerEvent) => {
      let dx = (ev.clientX - cx) / R, dy = (ev.clientY - cy) / R
      const m = Math.hypot(dx, dy); if (m > 1) { dx /= m; dy /= m }
      stick = [dx, dy]; knob.style.transform = `translate(${dx * R * 0.6}px, ${dy * R * 0.6}px)`
    }
    move(e)
    const up = () => { stick = [0, 0]; knob.style.transform = ''; stickEl.removeEventListener('pointermove', move); stickEl.removeEventListener('pointerup', up) }
    stickEl.addEventListener('pointermove', move); stickEl.addEventListener('pointerup', up)
  })

  Promise.all([fetch('world.json').then((r) => r.json() as Promise<WorldData>), import('../lib/walk/walker')]).then(([data, { startWalk }]) => {
    const walk = startWalk(canvas, data, {
      onNear(g) {
        near.hidden = !g
        if (g) { nearTitle.textContent = g.title; near.href = (g as { href?: string }).href ?? '/' }
      },
      move: () => stick,
    })
    load.remove()
    ;(window as unknown as { __walk: typeof walk }).__walk = walk
    addEventListener('keydown', (e) => { if (e.code === 'KeyE') { const g = walk.near(); if (g) location.href = g.href } if (e.code === 'KeyN') nightBtn.click() })
    const air = document.getElementById('wkAir') as HTMLButtonElement
    air.addEventListener('click', () => { const on = air.getAttribute('aria-pressed') !== 'true'; air.setAttribute('aria-pressed', String(on)); air.textContent = on ? 'On foot' : 'Aerial'; walk.setAerial(on) })
    if (new URLSearchParams(location.search).has('aerial')) air.click()
    nightBtn.addEventListener('click', () => { const on = nightBtn.getAttribute('aria-pressed') !== 'true'; nightBtn.setAttribute('aria-pressed', String(on)); nightBtn.textContent = on ? 'Day' : 'Night'; walk.setNight(on) })
  }).catch(() => { load.textContent = 'The island could not be built here (this browser needs WebGL).' })
</script>

<style>
  .wk { position: fixed; inset: 0; background: #0b1220; overflow: hidden; }
  .wk-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
  .wk-canvas:active { cursor: grabbing; }
  .wk-top { position: absolute; top: 14px; left: 14px; right: 14px; display: flex; justify-content: space-between; gap: 8px; pointer-events: none; }
  .wk-btn {
    pointer-events: auto; font: 600 14px/1 var(--font-ui, system-ui, sans-serif); color: #0f1730; background: rgb(255 255 255 / 0.9);
    border: 0; border-radius: 999px; padding: 10px 16px; text-decoration: none; cursor: pointer; box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
  }
  .wk-right { display: flex; gap: 8px; }
  .wk-btn:focus-visible { outline: 3px solid #4fe3c1; outline-offset: 2px; }
  .wk-help {
    position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); margin: 0; padding: 8px 14px; border-radius: 999px;
    font: 500 13px/1.3 var(--font-ui, system-ui, sans-serif); color: #eef3ff; background: rgb(12 18 34 / 0.62); white-space: nowrap; pointer-events: none;
  }
  .wk-near {
    position: absolute; left: 50%; bottom: 64px; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 18px; border-radius: 14px; background: #4fe3c1; color: #0f1730; text-decoration: none; font: 600 15px/1.2 var(--font-ui, system-ui, sans-serif);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }
  .wk-near[hidden] { display: none; }
  .wk-near kbd { font: 700 12px/1 ui-monospace, monospace; padding: 4px 6px; border-radius: 6px; background: rgb(15 23 48 / 0.15); }
  .wk-stick { display: none; position: absolute; left: 22px; bottom: 70px; width: 120px; height: 120px; border-radius: 50%; background: rgb(255 255 255 / 0.16); border: 2px solid rgb(255 255 255 / 0.35); touch-action: none; }
  .wk-stick.on { display: block; }
  .wk-stick i { position: absolute; left: 50%; top: 50%; width: 48px; height: 48px; margin: -24px 0 0 -24px; border-radius: 50%; background: rgb(255 255 255 / 0.85); }
  .wk-load { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: #eef3ff; font: 600 16px/1.4 var(--font-ui, system-ui, sans-serif); }
  @media (pointer: coarse) { .wk-help { display: none; } .wk-near { bottom: 210px; } }
</style>
