  /* ---- the odometer: a real seven-segment display -------------------------- */

  /* `digitCellHTML()` builds these nodes as a raw HTML string, inserted via
     `set:html` — Astro only rewrites elements it sees written directly in a
     template with its own scoping attribute, so anything injected as markup
     (here, or built at runtime by a script) never receives it and every
     rule for it has to be `:global`, the same trap trolley-scene.ts hit. */
  .odometer { display: inline-flex; line-height: 1; }
  :global(.digit) {
    position: relative;
    display: inline-block;
    width: 0.56em;
    height: 1em;
    margin: 0 0.05em;
    flex: none;
  }
  :global(.digit.flicker) { animation: incident-flicker 320ms steps(1, end); }
  @keyframes incident-flicker {
    0%, 18%, 36% { filter: brightness(1.9); }
    9%, 27%, 100% { filter: brightness(1); }
  }
  :global(.seg) {
    position: absolute;
    background: var(--seg-off, rgba(79, 227, 193, 0.08));
    transition: background 140ms linear, box-shadow 140ms linear;
  }
  :global(.seg.on) {
    background: var(--seg-on, #4fe3c1);
    box-shadow: 0 0 0.08em var(--seg-on, #4fe3c1), 0 0 0.24em rgba(79, 227, 193, 0.55);
  }
  :global(.seg-a), :global(.seg-g), :global(.seg-d) {
    left: 0.065em;
    width: 0.43em;
    height: 0.085em;
    clip-path: polygon(14% 0, 86% 0, 100% 50%, 86% 100%, 14% 100%, 0 50%);
  }
  :global(.seg-a) { top: 0; }
  :global(.seg-g) { top: 0.4575em; }
  :global(.seg-d) { top: 0.915em; }
  :global(.seg-f), :global(.seg-b), :global(.seg-e), :global(.seg-c) {
    width: 0.085em;
    height: 0.41em;
    clip-path: polygon(0 14%, 50% 0, 100% 14%, 100% 86%, 50% 100%, 0 86%);
  }
  :global(.seg-f), :global(.seg-e) { left: 0; }
  :global(.seg-b), :global(.seg-c) { right: 0; }
  :global(.seg-f), :global(.seg-b) { top: 0.085em; }
  :global(.seg-e), :global(.seg-c) { top: 0.505em; }

  /* Still searching a rare tier's deeper window: a slow sweep of brightness
     crosses the blank digits left to right, rather than the row just
     sitting there looking broken. */
  :global(html.play) .odometer.scanning :global(.digit) { animation: incident-scan 1.8s ease-in-out infinite; }
  .odometer.scanning :global(.digit:nth-child(1)) { animation-delay: 0ms; }
  .odometer.scanning :global(.digit:nth-child(2)) { animation-delay: 120ms; }
  .odometer.scanning :global(.digit:nth-child(3)) { animation-delay: 240ms; }
  .odometer.scanning :global(.digit:nth-child(4)) { animation-delay: 360ms; }
  .odometer.scanning :global(.digit:nth-child(5)) { animation-delay: 480ms; }
  @keyframes incident-scan {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  /* ---- groups / rows -------------------------------------------------------- */

  .groups { display: flex; flex-direction: column; gap: 32px; }
