    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  .bolt::after {
    content: '';
    position: absolute;
    inset: 40% 12%;
    height: 1px;
    background: rgba(0, 0, 0, 0.55);
    transform: rotate(28deg);
  }
  .bolt-tl { top: 9px; left: 10px; }
  .bolt-tr { top: 9px; right: 10px; }
  .bolt-bl { bottom: 9px; left: 10px; }
  .bolt-br { bottom: 9px; right: 10px; }

  /* The recessed "screen" the odometer sits inside, and the glass over it —
     shared between the hero and every row so one texture reads as one
     material throughout the sign rather than a different fake per size. */
  .hero-screen, .row-screen { position: relative; overflow: hidden; border-radius: 8px; }
  .screen-glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
