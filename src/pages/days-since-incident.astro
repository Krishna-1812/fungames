---
import GameShell from '../layouts/GameShell.astro'
import { iconSvg } from '../lib/icons'
import { EARTHQUAKE_CATEGORIES, FLARE_CATEGORIES, STORM_CATEGORIES, SHOCK_CATEGORIES } from '../lib/incident-model'
import { digitCellHTML } from '../lib/seven-segment'
import { flapCellHTML } from '../lib/split-flap'

/**
 * Days Since Incident — the workplace "days since last accident" sign,
 * except the incidents are real and every counter is live.
 *
 * The model (`lib/incident-model.ts`) and the loader (`lib/incident-fetch.ts`)
 * do all the real work; this page is a thin, honest client for them. Every
 * feed is read straight from the visitor's own browser at USGS and NASA — no
 * backend of this site's own, and nothing here is precomputed or invented.
 * `scripts/check-incident-model.mjs` proves the pure arithmetic and parsing
 * against real captured API shapes; there is deliberately no live-network
 * checker, the same restraint every other checker on this site takes.
 *
 * The visual redo: neal.fun's own version of this page renders every count
 * as a real eight-digit car-odometer window — ghosted unlit segments and
 * all — inside a bolted black plate. That structure is worth taking
 * literally rather than approximating with a monospace font, so
 * `lib/seven-segment.ts` draws a real seven-segment digit (`check-seven-
 * segment.mjs` proves the table is genuine, not just plausible), and every
 * card here is a mounted plate: rivets, a recessed screen, real depth.
 *
 * In the shell the sign sits on paper: the plates keep their dark screens,
 * the LEDs are mint and the hazard tape cobalt. Score is the headline "safe
 * for", Feeds counts the four sources that have answered, Moves the rows
 * read, and Best is the calmest stretch you have seen. When every row has
 * been read the report is the ending — quietly, since it is a list of
 * earthquakes and solar storms.
 */

const GROUPS = [
  { id: 'quake', label: 'Earthquakes', source: 'USGS', icon: 'quake', categories: EARTHQUAKE_CATEGORIES },
  { id: 'flare', label: 'Solar Flares', source: 'NASA DONKI', icon: 'solar-flare', categories: FLARE_CATEGORIES },
  { id: 'storm', label: 'Geomagnetic Storms', source: 'NASA DONKI', icon: 'geostorm', categories: STORM_CATEGORIES },
  { id: 'shock', label: 'Interplanetary Shocks', source: 'NASA DONKI', icon: 'shock', categories: SHOCK_CATEGORIES },
] as const

const ROW_DIGITS = 5
const HERO_DAY_DIGITS = 3

/** Real classification-scale content behind each group's info button — the
 *  same real, cited tables neal.fun's own info icons open, restated rather
 *  than copied, with a severity tier (0-5) driving the row's accent colour. */
type InfoRow = { range: string; effect: string; tier: 0 | 1 | 2 | 3 | 4 | 5 }
type InfoContent = { title: string; intro: string; rows: InfoRow[]; source: string; sourceUrl: string }
const INFO: Record<string, InfoContent> = {
  quake: {
    title: 'The moment magnitude scale',
    intro: 'Each whole number is roughly 32 times more energy released than the last — not a straight line.',
    rows: [
      { range: 'Under 2.5', effect: 'Usually not felt; recorded only by seismographs', tier: 0 },
      { range: '2.5 – 5.4', effect: 'Often felt; minor damage in most cases', tier: 1 },
      { range: '5.5 – 6.0', effect: 'Slight damage to buildings and structures', tier: 2 },
      { range: '6.1 – 6.9', effect: 'Can be destructive across populated areas', tier: 3 },
      { range: '7.0 – 7.9', effect: 'Major earthquake; serious damage over a wide area', tier: 4 },
      { range: '8.0 and up', effect: 'Great earthquake; serious damage hundreds of miles across', tier: 5 },
    ],
    source: 'United States Geological Survey',
    sourceUrl: 'https://www.usgs.gov/programs/earthquake-hazards/earthquake-magnitude-energy-release-and-shaking-intensity',
  },
  flare: {
    title: 'GOES X-ray flare class',
    intro: "Each letter is a tenfold jump in X-ray brightness. The bracketed R-number is NOAA's own radio-blackout severity for a flare of that class.",
    rows: [
      { range: 'A / B class', effect: 'Background level — no effect at Earth', tier: 0 },
      { range: 'C class', effect: 'Small; essentially no effect at Earth', tier: 1 },
      { range: 'M1 – M4 (R1)', effect: 'Minor HF radio degradation on the sunlit side', tier: 2 },
      { range: 'M5 – M9 (R2)', effect: 'Wide HF blackout; frequencies under 10 MHz fade', tier: 3 },
      { range: 'X1 – X9 (R3)', effect: 'Full dayside HF blackout, up to about an hour', tier: 4 },
      { range: 'X10 and up (R4–R5)', effect: 'Severe to extreme blackout across the dayside', tier: 5 },
    ],
    source: 'NOAA Space Weather Prediction Center',
    sourceUrl: 'https://www.spaceweather.gov/phenomena/solar-flares-radio-blackouts',
  },
  storm: {
    title: "NOAA's G-scale",
    intro: "Rated on the planetary Kp index — the same real-time measure of Earth's magnetic field this page's own counters are keyed to.",
    rows: [
      { range: 'G1, Kp 5', effect: 'Weak grid fluctuations; aurora reaches the far-northern US', tier: 1 },
      { range: 'G2, Kp 6', effect: 'High-latitude power grids see voltage alarms', tier: 2 },
      { range: 'G3, Kp 7', effect: 'Voltage corrections required; aurora as low as Illinois', tier: 3 },
      { range: 'G4, Kp 8', effect: 'Widespread voltage-control problems likely', tier: 4 },
      { range: 'G5, Kp 9', effect: 'Possible grid collapse — aurora reached Florida in May 2024', tier: 5 },
    ],
    source: 'NOAA Space Weather Prediction Center',
    sourceUrl: 'https://www.swpc.noaa.gov/noaa-scales-explanation',
  },
  shock: {
    title: 'Interplanetary shock',
    intro: "Not a category with levels — a shock either reached a spacecraft or it didn't. A fast coronal mass ejection drives a wave of compressed solar wind ahead of it; when that wave crosses a spacecraft near Earth, instruments record a sudden jump in solar-wind speed, density and magnetic field. It's often the first hard evidence that a geomagnetic storm is on its way, sometimes under an hour before it arrives.",
    rows: [],
    source: 'NASA DONKI (Space Weather Database Of Notifications, Knowledge, Information)',
    sourceUrl: 'https://ccmc.gsfc.nasa.gov/tools/DONKI/',
  },
}
---

<GameShell
  slug="days-since-incident"
  labels={{ score: 'Safe for', best: 'Calmest', level: 'Feeds', moves: 'Rows read' }}
  initial={{ score: '—', level: `0 / ${GROUPS.length}`, moves: `0 / ${GROUPS.reduce((n, g) => n + g.categories.length, 0)}` }}
>
  <div class="dsi">
    {/* The sign, on the wall it is screwed to. The wall is a shader
        (lib/incident-wall-shader.ts) that knows only where the sign is, to
        light the blocks and cast its shadow; the sign is markup, so its words
        stay sharp, and its counters are split-flap drums that fall card by
        card (lib/split-flap.ts). */}
    <section class="scene" id="dsiScene" aria-labelledby="signH">
      <div class="sign" id="dsiSign">
        <i class="screw" style="--sx:0;--sy:0;--rot:22deg" aria-hidden="true"></i><i class="screw" style="--sx:1;--sy:0;--rot:-31deg" aria-hidden="true"></i>
        <i class="screw" style="--sx:0;--sy:1;--rot:64deg" aria-hidden="true"></i><i class="screw" style="--sx:1;--sy:1;--rot:8deg" aria-hidden="true"></i>
        <header class="sign-band">
          <span class="sign-cross" aria-hidden="true"></span>
          <h2 id="signH">Safety record <span class="sign-band-sub">Planet Earth</span></h2>
        </header>
        <div class="sign-body" aria-hidden="true">
          <p class="sign-line">This planet has gone</p>
          <div class="sign-days">
            <span class="flaps flaps-big" data-flap="days" set:html={Array.from({ length: HERO_DAY_DIGITS }, () => flapCellHTML()).join('')} />
            <span class="sign-unit">days</span>
          </div>
          <div class="sign-hms">
            <span class="hms-part"><span class="flaps flaps-small" data-flap="hours" set:html={flapCellHTML() + flapCellHTML()} /><span class="hms-u">hrs</span></span>
            <b class="sign-colon">:</b>
            <span class="hms-part"><span class="flaps flaps-small" data-flap="minutes" set:html={flapCellHTML() + flapCellHTML()} /><span class="hms-u">min</span></span>
            <b class="sign-colon">:</b>
            <span class="hms-part"><span class="flaps flaps-small" data-flap="seconds" set:html={flapCellHTML() + flapCellHTML()} /><span class="hms-u">sec</span></span>
          </div>
          <p class="sign-line">without an incident</p>
        </div>
        <footer class="sign-foot"><i class="live-dot" aria-hidden="true"></i><span data-hero-caption>Reading the sensors&hellip;</span></footer>
        <i class="sign-light" aria-hidden="true"></i>
      </div>
      <p class="sr-only" aria-live="polite" data-hero-sr>Reading the sensors.</p>
    </section>

    <p class="lede">
      The sign from a warehouse wall, except the incidents are real. Every
      number on this page is read <em>right now</em> from a live feed: USGS for
      earthquakes, NOAA, GFZ Potsdam and NASA for the Sun and the Earth's
      magnetic field. Nobody typed any of it in.
    </p>

    <div class="groups">
      {GROUPS.map((group) => (
        <section class="group" aria-labelledby={`g-${group.id}`}>
          <h2 class="group-head" id={`g-${group.id}`}>
            <span class="group-icon" set:html={iconSvg(group.icon)} />
            {group.label}
            <button class="info-btn" type="button" data-info={group.id} aria-label={`What the ${group.label} scale means`}>i</button>
            <span class="group-source">{group.source}, live</span>
          </h2>
          <ol class="rows">
            {group.categories.map((cat) => (
              <li class="row" data-cat={cat.id} data-kind={group.id}>
                <i class="bolt bolt-tl" aria-hidden="true"></i><i class="bolt bolt-tr" aria-hidden="true"></i>
                <div class="row-top">
                  <span class="row-title">{cat.title}</span>
                  <span class="row-threshold">{cat.thresholdLabel}</span>
                </div>
                <div class="row-screen">
                  <span class="odometer" data-fig aria-hidden="true" set:html={Array.from({ length: ROW_DIGITS }, () => digitCellHTML()).join('')} />
                  <div class="screen-glass" aria-hidden="true"></div>
                </div>
                <p class="sr-only" data-sr>Reading the sensors.</p>
                <p class="row-detail" data-detail>&nbsp;</p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <footer class="foot">
      <p>
        Earthquakes are read from <a href="https://earthquake.usgs.gov/earthquakes/feed/" target="_blank" rel="noopener">USGS's</a>
        own catalogue search, one request per magnitude tier. Solar flares,
        geomagnetic storms and interplanetary shocks come from
        <a href="https://ccmc.gsfc.nasa.gov/tools/DONKI/" target="_blank" rel="noopener">NASA's DONKI</a> space-weather
        log, reduced to NOAA's own published GOES flare classes and G-scale.
        Hurricanes and tsunamis are deliberately not here: the cleanest free
        feed for them labels the identical wind speed two different things
        depending which weather agency reported it, and a category built on
        data that disagrees with itself would be worse than no row at all.
      </p>
      <p class="foot-small">
        A rare tier can take a few seconds longer than the rest — the
        difference between "no X10 flare in the last year" and "keep looking
        back until one turns up" isn't free, and this page pays it live
        rather than pretending otherwise.
      </p>
    </footer>
  </div>

  <dialog id="infoDialog" class="panel" aria-labelledby="infoTitle">
    <p class="label meta">The scale</p>
    <h2 id="infoTitle" data-info-title style="margin-top:10px"></h2>
    <div class="panel-body">
      <p class="info-intro" data-info-intro></p>
      <table class="info-table" data-info-table>
        <tbody data-info-rows></tbody>
      </table>
      <p class="info-source">Data from <a data-info-source-link target="_blank" rel="noopener"><span data-info-source></span></a>.</p>
    </div>
    <div class="panel-actions">
      <button type="button" class="pill pill--hero" data-close><span>Close</span></button>
    </div>
  </dialog>

  <script type="application/json" id="info-data" set:html={JSON.stringify(INFO)} />

  <Fragment slot="howto">
    <p>
      The "days since last accident" sign from a warehouse wall, except the
      incidents are real: earthquakes from USGS, and solar flares, geomagnetic
      storms and interplanetary shocks from NASA, read live from your browser.
    </p>
    <ul>
      <li>The big counter is time since the most recent incident of any kind. Each row below is days since the last one at that strength or worse.</li>
      <li>The <b>i</b> beside each group explains its scale.</li>
      <li>A rare tier can take a few seconds longer, while the page looks further back for one.</li>
    </ul>
    <p>When every row has been read, the report is the end. Your best is the calmest stretch you have seen.</p>
  </Fragment>
</GameShell>

<script>
  import {
    EARTHQUAKE_CATEGORIES, FLARE_CATEGORIES, STORM_CATEGORIES, SHOCK_CATEGORIES, ALL_CATEGORIES,
    mostRecentQualifying, daysSince, elapsedParts,
    type IncidentEvent, type IncidentCategory,
  } from '../lib/incident-model'
  import { loadFast, readCache, writeCache, type SourceResult, type SpaceAnswer } from '../lib/incident-fetch'
  import { segmentsFor, fitWidth, SEGMENT_KEYS } from '../lib/seven-segment'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { recordPlay } from '../lib/stats'
  import { FlapBoard } from '../lib/split-flap'
  import { ShaderSurface } from '../lib/gl'
  import { INCIDENT_WALL_FRAG } from '../lib/incident-wall-shader'
  import { hit } from '../lib/audio'

  const rowEls = new Map(
    Array.from(document.querySelectorAll<HTMLLIElement>('.row')).map((el) => [el.dataset.cat!, el]),
  )

  /** A real seven-segment odometer, not a monospace font pretending to be
   *  one. Each `.odometer` already holds N pre-built `.digit` cells (server-
   *  rendered by `digitCellHTML()`); this only ever toggles each cell's
   *  seven `.seg` children between on/off, so a changed digit flickers
   *  exactly the way a real display does rather than the text silently
   *  becoming a different string. */
  const prefersReducedMotion = !PLAY
  function setSegDigit(cell: HTMLElement, ch: string) {
    if (cell.dataset.v === ch) return
    const changed = cell.dataset.v !== undefined
    cell.dataset.v = ch
    const lit = segmentsFor(ch)
    const segs = cell.children
    for (let i = 0; i < SEGMENT_KEYS.length; i++) segs[i]!.classList.toggle('on', lit[i])
    if (changed && !prefersReducedMotion) {
      cell.classList.remove('flicker')
      // Force a reflow so the same animation can retrigger on the next change.
      void (cell as HTMLElement).offsetWidth
      cell.classList.add('flicker')
    }
  }
  function setOdometer(container: HTMLElement, raw: string) {
    const cells = container.children
    const value = fitWidth(raw, cells.length)
    for (let i = 0; i < cells.length; i++) setSegDigit(cells[i] as HTMLElement, value[i])
  }

  type RowState = { event: IncidentEvent | null; ok: boolean; pending: boolean }
  const state = new Map<string, RowState>()
  for (const cat of ALL_CATEGORIES) state.set(cat.id, { event: null, ok: true, pending: true })

  const ALL_DASHES = '----------'
  function paintRow(cat: IncidentCategory) {
    const el = rowEls.get(cat.id)
    if (!el) return
    const fig = el.querySelector<HTMLElement>('[data-fig]')!
    const sr = el.querySelector<HTMLElement>('[data-sr]')!
    const detail = el.querySelector<HTMLElement>('[data-detail]')!
    const s = state.get(cat.id)!

    fig.classList.toggle('scanning', s.pending && !s.event)

    if (!s.ok) {
      setOdometer(fig, ALL_DASHES) // the feed itself failed
      // Say whose feed it is: NASA's shock log has whole days down, which reloading will not fix.
      sr.textContent = 'The feed for this row did not answer.'
      detail.textContent = cat.kind === 'shock'
        ? "NASA's shock log has not answered yet, and no sudden impulse has been reported. This row fills in when one does."
        : cat.kind === 'quake' ? 'USGS did not answer in time. Try reloading in a minute.' : 'The space-weather feeds did not answer in time. Try reloading in a minute.'
      return
    }
    if (s.event) {
      const days = daysSince(Date.now(), s.event.time)
      setOdometer(fig, String(days))
      sr.textContent = `${days} days.`
      // Space weather is told in UTC ("peaking 20:41 UTC"), so its date is the UTC one too.
      const tz = cat.kind === 'quake' ? undefined : 'UTC'
      detail.textContent = `Last: ${s.event.detail}, ${new Date(s.event.time).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', timeZone: tz })}`
      return
    }
    if (s.pending) {
      setOdometer(fig, '')
      sr.textContent = 'Still searching further back.'
      detail.textContent = 'Nothing in the last 400 days — checking the last five years…'
    } else {
      setOdometer(fig, ALL_DASHES)
      sr.textContent = 'None found.'
      detail.textContent = 'No confirmed event in the last five years.'
    }
  }

  function applyResult(cat: IncidentCategory, event: IncidentEvent | null, ok: boolean, pending: boolean) {
    state.set(cat.id, { event, ok, pending })
    paintRow(cat)
    paintStrip()
  }

  /* ---- the shell ---------------------------------------------------------- */

  // Restart is a reload, the default: reading every feed again is exactly
  // what starting again means here.
  const shell = createShell({ slug: 'days-since-incident' })
  const GROUP_OF: Record<string, IncidentCategory[]> = {
    quake: EARTHQUAKE_CATEGORIES, flare: FLARE_CATEGORIES, storm: STORM_CATEGORIES, shock: SHOCK_CATEGORIES,
  }
  /** "3 d 4 h", "5 h 12 m", "40 s": short enough for a score tile. */
  function safeFor(ms: number) {
    const { days, hours, minutes } = elapsedParts(Date.now(), Date.now() - ms)
    if (days > 0) return `${days} d ${hours} h`
    if (hours > 0) return `${hours} h ${minutes} m`
    return minutes > 0 ? `${minutes} m` : `${Math.max(0, Math.floor(ms / 1000))} s`
  }
  /** The same span in words, for a sentence: "3 days and 4 hours", "43 minutes". */
  function inWords(ms: number) {
    const { days, hours, minutes } = elapsedParts(Date.now(), Date.now() - ms)
    const n = (v: number, u: string) => `${v} ${u}${v === 1 ? '' : 's'}`
    if (days > 0) return hours ? `${n(days, 'day')} and ${n(hours, 'hour')}` : n(days, 'day')
    if (hours > 0) return minutes ? `${n(hours, 'hour')} and ${n(minutes, 'minute')}` : n(hours, 'hour')
    return minutes > 0 ? n(minutes, 'minute') : 'under a minute'
  }
  const read = () => ALL_CATEGORIES.filter((c) => { const st = state.get(c.id)!; return !st.pending || !!st.event || !st.ok }).length
  function paintStrip() {
    shell.setLevel(`${Object.values(GROUP_OF).filter((list) => list.every((c) => { const st = state.get(c.id)!; return !st.pending || !!st.event || !st.ok })).length} / ${Object.keys(GROUP_OF).length}`)
    shell.setMoves(`${read()} / ${ALL_CATEGORIES.length}`)
  }

  let reported = false
  function maybeReport() {
    if (reported || heroPending) return
    if (ALL_CATEGORIES.some((c) => state.get(c.id)!.pending && !state.get(c.id)!.event)) return
    reported = true
    const calm = heroEvent ? Date.now() - heroEvent.time : 0
    if (heroEvent) shell.considerBest(Math.round(calm / 1000), safeFor(calm))
    // The row that has been quiet longest, for the one line worth reading.
    let quietest: { cat: IncidentCategory; days: number } | null = null
    for (const c of ALL_CATEGORIES) {
      const ev = state.get(c.id)!.event
      if (!ev) continue
      const d = daysSince(Date.now(), ev.time)
      if (!quietest || d > quietest.days) quietest = { cat: c, days: d }
    }
    recordPlay('days-since-incident', {}, {})
    shell.win({
      celebrate: false,
      // The card waits below the sign; nobody reading a row needs yanking.
      scroll: false,
      kicker: 'Every sensor read',
      title: heroEvent ? `The planet has been safe for ${inWords(calm)}.` : 'Nothing to report, for once.',
      score: heroEvent ? safeFor(calm) : '—',
      lines: [
        heroEvent ? `The last incident: ${heroEvent.detail}.` : 'No confirmed incident turned up in any feed.',
        quietest ? `Quietest row: ${quietest.cat.title}, ${quietest.days.toLocaleString('en-US')} days and counting.` : '',
      ].filter(Boolean),
      againLabel: 'Read the sensors again',
    })
  }

  /* ---- the hero: the single most recent incident of any kind -------------- */

  let heroEvent: IncidentEvent | null = null
  let heroPending = true
  function recomputeHero() {
    let best: IncidentEvent | null = null
    for (const cat of ALL_CATEGORIES) {
      const ev = state.get(cat.id)?.event
      if (ev && (!best || ev.time > best.time)) best = ev
    }
    heroEvent = best
  }
  /* The sign's drums. Each card that lands clacks, quietly, if sound is on;
     a drum spinning through cards to be set clacks softer. */
  const clack = (strength: number) => hit({ dur: 0.028, gain: 0.05 * strength, freq: 1500 + Math.random() * 700, q: 2.5 })
  const flapOf = (k: string) => new FlapBoard(document.querySelector<HTMLElement>(`[data-flap="${k}"]`)!, prefersReducedMotion, clack)
  const board = { days: flapOf('days'), hours: flapOf('hours'), minutes: flapOf('minutes'), seconds: flapOf('seconds') }
  const heroSr = document.querySelector<HTMLElement>('[data-hero-sr]')!
  let srMinute = -1

  function tickHero() {
    const capEl = document.querySelector<HTMLElement>('[data-hero-caption]')!
    if (!heroEvent) {
      capEl.textContent = heroPending ? 'Reading the sensors…' : 'No confirmed incident to report yet.'
      return
    }
    const { days, hours, minutes } = elapsedParts(Date.now(), heroEvent.time)
    const seconds = Math.floor((Date.now() - heroEvent.time) / 1000) % 60
    board.days.set(String(Math.max(0, days)))
    board.hours.set(String(hours), true)
    board.minutes.set(String(minutes), true)
    board.seconds.set(String(Math.max(0, seconds)), true)
    capEl.textContent = `Last incident: ${heroEvent.detail}`
    // Read aloud once a minute, not every second.
    if (minutes !== srMinute) {
      srMinute = minutes
      heroSr.textContent = `This planet has gone ${inWords(Date.now() - heroEvent.time)} without an incident. Last incident: ${heroEvent.detail}.`
    }
    // The tile only changes once a minute, so it is fine to tell it every tick.
    shell.setScore(safeFor(Date.now() - heroEvent.time))
  }

  /* ---- the wall ------------------------------------------------------------ */

  const scene = document.getElementById('dsiScene')!
  const sign = document.getElementById('dsiSign')!
  /** The sign is 900 mm across; where it is on the wall, in the canvas's own pixels, y up. */
  let plate = [0, 0, 1, 1], pxPerMm = 1
  let wall: ShaderSurface | null = null
  function placePlate() {
    if (!wall) return
    const s = scene.getBoundingClientRect(), r = sign.getBoundingClientRect()
    const k = wall.canvas.width / Math.max(1, s.width)
    const H = wall.canvas.height
    plate = [(r.left - s.left) * k, H - (r.bottom - s.top) * k, (r.right - s.left) * k, H - (r.top - s.top) * k]
    pxPerMm = ((r.right - r.left) * k) / 900
    wall.redraw()
  }
  // Built once the page has been seen: compiling the wall's shader is a few hundred milliseconds of work.
  function buildWall() {
    wall = new ShaderSurface(scene, INCIDENT_WALL_FRAG, {
      still: true,
      uniforms: () => ({ u_plate: plate, u_mm: pxPerMm }),
    })
    scene.prepend(wall.canvas)
    scene.classList.toggle('lit', wall.canvas.isConnected)
    // The canvas takes its size a frame after it is placed; measure then, and on every resize.
    requestAnimationFrame(placePlate)
    new ResizeObserver(() => requestAnimationFrame(placePlate)).observe(scene)
  }
  const idle = (window as Window & { requestIdleCallback?: (f: () => void, o?: { timeout: number }) => void }).requestIdleCallback
  if (idle) idle(buildWall, { timeout: 500 }); else setTimeout(buildWall, 60)
  setInterval(tickHero, 1000)
  tickHero()

  /* ---- loading: cache, fast pass, then a background deep pass per source -- */

  const now = Date.now()
  const cached = readCache(now)

  async function run() {
    let quakes: Map<string, SourceResult>
    let flr: SourceResult
    let gst: SourceResult
    let ips: SourceResult
    let space: SpaceAnswer | null

    if (cached) {
      quakes = new Map(cached.quakes)
      flr = cached.flr
      gst = cached.gst
      ips = cached.ips
      space = cached.space
    } else {
      const fast = await loadFast(now)
      quakes = fast.quakes
      flr = fast.flr
      gst = fast.gst
      ips = fast.ips
      space = fast.space
    }

    for (const cat of EARTHQUAKE_CATEGORIES) {
      const r = quakes.get(cat.id)
      applyResult(cat, r?.events[0] ?? null, r?.ok ?? false, false)
    }

    // The space-weather answer already holds the most recent event at every
    // level, from every source and the full records; nothing is left to search.
    for (const [list, src] of [[FLARE_CATEGORIES, flr], [STORM_CATEGORIES, gst], [SHOCK_CATEGORIES, ips]] as const) {
      for (const cat of list) applyResult(cat, mostRecentQualifying(src.events, cat), src.ok, false)
    }
    recomputeHero()
    heroPending = false
    tickHero()
    maybeReport()

    if (!cached && space) writeCache({ quakes: Array.from(quakes.entries()), flr, gst, ips, space }, now)
  }

  run()

  /* ---- the info dialog: one real classification scale per group ----------- */

  type InfoRow = { range: string; effect: string; tier: 0 | 1 | 2 | 3 | 4 | 5 }
  type InfoContent = { title: string; intro: string; rows: InfoRow[]; source: string; sourceUrl: string }
  const INFO: Record<string, InfoContent> = JSON.parse(document.getElementById('info-data')!.textContent!)

  const dialog = document.getElementById('infoDialog') as HTMLDialogElement
  const titleEl = dialog.querySelector<HTMLElement>('[data-info-title]')!
  const introEl = dialog.querySelector<HTMLElement>('[data-info-intro]')!
  const tableEl = dialog.querySelector<HTMLElement>('[data-info-table]')!
  const rowsEl = dialog.querySelector<HTMLElement>('[data-info-rows]')!
  const sourceEl = dialog.querySelector<HTMLElement>('[data-info-source]')!
  const sourceLinkEl = dialog.querySelector<HTMLAnchorElement>('[data-info-source-link]')!

  // Which scales get read, once each a page, and whose source gets followed.
  const explained = new Set<string>()
  let shownInfo: InfoContent | null = null
  sourceLinkEl.addEventListener('click', () => { if (shownInfo) shell.pick('Source followed', shownInfo.source) })
  document.querySelectorAll<HTMLButtonElement>('[data-info]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = INFO[btn.dataset.info!]
      if (!content) return
      shownInfo = content
      if (!explained.has(content.title)) { explained.add(content.title); shell.pick('Scale explained', content.title) }
      titleEl.textContent = content.title
      introEl.textContent = content.intro
      sourceEl.textContent = content.source
      sourceLinkEl.href = content.sourceUrl
      rowsEl.innerHTML = ''
      tableEl.classList.toggle('empty', content.rows.length === 0)
      for (const row of content.rows) {
        const tr = document.createElement('tr')
        tr.style.setProperty('--tier', String(row.tier))
        tr.innerHTML = `<td class="info-range">${row.range}</td><td class="info-effect">${row.effect}</td>`
        rowsEl.append(tr)
      }
      dialog.showModal()
    })
  })
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close())
  // Not the shell's own panel, so P for pause should not fire while it is open.
  // A click on the ::backdrop lands on the <dialog> element itself (its box
  // is exactly the panel), so this only fires for a genuine outside click.
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close() })
</script>

<style>
  /* The sign sits on paper. The plates keep their dark screens — they are
     the picture — and the page around them is the design system's. */
  .dsi { max-width: 1180px; margin: 0 auto; }
  .dsi > :not(.scene):not(.groups) { max-width: 780px; margin-left: auto; margin-right: auto; }

  /* ---- the wall and the sign ------------------------------------------------ */

  /* The wall is the shader; until it has drawn (or where there is no WebGL)
     it is a plain painted wall, and the sign casts its own CSS shadow. */
  .scene {
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; justify-content: center; align-items: center;
    min-height: 600px; padding: 84px 24px 120px;
    border-radius: var(--r-lg);
    background: radial-gradient(90% 70% at 50% 0%, #8a949c, #59636b 60%, #2b3238);
    box-shadow: 0 40px 80px -46px rgba(0, 0, 0, 0.85), inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }
  .scene :global(.gl-surface) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: -1; }

  /* A vitreous-enamel sign on steel, 900 mm across: white face, safety-green
     band and frame line, four chrome screws. The face is lit like the wall —
     brightest under the tube, a soft sheen across its top — by .sign-light,
     laid over everything printed on it. */
  .sign {
    --green: #0b5a3a;
    position: relative; width: min(760px, 100%);
    padding: 0 0 18px;
    border-radius: 12px;
    background: linear-gradient(180deg, #f6f8f8, #eef1f2 60%, #e7ebec);
    color: #14181c;
    font-family: var(--font);
    text-align: center;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12),
      0 1px 0 #b9c1c6, 0 2px 0 #8d969c, 0 3px 1px rgba(0, 0, 0, 0.35);
  }
  .scene:not(.lit) .sign { box-shadow: 0 30px 50px -20px rgba(0, 0, 0, 0.55), 0 2px 0 #8d969c; }
  /* The printed frame line, inset from the edge as every safety sign has. */
  .sign::before {
    content: ''; position: absolute; inset: 9px; border: 2.5px solid var(--green); border-radius: 7px; pointer-events: none;
  }
  .sign-band {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    margin: 9px 9px 0; padding: 15px 20px 14px;
    border-radius: 7px 7px 0 0;
    background: linear-gradient(180deg, #0f6743, var(--green));
    color: #fff;
  }
  .sign-band h2 {
    margin: 0; font-family: var(--font); font-size: clamp(17px, 2.6vw, 25px); font-weight: 800;
    letter-spacing: 0.16em; text-transform: uppercase; line-height: 1.1; color: #fff;
  }
  .sign-band-sub { font-weight: 600; opacity: 0.8; margin-left: 0.5em; }
  /* The safe-condition mark: a white cross on the green, in a white ring. */
  .sign-cross {
    position: relative; flex: none; width: 34px; height: 34px; border-radius: 50%;
    background: #fff;
  }
  .sign-cross::before, .sign-cross::after {
    content: ''; position: absolute; left: 50%; top: 50%; background: var(--green);
    transform: translate(-50%, -50%);
  }
  .sign-cross::before { width: 20px; height: 6px; }
  .sign-cross::after { width: 6px; height: 20px; }
  .sign-body { padding: 22px 26px 6px; }
  .sign-line {
    margin: 0; font-size: clamp(15px, 2.2vw, 21px); font-weight: 800;
    letter-spacing: 0.14em; text-transform: uppercase; color: #1b2025;
  }
  .sign-days { display: flex; align-items: flex-end; justify-content: center; gap: 16px; margin: 16px 0 14px; }
  .sign-unit { font-size: clamp(22px, 3.4vw, 34px); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding-bottom: 6px; }
  .sign-hms { display: flex; align-items: flex-start; justify-content: center; gap: 8px; margin: 0 0 18px; }
  .hms-part { display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .hms-u { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #4a5560; }
  .sign-colon { font-size: 30px; line-height: 64px; color: #1b2025; }
  .sign-foot {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    margin: 4px 34px 0; padding: 12px 0 4px;
    border-top: 1.5px solid rgba(11, 90, 58, 0.35);
    font-size: 13.5px; font-weight: 600; color: #2b333b; min-height: 1.5em;
  }
  .sign-foot .live-dot { flex: none; }

  /* Chrome pan-head screws, each turned however it was left. */
  .screw {
    position: absolute; z-index: 2; width: 15px; height: 15px; border-radius: 50%;
    left: calc(var(--sx) * (100% - 15px) + (1 - 2 * var(--sx)) * 15px);
    top: calc(var(--sy) * (100% - 15px) + (1 - 2 * var(--sy)) * 15px);
    background: radial-gradient(circle at 35% 30%, #ffffff, #c9d0d6 32%, #7d868e 70%, #454c53);
    box-shadow: 0 1.5px 1.5px rgba(0, 0, 0, 0.45), inset 0 -1px 1px rgba(0, 0, 0, 0.3);
    transform: rotate(var(--rot));
  }
  .screw::before, .screw::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 9px; height: 2px; margin: -1px 0 0 -4.5px;
    border-radius: 1px; background: #3a4046; box-shadow: 0 1px 0 rgba(255, 255, 255, 0.55);
  }
  .screw::after { transform: rotate(90deg); }

  /* The light on the enamel: brightest under the tube, falling off to the
     lower corners, and the tube's own reflection as a soft band near the top. */
  .sign-light {
    position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 3;
    background: radial-gradient(130% 110% at 50% -30%, rgba(255, 255, 255, 0) 45%, rgba(48, 62, 78, 0.28) 100%);
    mix-blend-mode: multiply;
  }
  .sign-light::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit;
    background: linear-gradient(176deg, transparent 6%, rgba(255, 255, 255, 0.2) 12%, transparent 24%);
    mix-blend-mode: screen;
  }

  /* ---- the split-flap drums --------------------------------------------------- */

  /* Built by flapCellHTML() as a string, so every rule that reaches inside a
     cell is :global (the set:html trap noted for the odometer below). */
  .flaps {
    --w: 70px; --h: 104px; --fs: 86px;
    display: inline-flex; gap: 5px; padding: 7px;
    border-radius: 8px;
    background: linear-gradient(180deg, #08090b, #121418);
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, 0.9), 0 1px 0 rgba(255, 255, 255, 0.8), 0 -1px 0 rgba(0, 0, 0, 0.25);
  }
  .flaps-small { --w: 38px; --h: 54px; --fs: 44px; gap: 3px; padding: 5px; border-radius: 6px; }
  .flaps :global(.sf) {
    position: relative; width: var(--w); height: var(--h); perspective: calc(var(--h) * 4);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 700; font-size: var(--fs); line-height: var(--h); font-variant-numeric: tabular-nums; color: #eef1f4;
  }
  .flaps :global(.sf-h) {
    position: absolute; left: 0; right: 0; height: 50%; overflow: hidden;
    background: linear-gradient(180deg, #2c3036, #1f2328);
    border-radius: 4px 4px 0 0;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  .flaps :global(.sf-b) {
    background: linear-gradient(180deg, #181b1f, #23272c);
    border-radius: 0 0 4px 4px;
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.04);
  }
  .flaps :global(.sf-t) { top: 0; }
  .flaps :global(.sf-b) { bottom: 0; }
  .flaps :global(.sf-h i) { position: absolute; left: 0; right: 0; height: 200%; font-style: normal; text-align: center; }
  .flaps :global(.sf-t i) { top: 0; }
  .flaps :global(.sf-b i) { bottom: 0; }
  /* The card that falls: hinged on the axle, its face the old top half, its back the new bottom half. */
  .flaps :global(.sf-flap) {
    position: absolute; left: 0; right: 0; top: 0; height: 50%; z-index: 2;
    transform-origin: 50% 100%; transform: rotateX(var(--a, 0deg)); transform-style: preserve-3d;
  }
  .flaps :global(.sf-flap .sf-h) { height: 100%; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .flaps :global(.sf-front) { filter: brightness(var(--lf, 1)); }
  .flaps :global(.sf-back) { transform: rotateX(180deg); filter: brightness(var(--lb, 1)); }
  /* The gap between the cards, and the axle pins at each side. */
  .flaps :global(.sf-axle) {
    position: absolute; left: -3px; right: -3px; top: 50%; height: 2px; margin-top: -1px; z-index: 3;
    background: linear-gradient(90deg, #6d757c 0 3px, #050607 3px calc(100% - 3px), #6d757c calc(100% - 3px));
  }
  /* A card in flight shades the card beneath it. */
  .flaps :global(.sf.turning .sf-b) { box-shadow: inset 0 14px 16px -10px rgba(0, 0, 0, 0.7); }

  @media (max-width: 640px) {
    .scene { min-height: 0; padding: 46px 14px 70px; }
    .sign-body { padding: 18px 14px 4px; }
    .sign-band { gap: 10px; padding: 12px 14px 11px; }
    .sign-cross { width: 26px; height: 26px; }
    .sign-cross::before { width: 15px; height: 5px; }
    .sign-cross::after { width: 5px; height: 15px; }
    .sign-band-sub { display: block; margin: 3px 0 0; font-size: 0.7em; }
    .flaps { --w: 50px; --h: 74px; --fs: 60px; gap: 4px; padding: 5px; }
    .flaps-small { --w: 30px; --h: 42px; --fs: 34px; gap: 2px; padding: 4px; }
    .sign-days { gap: 10px; margin: 12px 0 12px; }
    .sign-colon { font-size: 22px; line-height: 50px; }
    .sign { padding-bottom: 24px; }
    .sign-foot { margin: 2px 30px 0; font-size: 12.5px; text-align: left; align-items: flex-start; }
    .sign-foot .live-dot { margin-top: 6px; }
  }

  .lede {
    margin: 26px auto 34px;
    max-width: 46em;
    text-align: center;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink2);
  }
  .lede em { color: var(--ink); font-style: normal; font-weight: 700; }

  /* ---- mounted-plate chrome, shared by the hero and every row ------------- */

  .bolt {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background:
      linear-gradient(135deg, #4a505c, #1a1d24) padding-box,
      conic-gradient(from 200deg, rgba(255, 255, 255, 0.5), transparent 40%, transparent 60%, rgba(255, 255, 255, 0.5)) border-box;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  .bolt::after {
    content: '';
    position: absolute;
    inset: 40% 12%;
    height: 1px;
    background: rgba(0, 0, 0, 0.55);
    transform: rotate(28deg);
  }
  .bolt-tl { top: 9px; left: 10px; }
  .bolt-tr { top: 9px; right: 10px; }
  .bolt-bl { bottom: 9px; left: 10px; }
  .bolt-br { bottom: 9px; right: 10px; }

  /* The recessed "screen" the odometer sits inside, and the glass over it —
     shared between the hero and every row so one texture reads as one
     material throughout the sign rather than a different fake per size. */
  .row-screen { position: relative; overflow: hidden; border-radius: 8px; }
  .screen-glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.09) 0%, transparent 26%, transparent 72%, rgba(255, 255, 255, 0.05) 100%),
      repeating-linear-gradient(rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 6px var(--mint);
  }
  :global(html.play) .live-dot { animation: incident-live 1.8s ease-in-out infinite; }
  @keyframes incident-live {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  /* ---- the odometer: a real seven-segment display -------------------------- */

  /* `digitCellHTML()` builds these nodes as a raw HTML string, inserted via
     `set:html` — Astro only rewrites elements it sees written directly in a
     template with its own scoping attribute, so anything injected as markup
     (here, or built at runtime by a script) never receives it and every
     rule for it has to be `:global`, the same trap trolley-scene.ts hit. */
  .odometer { display: inline-flex; line-height: 1; }
  :global(.digit) {
    position: relative;
    display: inline-block;
    width: 0.56em;
    height: 1em;
    margin: 0 0.05em;
    flex: none;
  }
  :global(.digit.flicker) { animation: incident-flicker 320ms steps(1, end); }
  @keyframes incident-flicker {
    0%, 18%, 36% { filter: brightness(1.9); }
    9%, 27%, 100% { filter: brightness(1); }
  }
  :global(.seg) {
    position: absolute;
    background: var(--seg-off, rgba(79, 227, 193, 0.08));
    transition: background 140ms linear, box-shadow 140ms linear;
  }
  :global(.seg.on) {
    background: var(--seg-on, #4fe3c1);
    box-shadow: 0 0 0.08em var(--seg-on, #4fe3c1), 0 0 0.24em rgba(79, 227, 193, 0.55);
  }
  :global(.seg-a), :global(.seg-g), :global(.seg-d) {
    left: 0.065em;
    width: 0.43em;
    height: 0.085em;
    clip-path: polygon(14% 0, 86% 0, 100% 50%, 86% 100%, 14% 100%, 0 50%);
  }
  :global(.seg-a) { top: 0; }
  :global(.seg-g) { top: 0.4575em; }
  :global(.seg-d) { top: 0.915em; }
  :global(.seg-f), :global(.seg-b), :global(.seg-e), :global(.seg-c) {
    width: 0.085em;
    height: 0.41em;
    clip-path: polygon(0 14%, 50% 0, 100% 14%, 100% 86%, 50% 100%, 0 86%);
  }
  :global(.seg-f), :global(.seg-e) { left: 0; }
  :global(.seg-b), :global(.seg-c) { right: 0; }
  :global(.seg-f), :global(.seg-b) { top: 0.085em; }
  :global(.seg-e), :global(.seg-c) { top: 0.505em; }

  /* Still searching a rare tier's deeper window: a slow sweep of brightness
     crosses the blank digits left to right, rather than the row just
     sitting there looking broken. */
  :global(html.play) .odometer.scanning :global(.digit) { animation: incident-scan 1.8s ease-in-out infinite; }
  .odometer.scanning :global(.digit:nth-child(1)) { animation-delay: 0ms; }
  .odometer.scanning :global(.digit:nth-child(2)) { animation-delay: 120ms; }
  .odometer.scanning :global(.digit:nth-child(3)) { animation-delay: 240ms; }
  .odometer.scanning :global(.digit:nth-child(4)) { animation-delay: 360ms; }
  .odometer.scanning :global(.digit:nth-child(5)) { animation-delay: 480ms; }
  @keyframes incident-scan {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  /* ---- groups / rows -------------------------------------------------------- */

  .groups { display: flex; flex-direction: column; gap: 32px; }
  .group-head {
    font-family: var(--sans);
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .group-icon {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--t-teal);
  }
  .info-btn {
    flex: none;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--card);
    color: var(--ink);
    font-family: var(--display);
    font-size: 13px;
    font-style: italic;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: background 140ms, transform 140ms;
  }
  .info-btn:hover { background: var(--ink); color: var(--ink-paper); }
  .info-btn:active { transform: scale(0.95); }
  .group-source {
    margin-left: auto;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink3);
  }

  .rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 14px;
    row-gap: 2px;
    padding: 16px 18px 13px;
    border-radius: 11px;
    background: linear-gradient(180deg, #1a1d24, #13151b);
    border: 1px solid rgba(79, 227, 193, 0.1);
    box-shadow: 0 10px 22px -16px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .row .bolt-tl { top: 7px; left: 8px; }
  .row .bolt-tr { top: 7px; right: 8px; }
  .row .bolt { width: 6px; height: 6px; }

  .row-top { grid-column: 1; display: flex; flex-direction: column; gap: 1px; }
  .row-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #e6ebf2;
  }
  .row-threshold {
    font-size: 12px;
    color: #8a93a3;
  }
  .row-screen {
    grid-column: 2;
    grid-row: 1 / 3;
    padding: 5px 8px;
    background: #05060a;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.75), inset 0 0 0 1px rgba(79, 227, 193, 0.07);
  }
  .row-screen .odometer { font-size: clamp(19px, 4.6vw, 25px); }
  .row-detail {
    grid-column: 1;
    margin: 4px 0 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: #9aa3b2;
  }

  @media (prefers-reduced-motion: reduce) {
    .digit.flicker, .odometer.scanning .digit { animation: none; }
  }

  @media (max-width: 480px) {
    .row { grid-template-columns: 1fr; row-gap: 8px; padding-top: 20px; }
    .row-screen { grid-column: 1; grid-row: auto; justify-self: start; }
  }

  /* ---- the info dialog ------------------------------------------------------ */

  .info-intro { margin: 0 0 14px; }
  /* The rows/cells here are appended by the info-button script (dialog.rowsEl
     is built from `content.rows`, not written in this template), so every
     rule that must reach them is `:global` — the same set:html trap as the
     odometer digits above. */
  .info-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .info-table.empty { display: none; }
  :global(.info-table td) {
    padding: 7px 4px 7px 10px;
    border-top: 1px solid var(--paper3);
    border-left: 3px solid color-mix(in oklab, #d4302e calc(var(--tier, 0) * 20%), #6fae2e);
    vertical-align: top;
  }
  :global(.info-range) { white-space: nowrap; font-weight: 700; color: var(--ink); padding-right: 12px !important; }
  :global(.info-effect) { color: var(--ink2); line-height: 1.4; }
  .info-source { margin: 14px 0 0; font-size: 13px; color: var(--ink2); }
  .info-source a { color: var(--t-cobalt); }

  /* ---- footer ---------------------------------------------------------------- */

  .foot {
