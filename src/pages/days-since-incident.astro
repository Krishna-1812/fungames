---
import GameShell from '../layouts/GameShell.astro'
import { iconSvg } from '../lib/icons'
import { EARTHQUAKE_CATEGORIES, FLARE_CATEGORIES, STORM_CATEGORIES, SHOCK_CATEGORIES } from '../lib/incident-model'
import { digitCellHTML } from '../lib/seven-segment'

/**
 * Days Since Incident — the workplace "days since last accident" sign,
 * except the incidents are real and every counter is live.
 *
 * The model (`lib/incident-model.ts`) and the loader (`lib/incident-fetch.ts`)
 * do all the real work; this page is a thin, honest client for them. Every
 * feed is read straight from the visitor's own browser at USGS and NASA — no
 * backend of this site's own, and nothing here is precomputed or invented.
 * `scripts/check-incident-model.mjs` proves the pure arithmetic and parsing
 * against real captured API shapes; there is deliberately no live-network
 * checker, the same restraint every other checker on this site takes.
 *
 * The visual redo: neal.fun's own version of this page renders every count
 * as a real eight-digit car-odometer window — ghosted unlit segments and
 * all — inside a bolted black plate. That structure is worth taking
 * literally rather than approximating with a monospace font, so
 * `lib/seven-segment.ts` draws a real seven-segment digit (`check-seven-
 * segment.mjs` proves the table is genuine, not just plausible), and every
 * card here is a mounted plate: rivets, a recessed screen, real depth.
 *
 * In the shell the sign sits on paper: the plates keep their dark screens,
 * the LEDs are mint and the hazard tape cobalt. Score is the headline "safe
 * for", Feeds counts the four sources that have answered, Moves the rows
 * read, and Best is the calmest stretch you have seen. When every row has
 * been read the report is the ending — quietly, since it is a list of
 * earthquakes and solar storms.
 */

const GROUPS = [
  { id: 'quake', label: 'Earthquakes', source: 'USGS', icon: 'quake', categories: EARTHQUAKE_CATEGORIES },
  { id: 'flare', label: 'Solar Flares', source: 'NASA DONKI', icon: 'solar-flare', categories: FLARE_CATEGORIES },
  { id: 'storm', label: 'Geomagnetic Storms', source: 'NASA DONKI', icon: 'geostorm', categories: STORM_CATEGORIES },
  { id: 'shock', label: 'Interplanetary Shocks', source: 'NASA DONKI', icon: 'shock', categories: SHOCK_CATEGORIES },
] as const

const ROW_DIGITS = 5
const HERO_DAY_DIGITS = 3
const HERO_UNIT_DIGITS = 2

/** Real classification-scale content behind each group's info button — the
 *  same real, cited tables neal.fun's own info icons open, restated rather
 *  than copied, with a severity tier (0-5) driving the row's accent colour. */
type InfoRow = { range: string; effect: string; tier: 0 | 1 | 2 | 3 | 4 | 5 }
type InfoContent = { title: string; intro: string; rows: InfoRow[]; source: string; sourceUrl: string }
const INFO: Record<string, InfoContent> = {
  quake: {
    title: 'The moment magnitude scale',
    intro: 'Each whole number is roughly 32 times more energy released than the last — not a straight line.',
    rows: [
      { range: 'Under 2.5', effect: 'Usually not felt; recorded only by seismographs', tier: 0 },
      { range: '2.5 – 5.4', effect: 'Often felt; minor damage in most cases', tier: 1 },
      { range: '5.5 – 6.0', effect: 'Slight damage to buildings and structures', tier: 2 },
      { range: '6.1 – 6.9', effect: 'Can be destructive across populated areas', tier: 3 },
      { range: '7.0 – 7.9', effect: 'Major earthquake; serious damage over a wide area', tier: 4 },
      { range: '8.0 and up', effect: 'Great earthquake; serious damage hundreds of miles across', tier: 5 },
    ],
    source: 'United States Geological Survey',
    sourceUrl: 'https://www.usgs.gov/programs/earthquake-hazards/earthquake-magnitude-energy-release-and-shaking-intensity',
  },
  flare: {
    title: 'GOES X-ray flare class',
    intro: "Each letter is a tenfold jump in X-ray brightness. The bracketed R-number is NOAA's own radio-blackout severity for a flare of that class.",
    rows: [
      { range: 'A / B class', effect: 'Background level — no effect at Earth', tier: 0 },
      { range: 'C class', effect: 'Small; essentially no effect at Earth', tier: 1 },
      { range: 'M1 – M4 (R1)', effect: 'Minor HF radio degradation on the sunlit side', tier: 2 },
      { range: 'M5 – M9 (R2)', effect: 'Wide HF blackout; frequencies under 10 MHz fade', tier: 3 },
      { range: 'X1 – X9 (R3)', effect: 'Full dayside HF blackout, up to about an hour', tier: 4 },
      { range: 'X10 and up (R4–R5)', effect: 'Severe to extreme blackout across the dayside', tier: 5 },
    ],
    source: 'NOAA Space Weather Prediction Center',
    sourceUrl: 'https://www.spaceweather.gov/phenomena/solar-flares-radio-blackouts',
  },
  storm: {
    title: "NOAA's G-scale",
    intro: "Rated on the planetary Kp index — the same real-time measure of Earth's magnetic field this page's own counters are keyed to.",
    rows: [
      { range: 'G1, Kp 5', effect: 'Weak grid fluctuations; aurora reaches the far-northern US', tier: 1 },
      { range: 'G2, Kp 6', effect: 'High-latitude power grids see voltage alarms', tier: 2 },
      { range: 'G3, Kp 7', effect: 'Voltage corrections required; aurora as low as Illinois', tier: 3 },
      { range: 'G4, Kp 8', effect: 'Widespread voltage-control problems likely', tier: 4 },
      { range: 'G5, Kp 9', effect: 'Possible grid collapse — aurora reached Florida in May 2024', tier: 5 },
    ],
    source: 'NOAA Space Weather Prediction Center',
    sourceUrl: 'https://www.swpc.noaa.gov/noaa-scales-explanation',
  },
  shock: {
    title: 'Interplanetary shock',
    intro: "Not a category with levels — a shock either reached a spacecraft or it didn't. A fast coronal mass ejection drives a wave of compressed solar wind ahead of it; when that wave crosses a spacecraft near Earth, instruments record a sudden jump in solar-wind speed, density and magnetic field. It's often the first hard evidence that a geomagnetic storm is on its way, sometimes under an hour before it arrives.",
    rows: [],
    source: 'NASA DONKI (Space Weather Database Of Notifications, Knowledge, Information)',
    sourceUrl: 'https://ccmc.gsfc.nasa.gov/tools/DONKI/',
  },
}
---

<GameShell
  slug="days-since-incident"
  labels={{ score: 'Safe for', best: 'Calmest', level: 'Feeds', moves: 'Rows read' }}
  initial={{ score: '—', level: `0 / ${GROUPS.length}`, moves: `0 / ${GROUPS.reduce((n, g) => n + g.categories.length, 0)}` }}
>
  <div class="dsi">
    <div class="tape" aria-hidden="true"></div>

    <header class="head">
      <p class="lede">
        The sign from a warehouse wall, except the incidents are real. Every
        number below is read <em>right now</em> from a live feed — not a
        drill, and nobody typed it in.
      </p>
    </header>

    <section class="hero" aria-live="polite" aria-label="Time since the most recent incident of any kind">
      <i class="bolt bolt-tl" aria-hidden="true"></i><i class="bolt bolt-tr" aria-hidden="true"></i>
      <i class="bolt bolt-bl" aria-hidden="true"></i><i class="bolt bolt-br" aria-hidden="true"></i>
      <p class="hero-label"><i class="live-dot" aria-hidden="true"></i>Safe for</p>
      <div class="hero-screen">
        <div class="hero-clock">
          <div class="hero-fig">
            <span class="odometer hero-odo" data-hero="days" set:html={Array.from({ length: HERO_DAY_DIGITS }, () => digitCellHTML()).join('')} />
            <span class="hero-u">days</span>
          </div>
          <span class="hero-sep" aria-hidden="true">:</span>
          <div class="hero-fig">
            <span class="odometer hero-odo" data-hero="hours" set:html={Array.from({ length: HERO_UNIT_DIGITS }, () => digitCellHTML()).join('')} />
            <span class="hero-u">hrs</span>
          </div>
          <span class="hero-sep" aria-hidden="true">:</span>
          <div class="hero-fig">
            <span class="odometer hero-odo" data-hero="minutes" set:html={Array.from({ length: HERO_UNIT_DIGITS }, () => digitCellHTML()).join('')} />
            <span class="hero-u">min</span>
          </div>
          <span class="hero-sep" aria-hidden="true">:</span>
          <div class="hero-fig">
            <span class="odometer hero-odo" data-hero="seconds" set:html={Array.from({ length: HERO_UNIT_DIGITS }, () => digitCellHTML()).join('')} />
            <span class="hero-u">sec</span>
          </div>
        </div>
        <div class="screen-glass" aria-hidden="true"></div>
      </div>
      <p class="hero-caption" data-hero-caption>Reading the sensors&hellip;</p>
    </section>

    <div class="tape" aria-hidden="true"></div>

    <div class="groups">
      {GROUPS.map((group) => (
        <section class="group" aria-labelledby={`g-${group.id}`}>
          <h2 class="group-head" id={`g-${group.id}`}>
            <span class="group-icon" set:html={iconSvg(group.icon)} />
            {group.label}
            <button class="info-btn" type="button" data-info={group.id} aria-label={`What the ${group.label} scale means`}>i</button>
            <span class="group-source">{group.source}, live</span>
          </h2>
          <ol class="rows">
            {group.categories.map((cat) => (
              <li class="row" data-cat={cat.id} data-kind={group.id}>
                <i class="bolt bolt-tl" aria-hidden="true"></i><i class="bolt bolt-tr" aria-hidden="true"></i>
                <div class="row-top">
                  <span class="row-title">{cat.title}</span>
                  <span class="row-threshold">{cat.thresholdLabel}</span>
                </div>
                <div class="row-screen">
                  <span class="odometer" data-fig aria-hidden="true" set:html={Array.from({ length: ROW_DIGITS }, () => digitCellHTML()).join('')} />
                  <div class="screen-glass" aria-hidden="true"></div>
                </div>
                <p class="sr-only" data-sr>Reading the sensors.</p>
                <p class="row-detail" data-detail>&nbsp;</p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <footer class="foot">
      <p>
        Earthquakes are read from <a href="https://earthquake.usgs.gov/earthquakes/feed/" target="_blank" rel="noopener">USGS's</a>
        own catalogue search, one request per magnitude tier. Solar flares,
        geomagnetic storms and interplanetary shocks come from
        <a href="https://ccmc.gsfc.nasa.gov/tools/DONKI/" target="_blank" rel="noopener">NASA's DONKI</a> space-weather
        log, reduced to NOAA's own published GOES flare classes and G-scale.
        Hurricanes and tsunamis are deliberately not here: the cleanest free
        feed for them labels the identical wind speed two different things
        depending which weather agency reported it, and a category built on
        data that disagrees with itself would be worse than no row at all.
      </p>
      <p class="foot-small">
        A rare tier can take a few seconds longer than the rest — the
        difference between "no X10 flare in the last year" and "keep looking
        back until one turns up" isn't free, and this page pays it live
        rather than pretending otherwise.
      </p>
    </footer>
  </div>

  <dialog id="infoDialog" class="panel" aria-labelledby="infoTitle">
    <p class="label meta">The scale</p>
    <h2 id="infoTitle" data-info-title style="margin-top:10px"></h2>
    <div class="panel-body">
      <p class="info-intro" data-info-intro></p>
      <table class="info-table" data-info-table>
        <tbody data-info-rows></tbody>
      </table>
      <p class="info-source">Data from <a data-info-source-link target="_blank" rel="noopener"><span data-info-source></span></a>.</p>
    </div>
    <div class="panel-actions">
      <button type="button" class="pill pill--hero" data-close><span>Close</span></button>
    </div>
  </dialog>

  <script type="application/json" id="info-data" set:html={JSON.stringify(INFO)} />

  <Fragment slot="howto">
    <p>
      The "days since last accident" sign from a warehouse wall, except the
      incidents are real: earthquakes from USGS, and solar flares, geomagnetic
      storms and interplanetary shocks from NASA, read live from your browser.
    </p>
    <ul>
      <li>The big counter is time since the most recent incident of any kind. Each row below is days since the last one at that strength or worse.</li>
      <li>The <b>i</b> beside each group explains its scale.</li>
      <li>A rare tier can take a few seconds longer, while the page looks further back for one.</li>
    </ul>
    <p>When every row has been read, the report is the end. Your best is the calmest stretch you have seen.</p>
  </Fragment>
</GameShell>

<script>
  import {
    EARTHQUAKE_CATEGORIES, FLARE_CATEGORIES, STORM_CATEGORIES, SHOCK_CATEGORIES, ALL_CATEGORIES,
    mostRecentQualifying, daysSince, elapsedParts,
    type IncidentEvent, type IncidentCategory,
  } from '../lib/incident-model'
  import { loadFast, loadDeep, readCache, writeCache, type SourceResult, type DonkiKind } from '../lib/incident-fetch'
  import { segmentsFor, fitWidth, SEGMENT_KEYS } from '../lib/seven-segment'
  import { createShell } from '../lib/game-shell'
  import { PLAY } from '../lib/motion'
  import { recordPlay } from '../lib/stats'

  const rowEls = new Map(
    Array.from(document.querySelectorAll<HTMLLIElement>('.row')).map((el) => [el.dataset.cat!, el]),
  )

  /** A real seven-segment odometer, not a monospace font pretending to be
   *  one. Each `.odometer` already holds N pre-built `.digit` cells (server-
   *  rendered by `digitCellHTML()`); this only ever toggles each cell's
   *  seven `.seg` children between on/off, so a changed digit flickers
   *  exactly the way a real display does rather than the text silently
   *  becoming a different string. */
  const prefersReducedMotion = !PLAY
  function setSegDigit(cell: HTMLElement, ch: string) {
    if (cell.dataset.v === ch) return
    const changed = cell.dataset.v !== undefined
    cell.dataset.v = ch
    const lit = segmentsFor(ch)
    const segs = cell.children
    for (let i = 0; i < SEGMENT_KEYS.length; i++) segs[i]!.classList.toggle('on', lit[i])
    if (changed && !prefersReducedMotion) {
      cell.classList.remove('flicker')
      // Force a reflow so the same animation can retrigger on the next change.
      void (cell as HTMLElement).offsetWidth
      cell.classList.add('flicker')
    }
  }
  function setOdometer(container: HTMLElement, raw: string) {
    const cells = container.children
    const value = fitWidth(raw, cells.length)
    for (let i = 0; i < cells.length; i++) setSegDigit(cells[i] as HTMLElement, value[i])
  }

  type RowState = { event: IncidentEvent | null; ok: boolean; pending: boolean }
  const state = new Map<string, RowState>()
  for (const cat of ALL_CATEGORIES) state.set(cat.id, { event: null, ok: true, pending: true })

  const ALL_DASHES = '----------'
  function paintRow(cat: IncidentCategory) {
    const el = rowEls.get(cat.id)
    if (!el) return
    const fig = el.querySelector<HTMLElement>('[data-fig]')!
    const sr = el.querySelector<HTMLElement>('[data-sr]')!
    const detail = el.querySelector<HTMLElement>('[data-detail]')!
    const s = state.get(cat.id)!

    fig.classList.toggle('scanning', s.pending && !s.event)

    if (!s.ok) {
      setOdometer(fig, ALL_DASHES) // the feed itself failed
      sr.textContent = 'The feed for this row did not answer.'
      detail.textContent = 'Feed unavailable right now — try reloading in a bit.'
      return
    }
    if (s.event) {
      const days = daysSince(Date.now(), s.event.time)
      setOdometer(fig, String(days))
      sr.textContent = `${days} days.`
      detail.textContent = `Last: ${s.event.detail}, ${new Date(s.event.time).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}`
      return
    }
    if (s.pending) {
      setOdometer(fig, '')
      sr.textContent = 'Still searching further back.'
      detail.textContent = 'Nothing in the last 400 days — checking the last five years…'
    } else {
      setOdometer(fig, ALL_DASHES)
      sr.textContent = 'None found.'
      detail.textContent = 'No confirmed event in the last five years.'
    }
  }

  function applyResult(cat: IncidentCategory, event: IncidentEvent | null, ok: boolean, pending: boolean) {
    state.set(cat.id, { event, ok, pending })
    paintRow(cat)
    paintStrip()
  }

  /* ---- the shell ---------------------------------------------------------- */

  // Restart is a reload, the default: reading every feed again is exactly
  // what starting again means here.
  const shell = createShell({ slug: 'days-since-incident' })
  const GROUP_OF: Record<string, IncidentCategory[]> = {
    quake: EARTHQUAKE_CATEGORIES, flare: FLARE_CATEGORIES, storm: STORM_CATEGORIES, shock: SHOCK_CATEGORIES,
  }
  /** "3 d 4 h", "5 h 12 m", "40 s": short enough for a score tile. */
  function safeFor(ms: number) {
    const { days, hours, minutes } = elapsedParts(Date.now(), Date.now() - ms)
    if (days > 0) return `${days} d ${hours} h`
    if (hours > 0) return `${hours} h ${minutes} m`
    return minutes > 0 ? `${minutes} m` : `${Math.max(0, Math.floor(ms / 1000))} s`
  }
  /** The same span in words, for a sentence: "3 days and 4 hours", "43 minutes". */
  function inWords(ms: number) {
    const { days, hours, minutes } = elapsedParts(Date.now(), Date.now() - ms)
    const n = (v: number, u: string) => `${v} ${u}${v === 1 ? '' : 's'}`
    if (days > 0) return hours ? `${n(days, 'day')} and ${n(hours, 'hour')}` : n(days, 'day')
    if (hours > 0) return minutes ? `${n(hours, 'hour')} and ${n(minutes, 'minute')}` : n(hours, 'hour')
    return minutes > 0 ? n(minutes, 'minute') : 'under a minute'
  }
  const read = () => ALL_CATEGORIES.filter((c) => { const st = state.get(c.id)!; return !st.pending || !!st.event || !st.ok }).length
  function paintStrip() {
    shell.setLevel(`${Object.values(GROUP_OF).filter((list) => list.every((c) => { const st = state.get(c.id)!; return !st.pending || !!st.event || !st.ok })).length} / ${Object.keys(GROUP_OF).length}`)
    shell.setMoves(`${read()} / ${ALL_CATEGORIES.length}`)
  }

  let reported = false
  function maybeReport() {
    if (reported || heroPending) return
    if (ALL_CATEGORIES.some((c) => state.get(c.id)!.pending && !state.get(c.id)!.event)) return
    reported = true
    const calm = heroEvent ? Date.now() - heroEvent.time : 0
    if (heroEvent) shell.considerBest(Math.round(calm / 1000), safeFor(calm))
    // The row that has been quiet longest, for the one line worth reading.
    let quietest: { cat: IncidentCategory; days: number } | null = null
    for (const c of ALL_CATEGORIES) {
      const ev = state.get(c.id)!.event
      if (!ev) continue
      const d = daysSince(Date.now(), ev.time)
      if (!quietest || d > quietest.days) quietest = { cat: c, days: d }
    }
    recordPlay('days-since-incident', {}, {})
    shell.win({
      celebrate: false,
      // The card waits below the sign; nobody reading a row needs yanking.
      scroll: false,
      kicker: 'Every sensor read',
      title: heroEvent ? `The planet has been safe for ${inWords(calm)}.` : 'Nothing to report, for once.',
      score: heroEvent ? safeFor(calm) : '—',
      lines: [
        heroEvent ? `The last incident: ${heroEvent.detail}.` : 'No confirmed incident turned up in any feed.',
        quietest ? `Quietest row: ${quietest.cat.title}, ${quietest.days.toLocaleString('en-US')} days and counting.` : '',
      ].filter(Boolean),
      againLabel: 'Read the sensors again',
    })
  }

  /* ---- the hero: the single most recent incident of any kind -------------- */

  let heroEvent: IncidentEvent | null = null
  let heroPending = true
  function recomputeHero() {
    let best: IncidentEvent | null = null
    for (const cat of ALL_CATEGORIES) {
      const ev = state.get(cat.id)?.event
      if (ev && (!best || ev.time > best.time)) best = ev
    }
    heroEvent = best
  }
  function tickHero() {
    const capEl = document.querySelector<HTMLElement>('[data-hero-caption]')!
    if (!heroEvent) {
      capEl.textContent = heroPending ? 'Reading the sensors…' : 'No confirmed incident to report yet.'
      return
    }
    const { days, hours, minutes } = elapsedParts(Date.now(), heroEvent.time)
    const seconds = Math.floor((Date.now() - heroEvent.time) / 1000) % 60
    setOdometer(document.querySelector('[data-hero="days"]')!, String(Math.max(0, days)))
    setOdometer(document.querySelector('[data-hero="hours"]')!, String(hours).padStart(2, '0'))
    setOdometer(document.querySelector('[data-hero="minutes"]')!, String(minutes).padStart(2, '0'))
    setOdometer(document.querySelector('[data-hero="seconds"]')!, String(Math.max(0, seconds)).padStart(2, '0'))
    capEl.textContent = `Last: ${heroEvent.detail}`
    // The tile only changes once a minute, so it is fine to tell it every tick.
    shell.setScore(safeFor(Date.now() - heroEvent.time))
  }
  setInterval(tickHero, 1000)
  tickHero()

  /* ---- loading: cache, fast pass, then a background deep pass per source -- */

  const now = Date.now()
  const cached = readCache(now)

  async function run() {
    let quakes: Map<string, SourceResult>
    let flr: SourceResult
    let gst: SourceResult
    let ips: SourceResult
    const deep: Partial<Record<DonkiKind, SourceResult>> = {}

    if (cached) {
      quakes = new Map(cached.quakes)
      flr = cached.flr
      gst = cached.gst
      ips = cached.ips
      Object.assign(deep, cached.deep)
    } else {
      const fast = await loadFast(now)
      quakes = fast.quakes
      flr = fast.flr
      gst = fast.gst
      ips = fast.ips
    }

    for (const cat of EARTHQUAKE_CATEGORIES) {
      const r = quakes.get(cat.id)
      applyResult(cat, r?.events[0] ?? null, r?.ok ?? false, false)
    }

    const eventsByKind: Record<DonkiKind, IncidentEvent[]> = {
      FLR: [...flr.events, ...(deep.FLR?.events ?? [])],
      GST: [...gst.events, ...(deep.GST?.events ?? [])],
      IPS: [...ips.events, ...(deep.IPS?.events ?? [])],
    }
    const okByKind: Record<DonkiKind, boolean> = { FLR: flr.ok, GST: gst.ok, IPS: ips.ok }

    function paintKind(kind: DonkiKind, pending: boolean) {
      const list = { FLR: FLARE_CATEGORIES, GST: STORM_CATEGORIES, IPS: SHOCK_CATEGORIES }[kind]
      for (const cat of list) {
        const found = mostRecentQualifying(eventsByKind[kind], cat)
        applyResult(cat, found, okByKind[kind], pending && !found)
      }
    }

    paintKind('FLR', !cached)
    paintKind('GST', !cached)
    paintKind('IPS', !cached)
    recomputeHero()
    heroPending = false
    tickHero()
    maybeReport()

    if (!cached) {
      writeCache({ quakes: Array.from(quakes.entries()), flr, gst, ips, deep }, now)
    }

    // A background pass, per source, only for a kind that still has an
    // unresolved tier — the rare-tier cost from the file header, paid once.
    for (const kind of ['FLR', 'GST', 'IPS'] as const) {
      const list = { FLR: FLARE_CATEGORIES, GST: STORM_CATEGORIES, IPS: SHOCK_CATEGORIES }[kind]
      const unresolved = okByKind[kind] && list.some((c) => !mostRecentQualifying(eventsByKind[kind], c))
      if (!unresolved || deep[kind]) continue
      const deeper = await loadDeep(kind, now)
      deep[kind] = deeper
      eventsByKind[kind] = eventsByKind[kind].concat(deeper.events)
      okByKind[kind] = okByKind[kind] && deeper.ok
      paintKind(kind, false)
      recomputeHero()
      tickHero()
      writeCache({ quakes: Array.from(quakes.entries()), flr, gst, ips, deep }, now)
      maybeReport()
    }
  }

  run()

  /* ---- the info dialog: one real classification scale per group ----------- */

  type InfoRow = { range: string; effect: string; tier: 0 | 1 | 2 | 3 | 4 | 5 }
  type InfoContent = { title: string; intro: string; rows: InfoRow[]; source: string; sourceUrl: string }
  const INFO: Record<string, InfoContent> = JSON.parse(document.getElementById('info-data')!.textContent!)

  const dialog = document.getElementById('infoDialog') as HTMLDialogElement
  const titleEl = dialog.querySelector<HTMLElement>('[data-info-title]')!
  const introEl = dialog.querySelector<HTMLElement>('[data-info-intro]')!
  const tableEl = dialog.querySelector<HTMLElement>('[data-info-table]')!
  const rowsEl = dialog.querySelector<HTMLElement>('[data-info-rows]')!
  const sourceEl = dialog.querySelector<HTMLElement>('[data-info-source]')!
  const sourceLinkEl = dialog.querySelector<HTMLAnchorElement>('[data-info-source-link]')!

  document.querySelectorAll<HTMLButtonElement>('[data-info]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = INFO[btn.dataset.info!]
      if (!content) return
      titleEl.textContent = content.title
      introEl.textContent = content.intro
      sourceEl.textContent = content.source
      sourceLinkEl.href = content.sourceUrl
      rowsEl.innerHTML = ''
      tableEl.classList.toggle('empty', content.rows.length === 0)
      for (const row of content.rows) {
        const tr = document.createElement('tr')
        tr.style.setProperty('--tier', String(row.tier))
        tr.innerHTML = `<td class="info-range">${row.range}</td><td class="info-effect">${row.effect}</td>`
        rowsEl.append(tr)
      }
      dialog.showModal()
    })
  })
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close())
  // Not the shell's own panel, so P for pause should not fire while it is open.
  // A click on the ::backdrop lands on the <dialog> element itself (its box
  // is exactly the panel), so this only fires for a genuine outside click.
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close() })
</script>

<style>
  /* The sign sits on paper. The plates keep their dark screens — they are
     the picture — and the page around them is the design system's. */
  .dsi { max-width: 780px; margin: 0 auto; }

  .tape {
    height: 13px;
    margin: 0 0 22px;
    border-radius: 3px;
    background: repeating-linear-gradient(45deg, var(--cobalt) 0 10px, var(--ink) 10px 20px);
