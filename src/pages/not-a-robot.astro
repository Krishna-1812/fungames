  .w-mine { stroke: #ffd166; }
  .slider { width: min(300px, 100%); --sl-a: #7ba4e8; --sl-b: #2f588c; --sl-track: #dfe3ea; }
  .tonebtns { display: flex; gap: 8px; }

  /* --- hands ---------------------------------------------------------------- */

  /* Image tiles, like the street's, with the same four-pixel gutters. */
  .hands { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px; }
  .handbtn {
    position: relative; background: #fff; border: 0; padding: 0; overflow: hidden;
    cursor: pointer; line-height: 0;
  }
