  .rc-flash[hidden] { display: none; }
  .rc-flash svg { width: 62px; height: 62px; }
  .rc-flash.in { animation: rc-flash 620ms var(--ease); }
  @keyframes rc-flash { from { opacity: 0; } 70% { opacity: 1; } to { opacity: 0.96; } }

  /* --- the anchor ------------------------------------------------------- */

  /* Real measurements. 300 by 74 with a 28px box is the object everybody has
     clicked a thousand times, and it stops looking like it the moment any one
     of those numbers is rounded to something tidier. */
  .anchor {
    width: 300px; max-width: 100%; height: 74px; box-sizing: border-box;
    display: flex; align-items: center;
    background: #f9f9f9; border: 1px solid var(--rc-line); border-radius: 3px;
    font-family: var(--rc-font); color: #000;
