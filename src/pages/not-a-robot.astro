          ev.suffering = chosen.size
          api.pass(`Suffering in ${chosen.size} of 9 squares. Recorded.`)
        })
      },
    },

    /* 8 ------------------------------------------------------------- */
    {
      head: {
        lead: 'Select the image showing',
        target: 'a human hand',
        tail: 'One of these has the right number of parts',
      },
      mount(host, api) {
        // Two by two, which is the other shape a real image challenge comes in,
