  /* --- hold still ---------------------------------------------------------- */

  .hold { display: grid; justify-items: center; gap: 8px; padding: 6px 0; }
  .target {
    width: 148px; height: 148px; border: 0; background: none; padding: 0;
    color: var(--rc-blue-d); cursor: pointer; touch-action: none;
  }
