        const OPTIONS = hands().sort(() => Math.random() - 0.5)
        host.innerHTML = `<div class="hands" role="group" aria-label="Four pictures of a hand">${
          OPTIONS.map((o, i) =>
            `<button type="button" class="handbtn" data-i="${i}">
               <svg viewBox="0 0 120 140" aria-hidden="true">${o.svg}</svg>
