    border-radius: 14px; overflow: hidden; position: relative;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35), 0 26px 60px rgba(0, 0, 0, 0.45);
    /* The frame heats up as the checks get less reasonable, driven off the step
       index rather than a timer so it tracks how far in you are. It runs the
       long way round the wheel — blue, violet, magenta, red — because the short
       way passes through green, and a green banner reads as reassurance. */
    border-top: 5px solid hsl(calc(218 + var(--heat, 0) * 13) 62% 52%);
    transition: border-color 500ms var(--ease);
  }
  .box[data-heat="6"], .box[data-heat="7"] { --heat: 4; }
  .box[data-heat="8"], .box[data-heat="9"] { --heat: 7; }
  .box[data-heat="10"] { --heat: 9; }
  .box[data-heat="11"] { --heat: 11; }

