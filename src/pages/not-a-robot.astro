  .host::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(120% 90% at 50% 34%, rgba(12, 14, 20, 0.6), rgba(8, 9, 13, 0.9));
  }

  /* --- layout ----------------------------------------------------------- */

  .wrap {
    position: relative; z-index: 1;
    max-width: 1000px; margin: 0 auto; padding: 34px 18px 56px;
    display: grid; grid-template-columns: minmax(0, 1fr) 208px; gap: 26px;
    align-items: start; justify-items: center;
  }
  .column { display: grid; justify-items: center; gap: 14px; width: 100%; }
  .scene-src { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* --- the challenge ---------------------------------------------------- */

  .rc {
    width: min(412px, 100%);
    background: #fff; color: #000; font-family: var(--rc-font);
    border-radius: 3px; overflow: hidden; position: relative;
    /* The real one's shadow is almost nothing. Over a dimmed page it does not
       need to be more than that, and a soft halo underneath does the lifting. */
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.3), 0 22px 56px rgba(0, 0, 0, 0.55);
