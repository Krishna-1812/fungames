---
import GameShell from '../layouts/GameShell.astro'
import { PATTERNS } from '../lib/dark-patterns'
import { withBase } from '../lib/base'

/**
 * Dark Patterns — eleven manipulative UI tricks, reproduced as working fake
 * websites rather than described in a bullet list.
 *
 * Every one is a documented pattern, not an invented vibe — see
 * src/lib/dark-patterns.ts for the citation attached to each — and every
 * fake site is built the way that kind of site is really built, because a
 * trick only works on you when the place it lives in looks real: a homeware
 * shop with a bag that slides in from the right, a coffee blog with an
 * article to read and a newsletter modal over it, a streaming service's dark
 * account page, a download portal fenced in by adverts, a ticket site, a
 * software checkout, a settings screen, a social network's welcome wizard, a
 * fashion store's product page with its sales pop-ups, a newspaper. Each has
 * its own type, colour, voice and furniture, and they all open in one
 * browser window — tab, address bar, padlock, load bar — whose address and
 * title move as you go deeper into a site. The products in the shops are
 * photographed (scripts/shop-bake/, baked in the Auction studio's white
 * room), not drawn.
 *
 * The pattern's name is not shown until you have acted: "Confirmshaming"
 * over the confirmshaming modal would be a spoiler for the only thing it
 * tests. Score is how many you dodged, Site is progress through the eleven,
 * Moves are the ones you fell for, Best is your best run.
 *
 * `resolve('dodged' | 'fell', note)` is the whole verdict, and it is never
 * hidden behind a puzzle — every pattern can be beaten the first time by
 * anyone who looks closely, the same way the real ones can.
 */
const total = PATTERNS.length
const img = withBase('/dark-patterns/')
---

<GameShell
  slug="dark-patterns"
  labels={{ score: 'Dodged', best: 'Best run', level: 'Site', moves: 'Fell for' }}
  initial={{ score: '0', level: `0 / ${total}`, moves: '0' }}
>
  <div class="dpx" data-img={img}>
    <div class="dp-intro" id="intro">
      <p class="label meta">Eleven websites · one lesson</p>
      <h2 class="dp-intro-title">Every one of these sites wants <em class="wonk">something</em> from you.</h2>
      <p class="lead">
        Each is built around a trick the people who study this for a living have
        catalogued and named. Do the ordinary errand each site gives you. Look
        closely. Some are genuinely hard to beat.
      </p>
      <button type="button" class="pill pill--hero" id="begin">
        <span>Open the first site</span><span class="arrow" aria-hidden="true">→</span>
      </button>
      <ul class="dp-domains" aria-label="The eleven sites">
        {PATTERNS.map((p) => <li class="tag">{p.site}</li>)}
      </ul>
    </div>

    <div class="dp-play" id="play" hidden>
      <div class="bx" id="window">
        <div class="bx-tabs" aria-hidden="true">
          <div class="bx-tab"><i class="bx-fav" id="bxFav">F</i><span id="tabTitle">New tab</span>
            <svg viewBox="0 0 16 16" width="14" height="14"><path d="M4.5 4.5l7 7m0-7l-7 7" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg></div>
          <span class="bx-plus"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
          <span class="bx-win">
            <i><svg viewBox="0 0 12 12" width="11" height="11"><path d="M1 6h10" stroke="currentColor"/></svg></i>
            <i><svg viewBox="0 0 12 12" width="11" height="11"><rect x="1.5" y="1.5" width="9" height="9" stroke="currentColor" fill="none"/></svg></i>
            <i><svg viewBox="0 0 12 12" width="11" height="11"><path d="M1.5 1.5l9 9m0-9l-9 9" stroke="currentColor"/></svg></i>
          </span>
        </div>
        <div class="bx-bar">
          <span class="bx-ico" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18"><path d="M16 10H4.5m5-5.5L4 10l5.5 5.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="bx-ico is-off" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11.5m-5-5.5L16 10l-5.5 5.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="bx-ico bx-reload" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18"><path d="M15.5 10a5.5 5.5 0 1 1-1.6-3.9M15.5 3.5v3.2h-3.2" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <div class="bx-omni">
            <svg class="bx-lock" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 5h6m3 0h1M3 11h1m3 0h6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="10.5" cy="5" r="1.6" stroke="currentColor" stroke-width="1.3" fill="none"/><circle cx="5.5" cy="11" r="1.6" stroke="currentColor" stroke-width="1.3" fill="none"/></svg>
            <span class="bx-url"><span class="sr-only">Address: </span><b id="host">example.com</b><span id="path"></span></span>
            <svg class="bx-star" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M10 3l2.1 4.4 4.8.6-3.5 3.3.9 4.8L10 13.8 5.7 16.1l.9-4.8L3.1 8l4.8-.6z" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linejoin="round"/></svg>
          </div>
          <span class="bx-me" aria-hidden="true"><i></i><svg viewBox="0 0 4 16" width="4" height="16"><circle cx="2" cy="3" r="1.4"/><circle cx="2" cy="8" r="1.4"/><circle cx="2" cy="13" r="1.4"/></svg></span>
          <i class="bx-load" id="load" aria-hidden="true"></i>
        </div>
        <div class="bx-view">
          <div class="bx-scroll" id="scroll" tabindex="-1" aria-label="The website"><div id="slot"></div></div>
          <div class="bx-layer" id="layer"></div>
        </div>
      </div>

      <div class="dp-notes">
        <div class="dp-brief">
          <p class="label meta" id="siteNo">Site 1 of {total}</p>
          <p class="label dp-errand-lbl">Your errand</p>
          <p class="dp-errand" id="lede">—</p>
          <ol class="dp-tally" id="tally" aria-label="Your record so far">
            {PATTERNS.map(() => <li><span class="sr-only">Not yet</span></li>)}
          </ol>
        </div>

        <div class="dp-verdict" id="verdict" hidden tabindex="-1">
          <p class="label dp-v-head"><span class="dp-v-sign" id="vSign" aria-hidden="true">✓</span><span id="vHead">You spotted it</span></p>
          <h3 class="dp-v-title" id="vTitle">Pattern</h3>
          <p class="dp-v-note" id="vNote"></p>
          <p class="dp-v-reveal" id="vReveal"></p>
          <p class="dp-v-cite" id="vCite"></p>
          <div class="dp-v-crowd" id="vCrowd" aria-live="polite"></div>
          <button type="button" class="pill pill--ink" id="next">
            <span id="nextLbl">Next site</span><span aria-hidden="true">→</span>
          </button>
          <p class="dp-keys"><kbd>N</kbd> or <kbd>Enter</kbd></p>
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="howto">
    <p>
      Eleven fake websites, one at a time, each in its own browser tab. Each
      gives you an ordinary errand — buy a thing, cancel a thing, change a
      setting. Each is built around a real, catalogued manipulation.
    </p>
    <ul>
      <li><b>The trick is usually the loudest button.</b> The honest way through is usually small, plain text.</li>
      <li>Read every sentence twice, especially checkboxes and totals. Sometimes the right answer is to wait.</li>
      <li>The sites scroll, like real ones. After each you will see what the trick was called and who named it.</li>
    </ul>
    <p>Dodge as many as you can. Your best is your highest number dodged.</p>
  </Fragment>

  <details class="dp-real" slot="after">
    <summary class="label">Where these come from</summary>
    <p>
      Nothing here is randomised against you and nothing is a puzzle with a
      trick answer — every pattern can be beaten the first time by looking
      closely at the same two things every time: which option is loud and
      which one is quiet, and what a sentence actually says once you read it
      twice. That is also exactly how the real ones work.
    </p>
    <p>
      The names are not this site's invention. Most come from Harry
      Brignull's original 2010 list — he coined the term "dark pattern"
      cataloguing exactly these — and the newer ones from a 2019 Princeton/CHI
      study that scraped eleven thousand shopping sites looking for them, or
      the FTC's 2022 report to Congress on the same subject. The eleven
      companies here are invented; the shop's products were modelled and
      photographed for this page.
    </p>
    <p>Related: <a href={withBase('/not-a-robot/')}>I'm Not a Robot</a> is the other page here built out of real interface conventions rather than a metaphor for them.</p>
  </details>
</GameShell>

<script type="application/json" id="game-data" set:html={JSON.stringify(PATTERNS)} />

<script>
  import { createShell } from '../lib/game-shell'
  import { sfx, unlock } from '../lib/audio'
  import { recordPlay } from '../lib/stats'
  import { dailyFor, dailyTarget } from '../data/game-meta'
  import { loadCrowd, fillCrowd, share, people, FEW } from '../lib/crowd'

  type Pattern = { id: string; title: string; site: string; real: string; lede: string; reveal: string }
  const PATTERNS = JSON.parse(document.getElementById('game-data')!.textContent!) as Pattern[]
  const TOTAL = PATTERNS.length
  const IMG = (document.querySelector('.dpx') as HTMLElement).dataset.img!

  const $ = (id: string) => document.getElementById(id)!
  const intro = $('intro'), play = $('play')
  const win = $('window'), scroller = $('scroll'), slot = $('slot'), layer = $('layer')
  const verdict = $('verdict')
  const tally = [...$('tally').children] as HTMLLIElement[]

  /** Each site's tab: its title, its favicon (background, letter colour,
   *  letter) and the path it opens on. */
  type Tab = { title: string; fav: [string, string, string]; path: string }
  const TABS: Record<string, Tab> = {
    basket: { title: 'Fenwick & Oates — Three things, made well', fav: ['#1d1f22', '#f1efe9', 'F'], path: '/' },
    confirmshame: { title: 'Why your morning coffee tastes flat · The Daily Brew', fav: ['#1f4d4a', '#ffffff', 'D'], path: '/brewing/flat-coffee' },
    roach: { title: 'Account · Chorus+', fav: ['#0e1015', '#9d8cff', '+'], path: '/account' },
    urgency: { title: 'Auralis Q7 Headphones, 60% off today | GET IT NOW', fav: ['#d8102b', '#ffffff', 'G'], path: '/deal/auralis-q7' },
    ads: { title: 'Download PhotoTrim 4 for Windows — Free — Freeware Depot', fav: ['#2456a8', '#ffffff', 'F'], path: '/windows/photo-design/phototrim' },
    drip: { title: 'The Weather Station · The Assembly Rooms | ticketloop', fav: ['#16112e', '#c9bdff', 't'], path: '/event/the-weather-station' },
    continuity: { title: 'Start your free trial · Loomline', fav: ['#0f766e', '#ffffff', 'L'], path: '/checkout/pro' },
    trick: { title: 'Privacy & data · Account settings', fav: ['#111827', '#ffffff', 'A'], path: '/settings/privacy' },
    zuckering: { title: 'Welcome to frennet', fav: ['#1d6ff2', '#ffffff', 'f'], path: '/welcome' },
    social: { title: 'The Weekender — NIMBUS', fav: ['#111111', '#ffffff', 'N'], path: '/products/the-weekender' },
    nagging: { title: 'Markets open higher as rates hold | The Daily Briefing', fav: ['#111111', '#ffffff', 'B'], path: '/business/markets-open-higher' },
  }

  type Outcome = 'dodged' | 'fell'
  type Api = {
    resolve: (outcome: Outcome, note: string) => void
    /** An interval that stops while the game is paused and dies with the site. */
    every: (fn: () => void, ms: number) => void
    /** A timeout that dies with the site. */
    later: (fn: () => void, ms: number) => void
    /** A small knock — a new wall arriving, not a wrong answer. */
    knock: () => void
    /** A new page on the same site: the address, the tab and the load bar. */
    go: (path: string, title?: string) => void
    /** Over the page and not scrolled with it: modals, drawers, pop-ups. */
    layer: HTMLElement
    img: (name: string, small?: boolean) => string
  }
  type Mount = (host: HTMLElement, api: Api) => void
  type Result = { id: string; title: string; real: string; outcome: Outcome; note: string }

  let results: Result[] = []
  let idx = -1
  let resolved = false
  let shownAt = 0
  let timers: number[] = []
  let outs: number[] = []
  const clearTimers = () => { timers.forEach(clearInterval); outs.forEach(clearTimeout); timers = []; outs = [] }

  const shell = createShell({ slug: 'dark-patterns', onRestart: restart })
  loadCrowd('dark-patterns')

  /* ---------------------------------------------------------------------- */
  /* Shared furniture                                                        */
  /* ---------------------------------------------------------------------- */

  const on = (root: HTMLElement, sel: string, fn: (e: Event) => void) =>
    root.querySelector(sel)!.addEventListener('click', fn)

  /** A site's footer: its own columns and its own small print. */
  const footer = (k: string, cols: string[][], small: string) => `
    <footer class="${k}-foot sx-foot">
      <div class="sx-cols">${cols.map((c) => `<ul><li><b>${c[0]}</b></li>${c.slice(1).map((x) => `<li>${x}</li>`).join('')}</ul>`).join('')}</div>
      <p class="sx-small">${small}</p>
    </footer>`

  const ICON = {
    bag: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 7h12l-1 10H5zM7 7V5.5a3 3 0 0 1 6 0V7" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/></svg>',
    search: '<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
    user: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="7" r="3.2" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M3.5 17c1.2-3.2 3.6-4.6 6.5-4.6s5.3 1.4 6.5 4.6" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg>',
    close: '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8m0-8l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
    check: '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    bell: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/></svg>',
    down: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3v10m-4.5-4.5L10 13l4.5-4.5M4 16.5h12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  }

  /** Review stars, drawn: n filled of five. */
  const stars = (n: number) => `<span class="sx-stars" aria-hidden="true">${[0, 1, 2, 3, 4].map((k) => `<svg viewBox="0 0 20 20" width="14" height="14"><path d="M10 1.8l2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.7l-5.1 2.8 1.1-5.7-4.3-4 5.8-.7z" fill="${k < n ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>`).join('')}</span>`

  /** A seeded scatter, so a drawing comes out the same every time. */
  const seeded = (s: number) => () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646

  /** The gig's poster: a stage in haze, three beams, the crowd's heads and
   *  hands in silhouette against it. */
  function stageArt() {
    const r = seeded(7)
    let crowd = ''
    for (let i = 0; i < 46; i++) {
      const x = i * 13.4 + r() * 8 - 4, y = 196 + r() * 16, s = 7 + r() * 4
      crowd += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${s.toFixed(1)}"/><rect x="${(x - s * 1.5).toFixed(1)}" y="${(y + s * 0.6).toFixed(1)}" width="${(s * 3).toFixed(1)}" height="40" rx="${s.toFixed(1)}"/>`
      if (r() < 0.22) { const hx = x + (r() - 0.5) * 10; crowd += `<path d="M${x.toFixed(1)} ${(y + 6).toFixed(1)} L${hx.toFixed(1)} ${(y - 30 - r() * 14).toFixed(1)}" stroke-width="5" stroke-linecap="round"/>` }
    }
    return `<svg class="tl-svg" viewBox="0 0 600 240" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <radialGradient id="tlHaze" cx="50%" cy="38%" r="60%"><stop offset="0" stop-color="#8f6bff" stop-opacity=".55"/><stop offset=".55" stop-color="#3a2a8a" stop-opacity=".35"/><stop offset="1" stop-color="#0b0820" stop-opacity="0"/></radialGradient>
        <linearGradient id="tlBeam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e7e0ff" stop-opacity=".75"/><stop offset="1" stop-color="#7b5cff" stop-opacity="0"/></linearGradient>
      </defs>
      <rect width="600" height="240" fill="#0b0820"/>
      <rect width="600" height="240" fill="url(#tlHaze)"/>
      <path d="M300 0 L210 240 L390 240Z" fill="url(#tlBeam)" opacity=".5"/>
      <path d="M120 0 L40 240 L190 240Z" fill="url(#tlBeam)" opacity=".35"/>
      <path d="M480 0 L410 240 L560 240Z" fill="url(#tlBeam)" opacity=".35"/>
      <rect x="0" y="150" width="600" height="6" fill="#1b1540"/>
      <g fill="#05040d" stroke="#05040d">${crowd}</g>
    </svg>`
  }

  /** The markets story's chart: an index line through the first hour. */
  function chartArt() {
    const r = seeded(11)
    let v = 60, pts = ''
    for (let i = 0; i <= 60; i++) { v += (r() - 0.42) * 6; pts += `${(i * 10).toFixed(0)},${(150 - v).toFixed(1)} ` }
    return `<svg viewBox="0 0 600 170" aria-hidden="true">
      <g stroke="#e3e3e3" stroke-width="1">${[30, 70, 110, 150].map((y) => `<path d="M0 ${y}H600"/>`).join('')}</g>
      <g fill="#767676" font-family="Arial, sans-serif" font-size="11">${['9:30', '9:45', '10:00', '10:15', '10:30'].map((t, i) => `<text x="${i * 145 + 4}" y="166">${t}</text>`).join('')}</g>
      <polyline points="${pts}" fill="none" stroke="#0b6b4f" stroke-width="2.4" stroke-linejoin="round"/>
    </svg>`
  }

  /* ---------------------------------------------------------------------- */
  /* The eleven sites                                                        */
  /* ---------------------------------------------------------------------- */

  const MOUNTS: Record<string, Mount> = {
    basket(host, api) {
      const items = [
        { name: 'Leather notebook', maker: 'Bound in Leicester', price: 28, img: 'notebook' },
        { name: 'Reading lamp', maker: 'Spun in Sheffield', price: 44, img: 'lamp' },
        { name: 'Ceramic mug', maker: 'Thrown in Stoke', price: 14, img: 'mug' },
      ]
      host.innerHTML = `
        <p class="fo-ann">Free delivery over $60 · Thirty-day returns</p>
        <header class="fo-head">
          <nav class="fo-nav"><span>Shop</span><span>Home</span><span>Kitchen</span><span>Journal</span></nav>
          <p class="fo-logo">Fenwick <i>&amp;</i> Oates</p>
          <nav class="fo-tools">${ICON.search}${ICON.user}<span class="fo-bag">${ICON.bag}<b id="bagN">0</b></span></nav>
        </header>
        <section class="fo-hero">
          <p class="fo-eyebrow">New this week</p>
          <h1>Three things, made well.</h1>
          <p>Small runs from workshops we know by name.</p>
        </section>
        <div class="fo-grid">${items.map((it, k) => `
          <article class="fo-card">
            <div class="fo-img"><img src="${api.img(it.img, true)}" alt="${it.name}" width="600" height="600"></div>
            <div class="fo-meta"><h3>${it.name}</h3><p>${it.maker}</p><b>$${it.price}</b></div>
            <button type="button" class="fo-add" data-k="${k}">Add to bag</button>
          </article>`).join('')}
        </div>
        <section class="fo-story"><h2>Made to be used, then used again.</h2><p>We work with eleven workshops, none more than a day’s drive from our warehouse. Everything is made in small batches, so when it’s gone, it’s gone for a few weeks.</p></section>
        ${footer('fo', [['Shop', 'New this week', 'Home', 'Kitchen', 'Gift cards'], ['Help', 'Delivery', 'Returns', 'Contact us'], ['Fenwick & Oates', 'Our workshops', 'Journal', 'Stockists']], '© Fenwick &amp; Oates Ltd. Prices include sales tax.')}`
      host.querySelectorAll<HTMLButtonElement>('.fo-add').forEach((btn) =>
        btn.addEventListener('click', () => {
          sfx.tick()
          const it = items[Number(btn.dataset.k)]
          host.querySelector('#bagN')!.textContent = '1'
          btn.textContent = 'Added'
          api.layer.innerHTML = `
            <div class="fo-scrim"></div>
            <aside class="fo-drawer" role="dialog" aria-label="Your bag">
              <header><h2>Your bag</h2><span>1 item</span></header>
              <div class="fo-line"><img src="${api.img(it.img, true)}" alt=""><div><b>${it.name}</b><span>${it.maker} · Qty 1</span></div><b>$${it.price.toFixed(2)}</b></div>
              <label class="fo-addon"><input type="checkbox" checked class="extra" data-p="4.99"><span><b>Fenwick Care</b> Two years’ cover for accidents</span><em>$4.99</em></label>
              <label class="fo-addon"><input type="checkbox" checked class="extra" data-p="2.99"><span><b>Fenwick Rewards</b> Members’ prices, renews monthly</span><em>$2.99</em></label>
              <div class="fo-sum"><span>Subtotal</span><b id="total"></b></div>
              <p class="fo-small">Delivery and taxes calculated at checkout.</p>
              <button type="button" class="fo-checkout" id="checkout">Check out</button>
              <p class="fo-small fo-pay">Secure checkout · Visa · Mastercard · Amex</p>
            </aside>`
          api.knock()
          const paint = () => {
            const extra = [...api.layer.querySelectorAll<HTMLInputElement>('.extra:checked')].reduce((n, x) => n + Number(x.dataset.p), 0)
            const t = `$${(it.price + extra).toFixed(2)}`
            api.layer.querySelector('#total')!.textContent = t
            api.layer.querySelector('#checkout')!.textContent = `Check out · ${t}`
          }
          api.layer.querySelectorAll('.extra').forEach((x) => x.addEventListener('change', () => { sfx.tick(); paint() }))
          paint()
          on(api.layer, '#checkout', () => {
            const extras = api.layer.querySelectorAll<HTMLInputElement>('.extra:checked').length
            if (extras === 0) api.resolve('dodged', 'You unticked both extras before paying for anything you never chose.')
            else api.resolve('fell', `You paid for ${extras} thing${extras > 1 ? 's' : ''} that rode along with your actual order.`)
          })
        }),
      )
    },

    confirmshame(host, api) {
      host.innerHTML = `
        <header class="db-head"><p class="db-logo">The Daily Brew</p><nav><span>Brewing</span><span>Beans</span><span>Gear</span><span>Shop</span></nav></header>
        <article class="db-post">
          <p class="db-cat">Brewing · 6 min read</p>
          <h1>Why your morning coffee tastes flat</h1>
          <p class="db-by"><i class="db-av">ME</i><span><b>Mara Ellison</b> · 14 March</span></p>
          <figure class="db-fig"><img src="${api.img('mug')}" alt="A stoneware mug on a white table"><figcaption>Your mug is not the problem. Probably.</figcaption></figure>
          <p class="db-lede">It is almost never the beans. A cup that tastes of nothing in particular — not bitter, not sour, just beige — is usually telling you about the three things that happen after the bag is opened: how long ago, how hot the water was, and how fine you ground it.</p>
          <h2>Stale is a matter of days</h2>
          <p>Roasted coffee gives up most of its aroma within a fortnight of the bag being opened. Buy smaller bags, fold the top down tight, and keep them out of the fridge, where every opening of the door condenses a little water onto the beans.</p>
          <h2>Water just off the boil</h2>
          <p>Somewhere between 92 and 96 degrees pulls out the sweetness without the harshness. With no thermometer, let the kettle sit for thirty seconds after it clicks off.</p>
          <p>And grind finer than you think. Flat coffee is very often under-extracted coffee: water that ran past the grounds too quickly to take anything with it.</p>
        </article>
