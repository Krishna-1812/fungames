  .dp-errand-lbl { margin-top: 6px; }
  .dp-errand { font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 600; font-size: var(--fs-h3); line-height: 1.05; letter-spacing: -0.02em; }
  .dp-tally { list-style: none; margin: 8px 0 4px; padding: 0; display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); gap: 4px; }
  .dp-tally li { position: relative; aspect-ratio: 1; max-width: 30px; border-radius: 8px; background: var(--paper2); display: grid; place-items: center; }
  .dp-tally li::after { content: attr(data-sign); font: 800 13px/1 var(--sans); color: var(--ink); }
  .dp-tally li.is-dodged { background: var(--sky); }
  .dp-tally li.is-fell { background: var(--red); }
  .dp-tally li.is-now { background: var(--card); box-shadow: inset 0 0 0 2px var(--ink); }

  .dp-verdict { display: grid; gap: 10px; justify-items: start; padding: 22px; border-radius: var(--r-lg); color: var(--ink); box-shadow: var(--shadow-block); outline: none; }
