  .dp-verdict.is-fell { background: var(--red); }
  .dp-v-head { display: flex; align-items: center; gap: 8px; }
  .dp-v-sign { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); color: var(--ink-paper); font-size: 13px; }
  .dp-v-title { font-size: var(--fs-h3); }
  .dp-v-note { font-weight: 700; }
  .dp-v-reveal { font-size: 15px; line-height: 1.5; }
  .dp-v-cite { font-size: 13px; font-weight: 600; }
  .dp-verdict .pill { margin-top: 6px; }
  .dp-keys { font-size: 13px; }
  .dp-keys kbd, .dp-real kbd {
