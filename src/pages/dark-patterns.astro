  .dp-big { font-size: 24px; letter-spacing: -0.03em; }
  .dp-row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 2px; border-bottom: 1.5px solid var(--paper3); font-size: 15px; }
  .dp-total { display: flex; justify-content: space-between; gap: 12px; padding: 12px 2px 4px; border-top: 2px solid var(--ink); font-size: 18px; font-weight: 800; }

  /* Sneak into Basket */
  .dp-products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 620px) { .dp-products { grid-template-columns: minmax(0, 1fr); } }
  .dp-product { display: grid; gap: 6px; align-content: start; padding: 16px; border-radius: var(--r); background: var(--paper2); }
  .dp-product .dp-price { color: var(--ink2); font-weight: 600; }
  .dp-product .dp-trap { margin-top: 8px; min-height: 46px; padding: 0 18px; font-size: 14px; }

  /* The faux page behind a modal: grey text lines, nothing to read. */
  .dp-behind { display: grid; gap: 10px; opacity: 0.5; }
  .dp-behind i { display: block; height: 10px; border-radius: 5px; background: var(--paper3); }
  .dp-behind i.short { width: 62%; }
  .dp-modal, .dp-prompt {
    position: relative; z-index: 1;
    margin-top: -64px;
    display: grid; gap: 10px;
    padding: 22px; border: 2px solid var(--ink); border-radius: var(--r-lg);
    background: var(--card); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.16);
  }
  .dp-prompt { max-width: 360px; margin-top: -100px; padding: 18px; border-radius: var(--r); }
  .dp-modal-q { font-family: var(--display); font-variation-settings: var(--display-axes); font-weight: 600; font-size: clamp(20px, 2vw, 26px); line-height: 1.1; letter-spacing: -0.02em; max-width: 26ch; }
  .dp-stall { display: grid; gap: 10px; }

  /* False Urgency */
  .dp-deal { font-size: 18px; }
  .dp-deal s { color: var(--ink3); }
  .dp-deal b { font-size: 40px; letter-spacing: -0.04em; }
  .dp-clock-line { font-size: 16px; font-weight: 600; }
  .dp-clock { display: inline-block; min-width: 3.4em; font-size: 26px; letter-spacing: -0.02em; }
  .dp-clock.is-reset { color: var(--t-red); }

  /* Disguised Ads */
  .dp-dlgrid { display: grid; gap: 10px; }
  .dp-decoy, .dp-real-dl { display: grid; justify-items: center; gap: 3px; width: 100%; padding: 12px 20px; }
  .dp-decoy { justify-self: stretch; }
  .dp-decoy[data-c='cobalt'] { background: var(--cobalt); }
  .dp-decoy[data-c='lilac'] { background: var(--lilac); }
  .dp-decoy[data-c='sky'] { background: var(--sky); }
  .dp-decoy small, .dp-real-dl small { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .dp-real-dl {
    min-height: 48px; border: 1.5px dashed var(--ink3); border-radius: var(--r);
    background: transparent; color: var(--ink2); font: 600 14px/1.2 var(--sans); cursor: pointer;
  }
  .dp-real-dl small { color: var(--ink3); }
  .dp-real-dl:hover { border-style: solid; color: var(--ink); }

  /* Forced Continuity */
  .dp-field input {
    width: 100%; height: 48px; padding: 0 16px; border-radius: var(--r);
    border: 1.5px solid var(--paper3); background: var(--card); font-size: 15px;
  }
  .dp-field input:focus { border-color: var(--ink); outline: none; }
  .dp-fine { margin: -6px 0; }

  /* Privacy Zuckering */
  .dp-trap.is-big { justify-self: stretch; min-height: 72px; font-size: 17px; }

  /* Fake Social Proof */
  .dp-toasts { display: grid; gap: 8px; min-height: 96px; align-content: start; }
  .dp-toast { padding: 10px 14px; border-radius: var(--r); border: 1.5px solid var(--ink); background: var(--card); font-size: 13px; font-weight: 500; box-shadow: var(--shadow-block); }

