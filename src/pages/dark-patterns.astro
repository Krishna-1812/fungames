  }

  /* ---- the verdict table, inside the ink result card ----------------- */
  .dp-sheet { width: 100%; border-collapse: collapse; font-size: 15px; }
  .dp-sheet caption { text-align: left; padding-bottom: 10px; }
  .dp-sheet th, .dp-sheet td { text-align: left; padding: 10px 8px; border-bottom: 1px solid rgba(246, 244, 240, 0.22); vertical-align: top; }
  .dp-sheet thead th { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .dp-sheet tbody th { font-weight: 600; }
  .dp-sheet td:last-child { color: var(--ink-paper); opacity: 0.8; font-size: 13.5px; }
  .dp-sheet tr.is-dodged td:nth-child(2) { color: var(--sky); font-weight: 700; white-space: nowrap; }
  .dp-sheet tr.is-fell td:nth-child(2) { color: var(--red); font-weight: 700; white-space: nowrap; }
  @media (max-width: 560px) { .dp-sheet td:last-child, .dp-sheet thead th:last-child { display: none; } }

  .dp-real { margin-top: 16px; padding: 20px 24px; border-radius: var(--r-lg); background: var(--card); box-shadow: var(--shadow-block); }
  .dp-real summary { cursor: pointer; }
  .dp-real p { margin-top: 12px; max-width: 64ch; color: var(--ink2); }
  .dp-real a { color: var(--t-blue); font-weight: 600; }

  /* ---- motion: armed only under html.play ---------------------------- */
  html.play .dp-trap { transition: transform var(--t-fast) var(--spring); animation: dp-breathe 2.6s var(--ease-io) infinite; }
  html.play .dp-trap:hover { transform: translateY(-2px) scale(1.02); animation-play-state: paused; }
  html.play .dp-trap:active { transform: scale(0.97); }
  /* A real "act now" button is never quite still either. Subtle on purpose:
     the joke is that this barely registers. */
  @keyframes dp-breathe { 50% { transform: scale(1.03); } }

  html.play .dp-load.is-loading { animation: dp-load 700ms var(--glide) both; }
  @keyframes dp-load { 0% { opacity: 1; transform: scaleX(0); } 70% { opacity: 1; transform: scaleX(1); } 100% { opacity: 0; transform: scaleX(1); } }
  html.play .dp-site.is-loading { animation: dp-wipe 620ms var(--glide) both; }
  @keyframes dp-wipe { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  html.play .dp-site.is-knock .dp-body > * { animation: dp-knock 380ms var(--spring) both; }
  @keyframes dp-knock { from { opacity: 0; transform: translateY(10px) scale(0.98); } }
  html.play .dp-toast { animation: dp-knock 300ms var(--spring) both; }
  html.play .dp-verdict:not([hidden]) { animation: dp-settle 620ms var(--spring) both; }
  @keyframes dp-settle { from { transform: scale(0.94); border-radius: 48px; } }
</style>
