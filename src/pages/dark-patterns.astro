          toasts.innerHTML = `<div class="nb-toast"><img src="${api.img('duffel', true)}" alt=""><p><b>${names[count % names.length]}</b> just bought <i>The Weekender</i><small>${ICON.check}2 minutes ago</small></p></div>`
          sfx.tick()
          if (count >= 6)
            api.resolve('dodged', `You watched ${count} of them cycle through the same three names and the same three cities, always “2 minutes ago”.`)
        }, 1300)
      }, 900)
    },

    nagging(host, api) {
      let asks = 0
      const MAX = 3
      const today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
      host.innerHTML = `
        <header class="br-mast"><p class="br-date">${today}</p><p class="br-logo">The Daily Briefing</p>
          <nav><span>World</span><span>Business</span><span class="is-on">Markets</span><span>Politics</span><span>Science</span><span>Culture</span><span>Opinion</span></nav></header>
        <article class="br-art">
          <p class="br-kick">Markets</p>
          <h1>Markets open higher as rates hold</h1>
          <p class="br-deck">Shares rose in early trading after the central bank left its benchmark rate unchanged for a third meeting in a row.</p>
          <p class="br-by">By Tomas Okafor · 8:42 am</p>
          <figure class="br-fig">${chartArt()}<figcaption>The index through the first hour of trading.</figcaption></figure>
          <p>Stocks climbed at the open on Friday, extending a week of gains, as investors read the decision as a sign that the next move in rates is more likely to be down than up.</p>
          <p>Banks and housebuilders led the rise. Bond yields slipped, and the currency was little changed against the dollar.</p>
          <p>“Nobody expected a cut this month,” one fund manager said. “What the market wanted was not to be surprised, and it wasn’t.”</p>
        </article>
        ${footer('br', [['The Daily Briefing', 'Subscribe', 'Newsletters', 'Corrections']], '© The Daily Briefing')}`
      const render = () => {
        asks++
        const last = asks > MAX
        api.layer.innerHTML = `
          <div class="br-ask" role="dialog" aria-label="Notifications">
            <i class="br-bell">${ICON.bell}</i>
            <div><b>Never miss a story</b><p>Turn on notifications for breaking news from The Daily Briefing.</p>
              <div class="br-acts"><button type="button" class="br-yes" id="allow">Turn on</button><button type="button" class="br-no" id="not">${last ? 'Never ask again' : 'Not now'}</button></div></div>
          </div>`
        if (asks > 1) sfx.whoosh()
        on(api.layer, '#allow', () => api.resolve('fell', last
          ? `You said no ${MAX} times, and said yes the moment it finally offered to stop asking.`
          : `You gave in on ask number ${asks}.`))
        on(api.layer, '#not', () => {
          if (last) api.resolve('dodged', `You said no ${MAX + 1} times in a row rather than give in.`)
          else { sfx.tick(); api.layer.innerHTML = ''; api.later(render, 1100) }
        })
      }
      api.later(render, 900)
    },
  }

  /* ---------------------------------------------------------------------- */
  /* Runner                                                                  */
  /* ---------------------------------------------------------------------- */

  const dodgedCount = () => results.filter((r) => r.outcome === 'dodged').length

  function paintStrip() {
    shell.setScore(String(dodgedCount()))
    shell.setMoves(String(results.length - dodgedCount()))
    shell.setLevel(`${Math.max(0, idx + 1)} / ${TOTAL}`)
  }

  function paintTally() {
    tally.forEach((li, k) => {
      const r = results[k]
      li.className = r ? (r.outcome === 'dodged' ? 'is-dodged' : 'is-fell') : k === idx ? 'is-now' : ''
      li.dataset.sign = r ? (r.outcome === 'dodged' ? '✓' : '✗') : ''
      li.firstElementChild!.textContent = r
        ? `Site ${k + 1}: ${r.outcome === 'dodged' ? 'dodged' : 'fell for it'}`
        : k === idx ? `Site ${k + 1}: now` : `Site ${k + 1}: not yet`
    })
  }

  function loadBar() {
    const el = $('load')
    el.classList.remove('is-loading')
    void el.offsetWidth
    el.classList.add('is-loading')
  }

  const api: Api = {
    layer,
    img: (name, small) => `${IMG}${name}${small ? '-s' : ''}.webp`,
    resolve(outcome, note) {
      if (resolved) return
      resolved = true
      clearTimers()
      slot.inert = true
      layer.inert = true
      const p = PATTERNS[idx]
      results.push({ id: p.id, title: p.title, real: p.real, outcome, note })
      shell.pick('Fell for each pattern', outcome === 'fell', p.title)
      shell.pick('Seconds to decide, per pattern', Math.round((performance.now() - shownAt) / 1000), p.title)
      const good = outcome === 'dodged'
      verdict.className = 'dp-verdict ' + (good ? 'is-dodged' : 'is-fell')
      $('vSign').textContent = good ? '✓' : '✗'
      $('vHead').textContent = good ? 'You spotted it' : 'You fell for it'
      $('vTitle').textContent = p.title
      $('vNote').textContent = note
      $('vReveal').textContent = p.reveal
      $('vCite').textContent = `Catalogued in ${p.real}`
      // Everyone else on this same site: how many of them it caught.
      fillCrowd($('vCrowd'), 'dark-patterns', (c) => {
        const s = share(c, 'Fell for each pattern', p.title, true)
        if (!s) return FEW
        const fellPct = s.pct, n = people(s.n)
        if (good) return fellPct >= 50 ? `<b>${fellPct}%</b> of ${n} players fell for this one. You didn’t.` : `<b>${100 - fellPct}%</b> of ${n} players spotted it too.`
        return fellPct >= 50 ? `You’re in good company: <b>${fellPct}%</b> of ${n} players fell for it too.` : `Only <b>${fellPct}%</b> of ${n} players fell for this one.`
      })
      $('nextLbl').textContent = idx + 1 >= TOTAL ? 'See how you did' : 'Next site'
      verdict.hidden = false
      win.classList.add('is-done')
      if (good) { sfx.good(); shell.pop(verdict) }
      else { sfx.bad(); shell.shake(win) }
      shell.announce(`${good ? 'You spotted it' : 'You fell for it'}: ${p.title}.`)
      paintStrip()
      paintTally()
      verdict.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      ;($('next') as HTMLButtonElement).focus({ preventScroll: true })
    },
    every(fn, ms) {
      timers.push(window.setInterval(() => { if (!shell.paused && !resolved) fn() }, ms))
    },
    later(fn, ms) {
      // Paused time does not count: wait it out, then run.
      const run = () => { if (resolved) return; if (shell.paused) outs.push(window.setTimeout(run, 250)); else fn() }
      outs.push(window.setTimeout(run, ms))
    },
    knock() {
      for (const el of [slot, layer]) {
        el.classList.remove('is-knock')
        void el.offsetWidth
        el.classList.add('is-knock')
      }
    },
    go(path, title) {
      $('path').textContent = path === '/' ? '' : path
      if (title) $('tabTitle').textContent = title
      scroller.scrollTop = 0
      loadBar()
    },
  }

  function show(i: number) {
    clearTimers()
    if (i >= TOTAL) return finish()
    idx = i
    resolved = false
    const p = PATTERNS[i]
    const tab = TABS[p.id]
    $('host').textContent = p.site
    $('path').textContent = tab.path === '/' ? '' : tab.path
    $('tabTitle').textContent = tab.title
    const fav = $('bxFav')
    fav.textContent = tab.fav[2]
    fav.style.background = tab.fav[0]
    fav.style.color = tab.fav[1]
    $('siteNo').textContent = `Site ${i + 1} of ${TOTAL}`
    $('lede').textContent = p.lede
    verdict.hidden = true
    win.classList.remove('is-done')
    slot.inert = false
    layer.inert = false
    slot.className = 'sx s-' + p.id
    layer.className = 'bx-layer sx s-' + p.id
    slot.innerHTML = ''
    layer.innerHTML = ''
    scroller.scrollTop = 0
    // A new site: the load bar runs and the page fades up — the small tell
    // that this is a different place loading, not a relabel.
    loadBar()
    slot.classList.add('is-loading')
    MOUNTS[p.id](slot, api)
    shell.progress(i + 1)
    shownAt = performance.now()
    shell.announce(`Site ${i + 1}: ${p.site}. ${p.lede}`)
    paintStrip()
    paintTally()
    if (i === TOTAL - 1) shell.levelUp('Last one.')
    scroller.focus({ preventScroll: true })
  }

  /** The shops' photographs, fetched as the first site opens, so no
   *  product tile is ever blank when a later site loads. */
  const PHOTOS = ['notebook', 'lamp', 'mug', 'headphones', 'duffel']
  let preloaded = false
  function preload() {
    if (preloaded) return
    preloaded = true
    for (const n of PHOTOS) for (const s of [false, true]) { const im = new Image(); im.src = api.img(n, s) }
  }

  function begin() {
    preload()
    unlock()
    sfx.click()
    intro.hidden = true
    play.hidden = false
    show(0)
    shell.stage.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  function restart() {
    clearTimers()
    results = []
    paintTally()
    begin()
  }

  $('begin').addEventListener('click', begin)
  $('next').addEventListener('click', () => { sfx.click(); show(idx + 1) })

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || shell.paused) return
    const t = e.target as HTMLElement
    if (t.closest('input, textarea, select, dialog')) return
    const k = e.key.toLowerCase()
    if (!verdict.hidden && !play.hidden && (k === 'n' || (k === 'enter' && !t.closest('button, a')))) {
      e.preventDefault()
      show(idx + 1)
    } else if (!intro.hidden && k === 'enter' && !t.closest('button, a')) {
      e.preventDefault()
      begin()
    }
  })

  /* ---------------------------------------------------------------------- */
  /* The verdict                                                             */
  /* ---------------------------------------------------------------------- */

  function finish() {
    const dodged = dodgedCount()
    const fell = results.length - dodged
    shell.resultExtra.innerHTML = `
      <table class="dp-sheet">
        <caption class="label">Every site, and which way you went</caption>
        <thead><tr><th scope="col">Pattern</th><th scope="col">You</th><th scope="col">Catalogued in</th></tr></thead>
        <tbody>${results.map((r) => `
          <tr class="${r.outcome === 'dodged' ? 'is-dodged' : 'is-fell'}">
            <th scope="row">${r.title}</th>
            <td>${r.outcome === 'dodged' ? '✓ Dodged' : '✗ Fell for it'}</td>
            <td>${r.real}</td>
          </tr>`).join('')}</tbody>
      </table>`

    recordPlay('dark-patterns', { dodged, fell, total: results.length }, { dodged: 'high' })
    const beat = shell.considerBest(dodged, `${dodged} / ${TOTAL}`)
    const lines = [
      fell === 0
        ? 'Every single one — and the real versions are built by people paid to make that hard.'
        : `You fell for ${fell}. Those are exactly the ones worth re-reading below: the mechanism is named next to each.`,
    ]
    if (beat === 'beaten') lines.push('✓ That is a new personal best.')
    else if (beat === 'first') lines.push('Your first run — that is the number to beat now.')
    else if (shell.best) lines.push(`Your best run is still ${shell.best.text}.`)
    const now = new Date()
    if (dailyFor(now).slug === 'dark-patterns') {
      const need = dailyTarget.dodges(now)
      shell.daily(dodged >= need, `The target: get through ${need} or more of the ${TOTAL} sites without falling for the trick. You got through ${dodged}.`)
    }
    const ending = { kicker: `Site ${TOTAL} of ${TOTAL} · the verdict`, score: `${dodged} / ${TOTAL}`, from: `0 / ${TOTAL}`, lines, againLabel: 'Run it again' }
    if (dodged === TOTAL) shell.win({ ...ending, title: 'You saw through every one.' })
    else if (dodged > fell) shell.win({ ...ending, title: 'You saw through most of them.' })
    else shell.lose({ ...ending, title: 'The internet got you.' })
  }
</script>

<style is:global>
