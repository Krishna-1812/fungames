  .isl-pp-n { margin: -2px -4px -2px 0; padding: 1px 7px; font-size: 13px; border-radius: 999px; background: #e3e9ff; border: 2px solid #1b2340; }
  .isl-pp-new {
    position: absolute; top: -11px; right: -11px;
