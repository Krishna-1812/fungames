---
import Paper from '../layouts/Paper.astro'
import { SITE } from '../site.config'
import { listedGames, CATEGORIES } from '../data/games'
import { META, dailyFor } from '../data/game-meta'
import { withBase } from '../lib/base'
import { buildIsland } from '../lib/island/world'
import { DISTRICTS, PLACES } from '../lib/island/landmarks'
import '../styles/island.css'

/*
 * The homepage is Tiny Island: every game is a building on one illustrated
 * map, standing in the district its subject belongs to, drawn here at build
 * time (lib/island) so the picture needs no script to appear. The camera,
 * the cards that pop up and the dive into a game are lib/island/camera.ts.
 * Under the island, every game again as a card, for anyone who would rather
 * scan a list than explore.
 */
const games = listedGames().sort((a, b) => b.added.localeCompare(a.added))
const count = games.length
const island = buildIsland(games.map((g) => ({ slug: g.slug, title: g.title, blurb: g.blurb, href: withBase(`/${g.slug}/`) })))
const [vx, vy, vw, vh] = island.viewBox

const districtOf = Object.fromEntries(PLACES.map(([s, d]) => [s, d]))
const tintOf = (slug: string) => DISTRICTS.find((d) => d.key === districtOf[slug])?.tint ?? '#e3e9ff'
const CHIP: Record<string, string> = { science: 'Real science', you: 'Measures you', money: 'Money', fun: 'Just because' }

// Each card frames its building by its footprint and its body, not by
// everything it draws: a lighthouse beam or a space elevator's cable would
// shrink the building to a speck.
const frame = (slug: string) => {
  const a = island.anchors[slug]
  const pts = a.foot.split(' ').map((p) => p.split(',').map(Number))
  const fx0 = Math.min(...pts.map((p) => p[0])), fx1 = Math.max(...pts.map((p) => p[0])), fy1 = Math.max(...pts.map((p) => p[1]))
  const footW = fx1 - fx0
  const top = Math.max(a.y0, fy1 - footW * 1.25)
  let h = Math.max(footW * 0.95, (fy1 - top) * 1.16)
  let w = (h * 4) / 3
  if (w < footW * 1.2) { w = footW * 1.2; h = (w * 3) / 4 }
  const cx = (fx0 + fx1) / 2, bottom = fy1 + h * 0.08
  return `${(cx - w / 2).toFixed(1)} ${(bottom - h).toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`
}

const daily = dailyFor(new Date())
const info = Object.fromEntries(games.map((g) => [g.slug, { slug: g.slug, title: g.title, blurb: g.blurb, href: withBase(`/${g.slug}/`), tint: tintOf(g.slug) }]))
const data = { bounds: island.viewBox, anchors: island.anchors, games: info, slugs: games.map((g) => g.slug) }
---

<Paper
  title={`${SITE.name} — ${count} small games on one tiny island`}
  description={SITE.description}
  image={withBase('/og-home.png')}
  bodyClass="home-isle"
  masthead={false}
  colophon={false}
  themeColor="#8ccbff"
  fonts={['Fredoka:wght@400..700', 'Silkscreen']}
  paperFonts={false}
>
  <main id="main">
    <section class="isl" aria-label={`Tiny Island: ${count} games, each one a building`}>
      <div class="isl-box" id="islBox" tabindex="0">
        <div class="isl-stage" id="islStage">
          <div class="isle isl-world" id="isle" style={`--vx:${vx}px;--vy:${vy}px;--vw:${vw}px;--vh:${vh}px`}>
            {island.layers.map((l) => <svg class={`isl-layer isl-layer--${l.kind}`} viewBox={`${vx} ${vy} ${vw} ${vh}`} xmlns="http://www.w3.org/2000/svg" aria-hidden={l.kind === 'landmark' ? undefined : 'true'} set:html={l.body} />)}
          </div>
        </div>
        <style is:inline set:html={island.css}></style>
        <div class="isl-labels" aria-hidden="true"></div>
        <div class="isl-card" hidden role="dialog" aria-live="polite">
          <p class="isl-card-title"></p>
          <p class="isl-card-blurb"></p>
          <p class="isl-card-extra" hidden></p>
          <div class="isl-card-row">
            <span class="isl-card-best" hidden></span>
            <a class="isl-card-play" href="#"><span>Play</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
        </div>
        <div class="isl-iris" aria-hidden="true"></div>

        <header class="isl-top">
          <a class="isl-logo" href={withBase('/')}><span class="isl-logo-dot" aria-hidden="true"></span>{SITE.name}</a>
          <nav class="isl-nav" aria-label="Island">
            <button type="button" class="isl-btn" id="btnToday"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="10" r="6.5" fill="currentColor" opacity=".25" /><path d="M5.5 10a6.5 6.5 0 0 1 13 0c0 3-2.4 5-4 6.5h-5C7.9 15 5.5 13 5.5 10zM9.5 16.5 10.5 20h3l1-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><span>Today</span></button>
            <button type="button" class="isl-btn isl-btn--hot" id="btnSurprise"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="9" cy="9" r="1.6" fill="currentColor" /><circle cx="15" cy="15" r="1.6" fill="currentColor" /><circle cx="15" cy="9" r="1.6" fill="currentColor" /><circle cx="9" cy="15" r="1.6" fill="currentColor" /></svg><span>Surprise me</span></button>
          </nav>
        </header>

        <p class="isl-hint"><span class="isl-hint-long">Drag to explore · click any building to play</span><span class="isl-hint-short">Drag · pinch · tap a building</span></p>

        <div class="isl-zoom" role="group" aria-label="Zoom">
          <button type="button" id="zIn" aria-label="Zoom in">+</button>
          <button type="button" id="zOut" aria-label="Zoom out">−</button>
          <button type="button" id="zHome" aria-label="Show the whole island"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5 10 4l7 5.5M5.5 8v8h9V8" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" /></svg></button>
        </div>
        <div class="isl-mini" aria-hidden="true">
          <svg viewBox={`${vx} ${vy} ${vw} ${vh}`} preserveAspectRatio="xMidYMid meet"><path d={island.mini} fill="#4fe3c1" /><rect class="isl-mini-view" x="0" y="0" width="0" height="0" rx="14" /></svg>
        </div>
        <a class="isl-down" href="#games"><span>All {count} games</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
    </section>

    <section class="gs" id="games" aria-labelledby="games-title">
      <div class="gs-wrap">
        <div class="gs-head">
          <h2 id="games-title">All {count} games</h2>
          <div class="gs-tools">
            <div class="gs-chips" role="group" aria-label="Filter games">
              <button type="button" class="gs-chip" data-filter="all" aria-pressed="true">All</button>
              {CATEGORIES.map((c) => <button type="button" class="gs-chip" data-filter={c.key} aria-pressed="false">{CHIP[c.key]}</button>)}
            </div>
            <label class="gs-search">
              <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
              <span class="sr-only">Search games</span>
              <input type="search" id="q" autocomplete="off" spellcheck="false" placeholder="Search" />
            </label>
          </div>
        </div>

        <ul class="gs-grid" role="list" id="grid">
          {games.map((g) => {
            const a = island.anchors[g.slug]
            return (
              <li class="gcard-slot gs-slot" data-slug={g.slug} data-cat={g.category} data-search={`${g.title} ${g.blurb} ${g.description}`.toLowerCase()}>
                <a class="gc" href={withBase(`/${g.slug}/`)} style={`--tint:${tintOf(g.slug)}`}>
                  <span class="gc-art" aria-hidden="true">
                    <svg class="isle gc-svg" viewBox={frame(g.slug)} xmlns="http://www.w3.org/2000/svg" data-art={g.slug}>
                      <polygon points={a.foot} fill="#ffffff" fill-opacity="0.75" stroke="#1b2340" stroke-opacity="0.18" stroke-width="1.5" />
                    </svg>
                  </span>
                  <span class="gc-body">
                    <span class="gc-title">{g.title}</span>
                    <span class="gc-blurb">{g.blurb}</span>
                    <span class="gc-foot">
                      <span class="gc-tag">{META[g.slug]?.difficulty ?? 'Explore'}</span>
                      <span class="gc-best" data-best={g.slug}></span>
                    </span>
                  </span>
                </a>
                <button type="button" class="gc-pin" data-pin={g.slug} aria-label={`Show ${g.title} on the island`}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 18s-5.5-5.2-5.5-9.3A5.5 5.5 0 0 1 15.5 8.7C15.5 12.8 10 18 10 18z" fill="currentColor" /><circle cx="10" cy="8.6" r="2" fill="#fff" /></svg>
                </button>
              </li>
            )
          })}
        </ul>
        <p class="gs-empty" id="empty" hidden>Nothing matches that. Try a shorter word.</p>
      </div>
    </section>

    <footer class="ft">
      <div class="gs-wrap ft-in">
        <p class="ft-name">{SITE.name}</p>
        <p class="ft-line">{count} small games, real maths, nothing to sign up for. Everything runs in your browser.</p>
      </div>
    </footer>
  </main>

  <script type="application/json" id="isl-data" set:html={JSON.stringify({ ...data, daily: daily.slug })} />
</Paper>

<script>
  import { initIsland, type GameInfo } from '../lib/island/camera'
  import { flip, PLAY } from '../lib/motion'
  import { bestKey, dailyFor } from '../data/game-meta'

  const data = JSON.parse(document.getElementById('isl-data')!.textContent!) as {
    bounds: [number, number, number, number]
    anchors: Record<string, { x0: number; y0: number; x1: number; y1: number; bx: number; by: number; district: string; slug: string }>
    games: Record<string, GameInfo>
    slugs: string[]
  }
  const svg = document.getElementById('isle')!
  const box = document.getElementById('islBox')!
  const NS = 'http://www.w3.org/2000/svg'

  /* ---- bests, from this browser ------------------------------------------ */
  const readBest = (slug: string): string | null => {
    try { const v = JSON.parse(localStorage.getItem(bestKey(slug)) ?? 'null'); return typeof v?.text === 'string' ? v.text : null } catch { return null }
  }
  for (const s of data.slugs) data.games[s].best = readBest(s)
  document.querySelectorAll<HTMLElement>('[data-best]').forEach((el) => { const b = data.games[el.dataset.best!]?.best; if (b) { el.textContent = `Best ${b}`; el.classList.add('has-best') } })

  const isle = initIsland({ box, stage: document.getElementById('islStage')!, world: svg, bounds: data.bounds, anchors: data.anchors, games: data.games })
  document.getElementById('zIn')!.addEventListener('click', isle.zoomIn)
  document.getElementById('zOut')!.addEventListener('click', isle.zoomOut)
  document.getElementById('zHome')!.addEventListener('click', isle.home)

  // A layer of our own on top, for the balloon and the flags.
  const extras = document.createElementNS(NS, 'svg')
  const [bx0, by0, bw0, bh0] = data.bounds
  extras.setAttribute('viewBox', `${bx0} ${by0} ${bw0} ${bh0}`)
  extras.setAttribute('class', 'isl-layer'); extras.setAttribute('aria-hidden', 'true')
  svg.append(extras)
  const add = (markup: string) => { const g = document.createElementNS(NS, 'g'); g.innerHTML = markup; extras.append(g); return g }

  /* ---- a flag on every building you have finished ------------------------- */
  for (const s of data.slugs) {
    if (!data.games[s].best) continue
    const a = data.anchors[s]
    const x = a.x1 - 14, y = a.y0 + 18
    add(`<g class="flag-done"><path d="M${x} ${y}v-30" stroke="#1b2340" stroke-width="2.2"/><path d="M${x} ${y - 30}l18 5l-18 6z" fill="#ff4f6e" stroke="#1b2340" stroke-width="1.6" stroke-linejoin="round" class="flutter"/></g>`)
  }

  /* ---- today's challenge: a balloon tied over the building ---------------- */
  const today = dailyFor(new Date())
  const ta = data.anchors[today.slug]
  if (ta) {
    const x = (ta.x0 + ta.x1) / 2, y = ta.y0 - 70
    add(`<g class="balloon"><path d="M${x} ${y + 44}C${x - 6} ${y + 70} ${x + 6} ${y + 80} ${x} ${ta.y0 + 10}" fill="none" stroke="#1b2340" stroke-width="1.4" stroke-dasharray="3 4"/>` +
      `<g class="bob"><path d="M${x - 26} ${y - 8}a26 28 0 1 1 52 0c0 15-11 24-17 30h-18c-6-6-17-15-17-30z" fill="#ff4f6e" stroke="#1b2340" stroke-width="2.2"/>` +
      `<path d="M${x - 8} ${y - 34}c-7 26-5 46 0 56M${x + 8} ${y - 34}c7 26 5 46 0 56" fill="none" stroke="#fff" stroke-width="5"/>` +
      `<path d="M${x - 9} ${y + 22}l3 9M${x + 9} ${y + 22}l-3 9" stroke="#1b2340" stroke-width="1.6"/>` +
      `<rect x="${x - 8}" y="${y + 30}" width="16" height="12" rx="3" fill="#b8a1ff" stroke="#1b2340" stroke-width="2"/>` +
      `<rect x="${x - 30}" y="${y - 62}" width="60" height="18" rx="9" fill="#4fe3c1" stroke="#1b2340" stroke-width="2"/>` +
      `<text x="${x}" y="${y - 49}" text-anchor="middle" font-family="Fredoka, sans-serif" font-weight="700" font-size="11" fill="#1b2340">TODAY</text></g></g>`)
  }
  document.getElementById('btnToday')!.addEventListener('click', () => {
    box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
    isle.flyToSlug(today.slug, 2.2)
    setTimeout(() => isle.showCard(today.slug, `Today: ${today.goal}`), PLAY ? 650 : 0)
  })

  /* ---- surprise me: fly to one at random and open its card ---------------- */
  let lastPick = ''
  document.getElementById('btnSurprise')!.addEventListener('click', () => {
    let s = lastPick
    while (s === lastPick) s = data.slugs[Math.floor(Math.random() * data.slugs.length)]
    lastPick = s
    box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
    isle.hideCard()
    isle.home()
    setTimeout(() => isle.flyToSlug(s, 2.4), PLAY ? 420 : 0)
    setTimeout(() => isle.showCard(s), PLAY ? 1250 : 0)
  })

  /* ---- the cards: filter, search, and "show on the island" ---------------- */
  const slots = Array.from(document.querySelectorAll<HTMLElement>('.gs-slot'))
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
  const q = document.getElementById('q') as HTMLInputElement
  const empty = document.getElementById('empty')!
  let filter = new URLSearchParams(location.search).get('c') ?? 'all'
  if (!chips.some((c) => c.dataset.filter === filter)) filter = 'all'
  const apply = () => {
    const term = q.value.trim().toLowerCase()
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)))
    const keep = new Set<string>()
    flip(slots, () => {
      for (const s of slots) {
        const ok = (filter === 'all' || s.dataset.cat === filter) && (!term || s.dataset.search!.includes(term))
        s.hidden = !ok
        if (ok) keep.add(s.dataset.slug!)
      }
      empty.hidden = keep.size > 0
    })
    // The island dims whatever the filter leaves out.
    isle.dim(filter === 'all' && !term ? null : keep)
  }
  chips.forEach((c) => c.addEventListener('click', () => { filter = c.dataset.filter!; apply() }))
  let t = 0
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(apply, 90) })
  if (filter !== 'all') apply()
  document.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach((b) => b.addEventListener('click', () => {
    const s = b.dataset.pin!
    box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
    setTimeout(() => { isle.flyToSlug(s, 2.4); isle.showCard(s) }, PLAY ? 500 : 0)
  }))

  // Each card gets its own copy of its building, made here rather than shipped
  // twice in the page, and not a <use> of the map's: a <use> would make every
  // animation on the island replay into its copy too, every frame.
  document.querySelectorAll<SVGSVGElement>('[data-art]').forEach((sv) => {
    const art = document.getElementById(`lm-${sv.dataset.art}`)
    if (!art) return
    const copy = art.cloneNode(true) as Element
    copy.removeAttribute('id'); copy.querySelectorAll('[id]').forEach((e) => e.removeAttribute('id'))
    sv.append(copy)
  })
  // The cards' buildings run only while the cards are on screen.
  const grid = document.getElementById('grid')!
  new IntersectionObserver(([e]) => grid.classList.toggle('is-paused', !e.isIntersecting), { rootMargin: '200px' }).observe(grid)

  /* ---- a few motions that need a clock rather than a keyframe ------------- */
  if (PLAY) {
    const years = document.querySelectorAll('.isle .wwa-year')
    setInterval(() => { if (svg.classList.contains('is-paused')) return; const y = String(1300 + Math.floor(Math.random() * 720)); years.forEach((el) => { el.textContent = y }) }, 2400)
    let wk = 38
    const cells = document.querySelectorAll<SVGElement>('#isle .liw-cell')
    setInterval(() => { if (svg.classList.contains('is-paused')) return; wk = wk >= 63 ? 38 : wk + 1; cells.forEach((c) => c.setAttribute('fill', Number(c.dataset.k) < wk ? '#5fe0bf' : '#e8e1f5')) }, 900)
    const wins = Array.from(document.querySelectorAll<SVGElement>('#isle .es-win'))
    setInterval(() => { if (svg.classList.contains('is-paused')) return; wins.forEach((w) => w.classList.remove('lit')); for (let k = 0; k < 4; k++) wins[Math.floor(Math.random() * wins.length)]?.classList.add('lit') }, 800)
  }
</script>

<style>
  :global(body.home-isle) { background: #8ccbff; font-family: 'Fredoka', system-ui, sans-serif; color: #1b2340; }
  :global(.home-isle .progress-bar) { display: none; }

  /* ================= the island ================= */
  .isl { position: relative; }
  .isl-box {
    position: relative;
    height: max(560px, min(100svh, 1100px));
    overflow: hidden;
    background: #8ccbff;
    outline: none;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .isl-box.is-grabbing { cursor: grabbing; }
  .isl-box:focus-visible { box-shadow: inset 0 0 0 4px #1b2340; }
  .isl-stage { position: absolute; inset: 0; }
  .isl-world { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0; }
  :global(.isl-layer) { position: absolute; left: var(--vx); top: var(--vy); width: var(--vw); height: var(--vh); max-width: none; overflow: visible; pointer-events: none; }
  :global(.isl-layer a.lm) { pointer-events: visiblePainted; }
  :global(.isle text) { user-select: none; }
  :global(.isl-box.z-near .layer-banners) { opacity: 0; }
  :global(.isl-box .layer-banners) { transition: opacity 0.3s; }

  .isl-top {
    position: absolute;
    left: 0; right: 0; top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px clamp(14px, 3vw, 32px);
    pointer-events: none;
  }
  .isl-top > * { pointer-events: auto; }
  .isl-logo {
    display: inline-flex; align-items: center; gap: 10px;
    margin-right: auto;
    padding: 9px 16px 9px 11px;
    background: #fff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    font-weight: 700; font-size: 19px; text-decoration: none; color: #1b2340;
  }
  .isl-logo-dot { width: 20px; height: 20px; border-radius: 50%; background: #4fe3c1; border: 3px solid #1b2340; }
  .isl-nav { display: flex; gap: 10px; }
  .isl-btn, .isl-zoom button, .isl-down {
    display: inline-flex; align-items: center; gap: 8px;
    font: 700 16px 'Fredoka', system-ui, sans-serif; color: #1b2340;
    background: #fff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    padding: 9px 15px; cursor: pointer; text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.2s;
  }
  .isl-btn svg, .isl-down svg { width: 20px; height: 20px; }
  .isl-btn:hover, .isl-zoom button:hover, .isl-down:hover { background: #eef4ff; }
  .isl-btn:active, .isl-zoom button:active, .isl-down:active { transform: translateY(4px); box-shadow: 0 0 0 #1b2340; }
  .isl-btn--hot { background: #4fe3c1; }
  .isl-btn--hot:hover { background: #6debcd; }
  .isl-btn:focus-visible, .isl-zoom button:focus-visible, .isl-down:focus-visible, .isl-logo:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  .isl-hint {
    position: absolute; left: 50%; bottom: 26px; z-index: 4;
    transform: translateX(-50%);
    margin: 0; padding: 10px 18px;
    background: #1b2340; color: #fff; border-radius: 999px;
    font-weight: 600; font-size: 15px; white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.5s, transform 0.5s;
  }
  .isl-hint-short { display: none; }
  .isl-hint.is-gone { opacity: 0; transform: translateX(-50%) translateY(12px); }
  :global(html.play) .isl-hint { animation: isl-hint-in 0.8s 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards; }
  @keyframes isl-hint-in { from { opacity: 0; transform: translateX(-50%) translateY(20px); } }

  .isl-zoom { position: absolute; right: clamp(14px, 3vw, 32px); bottom: 24px; z-index: 5; display: grid; gap: 10px; }
  .isl-zoom button { width: 48px; height: 48px; padding: 0; justify-content: center; font-size: 26px; line-height: 1; }
  .isl-zoom svg { width: 20px; height: 20px; }
  .isl-mini {
    position: absolute; left: clamp(14px, 3vw, 32px); bottom: 24px; z-index: 5;
    width: 168px; height: 112px;
    background: #8ccbff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    overflow: hidden; cursor: pointer;
  }
  .isl-mini svg { width: 100%; height: 100%; display: block; }
  .isl-mini-view { fill: rgba(255, 255, 255, 0.35); stroke: #1b2340; stroke-width: 22; }
  .isl-down { position: absolute; left: 50%; bottom: 24px; z-index: 4; transform: translateX(-50%); display: none; }
  .isl-down:active { transform: translateX(-50%) translateY(4px); }

  /* The card that pops up over a building. */
  .isl-card {
    --arrow: 50%;
    position: absolute; left: 0; top: 0; z-index: 6;
    width: min(290px, calc(100% - 24px));
    padding: 16px 16px 14px;
