---
import fs from 'node:fs'
import Paper from '../layouts/Paper.astro'
import TileArt from '../components/TileArt.astro'
import { SITE } from '../site.config'
import { listedGames, CATEGORIES } from '../data/games'
import { META, SHELL_GAMES, dailyFor } from '../data/game-meta'
import { inkIcon } from '../lib/ink-icon'
import { withBase } from '../lib/base'

// Newest first. The two games already in the shared shell lead the deck,
// because they are the ones that look like the page you are on.
const games = listedGames().sort((a, b) => b.added.localeCompare(a.added))
const count = games.length
const CHIP: Record<string, string> = { science: 'Real science', you: 'Measures you', money: 'Money', fun: 'Just because' }
const catLabel = CHIP

const shellFirst = [
  ...games.filter((g) => SHELL_GAMES.has(g.slug)),
  ...games.filter((g) => !SHELL_GAMES.has(g.slug)),
]
const deck = shellFirst.slice(0, 5)
const featured = deck[0]

// Four block colours rotate by card slot; each card floods with the one two
// steps along, so the flood is always a real change of colour.
const SLOTS = ['orange', 'amber', 'sky', 'red'] as const
const DECK_BLOCKS = ['orange', 'sky', 'amber', 'red', 'orange'] as const

// A real count, read at build time rather than typed: every model on the
// site has a checker in scripts/, and check-all runs all of them.
const checks = fs.readdirSync('scripts').filter((f) => /^check-.+\.mjs$/.test(f) && f !== 'check-all.mjs').length

const daily = dailyFor(new Date())
const dailyGame = games.find((g) => g.slug === daily.slug)!
---

<Paper title={`${SITE.name} — small games, real maths`} description={SITE.description} image={withBase('/og-home.png')}>
  <main id="main" class="page-top">
    {/* ---- hero ------------------------------------------------------- */}
    <section class="wrap hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="label meta" data-decode>{count} small games · no sign-up · all in your browser</p>
        <h1 id="hero-title" class="t-hero has-marker" data-reveal="lines" data-springy>
          <span class="mask-line" style="--line:0"><span>Tiny games,</span></span>
          <span class="mask-line" style="--line:1"><span><em class="wonk">wildly</em></span></span>
          <span class="mask-line" style="--line:2"><span><span class="marker" data-draw>overthought.</span></span></span>
        </h1>
        <p class="lead">
          Rule puzzles, auctions, falling asteroids and the whole history of the
          internet — {count} of them, each built on real maths and checked
          against real answers. Nothing to install. Pick one and it starts.
        </p>
        <div class="hero-actions">
          <a class="pill pill--hero" href={withBase(`/${featured.slug}/`)} data-confetti>
            <span>Play now</span><span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="pill pill--line" href="#games"><span>Browse all {count}</span></a>
        </div>
      </div>

      <div class="deck" data-settle role="group" aria-label="Featured games">
        {deck.map((g, k) => (
          <a
            class={`deck-card b-${DECK_BLOCKS[k]}`}
            href={withBase(`/${g.slug}/`)}
            style={`--k:${k}`}
            tabindex={k === 0 ? 0 : -1}
            aria-hidden={k === 0 ? 'false' : 'true'}
            draggable="false"
          >
            <span class="label">
              <span>{SHELL_GAMES.has(g.slug) ? 'New shell' : catLabel[g.category]}</span>
              <span>{META[g.slug]?.difficulty}</span>
            </span>
            <span class="deck-art" aria-hidden="true" style={`background:linear-gradient(142deg, ${g.accent}, ${g.accent2})`}><TileArt slug={g.slug} seed={k + 2} /></span>
            <span class="deck-head">
              <span class="deck-icon" aria-hidden="true" set:html={inkIcon(META[g.slug]?.icon ?? 'die')} />
            </span>
            <h3>{g.title}</h3>
            <p>{g.blurb}</p>
          </a>
        ))}
      </div>
    </section>

    {/* ---- ticker ----------------------------------------------------- */}
    <div class="ticker" role="group" aria-label="Every game on the site">
      <div class="ticker-track">
        <div class="ticker-run">
          {games.map((g) => <span class="ticker-item">{g.title}</span>)}
        </div>
        <div class="ticker-run ticker-dup" aria-hidden="true">
          {games.map((g) => <span class="ticker-item">{g.title}</span>)}
        </div>
      </div>
    </div>

    {/* ---- directory -------------------------------------------------- */}
    <section class="wrap section" id="games" aria-labelledby="games-title">
      <div class="dir-head">
        <div>
          <p class="label meta" data-decode>The directory</p>
          <h2 id="games-title" data-reveal="lines" style="margin-top:14px">
            <span class="mask-line" style="--line:0"><span>Pick a game.</span></span>
            <span class="mask-line" style="--line:1"><span>Any <em class="wonk">game</em>.</span></span>
          </h2>
        </div>
        <p class="lead">
          Sorted by what they actually do. Two of them already live in the new
          shell — scores, bests and all — and the rest move over two at a time.
        </p>
      </div>
      <hr class="rule-line" data-reveal style="margin-top:40px" />

      <div class="dir-controls">
        <div class="chips" role="group" aria-label="Filter games">
          <button type="button" class="pill chip" data-filter="all" aria-pressed="true"><span>All</span></button>
          <button type="button" class="pill chip" data-filter="shell" aria-pressed="false"><span>New shell</span></button>
          {CATEGORIES.map((c) => (
            <button type="button" class="pill chip" data-filter={c.key} aria-pressed="false"><span>{CHIP[c.key]}</span></button>
          ))}
        </div>
        <label class="search">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6.2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13.2 13.2 18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span class="sr-only">Search games</span>
          <input type="search" id="q" autocomplete="off" spellcheck="false" placeholder="Search by name or idea" />
          <span class="count" id="count" aria-live="polite">{count} games</span>
        </label>
      </div>

      <ul class="grid" role="list" id="grid">
        {games.map((g, i) => {
          const slot = i % 4
          const meta = META[g.slug]
          const inShell = SHELL_GAMES.has(g.slug)
          return (
            <li
              class="gcard-slot"
              data-slug={g.slug}
              data-cat={g.category}
              data-shell={inShell ? '1' : '0'}
              data-search={`${g.title} ${g.blurb} ${g.description}`.toLowerCase()}
            >
              <a
                class={`gcard b-${SLOTS[slot]}`}
                href={withBase(`/${g.slug}/`)}
                style={`--flood:var(--${SLOTS[(slot + 2) % 4]}); --cover:linear-gradient(142deg, ${g.accent}, ${g.accent2})`}
              >
                <div class="gcard-art" data-reveal="wipe" aria-hidden="true">
                  <div class="wipe gcard-art-inner"><TileArt slug={g.slug} seed={i + 1} /></div>
                </div>
                <div class="gcard-row">
                  <span class="gcard-icon" aria-hidden="true" set:html={inkIcon(meta?.icon ?? 'die')} />
                  <span class={`tag${inShell ? ' is-solid' : ''}`}>{inShell ? '✓ ' : ''}{meta?.difficulty ?? 'Explore'}</span>
                </div>
                <h3>{g.title}</h3>
                <p>{g.blurb}</p>
                <div class="gcard-foot">
                  <span class="gcard-best">
                    <span class="label">Best</span>
                    <span class="num" data-best={g.slug}>—</span>
                  </span>
                  <span class="gcard-go" aria-hidden="true">→</span>
                </div>
              </a>
            </li>
          )
        })}
      </ul>
      <p class="empty" id="empty" hidden>Nothing matches that. Try a shorter word.</p>
    </section>

    {/* ---- daily challenge: the ink band, opening like a portal ------- */}
    <section class="wrap section" id="daily" aria-labelledby="daily-title">
      <div class="portal">
        <div class="portal-inner block b-ink band on-ink">
          <div>
            <p class="label" data-decode>Daily challenge</p>
            <h2 id="daily-title" data-reveal="lines">
              <span class="mask-line" style="--line:0"><span>One game.</span></span>
              <span class="mask-line" style="--line:1"><span>One <em class="wonk">day</em>.</span></span>
            </h2>
            <p class="lead" id="dailyGoal">{daily.goal}</p>
            <div class="band-actions">
              <a class="pill pill--hero" id="dailyGo" href={withBase(`/${daily.slug}/`)} data-confetti>
                <span>Take it on</span><span class="arrow" aria-hidden="true">→</span>
              </a>
              <a class="pill pill--line" href="#games"><span>Another game</span></a>
            </div>
          </div>
          <div class="band-card block b-amber">
            <p class="label">Today's game</p>
            <h3 id="dailyName">{dailyGame.title}</h3>
            <dl>
              <div><dt class="label">Your best</dt><dd><span class="num" id="dailyBest">—</span></dd></div>
              <div><dt class="label">Finished</dt><dd><span class="num" id="dailyPlays">0</span></dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    {/* ---- how it works ---------------------------------------------- */}
    <section class="wrap section" id="how" aria-labelledby="how-title">
      <p class="label meta" data-decode>How it works</p>
      <h2 id="how-title" data-reveal="lines" style="margin-top:14px">
        <span class="mask-line" style="--line:0"><span>Everything runs</span></span>
        <span class="mask-line" style="--line:1"><span><em class="wonk">here</em>, in this tab.</span></span>
      </h2>
      <div class="stats">
        <div class="stat">
          <span class="num" data-odo={String(count)}>{count}</span>
          <span class="label">Games</span>
          <p>Each one a single page, loading only the code it needs.</p>
        </div>
        <div class="stat">
          <span class="num" data-odo={String(checks)}>{checks}</span>
          <span class="label">Automated checks</span>
          <p>Every model is tested against answers somebody else already knows.</p>
        </div>
        <div class="stat">
          <span class="num" data-odo="0">0</span>
          <span class="label">Accounts needed</span>
          <p>Scores stay in this browser. Nothing is sent anywhere.</p>
        </div>
        <div class="stat">
          <span class="num" id="myPlays">0</span>
          <span class="label">Games you've finished</span>
          <p>Counted on this device, from the games that have an ending.</p>
        </div>
      </div>
    </section>

    {/* ---- closing call to action ------------------------------------ */}
    <section class="wrap section">
      <div class="block b-sky cta" data-settle>
        <div>
          <h2 data-reveal="lines">
            <span class="mask-line" style="--line:0"><span>Can't <em class="wonk">choose</em>?</span></span>
            <span class="mask-line" style="--line:1"><span>Let the page.</span></span>
          </h2>
          <p class="lead">One of {count}, picked at random. No take-backs.</p>
        </div>
        <a class="pill pill--hero" id="surprise" href={withBase(`/${games[0].slug}/`)} data-confetti>
          <span>Surprise me</span><span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <script type="application/json" id="dir-data" set:html={JSON.stringify({ slugs: games.map((g) => g.slug), daily: daily.slug })} />
</Paper>

<script>
  import { flip, roll, whenSeen, PLAY } from '../lib/motion'
  import { readAll } from '../lib/stats'
  import { bestKey, dailyFor } from '../data/game-meta'
  import { withBase } from '../lib/base'

  const data = JSON.parse(document.getElementById('dir-data')!.textContent!) as { slugs: string[] }

  /* ---- bests, read from this browser ------------------------------- */
  const readBest = (slug: string): string | null => {
    try {
      const raw = localStorage.getItem(bestKey(slug))
      if (!raw) return null
      const v = JSON.parse(raw)
      return typeof v?.text === 'string' ? v.text : null
    } catch { return null }
  }
  document.querySelectorAll<HTMLElement>('[data-best]').forEach((el) => {
    const b = readBest(el.dataset.best!)
    if (b) el.textContent = b
  })

  /* ---- directory filter, carried by FLIP --------------------------- */
  const slots = Array.from(document.querySelectorAll<HTMLElement>('.gcard-slot'))
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
  const q = document.getElementById('q') as HTMLInputElement
  const countEl = document.getElementById('count')!
  const empty = document.getElementById('empty')!
  let filter = new URLSearchParams(location.search).get('c') ?? 'all'
  if (!chips.some((c) => c.dataset.filter === filter)) filter = 'all'

  const apply = () => {
    const term = q.value.trim().toLowerCase()
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)))
    flip(slots, () => {
      let shown = 0
      for (const s of slots) {
        const byKind = filter === 'all' || (filter === 'shell' ? s.dataset.shell === '1' : s.dataset.cat === filter)
        const ok = byKind && (!term || s.dataset.search!.includes(term))
        s.hidden = !ok
        if (ok) shown++
      }
      countEl.textContent = `${shown} game${shown === 1 ? '' : 's'}`
      empty.hidden = shown > 0
    })
  }
  chips.forEach((c) => c.addEventListener('click', () => { filter = c.dataset.filter!; apply() }))
  let t = 0
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(apply, 90) })
  if (filter !== 'all') apply()

  /* ---- daily challenge, for today rather than for the build -------- */
  const d = dailyFor(new Date())
  document.getElementById('dailyGoal')!.textContent = d.goal
  document.getElementById('dailyName')!.textContent = d.title
  ;(document.getElementById('dailyGo') as HTMLAnchorElement).href = withBase(`/${d.slug}/`)
  const stats = readAll()
  const best = readBest(d.slug)
  const dailyBest = document.getElementById('dailyBest')!
  const dailyPlays = document.getElementById('dailyPlays')!
  const plays = stats.games[d.slug]?.plays ?? 0
  whenSeen(dailyBest, () => {
    if (best) roll(dailyBest, best, { from: best.replace(/\d/g, '0') })
    roll(dailyPlays, String(plays), { from: '0' })
  })

  /* ---- your finished games ----------------------------------------- */
  const total = Object.values(stats.games).reduce((n, g) => n + (g?.plays ?? 0), 0)
  const mine = document.getElementById('myPlays')!
  if (PLAY) whenSeen(mine, () => roll(mine, total.toLocaleString('en-GB'), { from: '0' }))
  else mine.textContent = total.toLocaleString('en-GB')

  /* ---- surprise me ------------------------------------------------- */
  const surprise = document.getElementById('surprise') as HTMLAnchorElement
  const pick = () => data.slugs[Math.floor(Math.random() * data.slugs.length)]
  surprise.href = withBase(`/${pick()}/`)
  surprise.addEventListener('pointerenter', () => { surprise.href = withBase(`/${pick()}/`) })
  surprise.addEventListener('click', (e) => {
    // Let the confetti land before the page goes.
    if (!PLAY || e.metaKey || e.ctrlKey || e.shiftKey) return
    e.preventDefault()
    setTimeout(() => { location.href = surprise.href }, 380)
  })
</script>
