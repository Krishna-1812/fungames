---
import fs from 'node:fs'
import Paper from '../layouts/Paper.astro'
import TileArt from '../components/TileArt.astro'
import { SITE } from '../site.config'
import { listedGames, CATEGORIES } from '../data/games'
import { META, dailyFor } from '../data/game-meta'
import { inkIcon } from '../lib/ink-icon'
import { withBase } from '../lib/base'

/*
 * The homepage is the one page that is not paper. It is a night sky: the
 * games stand in a ring you can spin, the title thickens under the pointer,
 * and everything below it glows rather than sits in a coloured block. The
 * motion is all in lib/home-fx.ts; without it (reduced motion, or no script)
 * every section below is simply its finished state.
 */

// Newest first.
const games = listedGames().sort((a, b) => b.added.localeCompare(a.added))
const count = games.length
const CHIP: Record<string, string> = { science: 'Real science', you: 'Measures you', money: 'Money', fun: 'Just because' }

const featured = games[0]
const ring = games.slice(0, 8)
const cover = (g: (typeof games)[number]) => `--cover:linear-gradient(142deg, ${g.accent}, ${g.accent2})`

// The title, split into letters here rather than in the browser, so the
// markup is final before any script runs. `i` counts through the whole
// title for the rise; `j` counts within a line for the gradient's offset.
let n = 0
const TITLE = [
  { cls: '', words: ['Tiny', 'games,'] },
  { cls: 'h-wonk', words: ['wildly'] },
  { cls: 'h-grad', words: ['overthought.'] },
].map((line) => {
  let j = 0
  return { cls: line.cls, words: line.words.map((w) => [...w].map((c) => ({ c, i: n++, j: j++ }))) }
})

// A real count, read at build time rather than typed: every model on the
// site has a checker in scripts/, and check-all runs all of them.
const checks = fs.readdirSync('scripts').filter((f) => /^check-.+\.mjs$/.test(f) && f !== 'check-all.mjs').length

// The daily game changes at midnight UTC, long after this page was built, so
// every game the week's rotation can land on is drawn here and the script
// shows today's.
const daily = dailyFor(new Date())
const dailyGame = games.find((g) => g.slug === daily.slug)!
const dailySlugs = [...new Set(Array.from({ length: 7 }, (_, i) => dailyFor(new Date(Date.now() + i * 86_400_000)).slug))]
const dailyGames = dailySlugs.map((s) => games.find((g) => g.slug === s)!).filter(Boolean)
---

<Paper
  title={`${SITE.name} — small games, real maths`}
  description={SITE.description}
  image={withBase('/og-home.png')}
  bodyClass="home-night"
  themeColor="#05070f"
  colorScheme="dark"
>
  <div class="h-glow" id="glow" aria-hidden="true"></div>
  <main id="main" class="h">
    {/* ---- hero: the night sky and the ring ---------------------------- */}
    <section class="h-hero" aria-labelledby="hero-title">
      <div class="h-aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i></div>
      <canvas class="h-sky" id="sky" aria-hidden="true"></canvas>
      <div class="h-grain" aria-hidden="true"></div>

      <div class="wrap h-hero-in">
        <div class="h-copy">
          <p class="h-pill h-in" style="--d:0ms"><span class="h-pulse" aria-hidden="true"></span>{count} small games · no sign-up · all in your browser</p>
          <h1 class="h-title" id="hero-title" aria-label="Tiny games, wildly overthought.">
            {TITLE.map((line) => (
              <span class={`h-line ${line.cls}`} aria-hidden="true">
                {line.words.map((w, wi) => (
                  <>{wi > 0 && ' '}<span class="h-word">{w.map((ch) => <span class="ch" style={`--i:${ch.i};--j:${ch.j}`}>{ch.c}</span>)}</span></>
                ))}
              </span>
            ))}
          </h1>
          <p class="h-lead h-in" style="--d:900ms">
            Rule puzzles, auctions, falling asteroids and the whole history of
            the internet: {count} of them, each built on real maths and checked
            against real answers. Nothing to install. Pick one and it starts.
          </p>
          <div class="h-actions h-in" style="--d:1050ms">
            <a class="h-btn h-btn--main h-magnet" href={withBase(`/${featured.slug}/`)}>
              <span>Play now</span><span class="h-arrow" aria-hidden="true">→</span>
            </a>
            <a class="h-btn h-btn--ghost h-magnet" href="#games"><span>Browse all {count}</span></a>
          </div>
        </div>

        <div class="h-stage-wrap h-in" style="--d:500ms">
          <div class="h-stage" id="stage" role="group" aria-label="The newest games">
            <div class="h-ring" style={`--n:${ring.length}`}>
              {ring.map((g, k) => (
                <a class="h-rc" href={withBase(`/${g.slug}/`)} style={`--k:${k}`} draggable="false" data-title={g.title} data-blurb={g.blurb}>
                  <span class="h-rc-art" style={cover(g)} aria-hidden="true"><TileArt slug={g.slug} seed={k + 2} /></span>
                  <span class="h-rc-c">{CHIP[g.category]}</span>
                  <span class="h-rc-t">{g.title}</span>
                </a>
              ))}
            </div>
          </div>
          <p class="h-cap" aria-hidden="true">
            <span class="h-cap-k">Facing you</span>
            <span class="h-cap-t" id="capTitle">{ring[0].title}</span>
            <span class="h-cap-b" id="capBlurb">{ring[0].blurb}</span>
            <span class="h-cap-hint">Drag to spin</span>
          </p>
        </div>
      </div>

      <a class="h-cue" href="#games" aria-label="Scroll to the games"><span class="h-cue-dot"></span></a>
    </section>

    {/* ---- two marquees, the second one running the other way --------- */}
    <div class="h-mq" id="marquee" aria-hidden="true">
      <div class="h-mq-row" data-dir="-1">
        <div class="h-mq-track">
          {[0, 1].map(() => games.map((g) => <span class="h-mq-item">{g.title}</span>))}
        </div>
      </div>
      <div class="h-mq-row h-mq-row--line" data-dir="1">
        <div class="h-mq-track">
          {[0, 1].map(() => [...games].reverse().map((g) => <span class="h-mq-item">{g.title}</span>))}
        </div>
      </div>
    </div>

    {/* ---- directory -------------------------------------------------- */}
    <section class="wrap h-sec" id="games" aria-labelledby="games-title">
      <div class="h-head">
        <div>
          <p class="h-kicker h-rv">The directory</p>
          <h2 class="h-h2 h-rv" id="games-title">Pick a game.<br />Any <em>game</em>.</h2>
        </div>
        <p class="h-sub h-rv">
          Sorted by what they actually do. Every one of them keeps score, and
          remembers your best on this device.
        </p>
      </div>

      <div class="h-controls h-rv">
        <div class="h-chips" role="group" aria-label="Filter games">
          <span class="h-chip-ind" aria-hidden="true"></span>
          <button type="button" class="h-chip" data-filter="all" aria-pressed="true">All</button>
          {CATEGORIES.map((c) => (
            <button type="button" class="h-chip" data-filter={c.key} aria-pressed="false">{CHIP[c.key]}</button>
          ))}
        </div>
        <label class="h-search">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6.2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13.2 13.2 18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span class="sr-only">Search games</span>
          <input type="search" id="q" autocomplete="off" spellcheck="false" placeholder="Search by name or idea" />
          <span class="h-count" id="count" aria-live="polite">{count} games</span>
        </label>
      </div>

      <ul class="h-grid" role="list" id="grid">
        {games.map((g, i) => {
          const meta = META[g.slug]
          return (
            <li
              class="gcard-slot h-slot"
              data-slug={g.slug}
              data-cat={g.category}
              data-search={`${g.title} ${g.blurb} ${g.description}`.toLowerCase()}
            >
              <a class="h-card" href={withBase(`/${g.slug}/`)}>
                <span class="h-card-art" aria-hidden="true">
                  <span class="h-card-cover" style={cover(g)}><TileArt slug={g.slug} seed={i + 1} /></span>
                </span>
                <span class="h-card-top">
                  <span class="h-card-icon" aria-hidden="true" set:html={inkIcon(meta?.icon ?? 'die')} />
                  <span class="h-tag">{meta?.difficulty ?? 'Explore'}</span>
                </span>
                <h3>{g.title}</h3>
                <p>{g.blurb}</p>
                <span class="h-card-foot">
                  <span class="h-best">
                    <span class="h-best-l">Best</span>
                    <span class="h-best-v" data-best={g.slug}>—</span>
                  </span>
                  <span class="h-go" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          )
        })}
      </ul>
      <p class="h-empty" id="empty" hidden>Nothing matches that. Try a shorter word.</p>
    </section>

    {/* ---- daily challenge: a portal ---------------------------------- */}
    <section class="wrap h-sec" id="daily" aria-labelledby="daily-title">
      <div class="h-daily">
        <div class="h-daily-copy">
          <p class="h-kicker h-rv">Daily challenge</p>
          <h2 class="h-h2 h-rv" id="daily-title">One game.<br />One <em>day</em>.</h2>
          <p class="h-sub h-rv" id="dailyGoal">{daily.goal}</p>
          <p class="h-clock h-rv">
            <span class="h-clock-l">A new one in</span>
            <span class="h-clock-v" id="dailyClock">--:--:--</span>
          </p>
          <div class="h-actions h-rv">
            <a class="h-btn h-btn--main h-magnet" id="dailyGo" href={withBase(`/${daily.slug}/`)}>
              <span>Take it on</span><span class="h-arrow" aria-hidden="true">→</span>
            </a>
            <a class="h-btn h-btn--ghost h-magnet" href="#games"><span>Another game</span></a>
          </div>
        </div>

        <div class="h-portal h-rv">
          <div class="h-portal-glow" aria-hidden="true"></div>
          <svg class="h-rings" viewBox="0 0 400 400" aria-hidden="true">
            <defs>
              <linearGradient id="h-ring-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#4fe3c1" />
                <stop offset="0.5" stop-color="#8ccbff" />
                <stop offset="1" stop-color="#b8a1ff" />
              </linearGradient>
            </defs>
            <g class="h-r h-r1"><circle cx="200" cy="200" r="192" /></g>
            <g class="h-r h-r2"><circle cx="200" cy="200" r="170" /></g>
            <g class="h-r h-r3"><circle cx="200" cy="200" r="148" /><circle class="h-moon" cx="200" cy="52" r="6" /></g>
            <g class="h-r h-r4"><circle class="h-moon h-moon--b" cx="200" cy="8" r="4.5" /><circle class="h-moon h-moon--c" cx="30" cy="290" r="3.5" /></g>
          </svg>
          <div class="h-screen">
            {dailyGames.map((g) => (
              <span class="h-screen-art" data-daily-art={g.slug} hidden={g.slug !== daily.slug} style={cover(g)} aria-hidden="true">
                <TileArt slug={g.slug} seed={3} />
              </span>
            ))}
            <span class="h-screen-shade" aria-hidden="true"></span>
            <span class="h-screen-k">Today's game</span>
            <h3 class="h-screen-t" id="dailyName">{dailyGame.title}</h3>
          </div>
          <dl class="h-daily-stats">
            <div><dt>Your best</dt><dd id="dailyBest">—</dd></div>
            <div><dt>Finished</dt><dd id="dailyPlays">0</dd></div>
          </dl>
        </div>
      </div>
    </section>

    {/* ---- how it works ---------------------------------------------- */}
    <section class="wrap h-sec" id="how" aria-labelledby="how-title">
      <p class="h-kicker h-rv">How it works</p>
      <h2 class="h-h2 h-rv" id="how-title">Everything runs<br /><em>here</em>, in this tab.</h2>
      <div class="h-stats">
        <div class="h-stat h-rv">
          <span class="h-stat-n" data-odo={String(count)}>{count}</span>
          <span class="h-stat-l">Games</span>
          <p>Each one a single page, loading only the code it needs.</p>
        </div>
        <div class="h-stat h-rv">
          <span class="h-stat-n" data-odo={String(checks)}>{checks}</span>
          <span class="h-stat-l">Automated checks</span>
          <p>Every model is tested against answers somebody else already knows.</p>
        </div>
        <div class="h-stat h-rv">
          <span class="h-stat-n" data-odo="0">0</span>
          <span class="h-stat-l">Accounts needed</span>
          <p>Scores stay in this browser. Nothing is sent anywhere.</p>
        </div>
        <div class="h-stat h-rv">
          <span class="h-stat-n" id="myPlays">0</span>
          <span class="h-stat-l">Games you've finished</span>
          <p>Counted on this device, from the games that have an ending.</p>
        </div>
      </div>
    </section>

    {/* ---- closing call to action: a slot machine --------------------- */}
    <section class="wrap h-sec h-last">
      <div class="h-luck h-rv">
        <div class="h-luck-copy">
          <h2 class="h-h2">Can't <em>choose</em>?<br />Let the page.</h2>
          <p class="h-sub">One of {count}, picked at random. No take-backs.</p>
        </div>
        <div class="h-reel" id="reel" aria-hidden="true">
          <div class="h-reel-track">
            {[0, 1, 2].map(() => games.map((g) => <span class="h-reel-row">{g.title}</span>))}
          </div>
        </div>
        <a class="h-btn h-btn--main h-magnet" id="surprise" href={withBase(`/${games[0].slug}/`)}>
          <span>Surprise me</span><span class="h-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <script type="application/json" id="dir-data" set:html={JSON.stringify({ slugs: games.map((g) => g.slug) })} />
</Paper>

<script>
  import { flip, roll, whenSeen, confetti, PLAY } from '../lib/motion'
  import { initSky, initRing, initTitle, initMarquee, initTilt, initMagnets, initGlow, initReel } from '../lib/home-fx'
  import { readAll } from '../lib/stats'
  import { bestKey, dailyFor } from '../data/game-meta'
  import { withBase } from '../lib/base'

  const data = JSON.parse(document.getElementById('dir-data')!.textContent!) as { slugs: string[] }
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T

  /* ---- the hero ----------------------------------------------------- */
  initSky($<HTMLCanvasElement>('sky'))
  initTitle(document.querySelector<HTMLElement>('.h-title')!)
  initGlow($('glow'))
  initMagnets(Array.from(document.querySelectorAll<HTMLElement>('.h-magnet')))
  const ringCards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.h-rc'))
  const capTitle = $('capTitle')
  const capBlurb = $('capBlurb')
  initRing($('stage'), (i) => {
    capTitle.textContent = ringCards[i].dataset.title!
    capBlurb.textContent = ringCards[i].dataset.blurb!
    if (PLAY) {
      capTitle.parentElement!.classList.remove('is-new')
      void capTitle.offsetWidth
      capTitle.parentElement!.classList.add('is-new')
    }
  })
  initMarquee($('marquee'))

  /* ---- reveals: headings, and the cards a column at a time --------- */
  document.querySelectorAll('.h-rv').forEach((el) => (PLAY ? whenSeen(el) : el.classList.add('is-in')))
  const slots = Array.from(document.querySelectorAll<HTMLElement>('.gcard-slot'))
  for (const s of slots) {
    s.style.setProperty('--d', `${Math.round(s.offsetLeft / Math.max(1, s.offsetWidth)) * 90}ms`)
    if (!PLAY) { s.classList.add('is-in'); continue }
    whenSeen(s)
    s.addEventListener('animationend', () => s.classList.add('is-done'), { once: true })
  }
  initTilt(Array.from(document.querySelectorAll<HTMLElement>('.h-card')))

  /* ---- bests, read from this browser ------------------------------- */
  const readBest = (slug: string): string | null => {
    try {
      const raw = localStorage.getItem(bestKey(slug))
      if (!raw) return null
      const v = JSON.parse(raw)
      return typeof v?.text === 'string' ? v.text : null
    } catch { return null }
  }
  document.querySelectorAll<HTMLElement>('[data-best]').forEach((el) => {
    const b = readBest(el.dataset.best!)
    if (b) { el.textContent = b; el.classList.add('has-best') }
  })

  /* ---- directory filter, carried by FLIP --------------------------- */
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
  const chipBox = document.querySelector<HTMLElement>('.h-chips')!
  const ind = chipBox.querySelector<HTMLElement>('.h-chip-ind')!
  const q = $<HTMLInputElement>('q')
  const countEl = $('count')
  const empty = $('empty')
  let filter = new URLSearchParams(location.search).get('c') ?? 'all'
  if (!chips.some((c) => c.dataset.filter === filter)) filter = 'all'

  // One highlight slides between the chips instead of each chip filling.
  const moveInd = () => {
    const on = chips.find((c) => c.dataset.filter === filter)!
    ind.style.transform = `translate(${on.offsetLeft}px, ${on.offsetTop}px)`
    ind.style.width = `${on.offsetWidth}px`
    ind.style.height = `${on.offsetHeight}px`
  }
  chipBox.classList.add('has-ind')
  addEventListener('resize', moveInd, { passive: true })
  document.fonts?.ready.then(moveInd)

  const apply = () => {
    const term = q.value.trim().toLowerCase()
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)))
    moveInd()
    flip(slots, () => {
      let shown = 0
      for (const s of slots) {
        const byKind = filter === 'all' || s.dataset.cat === filter
        const ok = byKind && (!term || s.dataset.search!.includes(term))
        s.hidden = !ok
        if (ok) { shown++; s.classList.add('is-in', 'is-done') }
      }
      countEl.textContent = `${shown} game${shown === 1 ? '' : 's'}`
      empty.hidden = shown > 0
    })
  }
  chips.forEach((c) => c.addEventListener('click', () => { filter = c.dataset.filter!; apply() }))
  let t = 0
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(apply, 90) })
  if (filter !== 'all') apply()
  else moveInd()

  /* ---- daily challenge, for today rather than for the build -------- */
  const d = dailyFor(new Date())
  $('dailyGoal').textContent = d.goal
  $('dailyName').textContent = d.title
  $<HTMLAnchorElement>('dailyGo').href = withBase(`/${d.slug}/`)
  document.querySelectorAll<HTMLElement>('[data-daily-art]').forEach((el) => { el.hidden = el.dataset.dailyArt !== d.slug })
  const stats = readAll()
  const best = readBest(d.slug)
  const dailyBest = $('dailyBest')
  const dailyPlays = $('dailyPlays')
  const plays = stats.games[d.slug]?.plays ?? 0
  whenSeen(dailyBest, () => {
    if (best) roll(dailyBest, best, { from: best.replace(/\d/g, '0') })
    roll(dailyPlays, String(plays), { from: '0' })
  })
  // The rotation turns over at midnight UTC.
  const clock = $('dailyClock')
  const pad = (v: number) => String(v).padStart(2, '0')
  const tickClock = () => {
    const now = new Date()
    const next = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1)
    const s = Math.max(0, Math.floor((next - now.getTime()) / 1000))
    clock.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`
  }
  tickClock()
  setInterval(tickClock, 1000)

  /* ---- your finished games ----------------------------------------- */
  const total = Object.values(stats.games).reduce((n, g) => n + (g?.plays ?? 0), 0)
  const mine = $('myPlays')
  if (PLAY) whenSeen(mine, () => roll(mine, total.toLocaleString('en-GB'), { from: '0' }))
  else mine.textContent = total.toLocaleString('en-GB')

  /* ---- surprise me: spin the reel, then go ------------------------- */
  const surprise = $<HTMLAnchorElement>('surprise')
  const reel = initReel($('reel'), data.slugs.length)
  let pick = 0
  const choose = () => {
    pick = Math.floor(Math.random() * data.slugs.length)
    surprise.href = withBase(`/${data.slugs[pick]}/`)
  }
  choose()
  surprise.addEventListener('pointerenter', choose)
  let going = false
  surprise.addEventListener('click', (e) => {
    if (!PLAY || e.metaKey || e.ctrlKey || e.shiftKey) return
    e.preventDefault()
    if (going) return
    going = true
    surprise.classList.add('is-spinning')
    reel.spinTo(pick).then(() => {
      const r = surprise.getBoundingClientRect()
      confetti(r.left + r.width / 2, r.top + r.height / 2, 60)
      setTimeout(() => { location.href = surprise.href }, 520)
    })
  })
</script>

<style is:global>
  /* The night, for the whole page: the masthead and the colophon read their
     colours from Paper's tokens, so re-inking the tokens inside them is all
     it takes to turn them dark. */
  body.home-night {
    --h-bg: #05070f;
    --h-bg2: #0a0f22;
    --h-text: #eef2ff;
    --h-dim: #a4aecb;
    --h-line: rgba(160, 180, 255, 0.13);
    background: var(--h-bg);
    color: var(--h-text);
  }
  .home-night ::selection { background: var(--mint); color: #05070f; }
  .home-night .masthead {
    --paper: rgba(5, 7, 15, 0.72);
    --paper3: rgba(160, 180, 255, 0.12);
    --ink: #eef2ff;
    --ink-paper: #05070f;
    --focus: #eef2ff;
    color: var(--ink);
  }
  .home-night .masthead.is-solid { backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); }
  .home-night .masthead .pill--ink:hover { background: var(--mint); color: #05070f; }
  .home-night .skip { background: #eef2ff; color: #05070f; }
  .home-night .colophon-wrap {
    --ink: #eef2ff;
    --card: #26306a;
    --focus: #eef2ff;
    margin-top: clamp(80px, 10vw, 150px);
  }
  .home-night .colophon.b-lilac {
    background:
      radial-gradient(90% 120% at 0% 0%, rgba(91, 130, 255, 0.28), transparent 55%),
      radial-gradient(70% 100% at 100% 100%, rgba(184, 161, 255, 0.24), transparent 60%),
      linear-gradient(180deg, #0d1330, #090d1f);
    border: 1px solid rgba(160, 180, 255, 0.16);
    box-shadow: 0 40px 80px -40px rgba(91, 130, 255, 0.4);
  }
  .home-night .colophon .label { color: var(--h-dim); }
  .home-night .colophon .wordmark {
    background: linear-gradient(100deg, #eef2ff 20%, #8ccbff 55%, #b8a1ff 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .home-night .colophon .wordmark .ch { -webkit-text-fill-color: transparent; background: inherit; -webkit-background-clip: text; background-clip: text; }
  .home-night .colophon-legal { color: var(--h-dim); }

  @property --h-ang {
    syntax: '<angle>';
