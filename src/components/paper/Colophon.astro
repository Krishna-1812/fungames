---
import { SITE } from '../../site.config'
import { withBase } from '../../lib/base'
import { CATEGORIES, listedGames } from '../../data/games'

const newest = listedGames().sort((a, b) => b.added.localeCompare(a.added)).slice(0, 4)
// The other end of the shelf from "Newest", now that every game is in the
// shell and a list of the shell ones would be a list of everything.
const oldest = listedGames().sort((a, b) => a.added.localeCompare(b.added)).slice(0, 4)

// Shape tiles: four shapes in five inks, fixed rather than random so the
// grid is the same object on every visit.
const TILES: [string, string][] = [
  ['circle', 'var(--ink)'], ['half', 'var(--card)'], ['leaf', 'var(--sky)'], ['square', 'var(--red)'],
  ['leaf', 'var(--card)'], ['square', 'var(--ink)'], ['circle', 'var(--cobalt)'], ['half', 'var(--sky)'],
]
---

<footer class="wrap colophon-wrap">
  <div class="block b-lilac colophon" data-settle>
    <div class="colophon-top">
      <p class="wordmark">{SITE.name}</p>
      <div class="shapes" aria-hidden="true">
        {TILES.map(([shape, c]) => <span class={`shape ${shape}`} style={`--c:${c}`}></span>)}
      </div>
    </div>
    <div class="colophon-body">
      <p class="tagline">Small games, real maths, nothing to sign up for.</p>
      <div>
        <p class="label">Newest</p>
        <ul>{newest.map((g) => <li><a href={withBase(`/${g.slug}/`)}>{g.title}</a></li>)}</ul>
      </div>
      <div>
        <p class="label">Oldest</p>
        <ul>{oldest.map((g) => <li><a href={withBase(`/${g.slug}/`)}>{g.title}</a></li>)}</ul>
      </div>
      <div>
        <p class="label">Browse</p>
        <ul>{CATEGORIES.map((c) => <li><a href={withBase(`/?c=${c.key}#games`)}>{c.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="colophon-legal">
      <span>{SITE.tagline}</span>
      <span>Runs in your browser. Visits are counted anonymously: <a href={withBase('/privacy/')}>privacy</a>.</span>
    </div>
  </div>
</footer>
