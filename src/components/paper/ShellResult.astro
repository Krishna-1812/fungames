---
import { withBase } from '../../lib/base'

/**
 * The shell's result card: an ink block the runtime (lib/game-shell.ts) fills
 * in when a game ends. Its own component only so GameShell can put it after
 * the stage (the usual place) or before it, for a game that is played upward.
 */
---

<section class="result on-ink" data-result hidden tabindex="-1" aria-labelledby="result-title">
  <p class="label" data-result-kicker>Finished</p>
  <h2 id="result-title" data-result-title>Well played</h2>
  <span class="num result-score" data-result-score>0</span>
  <div class="vs-verdict" data-vs hidden></div>
  <a class="qst-note" data-quest hidden href={withBase('/')}>
    <svg class="qst-seal" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2.5l4.1 3.3 5.2-.6 2 4.8 4.8 2-.6 5.2 3.3 4.1-3.3 4.1.6 5.2-4.8 2-2 4.8-5.2-.6L20 37.5l-4.1-3.3-5.2.6-2-4.8-4.8-2 .6-5.2L1.2 20l3.3-4.1-.6-5.2 4.8-2 2-4.8 5.2.6z" fill="currentColor"/><path d="M13 20.5l4.6 4.6L27.5 15" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="qst-body"><span class="label">Quest complete</span><span class="qst-name" data-quest-name></span><span class="qst-line" data-quest-line></span><span class="qst-go">See it in your passport <span aria-hidden="true">→</span></span></span>
  </a>
  <div class="result-lines" data-result-lines></div>
  <div class="dly" data-daily hidden>
    <div class="dly-head">
      <p class="label">Today’s challenge</p>
      <p class="dly-state" data-daily-state>✓ Beaten</p>
    </div>
    <p class="dly-note" data-daily-note></p>
    <div class="dly-row">
      <p class="dly-streak"><span class="num dly-n" data-daily-n>1</span><span class="dly-unit">day streak</span><span class="dly-best" data-daily-best hidden></span></p>
      <ol class="dly-cal" data-daily-cal aria-label="The last two weeks"></ol>
    </div>
    <p class="dly-why" data-daily-why></p>
    <div class="dly-foot">
      <p class="dly-next" data-daily-next></p>
      <button type="button" class="pill pill--line pill--line-paper pill--sm" data-daily-share><span>Share today’s result</span></button>
    </div>
  </div>
  <div class="result-extra" data-result-extra></div>
  <div class="result-actions">
    <button type="button" class="pill pill--hero" data-act="again">
      <span data-again-label>Try again</span><span class="arrow" aria-hidden="true">→</span>
    </button>
    <button type="button" class="pill pill--line pill--line-paper vs-btn" data-challenge hidden>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M17.5 2.5 2.5 9l5.6 2.3L10.4 17z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M17.5 2.5 8.1 11.3" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg><span>Challenge a friend</span>
    </button>
    <a class="pill pill--line pill--line-paper" href={withBase('/')}><span>Back to games</span></a>
  </div>
  <label class="vs-copy" data-vs-copy hidden><span class="label">Copy this and send it to a friend</span><textarea readonly rows="3"></textarea></label>
  <div class="nx nx--end" data-next-end hidden>
    <div class="nx-head">
      <p class="label">Up next</p>
      <a class="nx-home" data-next-home href={withBase('/')}><span>Or wander the island</span><span aria-hidden="true">→</span></a>
    </div>
    <div class="nx-row" data-next-row></div>
  </div>
</section>
