  .pp-tally { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pp-tally li { padding: 10px 12px; background: rgba(255, 255, 255, 0.8); border: 2px solid #1b2340; border-radius: 14px; box-shadow: 0 3px 0 #1b2340; }
  .pp-tally b { display: block; font-size: 28px; line-height: 1; }
  .pp-tally span { font-size: 13px; color: var(--pmute); font-weight: 600; }
  .pp-ticks { display: flex; gap: 3px; margin: 16px 0 0; }
  .pp-ticks i { flex: 1; height: 12px; border-radius: 3px; background: #dfe5f6; }
  .pp-ticks i.is-on { background: var(--ink); }
  .pp-mrz {
    margin: 16px 0 0; padding: 10px 12px; white-space: pre; overflow: hidden;
    font: 600 12.5px/1.5 ui-monospace, 'Cascadia Mono', Consolas, Menlo, monospace; letter-spacing: 0.1em; color: #3a4466;
    background: rgba(220, 229, 250, 0.7); border-radius: 10px;
  }
  .pp-reset {
    margin: 14px 0 0; padding: 0; background: none; border: 0; cursor: pointer;
    font: 600 13px 'Fredoka', system-ui, sans-serif; color: var(--pmute); text-decoration: underline; text-underline-offset: 3px;
  }
  .pp-reset:hover { color: #c4306f; }

  /* ---- the tabs down the edge of the pages ---- */
  /* Never shrinks: on a phone it scrolls sideways, and a scroller in a
     flex column is otherwise squashed to nothing by a tall page below it. */
  .pp-tabs { flex: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 16px; }
  .pp-tab {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 11px; font: 600 13.5px 'Fredoka', system-ui, sans-serif; color: #1b2340; cursor: pointer;
    background: #fff; border: 2px solid #1b2340; border-radius: 999px;
    transition: background-color 0.15s, color 0.15s, transform 0.12s;
  }
  .pp-tab:hover { transform: translateY(-1px); background: #eef2ff; }
  .pp-tab i { font-style: normal; font-size: 11.5px; font-weight: 700; color: var(--pmute); }
  .pp-tab.is-complete::before { content: '✓'; font-weight: 700; color: var(--ink); }
  .pp-tab[aria-selected='true'] { background: var(--ink, #1b2340); color: #fff; border-color: #1b2340; }
  .pp-tab[aria-selected='true'] i, .pp-tab[aria-selected='true'].is-complete::before { color: rgba(255, 255, 255, 0.85); }
  .pp-tab:focus-visible, .pp-slot:focus-visible, .pp-reset:focus-visible, .pp-close:focus-visible { outline: 3px solid #4fe3c1; outline-offset: 2px; }
  .pp-tab--you { display: none; }

  /* ---- a district's page ---- */
  .pp-sheet { position: relative; flex: 1; }
  .pp-sheet[hidden] { display: none; }
  .pp-sheet.is-turning { animation: pp-turn 0.45s cubic-bezier(0.2, 0.8, 0.3, 1); transform-origin: 0 50%; }
  @keyframes pp-turn { from { opacity: 0.15; transform: perspective(1400px) rotateY(-24deg) translateX(-10px); } }
  .pp-sheet-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 8px; margin-bottom: 14px; border-bottom: 2px solid color-mix(in srgb, var(--ink) 30%, transparent); }
  .pp-sheet-head h3 { margin: 0; font-size: 26px; font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
  .pp-sheet-head p { margin: 0; font-size: 14px; font-weight: 600; color: var(--pmute); white-space: nowrap; }
  .pp-sheet-head b { color: var(--ink); font-size: 17px; }
  .pp-note { margin: -4px 0 14px; font-size: 14px; line-height: 1.4; color: #4a5578; }
  /* The district's seal, once every game in it is stamped. */
  .pp-seal-at { --rot: -14deg; position: absolute; right: -6px; top: 40px; width: 118px; color: var(--ink); opacity: 0; pointer-events: none; z-index: 2; transform: rotate(var(--rot)); mix-blend-mode: multiply; }
  .pp-seal-at svg { display: block; width: 100%; height: auto; }
  .pp-sheet.is-complete .pp-seal-at { opacity: 0.85; }
  html.play .pp-sheet.is-complete:not([hidden]) .pp-seal-at { animation: pp-seal 0.55s 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) both; }
  @keyframes pp-seal { 0% { opacity: 0; transform: rotate(4deg) scale(2); } 100% { opacity: 0.85; transform: rotate(var(--rot)) scale(1); } }

  .pp-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 10px; }
  .pp-slot {
    position: relative; width: 100%;
    display: grid; justify-items: center; align-content: start;
    padding: 8px 4px 10px; margin: 0;
    background: none; border: 0; border-radius: 16px; cursor: pointer;
    color: var(--ink); font: inherit; text-align: center;
    transition: background-color 0.15s;
  }
  .pp-slot:hover { background: color-mix(in srgb, var(--ink) 7%, transparent); }
  .pp-stamp, .pp-ghost { grid-area: 1 / 1; width: min(100%, 132px); aspect-ratio: 1; }
  .pp-stamp { display: block; opacity: 0; transform: rotate(var(--rot)); mix-blend-mode: multiply; }
  .pp-stamp text { font-family: 'Fredoka', system-ui, sans-serif; }
  .pp-ghost {
    display: grid; place-items: center; box-sizing: border-box; padding: 26%;
    color: #c5cde4; border: 2.5px dashed #c5cde4; border-radius: 50%;
  }
  .pp-ghost svg { width: 100%; height: 100%; display: block; opacity: 0.8; }
  .pp-slot:hover .pp-ghost { color: #9aa6c8; border-color: #9aa6c8; }
  .pp-slot.is-stamped .pp-stamp { opacity: 0.93; }
  .pp-slot.is-stamped .pp-ghost { visibility: hidden; }
  .pp-name { margin-top: 6px; font-size: 14px; font-weight: 600; line-height: 1.15; color: #1b2340; }
  .pp-when { margin-top: 2px; font-size: 12px; font-weight: 500; color: var(--pmute); }
  .pp-slot:not(.is-stamped) .pp-name { color: #7d88a8; }
  .pp-slot.is-done::after {
    content: 'Finished'; position: absolute; top: 4px; right: 2px;
    padding: 2px 7px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: #fff; background: var(--ink); border: 2px solid #1b2340; border-radius: 8px; transform: rotate(7deg);
  }

  /* A new stamp lands: down hard, a little bounce, a ring of ink. */
  .pp-slot.is-landing .pp-stamp { animation: pp-land 0.5s var(--d, 0s) cubic-bezier(0.25, 0.9, 0.35, 1.25) both; }
  @keyframes pp-land {
    0% { opacity: 0; transform: rotate(calc(var(--rot) + 16deg)) scale(2.2); }
    55% { opacity: 1; transform: rotate(var(--rot)) scale(0.9); }
    100% { opacity: 0.93; transform: rotate(var(--rot)) scale(1); }
  }
  .pp-slot.is-stamped.is-landing .pp-ghost { visibility: visible; animation: pp-gone 0.12s calc(var(--d, 0s) + 0.26s) both; }
  @keyframes pp-gone { to { opacity: 0; } }
  .pp-slot.is-landing::before {
    content: ''; position: absolute; left: 50%; top: 8px; width: min(100% - 8px, 132px); aspect-ratio: 1; translate: -50% 0;
    border: 3px solid var(--ink); border-radius: 50%; opacity: 0; pointer-events: none;
    animation: pp-splash 0.6s calc(var(--d, 0s) + 0.27s) ease-out both;
  }
  @keyframes pp-splash { from { opacity: 0.55; transform: scale(0.7); } to { opacity: 0; transform: scale(1.45); } }
  .pp-slot.is-landing .pp-when { animation: pp-when 0.4s calc(var(--d, 0s) + 0.35s) both; }
  @keyframes pp-when { from { opacity: 0; transform: translateY(4px); } }

  /* ---- sightings ---- */
  .pp-sights { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .pp-sight {
    display: flex; align-items: center; gap: 10px; padding: 7px 10px;
    font-size: 14.5px; font-weight: 600; color: #7d88a8;
    background: rgba(255, 255, 255, 0.6); border: 2px dashed #c5cde4; border-radius: 12px;
  }
  .pp-sight small { margin-left: auto; font-size: 11.5px; font-weight: 500; }
  .pp-sight-mark {
    flex: none; display: grid; place-items: center; width: 24px; height: 24px;
    font-size: 13px; font-weight: 700; color: #9aa6c8; border: 2px solid #c5cde4; border-radius: 50%;
  }
  .pp-sight-mark svg { width: 16px; height: 16px; }
  .pp-sight.is-seen { color: #1b2340; background: #fff; border: 2px solid #1b2340; }
  .pp-sight.is-seen .pp-sight-mark { color: #fff; background: var(--ink); border-color: #1b2340; }
  .pp-sight.is-secret:not(.is-seen) { font-style: italic; }
  .pp-sight.is-secret.is-seen .pp-sight-mark { background: #c4306f; }

  /* ---- quests ---- */
  .pp-quests { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .pp-quest {
    display: flex; align-items: flex-start; gap: 12px; padding: 10px 12px 11px;
    background: #fff; border: 2px solid #1b2340; border-radius: 14px; box-shadow: 0 3px 0 #1b2340;
  }
  .pp-quest.is-done { background: #f1fcf8; }
  .pp-quest.is-fresh { animation: pp-quest-new 1.6s ease-in-out 2; }
  @keyframes pp-quest-new { 50% { box-shadow: 0 3px 0 #1b2340, 0 0 0 5px rgba(79, 227, 193, 0.55); } }
  .pp-q-seal {
    flex: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-top: 1px;
    font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1; letter-spacing: -0.02em; white-space: nowrap;
    border: 2.5px dashed color-mix(in srgb, var(--ink) 45%, transparent); border-radius: 50%;
  }
  .pp-q-seal small { font-size: 11px; font-weight: 600; color: var(--pmute); }
  .pp-quest.is-done .pp-q-seal { border: 2.5px solid #1b2340; background: #4fe3c1; color: #1b2340; }
  .pp-q-seal svg { width: 24px; height: 24px; }
  .pp-q-body { flex: 1; min-width: 0; display: grid; gap: 3px; }
  .pp-q-name { font-size: 16.5px; font-weight: 700; color: #1b2340; line-height: 1.15; }
  .pp-q-line { font-size: 13.5px; font-weight: 500; line-height: 1.35; color: #4a5578; }
  .pp-q-bar { display: block; height: 7px; margin-top: 4px; border-radius: 4px; background: #e3e7f3; overflow: hidden; }
  .pp-q-bar i { display: block; height: 100%; width: calc(var(--w, 0) * 100%); border-radius: 4px; background: var(--ink); }
  .pp-quest.is-done .pp-q-bar { display: none; }
  .pp-q-meta { font-size: 12.5px; font-weight: 700; color: var(--pmute); }
  .pp-quest.is-done .pp-q-meta { color: #0f7f66; }
  .pp-q-reward {
    justify-self: start; display: inline-flex; align-items: center; gap: 7px; margin-top: 4px; padding: 4px 10px 4px 5px;
    font: 700 12.5px 'Fredoka', system-ui, sans-serif; color: #1b2340;
    background: #f3f1ff; border: 2px solid #c9c1f0; border-radius: 999px;
  }
  .pp-q-reward i { width: 18px; height: 18px; border-radius: 50%; background: linear-gradient(135deg, var(--a), var(--b) 55%, var(--c)); border: 1.5px solid #1b2340; }
  button.pp-q-reward { cursor: pointer; border-color: #1b2340; background: #fff; box-shadow: 0 2px 0 #1b2340; }
  button.pp-q-reward:hover:not([disabled]) { background: #e3f3ff; }
  button.pp-q-reward[disabled] { cursor: default; box-shadow: none; background: #f1fcf8; border-color: #0f7f66; }
  /* ---- the Save page ---- */
  .pp-save { display: grid; gap: 12px; justify-items: start; margin: 4px 0 2px; }
  .pp-save[hidden], .pp-save [hidden], .pp-remind [hidden] { display: none; }
  .pp-save-use { display: grid; gap: 6px; width: 100%; margin-top: 6px; }
  .pp-save-use label, .pp-code-label, .pp-remind label { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pmute); }
  .pp-code-label { margin: 0; }
  .pp-save-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .pp-save-use .pp-save-row { width: 100%; }
  .pp-save-use input, .pp-remind select {
    min-width: 0; flex: 1 1 210px; padding: 9px 12px; font: 600 16px ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: 0.06em; color: #1b2340;
    background: #fff; border: 2px solid #1b2340; border-radius: 12px;
  }
  .pp-remind select { flex: 0 1 auto; font: 600 16px 'Fredoka', system-ui, sans-serif; letter-spacing: 0; padding: 8px 10px; }
  .pp-save-use input:focus-visible, .pp-remind select:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .pp-btn {
    padding: 8px 15px; cursor: pointer; font: 700 14.5px 'Fredoka', system-ui, sans-serif; color: #1b2340;
    background: #fff; border: 2px solid #1b2340; border-radius: 999px; box-shadow: 0 3px 0 #1b2340;
  }
  .pp-btn:hover:not([disabled]) { background: #e3f3ff; }
  .pp-btn:active:not([disabled]) { transform: translateY(3px); box-shadow: 0 0 0 #1b2340; }
  .pp-btn[disabled] { opacity: 0.6; cursor: progress; }
  .pp-btn--main { background: #4fe3c1; }
  .pp-btn--main:hover:not([disabled]) { background: #7befd4; }
  .pp-btn:focus-visible, .pp-link:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .pp-code {
    margin: -6px 0 0; padding: 10px 14px; font: 700 clamp(17px, 2.4vw, 22px) ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: 0.08em; color: #1b2340;
    background: #fff; border: 2px dashed var(--ink); border-radius: 12px; user-select: all; overflow-wrap: anywhere;
  }
  .pp-save-how, .pp-save-meta, .pp-remind-line { margin: 0; font-size: 13.5px; font-weight: 500; line-height: 1.4; color: #4a5578; }
  .pp-save-meta { font-size: 12.5px; color: var(--pmute); }
  .pp-link {
    padding: 0; background: none; border: 0; cursor: pointer;
    font: 600 13px 'Fredoka', system-ui, sans-serif; color: var(--pmute); text-decoration: underline; text-underline-offset: 3px;
  }
  .pp-link:hover { color: var(--ink); }
  .pp-link--warn:hover { color: #c4306f; }
  .pp-save-small { gap: 6px 18px; }
  .pp-save-msg { margin: 10px 0 0; font-size: 14px; font-weight: 700; color: #0f7f66; line-height: 1.4; }
  .pp-save-msg:empty { display: none; }
  .pp-remind { display: grid; gap: 10px; justify-items: start; }
  .pp-remind label { letter-spacing: 0.06em; }
  .pp-tab.has-new::after { content: ''; width: 8px; height: 8px; margin-left: 2px; border-radius: 50%; background: #ff4f6e; border: 1.5px solid #1b2340; }

  /* ---- the cover, which opens on the way in ---- */
  .pp-cover { position: absolute; top: 10px; bottom: 10px; left: 50%; right: 10px; z-index: 6; display: none; transform-origin: 0 50%; transform-style: preserve-3d; pointer-events: none; }
  .pp-book.is-cover .pp-cover { display: block; }
  .pp-book.is-opening .pp-cover { transform: rotateY(-178deg); transition: transform 0.9s cubic-bezier(0.55, 0.05, 0.3, 1); }
  .pp-cover-front, .pp-cover-back { position: absolute; inset: 0; backface-visibility: hidden; }
  .pp-cover-front {
    display: grid; place-content: center; justify-items: center; gap: 14px; text-align: center;
    border-radius: 5px 16px 16px 5px; color: var(--cf-ink, #c4f4e8);
    background: radial-gradient(120% 80% at 30% 20%, var(--cf-1, #33479a), var(--cf-2, #212e6a) 60%, var(--cf-3, #1a2456));
    box-shadow: inset 0 0 0 12px transparent, inset 0 0 0 14px rgba(196, 244, 232, 0.35);
  }
  .pp-cover-back { transform: rotateY(180deg); border-radius: 16px 5px 5px 16px; background: #e9eefc; }
  .pp-cover-top, .pp-cover-word, .pp-cover-small { margin: 0; text-transform: uppercase; }
  .pp-cover-top { font-size: 16px; font-weight: 700; letter-spacing: 0.32em; }
  .pp-cover-word {
    font-size: 40px; font-weight: 700; letter-spacing: 0.24em; margin-right: -0.24em;
    background: linear-gradient(100deg, #eafffa, #8fe6d4 40%, #e3f6ff 55%, #7dc8dc); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .pp-cover-small { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; opacity: 0.75; }
  /* The pearl cover is pale: its lettering is printed dark. */
  .pp-book[data-cover='pearl'] .pp-cover-word { background-image: linear-gradient(100deg, #2b3a7c, #5a4bc9 45%, #1f67c9 60%, #2b3a7c); }
  .pp-book[data-cover='pearl'] .pp-cover-emblem { filter: drop-shadow(0 2px 0 rgba(43, 58, 124, 0.5)); }
  .pp-book[data-cover='pearl']::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.5) 46%, rgba(205, 240, 255, 0.4) 52%, transparent 66%); background-size: 250% 100%; background-position: 120% 0; }
  html.play .pp[open] .pp-book[data-cover='pearl']::after { animation: pp-holo 4.2s 0.6s ease-in-out infinite; }
  /* A new cover put on: the book gives a little bounce. */
  html.play .pp-book.is-recovered { animation: pp-recover 0.5s cubic-bezier(0.3, 1.6, 0.5, 1); }
  @keyframes pp-recover { 40% { transform: scale(0.985) rotate(-0.4deg); } }

  /* ---- bottles, on your page ---- */
  .pp-tally .pp-tally-bottles { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 10px; }
  .pp-tally-bottles b { grid-row: 1 / 3; }
  .pp-bpips { display: flex; gap: 4px; margin-top: 4px; }
  .pp-bpips i { width: 11px; height: 17px; border-radius: 3px 3px 5px 5px; border: 1.5px dashed #b7c1dc; }
  .pp-bpips i.is-on { background: var(--glass); border: 1.5px solid #1b2340; }

  /* ---- the bottles' own page ---- */
  .pp-bottles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px 6px; }
  .pp-bottle {
    position: relative; width: 100%; display: grid; justify-items: center; gap: 4px;
    padding: 8px 2px 6px; margin: 0; background: none; border: 0; border-radius: 14px; cursor: pointer;
    font: inherit; color: #b7c1dc; transition: background-color 0.15s;
  }
  .pp-bottle:hover { background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .pp-bottle.is-reading { background: color-mix(in srgb, var(--ink) 13%, transparent); }
  .pp-bottle-found, .pp-bottle-ghost { grid-area: 1 / 1; display: block; width: 34px; height: 54px; }
  .pp-bottle-svg { display: block; width: 100%; height: 100%; }
  .pp-bottle-found { opacity: 0; transform: rotate(-8deg) scale(0.8); transition: opacity 0.3s, transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .pp-bottle.is-found .pp-bottle-found { opacity: 1; transform: rotate(-8deg); }
  .pp-bottle.is-found .pp-bottle-ghost { visibility: hidden; }
  .pp-bottle:hover .pp-bottle-ghost { color: #8f9bc0; }
  .pp-bottle-no { font-size: 12px; font-weight: 700; color: #8f9bc0; }
  .pp-bottle.is-found .pp-bottle-no { color: #1b2340; }
  .pp-bottle:focus-visible, .pp-coverbtn:focus-visible { outline: 3px solid #4fe3c1; outline-offset: 2px; }
  .pp-letter {
    margin: 12px 0 0; padding: 12px 16px; min-height: 92px;
    background-color: #fdfeff; background-image: repeating-linear-gradient(180deg, transparent 0 25px, rgba(140, 203, 255, 0.35) 25px 26.5px); background-position: 0 30px;
    border: 2px solid #1b2340; border-radius: 12px; box-shadow: 0 3px 0 #1b2340;
  }
  .pp-letter.is-turning { animation: pp-turn 0.4s cubic-bezier(0.2, 0.8, 0.3, 1); transform-origin: 0 50%; }
  .pp-letter p { margin: 0; }
  .pp-letter-no { font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); }
  .pp-letter-text { margin-top: 4px !important; font-size: 16px; font-weight: 500; line-height: 26.5px; color: #4a5578; }
  .pp-letter.is-open .pp-letter-text { color: #1b2340; }
  .pp-letter-from { text-align: right; font-size: 14px; font-weight: 600; color: var(--pmute); line-height: 26.5px; }
  .pp-sub { margin: 18px 0 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pmute); }
  .pp-covers { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .pp-coverbtn {
    display: grid; justify-items: center; gap: 3px; padding: 8px 4px 7px; margin: 0;
    font: inherit; color: #1b2340; background: rgba(255, 255, 255, 0.7); border: 2px solid #c5cde4; border-radius: 12px; cursor: pointer;
    transition: border-color 0.15s, transform 0.12s, background-color 0.15s;
  }
  .pp-coverbtn:hover:not(:disabled) { transform: translateY(-2px); border-color: #1b2340; }
  .pp-coverbtn[aria-checked='true'] { border-color: #1b2340; background: #fff; box-shadow: 0 3px 0 #1b2340; }
  .pp-swatch {
    position: relative; display: grid; place-items: center; width: 34px; height: 44px; border-radius: 3px 7px 7px 3px;
    background: radial-gradient(120% 80% at 30% 20%, var(--a), var(--b) 60%, var(--c)); border: 2px solid #1b2340;
    font-size: 15px; font-weight: 700; color: var(--t);
  }
  .pp-coverbtn[aria-checked='true'] .pp-swatch::after { content: '✓'; position: absolute; right: -9px; bottom: -7px; display: grid; place-items: center; width: 18px; height: 18px; font-size: 11px; color: #fff; background: #13806a; border: 2px solid #1b2340; border-radius: 50%; }
  .pp-cname { font-size: 12.5px; font-weight: 700; line-height: 1.1; text-align: center; }
