              <span class="pp-photo-pin" id="ppPin"></span>
            </div>
            <dl class="pp-fields">
              <div><dt>Holder</dt><dd>You</dd></div>
              <div><dt>Rank</dt><dd><b id="ppRank">Just landed</b></dd></div>
              <div><dt>First landed</dt><dd id="ppSince">Not yet</dd></div>
              <div><dt>Issued at</dt><dd>The Harbour</dd></div>
            </dl>
          </div>
          <ul class="pp-tally" role="list">
            <li><b id="ppVisited">0</b><span>of {count} games visited</span></li>
            <li><b id="ppFinished">0</b><span>finished</span></li>
            <li><b id="ppDistricts">0</b><span>of {book.length} districts complete</span></li>
