---
import Paper from '../layouts/Paper.astro'
import { SITE } from '../site.config'
import { CATEGORIES } from '../data/games'
import { META, dailyFor } from '../data/game-meta'
import { withBase } from '../lib/base'
import { faviconSvg } from '../lib/favicon'
import { homeGames, homeIsland, homeBake, hasRealWorld, type World } from '../lib/island/home'
import { plateInfo } from '../lib/island/plate'
import { cardCss } from '../lib/island/moves'
import { cardFrame } from '../lib/island/card-art'
import { DISTRICTS, PLACES } from '../lib/island/landmarks'
import { STAMP, stampSvg, sealSvg } from '../lib/passport-art'
import { inkIcon } from '../lib/ink-icon'
import { COVERS, QUEST_COVERS, BOTTLE_COUNT, glassOf } from '../lib/bottles'
import { QUESTS } from '../lib/quests'
import { GRID } from '../lib/island/world'
import { coastline } from '../lib/island/sound'

/*
 * The homepage is Tiny Island: every game is a building on one illustrated
 * map, standing in the district its subject belongs to. It is drawn at build
 * time (lib/island) and baked into pictures (lib/island/bake) that one canvas
 * draws (lib/island/engine); a small picture of it stands in until the canvas
 * can, and a whole still one without script. The camera, the cards that pop
 * up and the dive into a game are lib/island/camera.ts.
 * Under the island, every game again as a card, for anyone who would rather
 * scan a list than explore.
 */
// Which island this page shows (pages/index.astro the cartoon one, pages/realistic.astro the one
// Unity renders), and the switch between them: a link to the other page, remembered by the page.
const { world = 'cartoon' } = Astro.props as { world?: World }
const worlds = hasRealWorld()
const worldHref = { cartoon: withBase('/'), real: withBase('/realistic/') }
// Until the realistic island is the one everyone gets (plate.json's `live`), it is the one you ask for.
const worldDefault: World = plateInfo('plate')?.live ? 'real' : 'cartoon'
// The realistic island's open sea (scripts/unity-plate.mjs measures it), behind the canvas and in the browser's bar.
const seaColour = world === 'real' ? plateInfo('plate')?.sea ?? '#3b80c6' : '#3b80c6'
const games = homeGames()
const count = games.length
const island = homeIsland(world)
const baked = homeBake(world)
const [vx, vy, vw, vh] = island.viewBox
const poster = baked.scene.poster
// The mini-map is the island itself, small: the poster the page opens on, with a pin for every game.
// Framed on where the buildings are (the island's land box is the whole grid,
// sea and all), with room round them for the coast, at the box's own shape.
const lms = Object.values(island.anchors)
const [lx0, ly0, lx1, ly1] = [Math.min(...lms.map((a) => a.x0)), Math.min(...lms.map((a) => a.y0)), Math.max(...lms.map((a) => a.x1)), Math.max(...lms.map((a) => a.y1))]
const miniBox = (() => {
  const w = (lx1 - lx0) * 1.18, h = (ly1 - ly0) * 1.2, cx = (lx0 + lx1) / 2, cy = (ly0 + ly1) / 2
  const W = Math.max(w, h * (196 / 132)), H = W * (132 / 196)
  return [cx - W / 2, cy - H / 2, W, H].map((v) => Math.round(v))
})()
const miniPin = (miniBox[2] / 196) * 2.3
// The cards' copies of the buildings move by the island's own rules.
const cardStyle = cardCss('.gc-svg', Object.values(baked.cards).join(''), island.css)

const districtOf = Object.fromEntries(PLACES.map(([s, d]) => [s, d]))
const tintOf = (slug: string) => DISTRICTS.find((d) => d.key === districtOf[slug])?.tint ?? '#e3e9ff'
const CHIP: Record<string, string> = { science: 'Real science', you: 'Measures you', money: 'Money', fun: 'Just because' }

// Each card frames its building by its footprint and its body (lib/island/card-art.ts).
const frame = (slug: string) => cardFrame(island, slug).join(' ')

// Messages in bottles: where each lies (for the passport's hint), and how a bottle is drawn in the book.
const DNAME = Object.fromEntries(DISTRICTS.map((d) => [d.key, d.name]))
const bottles = island.bottles.map((b) => ({ n: b.n, district: b.district, where: b.n === BOTTLE_COUNT ? 'Out at sea, to the west' : `On the shore of ${DNAME[b.district].replace(/^The /, 'the ')}` }))
const bottleArt = (glass: string) => `<svg class="pp-bottle-svg" viewBox="0 0 44 70" aria-hidden="true" focusable="false"><path d="M17 4h10v4h-1v9c0 3 9 7 9 17v26a6 6 0 0 1-6 6H15a6 6 0 0 1-6-6V34c0-10 9-14 9-17V8h-1z" fill="${glass}" stroke="#1b2340" stroke-width="2.4" stroke-linejoin="round"/><rect x="16.5" y="1.5" width="11" height="7" rx="2" fill="#c69f78" stroke="#1b2340" stroke-width="2"/><rect x="14" y="34" width="16" height="22" rx="3" fill="#fffdf7" stroke="#9aa6c8" stroke-width="1.2"/><path d="M14 45h16" stroke="#ff4f6e" stroke-width="2"/><path d="M12.6 36.5v17" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".8"/></svg>`
const bottleGhost = `<svg class="pp-bottle-svg" viewBox="0 0 44 70" aria-hidden="true" focusable="false"><path d="M17 4h10v4h-1v9c0 3 9 7 9 17v26a6 6 0 0 1-6 6H15a6 6 0 0 1-6-6V34c0-10 9-14 9-17V8h-1z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-dasharray="4 3.5" stroke-linejoin="round"/><text x="22" y="50" text-anchor="middle" font-family="Fredoka, system-ui, sans-serif" font-weight="700" font-size="17" fill="currentColor">?</text></svg>`
const pillBottle = `<svg viewBox="0 0 44 70" aria-hidden="true"><path d="M17 4h10v4h-1v9c0 3 9 7 9 17v26a6 6 0 0 1-6 6H15a6 6 0 0 1-6-6V34c0-10 9-14 9-17V8h-1z" fill="#bdf0da" stroke="#1b2340" stroke-width="4" stroke-linejoin="round"/><rect x="14" y="34" width="16" height="22" rx="3" fill="#fffdf7"/></svg>`

const daily = dailyFor(new Date())
const info = Object.fromEntries(games.map((g) => [g.slug, { slug: g.slug, title: g.title, blurb: g.blurb, href: withBase(`/${g.slug}/`), tint: tintOf(g.slug), cat: g.category }]))
// The coastline, for the soundscape's surf (lib/island/sound.ts).
const coast = coastline(island.grid, GRID)
const districts = DISTRICTS.map((d) => ({ key: d.key, name: d.name, x: island.banners[d.key][0], y: island.banners[d.key][1] }))
const data = { bounds: island.viewBox, land: island.land, districts, anchors: island.anchors, games: info, slugs: games.map((g) => g.slug), base: baked.base, posterScale: baked.scene.levels[0], pokes: baked.scene.pokes, play: island.play, grid: island.grid, coast, bottles, inks: Object.fromEntries(Object.entries(STAMP).map(([k, v]) => [k, v.ink])) }

// The passport: a page per district, in the order you would walk the island
// from the middle, each game a stamp drawn here and inked by the page once
// this browser has been there. A small tilt each, from the name, so a page of
// stamps looks stamped rather than typeset.
const BOOK = ['oldtown', 'market', 'funfair', 'harbour', 'proving', 'badlands', 'peaks']
const tilt = (s: string) => { let h = 7; for (const ch of s) h = (h * 31 + ch.charCodeAt(0)) % 997; return ((h % 19) - 9) }
const book = BOOK.map((key) => {
  const d = DISTRICTS.find((x) => x.key === key)!
  const list = games.filter((g) => districtOf[g.slug] === key).sort((a, b) => a.title.localeCompare(b.title))
  return { key, name: d.name, ink: STAMP[key].ink, seal: sealSvg(key, d.name), games: list.map((g) => ({ slug: g.slug, title: g.title, rot: tilt(g.slug), stamp: stampSvg({ slug: g.slug, title: g.title, district: key, icon: META[g.slug]?.icon ?? 'star' }), ghost: inkIcon(META[g.slug]?.icon ?? 'star') })) }
}).filter((p) => p.games.length)
---

<Paper
  title={`${SITE.name} — ${count} small games on one tiny island`}
  description={SITE.description}
  image={withBase('/og-home.png')}
  bodyClass="home-isle"
  masthead={false}
  colophon={false}
  themeColor={seaColour}
  fonts={['Fredoka:wght@400..700', 'Silkscreen']}
  paperFonts={false}
  noindex={world !== 'cartoon'}
>
  {worlds && (
    // The island you chose last time, before anything else is fetched: the other page, at once, with
    // the address's own extras, and where you came from (so stepping out of a game still works there).
    // And come here by the switch: the one island fades into the other, where the camera was.
    <script is:inline define:vars={{ here: world, def: worldDefault, href: worldHref }}>
      try {
        const want = localStorage.getItem('isl-world') || def
        if (want !== here && href[want]) {
          sessionStorage.setItem('isl-ref', document.referrer)
          location.replace(href[want] + location.search + location.hash)
        } else if (sessionStorage.getItem('isl-swap')) {
          sessionStorage.removeItem('isl-swap')
          const d = document.documentElement
          d.classList.add('world-in')
          setTimeout(() => d.classList.remove('world-in'), 1200)
        }
      } catch {}
    </script>
  )}
  {world === 'real' && <style is:inline set:html={`body.home-isle, .isl-box { background: ${seaColour} !important; }`} />}
  <main id="main">
    <section class="isl" aria-label={`Tiny Island: ${count} games, each one a building`}>
      <div class="isl-box" id="islBox" tabindex="0" data-world={world}>
        <div class="isl-stage" id="islStage">
          <canvas class="isl-canvas" id="islCanvas" aria-hidden="true"></canvas>
          {/* The map and its smallest level's index, asked for at once: the script that would ask for them comes in a second or two later on a phone. */}
          <link rel="preload" href={baked.base + 'scene.json'} as="fetch" crossorigin="anonymous" />
          <link rel="preload" href={baked.base + baked.scene.lv[0].index} as="fetch" crossorigin="anonymous" />
          {poster && <img class="isl-poster" id="islPoster" src={baked.base + poster.file} width={poster.w} height={poster.h} alt="" fetchpriority="high" decoding="async" style={poster.tiny ? `background-image:url(${poster.tiny});background-size:100% 100%` : undefined} />}
          <noscript><img class="isl-still" src={baked.base + 'still.webp'} alt={`Tiny Island: ${count} games, each one a building`} /></noscript>
        </div>
        <nav class="isl-links" aria-label="The games on the island">
          {games.map((g) => <a class="isl-lm" href={withBase(`/${g.slug}/`)} data-slug={g.slug}>{g.title}: {g.blurb}</a>)}
        </nav>
        <div class="isl-labels" aria-hidden="true"></div>
        <div class="isl-card" hidden role="dialog" aria-live="polite">
          <p class="isl-card-title"></p>
          <p class="isl-card-blurb"></p>
          <p class="isl-card-extra" hidden></p>
          <div class="isl-card-row">
            <span class="isl-card-best" hidden></span>
            <a class="isl-card-play" href="#"><span>Play</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
        </div>

        <header class="isl-top">
          <a class="isl-logo" href={withBase('/')}><span class="isl-logo-dot" aria-hidden="true" set:html={faviconSvg(true)} /><span class="isl-logo-name">{SITE.name}</span></a>
          <nav class="isl-nav" aria-label="Island">
            <button type="button" class="isl-btn" id="btnPassport" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2.5" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="10.5" r="3.4" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M8.6 10.5h6.8M12 7.1c-1.6 2-1.6 4.8 0 6.8M12 7.1c1.6 2 1.6 4.8 0 6.8M9 17h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg><span>Passport</span><b class="isl-pp-n" id="ppCount" hidden></b><i class="isl-pp-new" id="ppNew" hidden></i></button>
            <button type="button" class="isl-btn" id="btnToday"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="10" r="6.5" fill="currentColor" opacity=".25" /><path d="M5.5 10a6.5 6.5 0 0 1 13 0c0 3-2.4 5-4 6.5h-5C7.9 15 5.5 13 5.5 10zM9.5 16.5 10.5 20h3l1-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><span>Today</span><b class="isl-streak-n" id="islStreakN" hidden></b></button>
            <button type="button" class="isl-btn isl-btn--hot" id="btnSurprise"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="9" cy="9" r="1.6" fill="currentColor" /><circle cx="15" cy="15" r="1.6" fill="currentColor" /><circle cx="15" cy="9" r="1.6" fill="currentColor" /><circle cx="9" cy="15" r="1.6" fill="currentColor" /></svg><span>Surprise me</span></button>
            <div class="isl-more">
              <button type="button" class="isl-btn isl-btn--round" id="btnMore" aria-expanded="false" aria-controls="islMorePanel" aria-label="How the island looks and sounds" title="How the island looks and sounds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><circle cx="15" cy="7" r="2.4" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" /><circle cx="9" cy="17" r="2.4" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" /></svg></button>
              <div class="isl-more-panel" id="islMorePanel" hidden>
                {worlds && (
                  <div class="isl-world" role="group" aria-label="How the island looks">
                    <a class="isl-world-opt" href={worldHref.cartoon} data-world="cartoon" aria-label="Cartoon island" aria-current={world === 'cartoon' ? 'page' : undefined} title="The island, drawn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4.5l5 5-8.2 8.2c-.9.9-2.2 1.3-3.4 1.1l-3.4-.6.6-3.4c.2-1.2.6-2.5 1.5-3.4z" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M12.5 6.5l5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg><span>Cartoon</span></a>
                    <a class="isl-world-opt" href={worldHref.real} data-world="real" aria-label="Realistic island" aria-current={world === 'real' ? 'page' : undefined} title="The island, rendered in 3D"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 19.5l6-9 4 5.5 2.6-3.5 6.4 7z" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><circle cx="17" cy="6.5" r="2.4" fill="none" stroke="currentColor" stroke-width="2" /></svg><span>Realistic</span></a>
                  </div>
                )}
                <div class="isl-more-row">
                  <button type="button" class="isl-btn isl-btn--round" id="btnTime" aria-label="Switch to night" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><g class="ic-sun"><circle cx="12" cy="12" r="4.5" fill="currentColor" opacity=".25" stroke="currentColor" stroke-width="2" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></g><path class="ic-moon" d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><span>Night</span></button>
                  <button type="button" class="isl-btn isl-btn--round" id="btnSound" aria-label="Turn sound on" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 9h3.2L12.5 5v14l-4.8-4H4.5z" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path class="ic-waves" d="M15.5 9.2a4 4 0 0 1 0 5.6M18 6.8a7.4 7.4 0 0 1 0 10.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path class="ic-off" d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg><span>Sound</span></button>
                </div>
              </div>
            </div>
          </nav>
        </header>

        <h1 class="isl-title">{count} small games on one tiny island</h1>
        <p class="isl-hint"><span class="isl-hint-long">Drag to explore · click any building to play</span><span class="isl-hint-short">Drag · pinch · tap a building</span></p>

        <div class="isl-welcome" id="islWelcome" hidden>
          <span class="isl-welcome-mark" aria-hidden="true" set:html={faviconSvg(true)} />
          <p><b>Welcome to Tiny Island!</b> <span class="isl-welcome-long">Every building is a game: drag to look round, click one to play.</span><span class="isl-welcome-short">Tap a building to play.</span></p>
          <button type="button" class="isl-welcome-sound" id="welcomeSound"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 9h3.2L12.5 5v14l-4.8-4H4.5z" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M15.5 9.2a4 4 0 0 1 0 5.6M18 6.8a7.4 7.4 0 0 1 0 10.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg><span>Sound on?</span></button>
          <button type="button" class="isl-welcome-x" id="welcomeX" aria-label="Close the welcome"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg></button>
        </div>

        <div class="isl-pills">
          <button type="button" class="isl-found" id="islFound" hidden></button>
          <button type="button" class="isl-bpill" id="islBottles" hidden><span class="isl-bpill-art" set:html={pillBottle} /><span id="islBottlesN"></span></button>
        </div>
        <p class="isl-toast" id="islToast" role="status" aria-live="polite"></p>
        <div class="isl-note" id="islNote" hidden role="status" aria-live="polite">
          <p class="isl-note-no" id="islNoteNo"></p>
          <p class="isl-note-text" id="islNoteText"></p>
          <p class="isl-note-from" id="islNoteFrom"></p>
          <p class="isl-note-foot"><span id="islNoteCount"></span><button type="button" class="isl-note-book" id="islNoteBook">See them all</button></p>
          <button type="button" class="isl-note-x" id="islNoteX" aria-label="Put the note away"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg></button>
        </div>
        <div class="isl-flash" aria-hidden="true"></div>
        <div class="isl-board" id="islBoard" hidden role="dialog" aria-labelledby="islBoardH">
          <header class="isl-board-head">
            <p class="isl-board-kicker">The noticeboard by the town square</p>
            <h2 class="isl-board-h" id="islBoardH">What’s on today</h2>
            <p class="isl-board-date" id="islBoardDate"></p>
          </header>
          <div class="isl-board-streak" id="islStreak">
            <p class="isl-bs-n" id="islStreakBig" hidden><b id="islStreakNum">0</b><span>day streak</span></p>
            <ol class="isl-bs-cal" id="islStreakCal" aria-label="The daily challenge, the last two weeks" hidden></ol>
            <p class="isl-bs-line" id="islStreakLine"></p>
          </div>
          <ul class="isl-board-list" id="islBoardList" role="list"></ul>
          <p class="isl-board-foot">Everything here runs by your own clock.</p>
          <button type="button" class="isl-board-x" id="islBoardX" aria-label="Close the noticeboard"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg></button>
        </div>

        <div class="isl-zoom" role="group" aria-label="Zoom">
          <button type="button" class="isl-snap" id="zSnap" aria-label="Make a postcard of this view" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.8l1.4-2h4.6l1.4 2h1.8A2.5 2.5 0 0 1 20 8.5v8a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5z" fill="currentColor" fill-opacity=".22" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><circle cx="12" cy="12.4" r="3.6" fill="#fff" stroke="currentColor" stroke-width="2" /><circle cx="17" cy="9" r="1" fill="currentColor" /></svg><span class="isl-snap-tip" aria-hidden="true">Postcard</span></button>
          <button type="button" id="zIn" aria-label="Zoom in">+</button>
          <button type="button" id="zOut" aria-label="Zoom out">−</button>
          <button type="button" id="zHome" aria-label="Show the whole island"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5 10 4l7 5.5M5.5 8v8h9V8" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" /></svg></button>
        </div>
        <div class="isl-mini" aria-hidden="true">
          <svg viewBox={miniBox.join(' ')} preserveAspectRatio="xMidYMid slice">
            {poster ? <image href={baked.base + poster.file} x={vx} y={vy} width={poster.w / baked.scene.levels[0]} height={poster.h / baked.scene.levels[0]} preserveAspectRatio="none" /> : <path d={island.mini} fill="#4fe3c1" />}
            <g class="isl-mini-pins">{games.map((g) => <circle class="isl-mini-pin" data-slug={g.slug} cx={island.anchors[g.slug].bx} cy={island.anchors[g.slug].by} r={miniPin.toFixed(1)}><title>{g.title}</title></circle>)}</g>
            <rect class="isl-mini-view" x="0" y="0" width="0" height="0" rx="14" />
          </svg>
        </div>
        <button type="button" class="isl-mapbtn" id="islMapBtn" aria-expanded="false" aria-label="Show the map" title="Map"><svg class="ic-map" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5 9 4.5l6 2 5.5-2v13l-5.5 2-6-2-5.5 2z" fill="currentColor" fill-opacity=".22" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M9 4.5v13M15 6.5v13" fill="none" stroke="currentColor" stroke-width="2" /></svg><svg class="ic-fold" viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg></button>
        <a class="isl-down" href="#games"><span>All {count} games</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
    </section>
    {/* Over the whole window, not just the map: it hands over to the game page, which opens it again. */}
    <div class="isl-iris" aria-hidden="true"></div>

    <dialog class="pc" id="pc" aria-labelledby="pcTitle">
