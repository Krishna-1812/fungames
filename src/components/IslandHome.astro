          </ul>
          <div class="pp-ticks" id="ppTicks" aria-hidden="true">{games.map((g) => <i data-tick={g.slug} style={`--ink:${STAMP[districtOf[g.slug]]?.ink ?? '#4637a6'}`} />)}</div>
          <p class="pp-mrz" id="ppMrz" aria-hidden="true"></p>
          <button type="button" class="pp-reset" id="ppReset">Start a new passport</button>
        </section>
        <section class="pp-page pp-right">
          <div class="pp-tabs" role="tablist" aria-label="Passport pages">
            <button type="button" role="tab" class="pp-tab pp-tab--you" data-tab="you" aria-selected="true">You</button>
            {book.map((p) => <button type="button" role="tab" class="pp-tab" data-tab={p.key} aria-selected="false" style={`--ink:${p.ink}`}>{p.name.replace(/^The /, '')}<i data-tab-n={p.key}></i></button>)}
            <button type="button" role="tab" class="pp-tab" data-tab="bottles" aria-selected="false" style="--ink:#1f7fa8">Bottles<i id="ppBTab"></i></button>
            <button type="button" role="tab" class="pp-tab" data-tab="sightings" aria-selected="false" style="--ink:#2a6f8f">Sightings</button>
