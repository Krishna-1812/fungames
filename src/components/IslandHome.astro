  if (!isMuted()) {
    const wake = () => { removeEventListener('pointerdown', wake, true); removeEventListener('keydown', wake, true); unlock(); sound!.start() }
    addEventListener('pointerdown', wake, true); addEventListener('keydown', wake, true)
    if (isle.cameFrom) void mayPlay().then((ok) => { if (ok && !sound!.on) { wake(); sound!.back() } })
  }

  /* ---- the passport -------------------------------------------------------- */
  const pp = document.getElementById('pp') as HTMLDialogElement
  const ppBook = document.getElementById('ppBook')!
  const btnPassport = document.getElementById('btnPassport')!
  const ppCountEl = document.getElementById('ppCount')!, ppNewEl = document.getElementById('ppNew')!
  const ppSlots = new Map([...pp.querySelectorAll<HTMLButtonElement>('.pp-slot')].map((b) => [b.dataset.slug!, b]))
  const ppTabs = [...pp.querySelectorAll<HTMLButtonElement>('[data-tab]')]
  const ppSheets = [...pp.querySelectorAll<HTMLElement>('[data-sheet]')]
  const ppTicks = new Map([...pp.querySelectorAll<HTMLElement>('[data-tick]')].map((t) => [t.dataset.tick!, t]))
  const wide = matchMedia('(min-width: 761px)')
  const SECRET = new Set(['castaway', 'treasure', 'bottle', 'house32', 'dawnwhale', 'ufo'])
  const $pp = (id: string) => document.getElementById(id)!
  const pretty = (day: string) => stampDate(day).replace(/[A-Z]{3}/, (m) => m[0] + m.slice(1).toLowerCase())
  const sheetOf = (slug: string) => data.anchors[slug]?.district
  const firstSheet = ppSheets[0].dataset.sheet!

  function renderPassport() {
    const v = visits(), file = readPassport()
    const fresh = new Set(newStamps(v, file.seen))
    const total = data.slugs.length
    let n = 0, since = '', latest = '', latestSlug = ''
    for (const [slug, b] of ppSlots) {
      const at = v[slug], g = data.games[slug]
      b.classList.toggle('is-stamped', !!at)
      b.classList.toggle('is-done', finished.has(slug))
      b.classList.toggle('is-fresh', fresh.has(slug))
      const date = b.querySelector('.pp-date')
      if (date) (date.querySelector('textPath') ?? date).textContent = at ? (at.first ? stampDate(at.first) : 'EARLY DAYS') : ''
      const when = !at ? 'Not yet' : (at.first ? pretty(at.first) : 'Before the passport') + (at.days > 1 ? ` · ${at.days} days` : '')
      b.querySelector('.pp-when')!.textContent = when
      b.setAttribute('aria-label', `${g.title}: ${at ? `stamped ${when}${finished.has(slug) ? ', finished' : ''}` : 'not visited yet'}. Show it on the island`)
      ppTicks.get(slug)?.classList.toggle('is-on', !!at)
      if (!at) continue
      n++
      if (at.first && (!since || at.first < since)) since = at.first
      if (at.last && at.last >= latest) { latest = at.last; latestSlug = slug }
    }
    let complete = 0
    for (const sh of ppSheets) {
      const key = sh.dataset.sheet!
      // Only the district pages have stamps to count.
      if (!sh.querySelector('.pp-slot')) continue
      const mine = [...sh.querySelectorAll('.pp-slot')], got = mine.filter((b) => b.classList.contains('is-stamped')).length
      const done = got === mine.length
      if (done) complete++
      sh.classList.toggle('is-complete', done)
      sh.querySelector(`[data-count="${key}"]`)!.textContent = String(got)
      const tab = ppTabs.find((t) => t.dataset.tab === key)!
      tab.classList.toggle('is-complete', done)
      tab.querySelector('i')!.textContent = `${got}/${mine.length}`
    }
    const seen = kinds.filter((k) => found.has(k)).length
    const rank = rankFor(n, total)
    $pp('ppRank').textContent = rank
    $pp('ppSince').textContent = since ? pretty(since) : n ? 'Before the passport' : 'Not yet'
    $pp('ppVisited').textContent = String(n)
    $pp('ppFinished').textContent = String(finished.size)
    $pp('ppDistricts').textContent = String(complete)
    $pp('ppSecrets').textContent = `${seen}/${kinds.length}`
    // The machine-readable lines along the bottom of the page, which say
    // exactly what the page above them does.
    const pad = (x: number) => String(x).padStart(2, '0')
    const l1 = `P<TINY<ISLAND<<${rank.toUpperCase().replace(/[^A-Z]+/g, '<')}`.padEnd(44, '<').slice(0, 44)
    const body = `${pad(n)}OF${total}<<${pad(finished.size)}FIN<<${pad(seen)}OF${kinds.length}SEEN<<${since.replace(/-/g, '') || '00000000'}`.padEnd(43, '<').slice(0, 43)
    const check = [...body].reduce((a, ch) => a + ch.charCodeAt(0), 0) % 10
    $pp('ppMrz').textContent = `${l1}\n${body}${check}`
    // You are here: the last place you went.
    const pin = $pp('ppPin'), la = data.anchors[latestSlug]
    pin.hidden = !la
    if (la) { const [bx, by, bw, bh] = data.bounds; pin.style.left = `${(((la.x0 + la.x1) / 2 - bx) / bw) * 100}%`; pin.style.top = `${((la.y1 - by) / bh) * 100}%` }
    // Sightings: the ordinary ones are named before you find them; the
    // secrets are not.
    const sights = $pp('ppSights')
    $pp('ppSightN').textContent = String(seen); $pp('ppSightT').textContent = String(kinds.length)
    sights.replaceChildren(...[...kinds].sort((a, b) => Number(SECRET.has(a)) - Number(SECRET.has(b))).map((k) => {
      const li = document.createElement('li'), got = found.has(k), name = NAMES[k] ?? k
      li.className = `pp-sight${got ? ' is-seen' : ''}${SECRET.has(k) ? ' is-secret' : ''}`
      li.innerHTML = `<span class="pp-sight-mark" aria-hidden="true">${got ? '<svg viewBox="0 0 20 20"><path d="M5 10.5l3.4 3.4L15 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>' : '?'}</span>`
      const t = document.createElement('span')
      t.textContent = got || !SECRET.has(k) ? name.charAt(0).toUpperCase() + name.slice(1) : 'A secret'
      li.append(t)
      if (!got) { const s = document.createElement('small'); s.textContent = 'not yet'; li.append(s) }
      return li
    }))
    renderBottles()
    const newQuests = renderQuests()
    ppCountEl.textContent = `${n}/${total}`; ppCountEl.hidden = n === 0
    ppNewEl.textContent = `+${fresh.size + newQuests}`; ppNewEl.hidden = fresh.size + newQuests === 0
    btnPassport.setAttribute('aria-label', `Passport: ${n} of ${total} games visited${fresh.size ? `, ${fresh.size} new stamp${fresh.size > 1 ? 's' : ''}` : ''}`)
    return fresh
  }

  /* ---- the passport's quests (lib/quests.ts) ---- */
  const questGames = () => data.slugs.map((s) => ({ slug: s, cat: data.games[s].cat, district: data.anchors[s]?.district ?? '' }))
  const QUEST_COVERS_BY = new Map(ALL_COVERS.map((c) => [c.key, c]))
  // Quests done before this page (or before quests existed) are dated today, quietly.
  sync(gather(questGames()))
  const tick = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.4 3.4L15 7" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  /** Paint the quests page; returns how many finished quests the book has not shown yet. */
  function renderQuests(): number {
    const f = readQuests(), all = progress(gather(questGames()), f), fresh = new Set(unseen(f))
    const worn = readBottles().cover
    const done = all.filter((p) => p.done).length
    $pp('ppQN').textContent = String(done); $pp('ppQuestsDone').textContent = String(done); $pp('ppQTab').textContent = `${done}/${all.length}`
    // Done ones last, so what is left to do is what the page opens on.
    const order = [...all].sort((a, b) => Number(a.done) - Number(b.done) || b.n / b.goal - a.n / a.goal)
    $pp('ppQuests').replaceChildren(...order.map((p) => {
      const li = document.createElement('li')
      li.className = `pp-quest${p.done ? ' is-done' : ''}${fresh.has(p.q.id) ? ' is-fresh' : ''}`
      const cover = QUEST_COVERS_BY.get(p.q.cover ?? '')
      li.innerHTML = `<span class="pp-q-seal" aria-hidden="true">${p.done ? tick : `${p.n}<small>/${p.goal}</small>`}</span><span class="pp-q-body"><span class="pp-q-name"></span><span class="pp-q-line"></span><span class="pp-q-bar" aria-hidden="true"><i style="--w:${p.goal ? p.n / p.goal : 0}"></i></span><span class="pp-q-meta"></span></span>`
      li.querySelector('.pp-q-name')!.textContent = p.q.name
      li.querySelector('.pp-q-line')!.textContent = p.q.line
      li.querySelector('.pp-q-meta')!.textContent = p.done ? `Done${p.day ? ` ${pretty(p.day)}` : ''}` : `${p.n} of ${p.goal}`
      if (cover) {
        const r = document.createElement(p.done ? 'button' : 'span')
        r.className = 'pp-q-reward'
        r.setAttribute('style', `--a:${cover.face[0]};--b:${cover.face[1]};--c:${cover.face[2]}`)
        r.innerHTML = '<i aria-hidden="true"></i><span></span>'
        r.querySelector('span')!.textContent = !p.done ? `Earns the ${cover.name} cover` : worn === cover.key ? `Wearing the ${cover.name} cover` : `Put on the ${cover.name} cover`
        if (p.done && r instanceof HTMLButtonElement) {
          r.type = 'button'
          r.disabled = worn === cover.key
          r.addEventListener('click', () => { if (!wearCover(cover.key, questCovers())) return; track('isl_cover', { cover: cover.key }); sound?.stamp(); renderBottles(); renderQuests(); if (PLAY) { ppBook.classList.remove('is-recovered'); void ppBook.offsetWidth; ppBook.classList.add('is-recovered') } })
        }
        li.querySelector('.pp-q-body')!.append(r)
      }
      li.setAttribute('aria-label', `${p.q.name}: ${p.done ? 'done' : `${p.n} of ${p.goal}`}. ${p.q.line}`)
      return li
    }))
    byId('ppQTab').parentElement!.classList.toggle('has-new', fresh.size > 0)
    return fresh.size
  }
  /* ---- the passport's bottles, and its cover ---- */
  const ppBottleBtns = [...pp.querySelectorAll<HTMLButtonElement>('.pp-bottle')]
  const ppPips = [...pp.querySelectorAll<HTMLElement>('[data-pip]')]
  const ppCovers = [...pp.querySelectorAll<HTMLButtonElement>('.pp-coverbtn')]
  /** Put a cover on the book: its board round the pages, and the face it opens from. */
  function applyCover(key: string) {
    const c = ALL_COVERS.find((x) => x.key === key) ?? COVERS[0]
    ppBook.dataset.cover = c.key
    const set = (k: string, v: string) => ppBook.style.setProperty(k, v)
    set('--cv-a', c.board[0]); set('--cv-b', c.board[1]); set('--cf-1', c.face[0]); set('--cf-2', c.face[1]); set('--cf-3', c.face[2]); set('--cf-ink', c.ink)
  }
  function renderBottles() {
    const file = readBottles(), n = count(file)
    for (const b of ppBottleBtns) {
      const k = Number(b.dataset.n), got = k in file.found, day = file.found[k]
      b.classList.toggle('is-found', got)
      b.setAttribute('aria-label', got ? `Bottle ${k}: found${day ? ` ${pretty(day)}` : ''}. Read its note` : `Bottle ${k}: not found yet. ${b.dataset.where}`)
    }
    for (const p of ppPips) p.classList.toggle('is-on', Number(p.dataset.pip) in file.found)
    $pp('ppBottles').textContent = String(n); $pp('ppBN').textContent = String(n); $pp('ppBTab').textContent = `${n}/${BOTTLE_COUNT}`
    const earned = questCovers()
    for (const c of ppCovers) {
      const open = c.dataset.quest ? earned.has(c.dataset.cover!) : n >= Number(c.dataset.need)
      c.disabled = !open
      c.classList.toggle('is-locked', !open)
      c.setAttribute('aria-checked', String(c.dataset.cover === file.cover))
    }
    applyCover(file.cover)
  }
  for (const b of ppBottleBtns) b.addEventListener('click', () => {
    const k = Number(b.dataset.n), file = readBottles(), note = NOTES[k]
    for (const o of ppBottleBtns) o.classList.toggle('is-reading', o === b)
    const letter = $pp('ppLetter')
    letter.classList.toggle('is-open', k in file.found)
    if (k in file.found && note) {
      $pp('ppLetterNo').textContent = `No. ${k}${file.found[k] ? ` · found ${pretty(file.found[k])}` : ''}`
      $pp('ppLetterText').textContent = `“${note.text}”`
      $pp('ppLetterFrom').textContent = `— ${note.from}`
    } else {
      $pp('ppLetterNo').textContent = `No. ${k} · not found yet`
      $pp('ppLetterText').textContent = `${b.dataset.where}. Look along the water’s edge for a glint.`
      $pp('ppLetterFrom').textContent = ''
    }
    if (PLAY) { letter.classList.remove('is-turning'); void letter.offsetWidth; letter.classList.add('is-turning') }
  })
  for (const c of ppCovers) c.addEventListener('click', () => {
    if (!wearCover(c.dataset.cover!, questCovers())) return
    track('isl_cover', { cover: c.dataset.cover! })
    sound?.stamp()
    renderBottles()
    if (PLAY) { ppBook.classList.remove('is-recovered'); void ppBook.offsetWidth; ppBook.classList.add('is-recovered') }
  })
  // The bottle counter on the map opens the book at the bottles.
  const openAt = (tab: string) => { openPassport(); showSheet(tab, false) }
  bottlesEl.addEventListener('click', () => openAt('bottles'))
  byId('islNoteBook').addEventListener('click', () => { hideNote(); openAt('bottles') })

  let landDelay = 0
  function showSheet(tab: string, turn = true) {
    if (tab === 'you' && wide.matches) tab = firstSheet
    ppBook.dataset.view = tab
    for (const t of ppTabs) t.setAttribute('aria-selected', String(t.dataset.tab === tab))
    for (const sh of ppSheets) sh.hidden = sh.dataset.sheet !== tab
    const sheet = ppSheets.find((sh) => sh.dataset.sheet === tab)
    if (sheet && turn && PLAY) { sheet.classList.remove('is-turning'); void sheet.offsetWidth; sheet.classList.add('is-turning'); sound?.page() }
    if (!sheet) return
    // New stamps land, one after another, the first time their page is seen.
    const landing = [...sheet.querySelectorAll<HTMLElement>('.pp-slot.is-fresh')]
    landing.forEach((b, i) => {
      const d = landDelay + 0.25 + i * 0.3
      b.classList.remove('is-fresh')
      if (!PLAY) return
      b.style.setProperty('--d', `${d}s`)
      b.classList.add('is-landing')
      sound?.stamp(d + 0.22)
      setTimeout(() => b.classList.remove('is-landing'), (d + 1.2) * 1000)
    })
    landDelay = 0
    // Finished quests are new until their page has been looked at.
    if (tab === 'quests' && unseen().length) { markQuestsSeen(); const left = newStamps(visits(), readPassport().seen).length; ppNewEl.textContent = `+${left}`; ppNewEl.hidden = left === 0; byId('ppQTab').parentElement!.classList.remove('has-new') }
    if (landing.length) { markSeen(landing.map((b) => b.dataset.slug!)); const left = newStamps(visits(), readPassport().seen).length; ppNewEl.textContent = `+${left}`; ppNewEl.hidden = left === 0 }
  }
  for (const t of ppTabs) t.addEventListener('click', () => { track('isl_passport', { tab: t.dataset.tab! }); showSheet(t.dataset.tab!) })
  // Arrow keys turn the pages, the way tabs should.
  pp.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key
    if (k !== 'ArrowRight' && k !== 'ArrowLeft') return
    const shown = ppTabs.filter((t) => t.offsetParent !== null), i = shown.findIndex((t) => t.getAttribute('aria-selected') === 'true')
    const next = shown[(i + (k === 'ArrowRight' ? 1 : -1) + shown.length) % shown.length]
    next.focus(); showSheet(next.dataset.tab!)
  })

  function openPassport() {
    const fresh = renderPassport()
    track('isl_passport', { tab: 'open', new_stamps: fresh.size })
    const firstNew = [...fresh][0]
    document.documentElement.classList.add('pp-open')
    isle.pause(true)
    pp.showModal()
    if (PLAY) {
      ppBook.classList.remove('is-opening'); ppBook.classList.add('is-cover')
      requestAnimationFrame(() => requestAnimationFrame(() => ppBook.classList.add('is-opening')))
      setTimeout(() => ppBook.classList.remove('is-cover', 'is-opening'), 1000)
      sound?.page()
      landDelay = 0.75
    }
    showSheet(firstNew ? sheetOf(firstNew) ?? 'you' : 'you', false)
  }
  btnPassport.addEventListener('click', openPassport)
  // A game's "Quest complete" note links here: the book, open at its quests.
  if (location.hash === '#quests') { history.replaceState(null, '', location.pathname + location.search); setTimeout(() => { openPassport(); showSheet('quests', false) }, 400) }
  $pp('ppClose').addEventListener('click', () => pp.close())
  // A click on the dimmed page around the book closes it.
  pp.addEventListener('click', (e) => { if (e.target === pp) pp.close() })
  pp.addEventListener('close', () => { document.documentElement.classList.remove('pp-open'); isle.pause(false); renderPassport() })
  for (const [slug, b] of ppSlots) b.addEventListener('click', () => {
    pp.close()
    box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
    setTimeout(() => { isle.flyToSlug(slug, 2.4); isle.showCard(slug) }, PLAY ? 350 : 0)
  })
  $pp('ppReset').addEventListener('click', () => {
    if (!confirm('Start a new passport? The stamps go. Your scores, and the secrets you have found, stay.')) return
    clearPassport()
    renderPassport()
  })
  renderPassport()

  /* ---- the passport's Save page: a save code (lib/sync-client.ts), and the daily reminder (lib/remind.ts) ---- */
  const saveMsg = $pp('ppSaveMsg')
  const say = (s: string) => { saveMsg.textContent = s }
  const linkFor = (code: string) => `${location.origin}/#save=${code}`
  const ago = (iso: string) => {
    const s = (Date.now() - Date.parse(iso)) / 1000
    return !iso || !Number.isFinite(s) ? '' : s < 90 ? 'just now' : s < 5400 ? `${Math.round(s / 60)} minutes ago` : s < 129600 ? `${Math.round(s / 3600)} hours ago` : `${Math.round(s / 86400)} days ago`
  }
  function renderSave() {
    const l = readLink()
    $pp('ppSaveOff').hidden = !!l
    $pp('ppSaveOn').hidden = !l
    $pp('ppSaveState').textContent = l ? 'Saved under a code' : 'On this device only'
    if (!l) return
    $pp('ppSaveCode').textContent = showCode(l.code)
    $pp('ppSaveMeta').textContent = l.at ? `Last saved ${ago(l.at)}. A save nobody opens for 400 days is let go.` : ''
    $pp('ppSaveShare').hidden = !navigator.share
  }
  const why = { unknown: 'There is no save with that code. Check it against the other device.', offline: 'Could not reach the island just now. Try again in a moment.', busy: 'Too many tries just now. Wait a few minutes and try again.' }
  async function bringHere(code: string) {
    say('Bringing your progress over…')
    const out = await useCode(code)
    if (!out.ok) { say(why[out.why]); return }
    track('save_code', { action: 'used' })
    renderPassport(); renderSave()
    const n = Object.keys(readPassport().visits).length
    say(out.changed.length ? `Done. Your progress is here, merged with this device’s: ${n} ${n === 1 ? 'stamp' : 'stamps'} in the book now.` : 'Done. This device was already up to date.')
  }
  $pp('ppSaveMake').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement
    b.disabled = true; say('Making your code…')
    const out = await makeCode()
    b.disabled = false
    if (!out.ok) { say(why[out.why]); return }
    track('save_code', { action: 'made' })
    renderSave(); say('Saved. Now open the link on your other device.')
  })
  $pp('ppSaveUse').addEventListener('submit', (e) => {
    e.preventDefault()
    const code = cleanCode(($pp('ppSaveIn') as HTMLInputElement).value)
    if (!code) { say('A save code is 16 letters and numbers, like ABCD-EFGH-JKMN-PQRS.'); return }
    bringHere(code)
  })
  $pp('ppSaveCopy').addEventListener('click', async () => {
    const l = readLink(); if (!l) return
    try { await navigator.clipboard.writeText(linkFor(l.code)); say('Link copied. Open it on your other device.') } catch { say(`Copy this link: ${linkFor(l.code)}`) }
    track('share', { outcome: 'copied', what: 'save' })
  })
  $pp('ppSaveShare').addEventListener('click', async () => {
    const l = readLink(); if (!l) return
    try { await navigator.share({ title: 'My Tiny Island save', text: 'My Tiny Island progress. Open this on my other device:', url: linkFor(l.code) }); track('share', { outcome: 'shared', what: 'save' }) } catch { /* closed */ }
  })
  $pp('ppSaveLeave').addEventListener('click', () => {
    if (!confirm('Stop saving on this device? Your progress here stays, and the save stays for your other devices.')) return
    forgetCode(); track('save_code', { action: 'left' }); renderSave(); say('This device no longer saves under the code.')
  })
  $pp('ppSaveDrop').addEventListener('click', async () => {
    if (!confirm('Delete this save for every device? Each device keeps the progress it has, but the code stops working.')) return
    if (!(await deleteSave())) { say(why.offline); return }
    track('save_code', { action: 'deleted' }); renderSave(); say('Deleted. The code no longer works anywhere.')
  })
  // Another device's progress arrived while this page was open (lib/sync-client.ts startSync).
  document.addEventListener('funsite:synced', () => { renderPassport(); renderSave() })

  const hourSel = $pp('ppRemindHour') as HTMLSelectElement
  hourSel.replaceChildren(...Array.from({ length: 24 }, (_, h) => new Option(hourWords(h), String(h))))
  hourSel.value = String(readPref()?.hour ?? 18)
  async function renderRemind() {
    const r = await remindState()
    const on = r.state === 'on', canPush = on || r.state === 'off'
    $pp('ppRemindOn').hidden = on || !canPush
    $pp('ppRemindOff').hidden = !on
    // Where notifications cannot come, the calendar is the main way, not the aside.
    $pp('ppRemindCalMain').hidden = canPush
    $pp('ppRemindCal').hidden = !canPush
    $pp('ppRemindLine').textContent = on ? `On: a reminder at ${hourWords(r.hour ?? 18)} each day, unless you have already played.`
      : r.state === 'blocked' ? 'Notifications from this site are blocked in your browser’s settings. A calendar reminder works instead.'
      : r.state === 'home' ? 'On an iPhone or iPad, notifications only come to sites on the Home Screen: tap Share, then Add to Home Screen, and open the island from there. Or use your calendar.'
      : r.state === 'calendar' ? 'A reminder in your calendar when there is a new daily challenge, every day at the hour you pick.'
      : 'A nudge when there is a new daily challenge, at an hour that suits you. Never more than one a day, and none on a day you have already played.'
  }
  $pp('ppRemindOn').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement
    b.disabled = true
    const out = await turnOn(Number(hourSel.value))
    b.disabled = false
    track('remind', { action: out, via: 'passport' })
    await renderRemind()
    if (out === 'failed') $pp('ppRemindLine').textContent = 'That did not work just now. Try again, or use your calendar.'
  })
  $pp('ppRemindOff').addEventListener('click', async () => { await turnOff(); track('remind', { action: 'off', via: 'passport' }); renderRemind() })
  hourSel.addEventListener('change', async () => { if (readPref()?.on) { await turnOn(Number(hourSel.value)); renderRemind() } })
  const toCalendar = () => {
    downloadCalendar(Number(hourSel.value))
    track('remind', { action: 'calendar', via: 'passport' })
    $pp('ppRemindLine').textContent = 'Open the downloaded file to add the reminder to your calendar.' }
  $pp('ppRemindCal').addEventListener('click', toCalendar)
  $pp('ppRemindCalMain').addEventListener('click', toCalendar)
  for (const t of ppTabs) if (t.dataset.tab === 'save') t.addEventListener('click', () => { renderSave(); renderRemind() })

  // A save link (#save=CODE) brings that progress here; #save opens the page.
  if (location.hash.startsWith('#save')) {
    const code = cleanCode(location.hash.slice(6))
    history.replaceState(null, '', location.pathname + location.search)
    setTimeout(() => { openPassport(); showSheet('save', false); renderSave(); renderRemind(); if (code) bringHere(code) }, 400)
  }

  /* ---- postcards: the view, framed, to keep or send ------------------------ */
  // The camera button takes whatever is on the screen: the engine paints it
  // again at the card's own size (lib/island/postcard), with a close-up of
  // the nearest building for the stamp, and the card comes up to be saved or
  // sent through the phone's own share sheet. Until the map has loaded there
  // is nothing to take, so the button waits.
  {
    const btn = byId('zSnap') as HTMLButtonElement
    const pc = byId('pc') as HTMLDialogElement, img = byId('pcImg') as HTMLImageElement
    const save = byId('pcSave') as HTMLAnchorElement, share = byId('pcShare') as HTMLButtonElement
    let url = '', file: File | null = null, taking = false, place = 'Tiny Island'
    isle.withEngine(() => { btn.disabled = false })
    const nearest = <T,>(xs: T[], at: (t: T) => [number, number], x: number, y: number) => xs.reduce<{ t: T | null; d: number }>((b, t) => { const [u, v] = at(t), d = Math.hypot(u - x, v - y); return d < b.d ? { t, d } : b }, { t: null, d: Infinity }).t
    const close = () => pc.close()
    async function take() {
      if (taking) return
      taking = true
      isle.hideCard()
      sound?.shutter()
      if (PLAY) { box.classList.remove('is-flashing'); void box.offsetWidth; box.classList.add('is-flashing') }
      const v = isle.view(), shape = shapeFor(v.w, v.h), cr = crop(v, shape), ps = photoSize(shape)
      // Where it is from: the district whose name is nearest the middle, unless the whole island is in it.
      const [, , bw] = data.bounds
      const d = cr.w > bw * 0.55 ? null : nearest(data.districts, (q) => [q.x, q.y], cr.x, cr.y)
      place = d ? d.name : 'Tiny Island'
      const ink = d ? data.inks[d.key] ?? '#4637a6' : '#4637a6'
      // The stamp: the building nearest the middle, close up.
      const lm = nearest(Object.values(data.anchors), (a) => [(a.x0 + a.x1) / 2, (a.y0 + a.y1) / 2], cr.x, cr.y)
      byId('pcPlace').textContent = place
      pc.classList.add('is-developing'); img.removeAttribute('src')
      save.removeAttribute('href'); share.hidden = true
      document.documentElement.classList.add('pp-open')
      isle.pause(true)
      pc.showModal()
      const photo = document.createElement('canvas'), stamp = document.createElement('canvas')
      try {
        await Promise.all(['700 80px Fredoka', '600 40px Fredoka'].map((f) => document.fonts?.load(f).catch(() => null)))
        // Paint until everything in both is sharp (the sharper pictures it wants come in meanwhile), or a few seconds have gone.
        const until = performance.now() + 6000
        await new Promise<void>((done) => {
          const once = () => isle.withEngine((e) => {
            const a = e.snapshot(photo, { x: cr.x, y: cr.y, z: cr.z }, ps.w, ps.h)
            let b = { sharp: true }
            if (lm) { const sw = (lm.x1 - lm.x0) * 1.35, sh = (lm.y1 - lm.y0) * 1.22, z = Math.min(STAMP_PHOTO.w / sw, STAMP_PHOTO.h / sh); b = e.snapshot(stamp, { x: (lm.x0 + lm.x1) / 2, y: (lm.y0 + lm.y1) / 2 + (lm.y1 - lm.y0) * 0.04, z }, STAMP_PHOTO.w, STAMP_PHOTO.h) }
            if ((a.sharp && b.sharp) || performance.now() > until) done()
            else window.setTimeout(once, 140)
          })
          once()
        })
        const card = drawPostcard({ photo, stamp: lm ? stamp : null, place, ink, value: String(data.slugs.length), date: new Date(), host: location.host, shape })
        const blob = await new Promise<Blob | null>((r) => card.toBlob(r, 'image/jpeg', 0.92))
        if (!blob) throw new Error('the postcard could not be made')
        if (url) URL.revokeObjectURL(url)
        url = URL.createObjectURL(blob)
        const name = `tiny-island-${place.toLowerCase().replace(/^the /, '').replace(/[^a-z]+/g, '-')}.jpg`
        file = new File([blob], name, { type: 'image/jpeg' })
        img.src = url
        img.alt = `A postcard of Tiny Island: greetings from ${place}, with a stamp and a postmark`
        save.href = url; save.download = name
        share.hidden = !(navigator.canShare?.({ files: [file] }))
        await img.decode().catch(() => null)
        pc.classList.remove('is-developing')
        track('isl_postcard', { action: 'made', place, shape })
        ;(share.hidden ? save : share).focus()
      } catch (err) {
        console.error('[island] postcard', err)
        byId('pcWait').textContent = 'The camera jammed. Try again in a moment.'
      } finally { taking = false }
    }
    btn.addEventListener('click', take)
    share.addEventListener('click', async () => {
      if (!file) return
      track('isl_postcard', { action: 'share', place })
      try { await navigator.share({ files: [file], title: `Greetings from ${place}`, text: `Greetings from ${place}, on Tiny Island: ${location.origin}/?ref=postcard` }) }
      catch (e) { if ((e as Error).name !== 'AbortError') save.click() }
    })
    save.addEventListener('click', () => track('isl_postcard', { action: 'save', place }))
    byId('pcDone').addEventListener('click', close)
    byId('pcClose').addEventListener('click', close)
    pc.addEventListener('click', (e) => { if (e.target === pc) close() })
    pc.addEventListener('close', () => {
      document.documentElement.classList.remove('pp-open'); isle.pause(false)
      byId('pcWait').innerHTML = '<span class="pc-dot" aria-hidden="true"></span>Developing…'
      btn.focus({ preventScroll: true })
    })
    // P on the map takes one too.
    box.addEventListener('keydown', (e) => { if ((e.key === 'p' || e.key === 'P') && !e.ctrlKey && !e.metaKey && !e.altKey && !btn.disabled && !(e.target as Element).closest('input')) { e.preventDefault(); take() } })
  }

  /* ---- the cards: filter, search, and "show on the island" ---------------- */
  const slots = Array.from(document.querySelectorAll<HTMLElement>('.gs-slot'))
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
  const q = document.getElementById('q') as HTMLInputElement
  const empty = document.getElementById('empty')!
  let filter = new URLSearchParams(location.search).get('c') ?? 'all'
  if (!chips.some((c) => c.dataset.filter === filter)) filter = 'all'
  const apply = () => {
    const term = q.value.trim().toLowerCase()
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)))
    const keep = new Set<string>()
    flip(slots, () => {
      for (const s of slots) {
        const ok = (filter === 'all' || s.dataset.cat === filter) && (!term || s.dataset.search!.includes(term))
        s.hidden = !ok
        if (ok) keep.add(s.dataset.slug!)
      }
      empty.hidden = keep.size > 0
    })
    // The island dims whatever the filter leaves out.
    isle.dim(filter === 'all' && !term ? null : keep)
  }
  chips.forEach((c) => c.addEventListener('click', () => { filter = c.dataset.filter!; apply(); track('isl_filter', { filter }) }))
  let t = 0, said = 0
  q.addEventListener('input', () => {
    clearTimeout(t); t = window.setTimeout(apply, 90)
    // What people look for, once they have stopped typing: the words (cut short) and how many games matched.
    clearTimeout(said); said = window.setTimeout(() => {
      const term = q.value.trim().toLowerCase().slice(0, 40)
      if (term.length >= 2) track('isl_search', { q: term, results: slots.filter((x) => !x.hidden).length })
    }, 1200)
  })
  if (filter !== 'all') apply()
  document.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach((b) => b.addEventListener('click', () => {
    const s = b.dataset.pin!
    box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
    setTimeout(() => { isle.flyToSlug(s, 2.4); isle.showCard(s) }, PLAY ? 500 : 0)
  }))

  // Each card's building is drawn into it as that card comes near the screen, from art.json (the bake's:
  // two thirds of what the page weighed, kept out of it and cached for good). The file is asked for once
  // the grid is close, or once the island is in and the page has gone quiet; never while the island loads.
  let art: Promise<Record<string, string>> | null = null
  const getArt = () => (art ??= fetch(data.base + 'art.json').then((r) => (r.ok ? r.json() : Promise.reject(new Error(`art.json: ${r.status}`)))))
  const drawCard = (sv: SVGSVGElement) => getArt().then((all) => {
    const a = all[sv.dataset.art!]
    if (!a || sv.dataset.drawn) return
    sv.dataset.drawn = '1'
    sv.insertAdjacentHTML('beforeend', a)
    cardReady(sv)
  }).catch((err) => console.error('[island] a card could not load', err))
  const cardNear = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) { cardNear.unobserve(e.target); drawCard(e.target as SVGSVGElement) } }, { rootMargin: '500px 0px' })
  // The cards are watched from the first scroll, or once the island has had a few seconds to come in.
  let watching = false
  const watchCards = () => { if (watching) return; watching = true; document.querySelectorAll<SVGSVGElement>('.gc-svg[data-art]').forEach((sv) => cardNear.observe(sv)) }
  addEventListener('scroll', watchCards, { once: true, passive: true })
  isle.withEngine(() => setTimeout(watchCards, 3500))
  isle.withEngine(() => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(() => getArt(), { timeout: 6000 }) : getArt()), 6000))

  // The building site counts the year as it is today, not as it was on the
  // day the page was built (its storeys only change each quarter anyway).
  const pgNow = new Date(), pgYear = pgNow.getFullYear(), utc = (m: number, d: number, yy = pgYear) => Date.UTC(yy, m, d)
  const pgPct = Math.floor(((utc(pgNow.getMonth(), pgNow.getDate()) - utc(0, 1)) / (utc(0, 1, pgYear + 1) - utc(0, 1))) * 100)
  const pgWidth = (w: string | undefined) => Math.round(Number(w) * pgPct) / 100
  isle.withEngine((e) => { e.setText('pg-pct', `${pgPct}%`); e.setText('pg-year', `${pgYear} SO FAR`); e.setRectWidth('pg-bar', (d) => pgWidth(d.w)); isle.redraw() })

  // Each card's building moves only while that card is on screen. Every
  // animation on the page costs the whole page a frame, seen or not: with the
  // grid watched as one block, and woken 200px early, all thirty-one ran
  // just below the fold and took the island from 47 frames a second to 29.
  const cardIo = new IntersectionObserver((es) => { for (const e of es) e.target.classList.toggle('is-live', e.isIntersecting) })
  function cardReady(sv: SVGSVGElement) {
    // The building site's year, on its card too.
    sv.querySelectorAll('.pg-pct').forEach((el) => { el.textContent = `${pgPct}%` })
    sv.querySelectorAll('.pg-year').forEach((el) => { el.textContent = `${pgYear} SO FAR` })
    sv.querySelectorAll<SVGElement>('.pg-bar').forEach((el) => el.setAttribute('width', String(pgWidth(el.dataset.w))))
    cardIo.observe(sv)
    // Its pictures (Unity's), fetched now: it is about to be seen.
    sv.querySelectorAll<SVGImageElement>('image[data-src]').forEach((im) => { im.setAttribute('href', data.base + im.dataset.src!); im.removeAttribute('data-src') })
  }

  /* ---- a few motions that need a clock rather than a keyframe ------------- */
  if (PLAY) isle.withEngine((e) => {
    // Who Was Alive's year, on the map and on its card.
    setInterval(() => { if (!isle.awake()) return; const y = String(1300 + Math.floor(Math.random() * 720)); e.setText('wwa-year', y); document.querySelectorAll('.gc-svg .wwa-year').forEach((el) => { el.textContent = y }) }, 2400)
    // Life in Weeks fills in, a week at a time.
    let wk = 38
    setInterval(() => { if (!isle.awake()) return; wk = wk >= 63 ? 38 : wk + 1; e.eachShape('liw-cell', (d, set) => set(Number(d.k) < wk ? (d.on ?? '#5fe0bf') : (d.off ?? '#e8e1f5'))) }, 900)
    // Every Second's windows, a few lit at a time.
    const lit = RULES.find((r) => r.on.includes('es-win') && r.on.includes('lit'))?.base?.fill ?? '#ffe9a8'
    const wins: ((fill: string | null) => void)[] = []
    e.eachShape('es-win', (_, set) => wins.push(set))
    setInterval(() => { if (!isle.awake()) return; wins.forEach((set) => set(null)); for (let k = 0; k < 4; k++) wins[Math.floor(Math.random() * wins.length)]?.(lit) }, 800)
  })
</script>

<style>
  :global(body.home-isle) { background: #3b80c6; font-family: 'Fredoka', system-ui, sans-serif; color: #1b2340; }
  :global(.home-isle .progress-bar) { display: none; }

  /* ================= the island ================= */
  .isl { position: relative; }
  .isl-box {
    position: relative;
    height: max(560px, min(100svh, 1100px));
    overflow: hidden;
    overflow: clip;
    background: #3b80c6;
    outline: none;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .isl-box.is-grabbing { cursor: grabbing; }
  .isl-box:focus-visible { box-shadow: inset 0 0 0 4px #1b2340; }
  .isl-stage { position: absolute; inset: 0; }
  /* The realistic island seen as through a lens: the corners a little deeper, the eye drawn in. */
  /* The monsoon's light: a soft grey over everything, as under heavy cloud. */
  .isl-box[data-season='monsoon'] .isl-stage::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: rgba(70, 92, 130, 0.36); mix-blend-mode: multiply;
  }
  .isl-box[data-world='real'] .isl-stage::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 75% 70% at 50% 46%, transparent 58%, rgba(3, 22, 52, 0.16) 82%, rgba(2, 16, 40, 0.34) 100%);
  }
  /* The island: one canvas, under the page's own names and cards. Until it
     can draw, the poster stands in, placed by the camera (and without
     script, the whole still picture, fitted to the box). */
  .isl-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .isl-poster { position: absolute; left: 0; top: 0; max-width: none; transform-origin: 0 0; pointer-events: none; transition: opacity 0.4s ease; }
  :global(.isl-box.is-live) .isl-poster { opacity: 0; }
  :global(html:not(.js)) .isl-poster { display: none; }
  .isl-still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  /* A link for every building, out of sight: the keyboard's way round the
     map (each one flies the camera there and shows its card). */
  .isl-links { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .isl-top {
    position: absolute;
    left: 0; right: 0; top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px clamp(14px, 3vw, 32px);
    pointer-events: none;
  }
  .isl-top > * { pointer-events: auto; }
  .isl-logo {
    display: inline-flex; align-items: center; gap: 10px;
    margin-right: auto;
    padding: 9px 16px 9px 11px;
    background: #fff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    font-weight: 700; font-size: 19px; text-decoration: none; color: #1b2340;
  }
  .isl-logo-dot { width: 30px; height: 30px; flex: none; margin: -4px 0; }
  .isl-logo-dot :global(svg) { display: block; width: 100%; height: 100%; }
  .isl-nav { display: flex; gap: 10px; }
  .isl-btn, .isl-zoom button, .isl-down {
    display: inline-flex; align-items: center; gap: 8px;
    font: 700 16px 'Fredoka', system-ui, sans-serif; color: #1b2340;
    background: #fff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    padding: 9px 15px; cursor: pointer; text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.2s;
  }
  .isl-btn svg, .isl-down svg { width: 20px; height: 20px; }
  .isl-btn:hover, .isl-zoom button:hover, .isl-down:hover { background: #eef4ff; }
  .isl-btn:active, .isl-zoom button:active, .isl-down:active { transform: translateY(4px); box-shadow: 0 0 0 #1b2340; }
  .isl-btn--hot { background: #4fe3c1; }
  /* The cartoon island or the realistic one: two halves of one pill, the one shown filled. */
  .isl-world {
    display: inline-flex; padding: 3px; gap: 2px;
    background: #fff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
  }
  .isl-world-opt {
    display: inline-flex; align-items: center; gap: 6px;
    font: 700 15px 'Fredoka', system-ui, sans-serif; color: #1b2340; text-decoration: none;
    padding: 5px 11px; border-radius: 11px;
    transition: background-color 0.2s, color 0.2s;
  }
  .isl-world-opt svg { width: 19px; height: 19px; flex: none; }
  .isl-world-opt:hover { background: #eef4ff; }
  .isl-world-opt[aria-current='page'] { background: #1b2340; color: #fff; cursor: default; }
  .isl-world-opt:focus-visible { outline: 3px solid #5b82ff; outline-offset: 1px; }
  .isl-btn, .isl-logo, .isl-world-opt { white-space: nowrap; }
  /* Narrower: the switch by its pictures alone, then the logo by its own. */
  @media (max-width: 1100px) { .isl-world-opt span { display: none; } .isl-world-opt { padding: 5px 9px; } }
  @media (max-width: 900px) { .isl-logo-name { display: none; } .isl-logo { padding: 9px 10px; } }

  .isl-btn--round { padding: 9px 11px; }
  /* How the island looks and sounds: a panel under its button, with room for words. */
  .isl-more { position: relative; }
  .isl-more-panel {
    position: absolute; right: 0; top: calc(100% + 12px); z-index: 6;
    display: grid; gap: 10px; padding: 12px; min-width: 236px;
    background: #fff; border: 3px solid #1b2340; border-radius: 18px; box-shadow: 0 4px 0 #1b2340;
    animation: isl-more-in 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .isl-more-panel[hidden] { display: none; }
  @keyframes isl-more-in { from { opacity: 0; transform: translateY(-6px) scale(0.97); } }
  .isl-more-panel .isl-world { box-shadow: none; border-width: 2.5px; }
  .isl-more-panel .isl-world-opt { flex: 1; justify-content: center; padding: 6px 10px; }
  .isl-more-panel .isl-world-opt span, .isl-more-panel .isl-btn span { display: inline; }
  .isl-more-row { display: flex; gap: 8px; }
  .isl-more-row .isl-btn { flex: 1; justify-content: center; padding: 8px 10px; box-shadow: 0 3px 0 #1b2340; border-width: 2.5px; font-size: 15px; }
  #btnMore[aria-expanded='true'] { background: #1b2340; color: #fff; }
  .isl-btn .ic-moon { display: none; }
  .isl-btn[aria-pressed='true'] .ic-sun { display: none; }
  .isl-btn[aria-pressed='true'] .ic-moon { display: inline; }
  .isl-btn[aria-pressed='true'] { background: #1b2340; color: #fff; }
  .isl-btn[aria-pressed='true']:hover { background: #2c355e; }
  .isl-btn--hot:hover { background: #6debcd; }
  .isl-btn:focus-visible, .isl-zoom button:focus-visible, .isl-down:focus-visible, .isl-logo:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  .isl-hint {
    position: absolute; left: 50%; bottom: 26px; z-index: 4;
    transform: translateX(-50%);
    margin: 0; padding: 10px 18px;
    background: #1b2340; color: #fff; border-radius: 999px;
    font-weight: 600; font-size: 15px; white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.5s, transform 0.5s;
  }
  .isl-hint-short { display: none; }
  /* Touch or mouse decides the words, not the width of the window. */
  @media (pointer: coarse) { .isl-hint-long { display: none; } .isl-hint-short { display: inline; } }
  .isl-title {
    position: absolute; left: 50%; top: 22px; z-index: 4; transform: translateX(-50%);
    margin: 0; padding: 8px 18px;
    font: 700 18px 'Fredoka', system-ui, sans-serif; color: #1b2340; white-space: nowrap;
    background: rgba(255, 255, 255, 0.82); border: 2.5px solid #1b2340; border-radius: 999px;
    pointer-events: none;
  }
  [data-time='night'] .isl-title { background: rgba(223, 230, 250, 0.9); }
  /* It steps aside with the hint once you start exploring. */
  .isl-title { transition: opacity 0.5s; }
  .isl-title:has(+ .isl-hint.is-gone) { opacity: 0; }
  /* Below the top bar once the bar is wide enough to reach it: five buttons
     and a passport count meet a centred title at about 1560px. */
  @media (max-width: 1560px) { .isl-title { top: 84px; font-size: 16px; } }
  .isl-hint.is-gone { opacity: 0; transform: translateX(-50%) translateY(12px); }
  :global(html.play) .isl-hint { animation: isl-hint-in 0.8s 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards; }
  @keyframes isl-hint-in { from { opacity: 0; transform: translateX(-50%) translateY(20px); } }

  .isl-zoom { position: absolute; right: clamp(14px, 3vw, 32px); bottom: 24px; z-index: 5; display: grid; gap: 10px; }
  .isl-zoom button { width: 48px; height: 48px; padding: 0; justify-content: center; font-size: 26px; line-height: 1; }
  .isl-zoom svg { width: 20px; height: 20px; }
  .isl-zoom .isl-snap { position: relative; margin-bottom: 6px; background: #e3f3ff; }
  .isl-zoom .isl-snap svg { width: 24px; height: 24px; }
  .isl-zoom .isl-snap:hover { background: #cfe9ff; }
  .isl-zoom .isl-snap:disabled { opacity: 0.5; cursor: default; }
  .isl-snap-tip {
    position: absolute; right: calc(100% + 10px); top: 50%; transform: translate(6px, -50%);
    padding: 5px 11px; font: 700 14px 'Fredoka', system-ui, sans-serif; white-space: nowrap; color: #fff;
    background: #1b2340; border-radius: 999px; opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s;
  }
  @media (hover: hover) { .isl-snap:hover:not(:disabled) .isl-snap-tip, .isl-snap:focus-visible .isl-snap-tip { opacity: 1; transform: translate(0, -50%); } }
  .isl-mini {
    position: absolute; left: clamp(14px, 3vw, 32px); bottom: 24px; z-index: 5;
    width: 196px; height: 132px;
    background: #8ccbff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    overflow: hidden; cursor: pointer;
  }
  .isl-mini svg { width: 100%; height: 100%; display: block; }
  /* Folded away until asked for: the island is the picture, not the map of it. */
  .isl-box:not(.is-map) .isl-mini { visibility: hidden; opacity: 0; transform: translateY(10px) scale(0.92); pointer-events: none; }
  .isl-mini { transform-origin: 0 100%; transition: opacity 0.22s, transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.28s; }
  .isl-mapbtn {
    position: absolute; left: clamp(14px, 3vw, 32px); bottom: 24px; z-index: 6;
    display: grid; place-items: center; width: 48px; height: 48px; padding: 0;
    color: #1b2340; background: #fff; border: 3px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    cursor: pointer; transition: transform 0.12s, box-shadow 0.12s, background-color 0.2s, left 0.28s, bottom 0.28s, width 0.28s, height 0.28s, border-radius 0.28s;
  }
  .isl-mapbtn svg { width: 22px; height: 22px; }
  .isl-mapbtn:hover { background: #eef4ff; }
  .isl-mapbtn:active { transform: translateY(4px); box-shadow: 0 0 0 #1b2340; }
  .isl-mapbtn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .isl-mapbtn .ic-fold { display: none; width: 14px; height: 14px; }
  .isl-box.is-map .isl-mapbtn { left: calc(clamp(14px, 3vw, 32px) + 196px - 22px); bottom: calc(24px + 132px - 22px); width: 34px; height: 34px; border-radius: 999px; box-shadow: 0 3px 0 #1b2340; }
  .isl-box.is-map .isl-mapbtn .ic-map { display: none; }
  .isl-box.is-map .isl-mapbtn .ic-fold { display: block; }
  .isl-mini-view { fill: rgba(255, 255, 255, 0.28); stroke: #1b2340; stroke-width: 2px; vector-effect: non-scaling-stroke; }
  /* A pin for every game: white until played, mint once it has been, the day's challenge in raspberry; the one whose card is open larger. */
  .isl-mini-pin { fill: #ffffff; stroke: #1b2340; stroke-width: 1.1px; vector-effect: non-scaling-stroke; transform-box: fill-box; transform-origin: center; transition: transform 0.2s; }
  .isl-mini-pin.is-done { fill: #4fe3c1; }
  .isl-mini-pin.is-today { fill: #ff4f6e; }
  .isl-mini-pin.is-hot { transform: scale(1.7); }
  .isl-down { position: absolute; left: 50%; bottom: 24px; z-index: 4; transform: translateX(-50%); display: none; }
  /* How many of the island's secrets you have found, and how many bottles, once there is one of either. */
  .isl-pills { position: absolute; left: clamp(14px, 3vw, 32px); bottom: 150px; z-index: 5; display: flex; flex-wrap: wrap; gap: 8px; pointer-events: none; }
  .isl-pills > * { pointer-events: auto; }
  .isl-found, .isl-bpill {
    display: inline-flex; align-items: center;
    padding: 7px 14px; font: 700 14px 'Fredoka', system-ui, sans-serif; color: #1b2340;
    background: #fff; border: 2.5px solid #1b2340; border-radius: 999px; box-shadow: 0 3px 0 #1b2340; cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.2s;
  }
  .isl-found:hover, .isl-bpill:hover { background: #eef4ff; }
  .isl-found:active, .isl-bpill:active { transform: translateY(3px); box-shadow: 0 0 0 #1b2340; }
  .isl-found[hidden], .isl-bpill[hidden] { display: none; }
  .isl-bpill { gap: 7px; padding-left: 10px; }
  .isl-bpill-art { display: inline-flex; width: 11px; height: 18px; transform: rotate(-14deg); }
  .isl-bpill-art :global(svg) { width: 100%; height: 100%; }
  .isl-found:focus-visible, .isl-bpill:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .isl-found::before { content: ''; display: inline-block; width: 9px; height: 9px; margin-right: 7px; border-radius: 50%; background: #4fe3c1; border: 2px solid #1b2340; vertical-align: -1px; }
  .isl-toast {
    position: absolute; left: 50%; bottom: 90px; z-index: 6; max-width: min(520px, calc(100% - 32px)); margin: 0;
    padding: 10px 18px; font: 600 15px/1.35 'Fredoka', system-ui, sans-serif; color: #1b2340; text-align: center;
    background: #fff; border: 2.5px solid #1b2340; border-radius: 16px; box-shadow: 0 4px 0 #1b2340;
    transform: translate(-50%, 12px); opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s;
  }
  .isl-toast.is-on { opacity: 1; transform: translate(-50%, 0); }

  /* A first visit's hello, where the hint would be (which it replaces). */
  .isl-box.is-welcoming .isl-hint { display: none; }
  .isl-welcome {
    position: absolute; left: 50%; bottom: 24px; z-index: 6;
    display: flex; align-items: center; gap: 12px;
    width: max-content; max-width: calc(100% - 28px);
    padding: 8px 8px 8px 12px;
    background: #fff; border: 3px solid #1b2340; border-radius: 999px; box-shadow: 0 5px 0 #1b2340;
    font: 500 15.5px/1.3 'Fredoka', system-ui, sans-serif; color: #1b2340;
    transform: translate(-50%, 22px); opacity: 0;
    transition: opacity 0.4s, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .isl-welcome[hidden] { display: none; }
  .isl-welcome.is-on { opacity: 1; transform: translate(-50%, 0); }
  .isl-welcome.is-going { opacity: 0; transform: translate(-50%, 14px); transition-timing-function: ease; }
  .isl-welcome p { margin: 0; }
  .isl-welcome b { font-weight: 700; }
  .isl-welcome-mark { flex: none; display: inline-flex; width: 34px; height: 34px; }
  .isl-welcome-mark :global(svg) { width: 100%; height: 100%; }
  .isl-welcome-short { display: none; }
  .isl-welcome-sound {
    flex: none; display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px 7px 11px; font: 700 15px 'Fredoka', system-ui, sans-serif; color: #1b2340; cursor: pointer;
    background: #4fe3c1; border: 2.5px solid #1b2340; border-radius: 999px; box-shadow: 0 3px 0 #1b2340;
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.2s;
  }
  .isl-welcome-sound[hidden] { display: none; }
  .isl-welcome-sound:hover { background: #6debcd; }
  .isl-welcome-sound:active { transform: translateY(3px); box-shadow: 0 0 0 #1b2340; }
  .isl-welcome-sound svg { width: 19px; height: 19px; }
  .isl-welcome-x { flex: none; display: grid; place-items: center; width: 34px; height: 34px; padding: 0; color: #4a5372; background: none; border: 0; border-radius: 50%; cursor: pointer; }
  .isl-welcome-x:hover { background: #eef2ff; color: #1b2340; }
  .isl-welcome-x svg { width: 16px; height: 16px; }
  .isl-welcome button:focus-visible { outline: 3px solid #8ccbff; outline-offset: 2px; }
  @media (pointer: coarse), (max-width: 760px) { .isl-welcome-long { display: none; } .isl-welcome-short { display: inline; } }
  :global(html.play) .isl-welcome.is-on .isl-welcome-mark { animation: isl-wave 1.6s 0.5s ease-in-out 2; }
  @keyframes isl-wave { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 60% { transform: rotate(9deg); } }

  /* A bottle's note, unrolled over the map. */
  .isl-note {
    position: absolute; left: 50%; bottom: 108px; z-index: 7;
    width: min(430px, calc(100% - 28px));
    margin: 0; padding: 20px 24px 16px;
    color: #1b2340; font-family: 'Fredoka', system-ui, sans-serif;
    background-color: #fdfeff;
    background-image: repeating-linear-gradient(180deg, transparent 0 27px, rgba(140, 203, 255, 0.35) 27px 28.5px);
    background-position: 0 16px;
    border: 3px solid #1b2340; border-radius: 6px 6px 18px 18px; box-shadow: 0 6px 0 #1b2340, 0 24px 50px rgba(13, 20, 50, 0.28);
    transform: translateX(-50%) rotate(-1.2deg);
    transform-origin: 50% 0;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s;
  }
  .isl-note[hidden] { display: none; }
  .isl-note.is-on { opacity: 1; pointer-events: auto; }
  /* The roll at the top it unwinds from. */
  .isl-note::before { content: ''; position: absolute; left: -9px; right: -9px; top: -12px; height: 18px; background: linear-gradient(180deg, #ffffff, #e3ebfb); border: 3px solid #1b2340; border-radius: 9px; }
  :global(html.play) .isl-note.is-on { animation: isl-unroll 0.6s 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.05) both; }
  @keyframes isl-unroll { from { clip-path: inset(-20px -20px 100% -20px); } to { clip-path: inset(-20px -20px -40px -20px); } }
  .isl-note-no { margin: 2px 0 0; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #1f7fa8; }
  .isl-note-text { margin: 8px 0 0; font-size: 19px; font-weight: 500; line-height: 28.5px; }
  .isl-note-from { margin: 2px 0 0; text-align: right; font-size: 15px; font-weight: 600; color: #4a5372; line-height: 28.5px; }
  .isl-note-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 10px 0 0; padding-top: 10px; border-top: 2px dashed #c5cde4; font-size: 14px; font-weight: 600; color: #4a5372; }
  .isl-note.has-prize .isl-note-foot span { color: #c4306f; font-weight: 700; }
  .isl-note-book { flex: none; padding: 5px 12px; font: 700 13.5px 'Fredoka', system-ui, sans-serif; color: #1b2340; background: #e3f3ff; border: 2px solid #1b2340; border-radius: 999px; cursor: pointer; }
  .isl-note-book:hover { background: #cfe9ff; }
  .isl-note-x { position: absolute; right: 8px; top: 10px; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; color: #4a5372; background: none; border: 0; border-radius: 50%; cursor: pointer; }
  .isl-note-x:hover { background: #eef2ff; color: #1b2340; }
  .isl-note-x svg { width: 15px; height: 15px; }
  .isl-note button:focus-visible { outline: 3px solid #8ccbff; outline-offset: 2px; }

  /* The noticeboard: a board of pinned notes, over the map. */
  .isl-board {
    position: absolute; left: 50%; top: 84px; z-index: 7;
    width: min(560px, calc(100% - 28px)); max-height: calc(100% - 110px); overflow: auto; overscroll-behavior: contain;
    padding: 18px 18px 14px;
    color: #1b2340; font-family: 'Fredoka', system-ui, sans-serif;
    background: #e9e3f6; background-image: radial-gradient(rgba(27, 35, 64, 0.06) 1px, transparent 1.4px); background-size: 9px 9px;
    border: 6px solid #9b8bd6; outline: 3px solid #1b2340; outline-offset: -1px; border-radius: 16px; box-shadow: 0 7px 0 #1b2340, 0 24px 60px rgba(13, 20, 50, 0.3);
    transform: translate(-50%, 16px) scale(0.97); opacity: 0;
    transition: opacity 0.22s, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    scrollbar-width: thin;
  }
  .isl-board[hidden] { display: none; }
  .isl-board.is-on { opacity: 1; transform: translate(-50%, 0); }
  .isl-board-head { text-align: center; margin: 0 34px 12px; }
  .isl-board-kicker { margin: 0; font-size: 11.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #6a5bb0; }
  .isl-board-h { margin: 2px 0 0; font: 700 26px/1.1 'Fredoka', system-ui, sans-serif; letter-spacing: -0.01em; }
  .isl-board-date { margin: 3px 0 0; font-size: 14px; font-weight: 600; color: #4a5372; }
  .isl-streak-n {
    position: absolute; top: -9px; right: -9px; min-width: 24px; height: 24px; padding: 0 6px;
    display: grid; place-items: center; border-radius: 12px;
    background: #4fe3c1; color: #1b2340; border: 2.5px solid #1b2340;
    font: 700 13px/1 'Fredoka', system-ui, sans-serif;
  }
  .isl-streak-n[hidden] { display: none; }
  #btnToday { position: relative; }
  .isl-board-streak {
    display: grid; justify-items: center; gap: 8px; margin: 0 4px 14px; padding: 12px 14px;
    background: #fdfeff; border: 2px solid #1b2340; border-radius: 12px; box-shadow: 0 3px 0 rgba(27, 35, 64, 0.85);
    text-align: center;
  }
  .isl-bs-n { margin: 0; display: flex; align-items: baseline; gap: 7px; }
  .isl-bs-n[hidden], .isl-bs-cal[hidden] { display: none; }
  .isl-bs-n b { font-size: 34px; line-height: 1; color: #1b2340; }
  .isl-bs-n span { font-size: 16px; font-weight: 700; }
  .isl-bs-cal { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(14, 15px); gap: 5px; }
  :global(.isl-bs-dot) { width: 15px; height: 15px; border-radius: 50%; border: 2px solid #c5cde4; }
  :global(.isl-bs-dot.is-won) { background: #5b82ff; border-color: #1b2340; }
  :global(.isl-bs-dot.is-played) { background: #b8a1ff; border-color: #1b2340; }
  :global(.isl-bs-dot.is-forgiven) { border-style: dashed; border-color: #8a93b2; }
  :global(.isl-bs-dot.is-open) { border-color: #1b2340; }
  .isl-bs-line { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.35; color: #4a5372; max-width: 42ch; }
  .isl-board-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  :global(.isl-row) {
    position: relative; display: grid; grid-template-columns: 1fr auto; column-gap: 12px; align-items: center;
    padding: 11px 13px 10px 15px;
    background: #fdfeff; border: 2px solid #1b2340; border-radius: 4px 4px 10px 10px; box-shadow: 0 3px 0 rgba(27, 35, 64, 0.85);
    transform: rotate(var(--tilt, 0deg));
  }
  :global(.isl-row:nth-child(3n + 2)) { background: #f0fbf7; }
  :global(.isl-row:nth-child(3n)) { background: #f3f5ff; }
  :global(.isl-row-pin) { position: absolute; left: 50%; top: -6px; width: 11px; height: 11px; margin-left: -5px; border-radius: 50%; background: #ff4f6e; border: 2px solid #1b2340; }
  :global(.isl-row:nth-child(2n) .isl-row-pin) { background: #5b82ff; }
  :global(.isl-row:nth-child(3n) .isl-row-pin) { background: #4fe3c1; }
  :global(.isl-row p) { margin: 0; grid-column: 1; }
  :global(.isl-row-title) { font-size: 16.5px; font-weight: 700; line-height: 1.15; }
  :global(.isl-row-line) { margin-top: 2px !important; font-size: 13.5px; font-weight: 500; line-height: 1.3; color: #4a5372; }
  :global(.isl-row-when) { display: flex; align-items: center; gap: 6px; margin-top: 5px !important; font-size: 13.5px; font-weight: 700; color: #1b2340; }
  :global(.isl-row-dot) { width: 8px; height: 8px; border-radius: 50%; background: #c5cde4; border: 1.5px solid #1b2340; }
  :global(.isl-row.is-now .isl-row-dot) { background: #4fe3c1; }
  :global(.isl-row.is-now .isl-row-when) { color: #0f7f66; }
  :global(html.play .isl-row.is-now .isl-row-dot) { animation: isl-now 1.4s ease-in-out infinite; }
  @keyframes isl-now { 50% { box-shadow: 0 0 0 4px rgba(79, 227, 193, 0.35); } }
  :global(.isl-row-go) {
    grid-column: 2; grid-row: 1 / span 3;
    padding: 7px 13px; font: 700 14px 'Fredoka', system-ui, sans-serif; color: #1b2340; white-space: nowrap; cursor: pointer;
    background: #fff; border: 2.5px solid #1b2340; border-radius: 12px; box-shadow: 0 3px 0 #1b2340;
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.2s;
  }
  :global(.isl-row-go:hover) { background: #e3f3ff; }
  :global(.isl-row-go:active) { transform: translateY(3px); box-shadow: 0 0 0 #1b2340; }
  :global(.isl-row-go:focus-visible) { outline: 3px solid #4fe3c1; outline-offset: 2px; }
  :global(.isl-row[data-key='today'] .isl-row-go) { background: #4fe3c1; }
  :global(.isl-row[data-key='three']) { background: #fdfeff; }
  .isl-board-foot { margin: 12px 0 0; text-align: center; font-size: 12.5px; font-weight: 600; color: #6a5bb0; }
  .isl-board-x { position: absolute; right: 10px; top: 10px; display: grid; place-items: center; width: 36px; height: 36px; padding: 0; color: #1b2340; background: #fff; border: 2.5px solid #1b2340; border-radius: 50%; cursor: pointer; }
  .isl-board-x:hover { background: #eef2ff; }
  .isl-board-x svg { width: 15px; height: 15px; }
  .isl-board-x:focus-visible { outline: 3px solid #4fe3c1; outline-offset: 2px; }

  /* The camera's flash. */
  .isl-flash { position: absolute; inset: 0; z-index: 8; background: #fff; opacity: 0; pointer-events: none; }
  .isl-box.is-flashing .isl-flash { animation: isl-flash 0.55s ease-out; }
  @keyframes isl-flash { 0% { opacity: 0; } 12% { opacity: 0.85; } 100% { opacity: 0; } }
  .isl-down:active { transform: translateX(-50%) translateY(4px); }

  /* The card that pops up over a building. */
  .isl-card {
    --arrow: 50%;
    position: absolute; left: 0; top: 0; z-index: 6;
    width: min(290px, calc(100% - 24px));
    padding: 16px 16px 14px;
    background: #fff; border: 3px solid #1b2340; border-radius: 20px; box-shadow: 0 6px 0 #1b2340;
    opacity: 0; scale: 0.9;
    transition: opacity 0.18s, scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: var(--arrow) 100%;
    pointer-events: none;
  }
  .isl-card.is-on { opacity: 1; scale: 1; pointer-events: auto; }
  .isl-card::after {
    content: ''; position: absolute; left: calc(var(--arrow) - 11px); bottom: -14px;
    width: 18px; height: 18px; background: #fff; border: 3px solid #1b2340; border-top: 0; border-left: 0;
    transform: rotate(45deg); border-radius: 0 0 5px 0;
  }
  .isl-card.is-below { transform-origin: var(--arrow) 0; }
  .isl-card.is-below::after { bottom: auto; top: -14px; transform: rotate(-135deg); }
  .isl-card::before { content: ''; position: absolute; left: 12px; right: 12px; top: 12px; height: 6px; border-radius: 3px; background: var(--tint, #e3e9ff); opacity: 0; }
  .isl-card-title { margin: 0; font-size: 23px; font-weight: 700; line-height: 1.05; letter-spacing: -0.01em; }
  .isl-card-blurb { margin: 6px 0 0; font-size: 15px; line-height: 1.35; color: #4a5372; font-weight: 500; }
