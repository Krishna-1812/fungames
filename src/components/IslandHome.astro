        )}
      </div>
    </footer>
  </main>

  <script type="application/json" id="isl-data" set:html={JSON.stringify({ ...data, daily: daily.slug })} />
</Paper>

<script>
  import { initIsland, type GameInfo } from '../lib/island/camera'
  import { flagNodes, balloonNodes } from '../lib/island/extras'
  import { RULES } from '../lib/island/moves'
  import type { Node } from '../lib/island/scene'
  import { flip, PLAY } from '../lib/motion'
  import { bestKey, dailyFor } from '../data/game-meta'
  import { readDaily, streakOf, calendar, utcDay } from '../lib/daily'
  import { faviconHref } from '../lib/favicon'
  import { readPassport, withHistory, newStamps, markSeen, rankFor, stampDate, clearPassport, type Visit } from '../lib/passport'
  import { readAll } from '../lib/stats'
  import { islandSound } from '../lib/island/sound'
  import { isMuted, setMuted, unlock, mayPlay } from '../lib/audio'
  import { track, onLeave } from '../lib/analytics/client'
  import { readBottles, findBottle, wearCover, count, NOTES, COVERS, ALL_COVERS, BOTTLE_COUNT, type Cover } from '../lib/bottles'
  import { gather, sync, progress, readQuests, unseen, markQuestsSeen, questCovers } from '../lib/quests'
  import { drawPostcard, crop, shapeFor, photoSize, STAMP_PHOTO } from '../lib/island/postcard'
  import { createPlay, type PlayData } from '../lib/island/play'
  import { timetable, isFest, type Row } from '../lib/island/timetable'
  import { seasonOn, nextSeason, seeSeason, SEASONS as SEASON_NAMES, type SeasonKey } from '../lib/island/seasons'
  import { readLink, cleanCode, showCode } from '../lib/sync'
  import { makeCode, useCode, forgetCode, deleteSave } from '../lib/sync-client'
  import { state as remindState, turnOn, turnOff, downloadCalendar, hourWords, readPref } from '../lib/remind'

  // The lighthouse in the tab says hello: once when the page opens, and again
  // each time you switch away to another tab, it flashes the island's Morse
  // "HI" and then stays lit. One unit is a whole second, because a tab in the
  // background only gets its timers about once a second.
  if (PLAY) {
    const icon = document.getElementById('favicon') as HTMLLinkElement | null
    const on = faviconHref(true), off = faviconHref(false)
    // .... (gap) .. then a pause before it settles lit, as alternating
    // on/off lengths in units
    const HI = [1, 1, 1, 1, 1, 1, 1, 3, 1, 1, 1, 2]
    let timer = 0
    const flash = () => {
      if (!icon) return
      clearTimeout(timer)
      let i = 0
      const step = () => {
        if (i >= HI.length) { icon.href = on; return }
        icon.href = i % 2 ? off : on
        timer = window.setTimeout(step, HI[i++] * 1000)
      }
      icon.href = off
      timer = window.setTimeout(step, 1000)
    }
    flash()
    document.addEventListener('visibilitychange', () => { if (document.hidden) flash() })
  }

  const data = JSON.parse(document.getElementById('isl-data')!.textContent!) as {
    bounds: [number, number, number, number]
    land: [number, number, number, number]
    coast: [number, number][]
    districts: { key: string; name: string; x: number; y: number }[]
    anchors: Record<string, { x0: number; y0: number; x1: number; y1: number; bx: number; by: number; district: string; slug: string }>
    games: Record<string, GameInfo>
    slugs: string[]
    base: string
    posterScale: number
    pokes: string[]
    bottles: { n: number; district: string; where: string }[]
    play: PlayData
    grid: string
    inks: Record<string, string>
  }
  const box = document.getElementById('islBox')!
  /* ---- the cartoon island or the realistic one: the other page, remembered for next time ---- */
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.isl-world-opt')) {
    a.addEventListener('click', (ev) => {
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return
      ev.preventDefault()
      if (a.getAttribute('aria-current') === 'page') return
      try { localStorage.setItem('isl-world', a.dataset.world!); sessionStorage.setItem('isl-swap', '1') } catch {}
      track('isl_world', { to: a.dataset.world! })
      // The pill turns over at once; the page follows.
      for (const b of document.querySelectorAll('.isl-world-opt')) b.removeAttribute('aria-current')
      a.setAttribute('aria-current', 'page')
      location.assign(a.href + location.search)
    })
  }
  const byId = (id: string) => document.getElementById(id)!
  // The baked island: asked for at once, and the camera works over the poster until it is in.
  const scene = fetch(data.base + 'scene.json').then((r) => (r.ok ? r.json() : Promise.reject(new Error(`scene.json: ${r.status}`))))

  /* ---- bests, from this browser ------------------------------------------ */
  const readBest = (slug: string): string | null => {
    try { const v = JSON.parse(localStorage.getItem(bestKey(slug)) ?? 'null'); return typeof v?.text === 'string' ? v.text : null } catch { return null }
  }
  for (const s of data.slugs) data.games[s].best = readBest(s)
  const stats = readAll()
  const finished = new Set(data.slugs.filter((s) => data.games[s].best || (stats.games[s]?.plays ?? 0) > 0))
  // Every game this browser has been to: the passport's stamps, and any game
  // with a score from before the passport existed.
  const visits = (): Record<string, Visit> => withHistory(readPassport(), readAll(), data.slugs.filter((s) => data.games[s].best))
  let sound: ReturnType<typeof islandSound> | null = null
  document.querySelectorAll<HTMLElement>('[data-best]').forEach((el) => { const b = data.games[el.dataset.best!]?.best; if (b) { el.textContent = `Best ${b}`; el.classList.add('has-best') } })

  /* ---- things to poke, and secrets to find ---------------------------------- */
  const NAMES: Record<string, string> = { whale: 'the whale', dawnwhale: 'the dawn whale', sheep: 'a sheep', windmill: 'the windmill', balloon: 'a balloon', crab: 'a crab', fountain: 'the fountain', kite: 'a kite', dolphin: 'a dolphin', duck: 'a duck', gull: 'a gull', deer: 'the deer', ferry: 'the ferry', castaway: 'the castaway', treasure: 'the buried treasure', house32: 'the 32nd building', ufo: 'a UFO' }
  const foundEl = document.getElementById('islFound') as HTMLButtonElement, toastEl = document.getElementById('islToast')!
  // The bottles are counted one by one on a page of their own, not among the sightings.
  const kinds = data.pokes.filter((k) => k !== 'bottle' && k !== 'notice')
  const readFound = () => { try { return new Set<string>(JSON.parse(localStorage.getItem('isl-found') ?? '[]')) } catch { return new Set<string>() } }
  const found = readFound()
  let toastT = 0
  const toast = (msg: string, ms = 3400) => { toastEl.textContent = msg; toastEl.classList.add('is-on'); clearTimeout(toastT); toastT = window.setTimeout(() => toastEl.classList.remove('is-on'), ms) }
  const showFound = () => {
    const n = kinds.filter((k) => found.has(k)).length
    foundEl.hidden = n === 0
    foundEl.textContent = n === kinds.length ? `All ${n} found` : `${n} of ${kinds.length} found`
  }
  foundEl.addEventListener('click', () => toast(found.size >= kinds.length ? 'Every secret on the island. You know it better than we do.' : 'Poke anything that moves. Some things only come at certain hours.'))
  showFound()

  /* ---- messages in bottles ------------------------------------------------- */
  // Tap one and it hops, the cork comes out, and its note unrolls over the
  // map; then it is gone from the beach (for good, in this browser). Every
  // three found earns the passport a new cover (lib/bottles).
  const bottlesEl = byId('islBottles') as HTMLButtonElement, noteEl = byId('islNote')
  const showBottles = () => {
    const n = count(readBottles())
    bottlesEl.hidden = n === 0
    byId('islBottlesN').textContent = `${n} of ${BOTTLE_COUNT}`
    bottlesEl.setAttribute('aria-label', `Messages in bottles: ${n} of ${BOTTLE_COUNT} found. Open them in the passport`)
  }
  showBottles()
  let noteT = 0
  const hideNote = () => { clearTimeout(noteT); noteEl.classList.remove('is-on'); noteT = window.setTimeout(() => { noteEl.hidden = true }, 300) }
  function showNote(n: number, total: number, cover: Cover | null) {
    const note = NOTES[n]; if (!note) return
    byId('islNoteNo').textContent = `Message in a bottle · No. ${n}`
    byId('islNoteText').textContent = `“${note.text}”`
    byId('islNoteFrom').textContent = `— ${note.from}`
    byId('islNoteCount').textContent = total >= BOTTLE_COUNT && cover
      ? `Every bottle found! The ${cover.name} cover is yours.`
      : cover ? `${total} of ${BOTTLE_COUNT} found · new passport cover: ${cover.name}` : `${total} of ${BOTTLE_COUNT} found`
    noteEl.classList.toggle('has-prize', !!cover)
    clearTimeout(noteT)
    noteEl.hidden = false
    noteEl.classList.remove('is-on'); void noteEl.offsetWidth
    noteEl.classList.add('is-on')
    noteT = window.setTimeout(hideNote, 16000)
  }
  noteEl.addEventListener('pointerenter', () => clearTimeout(noteT))
  noteEl.addEventListener('pointerleave', () => { clearTimeout(noteT); noteT = window.setTimeout(hideNote, 6000) })
  byId('islNoteX').addEventListener('click', hideNote)
  // Back to the map: a hand on it puts the note away (on a phone it covers much of the view).
  byId('islStage').addEventListener('pointerdown', () => { if (!noteEl.hidden && noteEl.classList.contains('is-on')) hideNote() })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !noteEl.hidden) hideNote() })
  const onBottle = (n: number) => {
    const r = findBottle(n)
    track('isl_bottle', { n, first: r.first, total: r.total })
    sound?.poke('bottle')
    if (r.first) {
      sound?.found(); sound?.unroll()
      // It hops first, then fades from the sand.
      window.setTimeout(() => isle.withEngine((e) => { e.setGone([n]); isle.redraw() }), PLAY ? 950 : 0)
      showBottles()
    }
    showNote(n, r.total, r.cover)
  }

  const onPoke = (kind: string, n?: number) => {
    if (kind === 'bottle') { if (n) onBottle(n); return }
    if (kind === 'notice') { openBoard('map'); return }
    const first = !found.has(kind)
    track('isl_poke', { kind, first })
    if (first) { found.add(kind); try { localStorage.setItem('isl-found', JSON.stringify([...found])) } catch {} showFound(); sound?.found() }
    sound?.poke(kind)
    const tally = `${kinds.filter((k) => found.has(k)).length} of ${kinds.length}`
    if (kind === 'house32') { toast(`You found the 32nd building. It is not a game. Not yet. (${tally})`, 5000); return }
    if (kind === 'treasure') { toast(`Buried treasure! It is full of maps of other islands. (${tally})`, 5000); return }
    if (first) toast(found.size === kinds.length ? `You found ${NAMES[kind] ?? kind}, and that is all ${kinds.length}. Well done.` : `You found ${NAMES[kind] ?? kind}. ${tally}`)
  }

  /* ---- what answers back: a ball, pigeons, the water, the parade (lib/island/play) ---- */
  /* ---- analytics: what the island's visitors do (lib/analytics/shape.ts lists it all) ---- */
  let diveFrom = 'map'
  const carded = new Set<string>()
  const play = createPlay({
    data: data.play, grid: data.grid, play: PLAY, base: data.base,
    daily: () => dailyFor(new Date()).slug,
    ink: () => data.inks[data.anchors[dailyFor(new Date()).slug]?.district] ?? '#5b82ff',
    sound: () => sound,
    // Once in a while is enough to know people do it.
    onScare: (all) => { const now = Date.now(); if (now - scaredAt > 30_000) { scaredAt = now; track('isl_pigeons', { bell: all }) } },
  })
  let scaredAt = 0
  const ask0 = new URLSearchParams(location.search)
  const fest = () => isFest(new Date()) || ask0.get('fest') === '1'

  const isle = initIsland({
    box, stage: document.getElementById('islStage')!,
    canvas: document.getElementById('islCanvas') as HTMLCanvasElement,
    poster: document.getElementById('islPoster') as HTMLImageElement | null, posterScale: data.posterScale,
    scene, base: data.base,
    state: () => ({ time: box.dataset.time ?? 'day', season: box.dataset.season ?? '', hour: Number(box.dataset.hour ?? new Date().getHours()), fest: fest() }),
    bounds: data.bounds, land: data.land, districts: data.districts, anchors: data.anchors, games: data.games,
    links: new Map([...box.querySelectorAll<HTMLAnchorElement>('.isl-lm')].map((a) => [a.dataset.slug!, a])),
    onPoke, onEnter: (slug) => { sound?.dive(data.games[slug].href, PLAY); track('isl_dive', { from: diveFrom }, slug); diveFrom = 'map' },
    onBack: () => sound?.back(),
    onCard: (slug) => { if (!carded.has(slug)) { carded.add(slug); track('isl_card', {}, slug) } },
    grab: (x, y, z, touch) => {
      const h = play.grab(x, y, z, touch)
      return h && { move: h.move, up() { h.up(); track('isl_ball', { touch }) } }
    }, pointer: play.pointer, grabbable: play.overBall,
    // Where people tap, for the admin page's heat-map: rounded to ten map units, and at most eighty a visit.
    onTap: (x, y, z, hit, what) => { if (taps++ < 80) track('isl_tap', { x: Math.round(x / 10) * 10, y: Math.round(y / 10) * 10, z: Math.round(z * 100) / 100, hit, what }) },
  })
  let taps = 0
  isle.withEngine((e) => e.setLive(play.live))

  // How the island was explored, summed up as the page is left: drags,
  // wheel turns, the closest it was looked at, and which districts were in
  // the middle of the screen at some point (sampled every two seconds).
  {
    const seen = new Set<string>()
    let drags = 0, wheels = 0, closest = Infinity, looked = 0
    // Where the middle of the screen was, every two seconds, on a 10 × 7 grid
    // over the map (one base-36 digit a cell, up to 35): the heat-map of looking.
    const LOOK_W = 10, LOOK_H = 7, look = new Array<number>(LOOK_W * LOOK_H).fill(0)
    const stageEl = document.getElementById('islStage')!
    stageEl.addEventListener('pointerdown', () => { drags++ }, { passive: true })
    stageEl.addEventListener('wheel', () => { wheels++ }, { passive: true })
    let minied = 0
    const mapBtn = document.getElementById('islMapBtn')!
    const setMap = (on: boolean) => { box.classList.toggle('is-map', on); mapBtn.setAttribute('aria-expanded', String(on)); mapBtn.setAttribute('aria-label', on ? 'Fold the map away' : 'Show the map') }
    try { setMap(localStorage.getItem('isl-map') === 'open') } catch { setMap(false) }
    mapBtn.addEventListener('click', () => { const on = !box.classList.contains('is-map'); setMap(on); try { if (on) localStorage.setItem('isl-map', 'open'); else localStorage.removeItem('isl-map') } catch {} })
    box.querySelector('.isl-mini svg')?.addEventListener('pointerdown', () => { if (Date.now() - minied > 20_000) { minied = Date.now(); track('isl_minimap') } })
    setInterval(() => {
      if (document.visibilityState !== 'visible' || !isle.awake()) return
      const v = isle.view()
      looked += 2
      closest = Math.min(closest, v.w)
      const [bx, by, bw, bh] = data.bounds
      const cx = Math.floor(((v.x - bx) / bw) * LOOK_W), cy = Math.floor(((v.y - by) / bh) * LOOK_H)
      if (cx >= 0 && cx < LOOK_W && cy >= 0 && cy < LOOK_H) look[cy * LOOK_W + cx] = Math.min(35, look[cy * LOOK_W + cx] + 1)
      let best = '', bd = Infinity
      for (const d of data.districts) { const dd = Math.hypot(d.x - v.x, d.y - v.y); if (dd < bd) { bd = dd; best = d.key } }
      if (best && v.w < data.bounds[2] * 0.6) seen.add(best)
    }, 2000)
    onLeave(() => {
      if (!looked) return
      track('isl_session', { drags, wheels, secs: looked, closest_w: Number.isFinite(closest) ? Math.round(closest) : 0, districts: [...seen].sort().join(' '), n_districts: seen.size, cards: carded.size, look: look.map((c) => c.toString(36)).join(''), taps })
    })
    // How smoothly it draws on this device: five seconds of frames, once, a little after it has settled.
    setTimeout(() => {
      if (document.visibilityState !== 'visible' || !PLAY) return
      let frames = 0, slow = 0, last = performance.now()
      const t0 = last
      const step = (now: number) => {
        frames++
        if (now - last > 50) slow++
        last = now
        if (now - t0 < 5000) requestAnimationFrame(step)
        else track('isl_fps', { fps: Math.round((frames * 1000) / (now - t0)), slow, dpr: devicePixelRatio, w: innerWidth })
      }
      requestAnimationFrame(step)
    }, 8000)
  }
  // ?perf: the live things too, for scripts that test them.
  if (ask0.has('perf')) { Object.assign(window, { __play: play }); Object.defineProperty(window, '__sound', { get: () => sound }) }
  // The bottles found on earlier visits are not on the beaches any more.
  isle.withEngine((e) => e.setGone(Object.keys(readBottles().found).map(Number)))
  // The map is a window, not a scroller: focusing a building near the edge
  // must never scroll the box itself and push the top bar out of view.
  box.addEventListener('scroll', () => { box.scrollLeft = 0; box.scrollTop = 0 })
  document.getElementById('zIn')!.addEventListener('click', isle.zoomIn)
  document.getElementById('zOut')!.addEventListener('click', isle.zoomOut)
  document.getElementById('zHome')!.addEventListener('click', isle.home)

  /* ---- day and night, by the visitor's own clock ---------------------------- */
  // Dawn from six, day from eight, dusk from six in the evening, night from
  // eight. The sun/moon button picks day or night by hand, remembered in this
  // browser; picking what the clock would have chosen goes back to the clock.
  const btnTime = document.getElementById('btnTime')!
  // The season, from the visitor's own date: snow from December to Twelfth
  // Night, fireworks on New Year's Eve and Day, blossom in April. A page can
  // ask for one (?season=winter, spring or newyear) and for a time of day
  // (?time=night), to see it out of season.
  const ask = new URLSearchParams(location.search)
  const bySeason = (d = new Date()) => seasonOn(d)?.key ?? ''
  const season = ask.get('season') ?? bySeason()
  if (season) box.dataset.season = season
  // A season really here (not one asked for) goes in the passport's count of seasons seen.
  if (!ask.get('season') && season) { try { seeSeason(season as SeasonKey, localStorage) } catch { /* storage blocked */ } }
  // The hour, for the secrets that keep their own (?hour=3 asks for one).
  const showHour = () => { box.dataset.hour = ask.get('hour') ?? String(new Date().getHours()); isle.redraw() }
  showHour(); setInterval(showHour, 60 * 1000)
  const byClock = (h = new Date().getHours()) => (h >= 6 && h < 8 ? 'dawn' : h >= 8 && h < 18 ? 'day' : h >= 18 && h < 20 ? 'dusk' : 'night')
  const readTime = () => { try { return localStorage.getItem('isl-time') } catch { return null } }
  const showTime = () => {
    const forced = ask.get('time'), chosen = readTime()
    const t = forced && ['dawn', 'day', 'dusk', 'night'].includes(forced) ? forced : chosen === 'day' || chosen === 'night' ? chosen : byClock()
    box.dataset.time = t
    const dark = t === 'night' || t === 'dusk'
    btnTime.setAttribute('aria-pressed', String(dark))
    btnTime.setAttribute('aria-label', dark ? 'Switch to day' : 'Switch to night')
    isle.redraw()
  }
  // How the island looks and sounds: one button in the bar, its choices in a panel under it.
  const btnMore = document.getElementById('btnMore')!, morePanel = document.getElementById('islMorePanel')!
  const setMore = (on: boolean) => { morePanel.hidden = !on; btnMore.setAttribute('aria-expanded', String(on)) }
  btnMore.addEventListener('click', () => setMore(morePanel.hidden))
  document.addEventListener('pointerdown', (e) => { if (!morePanel.hidden && !(e.target as Element).closest?.('.isl-more')) setMore(false) }, true)
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !morePanel.hidden) { setMore(false); btnMore.focus() } })
  btnTime.addEventListener('click', () => {
    const next = box.dataset.time === 'night' || box.dataset.time === 'dusk' ? 'day' : 'night'
    const clock = byClock(), clockDark = clock === 'night' || clock === 'dusk'
    try { if ((next === 'night') === clockDark) localStorage.removeItem('isl-time'); else localStorage.setItem('isl-time', next) } catch {}
    track('isl_time', { mode: next })
    showTime()
  })
  showTime()
  setInterval(showTime, 5 * 60 * 1000)

  /* ---- on the map for this visitor: a flag on every building finished, ---- */
  /* ---- and today's challenge, a balloon tied over its building ----------- */
  const today = dailyFor(new Date())
  const ta = data.anchors[today.slug]
  // The mini-map's pins: every game played in this browser, and today's challenge.
  {
    const been = visits()
    for (const pin of box.querySelectorAll<SVGCircleElement>('.isl-mini-pin')) {
      const s = pin.dataset.slug!
      pin.classList.toggle('is-done', !!been[s] || finished.has(s))
      pin.classList.toggle('is-today', s === today.slug)
    }
  }
  isle.withEngine((e) => {
    const nodes: Node[] = []
    for (const s of data.slugs) { if (!finished.has(s)) continue; const a = data.anchors[s]; nodes.push(...flagNodes(a.x1 - 14, a.y0 + 18)) }
    if (ta) nodes.push(...balloonNodes((ta.x0 + ta.x1) / 2, ta.y0))
    e.add(nodes)
  })
  // The daily challenge's streak: a number on the Today button, and the noticeboard's top row.
  const paintStreak = () => {
    const f = readDaily(), day = utcDay(), st = streakOf(f.days, day, f.best)
    const title = data.games[today.slug]?.title ?? today.title
    const badge = byId('islStreakN')
    badge.textContent = String(st.n); badge.hidden = st.n < 1
    byId('btnToday').setAttribute('aria-label', st.n ? `Today: ${st.n}-day streak` : 'Today')
    byId('islStreakNum').textContent = String(st.n)
    byId('islStreakBig').hidden = st.n < 1
    const cal = byId('islStreakCal')
    cal.hidden = !Object.keys(f.days).length
    cal.innerHTML = calendar(f.days, day, st.forgiven).map((c) => `<li class="isl-bs-dot is-${c.state}" title="${c.day}"></li>`).join('')
    byId('islStreakLine').textContent = st.today
      ? `${st.today.ok ? '✓ Today’s challenge beaten.' : '✓ Today’s challenge played.'} Come back for the next one.`
      : st.n
        ? `Finish ${title} today to keep your streak. One missed day a week is forgiven.`
        : `Finish today’s challenge (${title}) to start a streak. One missed day a week is forgiven.`
  }
  paintStreak()
  addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) paintStreak() })
  const goToday = () => {
    box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
    isle.flyToSlug(today.slug, 2.2)
    setTimeout(() => isle.showCard(today.slug, `Today: ${today.goal}`), PLAY ? 650 : 0)
  }
  document.getElementById('btnToday')!.addEventListener('click', () => { track('isl_today'); openBoard('today') })

  /* ---- the noticeboard: what's on, by the clock (lib/island/timetable) ---- */
  // Opened from the board itself on the map, or the Today button. It says
  // what is on now and next, and each line can take you there.
  const boardEl = byId('islBoard'), boardList = byId('islBoardList')
  let ferryPhase = (): number | null => null
  isle.withEngine((e) => { ferryPhase = () => e.phase('isl-ferry') })
  let boardT = 0
  const P = (i: number, j: number, z = 0): [number, number] => [(i - j) * 32, (i + j) * 16 - z]
  const go = (x: number, y: number, n: number) => { closeBoard(); box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' }); setTimeout(() => isle.flyToPoint(x, y, n), PLAY ? 250 : 0) }
  const lh = data.anchors['share-this-page']
  const ACTIONS: Partial<Record<Row['key'], [string, () => void]>> = {
    today: ['Take me there', () => { closeBoard(); goToday() }],
    parade: ['Show me', () => { const [x, y] = play.parade().on ? play.paradeAt() : play.square(); go(x, y - 14, 3.6) }],
    ferry: ['Show me', () => { const [x, y] = P(21.02, 29.75, -12); go(x, y - 20, 3) }],
    bells: ['Show me', () => { const [x, y] = play.square(); go(x, y - 10, 4) }],
    lighthouse: ['Show me', () => { if (lh) go((lh.x0 + lh.x1) / 2, (lh.y0 + lh.y1) / 2, 2.6) }],
    fireworks: ['Look', () => { closeBoard(); isle.home() }],
    whale: ['Show me', () => { const [x, y] = P(36, 21, -12); go(x, y, 2.2) }],
  }
  /** The season as the page shows it (one asked for with ?season= included), or the next one coming. */
  const seasonRow = (now: Date) => {
    const asked = ask.get('season') as SeasonKey | null, real = seasonOn(now)
    if (asked && real?.key !== asked) return SEASON_NAMES[asked] ? { season: { ...SEASON_NAMES[asked], until: new Date(now.getTime() + 864e5) } } : {}
    if (real) return { season: real }
    const n = nextSeason(now)
    return n ? { next: { name: n.season.name, line: n.season.line, from: n.from } } : {}
  }
  const rowsNow = () => timetable(new Date(), {
    daily: { title: data.games[today.slug]?.title ?? today.slug, goal: today.goal },
    parade: (() => { const p = play.parade(); return { on: p.on, next: p.next, to: data.games[p.to]?.title ?? p.to } })(),
    ferry: ferryPhase(), shown: box.dataset.time ?? 'day', seenThree: found.has('ufo'),
    ...seasonRow(new Date()),
  })
  function paintBoard(first = false) {
    const rows = rowsNow()
    byId('islBoardDate').textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long' }) + ' · ' + new Date().toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' })
    if (first) {
      boardList.replaceChildren(...rows.map((r, k) => {
        const li = document.createElement('li')
        li.className = 'isl-row'; li.dataset.key = r.key; li.style.setProperty('--tilt', `${((k * 7) % 5) - 2}deg`)
        li.innerHTML = '<span class="isl-row-pin" aria-hidden="true"></span><p class="isl-row-title"></p><p class="isl-row-line"></p><p class="isl-row-when"><i class="isl-row-dot" aria-hidden="true"></i><span></span></p>'
        const act = ACTIONS[r.key]
        if (act) { const b = document.createElement('button'); b.type = 'button'; b.className = 'isl-row-go'; b.textContent = act[0]; b.addEventListener('click', () => { track('isl_board_go', { row: r.key }); act[1]() }); li.append(b) }
        return li
      }))
    }
    for (const r of rows) {
      const li = boardList.querySelector<HTMLElement>(`[data-key="${r.key}"]`); if (!li) continue
      li.classList.toggle('is-now', r.now)
      li.querySelector('.isl-row-title')!.textContent = r.title
      li.querySelector('.isl-row-line')!.textContent = r.line
      li.querySelector('.isl-row-when span')!.textContent = r.when
      const b = li.querySelector<HTMLButtonElement>('.isl-row-go'); if (b) b.setAttribute('aria-label', `${b.textContent}: ${r.title}`)
    }
  }
  function openBoard(from: string) {
    track('isl_board', { from })
    hideNote(); isle.hideCard()
    paintBoard(true)
    boardEl.hidden = false
    boardEl.classList.remove('is-on'); void boardEl.offsetWidth; boardEl.classList.add('is-on')
    clearInterval(boardT); boardT = window.setInterval(() => paintBoard(), 1000)
    sound?.page()
    boardEl.querySelector<HTMLButtonElement>('.isl-row-go')?.focus({ preventScroll: true })
  }
  function closeBoard() {
    if (boardEl.hidden) return
    clearInterval(boardT)
    boardEl.classList.remove('is-on')
    window.setTimeout(() => { if (!boardEl.classList.contains('is-on')) boardEl.hidden = true }, 260)
  }
  byId('islBoardX').addEventListener('click', closeBoard)
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !boardEl.hidden) closeBoard() })
  byId('islStage').addEventListener('pointerdown', closeBoard)

  /* ---- the clock's own events: the bell on the hour, the parade's drum ---- */
  {
    let rung = -1, beat = 0
    setInterval(() => {
      const d = new Date()
      if (d.getMinutes() === 0 && d.getSeconds() < 4 && rung !== d.getHours()) {
        rung = d.getHours()
        if (isle.awake()) { play.bells(); sound?.bells(d.getHours() % 12 || 12) }
      }
    }, 1000)
    // The band, heard while the parade is on screen.
    setInterval(() => {
      if (!sound?.on || !isle.awake() || !play.parade().on) return
      const [x, y] = play.paradeAt(), v = isle.view()
      if (Math.abs(x - v.x) < v.w * 0.6 && Math.abs(y - v.y) < v.h * 0.6) sound.drum(beat++)
    }, 400)
  }

  /* ---- surprise me: somewhere you have not been yet, and straight in ------ */
  // The camera flies there, the card says where, and then it dives in. Any
  // touch on the map, or Escape, calls it off and leaves you looking.
  let lastPick = '', diveT = 0
  const callOff = () => { if (!diveT) return; clearTimeout(diveT); diveT = 0; box.classList.remove('is-surprising') }
  box.addEventListener('pointerdown', (e) => { if (!(e.target as Element).closest('#btnSurprise')) callOff() }, true)
  box.addEventListener('keydown', (e) => { if (e.key === 'Escape') callOff() })
  document.getElementById('btnSurprise')!.addEventListener('click', () => {
    callOff()
    const been = visits()
    const fresh = data.slugs.filter((x) => !been[x] && x !== lastPick)
    const pool = fresh.length ? fresh : data.slugs.filter((x) => x !== lastPick)
    const s = pool[Math.floor(Math.random() * pool.length)]
    lastPick = s
    track('isl_surprise', { fresh: fresh.length }, s)
    const line = fresh.length ? (fresh.length === 1 ? 'The last place on the island you have not been. In you go…' : 'Somewhere you have not been yet. In you go…') : 'You have been everywhere, so: an old favourite. In you go…'
    box.scrollIntoView({ behavior: PLAY ? 'smooth' : 'auto', block: 'start' })
    isle.hideCard()
    isle.home()
    box.classList.add('is-surprising')
    setTimeout(() => isle.flyToSlug(s, 2.4), PLAY ? 420 : 0)
    setTimeout(() => isle.showCard(s, line), PLAY ? 1250 : 0)
    diveT = window.setTimeout(() => { diveT = 0; box.classList.remove('is-surprising'); diveFrom = 'surprise'; isle.enter(s) }, PLAY ? 3100 : 1800)
  })

  /* ---- sound: off until asked for, and then the island is heard ------------ */
  // The same switch as every game's speaker button: turning it on here turns
  // it on there, and the other way round.
  const btnSound = document.getElementById('btnSound')!
  {
    // Where the ferry is along its crossing (0..1), to hear its horn from there.
    // And where the drawn surf is in its roll, so the sound breaks with it (only while the waves move).
    let ferry = (): number | null => null, surf = (): number | null => null
    isle.withEngine((e) => { ferry = () => e.phase('isl-ferry'); if (PLAY) surf = () => e.phase('isl-surf') })
    const uf = data.anchors['universe-forecast']
    // Whatever is open over the island, from a game's card to the passport: the island heard through a door.
    const card = box.querySelector('.isl-card')!, board = byId('islBoard'), books = [byId('pp'), byId('pc')] as HTMLDialogElement[]
    const focus = () => books.some((d) => d.open) ? 0.3 : board.classList.contains('is-on') ? 0.5 : card.classList.contains('is-on') ? 0.72 : 1
    sound = islandSound(
      { districts: Object.fromEntries(data.districts.map((d) => [d.key, { x: d.x, y: d.y }])), rain: uf ? { x: (uf.x0 + uf.x1) / 2, y: uf.y0 } : undefined, land: data.land, coast: data.coast.map(([x, y]) => ({ x, y })) },
      { view: isle.view, time: () => box.dataset.time ?? 'day', season: () => box.dataset.season ?? '', awake: isle.heard, focus, surf: () => surf(), ferry: () => ferry(), fest },
    )
  }
  const paintSound = () => {
    const on = !isMuted()
    btnSound.setAttribute('aria-pressed', String(on))
    btnSound.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on')
  }
  paintSound()
  const soundOn = () => { unlock(); setMuted(false); sound!.start(); paintSound(); toast('Sound on. Fly round the island and listen: every district sounds like itself.') }
  btnSound.addEventListener('click', () => {
    if (isMuted()) soundOn()
    else { setMuted(true); sound!.stop(); paintSound() }
    track('sound', { on: !isMuted() })
    welcomeAway()
  })

  /* ---- a first visit: one line to say hello, and ask about sound ------------ */
  // Never in the way: it sits where the hint would, says what the island is,
  // and offers sound (which a browser will not play until asked). It goes when
  // closed, when sound is answered, or a while after the map is first used,
  // and it is only ever shown once.
  const welcome = byId('islWelcome')
  let welcomeT = 0
  function welcomeAway() {
    if (welcome.hidden || welcome.classList.contains('is-going')) return
    clearTimeout(welcomeT)
    welcome.classList.add('is-going'); welcome.classList.remove('is-on')
    window.setTimeout(() => { welcome.hidden = true }, 450)
  }
  {
    let first = false
    try { first = !localStorage.getItem('isl-welcomed') && !Object.keys(visits()).length && !count(readBottles()) } catch {}
    if (first) {
      box.classList.add('is-welcoming')
      try { localStorage.setItem('isl-welcomed', '1') } catch {}
      // Sound already chosen in a game: nothing to ask.
      byId('welcomeSound').hidden = !isMuted()
      window.setTimeout(() => { welcome.hidden = false; requestAnimationFrame(() => welcome.classList.add('is-on')) }, PLAY ? 1400 : 0)
      byId('welcomeSound').addEventListener('click', () => { track('isl_welcome', { answer: 'sound' }); soundOn(); welcomeAway() })
      byId('welcomeX').addEventListener('click', () => { track('isl_welcome', { answer: 'closed' }); welcomeAway() })
      // Once the map is being used, it has done its job: it goes a little later.
