                      <polygon points={a.foot} fill="#ffffff" fill-opacity="0.75" stroke="#1b2340" stroke-opacity="0.18" stroke-width="1.5" />
                    </svg>
                  </span>
                  <span class="gc-body">
                    <span class="gc-title">{g.title}</span>
                    <span class="gc-blurb">{g.blurb}</span>
                    <span class="gc-foot">
                      <span class="gc-tag">{META[g.slug]?.difficulty ?? 'Explore'}</span>
                      <span class="gc-best" data-best={g.slug}></span>
                    </span>
                  </span>
                </a>
                <button type="button" class="gc-pin" data-pin={g.slug} aria-label={`Show ${g.title} on the island`}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 18s-5.5-5.2-5.5-9.3A5.5 5.5 0 0 1 15.5 8.7C15.5 12.8 10 18 10 18z" fill="currentColor" /><circle cx="10" cy="8.6" r="2" fill="#fff" /></svg>
                </button>
              </li>
            )
          })}
        </ul>
        <p class="gs-empty" id="empty" hidden>Nothing matches that. Try a shorter word.</p>
