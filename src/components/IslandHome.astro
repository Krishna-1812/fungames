        {SITE.buyMeACoffee && (
          <a class="ft-coffee" href={`https://www.buymeacoffee.com/${SITE.buyMeACoffee}`} target="_blank" rel="noopener">
            <span class="ft-coffee-icon" aria-hidden="true" set:html={inkIcon('coffee')} />
            <span>Buy me a coffee</span>
