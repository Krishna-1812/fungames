---
import TileArt from './TileArt.astro'
import type { Game } from '../data/games'

interface Props { game: Game; index?: number }
const { game, index = 0 } = Astro.props
const ink = game.onAccent ?? '#ffffff'
---

<a
  class="tile"
  href={`/${game.slug}/`}
  style={`--a:${game.accent}; --b:${game.accent2}; --ink:${ink}; --i:${index}`}
>
  <TileArt art={game.art} seed={index + 1} />
  <div class="body">
    <h2>{game.title}</h2>
    <p>{game.blurb}</p>
  </div>
  <span class="glyph" aria-hidden="true">{game.glyph}</span>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 172px;
    padding: 22px 24px;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(135deg, var(--a), var(--b));
    box-shadow: var(--shadow);
    isolation: isolate;
    transition: transform 220ms var(--ease), box-shadow 220ms var(--ease);
    /* Staggered entrance, capped so a long grid does not crawl in. */
    animation: rise 520ms var(--ease) backwards;
    animation-delay: calc(min(var(--i), 11) * 45ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
  }

  /* A soft vignette keeps text readable over the brighter end of the gradient. */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0.1) 46%, transparent 72%);
    z-index: -1;
  }

  .tile:hover,
  .tile:focus-visible {
    transform: translateY(-5px) scale(1.008);
    box-shadow: var(--shadow-lg);
  }
  .tile:active { transform: translateY(-1px) scale(0.994); }

  /* A light sweeps across on hover. Purely decorative, but it is the thing
     that makes the grid feel like objects rather than rectangles. */
  .tile::before {
    content: '';
    position: absolute;
    inset: -40% -10%;
    background: linear-gradient(76deg, transparent 38%, rgba(255, 255, 255, 0.16) 50%, transparent 62%);
    transform: translateX(-120%);
    transition: transform 720ms var(--ease);
    pointer-events: none;
  }
  .tile:hover::before,
  .tile:focus-visible::before { transform: translateX(120%); }

  /* The art drifts a little further than the card, which reads as depth. */
  .tile :global(.art) {
    transition: transform 420ms var(--ease), opacity 420ms var(--ease);
  }
  .tile:hover :global(.art),
  .tile:focus-visible :global(.art) { transform: translate(-5px, -4px) scale(1.06); }

  .body { position: relative; max-width: 62%; }

  h2 {
    font-size: clamp(22px, 2.3vw, 29px);
    margin: 0 0 6px;
    text-wrap: balance;
  }
  p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.4;
    opacity: 0.82;
    text-wrap: pretty;
  }

  .glyph {
    position: absolute;
    top: 18px;
    right: 20px;
    font-size: 22px;
    line-height: 1;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
  }

  @media (max-width: 700px) {
    .tile { min-height: 148px; padding: 18px 20px; }
    .body { max-width: 68%; }
  }
</style>
