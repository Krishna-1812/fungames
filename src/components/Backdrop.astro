---
/**
 * The living backdrop behind a page.
 *
 * This sits *under* content and is deliberately low-contrast. The site's
 * accessibility bar is zero colour-contrast failures on every page, and text is
 * composited against whatever this draws — so the shader is constrained to a
 * few percent of luminance swing around the page background rather than being
 * allowed to paint whatever it likes. It reads as depth and light, not as a
 * picture.
 *
 * A real CSS gradient stays behind the canvas so a machine without WebGL2, or
 * one that has lost its GPU process, still gets a finished-looking page.
 */
interface Props {
  /** 'paper' for the light pages, 'void' for the dark game chrome. */
  variant?: 'paper' | 'void'
  /** Base colours, only used by the 'void' variant. */
  a?: string
  b?: string
}
const { variant = 'paper', a = '#0a0a12', b = '#141426' } = Astro.props

const hexToVec = (h: string) => {
  const n = parseInt(h.replace('#', ''), 16)
  return [(n >> 16 & 255) / 255, (n >> 8 & 255) / 255, (n & 255) / 255]
}
const va = hexToVec(a)
const vb = hexToVec(b)
---

<div
  class:list={['backdrop', `backdrop-${variant}`]}
  data-backdrop={variant}
  data-a={va.join(',')}
  data-b={vb.join(',')}
  aria-hidden="true"
>
</div>

<script>
  import { ShaderSurface, glsl } from '../lib/gl'

  const host = document.querySelector<HTMLElement>('[data-backdrop]')
  if (host) {
    const variant = host.dataset.backdrop
    const a = (host.dataset.a ?? '0,0,0').split(',').map(Number)
    const b = (host.dataset.b ?? '0,0,0').split(',').map(Number)

    /* Shared body: a slow domain-warped field lit by two drifting sources.
       Domain warping (feeding noise back into its own coordinates) is what
       turns generic cloud noise into something that looks like it has
       structure and flow rather than static fuzz. */
    const FIELD = `
      float field(vec2 p, float t) {
        vec2 q = vec2(fbm(p + vec2(0.0, t * 0.05), 4),
                      fbm(p + vec2(5.2, 1.3) - t * 0.04, 4));
        vec2 r = vec2(fbm(p + 4.0 * q + vec2(1.7, 9.2) + t * 0.03, 4),
                      fbm(p + 4.0 * q + vec2(8.3, 2.8) - t * 0.02, 4));
        return fbm(p + 4.0 * r, 5);
      }
    `

    const PAPER = glsl(`
      ${FIELD}
      void main() {
        vec2 uv = vUv;
        vec2 p = centred(uv);
        float t = u_time * 0.6;

        float f = field(p * 0.85, t);

        // Two soft sources: one drifting on its own, one following the pointer.
        // Both are wide and weak — this is bounce light, not a spotlight.
        vec2 l1 = vec2(sin(t * 0.11) * 0.7, cos(t * 0.09) * 0.45);
        vec2 l2 = (u_pointer * 2.0 - 1.0) * vec2(1.15, 0.8);
        float d1 = 1.0 - smoothstep(0.0, 1.5, length(p - l1));
        float d2 = 1.0 - smoothstep(0.0, 1.1, length(p - l2));

        // Warm highlight, cool shadow — the oldest trick in painting and the
        // reason flat grey gradients read as cheap. Pushed further apart than
        // the first pass, which kept them close enough to white that the
        // whole page read as flat off-white rather than as lit paper.
        vec3 warm = vec3(1.000, 0.940, 0.824);
        vec3 cool = vec3(0.765, 0.815, 0.905);

        float lum = f * 0.55 + d1 * 0.30 + d2 * 0.26;
        vec3 col = mix(cool, warm, clamp(lum, 0.0, 1.0));

        float k = 0.62;
        vec3 base = vec3(0.965, 0.961, 0.945);
        col = base + (col - base) * k;

        /* A measured floor, not a hoped-for one. This shader has no toLinear/
           toSRGB pipeline elsewhere — col is already the displayed sRGB value
           — so the WCAG curve is applied here directly rather than assuming
           the pow(2.2) shortcut the rest of the site uses, which the site's
           own notes already flag as diverging from the real curve. That
           divergence matters most in deep shadow; up here at L ~0.8 the two
           curves agree closely, but this is the one number on the page a
           mistake would actually break, so it gets the real formula anyway.
           --ink-soft (#605d68) is L 0.112 by that formula; 4.5:1 against it
           needs background L >= 0.68. Floored well above that. The push-
           toward-white below is a linear mix, not a true inverse of the WCAG
           curve, so it lands close to FLOOR rather than exactly on it —
           confirmed against the framebuffer, not just this arithmetic. */
        vec3 lc = vec3(
          col.r <= 0.03928 ? col.r / 12.92 : pow((col.r + 0.055) / 1.055, 2.4),
          col.g <= 0.03928 ? col.g / 12.92 : pow((col.g + 0.055) / 1.055, 2.4),
          col.b <= 0.03928 ? col.b / 12.92 : pow((col.b + 0.055) / 1.055, 2.4)
        );
        float relLum = dot(lc, vec3(0.2126, 0.7152, 0.0722));
        const float FLOOR = 0.83;
        if (relLum < FLOOR) col = mix(col, vec3(1.0), (FLOOR - relLum) / max(1.0 - relLum, 1e-4));

        // Paper tooth. Slightly coloured rather than grey, so it reads as fibre.
        vec2 px = uv * u_res;
        float g = hash21(floor(px / max(u_dpr, 1.0)) + floor(u_time * 12.0));
        col += (g - 0.5) * 0.016 * vec3(1.0, 0.97, 0.93);

        col = dither(col, px);
        fragColor = vec4(col, 1.0);
      }
    `)

    const VOID = glsl(`
      uniform vec3 u_a;
      uniform vec3 u_b;
      ${FIELD}
      void main() {
        vec2 uv = vUv;
        vec2 p = centred(uv);
        float t = u_time * 0.5;

        float f = field(p * 0.7, t);
        float r = ridge(p * 1.4 + f * 0.6, 5);

        vec2 l2 = (u_pointer * 2.0 - 1.0) * vec2(1.2, 0.85);
        float d2 = 1.0 - smoothstep(0.0, 1.3, length(p - l2));

        // Rendered in linear light and tonemapped, so the bright filaments roll
        // off instead of clipping into flat blocks of colour.
        vec3 col = mix(toLinear(u_a), toLinear(u_b), clamp(f * 1.3, 0.0, 1.0));
        col += toLinear(u_b) * r * r * 1.5;
        col += toLinear(u_b) * d2 * 0.35;
        col *= 1.0 - 0.35 * smoothstep(0.4, 1.5, length(p));

        col = aces(col * 1.15);
        col = toSRGB(col);
        col = dither(col, uv * u_res);
        fragColor = vec4(col, 1.0);
      }
    `)

    const surface = new ShaderSurface(host, variant === 'void' ? VOID : PAPER, {
      // The field is expensive per-pixel and it is all low frequency, so it is
      // rendered below device resolution and scaled up. Nothing in it has an
      // edge sharp enough for that to be visible.
      scale: 0.5,
      uniforms: () => (variant === 'void' ? { u_a: a, u_b: b } : {}),
    })

    // Pointer drives the second light. Passive listener, and the value is only
    // read once per frame by the shader, so this costs nothing measurable.
    addEventListener(
      'pointermove',
      (e) => surface.setPointer(e.clientX / innerWidth, 1 - e.clientY / innerHeight),
      { passive: true },
    )
  }
</script>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* The still fallback: whatever the shader would have averaged out to. */
    background:
      radial-gradient(120% 90% at 20% 0%, #fffdf8 0%, transparent 60%),
      radial-gradient(100% 80% at 90% 20%, #f2f4f8 0%, transparent 55%),
      var(--paper);
  }
  .backdrop-void {
    background:
      radial-gradient(120% 90% at 30% 10%, #1a1a30 0%, transparent 60%),
      #08080f;
  }

  /* The canvas is created at runtime, so it cannot carry a scoped style
     attribute — these rules have to be global or they silently do nothing. */
  .backdrop :global(.gl-surface) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
