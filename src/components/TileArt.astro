---
import type { TileArt } from '../data/games'

interface Props { art: TileArt; seed?: number }
const { art, seed = 1 } = Astro.props

// Deterministic pseudo-random so tiles look hand-varied but never reflow
// between builds. Same seed, same drawing, every time.
const rand = (n: number) => {
  const x = Math.sin(seed * 9301 + n * 49297) * 233280
  return x - Math.floor(x)
}
const range = (n: number) => Array.from({ length: n }, (_, i) => i)

// A wobbling polyline used by the 'stroke' tile.
const strokePath = range(26)
  .map((i) => {
    const t = i / 25
    const x = 20 + t * 200
    const y = 70 + Math.sin(t * 7) * 16 * (0.35 + rand(i)) + (rand(i + 40) - 0.5) * 10
    return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`
  })
  .join(' ')

const scribble = range(30)
  .map((i) => {
    const a = i * 0.75
    const r = 18 + i * 1.9
    return `${i === 0 ? 'M' : 'L'}${(120 + Math.cos(a) * r).toFixed(1)},${(70 + Math.sin(a) * r * 0.62).toFixed(1)}`
  })
  .join(' ')
---

{/* Purely decorative: the tile's real label is HTML text in GameTile. */}
<svg class="art" viewBox="0 0 240 140" aria-hidden="true" focusable="false">
  {
    art === 'strata' && (
      <g>
        {range(7).map((i) => (
          <rect
            x="0" y={18 + i * 17} width="240" height={11 - i * 0.6}
            rx="3" fill="#fff" opacity={0.09 + i * 0.045}
          />
        ))}
        <circle cx="196" cy="112" r="7" fill="#fff" opacity="0.9" />
      </g>
    )
  }

  {
    art === 'rings' && (
      <g fill="none" stroke="#fff">
        {range(6).map((i) => (
          <circle cx="120" cy="70" r={12 + i * 17} opacity={0.5 - i * 0.07} stroke-width={2.5 - i * 0.3} />
        ))}
        <circle cx="120" cy="70" r="5" fill="#fff" stroke="none" opacity="0.95" />
      </g>
    )
  }

  {
    art === 'checklist' && (
      <g>
        {range(5).map((i) => (
          <g opacity={0.85 - i * 0.13}>
            <rect x="42" y={22 + i * 22} width="14" height="14" rx="4" fill="none" stroke="#fff" stroke-width="2" />
            {i < 3 && (
              <path
                d={`M45.5 ${29 + i * 22} l3.5 3.5 l5 -6`}
                fill="none" stroke="#fff" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round"
              />
            )}
            <rect x="66" y={26 + i * 22} width={120 - i * 14} height="6" rx="3" fill="#fff" opacity="0.55" />
          </g>
        ))}
      </g>
    )
  }

  {
    art === 'stroke' && (
      <g fill="none">
        <path d="M20 70 L220 70" stroke="#fff" stroke-width="2" stroke-dasharray="5 7" opacity="0.4" />
        <path d={strokePath} stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" opacity="0.95" />
        <circle cx="20" cy="70" r="7" fill="#fff" />
        <circle cx="220" cy="70" r="7" fill="#fff" />
      </g>
    )
  }

  {
    art === 'orbit' && (
      <g>
        <circle cx="94" cy="70" r="34" fill="#fff" opacity="0.22" />
        <circle cx="146" cy="70" r="34" fill="#fff" opacity="0.22" />
        {/* The lens where they overlap — the whole idea of the game. */}
        <path
          d="M120 41.5 A34 34 0 0 1 120 98.5 A34 34 0 0 1 120 41.5 Z"
          fill="#fff" opacity="0.72"
        />
        <circle cx="120" cy="70" r="3.5" fill="#fff" />
      </g>
    )
  }

  {
    art === 'stacks' && (
      <g>
        {range(6).map((i) => {
          const h = 16 + rand(i) * 62
          return (
            <g>
              <rect x={40 + i * 28} y={112 - h} width="19" height={h} rx="3" fill="#fff" opacity={0.28 + i * 0.1} />
              <ellipse cx={49.5 + i * 28} cy={112 - h} rx="9.5" ry="3" fill="#fff" opacity="0.85" />
            </g>
          )
        })}
      </g>
    )
  }

  {
    art === 'fold' && (
      <g>
        {range(5).map((i) => (
          <path
            d={`M${34 + i * 8} ${100 - i * 15} L${206 - i * 12} ${100 - i * 15} L${196 - i * 12} ${112 - i * 15} L${44 + i * 8} ${112 - i * 15} Z`}
            fill="#fff" opacity={0.24 + i * 0.14}
          />
        ))}
      </g>
    )
  }

  {
    art === 'bars' && (
      <g>
        {range(5).map((i) => {
          const w = 40 + rand(i) * 130
          return (
            <g>
              <rect x="36" y={24 + i * 21} width="168" height="9" rx="4.5" fill="#fff" opacity="0.2" />
              <rect x="36" y={24 + i * 21} width={w} height="9" rx="4.5" fill="#fff" opacity="0.9" />
            </g>
          )
        })}
      </g>
    )
  }

  {
    art === 'waves' && (
      <g fill="none" stroke="#fff" stroke-linecap="round">
        {range(4).map((i) => {
          const amp = 8 + i * 7
          const d = range(41)
            .map((k) => {
              const x = 16 + k * 5.2
              const y = 70 + Math.sin(k / 3.1 + i * 1.4) * amp
              return `${k === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`
            })
            .join(' ')
          return <path d={d} stroke-width={2.6 - i * 0.4} opacity={0.85 - i * 0.17} />
        })}
      </g>
    )
  }

  {
    art === 'tracks' && (
      <g stroke="#fff" fill="none" stroke-linecap="round">
        <path d="M120 128 L120 74 L48 20" stroke-width="3.2" opacity="0.9" />
        <path d="M120 74 L200 20" stroke-width="3.2" opacity="0.4" />
        {range(6).map((i) => (
          <path d={`M${112 - i * 1.5} ${118 - i * 9} L${128 + i * 1.5} ${118 - i * 9}`} stroke-width="2.6" opacity={0.6 - i * 0.07} />
        ))}
        <circle cx="120" cy="74" r="5.5" fill="#fff" stroke="none" />
      </g>
    )
  }

  {
    art === 'sketch' && (
      <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
        <path d={scribble} stroke-width="2.6" opacity="0.85" />
        <path d="M186 34 l14 14 M200 34 l-14 14" stroke-width="2.6" opacity="0.6" />
      </g>
    )
  }

  {
    art === 'powder' && (
      <g>
        {range(5).map((i) => (
          <path
            d={`M${20 + i * 8} 128 Q${120} ${104 - i * 15} ${220 - i * 8} 128 Z`}
            fill="#fff" opacity={0.16 + i * 0.13}
          />
        ))}
        {range(16).map((i) => (
          <rect
            x={40 + rand(i) * 160} y={12 + rand(i + 20) * 70}
            width="4" height="4" rx="1" fill="#fff" opacity={0.35 + rand(i + 40) * 0.5}
          />
        ))}
      </g>
    )
  }

  {
    art === 'orbit2' && (
      <g fill="none" stroke="#fff">
        <ellipse cx="120" cy="70" rx="88" ry="34" opacity="0.3" stroke-width="1.6" />
        <ellipse cx="120" cy="70" rx="56" ry="54" opacity="0.22" stroke-width="1.6" />
        <circle cx="120" cy="70" r="13" fill="#fff" stroke="none" opacity="0.95" />
        <circle cx="208" cy="70" r="5.5" fill="#fff" stroke="none" opacity="0.85" />
        <circle cx="120" cy="16" r="4" fill="#fff" stroke="none" opacity="0.7" />
        <path d="M186 52 A88 34 0 0 1 208 70" stroke-width="3" opacity="0.8" />
      </g>
    )
  }

  {
    art === 'chaos' && (
      <g>
        {range(22).map((i) => {
          const s = 5 + rand(i) * 17
          return (
            <rect
              x={14 + rand(i + 5) * 206} y={8 + rand(i + 11) * 116}
              width={s} height={s} rx={rand(i + 30) > 0.5 ? s / 2 : 3}
              fill="#fff" opacity={0.18 + rand(i + 60) * 0.62}
              transform={`rotate(${(rand(i + 70) - 0.5) * 60} ${14 + rand(i + 5) * 206} ${8 + rand(i + 11) * 116})`}
            />
          )
        })}
      </g>
    )
  }

  {/* Damage rings spreading from an impact point, with the incoming trajectory
      streaking in from the top right. */}
  {
    art === 'impact' && (
      <g>
        {range(5).map((i) => (
          <ellipse
            cx={92} cy={104} rx={16 + i * 27} ry={7 + i * 12}
            fill="none" stroke="#fff"
            stroke-width={1.6 - i * 0.2}
            opacity={0.5 - i * 0.075}
          />
        ))}
        <ellipse cx={92} cy={104} rx={13} ry={6} fill="#fff" opacity={0.85} />
        <path
          d="M212 14 L108 92" stroke="#fff" stroke-width="2.4"
          stroke-linecap="round" opacity="0.75"
        />
        {range(7).map((i) => (
          <circle
            cx={206 - i * 15 + rand(i) * 6} cy={20 + i * 11 + rand(i + 9) * 5}
            r={2.6 - i * 0.28} fill="#fff" opacity={0.7 - i * 0.08}
          />
        ))}
      </g>
    )
  }

  {/* A price climbing the ladder, and the hammer arriving on top of it. */}
  {
    art === 'gavel' && (
      <g>
        {range(7).map((i) => (
          <rect
            x={26 + i * 17} y={122 - (10 + i * i * 2.1)} width="11"
            height={10 + i * i * 2.1} rx="2" fill="#fff" opacity={0.22 + i * 0.06}
          />
        ))}
        <g transform="rotate(-28 176 52)">
          <rect x="150" y="34" width="52" height="26" rx="7" fill="#fff" opacity="0.95" />
          <rect x="172" y="58" width="9" height="46" rx="4" fill="#fff" opacity="0.78" />
        </g>
        <rect x="140" y="118" width="74" height="9" rx="4" fill="#fff" opacity="0.6" />
      </g>
    )
  }

  {/* A verification grid mid-answer, with the pointer that is being watched. */}
  {
    art === 'verify' && (
      <g>
        {range(9).map((i) => {
          const col = i % 3
          const row = Math.floor(i / 3)
          const ticked = i === 1 || i === 4 || i === 6
          return (
            <g>
              <rect
                x={62 + col * 38} y={16 + row * 38} width="32" height="32" rx="5"
                fill="#fff" opacity={ticked ? 0.9 : 0.2}
              />
              {ticked && (
                <path
                  d={`M${70 + col * 38} ${32 + row * 38} l5 5 l10 -12`}
                  fill="none" stroke="#1b2440" stroke-width="3"
                  stroke-linecap="round" stroke-linejoin="round"
                />
              )}
            </g>
          )
        })}
        <path
          d="M164 96 L164 132 L173 124 L179 137 L186 133 L180 121 L191 120 Z"
          fill="#fff" stroke="#1b2440" stroke-width="2.5" stroke-linejoin="round"
        />
      </g>
    )
  }

  {
    art === 'grid' && (
      <g fill="#fff">
        {range(90).map((i) => {
          const col = i % 18
          const row = Math.floor(i / 18)
          // The first third is filled in: the weeks already spent.
          const spent = i < 34
          return (
            <rect
              x={26 + col * 11} y={30 + row * 11} width="7" height="7" rx="1.6"
              opacity={spent ? 0.92 : 0.22}
            />
          )
        })}
      </g>
    )
  }
</svg>

<style>
  .art {
    position: absolute;
    right: -6px;
    bottom: -4px;
    width: 46%;
    max-width: 260px;
    height: auto;
    pointer-events: none;
  }
  @media (max-width: 700px) {
    .art { width: 40%; right: -10px; }
  }
</style>
