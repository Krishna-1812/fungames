---
import { ART, PRESERVE, SLOT_BOX, fadeStops } from '../lib/tile-art'

interface Props { slug: string; seed?: number }
const { slug, seed = 1 } = Astro.props

// A missing drawing is a build-time mistake, not a runtime one — check-art
// enforces that every listed game has one — but rendering nothing is a better
// failure than rendering a broken <svg>.
const art = ART[slug]
const box = art ? SLOT_BOX[art.slot] : null

// Full-bleed drawings dissolve under the title rather than fighting it. The
// stops come from lib/tile-art so check-art masks the tile with the same
// numbers before it measures contrast.
const fade = art ? fadeStops(art.slot) : null
const mask = fade
  ? `linear-gradient(to right, transparent ${fade[0]}%, #000 ${fade[1]}%)`
  : null
---

{
  art && box && (
    /* The drawing's own markup goes in with set:html. It is server-rendered
       string content, so Astro's scoped-style hash lands on this <svg> but on
       nothing inside it — which is fine, because everything inside carries its
       own fills. Do not add a style rule here that targets a child; it will
       not apply. (Fourth time this has been worth writing down.) */
    <svg
      class="art"
      viewBox={art.viewBox}
      preserveAspectRatio={PRESERVE[art.slot]}
      style={
        `left:${box.l}%; top:${box.t}%; width:${box.w}%; height:${box.h}%` +
        (mask ? `; -webkit-mask-image:${mask}; mask-image:${mask}` : '')
      }
      aria-hidden="true"
      focusable="false"
      set:html={art.draw(seed)}
    />
  )
}

<style>
  /* Position comes from SLOT_BOX as an inline style, so the page and the
     checker are laying the drawing out from the same numbers. */
  .art {
    position: absolute;
    display: block;
    pointer-events: none;
  }
</style>
