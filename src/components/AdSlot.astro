---
import { SITE } from '../site.config'

interface Props {
  /** AdSense ad unit slot id. */
  slot?: string
  label?: string
}
const { slot = '', label = 'Advertisement' } = Astro.props
const enabled = Boolean(SITE.adsenseClient && slot)
---

{
  enabled && (
    <aside class="ad" aria-label={label}>
      <span class="ad-label">{label}</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={SITE.adsenseClient}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({})
      </script>
    </aside>
  )
}

<style>
  .ad { display: block; margin: 32px auto; max-width: 970px; text-align: center; }
  .ad-label {
    display: block; font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-soft); opacity: 0.6; margin-bottom: 6px;
  }
</style>
