---
import { faviconHref } from '../lib/favicon'
import { withBase } from '../lib/base'
import { SITE } from '../site.config'
import '../styles/global.css'
import '../styles/consent.css'

interface Props {
  title: string
  description?: string
  image?: string
  /** Games set this to lock page scroll. */
  fixed?: boolean
  themeColor?: string
  /** Games with their own dark frame skip the paper background. */
  bodyClass?: string
  /** The 404 page sets this — a static host may still answer with 200. */
  noindex?: boolean
  /** Extra Google Fonts families a single page needs, as css2 'family=' values. */
  fonts?: string[]
  /** Extra JSON-LD objects (breadcrumbs, VideoGame) a page wants alongside the sitewide WebSite one. */
  structuredData?: Record<string, unknown>[]
}

const {
  title,
  description = SITE.description,
  image,
  fixed = false,
  themeColor = '#f6f5f1',
  bodyClass = '',
  noindex = false,
  fonts = [],
  structuredData = [],
} = Astro.props

// One request, not two: a page that wants another family appends it here
// rather than adding a second render-blocking link to the same host.
const fontHref =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800' +
  '&family=Inter:wght@400;500;600;700' +
  fonts.map((f) => '&family=' + f).join('') +
  '&display=swap'

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
}

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href
const ogImage = image ? new URL(image, Astro.site ?? SITE.url).href : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon-96.png')} sizes="96x96" type="image/png" />
    <link rel="icon" href={faviconHref(true)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={fontHref}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {
      structuredData.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }

    {
      SITE.plausibleDomain && (
        <script is:inline defer data-domain={SITE.plausibleDomain} src="https://plausible.io/js/script.js"></script>
      )
    }
    {
      SITE.adsenseClient && (
        <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}></script>
      )
    }
  </head>
  <body class:list={[bodyClass, { 'is-fixed': fixed }]}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script>
      /* The filled part of a slider.

         Firefox has ::-moz-range-progress and needs nothing from here.
         Chromium has no equivalent, so the fill is a gradient stop in
         global.css positioned by --fill, and something has to write it. One
         delegated listener in the layout does every slider on the site. */
      const paint = (el) => {
        const min = Number(el.min || 0)
        const max = Number(el.max === '' ? 100 : el.max)
        const pct = max > min ? ((Number(el.value) - min) / (max - min)) * 100 : 0
        el.style.setProperty('--fill', pct + '%')
      }

      document.addEventListener('input', (e) => {
        const t = e.target
        if (t instanceof HTMLInputElement && t.type === 'range') paint(t)
      })
      document.querySelectorAll('input[type="range"]').forEach(paint)

      /* Not every slider is in the markup: the tone challenge in I'm Not a
         Robot builds its own, and a slider that appears already halfway along
         with an empty track behind it is worse than one that was never
         styled. So late arrivals get found too. The check runs only over the
         nodes an insertion actually added, which costs nothing next to the
         insertion itself. */
      new MutationObserver((records) => {
        for (const r of records)
          for (const node of r.addedNodes) {
            if (!(node instanceof HTMLElement)) continue
            if (node instanceof HTMLInputElement && node.type === 'range') paint(node)
            else node.querySelectorAll('input[type="range"]').forEach(paint)
          }
      }).observe(document.body, { childList: true, subtree: true })
    </script>
  </body>
</html>
