---
import Paper from './Paper.astro'
import ShellResult from '../components/paper/ShellResult.astro'
import { SITE } from '../site.config'
import { gameBySlug } from '../data/games'
import { withBase } from '../lib/base'
import { META } from '../data/game-meta'
import { homeGames, hasRealWorld } from '../lib/island/home'
import { plateInfo } from '../lib/island/plate'
import { DISTRICTS, PLACES } from '../lib/island/landmarks'
import type { NextData } from '../lib/next-up'
import '../styles/paper/game-shell.css'

/**
 * The shared game shell. A game page supplies three things:
 *
 *   - the stage (default slot): its own board, pieces and controls
 *   - `howto` (named slot): what the How-to-play panel says
 *   - `labels`: what the four score tiles are called in this game
 *
 * and drives everything else through `createShell()` in lib/game-shell.ts —
 * score, best, level, moves, pop/shake feedback, level-up, win and lose.
 * The same frame, the same controls and the same keys, so thirty games read
 * as one product.
 */
interface Props {
  slug: string
  labels?: { score?: string; best?: string; level?: string; moves?: string }
  /** Initial values, so the strip is finished before any script runs. */
  initial?: { score?: string; level?: string; moves?: string }
  /** Extra font families the game's own content needs (see Paper.astro). */
  fonts?: string[]
  /**
   * Put the result card above the stage instead of below it: for a game that
   * is played by scrolling up, whose ending is at the top of the page.
   */
  resultFirst?: boolean
}

const { slug, labels = {}, initial = {}, fonts = [], resultFirst = false } = Astro.props
const game = gameBySlug(slug)
if (!game) throw new Error(`No registry entry for game "${slug}"`)

const L = {
  score: labels.score ?? 'Score',
  best: labels.best ?? 'Best',
  level: labels.level ?? 'Level',
  moves: labels.moves ?? 'Moves',
}

const howto = Astro.slots.has('howto') ? await Astro.slots.render('howto') : ''

// What "Up next" chooses from (lib/next-up.ts): every listed game, with the
// colour of its district behind its building, as on the homepage's cards.
const districtOf = Object.fromEntries(PLACES.map(([s, d]) => [s, d]))
const nextData: NextData = {
  games: homeGames().map((g) => ({
    slug: g.slug, title: g.title, blurb: g.blurb, cat: g.category, added: g.added,
    kind: META[g.slug]?.difficulty === 'Explore' ? 'explore' : 'play',
    tint: DISTRICTS.find((d) => d.key === districtOf[g.slug])?.tint ?? '#e3e9ff',
    district: districtOf[g.slug] ?? '',
  })),
  worlds: hasRealWorld() ? ['cartoon', 'real'] : ['cartoon'],
  world: plateInfo('plate')?.live ? 'real' : 'cartoon',
  home: { cartoon: withBase('/'), real: withBase('/realistic/') },
  base: withBase('/').replace(/\/$/, ''),
}

const gameUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href
const homeUrl = new URL(withBase('/'), Astro.site ?? SITE.url).href
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: game.title, item: gameUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: game.description,
    url: gameUrl,
    image: new URL(withBase(`/og/${game.slug}.png`), Astro.site ?? SITE.url).href,
    gamePlatform: 'Web browser',
    isAccessibleForFree: true,
    datePublished: game.added,
  },
]
---

<Paper
  title={`${game.title} — ${SITE.name}`}
  description={game.description}
  image={withBase(`/og/${game.slug}.png`)}
  masthead={false}
  colophon={false}
  structuredData={structuredData}
  fonts={fonts}
>
  <div class="shell" data-shell data-slug={slug}>
    {/* One slim bar: the way back, the name, and the three things a player reaches for (sound, how to
        play, and pause or restart under ⋯). The game below gets the room. */}
    <header class="wrap shell-bar">
      <a class="pill pill--line pill--sm shell-back" href={withBase('/')} aria-label="Back to the island">
        <span aria-hidden="true">←</span><span class="shell-back-word">Island</span>
      </a>
      <h1 class="shell-title">{game.title}</h1>
      <div class="shell-controls" role="group" aria-label="Game controls">
        <button type="button" class="shell-icon" data-act="sound" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 9h3.2L12.5 5v14l-4.8-4H4.5z" fill="currentColor" fill-opacity=".2" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path class="ic-on" d="M15.5 9.2a4 4 0 0 1 0 5.6M18 6.8a7.4 7.4 0 0 1 0 10.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path class="ic-off" d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span class="sr-only" data-sound-label>Sound off</span>
        </button>
        <button type="button" class="pill pill--ink pill--sm shell-howto" data-act="howto" aria-haspopup="dialog" aria-label="How to play">
          <span class="shell-howto-q" aria-hidden="true">?</span><span class="shell-howto-word">How to play</span>
        </button>
        <details class="shell-more">
          <summary class="shell-icon" aria-label="Pause or restart">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="12" r="1.9" fill="currentColor" /><circle cx="12" cy="12" r="1.9" fill="currentColor" /><circle cx="18.5" cy="12" r="1.9" fill="currentColor" /></svg>
          </summary>
          <div class="shell-menu">
            <button type="button" data-act="pause" aria-haspopup="dialog"><span>Pause</span><kbd>P</kbd></button>
            <button type="button" data-act="restart"><span>Restart</span></button>
          </div>
        </details>
      </div>
    </header>

    <main id="main" class="wrap shell-main">
      <ul class="shell-strip" role="list" aria-label="Scores">
        <li class:list={['shell-tile', { 'is-empty': (initial.score ?? '0') === '—' }]} data-tile="score">
          <span class="label">{L.score}</span>
          <span class="num tab" data-val>{initial.score ?? '0'}</span>
        </li>
        <li class="shell-tile is-empty" data-tile="best">
          <span class="label">{L.best}</span>
          <span class="num" data-val>—</span>
          <span class="new-best" data-new-best hidden>✓ New best</span>
        </li>
        <li class:list={['shell-tile', { 'is-empty': (initial.level ?? '1') === '—' }]} data-tile="level">
          <span class="label">{L.level}</span>
          <span class="num tab" data-val>{initial.level ?? '1'}</span>
        </li>
        <li class:list={['shell-tile', { 'is-empty': (initial.moves ?? '0') === '—' }]} data-tile="moves">
          <span class="label">{L.moves}</span>
          <span class="num tab" data-val>{initial.moves ?? '0'}</span>
        </li>
      </ul>
      <p class="sr-only" aria-live="polite" data-announce></p>

      <div class="vs-banner" data-vs-banner hidden>
        <span class="dly-badge">A friend’s challenge</span>
        <p class="vs-banner-line" data-vs-line></p>
      </div>

      <div class="dly-banner" data-daily-banner hidden>
        <span class="dly-badge">Today’s challenge</span>
        <p class="dly-goal" data-daily-goal></p>
        <p class="dly-meta" data-daily-meta></p>
      </div>

      {resultFirst && <ShellResult />}

      <section class="stage" data-stage aria-label={`${game.title} — play area`}>
        <noscript>
          <div class="stage-note">
            <p class="t-h3">This game needs JavaScript to play.</p>
            <div class="panel-body" set:html={howto} />
          </div>
        </noscript>
        <slot />
        <div class="level-up" data-level-up hidden aria-hidden="true">
          <p class="display"><span class="marker" data-level-text>Level 2</span></p>
        </div>
      </section>

      {!resultFirst && <ShellResult />}

      <slot name="after" />
    </main>

    <section class="nx nx--foot wrap" data-next-foot hidden aria-labelledby="nx-foot-title">
      <div class="nx-head">
        <h2 class="nx-title-h" id="nx-foot-title" data-next-title>Keep exploring</h2>
        <a class="nx-home" data-next-home href={withBase('/')}><span>All the games on Tiny Island</span><span aria-hidden="true">→</span></a>
      </div>
      <div class="nx-row" data-next-row></div>
    </section>
  </div>
  <script type="application/json" id="next-data" set:html={JSON.stringify(nextData)} />

  <dialog class="panel" data-panel="pause" aria-labelledby="pause-title">
    <p class="label meta">Paused</p>
    <h2 id="pause-title" style="margin-top:10px">Take your time.</h2>
    <div class="panel-body"><p>Nothing moves while this is open. The game picks up exactly where it stopped.</p></div>
    <div class="panel-actions">
      <button type="button" class="pill pill--hero" data-close autofocus><span>Resume</span><span class="arrow" aria-hidden="true">→</span></button>
      <button type="button" class="pill pill--line" data-act="restart"><span>Restart</span></button>
    </div>
  </dialog>

  <dialog class="panel" data-panel="howto" aria-labelledby="howto-title">
    <p class="label meta">{game.title}</p>
    <h2 id="howto-title" style="margin-top:10px">How to play</h2>
    <div class="panel-body" set:html={howto} />
    <div class="panel-body">
      <p><kbd>P</kbd> pauses, <kbd>Esc</kbd> closes this panel. Every control can be reached with <kbd>Tab</kbd>.</p>
    </div>
    <div class="panel-actions">
      <button type="button" class="pill pill--hero" data-close autofocus><span>Got it</span><span class="arrow" aria-hidden="true">→</span></button>
    </div>
  </dialog>
</Paper>
